{
  "schema_version": 1,
  "id": "codex-cli-integration",
  "title": "Managed Codex CLI and DBSCTR parity",
  "state": "discovering",
  "coordinator_repository": "Saltiola7/dotfiles-ai",
  "statements": [
    {"id":"INT-001","kind":"requirement","text":"Manage Codex CLI and OpenCode as supported peer runtimes from dotfiles-ai.","disposition":"ready","artifacts":["docs/initiatives/codex-cli-integration/README.md","docs/specs/codex_control_plane/README.md"]},
    {"id":"INT-002","kind":"non-goal","text":"Do not manage or redirect the separately managed Codex desktop application.","disposition":"ready","artifacts":["docs/specs/codex_control_plane/README.md"]},
    {"id":"INT-003","kind":"requirement","text":"Support Codex on the macOS host, Fedora Lima guests, Herdr, Hermes, and autonomous DBSCTR workers.","disposition":"ready","artifacts":["docs/specs/dotfiles_ai_distribution/features/codex-cli.md"]},
    {"id":"INT-004","kind":"decision","text":"Keep OpenCode installed and supported; parity readiness does not retire either runtime or change interactive invocation.","disposition":"ready","artifacts":["docs/initiatives/codex-cli-integration/README.md"]},
    {"id":"INT-005","kind":"decision","text":"Persist only automation runtime selection through rnd.runtime and an optional workspace override; default to OpenCode and never fall back silently.","disposition":"ready","artifacts":["docs/specs/dotfiles_ai_distribution/features/codex-cli.md"]},
    {"id":"INT-006","kind":"requirement","text":"Give Codex CLI a dedicated CODEX_HOME derived from the optional centralized state root with a local fallback.","disposition":"ready","artifacts":["docs/specs/codex_control_plane/README.md","docs/specs/dotfiles_ai_distribution/features/codex-cli.md"]},
    {"id":"INT-007","kind":"constraint","text":"Keep host, guest, and desktop credentials, sessions, logs, and private state isolated and out of Git.","disposition":"ready","artifacts":["docs/specs/codex_control_plane/README.md","docs/specs/shell_auth_startup/codex-cli.md"]},
    {"id":"INT-008","kind":"decision","text":"Use the official macOS Homebrew cask and a pinned checksum-verified Fedora aarch64 musl release.","disposition":"ready","artifacts":["docs/specs/dotfiles_ai_distribution/features/codex-cli.md"]},
    {"id":"INT-009","kind":"requirement","text":"Require outcome parity for every requested configuration, lifecycle, tooling, history, worker, recovery, and federation capability.","disposition":"ready","artifacts":["docs/specs/codex_control_plane/README.md"]},
    {"id":"INT-010","kind":"decision","text":"Prefer native Codex instructions, skills, agents, sandbox, approvals, hooks, CLI JSONL, and supported thread APIs over rebuilt behavior.","disposition":"ready","artifacts":["docs/specs/codex_control_plane/README.md"]},
    {"id":"INT-011","kind":"decision","text":"Retain one DBSCTR V3 lifecycle and add conforming harness adapters rather than a Codex-specific lifecycle version.","disposition":"ready","artifacts":["docs/specs/dbsctr_v3_lifecycle/features/harness-adapters.md"]},
    {"id":"INT-012","kind":"decision","text":"Propose Cycle Record schema 5 for future generic harness identity while preserving schema 3 and 4 reads without implicit migration.","disposition":"ready","artifacts":["docs/specs/dbsctr_v3_lifecycle/features/harness-adapters.md"]},
    {"id":"INT-013","kind":"decision","text":"Use a short-lived Python Codex adapter over the installed CLI, sanitized hooks, stable app-server stdio, and dbsctrctl.","disposition":"ready","artifacts":["docs/specs/codex_control_plane/README.md"]},
    {"id":"INT-014","kind":"constraint","text":"Do not read undocumented Codex SQLite or JSONL storage or infer missing runtime identity.","disposition":"ready","artifacts":["docs/specs/codex_control_plane/README.md","docs/specs/dbsctr_v3_lifecycle/features/harness-adapters.md"]},
    {"id":"INT-015","kind":"requirement","text":"Integrate Discovery, QA, PM, writing, DKS, Graphify, incidents, review, history, telemetry, benchmarks, recovery, and federation where their outcomes apply.","disposition":"ready","artifacts":["docs/specs/codex_control_plane/README.md"]},
    {"id":"INT-016","kind":"decision","text":"Project only digest-owned managed configuration atomically into CODEX_HOME and refuse unmanaged collisions or implicit state migration.","disposition":"ready","artifacts":["docs/specs/dotfiles_ai_distribution/features/codex-cli.md"]},
    {"id":"INT-017","kind":"requirement","text":"Gate identity-dependent implementation on a macOS and Fedora hook-to-thread correlation probe.","disposition":"ready","artifacts":["docs/specs/codex_control_plane/OPERATION.md"]},
    {"id":"INT-018","kind":"constraint","text":"Use hooks only for bounded sanitized identity, policy, and evidence; hooks never write lifecycle state.","disposition":"ready","artifacts":["docs/specs/codex_control_plane/README.md"]},
    {"id":"INT-019","kind":"non-goal","text":"Do not add MCP, plugin packaging, an SDK-bundled second runtime, a Rust rewrite, or a private Codex fork without separately approved evidence.","disposition":"ready","artifacts":["docs/specs/codex_control_plane/README.md"]},
    {"id":"INT-020","kind":"risk","text":"Codex release, hook, and app-server identity contracts may drift and must be capability-probed before deployment or parity claims.","disposition":"ready","artifacts":["docs/specs/codex_control_plane/README.md","docs/specs/codex_control_plane/OPERATION.md"]},
    {"id":"INT-021","kind":"decision","text":"Use the user-approved lifecycle, Codex control-plane, distribution, shell-auth, and consulted-context map.","disposition":"ready","artifacts":["docs/initiatives/codex-cli-integration/README.md"]},
    {"id":"INT-022","kind":"constraint","text":"Require cross-runtime conformance, OpenCode regression evidence, and representative benchmarks before performance-driven architecture changes.","disposition":"ready","artifacts":["docs/specs/dbsctr_v3_lifecycle/features/harness-adapters.md"]}
  ],
