{
  "schema_version": 1,
  "id": "codex-cli-integration",
  "title": "Managed Codex CLI and DBSCTR parity",
  "state": "building",
  "coordinator_repository": "Saltiola7/dotfiles-ai",
  "statements": [
    {"id":"INT-001","kind":"requirement","text":"Manage Codex CLI and OpenCode as supported peer runtimes from dotfiles-ai.","disposition":"ready","artifacts":["docs/initiatives/codex-cli-integration/README.md","docs/specs/codex_control_plane/README.md"]},
    {"id":"INT-002","kind":"non-goal","text":"Do not manage or redirect the separately managed Codex desktop application.","disposition":"ready","artifacts":["docs/specs/codex_control_plane/README.md"]},
    {"id":"INT-003","kind":"requirement","text":"Support Codex on the macOS host, Fedora Lima guests, Herdr, Hermes, and autonomous DBSCTR workers.","disposition":"ready","artifacts":["docs/specs/dotfiles_ai_distribution/features/codex-cli.md"]},
    {"id":"INT-004","kind":"decision","text":"Keep OpenCode installed and supported; parity readiness does not retire either runtime or change interactive invocation.","disposition":"ready","artifacts":["docs/initiatives/codex-cli-integration/README.md"]},
    {"id":"INT-005","kind":"decision","text":"Persist only automation runtime selection through rnd.runtime and an optional workspace override; default to OpenCode and never fall back silently.","disposition":"ready","artifacts":["docs/specs/dotfiles_ai_distribution/features/codex-cli.md"]},
    {"id":"INT-006","kind":"requirement","text":"Give Codex CLI a dedicated CODEX_HOME derived from the optional centralized state root with a local fallback.","disposition":"ready","artifacts":["docs/specs/codex_control_plane/README.md","docs/specs/dotfiles_ai_distribution/features/codex-cli.md"]},
    {"id":"INT-007","kind":"constraint","text":"Keep host, guest, and desktop credentials, sessions, logs, and private state isolated and out of Git.","disposition":"ready","artifacts":["docs/specs/codex_control_plane/README.md","docs/specs/shell_auth_startup/codex-cli.md"]},
    {"id":"INT-008","kind":"decision","text":"Use official Codex release archives and published SHA-256 digests on every managed platform; the moving Homebrew cask is not runtime authority.","disposition":"ready","artifacts":["docs/specs/dotfiles_ai_distribution/features/codex-rolling-stable.md"]},
    {"id":"INT-009","kind":"requirement","text":"Require outcome parity for every requested configuration, lifecycle, tooling, history, worker, recovery, and federation capability.","disposition":"ready","artifacts":["docs/specs/codex_control_plane/README.md"]},
    {"id":"INT-010","kind":"decision","text":"Prefer native Codex instructions, skills, agents, sandbox, approvals, hooks, CLI JSONL, and supported thread APIs over rebuilt behavior.","disposition":"ready","artifacts":["docs/specs/codex_control_plane/README.md"]},
    {"id":"INT-011","kind":"decision","text":"Retain one DBSCTR V3 lifecycle and add conforming harness adapters rather than a Codex-specific lifecycle version.","disposition":"ready","artifacts":["docs/specs/dbsctr_v3_lifecycle/features/harness-adapters.md"]},
    {"id":"INT-012","kind":"decision","text":"Use Cycle Record schema 5 for every new cycle with an empty pre-attach adapter map while preserving schema 3 and 4 reads without implicit migration.","disposition":"ready","artifacts":["docs/specs/dbsctr_v3_lifecycle/features/harness-adapters.md"]},
    {"id":"INT-013","kind":"decision","text":"Use a short-lived Python Codex adapter over the installed CLI, sanitized hooks, stable app-server stdio, and dbsctrctl.","disposition":"ready","artifacts":["docs/specs/codex_control_plane/README.md"]},
    {"id":"INT-014","kind":"constraint","text":"Do not read undocumented Codex SQLite or JSONL storage or infer missing runtime identity.","disposition":"ready","artifacts":["docs/specs/codex_control_plane/README.md","docs/specs/dbsctr_v3_lifecycle/features/harness-adapters.md"]},
    {"id":"INT-015","kind":"requirement","text":"Integrate Discovery, QA, PM, writing, DKS, Graphify, incidents, review, history, telemetry, benchmarks, recovery, and federation where their outcomes apply.","disposition":"ready","artifacts":["docs/specs/codex_control_plane/README.md"]},
    {"id":"INT-016","kind":"decision","text":"Project only digest-owned managed configuration through a crash-recoverable journaled transaction and refuse unmanaged collisions or implicit state migration.","disposition":"ready","artifacts":["docs/specs/dotfiles_ai_distribution/features/codex-cli.md"]},
    {"id":"INT-017","kind":"requirement","text":"Gate identity-dependent implementation on a macOS and Fedora hook-to-thread correlation probe.","disposition":"ready","artifacts":["docs/specs/codex_control_plane/OPERATION.md"]},
    {"id":"INT-018","kind":"constraint","text":"Use hooks only for bounded sanitized identity, policy, and evidence; hooks never write lifecycle state.","disposition":"ready","artifacts":["docs/specs/codex_control_plane/README.md"]},
    {"id":"INT-019","kind":"non-goal","text":"Do not add MCP, plugin packaging, an SDK-bundled second runtime, a Rust rewrite, or a private Codex fork without separately approved evidence.","disposition":"ready","artifacts":["docs/specs/codex_control_plane/README.md"]},
    {"id":"INT-020","kind":"risk","text":"Codex release, hook, and app-server identity contracts may drift and must be capability-probed before deployment or parity claims.","disposition":"ready","artifacts":["docs/specs/codex_control_plane/README.md","docs/specs/codex_control_plane/OPERATION.md"]},
    {"id":"INT-021","kind":"decision","text":"Use the user-approved lifecycle, Codex control-plane, distribution, shell-auth, and consulted-context map.","disposition":"ready","artifacts":["docs/initiatives/codex-cli-integration/README.md"]},
    {"id":"INT-022","kind":"constraint","text":"Require cross-runtime conformance, OpenCode regression evidence, and representative benchmarks before performance-driven architecture changes.","disposition":"ready","artifacts":["docs/specs/dbsctr_v3_lifecycle/features/harness-adapters.md"]},
    {"id":"INT-023","kind":"decision","text":"Use required status objects with bounded reasons for partial or unavailable schema-5 adapter capabilities.","disposition":"ready","artifacts":["docs/specs/dbsctr_v3_lifecycle/features/harness-adapters.md"]},
    {"id":"INT-024","kind":"decision","text":"Advance Method Revision to 3.29 and dual-write exact generic and legacy OpenCode identity when schema-5 implementation gates pass.","disposition":"ready","artifacts":["docs/specs/dbsctr_v3_lifecycle/features/harness-adapters.md","docs/specs/dbsctr_v3_lifecycle/PROFILE.md"]},
    {"id":"INT-025","kind":"constraint","text":"Limit the first schema-5 slice to synthetic Codex conformance; native Codex integration remains in later slices.","disposition":"ready","artifacts":["docs/specs/dbsctr_v3_lifecycle/features/harness-adapters.md"]},
    {"id":"INT-026","kind":"decision","text":"Deliver host foundation and distribution as two sequential pull requests so control-plane contracts precede package and guest deployment.","disposition":"ready","artifacts":["docs/initiatives/codex-cli-integration/README.md","docs/specs/codex_control_plane/README.md","docs/specs/dotfiles_ai_distribution/features/codex-cli.md"]},
    {"id":"INT-027","kind":"constraint","text":"Live probes and workers require an existing boundary-local Codex login and never auto-authenticate, inject a shared API key, or copy authentication between host and guests.","disposition":"ready","artifacts":["docs/initiatives/codex-cli-integration/README.md","docs/specs/codex_control_plane/README.md","docs/specs/codex_control_plane/OPERATION.md","docs/specs/dotfiles_ai_distribution/features/codex-cli.md","docs/specs/shell_auth_startup/codex-cli.md"]},
    {"id":"INT-028","kind":"decision","text":"Manage only the initial native Codex roles Build, Discovery, Plan, Review, Explore, and Scout; do not mirror every OpenCode agent.","disposition":"ready","artifacts":["docs/specs/codex_control_plane/README.md"]},
    {"id":"INT-029","kind":"decision","text":"Install and update Codex in all registered managed Fedora guests and provision future managed guests automatically.","disposition":"ready","artifacts":["docs/specs/dotfiles_ai_distribution/features/codex-cli.md"]},
    {"id":"INT-030","kind":"constraint","text":"Accept the documented Codex hook transcript_path only as bounded transient input, then discard it without reading, canonicalizing, logging, exposing, or persisting it.","disposition":"ready","artifacts":["docs/specs/codex_control_plane/README.md","docs/specs/codex_control_plane/OPERATION.md"]},
    {"id":"INT-031","kind":"decision","text":"Stage portable Codex source under codex-managed, use projected agents/**/*.toml role definitions, and configure the five initial identity hooks as inline command hooks.","disposition":"ready","artifacts":["docs/initiatives/codex-cli-integration/README.md","docs/specs/codex_control_plane/README.md","docs/specs/dotfiles_ai_distribution/features/codex-cli.md"]},
    {"id":"INT-032","kind":"requirement","text":"Validate bounded private harness history through one lifecycle-owned stateless request-and-page envelope before any runtime-specific consumer mapping.","disposition":"ready","artifacts":["docs/specs/dbsctr_v3_lifecycle/features/harness-history-source.md","docs/specs/dbsctr_v3_lifecycle/features/harness-history-source.schemas.json"]},
    {"id":"INT-033","kind":"decision","text":"Accept frozen legacy and paginated Codex threads only when stable thread/read with includeTurns returns full item views; never invoke turn or item pagination in the history adapter.","disposition":"ready","artifacts":["docs/specs/codex_control_plane/features/history-adapter.md","docs/specs/codex_control_plane/features/history-adapter.contract.json"]},
    {"id":"INT-034","kind":"decision","text":"Project only final safe user and assistant text; discard interim and unsupported known non-content items, discard unsafe text with explicit partial availability, reject unknown discriminators or missing required fields, and ignore additive optional Thread fields.","disposition":"ready","artifacts":["docs/specs/codex_control_plane/features/history-adapter.md","docs/specs/codex_control_plane/features/history-adapter.contract.json"]},
    {"id":"INT-035","kind":"requirement","text":"Every chezmoi apply checks and transactionally activates the latest compatible stable Codex release on the host and registered managed guests.","disposition":"ready","artifacts":["docs/specs/dotfiles_ai_distribution/features/codex-rolling-stable.md"]},
    {"id":"INT-036","kind":"decision","text":"Persist one owner-private release lock with platform, official asset digests, derived active executable digest, active and previous generations, and validator revision; never persist release bodies, paths, credentials, or session identity.","disposition":"ready","artifacts":["docs/specs/dotfiles_ai_distribution/features/codex-rolling-stable.md"]},
    {"id":"INT-037","kind":"decision","text":"When a healthy Codex release exists, metadata, download, validation, or guest unavailability keeps every target unchanged and does not fail unrelated chezmoi apply work.","disposition":"ready","artifacts":["docs/specs/dotfiles_ai_distribution/features/codex-rolling-stable.md"]},
    {"id":"INT-038","kind":"constraint","text":"A Codex update never restarts or signals active Codex, OpenCode, or Herdr processes; atomic activation affects only later launches.","disposition":"ready","artifacts":["docs/specs/dotfiles_ai_distribution/features/codex-rolling-stable.md"]},
    {"id":"INT-039","kind":"constraint","text":"Stage and validate one candidate on all registered targets before activation; activation failure restores prior binaries and locks in reverse order without host/guest divergence.","disposition":"ready","artifacts":["docs/specs/dotfiles_ai_distribution/features/codex-rolling-stable.md"]},
    {"id":"INT-040","kind":"risk","text":"Every newly selected Codex release must pass body-free semantic hook, identity, configuration, and stable app-server compatibility probes before adapters or workers claim support.","disposition":"ready","artifacts":["docs/specs/dotfiles_ai_distribution/features/codex-rolling-stable.md","docs/specs/codex_control_plane/OPERATION.md"]}
  ],
