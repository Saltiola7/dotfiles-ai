  "statements": [
    {"id":"INT-001","kind":"requirement","text":"Repair shared tooling in dotfiles-ai and provide prompts for the operator to resume exact existing conversations without taking over their project work.","disposition":"ready","artifacts":["docs/initiatives/session-resumption/README.md"]},
    {"id":"INT-002","kind":"requirement","text":"Support verified existing cycle worktrees in place outside the current allocation directory while preserving repository, Cycle Record, native identity and single-writer validation.","disposition":"ready","artifacts":["docs/initiatives/session-resumption/README.md","docs/specs/dbsctr_v3_lifecycle/features/canonical-continuation.md"]},
    {"id":"INT-003","kind":"constraint","text":"Preserve pending merges, dirty files, provider affinity, session history and existing child-agent restrictions; never infer recovery approval or fabricate identities.","disposition":"ready","artifacts":["docs/initiatives/session-resumption/README.md"]},
    {"id":"INT-004","kind":"requirement","text":"Provide a verified one-PR Discovery-to-Build path preserving committed authority, fresh exact launch approval, upstream reconciliation and unrelated local work.","disposition":"open","artifacts":["docs/initiatives/session-resumption/README.md"]},
    {"id":"INT-005","kind":"requirement","text":"Assess DKS retirement validation without weakening manifest ownership, link safety or protected PM and Graphify boundaries; leave irreversible retirement to its original session after fresh inventory-bound no-backup approval.","disposition":"open","artifacts":["docs/initiatives/session-resumption/README.md","docs/specs/dbsctr_knowledge_store/features/dks-state-retirement.md"]},
    {"id":"INT-006","kind":"constraint","text":"Qualify shared fixes before deployment and distinguish fixture success from operator-confirmed progress in the original sessions; never prescribe fresh conversations or permission bypasses as repairs.","disposition":"ready","artifacts":["docs/initiatives/session-resumption/README.md"]}
