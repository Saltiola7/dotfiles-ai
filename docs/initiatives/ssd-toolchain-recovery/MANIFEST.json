  "id": "ssd-toolchain-recovery",
  "title": "SSD toolchain recovery and managed maintenance",
  "state": "discovering",
  "coordinator_repository": "Saltiola7/dotfiles-ai",
  "statements": [
    {"id":"INT-001","kind":"requirement","text":"Verify and restore external-state tools after storage replacement, preserving exact conversations and layout.","disposition":"open","artifacts":["docs/initiatives/ssd-toolchain-recovery/README.md"]},
    {"id":"INT-002","kind":"constraint","text":"Preserve histories, credentials, archives, failed attempts and new V2 work; retain intentional redundant PPC DVC omissions.","disposition":"ready","artifacts":["docs/initiatives/ssd-toolchain-recovery/README.md"]},
    {"id":"INT-003","kind":"constraint","text":"Manage durable setup and external-state routing through chezmoi; verify redundancy before retiring installation ownership. Native updates replace custom updater ownership only after qualification.","disposition":"ready","artifacts":["docs/initiatives/ssd-toolchain-recovery/README.md","docs/initiatives/ssd-toolchain-recovery/NATIVE-UPDATES.md"]},
    {"id":"INT-004","kind":"requirement","text":"Update host tools and Python patch releases while preserving minor-version pins and proving relocated state works.","disposition":"open","artifacts":["docs/initiatives/ssd-toolchain-recovery/README.md"]},
    {"id":"INT-005","kind":"requirement","text":"Upgrade non-production Python environments only after candidate compatibility and runtime qualification.","disposition":"open","artifacts":["docs/initiatives/ssd-toolchain-recovery/README.md"]},
    {"id":"INT-006","kind":"constraint","text":"Exclude enterprise-seo-tools and all production environments; preserve SDS GKE and shared production inputs.","disposition":"ready","artifacts":["docs/initiatives/ssd-toolchain-recovery/README.md"]},
    {"id":"INT-007","kind":"requirement","text":"Keep browser MCPs disconnected by default and manually connectable; restore Tab next-agent and Shift+Tab previous-agent.","disposition":"ready","artifacts":["docs/initiatives/ssd-toolchain-recovery/README.md","docs/specs/opencode_control_plane/features/manual-browser-and-agent-keys.md"]},
    {"id":"INT-008","kind":"requirement","text":"Qualify an existing OpenCode-only hibernator for fifteen-minute idle unfocused sessions, preserving exact conversation identity and excluding working focused or blocked sessions.","disposition":"open","artifacts":["docs/initiatives/ssd-toolchain-recovery/README.md"]},
    {"id":"INT-009","kind":"decision","text":"Draft and exact scroll-position loss are accepted for hibernation; prefer official Herdr integration.","disposition":"ready","artifacts":["docs/initiatives/ssd-toolchain-recovery/README.md"]},
    {"id":"INT-010","kind":"decision","text":"Restarts are authorized with recovery preservation; native permission boundaries and exact launch consent remain enforced.","disposition":"ready","artifacts":["docs/initiatives/ssd-toolchain-recovery/README.md"]},
    {"id":"INT-011","kind":"requirement","text":"Complete original V2 delivery through its existing Initiative, defining fresh provisioning admission without replaying completed migration.","disposition":"open","artifacts":["docs/initiatives/ssd-toolchain-recovery/README.md","docs/initiatives/opencode-rolling-stable/MANIFEST.json"]},
    {"id":"INT-012","kind":"decision","text":"Operator approved dotfiles host ownership, dotfiles-ai runtime ownership and per-project Python ownership; serialize shared writers.","disposition":"ready","artifacts":["docs/initiatives/ssd-toolchain-recovery/README.md","docs/initiatives/ssd-toolchain-recovery/WORKSTREAMS.md"]},
    {"id":"INT-013","kind":"requirement","text":"Use native OpenCode updates on the invoked platform only; supported native installation owns executable updates and chezmoi preserves state routing without downgrade or executable shadowing.","disposition":"ready","artifacts":["docs/initiatives/ssd-toolchain-recovery/NATIVE-UPDATES.md"]},
    {"id":"INT-014","kind":"decision","text":"Replace custom Codex updater ownership with a supported per-platform native installation after proving existing external state and configuration survive; supersede the earlier custom-updater-only requirement.","disposition":"ready","artifacts":["docs/initiatives/ssd-toolchain-recovery/NATIVE-UPDATES.md"]},
    {"id":"INT-015","kind":"constraint","text":"Qualify install, native update, restart and chezmoi reapply against the same external state and exact resumable conversations before retiring old runtime ownership.","disposition":"ready","artifacts":["docs/initiatives/ssd-toolchain-recovery/NATIVE-UPDATES.md"]},
    {"id":"INT-016","kind":"decision","text":"Prepare durable Discovery artifacts before compaction and delegate ownership-disjoint work using native subagents where exposed and permitted; primary retains integration and live deployment ownership.","disposition":"ready","artifacts":["docs/initiatives/ssd-toolchain-recovery/WORKSTREAMS.md"]},
    {"id":"INT-017","kind":"requirement","text":"Complete all previously scoped upgrades and migrations, including host tools, guests, hibernation, non-production Python and lifecycle closure; available stable upgrades remain desired.","disposition":"ready","artifacts":["docs/initiatives/ssd-toolchain-recovery/WORKSTREAMS.md"]}
  ],
