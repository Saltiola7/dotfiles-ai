{
  "schema_version": 1,
  "id": "dbsctr-cycle-speed",
  "title": "Faster quality-equivalent DBSCTR cycles",
  "state": "ready",
  "coordinator_repository": "Saltiola7/dotfiles-ai",
  "statements": [
    {"id": "INT-001", "kind": "requirement", "text": "Use autonomous runtime as the primary cycle-speed metric.", "disposition": "ready", "artifacts": ["docs/initiatives/dbsctr-cycle-speed/README.md", "docs/specs/dbsctr_v3_lifecycle/features/cycle-performance.md"]},
    {"id": "INT-002", "kind": "requirement", "text": "Report calendar elapsed time separately from autonomous runtime.", "disposition": "ready", "artifacts": ["docs/specs/dbsctr_v3_lifecycle/features/cycle-performance.md"]},
    {"id": "INT-003", "kind": "requirement", "text": "Report mean, p50, p90, sample count, attribution coverage, and unavailable count.", "disposition": "ready", "artifacts": ["docs/specs/dbsctr_v3_lifecycle/features/cycle-performance.md"]},
    {"id": "INT-004", "kind": "requirement", "text": "Aggregate host and configured VM sources with explicit per-source availability.", "disposition": "ready", "artifacts": ["docs/initiatives/dbsctr-cycle-speed/README.md"]},
    {"id": "INT-005", "kind": "constraint", "text": "Do not remove, weaken, skip, or infer any required quality or safety evidence.", "disposition": "ready", "artifacts": ["docs/initiatives/dbsctr-cycle-speed/README.md", "docs/specs/dbsctr_v3_lifecycle/features/cycle-performance.md"]},
    {"id": "INT-006", "kind": "decision", "text": "Permit only benchmark-qualified concurrency with equivalent gate evidence and no added remediation.", "disposition": "ready", "artifacts": ["docs/initiatives/dbsctr-cycle-speed/README.md"]},
    {"id": "INT-007", "kind": "constraint", "text": "Keep timing and trend evidence private, bounded, sanitized, and source-local until federation.", "disposition": "ready", "artifacts": ["docs/initiatives/dbsctr-cycle-speed/README.md", "docs/specs/dbsctr_v3_lifecycle/features/cycle-performance.md"]},
    {"id": "INT-008", "kind": "requirement", "text": "Avoid repeated full OpenCode database scans when reporting cycle trends.", "disposition": "ready", "artifacts": ["docs/initiatives/dbsctr-cycle-speed/README.md"]},
    {"id": "INT-009", "kind": "requirement", "text": "Remediate DKS query lock contention and repeated fallback failures without weakening source verification.", "disposition": "ready", "artifacts": ["docs/initiatives/dbsctr-cycle-speed/README.md"]},
    {"id": "INT-010", "kind": "non-goal", "text": "Do not add a tracing backend, hosted telemetry service, or new workflow engine.", "disposition": "ready", "artifacts": ["docs/specs/dbsctr_v3_lifecycle/features/cycle-performance.md"]},
    {"id": "INT-011", "kind": "decision", "text": "Use the approved lifecycle, OpenCode control-plane, distribution, and DKS context map.", "disposition": "ready", "artifacts": ["docs/initiatives/dbsctr-cycle-speed/README.md"]},
    {"id": "INT-012", "kind": "risk", "text": "Historical calendar and sparse phase timing are not an autonomous-runtime baseline.", "disposition": "ready", "artifacts": ["docs/initiatives/dbsctr-cycle-speed/README.md", "docs/specs/dbsctr_v3_lifecycle/features/cycle-performance.md"]},
    {"id": "INT-013", "kind": "requirement", "text": "Provide a reusable report-only skill that audits cycle performance without requiring a bespoke prompt.", "disposition": "ready", "artifacts": ["docs/specs/dbsctr_v3_lifecycle/features/performance-audit.md"]},
    {"id": "INT-014", "kind": "requirement", "text": "Ground audits in sanitized cycle, session, incident, and telemetry evidence while keeping raw session content private.", "disposition": "ready", "artifacts": ["docs/specs/dbsctr_v3_lifecycle/features/performance-audit.md", "docs/specs/opencode_control_plane/features/performance-audit-orchestration.md"]},
    {"id": "INT-015", "kind": "requirement", "text": "Catalogue measured bottlenecks and obvious unmeasured bloat separately across the complete lifecycle.", "disposition": "ready", "artifacts": ["docs/specs/dbsctr_v3_lifecycle/features/performance-audit.md", "docs/initiatives/dbsctr-cycle-speed/README.md"]},
    {"id": "INT-016", "kind": "decision", "text": "Use Scout and Explore only for independent evidence gaps, keep private telemetry local, and never create generic reviewer work.", "disposition": "ready", "artifacts": ["docs/specs/opencode_control_plane/features/performance-audit-orchestration.md"]},
    {"id": "INT-017", "kind": "requirement", "text": "Treat DKS contention, incident scans, and telemetry timeouts as auditable performance and reliability defects with bounded fallback.", "disposition": "ready", "artifacts": ["docs/specs/dbsctr_knowledge_store/features/query-performance.md", "docs/specs/dbsctr_v3_lifecycle/features/performance-audit.md"]},
    {"id": "INT-018", "kind": "requirement", "text": "Prioritize opportunities by impact, frequency, confidence, effort, and quality risk, with explicit acceptance measurements.", "disposition": "ready", "artifacts": ["docs/specs/dbsctr_v3_lifecycle/features/performance-audit.md"]},
    {"id": "INT-019", "kind": "constraint", "text": "Do not claim causality from reviewer, model, token, or elapsed-time associations without comparable cohorts.", "disposition": "ready", "artifacts": ["docs/specs/opencode_control_plane/features/performance-audit-orchestration.md"]},
    {"id": "INT-020", "kind": "requirement", "text": "Reuse exact validation evidence and affected-scope selection where equivalent instead of rerunning unchanged authorities.", "disposition": "ready", "artifacts": ["docs/specs/dbsctr_v3_lifecycle/features/performance-audit.md"]},
    {"id": "INT-021", "kind": "requirement", "text": "Federated trend audits must use immutable captures and explicit source availability instead of repeated live rescans.", "disposition": "ready", "artifacts": ["docs/specs/dotfiles_ai_distribution/features/cycle-performance-trends.md"]},
    {"id": "INT-022", "kind": "non-goal", "text": "The audit skill does not mutate review markers, incidents, cycle state, gates, claims, or optimization activation.", "disposition": "ready", "artifacts": ["docs/specs/dbsctr_v3_lifecycle/features/performance-audit.md"]}
  ],
