{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotfiles-ai.local/dks/benchmark-runner-v2.schema.json",
  "title": "DKS owner-private benchmark runner evidence v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "queries", "duplicate_assessments", "adjudications", "resources", "telemetry_receipts", "run_manifests"],
  "properties": {
    "schema_version": {"const": 2},
    "queries": {"type": "array", "minItems": 100, "items": {"$ref": "#/$defs/query"}},
    "duplicate_assessments": {"type": "array", "minItems": 20, "items": {"$ref": "#/$defs/duplicate"}},
    "adjudications": {"type": "array", "items": {"$ref": "#/$defs/adjudication"}},
    "resources": {"type": "object", "additionalProperties": false, "required": ["code", "reranker"], "properties": {"code": {"$ref": "#/$defs/resource"}, "reranker": {"$ref": "#/$defs/resource"}}},
    "telemetry_receipts": {"type": "object", "additionalProperties": false, "required": ["code", "reranker"], "properties": {"code": {"$ref": "#/$defs/telemetry"}, "reranker": {"$ref": "#/$defs/telemetry"}}},
    "run_manifests": {"type": "object", "additionalProperties": false, "required": ["code", "reranker"], "properties": {"code": {"$ref": "#/$defs/run_manifest"}, "reranker": {"$ref": "#/$defs/run_manifest"}}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ranking": {"type": "array", "minItems": 100, "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "ranking_map": {"$ref": "#/$defs/system_ranking"},
    "system_ranking": {"type": "object", "additionalProperties": false, "required": ["baseline", "code", "reranker", "code_reranker"], "properties": {"baseline": {"$ref": "#/$defs/ranking"}, "code": {"$ref": "#/$defs/ranking"}, "reranker": {"$ref": "#/$defs/ranking"}, "code_reranker": {"$ref": "#/$defs/ranking"}}},
    "citation_list": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
    "system_citations": {"type": "object", "additionalProperties": false, "required": ["baseline", "code", "reranker", "code_reranker"], "properties": {"baseline": {"$ref": "#/$defs/citation_list"}, "code": {"$ref": "#/$defs/citation_list"}, "reranker": {"$ref": "#/$defs/citation_list"}, "code_reranker": {"$ref": "#/$defs/citation_list"}}},
    "depth_ranking": {"type": "object", "additionalProperties": false, "required": ["20", "50", "100"], "properties": {"20": {"type": "array", "minItems": 20, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "50": {"type": "array", "minItems": 50, "maxItems": 50, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "100": {"$ref": "#/$defs/ranking"}}},
    "system_depth_rankings": {"type": "object", "additionalProperties": false, "required": ["baseline", "code", "reranker", "code_reranker"], "properties": {"baseline": {"$ref": "#/$defs/depth_ranking"}, "code": {"$ref": "#/$defs/depth_ranking"}, "reranker": {"$ref": "#/$defs/depth_ranking"}, "code_reranker": {"$ref": "#/$defs/depth_ranking"}}},
    "timings": {"type": "object", "additionalProperties": false, "required": ["warmups", "runs"], "properties": {"warmups": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": 0}}, "runs": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "number", "minimum": 0}}}},
    "depth_timings": {"type": "object", "additionalProperties": false, "required": ["20", "50", "100"], "properties": {"20": {"$ref": "#/$defs/timings"}, "50": {"$ref": "#/$defs/timings"}, "100": {"$ref": "#/$defs/timings"}}},
    "system_depth_timings": {"type": "object", "additionalProperties": false, "required": ["baseline", "code", "reranker", "code_reranker"], "properties": {"baseline": {"$ref": "#/$defs/depth_timings"}, "code": {"$ref": "#/$defs/depth_timings"}, "reranker": {"$ref": "#/$defs/depth_timings"}, "code_reranker": {"$ref": "#/$defs/depth_timings"}}},
    "execution": {"type": "object", "additionalProperties": false, "required": ["run_id", "ranking_sha256", "timings_sha256", "telemetry_sha256"], "properties": {"run_id": {"type": "string", "minLength": 1}, "ranking_sha256": {"$ref": "#/$defs/sha256"}, "timings_sha256": {"$ref": "#/$defs/sha256"}, "telemetry_sha256": {"$ref": "#/$defs/sha256"}}},
    "depth_executions": {"type": "object", "additionalProperties": false, "required": ["20", "50", "100"], "properties": {"20": {"$ref": "#/$defs/execution"}, "50": {"$ref": "#/$defs/execution"}, "100": {"$ref": "#/$defs/execution"}}},
    "system_executions": {"type": "object", "additionalProperties": false, "required": ["baseline", "code", "reranker", "code_reranker"], "properties": {"baseline": {"$ref": "#/$defs/depth_executions"}, "code": {"$ref": "#/$defs/depth_executions"}, "reranker": {"$ref": "#/$defs/depth_executions"}, "code_reranker": {"$ref": "#/$defs/depth_executions"}}},
    "summary_warmups": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": 0}},
    "summary_runs": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "number", "minimum": 0}},
    "repeats": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/ranking"}},
    "system_warmups": {"type": "object", "additionalProperties": false, "required": ["baseline", "code", "reranker", "code_reranker"], "properties": {"baseline": {"$ref": "#/$defs/summary_warmups"}, "code": {"$ref": "#/$defs/summary_warmups"}, "reranker": {"$ref": "#/$defs/summary_warmups"}, "code_reranker": {"$ref": "#/$defs/summary_warmups"}}},
    "system_runs": {"type": "object", "additionalProperties": false, "required": ["baseline", "code", "reranker", "code_reranker"], "properties": {"baseline": {"$ref": "#/$defs/summary_runs"}, "code": {"$ref": "#/$defs/summary_runs"}, "reranker": {"$ref": "#/$defs/summary_runs"}, "code_reranker": {"$ref": "#/$defs/summary_runs"}}},
    "system_repeats": {"type": "object", "additionalProperties": false, "required": ["baseline", "code", "reranker", "code_reranker"], "properties": {"baseline": {"$ref": "#/$defs/repeats"}, "code": {"$ref": "#/$defs/repeats"}, "reranker": {"$ref": "#/$defs/repeats"}, "code_reranker": {"$ref": "#/$defs/repeats"}}},
    "query": {"type": "object", "additionalProperties": false, "required": ["query_id", "stratum", "text", "judgments", "rankings", "expected_citations", "citations", "depth_rankings", "depth_timings", "execution_receipts", "warmups_seconds", "runs_seconds", "repeat_rankings"], "properties": {"query_id": {"type": "string", "minLength": 1}, "stratum": {"type": "string", "minLength": 1}, "text": {"type": "string", "minLength": 1}, "judgments": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 3}}, "rankings": {"$ref": "#/$defs/system_ranking"}, "expected_citations": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}}, "citations": {"$ref": "#/$defs/system_citations"}, "depth_rankings": {"$ref": "#/$defs/system_depth_rankings"}, "depth_timings": {"$ref": "#/$defs/system_depth_timings"}, "execution_receipts": {"$ref": "#/$defs/system_executions"}, "warmups_seconds": {"$ref": "#/$defs/system_warmups"}, "runs_seconds": {"$ref": "#/$defs/system_runs"}, "repeat_rankings": {"$ref": "#/$defs/system_repeats"}}},
    "duplicate": {"type": "object", "additionalProperties": false, "required": ["original_assignment_id", "duplicate_assignment_id", "pair_id", "assessor_id", "query_id", "item_id", "randomization_sha256", "first_grade", "second_grade"], "properties": {"original_assignment_id": {"type": "string", "minLength": 1}, "duplicate_assignment_id": {"type": "string", "minLength": 1}, "pair_id": {"type": "string", "minLength": 1}, "assessor_id": {"type": "string", "minLength": 1}, "query_id": {"type": "string", "minLength": 1}, "item_id": {"type": "string", "minLength": 1}, "randomization_sha256": {"$ref": "#/$defs/sha256"}, "first_grade": {"type": "integer", "minimum": 0, "maximum": 3}, "second_grade": {"type": "integer", "minimum": 0, "maximum": 3}}},
    "adjudication": {"type": "object", "additionalProperties": false, "required": ["pair_id", "adjudicator_id", "final_grade", "reason"], "properties": {"pair_id": {"type": "string", "minLength": 1}, "adjudicator_id": {"type": "string", "minLength": 1}, "final_grade": {"type": "integer", "minimum": 0, "maximum": 3}, "reason": {"type": "string", "minLength": 1}}},
    "resource": {"type": "object", "additionalProperties": false, "required": ["peak_memory_gib", "memory_pressure", "swap_growth_bytes", "hardware_sku", "os_version", "power_state", "thermal_state", "captured_at", "collector_sha256", "raw_telemetry_sha256", "run_manifest_sha256"], "properties": {"peak_memory_gib": {"type": "number", "minimum": 0}, "memory_pressure": {"enum": ["normal", "warning", "critical"]}, "swap_growth_bytes": {"type": "integer", "minimum": 0}, "hardware_sku": {"type": "string", "minLength": 1}, "os_version": {"type": "string", "minLength": 1}, "power_state": {"type": "string", "minLength": 1}, "thermal_state": {"type": "string", "minLength": 1}, "captured_at": {"type": "integer", "minimum": 0}, "collector_sha256": {"$ref": "#/$defs/sha256"}, "raw_telemetry_sha256": {"$ref": "#/$defs/sha256"}, "run_manifest_sha256": {"$ref": "#/$defs/sha256"}}},
    "telemetry": {"type": "object", "additionalProperties": false, "required": ["collector_sha256", "run_manifest_sha256", "run_ids", "samples"], "properties": {"collector_sha256": {"$ref": "#/$defs/sha256"}, "run_manifest_sha256": {"$ref": "#/$defs/sha256"}, "run_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "samples": {"type": "object", "additionalProperties": false, "required": ["peak_memory_gib", "memory_pressure", "swap_growth_bytes", "hardware_sku", "os_version", "power_state", "thermal_state", "captured_at"], "properties": {"peak_memory_gib": {"type": "number", "minimum": 0}, "memory_pressure": {"enum": ["normal", "warning", "critical"]}, "swap_growth_bytes": {"type": "integer", "minimum": 0}, "hardware_sku": {"type": "string", "minLength": 1}, "os_version": {"type": "string", "minLength": 1}, "power_state": {"type": "string", "minLength": 1}, "thermal_state": {"type": "string", "minLength": 1}, "captured_at": {"type": "integer", "minimum": 0}}}}},
    "run_manifest": {"type": "object", "additionalProperties": false, "required": ["collector_sha256", "protocol_digest", "run_ids"], "properties": {"collector_sha256": {"$ref": "#/$defs/sha256"}, "protocol_digest": {"$ref": "#/$defs/sha256"}, "run_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}
  }
}
