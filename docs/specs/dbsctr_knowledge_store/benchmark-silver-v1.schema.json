{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotfiles-ai.local/dks/benchmark-silver-v1.schema.json",
  "title": "DKS committed silver retrieval suite v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark_id", "protocol_version", "evidence_class", "source_revision", "generated_at", "generator", "reviewers", "strata", "candidate_systems", "depths", "trial_duration_seconds", "questions"],
  "properties": {
    "schema_version": {"const": 1},
    "benchmark_id": {"const": "DKS-005"},
    "protocol_version": {"const": "dks-silver-v1"},
    "evidence_class": {"const": "silver"},
    "source_revision": {"const": "45096bb03891e9771a891d53f92b23863ae08a3e"},
    "generated_at": {"type": "integer", "minimum": 0},
    "generator": {"$ref": "#/$defs/modelEvidence"},
    "reviewers": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/modelEvidence"}},
    "strata": {"const": {"code_architecture": 20, "specs_contracts": 20, "operations_recovery": 20, "tickets_history": 20, "configuration_tooling": 20}},
    "candidate_systems": {"const": ["baseline", "code", "reranker", "code_reranker"]},
    "depths": {"const": [20, 50, 100]},
    "trial_duration_seconds": {"const": 604800},
    "questions": {"type": "array", "minItems": 100, "maxItems": 100, "items": {"$ref": "#/$defs/question"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "modelEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "prompt_sha256", "evidence_sha256"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "prompt_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "quote", "grade"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
        "quote": {"type": "string", "minLength": 16},
        "grade": {"const": 3}
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query_id", "stratum", "text", "citations"],
      "properties": {
        "query_id": {"type": "string", "pattern": "^(code_architecture|specs_contracts|operations_recovery|tickets_history|configuration_tooling)-[0-9]{3}$"},
        "stratum": {"enum": ["code_architecture", "specs_contracts", "operations_recovery", "tickets_history", "configuration_tooling"]},
        "text": {"type": "string", "minLength": 1},
        "citations": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/citation"}}
      }
    }
  }
}
