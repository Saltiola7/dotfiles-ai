{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotfiles-ai.local/dks/benchmark-protocol-v2.schema.json",
  "title": "DKS frozen retrieval benchmark protocol v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark_id", "protocol_version", "source_revision", "source_profile_sha256", "source_projection_sha256", "authority_snapshot_set_sha256", "authority_projection_sha256", "privacy_sequence", "privacy_digest", "graph_artifact_sha256", "general_embedding_manifest_sha256", "code_embedding_manifest_sha256", "reranker_manifest_sha256", "query_approval_commit", "judgment_freeze_commit", "query_digest", "protocol_digest", "judgment_digest", "result_digest", "query_count", "strata", "depths", "seed_sha256", "hardware", "authored_at", "assessor_protocol_version", "candidate_systems", "prompts", "chunkers", "metrics", "thresholds", "split", "activation_order", "telemetry_collector_sha256"],
  "properties": {
    "schema_version": {"const": 2},
    "benchmark_id": {"type": "string", "minLength": 1},
    "protocol_version": {"const": "dks-benchmark-v2"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "query_approval_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "judgment_freeze_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_profile_sha256": {"$ref": "#/$defs/sha256"},
    "source_projection_sha256": {"$ref": "#/$defs/sha256"},
    "authority_snapshot_set_sha256": {"$ref": "#/$defs/sha256"},
    "authority_projection_sha256": {"$ref": "#/$defs/sha256"},
    "privacy_sequence": {"type": "integer", "minimum": 0},
    "privacy_digest": {"$ref": "#/$defs/sha256"},
    "graph_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "general_embedding_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "code_embedding_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "reranker_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "query_digest": {"$ref": "#/$defs/sha256"},
    "protocol_digest": {"$ref": "#/$defs/sha256"},
    "judgment_digest": {"$ref": "#/$defs/sha256"},
    "result_digest": {"$ref": "#/$defs/sha256"},
    "query_count": {"type": "integer", "minimum": 100},
    "strata": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 20}},
    "depths": {"const": [20, 50, 100]},
    "seed_sha256": {"$ref": "#/$defs/sha256"},
    "hardware": {"type": "object", "additionalProperties": false, "required": ["sku", "os", "power", "thermal"], "properties": {"sku": {"type": "string", "minLength": 1}, "os": {"type": "string", "minLength": 1}, "power": {"type": "string", "minLength": 1}, "thermal": {"type": "string", "minLength": 1}}},
    "authored_at": {"type": "integer", "minimum": 0},
    "assessor_protocol_version": {"const": "dks-assessor-v2"},
    "candidate_systems": {"const": ["baseline", "code", "reranker", "code_reranker"]},
    "prompts": {"type": "object", "additionalProperties": false, "required": ["general", "code", "reranker"], "properties": {"general": {"$ref": "#/$defs/sha256"}, "code": {"$ref": "#/$defs/sha256"}, "reranker": {"$ref": "#/$defs/sha256"}}},
    "chunkers": {"const": ["dks-markdown-v1", "dks-source-v1", "dks-authority-v1"]},
    "metrics": {"const": ["ndcg10", "recall50", "exact_citation", "latency", "memory"]},
    "thresholds": {"const": {"relative_ndcg10": 0.05, "absolute_ndcg10_zero_baseline": 0.05, "ci95_lower": 0.0, "max_stratum_regression": -0.02, "warm_p95_seconds": 30.0, "peak_memory_gib": 56.0}},
    "split": {"const": {"evaluation": "frozen", "training_queries": 0}},
    "activation_order": {"const": ["baseline", "code", "reranker"]}
    ,"telemetry_collector_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
