#!/bin/bash
set -euo pipefail

{{ if not (or .dotfiles_ai.remote_user_environment.enabled .dotfiles_ai.linux_workstation.enabled) -}}
exit 0
{{ end -}}
target={{ .dotfiles_ai.herdr.executable | quote }}
case "$target" in "~/"*) target="$HOME/${target#\~/}" ;; esac
version={{ .dotfiles_ai.herdr.version | quote }}
{{ if and .dotfiles_ai.linux_workstation.enabled (not .dotfiles_ai.remote_user_environment.enabled) -}}
case "$(uname -s):$(uname -m)" in
    Linux:aarch64|Linux:arm64)
        url={{ .dotfiles_ai.herdr.linux_arm64_asset_url | quote }}
        sha256={{ .dotfiles_ai.herdr.linux_arm64_asset_sha256 | quote }}
        ;;
    Linux:x86_64)
        url={{ .dotfiles_ai.herdr.linux_amd64_asset_url | quote }}
        sha256={{ .dotfiles_ai.herdr.linux_amd64_asset_sha256 | quote }}
        ;;
    *) echo "This workstation profile requires Linux aarch64 or x86_64." >&2; exit 1 ;;
esac
IFS=: read -r -a search_directories <<< "$PATH"
for directory in "${search_directories[@]}"; do
    provider="${directory:-.}/herdr"
    [[ -x $provider ]] || continue
    if [[ -e $target && $provider -ef $target ]]; then continue; fi
    if "$provider" status server --json 2>/dev/null | grep -Eq '"running"[[:space:]]*:[[:space:]]*true'; then
        echo "Herdr ownership review required: active native server at $provider; leaving it unchanged." >&2
        exit 1
    fi
    echo "Herdr ownership review required: existing PATH provider at $provider; configure herdr.executable for its owner instead of shadowing it." >&2
    exit 1
done
if [[ -x $target ]]; then
    if [[ $($target --version 2>/dev/null) == "herdr $version" ]]; then exit 0; fi
    if "$target" status server --json 2>/dev/null | grep -Eq '"running"[[:space:]]*:[[:space:]]*true'; then
        echo "Herdr ownership review required: active server at $target; leaving it unchanged." >&2
        exit 1
    fi
    echo "Herdr ownership review required: existing executable at $target differs from the pin; leaving it unchanged." >&2
    exit 1
fi
if [[ -e $target || -L $target ]]; then
    echo "Herdr ownership review required: existing destination at $target; leaving it unchanged." >&2
    exit 1
fi
{{ else -}}
[[ $(uname -s) == Linux && $(uname -m) == x86_64 ]] || {
    echo "remote user environment requires Linux x86_64" >&2
    exit 1
}
version={{ .dotfiles_ai.herdr.remote_linux_amd64_version | quote }}
url={{ .dotfiles_ai.herdr.remote_linux_amd64_asset_url | quote }}
sha256={{ .dotfiles_ai.herdr.remote_linux_amd64_asset_sha256 | quote }}
managed_remote=1
{{ end -}}
# Only the managed remote skips on the installed digest as well as the version.
if [[ -n ${managed_remote:-} && -x $target && ! -L $target ]] &&
    printf '%s  %s\n' "$sha256" "$target" | sha256sum --check --status &&
    [[ $("$target" --version 2>/dev/null) == "herdr $version" ]]; then
    exit 0
fi
if [[ -z ${managed_remote:-} && -x $target && ! -L $target && $($target --version 2>/dev/null) == "herdr $version" ]]; then
    exit 0
fi
if [[ -x $target ]] && $target status server --json 2>/dev/null | grep -q '"running":true'; then
    echo "stop the remote Herdr server before upgrading its executable" >&2
    exit 1
fi
tmp=$(mktemp -d)
trap 'rm -rf "$tmp" "$target.new"' EXIT
curl -fsSL --retry 3 --retry-all-errors --connect-timeout 10 --max-time 180 "$url" -o "$tmp/herdr"
printf '%s  %s\n' "$sha256" "$tmp/herdr" | sha256sum -c -
install -d -m 0755 "$(dirname "$target")"
install -m 0755 "$tmp/herdr" "$target.new"
[[ $($target.new --version) == "herdr $version" ]] || { echo "managed Herdr version mismatch" >&2; exit 1; }
mv -f "$target.new" "$target"
