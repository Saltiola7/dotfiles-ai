#!/bin/bash
set -euo pipefail

{{ if not .dotfiles_ai.remote_user_environment.enabled -}}
exit 0
{{ end -}}
[[ $(uname -s) == Linux && $(uname -m) == x86_64 ]] || {
    echo "remote user environment requires Linux x86_64" >&2
    exit 1
}
target={{ .dotfiles_ai.herdr.executable | quote }}
case "$target" in "~/"*) target="$HOME/${target#\~/}" ;; esac
version={{ .dotfiles_ai.herdr.version | quote }}
url={{ .dotfiles_ai.herdr.linux_amd64_asset_url | quote }}
sha256={{ .dotfiles_ai.herdr.linux_amd64_asset_sha256 | quote }}
if [[ -x $target && ! -L $target && $($target --version 2>/dev/null) == "herdr $version" ]]; then
    exit 0
fi
if [[ -x $target ]] && $target status server --json 2>/dev/null | grep -q '"running":true'; then
    echo "stop the remote Herdr server before upgrading its executable" >&2
    exit 1
fi
tmp=$(mktemp -d)
trap 'rm -rf "$tmp" "$target.new"' EXIT
curl -fsSL --retry 3 --retry-all-errors --connect-timeout 10 --max-time 180 "$url" -o "$tmp/herdr"
printf '%s  %s\n' "$sha256" "$tmp/herdr" | sha256sum -c -
install -d -m 0755 "$(dirname "$target")"
install -m 0755 "$tmp/herdr" "$target.new"
[[ $($target.new --version) == "herdr $version" ]] || { echo "managed Herdr version mismatch" >&2; exit 1; }
mv -f "$target.new" "$target"
