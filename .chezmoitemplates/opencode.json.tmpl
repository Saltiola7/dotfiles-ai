{{- $references := dict -}}
{{- $worktrees := printf "%s/.local/state/dbsctr/worktrees" .chezmoi.homeDir -}}
{{- if .dotfiles_ai.state.root }}{{ $worktrees = printf "%s/dbsctr/worktrees" .dotfiles_ai.state.root }}{{ end -}}
{{- $_ := set $references "legacy-worktrees" (dict "path" $worktrees "description" "Retained pre-transition worktrees for explicit in-place adoption. Use native Git/Worktrunk inventory; this directory does not allocate or redirect tasks.") -}}
{{- range .dotfiles_ai.sandbox.workspaces -}}
  {{- range .mounts -}}
    {{- if ne .reference_name "" -}}
      {{- $path := .host -}}
      {{- if eq $.chezmoi.os "linux" }}{{ $path = .guest }}{{ end -}}
      {{- if ne .reference_subpath "" }}{{ $path = joinPath $path .reference_subpath }}{{ end -}}
      {{- $_ := set $references .reference_name (dict "path" $path "description" .reference_description) -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "preserve_recent_tokens": 65536
  },
  "provider": {
    "openai": {
      "options": {
        "headerTimeout": 300000,
        "timeout": 600000,
        "chunkTimeout": 300000
      },
      "models": {
        "gpt-6-astra": {
          "limit": { "context": 1050000, "input": 922000, "output": 128000 },
          "variants": {
            "medium": { "reasoningEffort": "medium" }
          }
        },
        "gpt-6-sol": {
          "variants": {
            "medium": { "reasoningEffort": "medium" }
          }
        }
      }
    },
{{ if .dotfiles_ai.opencode.vertex_project -}}
    "google-vertex-anthropic": {
      "options": {
        "project": {{ .dotfiles_ai.opencode.vertex_project | toJson }},
        "location": {{ .dotfiles_ai.opencode.vertex_location | toJson }}{{ if and .dotfiles_ai.opencode.vertex_credentials (not .dotfiles_ai.remote_user_environment.enabled) }},
        "googleAuthOptions": {
          "keyFilename": {{ .dotfiles_ai.opencode.vertex_credentials | toJson }}
        }{{ end }}
      }
    },
{{ end -}}
    "google": {},
    "moonshotai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Moonshot (Kimi)",
      "options": {
        "baseURL": "https://api.moonshot.ai/v1",
        "apiKey": "{env:MOONSHOT_API_KEY}"
      },
      "models": {
        "kimi-k2-turbo-preview": {
          "name": "Kimi K2 Turbo (preview)",
          "limit": { "context": 256000, "output": 8192 }
        },
        "moonshot-v1-32k": {
          "name": "Moonshot v1 32k",
          "limit": { "context": 32000, "output": 4096 }
        }
      }
    },
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": {{ .dotfiles_ai.opencode.lmstudio_base_url | toJson }}
      },
      "models": {
        "mistralai/devstral-small-2-2512": {
          "name": "Devstral Small 2 (MLX 4bit, local)",
          "limit": { "context": 65536, "output": 8192 }
        },
        "qwen/qwen3.6-35b-a3b": {
          "name": "Qwen3.6 35B A3B (MLX 4bit, local)",
          "limit": { "context": 32768, "output": 16384 }
        }
      }
    }
  },
{{ if gt (len $references) 0 -}}
  "references": {
{{- $first := true -}}
{{- range $name, $reference := $references }}
    {{ if not $first }},{{ end }}{{ $name | toJson }}: {
      "path": {{ $reference.path | toJson }},
      "description": {{ $reference.description | toJson }}
    }{{ $first = false -}}
{{- end }}
  },
{{ end -}}
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": { "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}" }
    }{{ if eq .chezmoi.os "darwin" }},
    "1password": {
      "type": "local",
      "command": ["/usr/local/bin/1password-mcp"],
      "enabled": true
    }{{ end }}
  },
  "agent": {
    "build": {
      "permission": {
        "bash": {
          "*dbsctrctl begin*": "allow",
