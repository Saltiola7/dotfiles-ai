<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.dotfiles-ai.herdr-server</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{ printf "%s/.local/bin/herdr-server-owner" .chezmoi.homeDir | html }}</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>{{ .chezmoi.homeDir | html }}</string>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
        <key>LC_CTYPE</key>
        <string>en_US.UTF-8</string>
        <key>PATH</key>
        <string>{{ .chezmoi.homeDir | html }}/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>{{ if .dotfiles_ai.state.root }}
        <key>DOTFILES_AI_STATE_ROOT</key>
        <string>{{ .dotfiles_ai.state.root | html }}</string>
        <key>XDG_DATA_HOME</key>
        <string>{{ printf "%s/xdg/data" .dotfiles_ai.state.root | html }}</string>
        <key>XDG_STATE_HOME</key>
        <string>{{ printf "%s/xdg/state" .dotfiles_ai.state.root | html }}</string>
        <key>DBSCTR_STATE_ROOT</key>
        <string>{{ printf "%s/dbsctr" .dotfiles_ai.state.root | html }}</string>
        <key>DBSCTR_WORKTREE_ROOT</key>
        <string>{{ printf "%s/dbsctr/worktrees" .dotfiles_ai.state.root | html }}</string>
        <key>DBSCTR_RND_STATE</key>
        <string>{{ printf "%s/dbsctr/rnd/dbsctr-rnd.sqlite3" .dotfiles_ai.state.root | html }}</string>
        <key>DBSCTR_RND_RECEIPTS</key>
        <string>{{ printf "%s/dbsctr/rnd/receipts" .dotfiles_ai.state.root | html }}</string>
{{ end }}
    </dict>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>60</integer>
    <key>StandardOutPath</key>
    <string>{{ printf "%s/Library/Logs/herdr-server.log" .chezmoi.homeDir | html }}</string>
    <key>StandardErrorPath</key>
    <string>{{ printf "%s/Library/Logs/herdr-server.err.log" .chezmoi.homeDir | html }}</string>
</dict>
</plist>
