#!/bin/bash
{{ if .dotfiles_ai.state.root -}}
export DOTFILES_AI_STATE_ROOT={{ .dotfiles_ai.state.root | quote }}
export XDG_DATA_HOME={{ printf "%s/xdg/data" .dotfiles_ai.state.root | quote }}
export XDG_STATE_HOME={{ printf "%s/xdg/state" .dotfiles_ai.state.root | quote }}
export DBSCTR_STATE_ROOT={{ printf "%s/dbsctr" .dotfiles_ai.state.root | quote }}
export DBSCTR_WORKTREE_ROOT={{ printf "%s/dbsctr/worktrees" .dotfiles_ai.state.root | quote }}
export DBSCTR_RND_STATE={{ printf "%s/dbsctr/rnd/dbsctr-rnd.sqlite3" .dotfiles_ai.state.root | quote }}
export DBSCTR_RND_RECEIPTS={{ printf "%s/dbsctr/rnd/receipts" .dotfiles_ai.state.root | quote }}
export HERMES_HOME={{ printf "%s/hermes" .dotfiles_ai.state.root | quote }}
[[ -f "$DOTFILES_AI_STATE_ROOT/.dotfiles-ai-state" ]] || {
    echo "centralized state root is unavailable" >&2
    exit 75
}
{{ end -}}

if [[ -n ${HERDR_ENV:-} ]]; then
    auto=0
    session=0
    for argument in "$@"; do
        [[ $argument == --auto ]] && auto=1
        [[ $argument == --session || $argument == --session=* ]] && session=1
    done
    [[ $auto == 1 || ( ${1:-} == session && ${2:-} == list ) ]] || set -- "$@" --auto

    if [[ $session == 1 ]]; then
        startup_dir=${DOTFILES_AI_STATE_ROOT:-${TMPDIR:-/tmp}}/herdr
        /bin/mkdir -p "$startup_dir"
        lock=$startup_dir/opencode-startup.lock
        while ! /usr/bin/shlock -p $$ -f "$lock" 2>/dev/null; do sleep 0.1; done
        trap '/bin/rm -f "$lock"' EXIT
        trap 'exit 130' INT
        trap 'exit 143' TERM

        last=0
        [[ -f $startup_dir/opencode-startup.timestamp ]] && read -r last < "$startup_dir/opencode-startup.timestamp"
        [[ $last =~ ^[0-9]+$ ]] || last=0
        now=$(/bin/date +%s)
        (( last <= now )) || last=0
        (( now - last > 5 )) || sleep "$((6 - now + last))"
        /bin/date +%s > "$startup_dir/opencode-startup.timestamp"

        /bin/rm -f "$lock"
        trap - EXIT INT TERM
    fi
fi
exec /opt/homebrew/bin/opencode "$@"
