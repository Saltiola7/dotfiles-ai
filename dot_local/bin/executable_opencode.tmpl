#!/bin/bash
{{ if .dotfiles_ai.remote_user_environment.enabled -}}
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"
export XDG_CACHE_HOME="$HOME/.cache"
{{ else if .dotfiles_ai.state.root -}}
export DOTFILES_AI_STATE_ROOT={{ .dotfiles_ai.state.root | quote }}
export XDG_DATA_HOME={{ printf "%s/xdg/data" .dotfiles_ai.state.root | quote }}
export XDG_STATE_HOME={{ printf "%s/xdg/state" .dotfiles_ai.state.root | quote }}
export DBSCTR_STATE_ROOT={{ printf "%s/dbsctr" .dotfiles_ai.state.root | quote }}
export DBSCTR_WORKTREE_ROOT=${DBSCTR_WORKTREE_ROOT:-{{ printf "%s/dbsctr/worktrees" .dotfiles_ai.state.root | quote }}}
export DBSCTR_RND_STATE={{ printf "%s/dbsctr/rnd/dbsctr-rnd.sqlite3" .dotfiles_ai.state.root | quote }}
export DBSCTR_RND_RECEIPTS={{ printf "%s/dbsctr/rnd/receipts" .dotfiles_ai.state.root | quote }}
export HERMES_HOME={{ printf "%s/hermes" .dotfiles_ai.state.root | quote }}
[[ -f "$DOTFILES_AI_STATE_ROOT/.dotfiles-ai-state" ]] || {
    echo "centralized state root is unavailable" >&2
    exit 75
}
{{ end -}}

    auto=0
    {{ if and (eq .chezmoi.os "darwin") (eq .chezmoi.arch "arm64") -}}
    interactive=1
    positional=0
    value=0
    explicit_server=0
    argument_index=0
    command_index=0
    for argument in "$@"; do
        argument_index=$((argument_index + 1))
        if [[ $value == 1 ]]; then value=0; continue; fi
        case "$argument" in
            --help|-h|--version|-v|--completions|--wizard) interactive=0 ;;
            --auto) auto=1 ;;
            --session|-s) value=1 ;;
            --session=*) ;;
            --standalone|--server=*) explicit_server=1 ;;
            --server) explicit_server=1; value=1 ;;
            --model|-m|--agent|--prompt|--log-level|--port|--hostname) value=1 ;;
            --continue|-c) ;;
            --*) ;;
            -*) interactive=0 ;;
            *)
                if [[ $positional == 0 ]]; then
                    positional=1
                    case "$argument" in
                        upgrade|update|uninstall|acp|api|debug|auth|mcp|plugin|models|stats|session|service|reload|pair|serve)
                            interactive=0 ;;
                        run|mini) command_index=$argument_index ;;
                        *) [[ -d $argument ]] || interactive=0 ;;
                    esac
                fi
                ;;
        esac
    done
if [[ -n ${HERDR_ENV:-} ]]; then
    if [[ $interactive == 1 ]]; then
        [[ $auto == 1 ]] || set -- "$@" --auto
    fi
    {{ else -}}
if [[ -n ${HERDR_ENV:-} ]]; then
    for argument in "$@"; do
        [[ $argument == --auto ]] && auto=1
    done
    [[ $auto == 1 || ( ${1:-} == session && ${2:-} == list ) ]] || set -- "$@" --auto
    {{ end -}}

fi
{{ if and (eq .chezmoi.os "darwin") (eq .chezmoi.arch "arm64") -}}
target="$HOME/.opencode/bin/opencode"
python3 - "$target" <<'PY' || exit 75
import os, pathlib, stat, sys
p = pathlib.Path(sys.argv[1])
for path in (p.parent.parent, p.parent, p):
    try:
        s = path.lstat()
    except OSError:
        sys.exit("native OpenCode is unavailable; run opencode-install")
    kind = stat.S_ISREG if path == p else stat.S_ISDIR
    if not kind(s.st_mode) or s.st_uid != os.getuid() or s.st_mode & 0o022:
        sys.exit("native OpenCode target is unsafe")
PY
[[ -x $target ]] || { echo "native OpenCode is not executable" >&2; exit 75; }
if [[ $interactive == 1 && $explicit_server == 0 ]]; then
    exec python3 -c '
import json, os, pathlib, stat, subprocess, sys
from urllib.parse import urlsplit
target = sys.argv[1]
environment = os.environ.copy()
def read(*args):
    return subprocess.check_output([target, *args], env=environment, text=True,
                                   stderr=subprocess.DEVNULL, timeout=10).strip()
try:
    server = read("service", "status")
    url = urlsplit(server)
    if url.scheme not in {"http", "https"} or url.hostname not in {"127.0.0.1", "localhost", "::1"} or not url.port:
        raise ValueError("shared service unavailable")
    registration = pathlib.Path(read("debug", "paths", "state")) / "service.json"
    with os.fdopen(os.open(registration, os.O_RDONLY | os.O_NOFOLLOW)) as stream:
        metadata = os.fstat(stream.fileno())
        if (not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.getuid()
                or metadata.st_mode & 0o077 or metadata.st_size > 65536):
            raise ValueError("unsafe native service registration")
        service = json.load(stream)
    if (service.get("url") != server or type(service.get("pid")) is not int
            or not isinstance(service.get("password"), str) or not service["password"]):
        raise ValueError("invalid native service registration")
    # Keep native service credentials in this child environment, never argv/output.
    environment["OPENCODE_PASSWORD"] = service["password"]
    # Explicit server selection never asks native discovery to replace a service.
    info = json.loads(read("api", "--server", server, "get", "/api/info"))
    version = read("--version").removeprefix("opencode v")
    if info.get("version") != version or info.get("pid") != service["pid"]:
        raise ValueError("shared service version mismatch")
    arguments = sys.argv[3:]
    index = int(sys.argv[2])
    arguments[index:index] = ["--server", server]
    launch = [target, *arguments]
    # An explicit authenticated endpoint cannot enter native service replacement.
    os.execvpe(launch[0], launch, environment)
except (OSError, ValueError, AttributeError, subprocess.SubprocessError):
    print("OpenCode start blocked: shared service unavailable or version mismatch; "
          "use a coordinated opencode service start/restart, or explicit --standalone/--server.", file=sys.stderr)
    sys.exit(75)
' "$target" "$command_index" "$@"
fi
exec "$target" "$@"
{{ else if eq .chezmoi.os "linux" -}}
exec "$HOME/.local/bin/opencode-update-all" exec-managed "$@"
{{ else -}}
package="$HOME/.local/state/dotfiles-ai/opencode-package"
if [[ -d $package || -x $HOME/.local/libexec/dotfiles-ai/opencode ]]; then
    exec "$HOME/.local/bin/opencode-update-all" exec-managed "$@"
fi
exec /opt/homebrew/bin/opencode "$@"
{{ end -}}
