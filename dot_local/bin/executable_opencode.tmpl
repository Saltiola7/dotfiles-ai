#!/bin/bash
{{ if .dotfiles_ai.remote_user_environment.enabled -}}
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"
export XDG_CACHE_HOME="$HOME/.cache"
{{ else if .dotfiles_ai.state.root -}}
export DOTFILES_AI_STATE_ROOT={{ .dotfiles_ai.state.root | quote }}
export XDG_DATA_HOME={{ printf "%s/xdg/data" .dotfiles_ai.state.root | quote }}
export XDG_STATE_HOME={{ printf "%s/xdg/state" .dotfiles_ai.state.root | quote }}
export DBSCTR_STATE_ROOT={{ printf "%s/dbsctr" .dotfiles_ai.state.root | quote }}
export DBSCTR_WORKTREE_ROOT=${DBSCTR_WORKTREE_ROOT:-{{ printf "%s/dbsctr/worktrees" .dotfiles_ai.state.root | quote }}}
export DBSCTR_RND_STATE={{ printf "%s/dbsctr/rnd/dbsctr-rnd.sqlite3" .dotfiles_ai.state.root | quote }}
export DBSCTR_RND_RECEIPTS={{ printf "%s/dbsctr/rnd/receipts" .dotfiles_ai.state.root | quote }}
export HERMES_HOME={{ printf "%s/hermes" .dotfiles_ai.state.root | quote }}
{{ if .dotfiles_ai.herdr.host_enabled -}}
if [[ -n ${HERDR_ENV:-} ]]; then
    herdr_host=${HERDR_HOST_BIN:-"$HOME/.local/bin/herdr-host"}
    [[ -x $herdr_host ]] || {
        echo "OpenCode start blocked: Herdr Host health preflight is unavailable; run herdr-host doctor" >&2
        exit 75
    }
    "$herdr_host" preflight --if-active
    preflight_status=$?
    (( preflight_status == 0 )) || exit "$preflight_status"
fi
{{ end -}}
[[ -f "$DOTFILES_AI_STATE_ROOT/.dotfiles-ai-state" ]] || {
    echo "centralized state root is unavailable" >&2
    exit 75
}
{{ end -}}

pace=0
if [[ -n ${HERDR_ENV:-} ]]; then
    auto=0
    session=0
    for argument in "$@"; do
        [[ $argument == --auto ]] && auto=1
        [[ $argument == --session || $argument == --session=* ]] && session=1
    done
    [[ $auto == 1 || ( ${1:-} == session && ${2:-} == list ) ]] || set -- "$@" --auto

    {{ if eq .chezmoi.os "darwin" -}}
    if [[ $session == 1 ]]; then
        [[ -x "$HOME/.local/bin/herdr-opencode-restore" ]] || {
            echo "OpenCode start blocked: pacing helper is unavailable" >&2
            exit 75
        }
        pace=1
    fi
    {{ end -}}
fi
start_opencode() {
    if [[ $pace == 1 ]]; then
        exec "$HOME/.local/bin/herdr-opencode-restore" --pace-start "$@"
    fi
    exec "$@"
}
{{ if eq .chezmoi.os "linux" -}}
start_opencode "$HOME/.local/bin/opencode-update-all" exec-managed "$@"
{{ else -}}
package="$HOME/.local/state/dotfiles-ai/opencode-package"
if [[ -d $package || -x $HOME/.local/libexec/dotfiles-ai/opencode ]]; then
    start_opencode "$HOME/.local/bin/opencode-update-all" exec-managed "$@"
fi
start_opencode /opt/homebrew/bin/opencode "$@"
{{ end -}}
