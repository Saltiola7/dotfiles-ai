        f"server_enabled = {'true' if workspace['name'] == config['atuin_workspace'] else 'false'}",
        "",
        "[data.dotfiles_ai.herdr]",
        f"theme = {quote(guest['theme'])}",
        "launchagent = false",
        'executable = "/usr/local/bin/herdr"',
        "",
        "[data.dotfiles_ai.hermes]",
        f"enabled = {'true' if guest['hermes_enabled'] else 'false'}",
