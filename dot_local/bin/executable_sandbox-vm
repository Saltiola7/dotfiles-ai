def resolve_runtime(config, workspace):
    return workspace["runtime"] or config["guest"]["rnd_runtime"]


def deployment_archive(source):
    source = Path(source)
    if not source.is_absolute() or source.is_symlink() or not (source / ".git").exists():
        raise ValueError("invalid deployment source")
    if command(["git", "-C", str(source), "status", "--porcelain"]):
        raise ValueError("deployment source is dirty")
    revision = command(["git", "-C", str(source), "rev-parse", "HEAD"])
    if not re.fullmatch(r"[0-9a-f]{40}", revision):
        raise ValueError("invalid deployment revision")
    descriptor, archive = tempfile.mkstemp(prefix="dotfiles-ai-deploy-", suffix=".tar.gz")
    os.close(descriptor)
    try:
        command(["git", "-C", str(source), "archive", "--format=tar.gz",
                 f"--add-virtual-file=.dotfiles-ai-deploy-commit:{revision}",
                 f"--output={archive}", "HEAD"], timeout=120)
    except Exception:
        Path(archive).unlink(missing_ok=True)
        raise
    return Path(archive), revision


def update_workspace(config, workspace, execute=command):
    instance = workspace["instance"]
    home = execute(["limactl", "shell", "--start", instance, "--", "printenv", "HOME"], timeout=120)
    if not home.startswith("/home/") or not ID.fullmatch(Path(home).name):
        raise RuntimeError("invalid guest home")
    rootless = execute(["limactl", "shell", instance, "--", "podman", "info", "--format", "{{.Host.Security.Rootless}}"], timeout=120)
    if rootless.strip() != "true":
        raise RuntimeError("workspace requires rootless Podman")
    execute(
        ["limactl", "shell", instance, "--", "sh", "-ceu", """
install -d -m 0700 "$HOME/.config/dotfiles-ai"
tmp=$(mktemp "$HOME/.config/dotfiles-ai/.chezmoi.XXXXXX")
trap 'rm -f "$tmp"' EXIT
sed "s|__GUEST_HOME__|$HOME|g" >"$tmp"
chmod 0600 "$tmp"
mv -f "$tmp" "$HOME/.config/dotfiles-ai/chezmoi.toml"
trap - EXIT
"""],
        timeout=120,
        input_data=guest_config(config, workspace).encode(),
    )
    deployment_source = os.environ.get("DOTFILES_AI_DEPLOY_SOURCE", "")
    if deployment_source:
        archive, revision = deployment_archive(deployment_source)
        remote = f"/tmp/dotfiles-ai-{revision}.tar.gz"
        try:
            execute(["limactl", "copy", str(archive), f"{instance}:{remote}"], timeout=300)
            execute(["limactl", "shell", instance, "--", "sh", "-ceu", '''
archive=$1
expected=$2
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"; rm -f "$archive"' EXIT
mkdir "$tmp/source"
tar -xzf "$archive" -C "$tmp/source"
test "$(cat "$tmp/source/.dotfiles-ai-deploy-commit")" = "$expected"
rm "$tmp/source/.dotfiles-ai-deploy-commit"
chezmoi -S "$tmp/source" -c "$HOME/.config/dotfiles-ai/chezmoi.toml" apply --force \
  "$HOME/.local/bin/dbsctrctl"
chezmoi -S "$tmp/source" -c "$HOME/.config/dotfiles-ai/chezmoi.toml" apply \
  "$HOME/.local/bin/codex" \
  "$HOME/.local/bin/codex-archive" \
  "$HOME/.local/bin/codex-control-plane" \
  "$HOME/.local/bin/codex-install" \
  "$HOME/.local/bin/codex-project" \
  "$HOME/.local/bin/codex-rollback" \
  "$HOME/.config/dotfiles-ai/codex-managed" \
  "$HOME/install-codex.sh" \
  "$HOME/project-codex.sh"
''', "deploy-codex", remote, revision], timeout=600)
        finally:
            archive.unlink(missing_ok=True)
    else:
        source = f"{home}/.local/share/chezmoi-dotfiles-ai"
        execute(["limactl", "shell", instance, "--", "git", "-C", source, "pull", "--ff-only"], timeout=300)
        execute(["limactl", "shell", instance, "--", "chezmoi", "-c",
                 f"{home}/.config/dotfiles-ai/chezmoi.toml", "apply"], timeout=300)
    execute(["limactl", "shell", instance, "--", "sh", "-ceu",
             'exec "$HOME/.local/bin/codex-install"'], timeout=300)
    execute(["limactl", "shell", instance, "--", "sh", "-ceu",
             'exec "$HOME/.local/bin/codex-project" "$HOME/.config/dotfiles-ai/codex-managed" '
             '"$HOME/.local/state/dotfiles-ai/codex"'], timeout=300)


def _instance_state(execute, instance):
    rows = _parse_rows(execute(["limactl", "list", "--json"]))
    current = next((row for row in rows if isinstance(row, dict) and row.get("name") == instance), None)
    if current is None or str(current.get("status", "")).lower() not in {"running", "stopped"}:
        raise ValueError("Lima instance is unavailable")
    return str(current["status"]).lower() == "running", current


def _restore_instance_state(execute, instance, expected_running):
    deadline = time.monotonic() + 30
    actions = 0
    last_error = None
    while time.monotonic() < deadline:
        try:
            rows = _parse_rows(execute(["limactl", "list", "--json"]))
            current = next((row for row in rows if isinstance(row, dict) and row.get("name") == instance), None)
            if current is None:
                raise ValueError("Lima instance is unavailable")
            status = str(current.get("status", "")).lower()
            if status == ("running" if expected_running else "stopped"):
                return
            if status not in {"starting", "stopping", "running", "stopped"}:
                raise ValueError("Lima instance is unavailable")
            if status in {"running", "stopped"}:
                if actions == 3:
                    break
                actions += 1
                execute(["limactl", "start" if expected_running else "stop", instance], timeout=120)
                continue
        except (OSError, RuntimeError, ValueError, subprocess.TimeoutExpired) as error:
            last_error = error
        time.sleep(1)
    raise RuntimeError("failed to restore Lima instance state") from last_error


def install_make(config, workspace, execute=command):
    instance = workspace["instance"]
    lock_root = Path(config["template"]).parent / ".sandbox-lifecycle-locks"
    with _instance_lock(lock_root, instance):
        running, current = _instance_state(execute, instance)
        try:
            if not running:
                execute(["limactl", "start", instance], timeout=120)
            status = execute(["limactl", "shell", instance, "--", "sh", "-c", MAKE_PROBE], timeout=120).strip()
            if status not in {"present", "missing"}:
                raise RuntimeError("invalid GNU Make probe")
        except Exception as error:
            try:
                _restore_instance_state(execute, instance, running)
            except Exception as restore_error:
                raise RuntimeError("GNU Make probe and state restoration failed") from error
            raise
        _restore_instance_state(execute, instance, running)
        if status == "present":
            return

        provisions = current.get("config", {}).get("provision", [])
        owned = sum(item == MAKE_PROVISION for item in provisions if isinstance(item, dict))
        if owned > 1:
            raise RuntimeError("duplicate GNU Make system provision")
        try:
            if running:
                execute(["limactl", "stop", instance], timeout=120)
            if not owned:
                execute(["limactl", "edit", "--yes", "--set", MAKE_PROVISION_RULE, instance], timeout=120)
            execute(["limactl", "start", instance], timeout=300)
            execute(["limactl", "shell", instance, "--", "sh", "-ceu", MAKE_VERIFY], timeout=120)
        except Exception as error:
            try:
                _restore_instance_state(execute, instance, running)
            except Exception as restore_error:
                raise RuntimeError("GNU Make provisioning and state restoration failed") from error
            raise
        _restore_instance_state(execute, instance, running)


def _install_opencode_locked(workspace, execute, running, current):
    instance = workspace["instance"]
    try:
        if not running:
            execute(["limactl", "start", instance], timeout=120)
        status = execute(["limactl", "shell", instance, "--", "sh", "-c", OPENCODE_PROBE], timeout=120).strip()
        if status not in {"present", "missing"}:
            raise RuntimeError("invalid OpenCode probe")
    except Exception as error:
        try:
            _restore_instance_state(execute, instance, running)
        except Exception:
            raise RuntimeError("OpenCode probe and state restoration failed") from error
        raise
    _restore_instance_state(execute, instance, running)

    provisions = current.get("config", {}).get("provision", [])
    owned = [(index, item) for index, item in enumerate(provisions) if isinstance(item, dict)
             and str(item.get("script", "")).startswith(f"{OPENCODE_PROVISION_MARKER}\n")]
    if len(owned) > 1:
        raise RuntimeError("duplicate OpenCode system provision")
    rule = OPENCODE_PROVISION_RULE if not owned else (
        f".provision[{owned[0][0]}] = {json.dumps(OPENCODE_PROVISION, separators=(',', ':'))}")
    provision_current = bool(owned and owned[0][1] == OPENCODE_PROVISION)
    if status == "present" and provision_current:
        return
    try:
        if running:
            execute(["limactl", "stop", instance], timeout=120)
        if not provision_current:
            execute(["limactl", "edit", "--yes", "--set", rule, instance], timeout=120)
        execute(["limactl", "start", instance], timeout=300)
        version = execute(["limactl", "shell", instance, "--", "sh", "-ceu", OPENCODE_VERIFY], timeout=120).strip()
        if version != OPENCODE_VERSION:
            raise RuntimeError("guest OpenCode version mismatch")
    except Exception as error:
        try:
            _restore_instance_state(execute, instance, running)
        except Exception:
            raise RuntimeError("OpenCode provisioning and state restoration failed") from error
        raise
    _restore_instance_state(execute, instance, running)


def install_opencode(config, workspace, execute=command):
    instance = workspace["instance"]
    lock_root = Path(config["template"]).parent / ".sandbox-lifecycle-locks"
    with _instance_lock(lock_root, instance):
        running, current = _instance_state(execute, instance)
        _install_opencode_locked(workspace, execute, running, current)


def _opencode_version(value, source):
    version = value.strip()
    if not re.fullmatch(r"\d+\.\d+\.\d+", version) or version != OPENCODE_VERSION:
        raise RuntimeError(f"{source} OpenCode version mismatch")
    return version


def host_opencode_version(execute=command):
    return _opencode_version(execute([HOST_OPENCODE, "--version"], timeout=30), "host")


def guest_opencode_version(workspace, execute=command):
    value = execute(["limactl", "shell", workspace["instance"], "--",
                     "/usr/local/libexec/opencode", "--version"], timeout=120)
    return _opencode_version(value, workspace["name"])


def _codex_version(value, source):
    version = value.strip()
    matches = re.findall(r"(?<![0-9])\d+\.\d+\.\d+(?![0-9])", version)
    if (len(version) > 128 or re.search(r"[\x00-\x1f\x7f]", version)
            or matches != [CODEX_VERSION]):
        raise RuntimeError(f"{source} Codex version mismatch")
    return matches[0]


def host_codex_version(execute=command):
    return _codex_version(execute([HOST_CODEX, "--version"], timeout=30), "host")


def guest_codex_version(workspace, execute=command):
    value = execute(["limactl", "shell", workspace["instance"], "--", "sh", "-ceu",
                     'exec "$HOME/.local/libexec/dotfiles-ai/codex" --version'], timeout=120)
    return _codex_version(value, workspace["name"])


def verify_opencode_parity(config, workspace, execute=command):
    host = host_opencode_version(execute)
    instance = workspace["instance"]
    lock_root = Path(config["template"]).parent / ".sandbox-lifecycle-locks"
    with _instance_lock(lock_root, instance):
        running, _ = _instance_state(execute, instance)
        try:
            if not running:
                execute(["limactl", "start", instance], timeout=120)
            guest = guest_opencode_version(workspace, execute)
        finally:
            _restore_instance_state(execute, instance, running)
    return {"host": host, "guest": guest, "instance": instance}


def verify_codex_version_parity(config, workspace, execute=command):
    host = host_codex_version(execute)
    instance = workspace["instance"]
    lock_root = Path(config["template"]).parent / ".sandbox-lifecycle-locks"
    with _instance_lock(lock_root, instance):
        running, _ = _instance_state(execute, instance)
        try:
            if not running:
                execute(["limactl", "start", instance], timeout=120)
            guest = guest_codex_version(workspace, execute)
        finally:
            _restore_instance_state(execute, instance, running)
    return {"host": host, "guest": guest, "instance": instance}


def _rollback_code():
    installed = Path(__file__).with_name("codex-rollback")
    source = Path(__file__).with_name("executable_codex-rollback")
    path = installed if installed.exists() else source
    value = path.read_bytes()
    if not value or len(value) > 256 * 1024:
        raise RuntimeError("Codex rollback helper is unavailable")
    return value


def codex_snapshot(workspace, execute=command):
    token = execute(["limactl", "shell", workspace["instance"], "--", "python3", "-", "snapshot"],
                    timeout=120, input_data=_rollback_code()).strip()
    if not re.fullmatch(r"[0-9a-f]{32}", token):
        raise RuntimeError("invalid Codex rollback token")
    return token


def codex_restore(workspace, token, execute=command):
    execute(["limactl", "shell", workspace["instance"], "--", "python3", "-", "restore", token],
            timeout=300, input_data=_rollback_code())


def codex_discard(workspace, token, execute=command):
    execute(["limactl", "shell", workspace["instance"], "--", "python3", "-", "discard", token],
            timeout=120, input_data=_rollback_code())


def _snapshot_action(config, workspace, token, action, execute):
    instance = workspace["instance"]
    lock_root = Path(config["template"]).parent / ".sandbox-lifecycle-locks"
    with _instance_lock(lock_root, instance):
        running, _ = _instance_state(execute, instance)
        try:
            if not running:
                execute(["limactl", "start", instance], timeout=120)
            action(workspace, token, execute)
        finally:
            _restore_instance_state(execute, instance, running)


def update_managed_workspace(config, workspace, execute=command, installer=None, updater=None,
                             snapshotter=codex_snapshot, restorer=codex_restore,
                             discarder=codex_discard, retain_backup=False):
    instance = workspace["instance"]
    lock_root = Path(config["template"]).parent / ".sandbox-lifecycle-locks"
    with _instance_lock(lock_root, instance):
        running, current = _instance_state(execute, instance)
        token = None
        try:
            if installer is None:
                _install_opencode_locked(workspace, execute, running, current)
            else:
                installer(config, workspace, execute)
            if not running:
                execute(["limactl", "start", instance], timeout=120)
            token = snapshotter(workspace, execute)
            if updater is not None:
                updater(config, workspace, execute)
            result = {
                "opencode": guest_opencode_version(workspace, execute),
                "codex": guest_codex_version(workspace, execute),
            }
            if not retain_backup:
                discarder(workspace, token, execute)
                token = None
        except Exception as error:
            if token is not None:
                try:
                    restorer(workspace, token, execute)
                except Exception as rollback_error:
                    raise RuntimeError("Codex update and rollback failed") from rollback_error
            raise
        finally:
            _restore_instance_state(execute, instance, running)
    return (result, token) if retain_backup else result


def update_all_workspaces(config, execute=command, installer=None, updater=None,
                          snapshotter=codex_snapshot, restorer=codex_restore,
                          discarder=codex_discard):
    host = host_opencode_version(execute)
    codex_host = host_codex_version(execute)
    updater = update_workspace if updater is None else updater
    versions = {}
    retained = []
    try:
        for workspace in config["workspaces"]:
            versions[workspace["name"]], token = update_managed_workspace(
                config, workspace, execute, installer, updater, snapshotter,
                restorer, discarder, retain_backup=True)
            retained.append((workspace, token))
    except Exception as error:
        rollback_errors = []
        for workspace, token in reversed(retained):
            try:
                _snapshot_action(config, workspace, token, restorer, execute)
            except Exception as rollback_error:
                rollback_errors.append(rollback_error)
        if rollback_errors:
            raise RuntimeError("ordered Codex rollout and rollback failed") from error
        raise
    for workspace, token in retained:
        _snapshot_action(config, workspace, token, discarder, execute)
    return {
        "host": host,
        "workspaces": {name: value["opencode"] for name, value in versions.items()},
        "codex": {
            "host": codex_host,
            "workspaces": {name: value["codex"] for name, value in versions.items()},
        },
    }


def service_token(config, execute=command):
    settings = config["onepassword"]
    if not settings["enabled"]:
        return None
    token = execute([
        "/usr/bin/security", "find-generic-password", "-s", settings["keychain_service"],
        "-a", settings["account"], "-w",
    ], timeout=10)
    if not token or len(token) > 4096 or re.search(r"[\x00-\x20\x7f]", token):
        raise RuntimeError("1Password service token is unavailable")
    validation_env = {**os.environ, "OP_SERVICE_ACCOUNT_TOKEN": token}
    execute(["op", "vault", "list"], timeout=10, environment=validation_env)
    return token


def shell_environment(config):
    names = ("HOME", "PATH", "USER", "LOGNAME", "SHELL", "TMPDIR", "LIMA_HOME")
    environment = {name: os.environ[name] for name in names if name in os.environ}
    environment["TERM"] = os.environ.get("LIMA_TERM", "xterm-256color")
    token = service_token(config)
    if token:
        environment["OP_SERVICE_ACCOUNT_TOKEN"] = token
        environment["LIMA_SHELLENV_ALLOW"] = "OP_SERVICE_ACCOUNT_TOKEN"
    return environment


def render_workspace(config, workspace, template=None):
    template = Path(config["template"]).read_text() if template is None else template
    mounts = []
    for mount in workspace["mounts"]:
        mounts.extend([
            f"  - location: {json.dumps(mount['host'])}",
            f"    mountPoint: {json.dumps(mount['guest'])}",
            f"    writable: {'true' if mount['writable'] else 'false'}",
        ])
    forwards = []
    if workspace["name"] == config["atuin_workspace"]:
        forwards.append(ATUIN_PORT_FORWARD)
    port_forwards = []
    if forwards:
        port_forwards.append("portForwards:")
        for forward in forwards:
            port_forwards.extend([
                f"- guestPort: {forward['guestPort']}",
                f"  hostPort: {forward['hostPort']}",
                f"  guestIP: {json.dumps(forward['guestIP'])}",
                f"  hostIP: {json.dumps(forward['hostIP'])}",
            ])
    values = {
        "@@MOUNTS@@": "\n".join(mounts),
        "@@WORKSPACE_JSON@@": json.dumps({"mounts": workspace["mounts"]}, sort_keys=True, separators=(",", ":")),
        "@@SOURCE@@": config["source"],
        "@@OPENCODE_INSTALL@@": OPENCODE_INSTALL.rstrip().replace("\n", "\n      "),
        "@@GUEST_CONFIG@@": guest_config(config, workspace).rstrip().replace("\n", "\n      "),
        "@@PORT_FORWARDS@@": "\n".join(port_forwards),
    }
    for marker, replacement in values.items():
        template = template.replace(marker, replacement)
    if "@@" in template:
        raise ValueError("workspace template contains an unknown marker")
    return template


def tailscale_enroll(config, workspace, stream, execute=command):
    if not config["tailscale"]["enabled"]:
        raise ValueError("Tailscale is disabled")
    raw = stream.read(1025)
    key = raw.rstrip(b"\r\n")
    if len(raw) > 1024 or not TAILSCALE_AUTH_KEY.fullmatch(key):
        raise ValueError("invalid Tailscale auth key")
    instance = workspace["instance"]
    lock_root = Path(config["template"]).parent / ".sandbox-lifecycle-locks"
    with _instance_lock(lock_root, instance):
        execute(["limactl", "shell", instance, "--", "sh", "-ceu", TAILSCALE_INSTALL], timeout=300)
        up = "exec \"$HOME/.local/bin/tailscale\" --socket=\"$XDG_RUNTIME_DIR/tailscale/tailscaled.sock\" up --auth-key=file:/dev/stdin"
        if config["tailscale"]["ssh"]:
            up += " --ssh"
        execute(["limactl", "shell", instance, "--", "sh", "-ceu", up],
                timeout=120, input_data=key + b"\n")


def configure_atuin(config, remove=False, execute=command, state_path=None):
    state_path = state_path or Path(config["template"]).parent / ".atuin-workspace"
    previous = state_path.read_text().strip() if state_path.exists() else ""
    if remove and not previous:
        return
    selected = previous if remove else config["atuin_workspace"]
    if previous and not remove and previous != selected:
        raise ValueError("remove the prior Atuin workspace before selecting another")
    workspace = workspace_map(config).get(selected)
    if workspace is None:
        raise ValueError("Atuin workspace is not configured")
    instance = workspace["instance"]
    lock_root = Path(config["template"]).parent / ".sandbox-lifecycle-locks"
    with _instance_lock(lock_root, instance):
        rows = _parse_rows(execute(["limactl", "list", "--json"]))
        current = next((row for row in rows if row.get("name") == instance), None)
        if current is None or not isinstance(current.get("config"), dict):
            raise ValueError("Lima instance configuration is unavailable")
        running = str(current.get("status", "")).lower() == "running"
        if remove:
            update_workspace(config, workspace, execute=execute)
        if running or remove:
            execute(["limactl", "stop", instance], timeout=120)
        try:
            forwards = current["config"].get("portForwards", [])
            rule = atuin_port_rule(forwards, remove=remove)
            execute(["limactl", "edit", "--yes", "--set", rule, instance], timeout=120)
        finally:
            if running:
                execute(["limactl", "start", instance], timeout=120)
    if remove:
        state_path.unlink(missing_ok=True)
    else:
        state_path.write_text(selected + "\n")


def configure_pm_postgres(config, remove=False, execute=command, state_path=None):
    state_path = state_path or Path(config["template"]).parent / ".pm-postgres-workspace"
    previous = state_path.read_text().strip() if state_path.exists() else ""
    if remove and not previous:
        rows = _parse_rows(execute(["limactl", "list", "--json"]))
        if any(all(item.get(key) == value for key, value in PM_POSTGRES_PORT_FORWARD.items())
               for row in rows if isinstance(row, dict) and isinstance(row.get("config"), dict)
               for item in row["config"].get("portForwards", []) if isinstance(item, dict)):
            raise ValueError("PM PostgreSQL forward ownership state is unavailable")
        return
    selected = previous if remove else config["pm_kernel"]["workspace"]
    if previous and not remove and previous != selected:
        raise ValueError("remove the prior PM PostgreSQL workspace before selecting another")
    workspace = workspace_map(config).get(selected)
    if workspace is None or not remove and not config["pm_kernel"]["postgres_enabled"]:
        raise ValueError("PM PostgreSQL workspace is not configured")
    instance = workspace["instance"]
    lock_root = Path(config["template"]).parent / ".sandbox-lifecycle-locks"
    with _instance_lock(lock_root, instance):
        rows = _parse_rows(execute(["limactl", "list", "--json"]))
        current = next((row for row in rows if row.get("name") == instance), None)
        if current is None or not isinstance(current.get("config"), dict):
            raise ValueError("Lima instance configuration is unavailable")
        running = str(current.get("status", "")).lower() == "running"
        if remove:
            update_workspace(config, workspace, execute=execute)
        if running or remove:
            execute(["limactl", "stop", instance], timeout=120)
        try:
            forwards = current["config"].get("portForwards", [])
            if (not remove and not previous and any(
                    all(item.get(key) == value for key, value in PM_POSTGRES_PORT_FORWARD.items())
                    for item in forwards if isinstance(item, dict))):
                raise ValueError("existing PM PostgreSQL forward has no ownership state")
            rule = pm_postgres_port_rule(forwards, remove=remove)
            execute(["limactl", "edit", "--yes", "--set", rule, instance], timeout=120)
        finally:
            if running:
                execute(["limactl", "start", instance], timeout=120)
    if remove:
        state_path.unlink(missing_ok=True)
    else:
        state_path.write_text(selected + "\n")


def provision_pm_postgres(config, stream, execute=command):
    pm_kernel = config["pm_kernel"]
    workspace = workspace_map(config).get(pm_kernel["workspace"])
    if workspace is None or not pm_kernel["enabled"] or not pm_kernel["postgres_enabled"]:
        raise ValueError("PM PostgreSQL workspace is not configured")
    raw = stream.read(1025)
    password = raw.rstrip(b"\r\n")
    if len(raw) > 1024 or len(password) < 24 or re.search(rb"[\x00-\x20\x7f]", password):
        raise ValueError("invalid PM PostgreSQL password")
    execute([
        "limactl", "shell", workspace["instance"], "--", "podman", "secret", "create",
        "--replace", "pm-postgres-password", "-",
    ], timeout=120, input_data=password)


def status_report(config, execute=command, lima_root=None):
    try:
        running = _parse_states(execute(["limactl", "list", "--json"]))
    except (OSError, RuntimeError, ValueError, json.JSONDecodeError, subprocess.TimeoutExpired):
        running = {}
    root = lima_root or Path(config["lima_home"] or os.environ.get("LIMA_HOME", "") or Path.home() / ".lima")
    workspaces = {}
    for workspace in config["workspaces"]:
        name = workspace["name"]
        instance = workspace["instance"]
        workspaces[name] = {
            "instance": instance,
            "running": running.get(instance, False),
            "allocated_bytes": allocated_bytes(root / instance),
        }
    return {
        "schema_version": 1,
        "host_free_bytes": shutil.disk_usage(root).free if root.exists() else None,
        "workspaces": workspaces,
    }


def _namespace(value, source):
    if isinstance(value, list):
        return [_namespace(item, source) for item in value]
    if not isinstance(value, dict):
        return value
    result = {}
    for key, item in value.items():
        if key in {"session_id", "cycle_id", "parent_session_id"} and isinstance(item, str):
            result[key] = f"{source}:{item}"
        elif key in {"session_ids", "cycle_ids"} and isinstance(item, list):
            result[key] = [f"{source}:{entry}" for entry in item]
        else:
            result[key] = _namespace(item, source)
    return result


def _exact(value, keys):
    return isinstance(value, dict) and set(value) == keys


def _safe_values(value):
    if isinstance(value, str):
        return len(value) <= 512 and not (UNSAFE.search(json.dumps(value)) or EMAIL.search(value) or SECRET.search(value))
    if isinstance(value, list):
        return all(_safe_values(item) for item in value)
    if isinstance(value, dict):
        return all(isinstance(key, str) and len(key) <= 128 and ID.fullmatch(key)
                   and not SECRET.search(f"{key}:") and _safe_values(item)
                   for key, item in value.items())
    return value is None or isinstance(value, (bool, int, float))


def _nonnegative(value):
    return not isinstance(value, bool) and isinstance(value, (int, float)) and math.isfinite(value) and value >= 0


def _nonnegative_integer(value):
    return isinstance(value, int) and not isinstance(value, bool) and value >= 0


def _valid_phase_profile(profile, cycle_id):
    if profile is None:
        return True
    return (_exact(profile, PHASE_KEYS) and profile.get("schema_version") == 1
            and profile.get("cycle_id") == cycle_id and profile.get("status") in {"complete", "unavailable"}
            and all(value == "unavailable" or _nonnegative_integer(value)
                    for value in (profile.get("critical_path_ms"), profile.get("total_wall_ms"), profile.get("overlap_ms")))
            and _nonnegative_integer(profile.get("repeated_work"))
            and isinstance(profile.get("principal_waits"), list)
            and all(_exact(wait, {"span_id", "wait_ms"}) and isinstance(wait["span_id"], str)
                    and ID.fullmatch(wait["span_id"]) and _nonnegative_integer(wait["wait_ms"])
                    for wait in profile["principal_waits"])
            and isinstance(profile.get("attribution_caveats"), list)
            and all(isinstance(item, str) and ID.fullmatch(item) for item in profile["attribution_caveats"]))


def _valid_candidate(candidate):
    if (not (_exact(candidate, CANDIDATE_KEYS) or _exact(candidate, CURRENT_CANDIDATE_KEYS))
            or not _exact(candidate.get("aggregates"), AGGREGATE_KEYS)
            or type(candidate.get("review_session", False)) is not bool):
        return False
    telemetry = candidate.get("telemetry")
    current_telemetry = _exact(telemetry, TELEMETRY_KEYS)
    legacy_telemetry = _exact(telemetry, LEGACY_TELEMETRY_KEYS)
    if (not current_telemetry and not legacy_telemetry
            or not _exact(telemetry.get("availability"), AVAILABILITY_KEYS if current_telemetry else LEGACY_AVAILABILITY_KEYS)):
        return False
    cycles = candidate.get("cycles")
    if not isinstance(cycles, list):
        return False
    for cycle in cycles:
        interval_fields = {"context", "started_at", "ended_at"}
        has_interval = isinstance(cycle, dict) and interval_fields <= set(cycle)
        if (not isinstance(cycle, dict) or set(cycle) - {"cycle_id", "state", "risk", "delivery_intent", "phase_profile", "metrics", "harness_activation", *interval_fields}
                or not {"cycle_id", "state"} <= set(cycle)
                or cycle.get("risk", "unavailable") not in {"routine", "elevated", "critical", "unavailable"}
                or cycle.get("delivery_intent", "unavailable") not in {"local", "merge", "release", "deploy", "draft_pr", "unavailable"}
                or bool(interval_fields.intersection(cycle)) != has_interval
                or has_interval and (not isinstance(cycle["context"], str) or not ID.fullmatch(cycle["context"])
                    or not _nonnegative_integer(cycle["started_at"])
                    or cycle["ended_at"] is not None and (not _nonnegative_integer(cycle["ended_at"])
                        or cycle["ended_at"] < cycle["started_at"]))):
            return False
        if not _valid_phase_profile(cycle.get("phase_profile"), cycle.get("cycle_id")):
            return False
    unavailable = lambda value: value == "unavailable" or _nonnegative(value)
    if (candidate.get("schema_version") != 1 or not ID.fullmatch(candidate.get("session_id", ""))
            or not all(_nonnegative_integer(candidate.get(name))
                       for name in ("snapshot", "session_ceiling", "part_ceiling"))
            or not isinstance(candidate.get("database_digest"), str)
            or not DIGEST.fullmatch(candidate["database_digest"])
            or candidate.get("project_digest") != "unavailable"
            and (not isinstance(candidate.get("project_digest"), str)
                 or not DIGEST.fullmatch(candidate["project_digest"]))
            or not isinstance(candidate.get("context"), str) or not ID.fullmatch(candidate["context"])
            or candidate.get("completed_at") is not None
            and (not isinstance(candidate["completed_at"], str)
                 or not re.fullmatch(r"(?:\d{10,16}|\d{4}-\d{2}-\d{2}T[^\s]{1,40}Z)", candidate["completed_at"]))
            or candidate.get("reviewed_status") not in {"reviewed", "unreviewed"}
            or candidate.get("correlation_quality") not in {"exact", "family", "worktree", "source", "ambiguous", "unavailable"}
            or not isinstance(candidate.get("method_revision"), str)
            or not re.fullmatch(r"(?:\d+(?:\.\d+)*|unavailable)", candidate["method_revision"])
            or any(not ID.fullmatch(cycle.get("cycle_id", ""))
                   or cycle.get("state") not in {"active", "blocked", "abandoned", "completed", "unknown"}
                   for cycle in cycles)
            or any(not (_nonnegative(candidate["aggregates"][name]) if name == "cost_total"
                        else _nonnegative_integer(candidate["aggregates"][name]))
                   and candidate["aggregates"][name] != "unavailable" for name in AGGREGATE_KEYS)
            or not all(telemetry[name] == "unavailable" or _nonnegative_integer(telemetry[name])
                       for name in ("approval_count", "retry_count", "delegation_count", "token_total"))
            or not unavailable(telemetry["cost_total"])
            or not (telemetry["model_families"] == "unavailable"
                    or isinstance(telemetry["model_families"], list) and all(isinstance(item, str) and ID.fullmatch(item) for item in telemetry["model_families"]))
            or not (telemetry["error_classes"] == "unavailable" or isinstance(telemetry["error_classes"], dict)
                    and all(ID.fullmatch(key) and _nonnegative_integer(value) for key, value in telemetry["error_classes"].items()))
            or telemetry["attribution_status"] not in {"exact", "family", "worktree", "source", "ambiguous", "unavailable"}
            or any(value not in {"available", "unavailable"} for value in telemetry["availability"].values())
            or current_telemetry and (telemetry.get("schema_version") != 2
                or telemetry.get("session_relation") not in {"primary", "child", "unavailable"}
                or any(telemetry[name] != "unavailable" and (not isinstance(telemetry[name], list)
                    or not telemetry[name] or any(not isinstance(item, str) or not ID.fullmatch(item)
                                                   for item in telemetry[name]))
                       for name in ("provider_ids", "model_ids", "agent_ids", "core_revisions", "overlay_revisions"))
                or any(telemetry[name] != "unavailable" and not _nonnegative_integer(telemetry[name])
                       for name in ("gate_failure_count", "gate_reopen_count", "remediation_round_count")))):
        return False
    for cycle in cycles:
        metrics = cycle.get("metrics")
        if metrics is not None and (not _exact(metrics, {"elapsed_ms", "gate_failure_count", "gate_reopen_count", "remediation_round_count"})
                or metrics["elapsed_ms"] != "unavailable" and not _nonnegative_integer(metrics["elapsed_ms"])
                or any(not _nonnegative_integer(metrics[name]) for name in ("gate_failure_count", "gate_reopen_count", "remediation_round_count"))):
            return False
        activation = cycle.get("harness_activation")
        if activation is not None and (not _exact(activation, {"schema_version", "provider_id", "model_id", "agent_id", "core_revision", "overlay_revision"})
                or activation.get("schema_version") != 1
                or any(not isinstance(activation.get(name), str) or not ID.fullmatch(activation[name])
                       for name in ("provider_id", "model_id", "agent_id", "core_revision", "overlay_revision"))):
            return False
    return _safe_values(candidate)


def _valid_query(query):
    return (_exact(query, QUERY_KEYS) and isinstance(query.get("archive_only"), bool)
            and all(item is None or _nonnegative_integer(item) for item in (query.get("after"), query.get("before")))
            and all(item is None or isinstance(item, str) and ID.fullmatch(item)
                    for item in (query.get("context"), query.get("cycle_id")))
            and (query.get("method_revision") is None or isinstance(query["method_revision"], str)
                 and re.fullmatch(r"\d+(?:\.\d+)*", query["method_revision"]))
            and (query.get("project_digest") is None or isinstance(query["project_digest"], str)
                 and DIGEST.fullmatch(query["project_digest"]))
            and query.get("reviewed_status") in {None, "reviewed", "unreviewed"}
            and query.get("state") in {None, "active", "blocked", "abandoned", "completed", "unknown"})


def _source_page(source, output, limit, cursor, previous=None, filters=None):
    if len(output.encode()) > MAX_OUTPUT or UNSAFE.search(output):
        raise ValueError("unsafe output")
    value = json.loads(output)
    if (not _exact(value, PAGE_KEYS) or value.get("schema_version") != 1
            or not isinstance(value.get("capture_id"), str) or not re.fullmatch(r"[0-9a-f]{24}", value["capture_id"])
            or not _exact(value.get("query"), QUERY_KEYS)):
        raise ValueError("invalid history page")
    if value.get("limit") != limit or value.get("cursor") != cursor or not isinstance(value.get("candidates"), list):
        raise ValueError("invalid history page")
    if (not all(_nonnegative_integer(value.get(name))
                for name in ("snapshot", "session_ceiling", "part_ceiling"))
            or not isinstance(value.get("database_digest"), str)
            or not re.fullmatch(r"[0-9a-f]{64}", value["database_digest"])
            or value.get("exclusion_digest") is not None
            and not re.fullmatch(r"[0-9a-f]{64}", value["exclusion_digest"])
            or value.get("continuation") is not None
            and (not _nonnegative_integer(value["continuation"]) or value["continuation"] <= cursor)):
        raise ValueError("invalid history identity")
    query = value["query"]
    if (not _valid_query(query) or filters is not None and query != filters
            or not isinstance(value.get("digest"), str) or not DIGEST.fullmatch(value["digest"])
            or not isinstance(value.get("session_ids"), list)
            or any(not isinstance(item, str) or not ID.fullmatch(item) for item in value["session_ids"])):
        raise ValueError("invalid history values")
    if previous is not None:
        for key in ("capture_id", "snapshot", "session_ceiling", "part_ceiling", "database_digest", "exclusion_digest"):
            if value.get(key) != previous.get(key):
                raise ValueError("source identity changed")
    if len(value["candidates"]) > limit or any(not _valid_candidate(candidate) for candidate in value["candidates"]):
        raise ValueError("invalid history page")
    state = {
        "source_id": source,
        "capture_id": value["capture_id"],
        "snapshot": value["snapshot"],
        "session_ceiling": value["session_ceiling"],
        "part_ceiling": value["part_ceiling"],
        "database_digest": value["database_digest"],
        "exclusion_digest": value.get("exclusion_digest"),
        "query_digest": hashlib.sha256(json.dumps(filters, sort_keys=True, separators=(",", ":")).encode()).hexdigest(),
        "continuation": value["continuation"],
    }
    page = _namespace(value, source)
    page["query"] = value["query"]
    return {"source_id": source, "availability": "available", "page": page}, state


def _valid_source_state(value):
    return (_exact(value, {"source_id", "capture_id", "snapshot", "session_ceiling", "part_ceiling", "database_digest",
                           "exclusion_digest", "query_digest", "continuation"})
            and isinstance(value["source_id"], str) and ID.fullmatch(value["source_id"])
            and isinstance(value["capture_id"], str) and re.fullmatch(r"[0-9a-f]{24}", value["capture_id"])
            and all(isinstance(value[name], int) and not isinstance(value[name], bool) and value[name] >= 0
                    for name in ("snapshot", "session_ceiling", "part_ceiling"))
            and isinstance(value["database_digest"], str) and DIGEST.fullmatch(value["database_digest"])
            and (value["exclusion_digest"] is None
                 or isinstance(value["exclusion_digest"], str) and DIGEST.fullmatch(value["exclusion_digest"]))
            and isinstance(value["query_digest"], str) and DIGEST.fullmatch(value["query_digest"])
            and (value["continuation"] is None
                 or isinstance(value["continuation"], int) and not isinstance(value["continuation"], bool)
                  and value["continuation"] >= 0))


def _manifest_identity(filters, sources):
    identity = []
    for source in sources:
        item = {"source_id": source["source_id"], "availability": source["availability"]}
        if source["availability"] == "available":
            page = source["page"]
            item.update({name: page[name] for name in (
                "capture_id", "snapshot", "session_ceiling", "part_ceiling", "database_digest",
                "exclusion_digest", "limit", "cursor", "continuation", "digest",
            )})
        identity.append(item)
    return {"filters": filters, "sources": identity}


def federated_review(config, limit=25, cursor=0, source_state=None, execute=command, filters=None,
                     excluded_session_id=None, excluded_message_id=None):
    validate_config(config)
    if not 1 <= limit <= 100 or cursor < 0:
        raise ValueError("invalid pagination")
    if any(value is not None and (not isinstance(value, str) or not ID.fullmatch(value))
           for value in (excluded_session_id, excluded_message_id)):
        raise ValueError("invalid excluded history identity")
    filters = {key: (False if key == "archive_only" else None) for key in QUERY_KEYS} | (filters or {})
    if not _valid_query(filters):
        raise ValueError("invalid history filters")
    query_digest = hashlib.sha256(json.dumps(filters, sort_keys=True, separators=(",", ":")).encode()).hexdigest()
    federated = [workspace for workspace in config["workspaces"] if workspace["federate"]]
    expected_sources = {"host", *(workspace["name"] for workspace in federated)}
    continuation_states = {}
    if source_state is not None:
        if (not isinstance(source_state, list) or len(source_state) != len(expected_sources)
                or not all(_valid_source_state(item) for item in source_state)
                or {item["source_id"] for item in source_state} != expected_sources
                or any(item["query_digest"] != query_digest for item in source_state)):
            raise ValueError("invalid source state")
        continuation_states = {item["source_id"]: item for item in source_state}
    sources = [None] * (len(federated) + 1)
    states = [None] * len(sources)
    host_state = continuation_states.get("host")
    host_cursor = host_state.get("continuation") if host_state else cursor
    if host_state and host_cursor is None:
        sources[0] = {"source_id": "host", "availability": "complete"}
        states[0] = host_state
    jobs = []
    lock_root = Path(config["template"]).parent / ".sandbox-lifecycle-locks"

    def collect_host():
        try:
            argv = _history_argv(limit, cursor, host_state, filters, excluded_session_id, excluded_message_id)
            return _source_page("host", execute(argv, timeout=HOST_HISTORY_TIMEOUT),
                                limit, host_cursor, host_state, filters)
        except (OSError, RuntimeError, ValueError, json.JSONDecodeError, subprocess.TimeoutExpired):
            return {"source_id": "host", "availability": "invalid_output"}, None

    if sources[0] is None:
        jobs.append((0, collect_host))

    def collect_workspace(workspace, state_before, source_cursor):
        source = workspace["name"]
        instance = workspace["instance"]
        envelope = {"source_id": source, "availability": "invalid_output"}
        state = None
        with _instance_lock(lock_root, instance):
            started = False
            try:
                statuses = _parse_statuses(execute(["limactl", "list", "--json"]))
                if instance not in statuses:
                    return {"source_id": source, "availability": "missing_instance"}, None
                if statuses[instance] not in {"running", "stopped"}:
                    return envelope, None
                started = statuses[instance] == "stopped"
                if started:
                    execute(["limactl", "start", instance], timeout=120)
                output = execute(["limactl", "shell", instance, "--", *_history_argv(limit, cursor, state_before, filters)], timeout=WORKSPACE_HISTORY_TIMEOUT)
                envelope, state = _source_page(source, output, limit, source_cursor, state_before, filters)
            except (OSError, RuntimeError, ValueError, json.JSONDecodeError, subprocess.TimeoutExpired):
                pass
            finally:
                if started:
                    try:
                        execute(["limactl", "stop", instance], timeout=120)
                    except (OSError, RuntimeError, subprocess.TimeoutExpired):
                        envelope = {"source_id": source, "availability": "state_restore_failed"}
                        state = None
        return envelope, state

    for index, workspace in enumerate(federated, 1):
        source = workspace["name"]
        instance = workspace["instance"]
        state_before = continuation_states.get(source)
        source_cursor = state_before.get("continuation") if state_before else cursor
        if state_before and source_cursor is None:
            sources[index] = {"source_id": source, "availability": "complete"}
            states[index] = state_before
            continue
        jobs.append((index, lambda workspace=workspace, state_before=state_before,
                     source_cursor=source_cursor:
                     collect_workspace(workspace, state_before, source_cursor)))
    with ThreadPoolExecutor(max_workers=min(4, len(jobs) or 1)) as pool:
        futures = [(index, pool.submit(job)) for index, job in jobs]
        for index, future in futures:
            sources[index], states[index] = future.result()
    next_state = [state for state in states if state is not None]
    digest = hashlib.sha256(json.dumps(_manifest_identity(filters, sources), sort_keys=True,
                                      separators=(",", ":")).encode()).hexdigest()
    continuation = next_state if len(next_state) == len(expected_sources) and any(state["continuation"] is not None for state in next_state) else None
    return {"schema_version": 2, "sources": sources, "source_state": continuation, "manifest_digest": digest}


def _validated_lens_summary(output, lens, scope, filters, capture_id):
    if len(output.encode()) > MAX_OUTPUT or UNSAFE.search(output):
        raise ValueError("unsafe output")
    value = json.loads(output)
    keys = {"schema_version", "capture_id", "lens", "scope", "snapshot", "session_ceiling",
            "part_ceiling", "database_digest", "exclusion_digest", "query", "member_count",
            "members_digest", "telemetry", "categories", "metrics", "evidence"}
    telemetry = {"page_count", "session_count", "review_session_count",
                 "excluded_review_session_count", "unattributed_session_count"}
    if (not _exact(value, keys) or value.get("schema_version") != 1 or value.get("lens") != lens
            or value.get("scope") != scope or value.get("capture_id") != capture_id
            or value.get("query") != filters or not DIGEST.fullmatch(value.get("database_digest", ""))
            or value.get("exclusion_digest") is not None
            and not DIGEST.fullmatch(value["exclusion_digest"])
            or not DIGEST.fullmatch(value.get("members_digest", ""))
            or any(not _nonnegative_integer(value.get(name))
                   for name in ("snapshot", "session_ceiling", "part_ceiling", "member_count"))
            or not _exact(value.get("telemetry"), telemetry)
            or any(not _nonnegative_integer(item) for item in value["telemetry"].values())
            or value["telemetry"]["unattributed_session_count"] != 0
            or value["member_count"] != value["telemetry"]["session_count"]
            or scope == "exclude" and value["telemetry"]["review_session_count"] != 0
            or scope == "only" and (value["telemetry"]["excluded_review_session_count"] != 0
                                    or value["telemetry"]["session_count"] != value["telemetry"]["review_session_count"])
            or not _exact(value.get("categories"), set(LENS_CATEGORY_VALUES))
            or any(not isinstance(counts, dict) or set(counts) - LENS_CATEGORY_VALUES[name]
                   or any(not _nonnegative_integer(count) for count in counts.values())
                   for name, counts in value["categories"].items())
            or any(sum(value["categories"][name].values()) != value["telemetry"]["session_count"]
                   for name in ("correlation_quality", "reviewed_status", "session_relation"))
            or len({sum(value["categories"][name].values())
                    for name in ("cycle_state", "risk", "delivery_intent")}) != 1
            or not _exact(value.get("metrics"), LENS_METRIC_KEYS)
            or any(not _exact(metric, {"available_count", "unavailable_count", "total", "minimum", "maximum"})
                   or not _nonnegative_integer(metric["available_count"])
                   or not _nonnegative_integer(metric["unavailable_count"])
                   or metric["available_count"] + metric["unavailable_count"] != value["telemetry"]["session_count"]
                   or any(item != "unavailable" and not _nonnegative(item)
                          for item in (metric["total"], metric["minimum"], metric["maximum"]))
                   or (metric["available_count"] == 0) != (metric["total"] == metric["minimum"] == metric["maximum"] == "unavailable")
                   or metric["available_count"] > 0 and not (metric["minimum"] <= metric["maximum"] <= metric["total"])
                   for metric in value["metrics"].values())
            or not isinstance(value.get("evidence"), list) or len(value["evidence"]) > 20
            or not _safe_values(value)):
        raise ValueError("invalid lens summary")
    cycle_total = sum(value["categories"]["cycle_state"].values())
    if value["metrics"]["cycle_count"]["total"] != ("unavailable" if not value["member_count"] else cycle_total):
        raise ValueError("invalid lens summary")
    for evidence in value["evidence"]:
        if (not _exact(evidence, {"session_id", "context", "completed_at", "correlation_quality",
                                  "cycles", "metrics", "signal_score"})
                or not ID.fullmatch(evidence.get("session_id", ""))
                or not ID.fullmatch(evidence.get("context", ""))
                or not isinstance(evidence.get("completed_at"), str) or not evidence["completed_at"].isdigit()
                or evidence.get("correlation_quality") not in LENS_CATEGORY_VALUES["correlation_quality"]
                or not isinstance(evidence.get("cycles"), list) or len(evidence["cycles"]) > 3
                or any(not isinstance(cycle, dict) or set(cycle) - {"cycle_id", "state", "risk", "delivery_intent", "metrics"}
                       or not {"cycle_id", "state"} <= set(cycle) or not ID.fullmatch(cycle["cycle_id"])
                       or cycle["state"] not in LENS_CATEGORY_VALUES["cycle_state"]
                       or cycle.get("risk", "unavailable") not in LENS_CATEGORY_VALUES["risk"]
                       or cycle.get("delivery_intent", "unavailable") not in LENS_CATEGORY_VALUES["delivery_intent"]
                       or "metrics" in cycle and (not _exact(cycle["metrics"], {"elapsed_ms", "gate_failure_count", "gate_reopen_count", "remediation_round_count"})
                           or cycle["metrics"]["elapsed_ms"] != "unavailable" and not _nonnegative_integer(cycle["metrics"]["elapsed_ms"])
                           or any(not _nonnegative_integer(cycle["metrics"][name]) for name in ("gate_failure_count", "gate_reopen_count", "remediation_round_count")))
                       for cycle in evidence["cycles"])
                or not _exact(evidence.get("metrics"), LENS_METRIC_KEYS)
                or any(item != "unavailable" and not _nonnegative(item) for item in evidence["metrics"].values())
                or not isinstance(evidence.get("signal_score"), list) or not 1 <= len(evidence["signal_score"]) <= 8
                or not all(_nonnegative(item) for item in evidence["signal_score"])):
            raise ValueError("invalid lens summary")
    return value


def _validated_capture_descriptor(output, filters):
    if len(output.encode()) > 4096 or UNSAFE.search(output):
        raise ValueError("unsafe output")
    value = json.loads(output)
    keys = {"schema_version", "capture_id", "created_at", "query", "snapshot", "session_ceiling",
            "part_ceiling", "database_digest", "page_size", "page_count", "member_count"}
    now = int(time.time() * 1000)
    if (not _exact(value, keys) or value.get("schema_version") != 1
            or not re.fullmatch(r"[0-9a-f]{24}", value.get("capture_id", ""))
            or value.get("query") != filters or not DIGEST.fullmatch(value.get("database_digest", ""))
            or not _nonnegative_integer(value.get("created_at"))
            or not now - 24 * 60 * 60 * 1000 <= value["created_at"] <= now + 5 * 60 * 1000
            or any(not _nonnegative_integer(value.get(name))
                   for name in ("snapshot", "session_ceiling", "part_ceiling", "page_count", "member_count"))
            or not isinstance(value.get("page_size"), int) or not 1 <= value["page_size"] <= 100):
        raise ValueError("invalid capture descriptor")
    return value


def federated_lens_summary(config, lens, scope, execute=command, filters=None,
                           excluded_session_id=None, excluded_message_id=None):
    validate_config(config)
    if lens not in RND_LENSES or scope not in {"only", "exclude"}:
        raise ValueError("invalid lens summary request")
    filters = {key: (False if key == "archive_only" else None) for key in QUERY_KEYS} | (filters or {})
    if not _valid_query(filters):
        raise ValueError("invalid history filters")
    workspaces = [workspace for workspace in config["workspaces"] if workspace["federate"]]
    sources = [None] * (len(workspaces) + 1)
    lock_root = Path(config["template"]).parent / ".sandbox-lifecycle-locks"

    def collect(source, run, timeout, excluded_session=None, excluded_message=None):
        try:
            descriptor = _validated_capture_descriptor(run(_capture_latest_argv(filters), timeout), filters)
            capture_id = descriptor["capture_id"]
            summary_argv = ["dbsctrctl", "history-capture", "--capture-id", capture_id,
                            "--lens-summary", lens, "--review-sessions", scope]
            if excluded_session is not None:
                summary_argv.extend(["--excluded-session-id", excluded_session])
            if excluded_message is not None:
                summary_argv.extend(["--excluded-message-id", excluded_message])
            summary_output = run(summary_argv, timeout)
            summary = _namespace(_validated_lens_summary(summary_output, lens, scope, filters, capture_id), source)
            summary["query"] = filters
            return {"source_id": source, "availability": "available", "summary": summary}
        except (OSError, RuntimeError, ValueError, json.JSONDecodeError, subprocess.TimeoutExpired):
            return {"source_id": source, "availability": "invalid_output"}

    jobs = [(0, lambda: collect("host", lambda argv, timeout: execute(argv, timeout=timeout),
                                HOST_SUMMARY_TIMEOUT, excluded_session_id, excluded_message_id))]
    for index, workspace in enumerate(workspaces, 1):
        def guest(workspace=workspace):
            source, instance = workspace["name"], workspace["instance"]
            with _instance_lock(lock_root, instance):
                started = False
                result = {"source_id": source, "availability": "invalid_output"}
                try:
                    statuses = _parse_statuses(execute(["limactl", "list", "--json"]))
                    if instance not in statuses:
                        result = {"source_id": source, "availability": "missing_instance"}
                    elif statuses[instance] in {"running", "stopped"}:
                        started = statuses[instance] == "stopped"
                        if started:
                            execute(["limactl", "start", instance], timeout=120)
                        result = collect(source, lambda argv, timeout: execute(
                            ["limactl", "shell", instance, "--", *argv], timeout=timeout),
                            WORKSPACE_HISTORY_TIMEOUT)
                except (OSError, RuntimeError, ValueError, json.JSONDecodeError, subprocess.TimeoutExpired):
                    pass
                finally:
                    if started:
                        try:
                            execute(["limactl", "stop", instance], timeout=120)
                        except (OSError, RuntimeError, subprocess.TimeoutExpired):
                            result = {"source_id": source, "availability": "state_restore_failed"}
                return result
        jobs.append((index, guest))
    with ThreadPoolExecutor(max_workers=min(4, len(jobs))) as pool:
        futures = [(index, pool.submit(job)) for index, job in jobs]
        for index, future in futures:
            sources[index] = future.result()
    totals = {name: sum(source["summary"]["telemetry"][name] for source in sources
                        if source["availability"] == "available")
              for name in ("page_count", "session_count", "review_session_count",
                           "excluded_review_session_count", "unattributed_session_count")}
    telemetry = {**totals, "source_count": len(sources)}
    result = {"schema_version": 1, "lens": lens, "scope": scope, "sources": sources,
              "telemetry": telemetry}
    manifest_digest = hashlib.sha256(json.dumps(
        result, sort_keys=True, separators=(",", ":")).encode()).hexdigest()
    return {**result, "manifest_digest": manifest_digest}


def privacy_epochs(config, execute=command):
    validate_config(config)
    federated = [workspace for workspace in config["workspaces"] if workspace["federate"]]
    sources = [None] * (len(federated) + 1)
    lock_root = Path(config["template"]).parent / ".sandbox-lifecycle-locks"

    def parse(source, output):
        value = json.loads(output)
        if (not _exact(value, {"schema_version", "privacy_epoch_digest"}) or value.get("schema_version") != 1
                or not isinstance(value.get("privacy_epoch_digest"), str)
                or not DIGEST.fullmatch(value["privacy_epoch_digest"])):
            raise ValueError("invalid privacy epoch")
        return {"source_id": source, "availability": "available",
                "privacy_epoch_digest": value["privacy_epoch_digest"]}

    def host():
        try:
            return parse("host", execute(["dbsctrctl", "review-privacy-epoch"], timeout=120))
        except (OSError, RuntimeError, ValueError, json.JSONDecodeError, subprocess.TimeoutExpired):
            return {"source_id": "host", "availability": "unavailable"}

    def guest(workspace):
        source, instance = workspace["name"], workspace["instance"]
        with _instance_lock(lock_root, instance):
            started = False
            try:
                statuses = _parse_statuses(execute(["limactl", "list", "--json"]))
                if instance not in statuses or statuses[instance] not in {"running", "stopped"}:
                    return {"source_id": source, "availability": "unavailable"}
                started = statuses[instance] == "stopped"
                if started:
                    execute(["limactl", "start", instance], timeout=120)
                return parse(source, execute(["limactl", "shell", instance, "--", "dbsctrctl",
                                               "review-privacy-epoch"], timeout=120))
            except (OSError, RuntimeError, ValueError, json.JSONDecodeError, subprocess.TimeoutExpired):
                return {"source_id": source, "availability": "unavailable"}
            finally:
                if started:
                    try:
                        execute(["limactl", "stop", instance], timeout=120)
                    except (OSError, RuntimeError, subprocess.TimeoutExpired):
                        pass

    jobs = [host, *(lambda workspace=workspace: guest(workspace) for workspace in federated)]
    with ThreadPoolExecutor(max_workers=min(4, len(jobs))) as pool:
        for index, value in enumerate(pool.map(lambda job: job(), jobs)):
            sources[index] = value
    return {"schema_version": 1, "sources": sources}


def main(argv=None, invocation=None):
    invocation = invocation or Path(sys.argv[0]).name
    config = None
    if invocation not in {"sandbox-vm", "executable_sandbox-vm"}:
        config = load_config()
        matches = [workspace["name"] for workspace in config["workspaces"]
                   if workspace["shell_alias"] == invocation]
        if len(matches) != 1:
            raise SystemExit(f"unknown workspace shell alias: {invocation}")
        alias_args = sys.argv[1:] if argv is None else argv
        argv = ["shell", matches[0], *(alias_args or ["herdr"])]
    parser = argparse.ArgumentParser()
    commands = parser.add_subparsers(dest="command", required=True)
    for name in ("create", "start", "stop", "update", "install-make", "instance", "render", "validate", "shell", "tailscale-enroll", "parity", "codex-version-parity"):
        sub = commands.add_parser(name)
        sub.add_argument("workspace")
        if name in {"parity", "codex-version-parity"}:
            sub.add_argument("--instance")
        if name == "shell":
            sub.add_argument("args", nargs=argparse.REMAINDER)
    review = commands.add_parser("review")
    review.add_argument("--limit", type=int, default=25)
    review.add_argument("--cursor", type=int, default=0)
    review.add_argument("--source-state-json")
    review.add_argument("--after", type=int)
    review.add_argument("--before", type=int)
    review.add_argument("--method-revision")
    review.add_argument("--cycle-id")
    review.add_argument("--state", choices=("active", "blocked", "abandoned", "completed", "unknown"))
    review.add_argument("--context")
    review.add_argument("--project-digest")
    review.add_argument("--reviewed-status", choices=("reviewed", "unreviewed"))
    review.add_argument("--archive-only", action="store_true")
    review.add_argument("--excluded-session-id")
    review.add_argument("--excluded-message-id")
    summary = commands.add_parser("review-summary")
    summary.add_argument("--lens", required=True, choices=sorted(RND_LENSES))
    summary.add_argument("--review-sessions", required=True, choices=("only", "exclude"))
    summary.add_argument("--after", type=int)
    summary.add_argument("--before", type=int)
    summary.add_argument("--method-revision")
    summary.add_argument("--cycle-id")
    summary.add_argument("--state", choices=("active", "blocked", "abandoned", "completed", "unknown"))
    summary.add_argument("--context")
    summary.add_argument("--project-digest")
    summary.add_argument("--reviewed-status", choices=("reviewed", "unreviewed"))
    summary.add_argument("--archive-only", action="store_true")
    summary.add_argument("--excluded-session-id")
    summary.add_argument("--excluded-message-id")
    commands.add_parser("privacy-epochs")
    commands.add_parser("status")
    commands.add_parser("build-workspace")
    commands.add_parser("update-all")
    atuin = commands.add_parser("configure-atuin")
    atuin.add_argument("--remove", action="store_true")
    pm_postgres = commands.add_parser("configure-pm-postgres")
    pm_postgres.add_argument("--remove", action="store_true")
    commands.add_parser("provision-pm-postgres")
    args = parser.parse_args(argv)
    config = config or load_config()
    if not config.get("enabled", True):
        raise SystemExit("OpenCode VM management is disabled")
    if config["lima_home"]:
        os.environ["LIMA_HOME"] = config["lima_home"]
    if args.command == "review":
        state = json.loads(args.source_state_json) if args.source_state_json else None
        filters = {key: getattr(args, key) for key in QUERY_KEYS}
        print(json.dumps(federated_review(
            config, args.limit, args.cursor, state, filters=filters,
            excluded_session_id=args.excluded_session_id, excluded_message_id=args.excluded_message_id,
        ), sort_keys=True, separators=(",", ":")))
        return
    if args.command == "review-summary":
        filters = {key: getattr(args, key) for key in QUERY_KEYS}
        print(json.dumps(federated_lens_summary(
            config, args.lens, args.review_sessions, filters=filters,
            excluded_session_id=args.excluded_session_id, excluded_message_id=args.excluded_message_id,
        ), sort_keys=True, separators=(",", ":")))
        return
    if args.command == "privacy-epochs":
        print(json.dumps(privacy_epochs(config), sort_keys=True, separators=(",", ":")))
        return
    if args.command == "status":
        print(json.dumps(status_report(config), sort_keys=True))
        return
    if args.command == "build-workspace":
        print(config["build_workspace"])
        return
    if args.command == "update-all":
        print(json.dumps(update_all_workspaces(config), sort_keys=True))
        return
    if args.command == "configure-atuin":
        configure_atuin(config, remove=args.remove)
        status = "removed" if args.remove else "configured"
        print(json.dumps({"workspace": config["atuin_workspace"], "status": status}, sort_keys=True))
        return
    if args.command == "configure-pm-postgres":
        configure_pm_postgres(config, remove=args.remove)
        status = "removed" if args.remove else "configured"
        print(json.dumps({"workspace": config["pm_kernel"]["workspace"], "status": status}, sort_keys=True))
        return
    if args.command == "provision-pm-postgres":
        provision_pm_postgres(config, sys.stdin.buffer)
        print(json.dumps({"workspace": config["pm_kernel"]["workspace"], "status": "provisioned"}, sort_keys=True))
        return
    try:
        workspace = workspace_map(config)[args.workspace]
    except KeyError:
        raise SystemExit(f"unknown workspace: {args.workspace}")
    if args.command == "instance":
        print(workspace["instance"])
        return
    if args.command == "parity":
        if args.instance and workspace["instance"] != args.instance:
            raise SystemExit("workspace instance changed")
        print(json.dumps(verify_opencode_parity(config, workspace), sort_keys=True))
        return
    if args.command == "codex-version-parity":
        if args.instance and workspace["instance"] != args.instance:
            raise SystemExit("workspace instance changed")
        print(json.dumps(verify_codex_version_parity(config, workspace), sort_keys=True))
        return
    if args.command == "render":
        print(render_workspace(config, workspace), end="")
        return
    if args.command == "validate":
        with tempfile.NamedTemporaryFile("w", suffix=".yaml") as rendered:
            rendered.write(render_workspace(config, workspace))
            rendered.flush()
            output = command(["limactl", "validate", rendered.name], timeout=120)
        if output:
            print(output)
        return
    if args.command == "shell":
        shell_args = args.args[1:] if args.args[:1] == ["--"] else args.args
        environment = shell_environment(config)
        preserve = ["--preserve-env"] if "OP_SERVICE_ACCOUNT_TOKEN" in environment else []
        os.execvpe("limactl", ["limactl", "shell", *preserve, workspace["instance"], *shell_args], environment)
        return
    if args.command == "tailscale-enroll":
        tailscale_enroll(config, workspace, sys.stdin.buffer)
        print(json.dumps({"workspace": args.workspace, "status": "enrolled"}, sort_keys=True))
        return
    if args.command == "install-make":
        install_make(config, workspace)
        print(json.dumps({"workspace": args.workspace, "status": "installed"}, sort_keys=True))
        return
    if args.command in {"start", "stop"}:
        lock_root = Path(config["template"]).parent / ".sandbox-lifecycle-locks"
        with _instance_lock(lock_root, workspace["instance"]):
            running = _parse_states(command(["limactl", "list", "--json"])).get(workspace["instance"], False)
            if running != (args.command == "start"):
                command(["limactl", args.command, workspace["instance"]], timeout=120)
        return
    if args.command == "create":
        for mount in workspace["mounts"]:
            if not Path(mount["host"]).exists():
                raise RuntimeError(f"missing host mount: {mount['host']}")
        with tempfile.NamedTemporaryFile("w", suffix=".yaml") as rendered:
            rendered.write(render_workspace(config, workspace))
            rendered.flush()
            command(["limactl", "create", "--name", workspace["instance"], rendered.name], timeout=900)
        command(["limactl", "start", workspace["instance"]], timeout=900)
        return
    if args.command == "update":
        host = host_opencode_version()
        host_codex_version()
        codex_host = host_codex_version()
        guest = update_managed_workspace(config, workspace, updater=update_workspace)
        print(json.dumps({"workspace": args.workspace, "status": "updated", "opencode": {"host": host, "guest": guest["opencode"]},
                          "codex": {"host": codex_host, "guest": guest["codex"]},
                          "allocation": status_report(config)}, sort_keys=True))


if __name__ == "__main__":
    main()
