#!/usr/bin/env python3
import argparse
import configparser
import hashlib
import json
import math
import os
from pathlib import Path, PurePosixPath
import re
import selectors
import shutil
import signal
import subprocess
import tempfile
import time


CONFIG = Path(os.environ.get("OPENCODE_VM_CONFIG", "~/.config/dotfiles-ai/sandbox.json")).expanduser()
ID = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$")
UNSAFE = re.compile(r"(?:https?://|file://|\"/|/(?:Users|home|root|tmp|private|var/folders)/|-----BEGIN [A-Z ]*PRIVATE KEY-----)", re.I)
EMAIL = re.compile(r"\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}\b", re.I)
SECRET = re.compile(r"(?:password|secret|api[_-]?key|access[_-]?token|bearer)\s*[:=]", re.I)
DIGEST = re.compile(r"^[0-9a-f]{64}$")
MAX_OUTPUT = 256 * 1024
PAGE_KEYS = {"schema_version", "snapshot", "session_ceiling", "part_ceiling", "database_digest", "exclusion_digest", "limit", "cursor", "continuation", "candidates", "digest", "query", "session_ids"}
CANDIDATE_KEYS = {"schema_version", "session_id", "snapshot", "session_ceiling", "part_ceiling", "database_digest", "project_digest", "context", "completed_at", "reviewed_status", "correlation_quality", "cycles", "aggregates", "telemetry", "method_revision"}
QUERY_KEYS = {"after", "archive_only", "before", "context", "cycle_id", "method_revision", "project_digest", "reviewed_status", "state"}
AGGREGATE_KEYS = {"approval_count", "candidate_count", "child_count", "cost_total", "cycle_abandoned_count", "cycle_active_count", "cycle_blocked_count", "cycle_completed_count", "cycle_count", "cycle_unknown_count", "elapsed_ms", "retry_count", "token_total", "tool_call_count", "tool_count", "tool_error_count"}
TELEMETRY_KEYS = {"approval_count", "attribution_status", "availability", "cost_total", "delegation_count", "error_classes", "model_families", "retry_count", "token_total"}
AVAILABILITY_KEYS = {"approval_count", "cost_total", "delegation_count", "error_classes", "model_families", "retry_count", "token_total"}
PHASE_KEYS = {"schema_version", "cycle_id", "status", "critical_path_ms", "total_wall_ms", "overlap_ms", "repeated_work", "principal_waits", "attribution_caveats"}


def command(argv, timeout=30):
    process = subprocess.Popen(argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE, start_new_session=True)
    selector = selectors.DefaultSelector()
    selector.register(process.stdout, selectors.EVENT_READ)
    selector.register(process.stderr, selectors.EVENT_READ)
    chunks = {process.stdout: [], process.stderr: []}
    size = 0
    deadline = time.monotonic() + timeout
    try:
        while selector.get_map():
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise subprocess.TimeoutExpired(argv, timeout)
            for key, _ in selector.select(remaining):
                chunk = key.fileobj.read1(64 * 1024)
                if not chunk:
                    selector.unregister(key.fileobj)
                    continue
                size += len(chunk)
                if size > MAX_OUTPUT:
                    raise RuntimeError("command output exceeded bound")
                chunks[key.fileobj].append(chunk)
        return_code = process.wait(timeout=max(0, deadline - time.monotonic()))
    except Exception:
        os.killpg(process.pid, signal.SIGKILL)
        process.wait()
        raise
    stdout = b"".join(chunks[process.stdout]).decode(errors="replace").strip()
    stderr = b"".join(chunks[process.stderr]).decode(errors="replace").strip()
    if return_code:
        raise RuntimeError(f"{argv[0]} failed")
    return stdout


def load_config(path=CONFIG):
    value = json.loads(path.read_text())
    validate_config(value)
    return value


def workspace_map(config):
    return {workspace["name"]: workspace for workspace in config["workspaces"]}


def _inside(left, right):
    try:
        left.relative_to(right)
        return True
    except ValueError:
        return False


def validate_config(value):
    if not isinstance(value, dict) or value.get("schema_version") != 2:
        raise ValueError("invalid sandbox config")
    if (not isinstance(value.get("enabled"), bool) or not isinstance(value.get("source"), str)
            or not re.fullmatch(r"https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(?:\.git)?", value["source"])):
        raise ValueError("invalid sandbox settings")
    if not isinstance(value.get("template"), str) or not value["template"].startswith("/"):
        raise ValueError("invalid workspace template")
    resources = value.get("resources")
    if not isinstance(resources, dict) or set(resources) != {"cpus", "memory_gib", "disk_gib"} or any(
            not isinstance(resources[name], int) or isinstance(resources[name], bool) or resources[name] <= 0
            for name in resources):
        raise ValueError("invalid workspace resources")
    guest = value.get("guest")
    if not isinstance(guest, dict) or set(guest) != {
            "bedrock_region", "bedrock_profile", "default_model", "small_model", "theme"} or any(
            not isinstance(item, str) for item in guest.values()):
        raise ValueError("invalid guest settings")
    workspaces = value.get("workspaces")
    if not isinstance(workspaces, list) or len(workspaces) > 32:
        raise ValueError("invalid workspaces")
    names = set()
    instances = set()
    all_references = set()
    for workspace in workspaces:
        if not isinstance(workspace, dict) or set(workspace) != {"name", "instance", "federate", "mounts"}:
            raise ValueError("invalid workspace")
        name = workspace.get("name", "")
        instance = workspace.get("instance", "")
        if not ID.fullmatch(name) or name == "host" or name in names:
            raise ValueError("invalid workspace name")
        if not ID.fullmatch(instance) or instance in instances or not isinstance(workspace["federate"], bool):
            raise ValueError(f"invalid {name} workspace")
        names.add(name)
        instances.add(instance)
        mounts = workspace["mounts"]
        if not isinstance(mounts, list) or not mounts or len(mounts) > 64:
            raise ValueError(f"invalid {name} mounts")
        hosts = []
        guests = []
        for mount in mounts:
            required = {"host", "guest", "writable", "protect_git_submodules", "reference_name", "reference_description", "reference_subpath"}
            if not isinstance(mount, dict) or set(mount) != required:
                raise ValueError(f"invalid {name} mount")
            if any(not isinstance(mount[key], str) or not mount[key].startswith("/") or re.search(r"[\x00-\x1f\x7f]", mount[key])
                   for key in ("host", "guest")):
                raise ValueError(f"invalid {name} mount path")
            if not isinstance(mount["writable"], bool) or not isinstance(mount["protect_git_submodules"], bool):
                raise ValueError(f"invalid {name} mount access")
            if mount["protect_git_submodules"] and not mount["writable"]:
                raise ValueError("submodule protection requires a writable mount")
            reference = mount["reference_name"]
            description = mount["reference_description"]
            subpath = mount["reference_subpath"]
            if not isinstance(reference, str) or reference and (not ID.fullmatch(reference) or reference in all_references):
                raise ValueError(f"invalid {name} reference")
            relative = PurePosixPath(subpath) if isinstance(subpath, str) else PurePosixPath("/")
            if (not isinstance(description, str) or len(description) > 512 or re.search(r"[\x00-\x1f\x7f]", description)
                    or bool(reference) != bool(description)
                    or not isinstance(subpath, str) or relative.is_absolute() or any(part in {".", ".."} for part in relative.parts)
                    or subpath and (not reference or str(relative) != subpath)):
                raise ValueError(f"invalid {name} reference description")
            if reference:
                all_references.add(reference)
            host = Path(mount["host"]).resolve()
            guest_path = PurePosixPath(mount["guest"])
            if str(host) != mount["host"] or str(guest_path) != mount["guest"] or ".." in guest_path.parts:
                raise ValueError(f"invalid {name} mount path")
            if any(_inside(host, other) or _inside(other, host) for other in hosts):
                raise ValueError("workspace host mounts overlap")
            if any(guest_path == other or guest_path.is_relative_to(other) or other.is_relative_to(guest_path) for other in guests):
                raise ValueError("workspace guest mounts overlap")
            hosts.append(host)
            guests.append(guest_path)
    build_workspace = value.get("build_workspace")
    if not isinstance(build_workspace, str) or build_workspace and build_workspace not in names:
        raise ValueError("invalid build workspace")
    if value["enabled"] and (not workspaces or not build_workspace):
        raise ValueError("enabled sandbox requires workspaces and a build workspace")
    return value


def submodule_paths(repo):
    parser = configparser.ConfigParser(interpolation=None)
    parser.read(repo / ".gitmodules")
    paths = []
    for section in parser.sections():
        if not section.startswith("submodule ") or not parser.has_option(section, "path"):
            continue
        value = parser.get(section, "path")
        path = PurePosixPath(value)
        if path.is_absolute() or not value or ".." in path.parts or "." in path.parts:
            raise ValueError("invalid submodule path")
        paths.append(value)
    if len(paths) != len(set(paths)):
        raise ValueError("duplicate submodule path")
    return sorted(paths)


def _history_argv(limit, cursor, state=None, filters=None):
    if state is not None:
        cursor = state.get("continuation")
        if not isinstance(cursor, int) or cursor < 0:
            raise ValueError("source continuation changed")
    argv = ["dbsctrctl", "review-history", "--limit", str(limit), "--cursor", str(cursor)]
    if state is not None:
        names = {
            "snapshot": "snapshot", "session_ceiling": "session-ceiling",
            "part_ceiling": "part-ceiling", "database_digest": "database-digest",
            "exclusion_digest": "exclusion-digest",
        }
        for key, name in names.items():
            if state.get(key) is not None:
                argv.extend([f"--{name}", str(state[key])])
    names = {"method_revision": "method-revision", "cycle_id": "cycle-id", "project_digest": "project-digest",
             "reviewed_status": "reviewed-status", "archive_only": "archive-only"}
    for key, value in (filters or {}).items():
        if value is True:
            argv.append(f"--{names.get(key, key.replace('_', '-'))}")
        elif value is not None and value is not False:
            argv.extend([f"--{names.get(key, key.replace('_', '-'))}", str(value)])
    return argv


def _parse_states(output):
    if not output:
        return {}
    try:
        value = json.loads(output)
        rows = value if isinstance(value, list) else [value]
    except json.JSONDecodeError:
        rows = [json.loads(line) for line in output.splitlines() if line.strip()]
    return {
        row["name"]: str(row.get("status", "")).lower() == "running"
        for row in rows if isinstance(row, dict) and isinstance(row.get("name"), str)
    }


def allocated_bytes(path):
    total = 0
    if not path.exists():
        return None
    for root, directories, files in os.walk(path, followlinks=False):
        for name in directories + files:
            try:
                total += (Path(root) / name).stat(follow_symlinks=False).st_blocks * 512
            except FileNotFoundError:
                pass
    return total


def guest_config(config, workspace):
    quote = json.dumps
    guest = config["guest"]
    resources = config["resources"]
    lines = [
        'sourceDir = "~/.local/share/chezmoi-dotfiles-ai"',
        'persistentState = "~/.config/dotfiles-ai/chezmoi.boltdb"',
        "",
        "[data.dotfiles_ai.opencode]",
        f"bedrock_region = {quote(guest['bedrock_region'])}",
        f"bedrock_profile = {quote(guest['bedrock_profile'])}",
        f"default_model = {quote(guest['default_model'])}",
        f"small_model = {quote(guest['small_model'])}",
        'lmstudio_base_url = "http://host.lima.internal:1234/v1"',
        "",
        "[data.dotfiles_ai.herdr]",
        f"theme = {quote(guest['theme'])}",
        "launchagent = false",
        'executable = "/usr/local/bin/herdr"',
        "",
        "[data.dotfiles_ai.rnd]",
        "enabled = false",
        'review_workdir = ""',
        "review_hour = 9",
        "review_minute = 0",
        "watchdog_interval_seconds = 300",
        'workspace_label = "DBSCTR R&D"',
        'github_account = ""',
        'github_repository = ""',
        "",
        "[data.dotfiles_ai.onepassword]",
        "enabled = false",
        'account = ""',
        'user_uuid = ""',
        'keychain_service = "op-service-account-token"',
        "",
        "[data.dotfiles_ai.sandbox]",
        "enabled = false",
        f"build_workspace = {quote(workspace['name'])}",
        f"cpus = {resources['cpus']}",
        f"memory_gib = {resources['memory_gib']}",
        f"disk_gib = {resources['disk_gib']}",
        "",
        "[[data.dotfiles_ai.sandbox.workspaces]]",
        f"name = {quote(workspace['name'])}",
        f"instance = {quote(workspace['instance'])}",
        f"federate = {'true' if workspace['federate'] else 'false'}",
    ]
    for mount in workspace["mounts"]:
        lines.extend([
            "",
            "[[data.dotfiles_ai.sandbox.workspaces.mounts]]",
            f"host = {quote(mount['host'])}",
            f"guest = {quote(mount['guest'])}",
            f"writable = {'true' if mount['writable'] else 'false'}",
            f"protect_git_submodules = {'true' if mount['protect_git_submodules'] else 'false'}",
            f"reference_name = {quote(mount['reference_name'])}",
            f"reference_description = {quote(mount['reference_description'])}",
            f"reference_subpath = {quote(mount['reference_subpath'])}",
        ])
    return "\n".join(lines) + "\n"


def render_workspace(config, workspace, template=None):
    template = Path(config["template"]).read_text() if template is None else template
    mounts = []
    for mount in workspace["mounts"]:
        mounts.extend([
            f"  - location: {json.dumps(mount['host'])}",
            f"    mountPoint: {json.dumps(mount['guest'])}",
            f"    writable: {'true' if mount['writable'] else 'false'}",
        ])
    values = {
        "@@MOUNTS@@": "\n".join(mounts),
        "@@WORKSPACE_JSON@@": json.dumps({"mounts": workspace["mounts"]}, sort_keys=True, separators=(",", ":")),
        "@@SOURCE@@": config["source"],
        "@@GUEST_CONFIG@@": guest_config(config, workspace).rstrip().replace("\n", "\n      "),
    }
    for marker, replacement in values.items():
        template = template.replace(marker, replacement)
    if "@@" in template:
        raise ValueError("workspace template contains an unknown marker")
    return template


def status_report(config, execute=command, lima_root=None):
    try:
        running = _parse_states(execute(["limactl", "list", "--json"]))
    except (OSError, RuntimeError, ValueError, json.JSONDecodeError, subprocess.TimeoutExpired):
        running = {}
    root = lima_root or Path.home() / ".lima"
    workspaces = {}
    for workspace in config["workspaces"]:
        name = workspace["name"]
        instance = workspace["instance"]
        workspaces[name] = {
            "instance": instance,
            "running": running.get(instance, False),
            "allocated_bytes": allocated_bytes(root / instance),
        }
    return {
        "schema_version": 1,
        "host_free_bytes": shutil.disk_usage(Path.home()).free,
        "workspaces": workspaces,
    }


def _namespace(value, source):
    if isinstance(value, list):
        return [_namespace(item, source) for item in value]
    if not isinstance(value, dict):
        return value
    result = {}
    for key, item in value.items():
        if key in {"session_id", "cycle_id", "parent_session_id"} and isinstance(item, str):
            result[key] = f"{source}:{item}"
        elif key in {"session_ids", "cycle_ids"} and isinstance(item, list):
            result[key] = [f"{source}:{entry}" for entry in item]
        else:
            result[key] = _namespace(item, source)
    return result


def _exact(value, keys):
    return isinstance(value, dict) and set(value) == keys


def _safe_values(value):
    if isinstance(value, str):
        return len(value) <= 512 and not (UNSAFE.search(json.dumps(value)) or EMAIL.search(value) or SECRET.search(value))
    if isinstance(value, list):
        return all(_safe_values(item) for item in value)
    if isinstance(value, dict):
        return all(_safe_values(item) for item in value.values())
    return value is None or isinstance(value, (bool, int, float))


def _nonnegative(value):
    return not isinstance(value, bool) and isinstance(value, (int, float)) and math.isfinite(value) and value >= 0


def _nonnegative_integer(value):
    return isinstance(value, int) and not isinstance(value, bool) and value >= 0


def _valid_phase_profile(profile, cycle_id):
    if profile is None:
        return True
    return (_exact(profile, PHASE_KEYS) and profile.get("schema_version") == 1
            and profile.get("cycle_id") == cycle_id and profile.get("status") in {"complete", "unavailable"}
            and all(value == "unavailable" or _nonnegative_integer(value)
                    for value in (profile.get("critical_path_ms"), profile.get("total_wall_ms"), profile.get("overlap_ms")))
            and _nonnegative_integer(profile.get("repeated_work"))
            and isinstance(profile.get("principal_waits"), list)
            and all(_exact(wait, {"span_id", "wait_ms"}) and isinstance(wait["span_id"], str)
                    and ID.fullmatch(wait["span_id"]) and _nonnegative_integer(wait["wait_ms"])
                    for wait in profile["principal_waits"])
            and isinstance(profile.get("attribution_caveats"), list)
            and all(isinstance(item, str) and ID.fullmatch(item) for item in profile["attribution_caveats"]))


def _valid_candidate(candidate):
    if not _exact(candidate, CANDIDATE_KEYS) or not _exact(candidate.get("aggregates"), AGGREGATE_KEYS):
        return False
    telemetry = candidate.get("telemetry")
    if not _exact(telemetry, TELEMETRY_KEYS) or not _exact(telemetry.get("availability"), AVAILABILITY_KEYS):
        return False
    cycles = candidate.get("cycles")
    if not isinstance(cycles, list):
        return False
    for cycle in cycles:
        if not (_exact(cycle, {"cycle_id", "state"}) or _exact(cycle, {"cycle_id", "state", "phase_profile"})):
            return False
        if not _valid_phase_profile(cycle.get("phase_profile"), cycle.get("cycle_id")):
            return False
    unavailable = lambda value: value == "unavailable" or _nonnegative(value)
    if (candidate.get("schema_version") != 1 or not ID.fullmatch(candidate.get("session_id", ""))
            or not all(_nonnegative_integer(candidate.get(name))
                       for name in ("snapshot", "session_ceiling", "part_ceiling"))
            or not all(isinstance(candidate.get(name), str) and DIGEST.fullmatch(candidate[name])
                       for name in ("database_digest", "project_digest"))
            or not isinstance(candidate.get("context"), str) or not ID.fullmatch(candidate["context"])
            or candidate.get("completed_at") is not None
            and (not isinstance(candidate["completed_at"], str)
                 or not re.fullmatch(r"(?:\d{10,16}|\d{4}-\d{2}-\d{2}T[^\s]{1,40}Z)", candidate["completed_at"]))
            or candidate.get("reviewed_status") not in {"reviewed", "unreviewed"}
            or candidate.get("correlation_quality") not in {"exact", "family", "worktree", "source", "ambiguous", "unavailable"}
            or not isinstance(candidate.get("method_revision"), str)
            or not re.fullmatch(r"(?:\d+(?:\.\d+)*|unavailable)", candidate["method_revision"])
            or any(not ID.fullmatch(cycle.get("cycle_id", ""))
                   or cycle.get("state") not in {"active", "blocked", "abandoned", "completed", "unknown"}
                   for cycle in cycles)
            or any(not (_nonnegative(candidate["aggregates"][name]) if name == "cost_total"
                        else _nonnegative_integer(candidate["aggregates"][name]))
                   and candidate["aggregates"][name] != "unavailable" for name in AGGREGATE_KEYS)
            or not all(telemetry[name] == "unavailable" or _nonnegative_integer(telemetry[name])
                       for name in ("approval_count", "retry_count", "delegation_count", "token_total"))
            or not unavailable(telemetry["cost_total"])
            or not (telemetry["model_families"] == "unavailable"
                    or isinstance(telemetry["model_families"], list) and all(isinstance(item, str) and ID.fullmatch(item) for item in telemetry["model_families"]))
            or not (telemetry["error_classes"] == "unavailable" or isinstance(telemetry["error_classes"], dict)
                    and all(ID.fullmatch(key) and _nonnegative_integer(value) for key, value in telemetry["error_classes"].items()))
            or telemetry["attribution_status"] not in {"exact", "family", "worktree", "source", "ambiguous", "unavailable"}
            or any(value not in {"available", "unavailable"} for value in telemetry["availability"].values())):
        return False
    return _safe_values(candidate)


def _valid_query(query):
    return (_exact(query, QUERY_KEYS) and isinstance(query.get("archive_only"), bool)
            and all(item is None or _nonnegative_integer(item) for item in (query.get("after"), query.get("before")))
            and all(item is None or isinstance(item, str) and ID.fullmatch(item)
                    for item in (query.get("context"), query.get("cycle_id")))
            and (query.get("method_revision") is None or isinstance(query["method_revision"], str)
                 and re.fullmatch(r"\d+(?:\.\d+)*", query["method_revision"]))
            and (query.get("project_digest") is None or isinstance(query["project_digest"], str)
                 and DIGEST.fullmatch(query["project_digest"]))
            and query.get("reviewed_status") in {None, "reviewed", "unreviewed"}
            and query.get("state") in {None, "active", "blocked", "abandoned", "completed", "unknown"})


def _source_page(source, output, limit, cursor, previous=None, filters=None):
    if len(output.encode()) > MAX_OUTPUT or UNSAFE.search(output):
        raise ValueError("unsafe output")
    value = json.loads(output)
    if not _exact(value, PAGE_KEYS) or value.get("schema_version") != 1 or not _exact(value.get("query"), QUERY_KEYS):
        raise ValueError("invalid history page")
    if value.get("limit") != limit or value.get("cursor") != cursor or not isinstance(value.get("candidates"), list):
        raise ValueError("invalid history page")
    if (not all(_nonnegative_integer(value.get(name))
                for name in ("snapshot", "session_ceiling", "part_ceiling"))
            or not isinstance(value.get("database_digest"), str)
            or not re.fullmatch(r"[0-9a-f]{64}", value["database_digest"])
            or value.get("exclusion_digest") is not None
            and not re.fullmatch(r"[0-9a-f]{64}", value["exclusion_digest"])
            or value.get("continuation") is not None
            and (not _nonnegative_integer(value["continuation"]) or value["continuation"] <= cursor)):
        raise ValueError("invalid history identity")
    query = value["query"]
    if (not _valid_query(query) or filters is not None and query != filters
            or not isinstance(value.get("digest"), str) or not DIGEST.fullmatch(value["digest"])
            or not isinstance(value.get("session_ids"), list)
            or any(not isinstance(item, str) or not ID.fullmatch(item) for item in value["session_ids"])):
        raise ValueError("invalid history values")
    if previous is not None:
        for key in ("snapshot", "session_ceiling", "part_ceiling", "database_digest", "exclusion_digest"):
            if value.get(key) != previous.get(key):
                raise ValueError("source identity changed")
    if len(value["candidates"]) > limit or any(not _valid_candidate(candidate) for candidate in value["candidates"]):
        raise ValueError("invalid history page")
    state = {
        "source_id": source,
        "snapshot": value["snapshot"],
        "session_ceiling": value["session_ceiling"],
        "part_ceiling": value["part_ceiling"],
        "database_digest": value["database_digest"],
        "exclusion_digest": value.get("exclusion_digest"),
        "query_digest": hashlib.sha256(json.dumps(filters, sort_keys=True, separators=(",", ":")).encode()).hexdigest(),
        "continuation": value["continuation"],
    }
    page = _namespace(value, source)
    page["query"] = value["query"]
    return {"source_id": source, "availability": "available", "page": page}, state


def _valid_source_state(value):
    return (_exact(value, {"source_id", "snapshot", "session_ceiling", "part_ceiling", "database_digest",
                           "exclusion_digest", "query_digest", "continuation"})
            and isinstance(value["source_id"], str) and ID.fullmatch(value["source_id"])
            and all(isinstance(value[name], int) and not isinstance(value[name], bool) and value[name] >= 0
                    for name in ("snapshot", "session_ceiling", "part_ceiling"))
            and isinstance(value["database_digest"], str) and DIGEST.fullmatch(value["database_digest"])
            and (value["exclusion_digest"] is None
                 or isinstance(value["exclusion_digest"], str) and DIGEST.fullmatch(value["exclusion_digest"]))
            and isinstance(value["query_digest"], str) and DIGEST.fullmatch(value["query_digest"])
            and (value["continuation"] is None
                 or isinstance(value["continuation"], int) and not isinstance(value["continuation"], bool)
                 and value["continuation"] >= 0))


def federated_review(config, limit=25, cursor=0, source_state=None, execute=command, filters=None):
    validate_config(config)
    if not 1 <= limit <= 100 or cursor < 0:
        raise ValueError("invalid pagination")
    filters = {key: (False if key == "archive_only" else None) for key in QUERY_KEYS} | (filters or {})
    if not _valid_query(filters):
        raise ValueError("invalid history filters")
    query_digest = hashlib.sha256(json.dumps(filters, sort_keys=True, separators=(",", ":")).encode()).hexdigest()
    federated = [workspace for workspace in config["workspaces"] if workspace["federate"]]
    expected_sources = {"host", *(workspace["name"] for workspace in federated)}
    continuation_states = {}
    if source_state is not None:
        if (not isinstance(source_state, list) or len(source_state) != len(expected_sources)
                or not all(_valid_source_state(item) for item in source_state)
                or {item["source_id"] for item in source_state} != expected_sources
                or any(item["query_digest"] != query_digest for item in source_state)):
            raise ValueError("invalid source state")
        continuation_states = {item["source_id"]: item for item in source_state}
    sources = []
    next_state = []
    host_state = continuation_states.get("host")
    host_cursor = host_state.get("continuation") if host_state else cursor
    if host_state and host_cursor is None:
        sources.append({"source_id": "host", "availability": "complete"})
        next_state.append(host_state)
    else:
        try:
            source, state = _source_page("host", execute(_history_argv(limit, cursor, host_state, filters), timeout=120),
                                         limit, host_cursor, host_state, filters)
            sources.append(source)
            next_state.append(state)
        except (OSError, RuntimeError, ValueError, json.JSONDecodeError, subprocess.TimeoutExpired):
            sources.append({"source_id": "host", "availability": "invalid_output"})
    try:
        running = _parse_states(execute(["limactl", "list", "--json"]))
    except (OSError, RuntimeError, ValueError, json.JSONDecodeError, subprocess.TimeoutExpired):
        running = {}
    for workspace in federated:
        source = workspace["name"]
        instance = workspace["instance"]
        state_before = continuation_states.get(source)
        source_cursor = state_before.get("continuation") if state_before else cursor
        if state_before and source_cursor is None:
            sources.append({"source_id": source, "availability": "complete"})
            next_state.append(state_before)
            continue
        if instance not in running:
            sources.append({"source_id": source, "availability": "missing_instance"})
            continue
        started = not running[instance]
        try:
            if started:
                execute(["limactl", "start", instance], timeout=120)
            output = execute(["limactl", "shell", instance, "--", *_history_argv(limit, cursor, state_before, filters)], timeout=120)
            envelope, state = _source_page(source, output, limit, source_cursor, state_before, filters)
            sources.append(envelope)
            next_state.append(state)
        except (OSError, RuntimeError, ValueError, json.JSONDecodeError, subprocess.TimeoutExpired):
            sources.append({"source_id": source, "availability": "invalid_output"})
        finally:
            if started:
                try:
                    execute(["limactl", "stop", instance], timeout=120)
                except (OSError, RuntimeError, subprocess.TimeoutExpired):
                    sources[-1] = {"source_id": source, "availability": "state_restore_failed"}
                    if next_state and next_state[-1]["source_id"] == source:
                        next_state.pop()
    digest = hashlib.sha256(json.dumps({"filters": filters, "sources": sources}, sort_keys=True, separators=(",", ":")).encode()).hexdigest()
    continuation = next_state if len(next_state) == len(expected_sources) and any(state["continuation"] is not None for state in next_state) else None
    return {"schema_version": 1, "sources": sources, "source_state": continuation, "manifest_digest": digest}


def main(argv=None):
    parser = argparse.ArgumentParser()
    commands = parser.add_subparsers(dest="command", required=True)
    for name in ("create", "update", "instance", "render", "validate", "shell"):
        sub = commands.add_parser(name)
        sub.add_argument("workspace")
        if name == "shell":
            sub.add_argument("args", nargs=argparse.REMAINDER)
    review = commands.add_parser("review")
    review.add_argument("--limit", type=int, default=25)
    review.add_argument("--cursor", type=int, default=0)
    review.add_argument("--source-state-json")
    review.add_argument("--after", type=int)
    review.add_argument("--before", type=int)
    review.add_argument("--method-revision")
    review.add_argument("--cycle-id")
    review.add_argument("--state", choices=("active", "blocked", "abandoned", "completed", "unknown"))
    review.add_argument("--context")
    review.add_argument("--project-digest")
    review.add_argument("--reviewed-status", choices=("reviewed", "unreviewed"))
    review.add_argument("--archive-only", action="store_true")
    commands.add_parser("status")
    commands.add_parser("build-workspace")
    args = parser.parse_args(argv)
    config = load_config()
    if not config.get("enabled", True):
        raise SystemExit("OpenCode VM management is disabled")
    if args.command == "review":
        state = json.loads(args.source_state_json) if args.source_state_json else None
        filters = {key: getattr(args, key) for key in QUERY_KEYS}
        print(json.dumps(federated_review(config, args.limit, args.cursor, state, filters=filters), sort_keys=True, separators=(",", ":")))
        return
    if args.command == "status":
        print(json.dumps(status_report(config), sort_keys=True))
        return
    if args.command == "build-workspace":
        print(config["build_workspace"])
        return
    try:
        workspace = workspace_map(config)[args.workspace]
    except KeyError:
        raise SystemExit(f"unknown workspace: {args.workspace}")
    if args.command == "instance":
        print(workspace["instance"])
        return
    if args.command == "render":
        print(render_workspace(config, workspace), end="")
        return
    if args.command == "validate":
        with tempfile.NamedTemporaryFile("w", suffix=".yaml") as rendered:
            rendered.write(render_workspace(config, workspace))
            rendered.flush()
            output = command(["limactl", "validate", rendered.name], timeout=120)
        if output:
            print(output)
        return
    if args.command == "shell":
        shell_args = args.args[1:] if args.args[:1] == ["--"] else args.args
        environment = {**os.environ, "TERM": os.environ.get("LIMA_TERM", "xterm-256color")}
        os.execvpe("limactl", ["limactl", "shell", workspace["instance"], *shell_args], environment)
        return
    if args.command == "create":
        for mount in workspace["mounts"]:
            if not Path(mount["host"]).exists():
                raise RuntimeError(f"missing host mount: {mount['host']}")
        with tempfile.NamedTemporaryFile("w", suffix=".yaml") as rendered:
            rendered.write(render_workspace(config, workspace))
            rendered.flush()
            command(["limactl", "create", "--name", workspace["instance"], rendered.name], timeout=900)
        command(["limactl", "start", workspace["instance"]], timeout=900)
        return
    if args.command == "update":
        home = command(["limactl", "shell", "--start", workspace["instance"], "--", "printenv", "HOME"], timeout=120)
        if not home.startswith("/home/") or not ID.fullmatch(Path(home).name):
            raise RuntimeError("invalid guest home")
        source = f"{home}/.local/share/chezmoi-dotfiles-ai"
        command(["limactl", "shell", workspace["instance"], "--", "git", "-C", source, "pull", "--ff-only"], timeout=300)
        command(["limactl", "shell", workspace["instance"], "--", "chezmoi", "-c", f"{home}/.config/dotfiles-ai/chezmoi.toml", "apply"], timeout=300)
        print(json.dumps({"workspace": args.workspace, "status": "updated", "allocation": status_report(config)}, sort_keys=True))


if __name__ == "__main__":
    main()
