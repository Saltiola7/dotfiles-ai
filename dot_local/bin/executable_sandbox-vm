PAGE_KEYS = {"schema_version", "capture_id", "snapshot", "session_ceiling", "part_ceiling", "database_digest", "exclusion_digest", "limit", "cursor", "continuation", "candidates", "digest", "query", "session_ids"}
CANDIDATE_KEYS = {"schema_version", "session_id", "snapshot", "session_ceiling", "part_ceiling", "database_digest", "project_digest", "context", "completed_at", "reviewed_status", "correlation_quality", "cycles", "aggregates", "telemetry", "method_revision"}
CURRENT_CANDIDATE_KEYS = CANDIDATE_KEYS | {"review_session"}
QUERY_KEYS = {"after", "archive_only", "before", "context", "cycle_id", "method_revision", "project_digest", "reviewed_status", "state"}
AGGREGATE_KEYS = {"approval_count", "candidate_count", "child_count", "cost_total", "cycle_abandoned_count", "cycle_active_count", "cycle_blocked_count", "cycle_completed_count", "cycle_count", "cycle_unknown_count", "elapsed_ms", "retry_count", "token_total", "tool_call_count", "tool_count", "tool_error_count"}
LEGACY_TELEMETRY_KEYS = {"approval_count", "attribution_status", "availability", "cost_total", "delegation_count", "error_classes", "model_families", "retry_count", "token_total"}
TELEMETRY_KEYS = LEGACY_TELEMETRY_KEYS | {"schema_version", "provider_ids", "model_ids", "agent_ids", "session_relation", "core_revisions", "overlay_revisions", "gate_failure_count", "gate_reopen_count", "remediation_round_count"}
AVAILABILITY_KEYS = TELEMETRY_KEYS - {"schema_version", "availability", "attribution_status"}
LEGACY_AVAILABILITY_KEYS = LEGACY_TELEMETRY_KEYS - {"availability", "attribution_status"}
PHASE_KEYS = {"schema_version", "cycle_id", "status", "critical_path_ms", "total_wall_ms", "overlap_ms", "repeated_work", "principal_waits", "attribution_caveats"}


def command(argv, timeout=30, input_data=None, environment=None):
    process = subprocess.Popen(argv, stdin=subprocess.PIPE if input_data is not None else None,
                               stdout=subprocess.PIPE, stderr=subprocess.PIPE, start_new_session=True,
                               env=environment)
    selector = selectors.DefaultSelector()
    selector.register(process.stdout, selectors.EVENT_READ)
    selector.register(process.stderr, selectors.EVENT_READ)
    chunks = {process.stdout: [], process.stderr: []}
    size = 0
    deadline = time.monotonic() + timeout
    try:
        if input_data is not None:
            process.stdin.write(input_data)
            process.stdin.close()
        while selector.get_map():
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise subprocess.TimeoutExpired(argv, timeout)
            for key, _ in selector.select(remaining):
                chunk = key.fileobj.read1(64 * 1024)
                if not chunk:
                    selector.unregister(key.fileobj)
                    continue
                size += len(chunk)
                if size > MAX_OUTPUT:
                    raise RuntimeError("command output exceeded bound")
                chunks[key.fileobj].append(chunk)
        return_code = process.wait(timeout=max(0, deadline - time.monotonic()))
    except Exception:
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except (ProcessLookupError, PermissionError):
            try:
                process.kill()
            except ProcessLookupError:
                pass
        try:
            process.wait(timeout=1)
        except subprocess.TimeoutExpired:
            pass
        raise
    stdout = b"".join(chunks[process.stdout]).decode(errors="replace").strip()
    stderr = b"".join(chunks[process.stderr]).decode(errors="replace").strip()
    if return_code:
        raise RuntimeError(f"{argv[0]} failed")
    return stdout


def load_config(path=CONFIG):
    value = json.loads(path.read_text())
    validate_config(value)
    return value


def workspace_map(config):
    return {workspace["name"]: workspace for workspace in config["workspaces"]}


def _inside(left, right):
    try:
        left.relative_to(right)
        return True
    except ValueError:
        return False


def validate_config(value):
    if not isinstance(value, dict) or value.get("schema_version") not in {4, 5}:
        raise ValueError("invalid sandbox config")
    if value["schema_version"] == 4:
        value["schema_version"] = 5
        value.setdefault("onepassword", {
            "enabled": False, "account": "", "user_uuid": "",
            "keychain_service": "op-service-account-token",
        })
        guest = value.get("guest")
        if isinstance(guest, dict):
            guest.setdefault("vertex_project", "")
            guest.setdefault("vertex_location", "global")
            guest.setdefault("vertex_account", "")
    if (not isinstance(value.get("enabled"), bool) or not isinstance(value.get("source"), str)
            or not re.fullmatch(r"https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(?:\.git)?", value["source"])):
        raise ValueError("invalid sandbox settings")
    lima_home = value.setdefault("lima_home", "")
    if not isinstance(lima_home, str) or lima_home and not Path(lima_home).is_absolute():
        raise ValueError("invalid Lima home")
    state_root = value.get("state_root", "")
    if not isinstance(state_root, str) or state_root and not Path(state_root).is_absolute():
        raise ValueError("invalid state root")
    if not isinstance(value.get("template"), str) or not value["template"].startswith("/"):
        raise ValueError("invalid workspace template")
    atuin_workspace = value.get("atuin_workspace")
    if not isinstance(atuin_workspace, str) or atuin_workspace and not ID.fullmatch(atuin_workspace):
        raise ValueError("invalid Atuin workspace")
    resources = value.get("resources")
    if not isinstance(resources, dict) or set(resources) != {"cpus", "memory_gib", "disk_gib"} or any(
            not isinstance(resources[name], int) or isinstance(resources[name], bool) or resources[name] <= 0
            for name in resources):
        raise ValueError("invalid workspace resources")
    tailscale = value.setdefault("tailscale", {"enabled": False, "ssh": False})
    if (not isinstance(tailscale, dict) or set(tailscale) != {"enabled", "ssh"}
            or any(not isinstance(tailscale[name], bool) for name in tailscale)):
        raise ValueError("invalid Tailscale settings")
    onepassword = value.get("onepassword")
    if (not isinstance(onepassword, dict)
            or set(onepassword) != {"enabled", "account", "user_uuid", "keychain_service"}
            or not isinstance(onepassword["enabled"], bool)
            or any(not isinstance(onepassword[name], str) for name in ("account", "user_uuid", "keychain_service"))
            or onepassword["enabled"] and not all(onepassword[name] for name in ("account", "user_uuid", "keychain_service"))):
        raise ValueError("invalid 1Password settings")
    guest = value.get("guest")
    if isinstance(guest, dict):
        guest.setdefault("hermes_enabled", False)
        guest.setdefault("rnd_backend", "native")
    if not isinstance(guest, dict) or set(guest) != {
            "default_model", "small_model", "theme",
            "atuin_sync_address", "hermes_enabled", "rnd_backend",
            "vertex_project", "vertex_location", "vertex_account"} or any(
            not isinstance(guest[name], str) for name in guest if name != "hermes_enabled") \
            or not isinstance(guest["hermes_enabled"], bool) \
            or guest["rnd_backend"] not in {"native", "hermes"}:
        raise ValueError("invalid guest settings")
    if not re.fullmatch(r"https://[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?(?::[0-9]{1,5})?", guest["atuin_sync_address"]):
        raise ValueError("invalid guest Atuin sync address")
    workspaces = value.get("workspaces")
    if not isinstance(workspaces, list) or len(workspaces) > 32:
        raise ValueError("invalid workspaces")
    names = set()
    instances = set()
    aliases = set()
    all_references = set()
    for workspace in workspaces:
        if isinstance(workspace, dict):
            workspace.setdefault("hermes_projects", False)
            workspace.setdefault("hermes_backlog_roots", [])
        if not isinstance(workspace, dict) or set(workspace) != {
                "name", "instance", "shell_alias", "federate", "hermes_projects",
                "hermes_backlog_roots", "mounts"}:
            raise ValueError("invalid workspace")
        name = workspace.get("name", "")
        instance = workspace.get("instance", "")
        shell_alias = workspace.get("shell_alias", "")
        if not ID.fullmatch(name) or name == "host" or name in names:
            raise ValueError("invalid workspace name")
        if (not ID.fullmatch(instance) or instance in instances
                or not isinstance(workspace["federate"], bool)
                or not isinstance(workspace["hermes_projects"], bool)):
            raise ValueError(f"invalid {name} workspace")
        if (not isinstance(shell_alias, str) or shell_alias and
                (not ALIAS.fullmatch(shell_alias) or shell_alias == "sandbox-vm" or shell_alias in aliases)):
            raise ValueError(f"invalid {name} shell alias")
        names.add(name)
        instances.add(instance)
        if shell_alias:
            aliases.add(shell_alias)
        mounts = workspace["mounts"]
        if not isinstance(mounts, list) or not mounts or len(mounts) > 64:
            raise ValueError(f"invalid {name} mounts")
        hosts = []
        guests = []
        for mount in mounts:
            required = {"host", "guest", "writable", "protect_git_submodules", "reference_name", "reference_description", "reference_subpath"}
            if not isinstance(mount, dict) or set(mount) != required:
                raise ValueError(f"invalid {name} mount")
            if any(not isinstance(mount[key], str) or not mount[key].startswith("/") or re.search(r"[\x00-\x1f\x7f]", mount[key])
                   for key in ("host", "guest")):
                raise ValueError(f"invalid {name} mount path")
            if not isinstance(mount["writable"], bool) or not isinstance(mount["protect_git_submodules"], bool):
                raise ValueError(f"invalid {name} mount access")
            if mount["protect_git_submodules"] and not mount["writable"]:
                raise ValueError("submodule protection requires a writable mount")
            reference = mount["reference_name"]
            description = mount["reference_description"]
            subpath = mount["reference_subpath"]
            if not isinstance(reference, str) or reference and (not ID.fullmatch(reference) or reference in all_references):
                raise ValueError(f"invalid {name} reference")
            relative = PurePosixPath(subpath) if isinstance(subpath, str) else PurePosixPath("/")
            if (not isinstance(description, str) or len(description) > 512 or re.search(r"[\x00-\x1f\x7f]", description)
                    or bool(reference) != bool(description)
                    or not isinstance(subpath, str) or relative.is_absolute() or any(part in {".", ".."} for part in relative.parts)
                    or subpath and (not reference or str(relative) != subpath)):
                raise ValueError(f"invalid {name} reference description")
            if reference:
                all_references.add(reference)
            host = Path(mount["host"]).resolve()
            guest_path = PurePosixPath(mount["guest"])
            if str(host) != mount["host"] or str(guest_path) != mount["guest"] or ".." in guest_path.parts:
                raise ValueError(f"invalid {name} mount path")
            if any(_inside(host, other) or _inside(other, host) for other in hosts):
                raise ValueError("workspace host mounts overlap")
            if any(guest_path == other or guest_path.is_relative_to(other) or other.is_relative_to(guest_path) for other in guests):
                raise ValueError("workspace guest mounts overlap")
            hosts.append(host)
            guests.append(guest_path)
        backlog_roots = workspace["hermes_backlog_roots"]
        mounted_roots = [PurePosixPath(mount["guest"]) for mount in mounts]
        if (not isinstance(backlog_roots, list) or len(backlog_roots) > 32
                or len(backlog_roots) != len(set(backlog_roots))
                or any(not isinstance(root, str) or not PurePosixPath(root).is_absolute()
                       or not any(PurePosixPath(root) == mount or PurePosixPath(root).is_relative_to(mount)
                                  for mount in mounted_roots)
                       for root in backlog_roots)):
            raise ValueError(f"invalid {name} Hermes backlog roots")
    build_workspace = value.get("build_workspace")
    if not isinstance(build_workspace, str) or build_workspace and build_workspace not in names:
        raise ValueError("invalid build workspace")
    if value["enabled"] and (not workspaces or not build_workspace):
        raise ValueError("enabled sandbox requires workspaces and a build workspace")
    if atuin_workspace and atuin_workspace not in names:
        raise ValueError("invalid Atuin workspace")
    if atuin_workspace:
        try:
            guarded_root = Path(state_root).resolve(strict=True)
            guarded_lima = Path(lima_home).resolve(strict=True)
            guarded_lima.relative_to(guarded_root)
        except (OSError, ValueError):
            raise ValueError("Atuin workspace requires guarded Lima home") from None
    return value


def atuin_port_rule(forwards, remove=False):
    if not isinstance(forwards, list) or any(not isinstance(item, dict) for item in forwards):
        raise ValueError("invalid Lima port forwards")
    owned = lambda item: all(item.get(key) == value for key, value in ATUIN_PORT_FORWARD.items())
    if not remove and any(item.get("hostPort") == 8889 and not owned(item) for item in forwards):
        raise ValueError("Atuin host port is already configured")
    retained = [item for item in forwards if not owned(item)]
    if not remove:
        retained.append(ATUIN_PORT_FORWARD)
    return ".portForwards = " + json.dumps(retained, sort_keys=True, separators=(",", ":"))


def submodule_paths(repo):
    parser = configparser.ConfigParser(interpolation=None)
    parser.read(repo / ".gitmodules")
    paths = []
    for section in parser.sections():
        if not section.startswith("submodule ") or not parser.has_option(section, "path"):
            continue
        value = parser.get(section, "path")
        path = PurePosixPath(value)
        if path.is_absolute() or not value or ".." in path.parts or "." in path.parts:
            raise ValueError("invalid submodule path")
        paths.append(value)
    if len(paths) != len(set(paths)):
        raise ValueError("duplicate submodule path")
    return sorted(paths)


def _history_argv(limit, cursor, state=None, filters=None, excluded_session_id=None, excluded_message_id=None):
    if state is not None:
        cursor = state.get("continuation")
        if not isinstance(cursor, int) or cursor < 0:
            raise ValueError("source continuation changed")
    argv = ["dbsctrctl", "review-history", "--limit", str(limit), "--cursor", str(cursor)]
    argv.extend(["--capture-id", state["capture_id"]] if state is not None else ["--capture"])
    if state is None:
        if excluded_session_id is not None:
            argv.extend(["--excluded-session-id", excluded_session_id])
        if excluded_message_id is not None:
            argv.extend(["--excluded-message-id", excluded_message_id])
    names = {"method_revision": "method-revision", "cycle_id": "cycle-id", "project_digest": "project-digest",
             "reviewed_status": "reviewed-status", "archive_only": "archive-only"}
    for key, value in (() if state is not None else (filters or {}).items()):
        if value is True:
            argv.append(f"--{names.get(key, key.replace('_', '-'))}")
        elif value is not None and value is not False:
            argv.extend([f"--{names.get(key, key.replace('_', '-'))}", str(value)])
    return argv


def _parse_states(output):
    return {name: status == "running" for name, status in _parse_statuses(output).items()}


def _parse_rows(output):
    if not output:
        return []
    try:
        value = json.loads(output)
        rows = value if isinstance(value, list) else [value]
    except json.JSONDecodeError:
        rows = [json.loads(line) for line in output.splitlines() if line.strip()]
    return rows


def _parse_statuses(output):
    return {
        row["name"]: str(row.get("status", "")).lower()
        for row in _parse_rows(output) if isinstance(row, dict) and isinstance(row.get("name"), str)
    }


def _instance_lock(root, instance):
    root.parent.mkdir(parents=True, exist_ok=True)
    try:
        root.mkdir(mode=0o700)
    except FileExistsError:
        pass
    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
    directory = os.open(root, flags)
    try:
        details = os.fstat(directory)
        if stat.S_IFMT(details.st_mode) != stat.S_IFDIR or details.st_uid != os.getuid():
            raise RuntimeError("sandbox lifecycle lock directory is unsafe")
        os.fchmod(directory, 0o700)
        descriptor = os.open(f"{instance}.lock", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW,
                             0o600, dir_fd=directory)
    except Exception:
        os.close(directory)
        raise
    os.close(directory)
    lock = os.fdopen(descriptor, "a+")
    details = os.fstat(descriptor)
    if stat.S_IFMT(details.st_mode) != stat.S_IFREG or details.st_uid != os.getuid():
        lock.close()
        raise RuntimeError("sandbox lifecycle lock is unsafe")
    os.fchmod(descriptor, 0o600)
    fcntl.flock(lock, fcntl.LOCK_EX)
    return lock


def allocated_bytes(path):
    total = 0
    if not path.exists():
        return None
    for root, directories, files in os.walk(path, followlinks=False):
        for name in directories + files:
            try:
                total += (Path(root) / name).stat(follow_symlinks=False).st_blocks * 512
            except FileNotFoundError:
                pass
    return total


