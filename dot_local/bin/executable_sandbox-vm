    onepassword = config["onepassword"]
    backlog_roots = workspace.get("hermes_backlog_roots") or [
        mount["guest"] for mount in workspace["mounts"]
        if mount["writable"] and not mount["protect_git_submodules"]
    ]
    lines = [
