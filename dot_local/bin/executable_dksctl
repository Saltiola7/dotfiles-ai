COMMIT_RE = re.compile(r"^[0-9a-f]{40}$")
SHA256_RE = re.compile(r"^[0-9a-f]{64}$")
GRAPHIFY_RUNTIME_SHA256 = "2202db22692c497e3c45fc19b746a9bc36f6409ae92f745cf19aa2e273443307"
GRAPHIFY_PRODUCER_SHA256 = "aa1bd96b0d72d4d7182843c0403f021bf21cb2da61c8bc6c9e766f179aa0b622"
GRAPHIFY_EXTRACTOR_REVISION = "43d54acbfa9e731f7a592bb582c1f4b9d48ed73e"
RERANKER_REVISION = "22e683669bc0f0bd69640a1354a6d0aebcfeede5"
GRAPHIFY_CONFIG = {"extractor": "graphifyy[sql]", "mode": "code-only",
                   "normalization": "stable-staged-graph-v1", "version": "0.9.50"}
HEADING_RE = re.compile(rb"^(#{1,6})[ \t]+(.+?)[ \t]*$")
DECLARATION_RE = re.compile(
    rb"^[ \t]*(?:class|data|def|enum|fn|func|function|interface|locals|module|output|"
    rb"package|provider|resource|struct|terraform|type|variable)\b")
PROJECT_RE = re.compile(r"^[a-z][a-z0-9_-]{0,62}$")
KNOWLEDGE_FAMILIES = (
    "cycle", "gate_evidence", "review", "history_report", "history_capture",
    "telemetry", "benchmark", "execution", "provider_evaluation", "improvement",
)
BENCHMARK_QUERY_STRATA = (
    "code_architecture", "specs_contracts", "operations_recovery",
    "tickets_history", "configuration_tooling",
)
DKS_005_SOURCE_REVISION = "45096bb03891e9771a891d53f92b23863ae08a3e"
SILVER_TRIAL_SECONDS = 604800


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *_args, **_kwargs):
        return None


def canonical_json(value) -> str:
    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False)


def digest_json(value) -> str:
    return hashlib.sha256(canonical_json(value).encode()).hexdigest()


def parse_knowledge_export(value: str):
    try:
        lines = value.splitlines()
        rows = [json.loads(line) for line in lines]
    except json.JSONDecodeError as error:
        raise ValueError("knowledge export is not canonical JSONL") from error
    if len(rows) < 2 or any(canonical_json(row) != line for row, line in zip(rows, lines)):
        raise ValueError("knowledge export is not canonical JSONL")
    manifest, terminal = rows[0], rows[-1]
    if (manifest.get("type") != "manifest" or manifest.get("schema_version") != 1
            or set(manifest.get("families", {})) != set(KNOWLEDGE_FAMILIES)
            or any(value not in ("available", "unavailable") for value in manifest["families"].values())
            or not isinstance(manifest.get("privacy_sequence"), int)
            or not 0 <= manifest["privacy_sequence"] < 2**64
            or not SHA256_RE.fullmatch(manifest.get("privacy_digest", ""))):
        raise ValueError("knowledge export manifest is invalid")
    digest = hashlib.sha256("".join(f"{line}\n" for line in lines[:-1]).encode()).hexdigest()
    if (terminal != {"type": "terminal", "schema_version": 1,
                     "digest": digest, "record_count": len(rows) - 2}
            or manifest.get("record_count") != len(rows) - 2):
        raise ValueError("knowledge export terminal digest is invalid")
    records, privacy, seen = [], [], set()
    content_seen = False
    for row in rows[1:-1]:
        if row.get("type") == "privacy":
            if (content_seen or set(row) != {"type", "schema_version", "family", "record_id",
                                             "reason", "timestamp"}
                    or row.get("schema_version") != 1
                    or row.get("family") not in KNOWLEDGE_FAMILIES
                    or not SHA256_RE.fullmatch(row.get("record_id", ""))
                    or row.get("reason") not in {"deleted", "expired", "forgotten"}
                    or type(row.get("timestamp")) is not int or row["timestamp"] < 0):
                raise ValueError("knowledge export privacy record is invalid")
            privacy.append(row)
            continue
        content_seen = True
        if (set(row) != {"type", "schema_version", "family", "record_id", "revision", "retention", "text"}
                or row.get("type") != "record" or row.get("schema_version") != 1
                or row.get("family") not in KNOWLEDGE_FAMILIES
                or not SHA256_RE.fullmatch(row.get("record_id", ""))
                or not SHA256_RE.fullmatch(row.get("revision", ""))
                or row.get("retention") not in ("retained", "expires")
                or not isinstance(row.get("text"), str)
                or hashlib.sha256(row["text"].encode()).hexdigest() != row["revision"]
                or (row["family"], row["record_id"]) in seen):
            raise ValueError("knowledge export record is invalid")
        seen.add((row["family"], row["record_id"]))
        records.append(row)
    return {"manifest": manifest, "terminal": terminal, "records": records, "privacy": privacy}


def authority_chunks(records, token_count, token_limit=1024):
    output = []
    for record in sorted(records, key=lambda item: (item["family"], item["record_id"])):
        path = f"authority/{record['family']}/{record['record_id']}.json"
        for chunk in chunk_source(record["text"].encode(), path, token_count, token_limit):
            chunk["chunk_id"] = digest_json({"source_kind": record["family"],
                                                "record_id": record["record_id"],
                                                "source_chunk_id": chunk["chunk_id"]})
            chunk.update(family=record["family"], record_id=record["record_id"])
            output.append(chunk)
    return output


def normalize_remote(value: str) -> str:
    if re.fullmatch(r"git@[^:]+:.+", value):
        host, path = value[4:].split(":", 1)
        value = f"https://{host.lower()}/{path}"
    parsed = urllib.parse.urlsplit(value)
    if parsed.scheme.lower() != "https" or not parsed.hostname:
        raise ValueError("unsupported repository remote")
    if parsed.username or parsed.password or parsed.query or parsed.fragment:
        raise ValueError("unsafe repository remote")
    path = parsed.path.rstrip("/")
    if path.endswith(".git"):
        path = path[:-4]
    if not path or path == "/" or ".." in path.split("/"):
        raise ValueError("invalid repository remote")
    return f"https://{parsed.hostname.lower()}{path}"


def run_git(repository: Path, *args: str, binary: bool = False):
    environment = {**os.environ, "GIT_NO_REPLACE_OBJECTS": "1"}
    completed = subprocess.run(["git", *args], cwd=repository, check=True,
                               capture_output=True, text=not binary, env=environment)
    return completed.stdout


def validate_markdown(data: bytes) -> str:
    if data.startswith(b"\xef\xbb\xbf"):
        raise ValueError("Markdown BOM is not supported")
    try:
        return data.decode("utf-8", errors="strict")
    except UnicodeDecodeError as error:
        raise ValueError("Markdown is not valid UTF-8") from error


def accepted_path(path: str) -> bool:
    parts = path.split("/")
    return (path.endswith(".md") and
            (path.startswith("docs/specs/") or path.startswith("docs/tickets/")) and
            "_archive" not in parts)


def accepted_source_path(path: str, profile: dict) -> bool:
    if (not isinstance(path, str) or not path or path.startswith("/") or "\\" in path
            or any(part in ("", ".", "..") for part in path.split("/"))):
        return False
    parts = path.split("/")
    if (any(part in profile.get("excluded_components", []) for part in parts)
            or parts[-1] in profile.get("excluded_basenames", [])
            or any(path.endswith(suffix) for suffix in profile.get("excluded_suffixes", []))):
        return False
    selected = (path in profile.get("root_files", [])
                or any(path == root or path.startswith(root + "/") for root in profile.get("roots", []))
                or "/" not in path and any(
                    path.startswith(rule["prefix"]) and path.endswith(rule["suffix"])
                    for rule in profile.get("root_prefix_suffix", [])))
    if not selected:
        return False
    return (path in profile.get("extensionless_paths", [])
            or any(path.endswith(suffix) for suffix in profile.get("suffixes", [])))


def git_documents(repository: Path, commit: str, expected_remote: str, source_profile=None):
    repository = repository.resolve(strict=True)
    if not COMMIT_RE.fullmatch(commit):
        raise ValueError("commit must be a lowercase 40-hex SHA-1")
    if run_git(repository, "rev-parse", "--show-object-format").strip() != "sha1":
        raise ValueError("repository object format must be sha1")
    actual_remote = normalize_remote(run_git(repository, "remote", "get-url", "origin").strip())
    if actual_remote != normalize_remote(expected_remote):
        raise ValueError("repository remote mismatch")
    if run_git(repository, "cat-file", "-t", commit).strip() != "commit":
        raise ValueError("revision is not a commit")
    selectors = () if source_profile else ("docs/specs", "docs/tickets")
    tree = run_git(repository, "ls-tree", "-rz", "--full-tree", "-r", commit, "--",
                   *selectors, binary=True)
    documents = []
    for row in tree.split(b"\0"):
        if not row:
            continue
        metadata, raw_path = row.split(b"\t", 1)
        mode, kind, raw_oid = metadata.split(b" ", 2)
        path = raw_path.decode("utf-8", errors="strict")
        accepted = accepted_source_path(path, source_profile) if source_profile else accepted_path(path)
        if not accepted:
            continue
        if mode not in {b"100644", b"100755"} or kind != b"blob":
            raise ValueError(f"unsupported Git mode for {path}")
        oid = raw_oid.decode()
        data = run_git(repository, "cat-file", "blob", oid, binary=True)
        validate_markdown(data)
        documents.append({"path": path, "blob_id": oid, "data": data,
                          "chunker": "dks-markdown-v1" if accepted_path(path) else "dks-source-v1"})
    return sorted(documents, key=lambda item: item["path"].encode())


def source_lines(data: bytes):
    position = 0
    while position < len(data):
        start = position
        while position < len(data) and data[position] not in (10, 13):
            position += 1
        payload_end = position
        if position < len(data):
            if data[position] == 13 and position + 1 < len(data) and data[position + 1] == 10:
                position += 2
            else:
                position += 1
        yield start, payload_end, position, data[start:payload_end]


def source_embedding_text(path: str, body: bytes) -> str:
    kind = Path(path).suffix.lstrip(".") or "executable"
    return f"path={path}\nkind={kind}\n\n{body.decode('utf-8')}"


def chunk_source(data: bytes, path: str, token_count, token_limit: int = 1024):
    validate_markdown(data)
    if not data:
        return []
    lines = list(source_lines(data))
    counts = {}

    def measure(start, end):
        key = (start, end)
        if key not in counts:
            counts[key] = token_count(source_embedding_text(path, data[start:end]))
        return counts[key]

    def fitting_end(start, candidates):
        end = None
        for candidate in candidates:
            if measure(start, candidate) > token_limit:
                break
            end = candidate
        return end

    def fitting_codepoint_end(start, candidates):
        low, high = 0, len(candidates)
        while low < high:
            middle = (low + high) // 2
            if measure(start, candidates[middle]) <= token_limit:
                low = middle + 1
            else:
                high = middle
        end = candidates[low - 1] if low else None
        return end if end is not None and measure(start, end) <= token_limit else None

    chunks = []
    content_id = hashlib.sha256(data).hexdigest()
    position = 0
    while position < len(data):
        remaining = [line for line in lines if line[2] > position]
        line_ends = [line[2] for line in remaining]
        end = fitting_end(position, line_ends)
        if end is not None and end < len(data):
            fitted = [line for line in remaining if line[2] <= end]
            blank = [line[2] for line in fitted if not line[3].strip(b" \t")]
            declarations = [line[0] for line in fitted
                            if line[0] > position and DECLARATION_RE.match(line[3])]
            end = max(blank or declarations or [end])
        if end is None:
            candidates = []
            candidate = position
            line_end = line_ends[0]
            while candidate < line_end:
                width = (1 if data[candidate] < 0x80 else 2 if data[candidate] < 0xE0
                         else 3 if data[candidate] < 0xF0 else 4)
                candidate += width
                candidates.append(candidate)
            end = fitting_codepoint_end(position, candidates)
            if end is None:
                raise ValueError("source context leaves no room for one UTF-8 code point")
        body = data[position:end]
        body_sha = hashlib.sha256(body).hexdigest()
        ordinal = len(chunks)
        text = source_embedding_text(path, body)
        identity = {"body_sha256": body_sha, "chunker": "dks-source-v1",
                    "content_id": content_id, "end_byte": end, "heading_path": [],
                    "ordinal": ordinal, "source_kind": Path(path).suffix or "executable",
                    "start_byte": position}
        chunks.append({"start_byte": position, "end_byte": end, "body": body.decode("utf-8"),
                       "body_bytes": body, "body_sha256": body_sha,
                       "chunk_id": digest_json(identity), "content_id": content_id,
                       "embedding_text": text, "embedding_tokens": measure(position, end),
                       "token_count": measure(position, end), "heading_path": [],
                       "ordinal": ordinal, "chunker_version": "dks-source-v1"})
        position = end
    return chunks


def graphify_location(document, value):
    lines = document.get("_graphify_lines")
    if lines is None:
        lines = document["_graphify_lines"] = list(source_lines(document["data"]))
    content_sha256 = document.get("_graphify_content_sha256")
    if content_sha256 is None:
        content_sha256 = document["_graphify_content_sha256"] = hashlib.sha256(document["data"]).hexdigest()
    if value is None and document["data"]:
        return {"path": document["path"], "blob_id": document["blob_id"],
                "content_sha256": content_sha256,
                "start_byte": 0, "end_byte": len(document["data"])}
    match = re.fullmatch(r"L([1-9][0-9]*)", str(value))
    if not match:
        raise ValueError("invalid Graphify source location")
    line = int(match.group(1))
    if line > len(lines):
        raise ValueError("invalid Graphify source location")
    start, _payload_end, end, _payload = lines[line - 1]
    return {"path": document["path"], "blob_id": document["blob_id"],
            "content_sha256": content_sha256,
            "start_byte": start, "end_byte": end}


def validate_graphify_graph(graph: dict, documents: dict, commit: str, version: str,
                            artifact_sha256=None, corpus_manifest_sha256=None):
    if (not COMMIT_RE.fullmatch(commit) or version != "0.9.50" or not isinstance(graph, dict)
            or set(graph) != {"nodes", "edges", "hyperedges", "input_tokens", "output_tokens"}
            or not isinstance(graph.get("nodes"), list) or len(graph["nodes"]) > 100000
            or not isinstance(graph.get("edges"), list) or len(graph["edges"]) > 500000
            or graph.get("hyperedges") != [] or graph.get("input_tokens") != 0
            or graph.get("output_tokens") != 0
            or artifact_sha256 is not None and not SHA256_RE.fullmatch(artifact_sha256)):
        raise ValueError("invalid Graphify artifact")
    seen = set()
    external = set()
    nodes = []
    node_fields = {"_callable", "_callable_class", "_origin", "confidence", "ecosystem",
                   "file_type", "frontmatter", "id", "label", "metadata", "node_kind",
                   "source_file", "source_location", "type", "version"}
    for node in graph["nodes"]:
        if (not isinstance(node, dict) or not isinstance(node.get("id"), str)
                or set(node) - node_fields or node.get("_origin") != "ast"
                or node.get("confidence", "EXTRACTED") not in {"EXTRACTED", "INFERRED", "AMBIGUOUS"}
                or not 1 <= len(node["id"].encode()) <= 512 or node["id"] in seen):
            raise ValueError("invalid Graphify node")
        seen.add(node["id"])
        path = node.get("source_file")
        location = node.get("source_location")
        if path in (None, "") and location in (None, ""):
            external.add(node["id"])
            continue
        if not isinstance(path, str) or path not in documents or location in (None, ""):
            raise ValueError("invalid Graphify source location")
        normalized = {"id": node["id"], "label": str(node.get("label", node["id"])),
                      "confidence": node.get("confidence", "EXTRACTED"),
                      "source_location": graphify_location(documents[path], location)}
        nodes.append(normalized)
    links = []
    dangling = 0
    edge_fields = {"_origin", "confidence", "confidence_score", "context", "relation",
                   "source", "source_file", "source_location", "target", "weight"}
    for link in graph["edges"]:
        if not isinstance(link, dict) or set(link) - edge_fields or link.get("_origin") != "ast":
            raise ValueError("invalid Graphify link")
        if link.get("source") not in seen or link.get("target") not in seen:
            dangling += 1
            continue
        if link["source"] in external or link["target"] in external:
            continue
        if (not isinstance(link.get("relation"), str)
                or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._:-]{0,127}", link.get("relation", ""))
                or link.get("confidence", "EXTRACTED") not in {"EXTRACTED", "INFERRED", "AMBIGUOUS"}):
            raise ValueError("invalid Graphify link")
        path = link.get("source_file")
        if (not isinstance(path, str) or path not in documents
                or link.get("source_location") in (None, "")):
            raise ValueError("invalid Graphify source location")
        links.append({"source": link["source"], "target": link["target"],
                      "relation": link["relation"], "confidence": link.get("confidence", "EXTRACTED"),
                      "source_location": graphify_location(documents[path], link.get("source_location"))})
    identity = {"commit": commit, "version": version, "nodes": nodes, "links": links,
                "corpus_manifest_sha256": corpus_manifest_sha256,
                "excluded_external_nodes": len(external), "excluded_dangling_edges": dangling}
    return {**identity, "artifact_sha256": artifact_sha256 or digest_json(graph),
            "normalized_sha256": digest_json(identity)}


def fence_open(payload: bytes):
    stripped = payload.lstrip(b" ")
    if len(payload) - len(stripped) > 3 or not stripped:
        return None
    marker = stripped[:1]
    if marker not in (b"`", b"~"):
        return None
    count = len(stripped) - len(stripped.lstrip(marker))
    return (marker, count) if count >= 3 else None


def fence_close(payload: bytes, fence) -> bool:
    marker, minimum = fence
    stripped = payload.lstrip(b" ")
    if len(payload) - len(stripped) > 3:
        return False
    count = len(stripped) - len(stripped.lstrip(marker))
    return count >= minimum and not stripped[count:].strip(b" \t")


def markdown_headings(data: bytes):
    lines = list(source_lines(data))
    headings = []
    fence = None
    heading_path = []
    for start, _, end, payload in lines:
        if fence:
            if fence_close(payload, fence):
                fence = None
            continue
        opener = fence_open(payload)
        if opener:
            fence = opener
            continue
        match = HEADING_RE.fullmatch(payload)
        if match:
            level = len(match.group(1))
            text = match.group(2).decode("utf-8")
            heading_path = heading_path[:level - 1] + [text]
            headings.append((start, end, list(heading_path)))
    return headings


def markdown_sections(data: bytes):
    headings = markdown_headings(data)
    sections = []
    body_start = 0
    current_path = []
    for heading_start, heading_end, path in headings:
        if heading_start > body_start:
            sections.append((body_start, heading_start, current_path))
        body_start = heading_end
        current_path = path
    if body_start < len(data):
        sections.append((body_start, len(data), current_path))
    return sections


def paragraph_ranges(data: bytes, start: int, end: int):
    ranges = []
    paragraph_start = None
    paragraph_end = None
    for line_start, _, line_end, payload in source_lines(data[start:end]):
        absolute_start, absolute_end = start + line_start, start + line_end
        blank = not payload.strip(b" \t")
        if blank:
            if paragraph_start is not None:
                ranges.append((paragraph_start, paragraph_end))
                paragraph_start = paragraph_end = None
        else:
            paragraph_start = absolute_start if paragraph_start is None else paragraph_start
            paragraph_end = absolute_end
    if paragraph_start is not None:
        ranges.append((paragraph_start, paragraph_end))
    return ranges


def embedding_text(heading_path, body: bytes) -> str:
    return f"Heading: {' > '.join(heading_path)}\n\n{body.decode('utf-8')}"


def candidate_boundaries(data: bytes, start: int, end: int):
    sentence = []
    whitespace = []
    for match in re.finditer(rb"[.!?][ \t\r\n]+", data[start:end]):
        sentence.append(start + match.end())
    for match in re.finditer(rb"[ \t\r\n]+", data[start:end]):
        whitespace.append(start + match.end())
    codepoints = []
    position = start
    while position < end:
        byte = data[position]
        width = 1 if byte < 0x80 else 2 if byte < 0xE0 else 3 if byte < 0xF0 else 4
        position += width
        codepoints.append(position)
    return sentence, whitespace, codepoints


def split_to_fit(data: bytes, start: int, end: int, heading_path, token_count, token_limit: int):
    result = []
    position = start
    while position < end:
        if token_count(embedding_text(heading_path, data[position:end])) <= token_limit:
            result.append((position, end))
            break
        groups = candidate_boundaries(data, position, end)
        chosen = None
        for boundaries in groups:
            fitting = [boundary for boundary in boundaries if boundary > position and
                       token_count(embedding_text(heading_path, data[position:boundary])) <= token_limit]
            if fitting:
                chosen = max(fitting)
                break
        if chosen is None:
            raise ValueError("heading context leaves no room for one UTF-8 code point")
        result.append((position, chosen))
        position = chosen
    return result


def chunk_markdown(data: bytes, token_count, token_limit: int = 1024):
    validate_markdown(data)
    chunks = []
    ordinal = 0
    for section_start, section_end, heading_path in markdown_sections(data):
        if token_count(embedding_text(heading_path, b"")) >= token_limit:
            raise ValueError("heading context exceeds token limit")
        units = []
        for start, end in paragraph_ranges(data, section_start, section_end):
            units.extend(split_to_fit(data, start, end, heading_path, token_count, token_limit))
        packed = []
        for start, end in units:
            if packed and token_count(embedding_text(heading_path, data[packed[-1][0]:end])) <= token_limit:
                packed[-1] = (packed[-1][0], end)
            else:
                packed.append((start, end))
        content_id = hashlib.sha256(data).hexdigest()
        for start, end in packed:
            body_bytes = data[start:end]
            body_sha = hashlib.sha256(body_bytes).hexdigest()
            identity = {
                "body_sha256": body_sha,
                "chunker": "dks-markdown-v1",
                "content_id": content_id,
                "end_byte": end,
                "heading_path": heading_path,
                "ordinal": ordinal,
                "start_byte": start,
            }
            text = embedding_text(heading_path, body_bytes)
            chunks.append({
                "body": body_bytes.decode("utf-8"),
                "body_bytes": body_bytes,
                "body_sha256": body_sha,
                "chunk_id": digest_json(identity),
                "content_id": content_id,
                "embedding_text": text,
                "embedding_tokens": token_count(text),
                "end_byte": end,
                "heading_path": list(heading_path),
                "ordinal": ordinal,
                "start_byte": start,
            })
            ordinal += 1
    return chunks


def node_id(project_id: str, kind: str, stable_key: str) -> str:
    return digest_json({"kind": kind, "project_id": project_id, "stable_key": stable_key})


def edge_id(project_id: str, revision_id: str, edge_type: str, source_node_id: str,
            target_node_id: str, start_byte: int, end_byte: int) -> str:
    return digest_json({
        "edge_type": edge_type, "end_byte": end_byte, "project_id": project_id,
        "revision_id": revision_id, "source_node_id": source_node_id,
        "start_byte": start_byte, "target_node_id": target_node_id,
    })


def resolve_project_link(source_path: str, link: str):
    parsed = urllib.parse.urlsplit(link)
    if parsed.scheme or parsed.netloc or parsed.query or parsed.path.startswith("/"):
        raise ValueError("external or absolute link")
    target = posixpath.normpath(posixpath.join(posixpath.dirname(source_path),
                                               urllib.parse.unquote(parsed.path)))
    if target == ".." or target.startswith("../"):
        raise ValueError("link escapes project")
    return target, urllib.parse.unquote(parsed.fragment) or None


def ticket_metadata_ranges(value):
    data = value.encode() if isinstance(value, str) else value
    lines = list(source_lines(data))
    if not lines or lines[0][3] != b"---":
        return {}, {}
    metadata = {}
    ranges = {}
    key = None
    for start, _, end, payload in lines[1:]:
        if payload == b"---":
            return metadata, ranges
        line = payload.decode("utf-8")
        if re.fullmatch(r"[a-z_]+:.*", line):
            key, value = line.split(":", 1)
            value = value.strip().strip('"')
            metadata[key] = value if value else []
            if value:
                ranges[(key, value)] = (start, end)
        elif key and isinstance(metadata.get(key), list) and re.fullmatch(r"\s+-\s+.+", line):
            item = re.sub(r"^\s+-\s+", "", line).strip().strip('"')
            metadata[key].append(item)
            ranges[(key, item)] = (start, end)
    return {}, {}


def ticket_metadata(value):
    return ticket_metadata_ranges(value)[0]


def build_graph(project_id: str, revision_id: str, documents, chunks):
    nodes = {}
    edges = {}
    paths = {document["path"] for document in documents}
    headings = {}
    heading_occurrences = {}

    def add_node(kind, stable_key, path=None, heading_path=None):
        identity = node_id(project_id, kind, stable_key)
        nodes[identity] = {
            "node_id": identity, "kind": kind, "stable_key": stable_key,
            "path": path, "heading_path": heading_path,
        }
        return identity

    def add_edge(edge_type, source, target, start, end):
        identity = edge_id(project_id, revision_id, edge_type, source, target, start, end)
        edges[identity] = {
            "edge_id": identity, "edge_type": edge_type, "source_node_id": source,
            "target_node_id": target, "start_byte": start, "end_byte": end,
        }

    path_nodes = {path: add_node("path", path, path=path) for path in sorted(paths)}
    ticket_nodes = {}
    for document in documents:
        if not document["path"].startswith("docs/tickets/"):
            continue
        metadata = ticket_metadata(validate_markdown(document["data"]))
        ticket_id = metadata.get("id")
        if isinstance(ticket_id, str) and ticket_id:
            ticket_nodes[ticket_id] = add_node("ticket", ticket_id, path=document["path"])

    for document in documents:
        path = document["path"]
        for start, end, heading_path in markdown_headings(document["data"]):
            stable_key = f"{path}#{' > '.join(heading_path)}@{start}"
            heading_node = add_node("heading", stable_key, path=path, heading_path=heading_path)
            headings.setdefault((path, heading_path[-1]), []).append(heading_node)
            heading_occurrences.setdefault((path, tuple(heading_path)), []).append((end, heading_node))

    for chunk in chunks:
        path = chunk["path"]
        chunk_node = add_node("chunk", chunk["chunk_id"], path=path,
                              heading_path=chunk["heading_path"])
        if chunk["heading_path"]:
            occurrences = [item for item in heading_occurrences[(path, tuple(chunk["heading_path"]))]
                           if item[0] <= chunk["start_byte"]]
            heading_node = max(occurrences)[1]
            source = heading_node
        else:
            source = path_nodes[path]
        add_edge("contains", source, chunk_node, chunk["start_byte"], chunk["end_byte"])

    for document in documents:
        metadata, ranges = ticket_metadata_ranges(document["data"])
        source = ticket_nodes.get(metadata.get("id"))
        if not source:
            continue
        for dependency in metadata.get("depends_on", []) if isinstance(metadata.get("depends_on"), list) else []:
            target = ticket_nodes.get(dependency) or add_node("ticket", dependency)
            add_edge("depends_on", source, target, *ranges[("depends_on", dependency)])
        for edge_type in ("owns", "reads"):
            values = metadata.get(edge_type, [])
            for value in values if isinstance(values, list) else []:
                normalized = posixpath.normpath(value)
                if normalized == ".." or normalized.startswith("../") or normalized.startswith("/"):
                    raise ValueError("ticket path escapes project")
                target = path_nodes.get(normalized) or add_node("path", normalized, path=normalized)
                add_edge(edge_type, source, target, *ranges[(edge_type, value)])

    link_pattern = re.compile(r"\[[^\]]*\]\(([^)]+)\)")
    for chunk in chunks:
        if chunk.get("chunker_version") == "dks-source-v1":
            continue
        source = node_id(project_id, "chunk", chunk["chunk_id"])
        for match in link_pattern.finditer(chunk["body"]):
            link = match.group(1).strip()
            parsed = urllib.parse.urlsplit(link)
            if parsed.scheme or parsed.netloc or parsed.query or link.startswith("/"):
                continue
            target_path, fragment = resolve_project_link(chunk["path"], link)
            if target_path not in paths:
                continue
            if fragment:
                matches = headings.get((target_path, fragment), [])
                if len(matches) != 1:
                    raise ValueError("Markdown heading link is not unique")
                target = matches[0]
            else:
                target = path_nodes[target_path]
            start = chunk["start_byte"] + len(chunk["body"][:match.start()].encode())
            end = chunk["start_byte"] + len(chunk["body"][:match.end()].encode())
            add_edge("links_to", source, target, start, end)
    return sorted(nodes.values(), key=lambda item: item["node_id"]), \
        sorted(edges.values(), key=lambda item: item["edge_id"])


def rrf(channels, limit: int = 20, k: int = 60):
    scores = {}
    ranks = {}
    for channel, identities in sorted(channels.items()):
        for rank, identity in enumerate(identities, 1):
            scores[identity] = scores.get(identity, 0.0) + 1.0 / (k + rank)
            ranks.setdefault(identity, {})[channel] = rank
    ordered = sorted(scores, key=lambda identity: (-scores[identity], identity))[:limit]
    return [{"id": identity, "score": scores[identity], "ranks": ranks[identity]}
            for identity in ordered]


def exact_query_tokens(query: str):
    tokens = set(re.findall(r"(?<![0-9A-Za-z._/+:-])(?:[0-9a-f]{64}|[0-9a-f]{40}|"
                            r"v?[0-9]+\.[0-9]+(?:\.[0-9]+)?(?:[-+][0-9A-Za-z.-]+)?)"
                            r"(?![0-9A-Za-z._/+:-])", query))
    for path in re.findall(r"`([^`\n]+)`", query):
        parts = path.split("/")
        if (not path.startswith("/") and "\\" not in path and "%" not in path
                and all(part not in ("", ".", "..") for part in parts)
                and posixpath.normpath(path) == path):
            tokens.add(path)
    return sorted(tokens)


def exact_channel(metadata, query, limit=20):
    tokens = exact_query_tokens(query)
    ranked = []
    for chunk_id, row in metadata.items():
        meta = "\n".join(str(row.get(key, "")) for key in (
            "path", "blob_id", "commit", "content_id", "body_sha256", "chunk_id"))
        body = str(row.get("body", ""))
        metadata_matches = sum(token in meta for token in tokens)
        body_matches = sum(body.count(token) for token in tokens)
        if metadata_matches or body_matches:
            distinct_matches = sum(token in meta or token in body for token in tokens)
            ranked.append((-distinct_matches, -metadata_matches, -body_matches, chunk_id))
    return [chunk_id for *_keys, chunk_id in sorted(ranked)[:limit]]


def quality_candidates(channels, limit=50):
    fused = rrf(channels, limit=sum(len(items) for items in channels.values()))
    by_id = {item["id"]: item for item in fused}
    pinned = [by_id[chunk_id] for chunk_id in channels.get("exact", [])[:20]
              if chunk_id in by_id]
    pinned_ids = {item["id"] for item in pinned}
    return pinned + [item for item in fused if item["id"] not in pinned_ids][:limit - len(pinned)]


def quality_rank(channels, metadata, query, rerank_scores=None, limit=10):
    fused = quality_candidates(channels, max(50, limit))
    exact_ids = set(channels.get("exact", []))
    pinned = [item for item in fused if item["id"] in exact_ids]
    remainder = [item for item in fused if item["id"] not in exact_ids]
    if rerank_scores is not None:
        remainder.sort(key=lambda item: (-float(rerank_scores.get(item["id"], float("-inf"))),
                                         -item["score"], item["id"]))
        for item in remainder:
            item["rerank_score"] = rerank_scores.get(item["id"])
    return (pinned + remainder)[:limit]


def sql_literal(value) -> str:
    if value is None:
        return "NULL"
    if isinstance(value, bool):
        return "TRUE" if value else "FALSE"
    if isinstance(value, (int, float)):
        if isinstance(value, float) and not math.isfinite(value):
            raise ValueError("non-finite SQL number")
        return str(value)
    return "'" + str(value).replace("'", "''") + "'"


def load_config(path: str):
    try:
        data = json.loads(Path(path).expanduser().read_text())
    except (OSError, json.JSONDecodeError) as error:
        raise ValueError("knowledge configuration unavailable") from error
    if not isinstance(data.get("projects"), dict):
        raise ValueError("knowledge projects unavailable")
    return data


def selected_project(config, project_id: str):
    if not PROJECT_RE.fullmatch(project_id):
        raise ValueError("invalid project")
    try:
        project = config["projects"][project_id]
    except KeyError as error:
        raise ValueError("unknown project") from error
    if not isinstance(project, dict):
        raise ValueError("invalid project configuration")
    return project


def database_failure(stderr: str):
    if "Keychain item is missing or inaccessible" in stderr:
        return RuntimeError("knowledge database credential keychain unavailable")
    if "Keychain OP_SERVICE_ACCOUNT_TOKEN is invalid" in stderr:
        return RuntimeError("knowledge database credential rejected")
    if "op-session:" in stderr or "dks-psql:" in stderr:
        return RuntimeError("knowledge database credential unavailable")
    if "connection to server" in stderr or "could not connect" in stderr:
        return RuntimeError("knowledge database unavailable")
    return RuntimeError("knowledge database operation failed")


def load_source_profile(project):
    value = project.get("source_profile_file")
    if not value:
        return None
    path = Path(value).expanduser()
    try:
        details = path.lstat()
        if (not stat.S_ISREG(details.st_mode) or details.st_uid != os.getuid()
                or stat.S_IMODE(details.st_mode) & 0o022):
            raise OSError("unsafe source profile")
        raw = path.read_bytes()
        profile = json.loads(raw)
    except (OSError, json.JSONDecodeError) as error:
        raise ValueError("source profile unavailable") from error
    if (hashlib.sha256(raw).hexdigest() != project.get("source_profile_sha256")
            or profile.get("schema_version") != 1
            or profile.get("profile_id") != "dks-source-profile-v1"):
        raise ValueError("source profile identity mismatch")
    return profile


def run_psql(config, project_id: str, sql: str):
    executable = str(Path(config.get("psql", "~/.local/bin/dks-psql")).expanduser())
    completed = subprocess.run([executable, "-X", "-v", "ON_ERROR_STOP=1", "-qAt"],
                               input=f"SET dks.project_id = {sql_literal(project_id)};\n{sql}\n",
                               text=True, capture_output=True)
    if completed.returncode:
        raise database_failure(completed.stderr)
    return completed.stdout.splitlines()


class PsqlSession:
    def __init__(self, config):
        executable = str(Path(config.get("psql", "~/.local/bin/dks-psql")).expanduser())
        self.errors = tempfile.TemporaryFile(mode="w+t")
        self.process = subprocess.Popen(
            [executable, "-X", "-qAt", "-v", "ON_ERROR_STOP=1"],
            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=self.errors,
            text=True, bufsize=1,
        )

    def execute(self, sql: str):
        marker = "dks_" + secrets.token_hex(12)
        try:
            self.process.stdin.write(sql + f"\n\\echo {marker}\n")
            self.process.stdin.flush()
        except (BrokenPipeError, AttributeError) as error:
            raise RuntimeError("knowledge database session failed") from error
        lines = []
        while True:
            line = self.process.stdout.readline()
            if not line:
                self.errors.seek(0)
                raise database_failure(self.errors.read(4096))
            value = line.rstrip("\n")
            if value == marker:
                return lines
            lines.append(value)

    def close(self):
        try:
            if self.process.poll() is None:
                try:
                    self.process.stdin.write("\\quit\n")
                    self.process.stdin.flush()
                    self.process.wait(timeout=5)
                except Exception:
                    try:
                        if self.process.poll() is None:
                            self.process.terminate()
                            try:
                                self.process.wait(timeout=5)
                            except subprocess.TimeoutExpired:
                                self.process.kill()
                                self.process.wait(timeout=5)
                    except Exception:
                        pass
        finally:
            for stream in (self.process.stdin, self.process.stdout, self.errors):
                try:
                    stream.close()
                except Exception:
                    pass

    def __enter__(self):
        return self

    def __exit__(self, *_):
        self.close()


def api_request(config, path: str, payload):
    embedding = config.get("embedding", {})
    key_path = Path(embedding.get("api_key_file", "")).expanduser()
    try:
        key_stat = key_path.lstat()
        if not stat.S_ISREG(key_stat.st_mode) or key_stat.st_uid != os.getuid() or \
                stat.S_IMODE(key_stat.st_mode) != 0o600:
            raise OSError("unsafe credential file")
        key = key_path.read_text().strip()
    except OSError as error:
        raise RuntimeError("embedding credential unavailable") from error
    if not re.fullmatch(r"[0-9a-f]{64}", key):
        raise RuntimeError("embedding credential invalid")
    base_url = embedding.get("url", "http://127.0.0.1:11435")
    parsed = urllib.parse.urlsplit(base_url)
    if parsed.scheme != "http" or parsed.hostname != "127.0.0.1" or parsed.port is None or \
            parsed.username or parsed.password or parsed.path not in ("", "/") or parsed.query or parsed.fragment:
        raise RuntimeError("embedding endpoint is not approved loopback")
    request = urllib.request.Request(
        f"http://127.0.0.1:{parsed.port}" + path,
        data=json.dumps(payload, separators=(",", ":")).encode(),
        headers={"Authorization": f"Bearer {key}", "Content-Type": "application/json"},
    )
    try:
        with urllib.request.build_opener(NoRedirect).open(request, timeout=120) as response:
            return json.load(response)
    except Exception as error:
        raise RuntimeError("embedding request failed") from error


def code_api_request(config, path: str, payload):
    service = config.get("code_embedding", {})
    key_path = Path(service.get("api_key_file", "")).expanduser()
    try:
        details = key_path.lstat()
        if (not stat.S_ISREG(details.st_mode) or details.st_uid != os.getuid()
                or stat.S_IMODE(details.st_mode) != 0o600):
            raise OSError("unsafe code embedding credential")
        key = key_path.read_text().strip()
    except OSError as error:
        raise RuntimeError("code embedding credential unavailable") from error
    url = urllib.parse.urlsplit(service.get("url", ""))
    if (url.scheme != "http" or url.hostname != "127.0.0.1" or url.port is None
            or url.username or url.password or url.path not in ("", "/")
            or url.query or url.fragment or not re.fullmatch(r"[0-9a-f]{64}", key)):
        raise RuntimeError("code embedding endpoint is not approved loopback")
    request = urllib.request.Request(
        f"http://127.0.0.1:{url.port}" + path,
        data=json.dumps(payload, separators=(",", ":")).encode(),
        headers={"Authorization": f"Bearer {key}", "Content-Type": "application/json"},
    )
    try:
        with urllib.request.build_opener(NoRedirect).open(request, timeout=120) as response:
            return json.load(response)
    except Exception as error:
        raise RuntimeError("code embedding request failed") from error


def validate_reranker_config(config, expected_manifest):
    service = config.get("reranker", {})
    if service.get("manifest_sha256") != expected_manifest:
        raise RuntimeError("reranker activation identity mismatch")
    manifest_path = Path(service.get("manifest_file", "")).expanduser()
    try:
        manifest_details = manifest_path.lstat()
        manifest_raw = manifest_path.read_bytes()
        manifest = json.loads(manifest_raw)
    except (OSError, json.JSONDecodeError) as error:
        raise RuntimeError("reranker manifest unavailable") from error
    if (not stat.S_ISREG(manifest_details.st_mode) or manifest_details.st_uid != os.getuid()
            or stat.S_IMODE(manifest_details.st_mode) & 0o022
            or hashlib.sha256(manifest_raw).hexdigest() != expected_manifest
            or manifest.get("model", {}).get("revision")
            != "22e683669bc0f0bd69640a1354a6d0aebcfeede5"):
        raise RuntimeError("reranker manifest identity mismatch")
    return manifest


def rerank(config, query, candidates, expected_manifest=None, timeout=30, batch_size=50):
    if expected_manifest is None:
        return None
    service = config.get("reranker", {})
    manifest = validate_reranker_config(config, expected_manifest)
    key_path = Path(service.get("api_key_file", "")).expanduser()
    try:
        details = key_path.lstat()
        if (not stat.S_ISREG(details.st_mode) or details.st_uid != os.getuid()
                or stat.S_IMODE(details.st_mode) != 0o600):
            raise OSError("unsafe reranker credential")
        key = key_path.read_text().strip()
    except OSError as error:
        raise RuntimeError("reranker credential unavailable") from error
    url = urllib.parse.urlsplit(service.get("url", ""))
    if (url.scheme != "http" or url.hostname != "127.0.0.1" or url.port is None
            or url.username or url.password or url.path not in ("", "/")
            or url.query or url.fragment or not re.fullmatch(r"[0-9a-f]{64}", key)):
        raise RuntimeError("reranker endpoint is not approved loopback")
    scores = []
    for offset in range(0, len(candidates), batch_size):
        batch = candidates[offset:offset + batch_size]
        request = urllib.request.Request(
            f"http://127.0.0.1:{url.port}/rerank",
            data=json.dumps({"model": service.get("model"), "query": query,
                             "documents": [item["body"] for item in batch]},
                            separators=(",", ":")).encode(),
            headers={"Authorization": f"Bearer {key}", "Content-Type": "application/json"},
        )
        try:
            with urllib.request.build_opener(NoRedirect).open(request, timeout=timeout) as response:
                body = json.load(response)
        except Exception as error:
            raise RuntimeError("reranker request failed") from error
        batch_scores = body.get("scores")
        if (body.get("model") != service.get("model")
                or body.get("revision") != manifest["model"]["revision"]
                or body.get("template_sha256") != manifest.get("contract", {}).get("template_sha256")
                or body.get("truncation") != "longest_first" or not isinstance(batch_scores, list)
                or len(batch_scores) != len(batch)
                or any(not isinstance(score, (int, float)) or isinstance(score, bool)
                       or not math.isfinite(score) or not 0 <= score <= 1 for score in batch_scores)):
            raise RuntimeError("reranker response invalid")
        scores.extend(batch_scores)
    return ({item["chunk_id"]: float(score) for item, score in zip(candidates, scores)},
            {"reranker_id": manifest.get("reranker_id"), "revision": body["revision"],
             "runtime": manifest.get("runtime"), "template_sha256": body["template_sha256"],
             "truncation": body["truncation"]})


def token_counter(config):
    def count(text: str):
        body = api_request(config, "/tokenize", {"content": text})
        tokens = body.get("tokens")
        if not isinstance(tokens, list):
            raise RuntimeError("tokenization response invalid")
        return len(tokens)
    return count


def embed(config, texts):
    if not texts:
        return []
    body = api_request(config, "/v1/embeddings", {
        "model": config.get("embedding", {}).get("model"), "input": texts,
    })
    if body.get("model") != config.get("embedding", {}).get("model"):
        raise RuntimeError("embedding response model mismatch")
    rows = body.get("data", [])
    if not isinstance(rows, list) or any(not isinstance(item, dict) or type(item.get("index")) is not int
                                         for item in rows) or \
            sorted(item["index"] for item in rows) != list(range(len(texts))):
        raise RuntimeError("embedding response indexes invalid")
    vectors = [item.get("embedding") for item in sorted(rows, key=lambda item: item["index"])]
    if len(vectors) != len(texts):
        raise RuntimeError("embedding count mismatch")
    for vector in vectors:
        validate_vector(vector)
    return vectors


def validate_vector(vector, dimensions=4096):
    if not isinstance(vector, list) or len(vector) != dimensions or \
            not all(isinstance(value, (int, float)) and math.isfinite(value) for value in vector):
        raise RuntimeError("embedding vector invalid")
    norm = math.sqrt(sum(value * value for value in vector))
    if abs(norm - 1.0) > 1e-3:
        raise RuntimeError("embedding vector is not normalized")


def vector_value(vector):
    values = []
    for item in vector:
        packed = struct.pack("!f", float(item))
        value = struct.unpack("!f", packed)[0]
        values.append(next(text for precision in range(1, 10)
                           if struct.pack("!f", float(text := format(value, f".{precision}g"))) == packed))
    return "[" + ",".join(values) + "]"


def validate_stored_vector(vector, value_text, value_sha256, dimensions=4096):
    validate_vector(vector, dimensions)
    if (not SHA256_RE.fullmatch(value_sha256 or "")
            or hashlib.sha256(value_text.encode()).hexdigest() != value_sha256):
        raise RuntimeError("stored embedding identity mismatch")


def validate_code_embedding_config(config):
    service = config.get("code_embedding", {})
    path = Path(service.get("manifest_file", "")).expanduser()
    try:
        details = path.lstat()
        if (not stat.S_ISREG(details.st_mode) or details.st_uid != os.getuid()
                or stat.S_IMODE(details.st_mode) & 0o022):
            raise OSError("unsafe code embedding manifest")
        raw = path.read_bytes()
        manifest = json.loads(raw)
    except (OSError, json.JSONDecodeError) as error:
        raise RuntimeError("code embedding manifest unavailable") from error
    url = urllib.parse.urlsplit(service.get("url", ""))
    if (hashlib.sha256(raw).hexdigest() != service.get("manifest_sha256")
            or manifest.get("embedding_space_id") != service.get("space_id")
            or manifest.get("contract") != {"context_tokens": 32768, "dimensions": 3584,
                                               "normalization": "l2", "pooling": "last"}
            or manifest.get("service", {}).get("host") != "127.0.0.1"
            or manifest.get("service", {}).get("port") != url.port
            or service.get("model") != "nomic-embed-code-q4km"):
        raise RuntimeError("code embedding manifest identity mismatch")


def code_embed(config, texts):
    if not texts:
        return []
    service = config.get("code_embedding", {})
    body = code_api_request(config, "/v1/embeddings", {"model": service.get("model"), "input": texts})
    rows = body.get("data", [])
    if (body.get("model") != service.get("model") or not isinstance(rows, list)
            or any(not isinstance(item, dict) or type(item.get("index")) is not int for item in rows)
            or sorted(item["index"] for item in rows) != list(range(len(texts)))):
        raise RuntimeError("code embedding response invalid")
    vectors = [item.get("embedding") for item in sorted(rows, key=lambda item: item["index"])]
    for vector in vectors:
        validate_vector(vector, 3584)
    return vectors


def validate_embedding_config(config):
    embedding = config.get("embedding", {})
    manifest_path = Path(embedding.get("manifest_file", "")).expanduser()
    try:
        manifest_stat = manifest_path.lstat()
        if not stat.S_ISREG(manifest_stat.st_mode) or manifest_stat.st_uid != os.getuid() or \
                stat.S_IMODE(manifest_stat.st_mode) & 0o022:
            raise OSError("unsafe manifest file")
        raw = manifest_path.read_bytes()
        manifest = json.loads(raw)
    except (OSError, json.JSONDecodeError) as error:
        raise RuntimeError("embedding manifest unavailable") from error
    parsed = urllib.parse.urlsplit(embedding.get("url", ""))
    valid = (
        hashlib.sha256(raw).hexdigest() == embedding.get("manifest_sha256")
        and manifest.get("embedding_space_id") == embedding.get("space_id")
        and manifest.get("contract", {}).get("dimensions") == 4096
        and manifest.get("contract", {}).get("normalization") == "l2"
        and manifest.get("service", {}).get("host") == "127.0.0.1"
        and manifest.get("service", {}).get("port") == parsed.port
        and embedding.get("model") == "qwen3-embedding-8b-q4km"
    )
    if not valid:
        raise RuntimeError("embedding manifest identity mismatch")


def validate_service_health(config, name):
    service = config.get(name, {})
    parsed = urllib.parse.urlsplit(service.get("url", ""))
    if (parsed.scheme != "http" or parsed.hostname != "127.0.0.1" or parsed.port is None
            or parsed.username or parsed.password or parsed.path not in ("", "/")
            or parsed.query or parsed.fragment):
        raise RuntimeError(f"{name} endpoint is not approved loopback")
    try:
        request = urllib.request.Request(f"http://127.0.0.1:{parsed.port}/health")
        with urllib.request.build_opener(NoRedirect).open(request, timeout=2) as response:
            raw = response.read(8193)
        body = json.loads(raw)
        expected = ({"status": "ok"} if name in {"embedding", "code_embedding"} else
                    {"ready": True, "model": service.get("model"), "revision": RERANKER_REVISION,
                     "batch_size": 1, "max_mps_memory_gib": 20,
                     "max_process_memory_gib": 24})
        if len(raw) > 8192 or body != expected:
            raise ValueError("invalid health payload")
    except Exception as error:
        raise RuntimeError(f"{name} health unavailable") from error


def command_status(args, config, project):
    lines = run_psql(config, args.project, f"""
SELECT json_build_object(
  'project', p.project_id,
  'active_revision', p.active_revision_id,
  'active_run', p.active_run_id,
  'embedding_space', p.active_embedding_space_id,
  'embedding_manifest', (SELECT manifest_sha256 FROM dks.embedding_spaces e
                         WHERE e.project_id=p.project_id
                           AND e.embedding_space_id=p.active_embedding_space_id),
  'migration', (SELECT max(version) FROM dks.schema_migrations),
  'last_run', (SELECT json_build_object('run_id', r.run_id, 'revision', r.revision_id, 'state', r.state, 'finished_at', r.finished_at)
               FROM dks.sync_runs r WHERE r.project_id=p.project_id ORDER BY r.created_at DESC, r.run_id DESC LIMIT 1),
  'records', (SELECT count(*) FROM dks.source_records r WHERE r.project_id=p.project_id AND r.revision_id=p.active_revision_id),
  'chunks', (SELECT count(*) FROM dks.revision_chunks c WHERE c.project_id=p.project_id AND c.revision_id=p.active_revision_id)
  ,'source_records', (SELECT coalesce(json_agg(json_build_array(r.path,r.blob_id) ORDER BY r.path),'[]'::json)
                      FROM dks.source_records r WHERE r.project_id=p.project_id AND r.revision_id=p.active_revision_id)
  ,'chunkers', (SELECT coalesce(json_agg(DISTINCT c.chunker_version ORDER BY c.chunker_version),'[]'::json)
                FROM dks.revision_chunks r JOIN dks.knowledge_chunks c USING(project_id,chunk_id)
                WHERE r.project_id=p.project_id AND r.revision_id=p.active_revision_id)
  ,'code_chunks', (SELECT count(DISTINCT c.chunk_id) FROM dks.revision_chunks r
                   JOIN dks.knowledge_chunks c USING(project_id,chunk_id)
                   WHERE r.project_id=p.project_id AND r.revision_id=p.active_revision_id
                     AND c.chunker_version='dks-source-v1')
  ,'code_embeddings', (SELECT count(DISTINCT e.chunk_id) FROM dks.code_embeddings e
                        JOIN dks.revision_chunks r USING(project_id,chunk_id)
                        WHERE e.project_id=p.project_id AND r.revision_id=p.active_revision_id
                          AND e.embedding_space_id={sql_literal(config.get('code_embedding', {}).get('space_id'))})
  ,'code_identity', (SELECT json_build_object('embedding_space',s.embedding_space_id,
      'manifest_sha256',s.manifest_sha256) FROM dks.code_embedding_spaces s
      WHERE s.project_id=p.project_id
        AND s.embedding_space_id={sql_literal(config.get('code_embedding', {}).get('space_id'))})
  ,'authority', (SELECT json_build_object(
      'privacy_sequence',s.privacy_sequence::text,'privacy_digest',s.privacy_digest,
      'manifests',(SELECT coalesce(json_agg(a.manifest_sha256 ORDER BY a.source_kind),'[]'::json)
                   FROM dks.authority_snapshots a WHERE a.project_id=p.project_id AND a.state='active'),
      'embedding_spaces',(SELECT coalesce(json_agg(DISTINCT e.embedding_space_id),'[]'::json)
                   FROM dks.authority_embeddings e JOIN dks.authority_snapshots a
                   USING(project_id,source_kind,snapshot_id)
                   WHERE a.project_id=p.project_id AND a.state='active'))
    FROM dks.privacy_state s WHERE s.project_id=p.project_id)
  ,'graphify', (SELECT json_build_object('revision',g.revision_id,'artifact_sha256',g.artifact_sha256,
      'source_profile_sha256',g.source_profile_sha256,'corpus_manifest_sha256',g.corpus_manifest_sha256,
      'extractor_version',g.extractor_version,'extractor_revision',g.extractor_revision,
      'config_sha256',g.config_sha256,'execution_receipt_sha256',g.execution_receipt_sha256,
      'execution_receipt',g.execution_receipt,
      'runtime_sha256',g.runtime_sha256,'producer_sha256',g.producer_sha256)
    FROM dks.graph_imports g WHERE g.project_id=p.project_id AND g.state='active')
  ,'ranking_policy', (SELECT policy_id FROM dks.ranking_policies q
                       WHERE q.project_id=p.project_id AND q.active)
  ,'ranking_evidence_class', (SELECT evidence_class FROM dks.ranking_policies q
                       WHERE q.project_id=p.project_id AND q.active)
  ,'trial_expires_at', (SELECT extract(epoch FROM trial_expires_at)::bigint FROM dks.ranking_policies q
                       WHERE q.project_id=p.project_id AND q.active)
)::text FROM dks.projects p WHERE p.project_id=current_setting('dks.project_id');
""")
    if not lines:
        return {"project": args.project, "active_revision": None}
    value = json.loads(lines[-1])
    records = sorted(value.pop("source_records", []), key=lambda item: item[0].encode())
    value["source_records_sha256"] = digest_json(records)
    return value


def reconcile_settings(config, project):
    settings = config.get("reconcile", {})
    enabled = settings.get("enabled")
    interval = settings.get("interval_seconds")
    timeout = settings.get("timeout_seconds")
    reference = project.get("reconcile_ref")
    fetch = project.get("reconcile_fetch")
    if (type(enabled) is not bool or type(fetch) is not bool or type(interval) is not int
            or type(timeout) is not int or not 300 <= interval <= 86400
            or not 60 <= timeout <= 86400 or not isinstance(reference, str)):
        raise ValueError("reconcile configuration invalid")
    match = re.fullmatch(r"refs/remotes/([A-Za-z0-9][A-Za-z0-9._-]{0,63})/([A-Za-z0-9][A-Za-z0-9._/-]{0,255})", reference)
    if not match or ".." in match.group(2).split("/"):
        raise ValueError("reconcile ref invalid")
    return {"enabled": enabled, "interval_seconds": interval, "timeout_seconds": timeout,
            "reference": reference, "remote": match.group(1), "branch": match.group(2), "fetch": fetch}


def resolve_reconcile_commit(project, settings, refresh=False):
    repository = Path(project.get("repository", "")).expanduser().resolve(strict=True)
    actual = normalize_remote(run_git(repository, "remote", "get-url", settings["remote"]).strip())
    if actual != normalize_remote(project.get("remote", "")):
        raise ValueError("repository remote mismatch")
    if refresh and settings["fetch"]:
        run_git(repository, "fetch", "--no-tags", settings["remote"],
                f"+refs/heads/{settings['branch']}:{settings['reference']}")
    commit = run_git(repository, "rev-parse", "--verify", settings["reference"] + "^{commit}").strip()
    if not COMMIT_RE.fullmatch(commit):
        raise RuntimeError("reconcile ref did not resolve to SHA-1")
    return commit


def authority_is_fresh(status, export, embedding_space=None):
    available = sum(value == "available" for value in export["manifest"]["families"].values())
    authority = status.get("authority") or {}
    spaces = authority.get("embedding_spaces") or []
    return (authority.get("privacy_sequence") == str(export["manifest"]["privacy_sequence"])
            and authority.get("privacy_digest") == export["manifest"]["privacy_digest"]
            and authority.get("manifests") == [export["terminal"]["digest"]] * available
            and (not export["records"] or spaces == [embedding_space]))


def expected_source_identity(project, commit):
    documents = git_documents(Path(project.get("repository", "")).expanduser(), commit,
                              project.get("remote", ""), load_source_profile(project))
    return (digest_json([[item["path"], item["blob_id"]] for item in documents]),
            sorted(set(item["chunker"] for item in documents)))


def expected_corpus_manifest_sha(project_id, project, commit):
    documents = git_documents(Path(project.get("repository", "")).expanduser(), commit,
                              project.get("remote", ""), load_source_profile(project))
    identity = {"schema_version": 1, "project": project_id, "commit": commit,
                "source_profile_sha256": project.get("source_profile_sha256"),
                "documents": [{"path": item["path"], "blob_id": item["blob_id"],
                               "content_sha256": hashlib.sha256(item["data"]).hexdigest()}
                              for item in documents]}
    return hashlib.sha256((canonical_json(identity) + "\n").encode()).hexdigest()


def git_is_fresh(status, config, project, commit):
    records_sha, chunkers = expected_source_identity(project, commit)
    embedding = config.get("embedding", {})
    return (status.get("active_revision") == commit
            and status.get("embedding_space") == embedding.get("space_id")
            and status.get("embedding_manifest") == embedding.get("manifest_sha256")
            and status.get("source_records_sha256") == records_sha and status.get("chunkers") == chunkers)


def graph_is_fresh(status, config, project_id, project, commit):
    graph = status.get("graphify") or {}
    producer = Path(config.get("graphify_producer", "~/.local/bin/dbsctr-graphify")).expanduser()
    try:
        producer_sha = hashlib.sha256(producer.read_bytes()).hexdigest()
    except OSError:
        return False
    corpus_sha = expected_corpus_manifest_sha(project_id, project, commit)
    receipt = graph.get("execution_receipt")
    try:
        validate_graphify_receipt(receipt, project_id, graph.get("artifact_sha256"), corpus_sha)
    except ValueError:
        return False
    receipt_sha = hashlib.sha256((canonical_json(receipt) + "\n").encode()).hexdigest()
    return (graph.get("revision") == commit
            and graph.get("source_profile_sha256") == project.get("source_profile_sha256")
            and graph.get("extractor_version") == GRAPHIFY_CONFIG["version"]
            and graph.get("extractor_revision") == GRAPHIFY_EXTRACTOR_REVISION
            and graph.get("config_sha256") == digest_json(GRAPHIFY_CONFIG)
            and graph.get("corpus_manifest_sha256") == corpus_sha
            and graph.get("execution_receipt_sha256") == receipt_sha
            and graph.get("runtime_sha256") == GRAPHIFY_RUNTIME_SHA256
            and graph.get("producer_sha256") == GRAPHIFY_PRODUCER_SHA256
            and producer_sha == GRAPHIFY_PRODUCER_SHA256)


def open_reconcile_lock(project):
    state_root = Path(project.get("knowledge_state_root", "")).expanduser()
    if not state_root.is_absolute():
        raise ValueError("knowledge state root is unavailable")
    directory = state_root / "knowledge" / "reconcile"
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    if directory.is_symlink():
        raise RuntimeError("reconcile lock directory is unsafe")
    project_id = project.get("project_id", "dotfiles-ai")
    if not PROJECT_RE.fullmatch(project_id):
        raise ValueError("invalid reconcile lock project")
    descriptor = os.open(directory / f"{project_id}.lock",
                         os.O_RDWR | os.O_CREAT | os.O_NONBLOCK | getattr(os, "O_NOFOLLOW", 0), 0o600)
    details = os.fstat(descriptor)
    if (not stat.S_ISREG(details.st_mode) or details.st_uid != os.getuid()
            or stat.S_IMODE(details.st_mode) != 0o600):
        os.close(descriptor)
        raise RuntimeError("reconcile lock is unsafe")
    return os.fdopen(descriptor, "a+")


def command_doctor(args, config, project):
    settings = reconcile_settings(config, project)
    project = {**project, "project_id": args.project}
    if not settings["enabled"]:
        return {"schema_version": 1, "project": args.project, "enabled": False,
                "state": "disabled", "target_revision": None, "healthy": True,
                "failures": [], "status": None}
    failures = []
    try:
        ensure_quality_policy(config, args.project)
    except (ValueError, RuntimeError, subprocess.SubprocessError):
        failures.append("ranking_policy_unavailable")
    try:
        status = command_status(args, config, project)
    except (ValueError, RuntimeError, subprocess.SubprocessError):
        return {"schema_version": 1, "project": args.project, "enabled": settings["enabled"],
                "target_revision": None, "healthy": False,
                "failures": ["database_unavailable"], "status": None}
    if status.get("migration") != 7:
        failures.append("schema_unavailable")
    try:
        active_ranking_policy(config, args.project)
    except (ValueError, RuntimeError, subprocess.SubprocessError):
        failures.append("ranking_policy_unavailable")
    try:
        handle = open_reconcile_lock(project)
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
            fcntl.flock(handle, fcntl.LOCK_UN)
        except BlockingIOError:
            failures.append("busy")
        finally:
            handle.close()
    except (OSError, ValueError, RuntimeError):
        failures.append("lock_unavailable")
    try:
        target = resolve_reconcile_commit(project, settings)
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError):
        target = None
        failures.append("source_ref_unavailable")
    embedding = config.get("embedding", {})
    code = config.get("code_embedding", {})
    if target and not git_is_fresh(status, config, project, target):
        failures.append("git_stale")
    if (status.get("code_chunks") != status.get("code_embeddings")
            or status.get("code_identity") != {"embedding_space": code.get("space_id"),
                                                "manifest_sha256": code.get("manifest_sha256")}):
        failures.append("code_stale")
    if target and not graph_is_fresh(status, config, args.project, project, target):
        failures.append("graph_stale")
    try:
        export = parse_knowledge_export(lifecycle_output(config, project, "knowledge-export"))
        if not authority_is_fresh(status, export, embedding.get("space_id")):
            failures.append("authority_stale")
    except (ValueError, RuntimeError, json.JSONDecodeError):
        failures.append("authority_unavailable")
    for name, validate in (("embedding", lambda: validate_embedding_config(config)),
                           ("code_embedding", lambda: validate_code_embedding_config(config)),
                           ("reranker", lambda: validate_reranker_config(
                               config, config.get("reranker", {}).get("manifest_sha256")))):
        try:
            validate()
            validate_service_health(config, name)
        except (ValueError, RuntimeError):
            failures.append(name + "_unavailable")
    return {"schema_version": 1, "project": args.project, "enabled": settings["enabled"],
            "target_revision": target, "healthy": not failures, "failures": sorted(set(failures)),
            "status": status}


def active_ranking_policy(config, project_id, session=None):
    sql = """
SELECT json_build_object('activation_id',activation_id,'policy_id',policy_id,
  'manifest_sha256',manifest_sha256,'benchmark_sha256',benchmark_sha256,
  'benchmark_aggregate_sha256',benchmark_aggregate_sha256,
  'source_revision_id',source_revision_id,'source_projection_sha256',source_projection_sha256,
  'authority_snapshot_set_sha256',authority_snapshot_set_sha256,
  'authority_projection_sha256',authority_projection_sha256,
  'privacy_sequence',privacy_sequence::text,'privacy_digest',privacy_digest,
  'current_source_revision',(SELECT active_revision_id FROM dks.projects p WHERE p.project_id=ranking_policies.project_id),
  'current_privacy_sequence',(SELECT privacy_sequence::text FROM dks.privacy_state s WHERE s.project_id=ranking_policies.project_id),
  'current_privacy_digest',(SELECT privacy_digest FROM dks.privacy_state s WHERE s.project_id=ranking_policies.project_id),
  'code_embedding_space_id',code_embedding_space_id,
  'graph_artifact_sha256',graph_artifact_sha256,
  'reranker_manifest_sha256',reranker_manifest_sha256,
  'evidence_class',evidence_class,
  'trial_expires_at',extract(epoch FROM trial_expires_at)::bigint::text,
  'trial_expired',coalesce(trial_expires_at <= now(),false))::text
FROM dks.ranking_policies WHERE project_id=current_setting('dks.project_id') AND active;
"""
    lines = session.execute(sql) if session else run_psql(config, project_id, sql)
    if len(lines) != 1:
        raise RuntimeError("active ranking policy is unavailable")
    policy = json.loads(lines[0])
    evidence_class = policy.get("evidence_class")
    if (policy.get("policy_id") not in {"dks-rrf-v1", "dks-quality-v2"}
            or not SHA256_RE.fullmatch(policy.get("manifest_sha256", ""))
            or (policy["policy_id"] == "dks-rrf-v1"
                and (evidence_class != "baseline" or policy.get("trial_expires_at") is not None))
            or (policy["policy_id"] == "dks-quality-v2"
                and (evidence_class not in {"human", "silver"}
                     or (evidence_class == "human" and policy.get("trial_expires_at") is not None)
                     or (evidence_class == "silver"
                         and (not str(policy.get("trial_expires_at") or "").isdigit()
                              or policy.get("trial_expired") is not False))
                     or not SHA256_RE.fullmatch(policy.get("benchmark_sha256") or "")
                     or not SHA256_RE.fullmatch(policy.get("benchmark_aggregate_sha256") or "")
                     or not SHA256_RE.fullmatch(policy.get("activation_id") or "")
                     or not COMMIT_RE.fullmatch(policy.get("source_revision_id") or "")
                     or any(not SHA256_RE.fullmatch(policy.get(name) or "") for name in (
                         "source_projection_sha256", "authority_snapshot_set_sha256",
                         "authority_projection_sha256", "privacy_digest"))
                     or not str(policy.get("privacy_sequence") or "").isdigit()
                     or policy.get("current_source_revision") != policy.get("source_revision_id")
                     or policy.get("current_privacy_sequence") != policy.get("privacy_sequence")
                     or policy.get("current_privacy_digest") != policy.get("privacy_digest")))
            or any(value is not None and not SHA256_RE.fullmatch(value) for value in (
                policy.get("graph_artifact_sha256"), policy.get("reranker_manifest_sha256")))):
        raise RuntimeError("active ranking policy identity is invalid")
    return policy


def ensure_quality_policy(config, project_id):
    with PsqlSession(config) as session:
        session.execute(f"SET dks.project_id={sql_literal(project_id)};")
        for lock_name in (project_id, project_id + ":code", project_id + ":authority"):
            locked = session.execute(
                f"SELECT pg_try_advisory_lock(hashtextextended({sql_literal(lock_name)}, 0));")
            if not locked or locked[-1] != "t":
                raise RuntimeError("quality policy lock unavailable")
        session.execute("BEGIN;")
        session.execute("SELECT activation_id FROM dks.ranking_policies "
                        "WHERE project_id=current_setting('dks.project_id') AND active FOR UPDATE;")
        try:
            policy = active_ranking_policy(config, project_id, session)
            validate_quality_projection(config, project_id, policy, session)
            if policy["policy_id"] == "dks-quality-v2" and policy["evidence_class"] == "silver":
                if policy.get("code_embedding_space_id"):
                    validate_code_embedding_config(config)
                    validate_service_health(config, "code_embedding")
                if policy.get("reranker_manifest_sha256"):
                    validate_reranker_config(config, policy["reranker_manifest_sha256"])
                    validate_service_health(config, "reranker")
        except (ValueError, RuntimeError):
            session.execute("\n".join(ranking_fallback_statements(project_id)))
            session.execute("COMMIT;")
            return {"ranking_policy": "dks-rrf-v1", "state": "restored"}
        session.execute("COMMIT;")
    return {"ranking_policy": policy["policy_id"], "state": "active"}


def imported_graph_channel(config, project_id, artifact, seed_ids, session=None):
    if not artifact or not seed_ids:
        return []
    seeds = ",".join(f"({rank},{sql_literal(chunk_id)})"
                     for rank, chunk_id in enumerate(seed_ids, 1))
    sql = f"""
WITH seeds(seed_rank,chunk_id) AS (VALUES {seeds}), adjacent AS (
  SELECT s.seed_rank,e.relation,e.edge_id,target.chunk_id
  FROM seeds s
  JOIN dks.imported_graph_node_chunks source ON source.chunk_id=s.chunk_id
  JOIN dks.imported_graph_edges e ON e.project_id=source.project_id
    AND e.artifact_sha256=source.artifact_sha256 AND e.source_node_id=source.node_id
  JOIN dks.imported_graph_node_chunks target ON target.project_id=e.project_id
    AND target.artifact_sha256=e.artifact_sha256 AND target.node_id=e.target_node_id
  WHERE e.artifact_sha256={sql_literal(artifact)} AND e.confidence='EXTRACTED'
  UNION ALL
  SELECT s.seed_rank,e.relation,e.edge_id,source.chunk_id
  FROM seeds s
  JOIN dks.imported_graph_node_chunks target ON target.chunk_id=s.chunk_id
  JOIN dks.imported_graph_edges e ON e.project_id=target.project_id
    AND e.artifact_sha256=target.artifact_sha256 AND e.target_node_id=target.node_id
  JOIN dks.imported_graph_node_chunks source ON source.project_id=e.project_id
    AND source.artifact_sha256=e.artifact_sha256 AND source.node_id=e.source_node_id
  WHERE e.artifact_sha256={sql_literal(artifact)} AND e.confidence='EXTRACTED'
)
SELECT chunk_id FROM adjacent ORDER BY seed_rank,relation,edge_id,chunk_id;
"""
    lines = session.execute(sql) if session else run_psql(config, project_id, sql)
    seen = set(seed_ids)
    result = []
    for chunk_id in lines:
        if chunk_id not in seen:
            seen.add(chunk_id)
            result.append(chunk_id)
        if len(result) == 20:
            break
    return result


def graphify_provenance(config, project_id, artifact, session=None):
    if not artifact:
        return None
    sql = f"""
SELECT json_build_object('artifact_sha256',artifact_sha256,'normalized_sha256',normalized_sha256,
  'extractor_version',extractor_version,'extractor_revision',extractor_revision,
  'config_sha256',config_sha256,'source_profile_sha256',source_profile_sha256,
  'corpus_manifest_sha256',corpus_manifest_sha256,'execution_receipt_sha256',execution_receipt_sha256,
  'excluded_external_nodes',excluded_external_nodes,'excluded_dangling_edges',excluded_dangling_edges)::text
FROM dks.graph_imports WHERE project_id=current_setting('dks.project_id')
  AND artifact_sha256={sql_literal(artifact)} AND state='active';
"""
    lines = session.execute(sql) if session else run_psql(config, project_id, sql)
    if len(lines) != 1:
        raise RuntimeError("active Graphify provenance is unavailable")
    return json.loads(lines[0])


def graph_channel(project_id, seed_ids, edges, nodes, chunks):
    node_by_id = {item["node_id"]: item for item in nodes}
    chunks_by_path = {}
    for chunk in chunks:
        chunks_by_path.setdefault(chunk["path"], []).append(chunk)
    for values in chunks_by_path.values():
        values.sort(key=lambda item: item["ordinal"])
    seed_nodes = {node_id(project_id, "chunk", chunk_id): rank
                  for rank, chunk_id in enumerate(seed_ids, 1)}
    candidates = []
    for edge in sorted(edges, key=lambda item: item["edge_id"]):
        adjacent = None
        seed_rank = seed_nodes.get(edge["source_node_id"])
        if seed_rank is not None:
            adjacent = edge["target_node_id"]
        else:
            seed_rank = seed_nodes.get(edge["target_node_id"])
            if seed_rank is not None:
                adjacent = edge["source_node_id"]
        if adjacent is None:
            continue
        node = node_by_id.get(adjacent)
        if not node:
            continue
        mapped = []
        if node["kind"] == "chunk":
            mapped = [node["stable_key"]]
        elif node.get("path"):
            for chunk in chunks_by_path.get(node["path"], []):
                if node["kind"] != "heading" or chunk["heading_path"][:len(node["heading_path"])] == node["heading_path"]:
                    mapped.append(chunk["chunk_id"])
        for chunk_id in mapped:
            candidates.append((seed_rank, edge["edge_type"], edge["edge_id"], chunk_id))
    seen = set()
    ordered = []
    for *_, chunk_id in sorted(candidates):
        if chunk_id not in seen:
            seen.add(chunk_id)
            ordered.append(chunk_id)
        if len(ordered) == 20:
            break
    return ordered


def silver_benchmark_policy(args, config, session):
    system = getattr(args, "benchmark_system", None)
    if system not in {"baseline", "code", "reranker", "code_reranker"}:
        raise ValueError("silver benchmark system is invalid")
    rows = session.execute(f"""
SELECT json_build_object('revision',p.active_revision_id,'graph_artifact',(
  SELECT artifact_sha256 FROM dks.graph_imports g WHERE g.project_id=p.project_id
    AND g.revision_id=p.active_revision_id AND g.state='active'))::text
FROM dks.projects p WHERE p.project_id=current_setting('dks.project_id');
""")
    if len(rows) != 1:
        raise RuntimeError("silver benchmark projection is unavailable")
    identity = json.loads(rows[0])
    if identity.get("revision") != args.commit:
        raise RuntimeError("silver benchmark source revision is not active")
    quality = system != "baseline"
    return {"activation_id": "dks-silver-v1", "policy_id": "dks-quality-v2" if quality else "dks-rrf-v1",
            "source_revision_id": args.commit,
            "code_embedding_space_id": (config.get("code_embedding", {}).get("space_id")
                                        if system in {"code", "code_reranker"} else None),
            "graph_artifact_sha256": identity.get("graph_artifact") if quality else None,
            "reranker_manifest_sha256": (config.get("reranker", {}).get("manifest_sha256")
                                         if system in {"reranker", "code_reranker"} else None),
            "evidence_class": "silver", "trial_expires_at": None}


def command_query_transaction(args, config, project, session):
    benchmark = getattr(args, "benchmark_system", None) is not None
    policy = (silver_benchmark_policy(args, config, session) if benchmark
              else active_ranking_policy(config, args.project, session))
    if not benchmark:
        validate_quality_projection(config, args.project, policy, session)
    maximum = 100 if benchmark else 10 if policy["policy_id"] == "dks-quality-v2" else 20
    if not 1 <= args.limit <= maximum:
        raise ValueError(f"query limit must be between 1 and {maximum}")
    if (policy["policy_id"] == "dks-quality-v2" and args.commit
            and args.commit != policy["source_revision_id"]):
        raise RuntimeError("quality policy is not valid for the selected revision")
    validate_embedding_config(config)
    vector = embed(config, [f"Instruct: Retrieve authoritative DBSCTR engineering evidence\nQuery:{args.text}"])[0]
    vector_sql = "[" + ",".join(format(float(value), ".9g") for value in vector) + "]"
    code_sql = ""
    if policy.get("code_embedding_space_id"):
        validate_code_embedding_config(config)
        prefix = "Represent this query for searching relevant code: "
        code_vector = code_embed(config, [prefix + args.text])[0]
        code_value = "[" + ",".join(format(float(value), ".9g") for value in code_vector) + "]"
        code_sql = f"""
  UNION ALL
  SELECT 'code_vector', c.chunk_id, -(e.value <#> {sql_literal(code_value)}::vector(3584))
  FROM scoped_chunks c JOIN dks.code_embeddings e USING(project_id,chunk_id)
  WHERE c.chunker_version='dks-source-v1'
    AND e.embedding_space_id={sql_literal(policy['code_embedding_space_id'])}
"""
    revision_filter = (sql_literal(args.commit) if args.commit else
                       "(SELECT active_revision_id FROM dks.projects WHERE project_id=current_setting('dks.project_id'))")
    sql = f"""
WITH git_chunks AS (
  SELECT DISTINCT ON (c.chunk_id) rc.project_id, rc.revision_id, rc.path, sr.blob_id,
         c.chunk_id, c.content_id, c.ordinal, c.start_byte, c.end_byte, c.heading_path,
          c.body_sha256, c.body, c.search_tsv, c.chunker_version, e.value
  FROM dks.revision_chunks rc
  JOIN dks.knowledge_chunks c USING (project_id, chunk_id)
  JOIN dks.source_records sr USING (project_id, revision_id, path)
  JOIN dks.embeddings e USING (project_id, chunk_id)
  JOIN dks.projects p USING (project_id)
  WHERE rc.revision_id={revision_filter} AND e.embedding_space_id=p.active_embedding_space_id
  ORDER BY c.chunk_id, rc.path
), authority_scoped AS (
  SELECT c.project_id, c.snapshot_id AS revision_id,
         ('authority/' || c.source_kind || '/' || c.record_id || '.json') AS path,
         r.revision AS blob_id, c.chunk_id, r.content_id, c.ordinal, c.start_byte, c.end_byte,
           '[]'::jsonb AS heading_path, c.body_sha256, c.body, c.search_tsv,
          'dks-authority-v1' AS chunker_version, e.value
  FROM dks.authority_chunks c
  JOIN dks.authority_records r USING (project_id,source_kind,snapshot_id,record_id)
  JOIN dks.authority_snapshots s USING (project_id,source_kind,snapshot_id)
  JOIN dks.authority_embeddings e USING (project_id,source_kind,snapshot_id,record_id,chunk_id)
  JOIN dks.projects p USING (project_id)
   WHERE {'false' if benchmark else "s.state='active'"} AND e.embedding_space_id=p.active_embedding_space_id
), scoped_chunks AS (
  SELECT * FROM git_chunks
  UNION ALL
  SELECT * FROM authority_scoped
), candidates AS (
  SELECT 'lexical' AS channel, c.chunk_id,
         ts_rank_cd(c.search_tsv, websearch_to_tsquery('english', {sql_literal(args.text)}), 32)::double precision AS score
  FROM scoped_chunks c
  WHERE c.search_tsv @@ websearch_to_tsquery('english', {sql_literal(args.text)})
  UNION ALL
  SELECT 'vector', c.chunk_id, -(c.value <#> {sql_literal(vector_sql)}::vector(4096))
  FROM scoped_chunks c
  {code_sql}
), ranked AS (
  SELECT *, row_number() OVER (PARTITION BY channel ORDER BY score DESC, chunk_id ASC) AS rank
  FROM candidates
)
SELECT json_build_object('kind','candidate','channel',channel,'chunk_id',chunk_id,'score',score,'rank',rank)::text
FROM ranked WHERE rank <= {100 if benchmark else 20}
UNION ALL
SELECT json_build_object('kind','chunk','chunk_id',c.chunk_id,'path',c.path,'ordinal',c.ordinal,
  'heading_path',c.heading_path,'start_byte',c.start_byte,'end_byte',c.end_byte,'content_id',c.content_id,
  'body_sha256',c.body_sha256,'blob_id',c.blob_id,'commit',c.revision_id,'body',c.body)::text
FROM scoped_chunks c
UNION ALL
SELECT json_build_object('kind','node','node_id',node_id,'node_kind',kind,'stable_key',stable_key,'path',path,'heading_path',heading_path)::text
FROM dks.graph_nodes WHERE revision_id={revision_filter}
UNION ALL
SELECT json_build_object('kind','edge','edge_id',edge_id,'edge_type',edge_type,'source_node_id',source_node_id,'target_node_id',target_node_id)::text
FROM GRAPH_TABLE (
  dks.knowledge_graph MATCH (source)-[edge]->(target)
  COLUMNS (source.revision_id AS revision_id, source.node_id AS source_node_id,
           edge.edge_id AS edge_id, edge.edge_type AS edge_type, target.node_id AS target_node_id)
) graph_rows WHERE revision_id={revision_filter};
"""
    rows = [json.loads(line) for line in session.execute(sql)]
    channel_rows = [row for row in rows if row["kind"] == "candidate"]
    channels = {
        name: [row["chunk_id"] for row in sorted(channel_rows, key=lambda item: item["rank"])
               if row["channel"] == name]
        for name in ("lexical", "vector", "code_vector")
    }
    seeds = [item["id"] for item in rrf(channels, limit=10)]
    chunks = [row for row in rows if row["kind"] == "chunk"]
    channels["graph"] = graph_channel(
        args.project,
        seeds,
        [row for row in rows if row["kind"] == "edge"],
        [{"node_id": row["node_id"], "kind": row["node_kind"], "stable_key": row["stable_key"],
          "path": row.get("path"), "heading_path": row.get("heading_path")} for row in rows if row["kind"] == "node"],
        chunks,
    )
    channels["graphify"] = imported_graph_channel(
        config, args.project, policy.get("graph_artifact_sha256"), seeds, session)
    metadata = {row["chunk_id"]: row for row in chunks}
    channels["exact"] = exact_channel(metadata, args.text)
    reranker_provenance = fallback = None
    fused_results = rrf({name: channels[name] for name in ("lexical", "vector", "graph")},
                        args.limit)
    if policy["policy_id"] == "dks-quality-v2":
        rerank_scores = None
        try:
            candidates = [metadata[item["id"]] for item in quality_candidates(channels)
                          if item["id"] in metadata]
            reranked = rerank(config, args.text, candidates,
                              policy.get("reranker_manifest_sha256"), 600 if benchmark else 30,
                              8 if benchmark else 50)
            if reranked is not None:
                rerank_scores, reranker_provenance = reranked
        except RuntimeError as error:
            if policy.get("evidence_class") == "silver":
                raise RuntimeError("silver trial reranker unavailable") from error
            fallback = str(error)
        fused_results = quality_rank(channels, metadata, args.text, rerank_scores, args.limit)
    results = []
    for fused in fused_results:
        if fused["id"] not in metadata:
            continue
        citation = {key: value for key, value in metadata[fused["id"]].items()
                    if key not in {"kind", "heading_path", "ordinal", "body"}}
        fused["score_terms"] = {name: 1.0 / (60 + rank) for name, rank in fused["ranks"].items()}
        results.append({**citation, **fused})
    return {"project": args.project, "revision": args.commit or (results[0]["commit"] if results else None),
            "ranking_policy": policy["policy_id"], "activation": policy,
            "graphify": graphify_provenance(config, args.project,
                                             policy.get("graph_artifact_sha256"), session),
            "reranker": reranker_provenance, "reranker_fallback": fallback,
            "results": results}


def command_query(args, config, project):
    ensure_quality_policy(config, args.project)
    with PsqlSession(config) as session:
        session.execute(f"SET dks.project_id={sql_literal(args.project)};")
        for lock_name in (args.project, args.project + ":code", args.project + ":authority"):
            locked = session.execute(
                f"SELECT pg_try_advisory_lock_shared(hashtextextended({sql_literal(lock_name)}, 0));")
            if not locked or locked[-1] != "t":
                raise RuntimeError("quality query lock unavailable")
        session.execute("BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY;")
        result = command_query_transaction(args, config, project, session)
        session.execute("COMMIT;")
    return result


def command_guarded_query(args, config, project):
    ensure_quality_policy(config, args.project)
    policy = active_ranking_policy(config, args.project)
    maximum = 10 if policy["policy_id"] == "dks-quality-v2" else 20
    args.limit = args.limit if args.limit is not None else maximum
    if not 1 <= args.limit <= maximum:
        raise ValueError(f"query limit must be between 1 and {maximum}")
    lines = run_psql(config, args.project, """
SELECT json_build_object('privacy_sequence',privacy_sequence::text,
                         'privacy_digest',privacy_digest)::text
FROM dks.privacy_state WHERE project_id=current_setting('dks.project_id');
""")
    if not lines:
        raise RuntimeError("knowledge privacy state is unavailable")
    identity = json.loads(lines[-1])
    executable = str(Path(config.get("dbsctrctl", "~/.local/bin/dbsctrctl")).expanduser())
    state_root = project.get("knowledge_state_root")
    if not isinstance(state_root, str) or not Path(state_root).expanduser().is_absolute():
        raise ValueError("knowledge state root is unavailable")
    command = [
        executable, "knowledge-privacy-guard", "--state-root", state_root,
        "--expected-sequence", identity["privacy_sequence"],
        "--expected-digest", identity["privacy_digest"], "--",
        sys.executable, str(Path(__file__).resolve()), "_query-core",
        "--config", args.config, "--project", args.project, "--text", args.text,
        "--limit", str(args.limit),
    ]
    if args.commit:
        command.extend(["--commit", args.commit])
    completed = subprocess.run(command, text=True, capture_output=True, stdin=subprocess.DEVNULL)
    if completed.returncode and policy.get("evidence_class") == "silver":
        command_rollback_quality(argparse.Namespace(project=args.project), config, project)
        completed = subprocess.run(command, text=True, capture_output=True, stdin=subprocess.DEVNULL)
    if completed.returncode:
        raise RuntimeError("privacy-guarded query failed")
    try:
        return json.loads(completed.stdout)
    except json.JSONDecodeError as error:
        raise RuntimeError("privacy-guarded query returned invalid JSON") from error


def projection_payload_sql(revision: str):
    return f"""
SELECT json_build_object(
  'records', (SELECT coalesce(jsonb_agg(jsonb_build_array(path,blob_id,content_id) ORDER BY path), '[]') FROM dks.source_records WHERE revision_id={sql_literal(revision)}),
  'chunks', (SELECT coalesce(jsonb_agg(jsonb_build_array(path,chunk_id) ORDER BY path,chunk_id), '[]') FROM dks.revision_chunks WHERE revision_id={sql_literal(revision)}),
  'embeddings', (SELECT coalesce(jsonb_agg(jsonb_build_array(e.embedding_id,e.value_sha256) ORDER BY e.embedding_id), '[]') FROM dks.embeddings e JOIN dks.revision_chunks r USING(project_id,chunk_id) WHERE r.revision_id={sql_literal(revision)}),
  'nodes', (SELECT coalesce(jsonb_agg(node_id ORDER BY node_id), '[]') FROM dks.graph_nodes WHERE revision_id={sql_literal(revision)}),
  'edges', (SELECT coalesce(jsonb_agg(edge_id ORDER BY edge_id), '[]') FROM dks.graph_edges WHERE revision_id={sql_literal(revision)})
)::text;
"""


def projection_identity(config, project_id: str, revision: str, session=None):
    sql = projection_payload_sql(revision)
    lines = session.execute(sql) if session else run_psql(config, project_id, sql)
    return digest_json(json.loads(lines[-1])) if lines else None


def authority_projection_payload_sql():
    return """
SELECT json_build_object(
  'snapshots',(SELECT coalesce(jsonb_agg(jsonb_build_array(source_kind,snapshot_id,manifest_sha256)
      ORDER BY source_kind,snapshot_id), '[]'::jsonb) FROM dks.authority_snapshots
      WHERE project_id=current_setting('dks.project_id') AND state='active'),
  'records',(SELECT coalesce(jsonb_agg(jsonb_build_array(r.source_kind,r.snapshot_id,r.record_id,
      r.revision,r.retention,r.content_id,r.body) ORDER BY r.source_kind,r.snapshot_id,r.record_id), '[]'::jsonb)
      FROM dks.authority_records r JOIN dks.authority_snapshots s
      USING(project_id,source_kind,snapshot_id) WHERE r.project_id=current_setting('dks.project_id')
      AND s.state='active'),
  'chunks',(SELECT coalesce(jsonb_agg(jsonb_build_array(c.source_kind,c.snapshot_id,c.record_id,
      c.chunk_id,c.body_sha256,c.body) ORDER BY c.source_kind,c.snapshot_id,c.record_id,c.chunk_id), '[]'::jsonb)
      FROM dks.authority_chunks c JOIN dks.authority_snapshots s
      USING(project_id,source_kind,snapshot_id) WHERE c.project_id=current_setting('dks.project_id')
      AND s.state='active'),
  'embeddings',(SELECT coalesce(jsonb_agg(jsonb_build_array(e.source_kind,e.snapshot_id,e.record_id,
      e.chunk_id,e.embedding_space_id,e.value_sha256)
      ORDER BY e.source_kind,e.snapshot_id,e.record_id,e.chunk_id,e.embedding_space_id), '[]'::jsonb)
      FROM dks.authority_embeddings e JOIN dks.authority_snapshots s
      USING(project_id,source_kind,snapshot_id) WHERE e.project_id=current_setting('dks.project_id')
      AND s.state='active'),
  'privacy_sequence',(SELECT privacy_sequence::text FROM dks.privacy_state
      WHERE project_id=current_setting('dks.project_id')),
  'privacy_digest',(SELECT privacy_digest FROM dks.privacy_state
      WHERE project_id=current_setting('dks.project_id')))::text;
"""


def validate_quality_projection(config, project_id, policy, session=None):
    if policy["policy_id"] != "dks-quality-v2":
        return
    source_sha = projection_identity(config, project_id, policy["source_revision_id"], session)
    sql = authority_projection_payload_sql()
    rows = session.execute(sql) if session else run_psql(config, project_id, sql)
    if len(rows) != 1:
        raise RuntimeError("quality authority projection is unavailable")
    authority = json.loads(rows[0])
    expected_manifest = digest_json({
        "aggregate_sha256": policy["benchmark_aggregate_sha256"],
        "authority_projection_sha256": policy["authority_projection_sha256"],
        "authority_snapshot_set_sha256": policy["authority_snapshot_set_sha256"],
        "benchmark_sha256": policy["benchmark_sha256"],
        "code_embedding_space_id": policy["code_embedding_space_id"],
        "evidence_class": policy["evidence_class"],
        "graph_artifact_sha256": policy["graph_artifact_sha256"],
        "policy_id": "dks-quality-v2", "privacy_digest": policy["privacy_digest"],
        "privacy_sequence": int(policy["privacy_sequence"]),
        "reranker_manifest_sha256": policy["reranker_manifest_sha256"],
        "source_projection_sha256": policy["source_projection_sha256"],
        "source_revision_id": policy["source_revision_id"],
        "trial_expires_at": (int(policy["trial_expires_at"])
                             if policy["trial_expires_at"] is not None else None),
    })
    if (source_sha != policy["source_projection_sha256"]
            or digest_json(authority["snapshots"]) != policy["authority_snapshot_set_sha256"]
            or digest_json(authority) != policy["authority_projection_sha256"]
            or authority.get("privacy_sequence") != policy["privacy_sequence"]
            or authority.get("privacy_digest") != policy["privacy_digest"]
            or expected_manifest != policy["manifest_sha256"]
            or digest_json({"manifest_sha256": expected_manifest,
                            "revision": policy["source_revision_id"]}) != policy["activation_id"]):
        raise RuntimeError("active quality projection identity mismatch")


def projected_payload(documents, chunks, embedding_space, vector_hashes, nodes, edges):
    records = sorted([document["path"], document["blob_id"],
                      hashlib.sha256(document["data"]).hexdigest()] for document in documents)
    chunk_rows = sorted([chunk["path"], chunk["chunk_id"]] for chunk in chunks)
    embedding_rows = []
    for chunk in chunks:
        embedding_id = digest_json({"chunk_id": chunk["chunk_id"], "embedding_space_id": embedding_space})
        embedding_rows.append([embedding_id, vector_hashes[embedding_id]])
    return {
        "records": records,
        "chunks": chunk_rows,
        "embeddings": sorted(embedding_rows),
        "nodes": sorted(node["node_id"] for node in nodes),
        "edges": sorted(edge["edge_id"] for edge in edges),
    }


def ranking_fallback_statements(project_id):
    project = sql_literal(project_id)
    return [
        f"UPDATE dks.ranking_policies SET active=false WHERE project_id={project} "
        "AND active AND policy_id='dks-quality-v2';",
        f"UPDATE dks.ranking_policies SET active=true,activated_at=now() WHERE project_id={project} "
        "AND activation_id='dks-rrf-v1';",
        "DO $policy$ BEGIN IF (SELECT count(*) FROM dks.ranking_policies WHERE project_id="
        f"{project} AND active)<>1 THEN RAISE EXCEPTION 'baseline ranking policy unavailable'; "
        "END IF; END $policy$;",
    ]


def sync_statements(project_id, commit, run_id, embedding_space, manifest_sha,
                    documents, chunks, vectors, nodes, edges):
    statements = ["BEGIN;"]
    statements.append(
        "INSERT INTO dks.embedding_spaces(project_id,embedding_space_id,manifest_sha256,dimensions) "
        f"VALUES ({sql_literal(project_id)},{sql_literal(embedding_space)},{sql_literal(manifest_sha)},4096) "
        "ON CONFLICT DO NOTHING;")
    statements.append(
        "DO $space$ BEGIN IF NOT EXISTS (SELECT 1 FROM dks.embedding_spaces "
        f"WHERE project_id={sql_literal(project_id)} AND embedding_space_id={sql_literal(embedding_space)} "
        f"AND manifest_sha256={sql_literal(manifest_sha)} AND dimensions=4096) "
        "THEN RAISE EXCEPTION 'embedding space identity mismatch'; END IF; END $space$;")
    statements.append(
        "INSERT INTO dks.source_revisions(project_id,revision_id) "
        f"VALUES ({sql_literal(project_id)},{sql_literal(commit)}) ON CONFLICT DO NOTHING;")
    statements.append(
        "INSERT INTO dks.sync_runs(project_id,run_id,revision_id,state,expected_records,expected_chunks,expected_embeddings,expected_nodes,expected_edges) "
        f"VALUES ({sql_literal(project_id)},{sql_literal(run_id)},{sql_literal(commit)},'staging',"
        f"{len(documents)},{len(chunks)},{len(chunks)},{len(nodes)},{len(edges)});")
    statements.extend([
        f"DELETE FROM dks.graph_edges WHERE project_id={sql_literal(project_id)} AND revision_id={sql_literal(commit)};",
        f"DELETE FROM dks.revision_chunks WHERE project_id={sql_literal(project_id)} AND revision_id={sql_literal(commit)};",
        f"DELETE FROM dks.graph_nodes WHERE project_id={sql_literal(project_id)} AND revision_id={sql_literal(commit)};",
        f"DELETE FROM dks.source_records WHERE project_id={sql_literal(project_id)} AND revision_id={sql_literal(commit)};",
    ])
    for document in documents:
        body = validate_markdown(document["data"])
        content_id = hashlib.sha256(document["data"]).hexdigest()
        statements.append(
            "INSERT INTO dks.content_objects(project_id,content_id,body) VALUES ("
            f"{sql_literal(project_id)},{sql_literal(content_id)},{sql_literal(body)}) ON CONFLICT DO NOTHING;")
        statements.append(
            "INSERT INTO dks.source_records(project_id,revision_id,path,blob_id,content_id) VALUES ("
            f"{sql_literal(project_id)},{sql_literal(commit)},{sql_literal(document['path'])},"
            f"{sql_literal(document['blob_id'])},{sql_literal(content_id)}) ON CONFLICT DO NOTHING;")
    for chunk in chunks:
        heading_json = canonical_json(chunk["heading_path"])
        statements.append(
            "INSERT INTO dks.knowledge_chunks(project_id,chunk_id,content_id,chunker_version,ordinal,start_byte,end_byte,heading_path,heading_text,body,body_sha256,token_count) VALUES ("
            f"{sql_literal(project_id)},{sql_literal(chunk['chunk_id'])},{sql_literal(chunk['content_id'])},{sql_literal(chunk.get('chunker_version', 'dks-markdown-v1'))},"
            f"{chunk['ordinal']},{chunk['start_byte']},{chunk['end_byte']},{sql_literal(heading_json)}::jsonb,"
            f"{sql_literal(' > '.join(chunk['heading_path']))},{sql_literal(chunk['body'])},{sql_literal(chunk['body_sha256'])},{chunk['embedding_tokens']}) ON CONFLICT DO NOTHING;")
        embedding_id = digest_json({"chunk_id": chunk["chunk_id"], "embedding_space_id": embedding_space})
        stored_value = vector_value(vectors[embedding_id])
        vector_sha = hashlib.sha256(stored_value.encode()).hexdigest()
        statements.append(
            "INSERT INTO dks.embeddings(project_id,embedding_id,chunk_id,embedding_space_id,value,value_sha256) VALUES ("
            f"{sql_literal(project_id)},{sql_literal(embedding_id)},{sql_literal(chunk['chunk_id'])},"
            f"{sql_literal(embedding_space)},{sql_literal(stored_value)}::vector(4096),{sql_literal(vector_sha)}) ON CONFLICT DO NOTHING;")
        statements.append(
            "INSERT INTO dks.revision_chunks(project_id,run_id,revision_id,path,chunk_id) VALUES ("
            f"{sql_literal(project_id)},{sql_literal(run_id)},{sql_literal(commit)},"
            f"{sql_literal(chunk['path'])},{sql_literal(chunk['chunk_id'])}) ON CONFLICT DO NOTHING;")
    for node in nodes:
        heading = canonical_json(node.get("heading_path")) if node.get("heading_path") is not None else None
        statements.append(
            "INSERT INTO dks.graph_nodes(project_id,node_id,revision_id,kind,stable_key,path,heading_path) VALUES ("
            f"{sql_literal(project_id)},{sql_literal(node['node_id'])},{sql_literal(commit)},"
            f"{sql_literal(node['kind'])},{sql_literal(node['stable_key'])},{sql_literal(node.get('path'))},"
            f"{sql_literal(heading)}::jsonb) ON CONFLICT DO NOTHING;")
    for edge in edges:
        statements.append(
            "INSERT INTO dks.graph_edges(project_id,edge_id,run_id,revision_id,edge_type,source_node_id,target_node_id,source_start_byte,source_end_byte) VALUES ("
            f"{sql_literal(project_id)},{sql_literal(edge['edge_id'])},{sql_literal(run_id)},{sql_literal(commit)},"
            f"{sql_literal(edge['edge_type'])},{sql_literal(edge['source_node_id'])},{sql_literal(edge['target_node_id'])},"
            f"{edge['start_byte']},{edge['end_byte']}) ON CONFLICT DO NOTHING;")
    statements.extend([
        f"UPDATE dks.sync_runs SET state='ready' WHERE project_id={sql_literal(project_id)} AND run_id={sql_literal(run_id)};",
        "DO $validate$ DECLARE run_row dks.sync_runs%ROWTYPE; actual_records integer; actual_chunks integer; actual_embeddings integer; actual_nodes integer; actual_edges integer; BEGIN "
        f"SELECT * INTO STRICT run_row FROM dks.sync_runs WHERE project_id={sql_literal(project_id)} AND run_id={sql_literal(run_id)} AND state='ready'; "
        f"SELECT count(*) INTO actual_records FROM dks.source_records WHERE project_id={sql_literal(project_id)} AND revision_id={sql_literal(commit)}; "
        f"SELECT count(*) INTO actual_chunks FROM dks.revision_chunks WHERE project_id={sql_literal(project_id)} AND run_id={sql_literal(run_id)}; "
        f"SELECT count(*) INTO actual_embeddings FROM dks.revision_chunks rc JOIN dks.embeddings e USING(project_id,chunk_id) WHERE rc.project_id={sql_literal(project_id)} AND rc.run_id={sql_literal(run_id)} AND e.embedding_space_id={sql_literal(embedding_space)}; "
        f"SELECT count(*) INTO actual_nodes FROM dks.graph_nodes WHERE project_id={sql_literal(project_id)} AND revision_id={sql_literal(commit)}; "
        f"SELECT count(*) INTO actual_edges FROM dks.graph_edges WHERE project_id={sql_literal(project_id)} AND run_id={sql_literal(run_id)}; "
        "IF actual_records<>run_row.expected_records OR actual_chunks<>run_row.expected_chunks OR actual_embeddings<>run_row.expected_embeddings OR actual_nodes<>run_row.expected_nodes OR actual_edges<>run_row.expected_edges THEN RAISE EXCEPTION 'projection completeness mismatch'; END IF; END $validate$;",
        f"UPDATE dks.sync_runs SET state='retained', finished_at=now() WHERE project_id={sql_literal(project_id)} AND state='active';",
        f"UPDATE dks.projects SET active_revision_id={sql_literal(commit)}, active_run_id={sql_literal(run_id)}, active_embedding_space_id={sql_literal(embedding_space)}, updated_at=now() WHERE project_id={sql_literal(project_id)};",
        f"UPDATE dks.sync_runs SET state='active', finished_at=now() WHERE project_id={sql_literal(project_id)} AND run_id={sql_literal(run_id)};",
    ])
    statements.extend(ranking_fallback_statements(project_id))
    statements.append("COMMIT;")
    return statements


def authority_sync_statements(project_id, export, chunks, vectors, embedding_space, manifest_sha):
    manifest = export["manifest"]
    stream_digest = export["terminal"]["digest"]
    by_family = {family: [] for family in KNOWLEDGE_FAMILIES}
    for record in export["records"]:
        by_family[record["family"]].append(record)
    chunks_by_record = {}
    for chunk in chunks:
        chunks_by_record.setdefault((chunk["family"], chunk["record_id"]), []).append(chunk)
    statements = ["BEGIN;"]
    incoming = [(record["family"], record["record_id"]) for record in export["records"]]
    if incoming:
        values = ",".join(f"({sql_literal(family)},{sql_literal(record_id)})"
                          for family, record_id in incoming)
        statements.append(
            "DO $deny$ BEGIN IF EXISTS (SELECT 1 FROM dks.privacy_denies d "
            f"JOIN (VALUES {values}) AS incoming(source_kind,record_id) USING(source_kind,record_id) "
            f"WHERE d.project_id={sql_literal(project_id)}) THEN "
            "RAISE EXCEPTION 'authority export contains denied identity'; END IF; END $deny$;")
    for family in KNOWLEDGE_FAMILIES:
        if manifest["families"][family] == "unavailable":
            statements.append(
                "UPDATE dks.authority_snapshots SET state='retained' WHERE project_id="
                f"{sql_literal(project_id)} AND source_kind={sql_literal(family)} AND state='active';")
            continue
        snapshot = digest_json({"family": family, "stream_digest": stream_digest})
        statements.append(
            "UPDATE dks.authority_snapshots SET state='retained' WHERE project_id="
            f"{sql_literal(project_id)} AND source_kind={sql_literal(family)} AND state='active';")
        statements.append(
            "DELETE FROM dks.authority_snapshots WHERE project_id="
            f"{sql_literal(project_id)} AND source_kind={sql_literal(family)} "
            f"AND snapshot_id={sql_literal(snapshot)};")
        statements.append(
            "INSERT INTO dks.authority_snapshots(project_id,source_kind,snapshot_id,manifest_sha256,"
            "privacy_sequence,privacy_digest,state) VALUES ("
            f"{sql_literal(project_id)},{sql_literal(family)},{sql_literal(snapshot)},"
            f"{sql_literal(stream_digest)},{manifest['privacy_sequence']},{sql_literal(manifest['privacy_digest'])},"
            "'staging');")
        for record in by_family[family]:
            content_id = hashlib.sha256(record["text"].encode()).hexdigest()
            statements.append(
                "INSERT INTO dks.authority_records(project_id,source_kind,snapshot_id,record_id,revision,"
                "retention,body,content_id) VALUES ("
                f"{sql_literal(project_id)},{sql_literal(family)},{sql_literal(snapshot)},"
                f"{sql_literal(record['record_id'])},{sql_literal(record['revision'])},"
                f"{sql_literal(record['retention'])},{sql_literal(record['text'])},{sql_literal(content_id)});")
            for chunk in chunks_by_record.get((family, record["record_id"]), []):
                body = chunk["body"].decode() if isinstance(chunk["body"], bytes) else chunk["body"]
                statements.append(
                    "INSERT INTO dks.authority_chunks(project_id,source_kind,snapshot_id,record_id,chunk_id,"
                    "ordinal,start_byte,end_byte,body,body_sha256,token_count) VALUES ("
                    f"{sql_literal(project_id)},{sql_literal(family)},{sql_literal(snapshot)},"
                    f"{sql_literal(record['record_id'])},{sql_literal(chunk['chunk_id'])},{chunk['ordinal']},"
                    f"{chunk['start_byte']},{chunk['end_byte']},{sql_literal(body)},"
                    f"{sql_literal(chunk['body_sha256'])},{chunk['embedding_tokens']});")
                vector = vectors[chunk["chunk_id"]]
                validate_vector(vector)
                value = vector_value(vector)
                statements.append(
                    "INSERT INTO dks.authority_embeddings(project_id,source_kind,snapshot_id,record_id,chunk_id,"
                    "embedding_space_id,value,value_sha256) "
                    "VALUES ("
                    f"{sql_literal(project_id)},{sql_literal(family)},{sql_literal(snapshot)},"
                    f"{sql_literal(record['record_id'])},{sql_literal(chunk['chunk_id'])},"
                    f"{sql_literal(embedding_space)},"
                    f"{sql_literal(value)}::vector(4096),{sql_literal(hashlib.sha256(value.encode()).hexdigest())});")
        statements.append(
            "UPDATE dks.authority_snapshots SET state='active' WHERE project_id="
            f"{sql_literal(project_id)} AND source_kind={sql_literal(family)} "
            f"AND snapshot_id={sql_literal(snapshot)};")
    statements.extend(ranking_fallback_statements(project_id))
    statements.append("COMMIT;")
    return statements


def privacy_sync_statements(project_id, export):
    manifest = export["manifest"]
    sequence = manifest["privacy_sequence"]
    digest = manifest["privacy_digest"]
    statements = ["BEGIN;", (
        "INSERT INTO dks.privacy_state(project_id,privacy_sequence,privacy_digest) VALUES ("
        f"{sql_literal(project_id)},{sequence},{sql_literal(digest)}) ON CONFLICT DO NOTHING;"), (
        "DO $privacy$ DECLARE current_sequence numeric; current_digest text; BEGIN "
        "SELECT privacy_sequence,privacy_digest INTO STRICT current_sequence,current_digest "
        f"FROM dks.privacy_state WHERE project_id={sql_literal(project_id)} FOR UPDATE; "
        f"IF {sequence}<current_sequence OR ({sequence}=current_sequence AND {sql_literal(digest)}<>current_digest) "
        "THEN RAISE EXCEPTION 'knowledge privacy identity rollback'; END IF; END $privacy$;")]
    for item in export["privacy"]:
        statements.append(
            "INSERT INTO dks.privacy_denies(project_id,source_kind,record_id,reason,denied_at) VALUES ("
            f"{sql_literal(project_id)},{sql_literal(item['family'])},{sql_literal(item['record_id'])},"
            f"{sql_literal(item['reason'])},{item['timestamp']}) ON CONFLICT(project_id,source_kind,record_id) "
            "DO UPDATE SET reason=excluded.reason,denied_at=greatest(dks.privacy_denies.denied_at,excluded.denied_at);")
        statements.append(
            "DELETE FROM dks.authority_records WHERE project_id="
            f"{sql_literal(project_id)} AND source_kind={sql_literal(item['family'])} "
            f"AND record_id={sql_literal(item['record_id'])};")
    statements.extend([
        "UPDATE dks.privacy_state SET "
        f"privacy_sequence={sequence},privacy_digest={sql_literal(digest)},updated_at=now() "
        f"WHERE project_id={sql_literal(project_id)};",
    ])
    statements.extend(ranking_fallback_statements(project_id))
    statements.append("COMMIT;")
    return statements


def graph_import_statements(project_id, commit, graph, source_profile_sha256,
                            corpus_manifest_sha256, execution_receipt_sha256,
                            execution_receipt=None):
    artifact = graph["artifact_sha256"]
    config_sha = digest_json(GRAPHIFY_CONFIG)
    statements = ["BEGIN;",
        f"UPDATE dks.graph_imports SET state='retained' WHERE project_id={sql_literal(project_id)} AND state='active';",
        f"DELETE FROM dks.imported_graph_edges WHERE project_id={sql_literal(project_id)} "
        f"AND artifact_sha256={sql_literal(artifact)};",
        f"DELETE FROM dks.imported_graph_node_chunks WHERE project_id={sql_literal(project_id)} "
        f"AND artifact_sha256={sql_literal(artifact)};",
        f"DELETE FROM dks.imported_graph_nodes WHERE project_id={sql_literal(project_id)} "
        f"AND artifact_sha256={sql_literal(artifact)};",
        f"DELETE FROM dks.graph_imports WHERE project_id={sql_literal(project_id)} "
        f"AND artifact_sha256={sql_literal(artifact)};",
        "INSERT INTO dks.graph_imports(project_id,revision_id,artifact_sha256,normalized_sha256,extractor_version,"
        "extractor_revision,config_sha256,source_profile_sha256,corpus_manifest_sha256,execution_receipt_sha256,execution_receipt,"
        "runtime_sha256,producer_sha256,"
        "expected_nodes,expected_edges,"
        "excluded_external_nodes,excluded_dangling_edges,state) VALUES ("
        f"{sql_literal(project_id)},{sql_literal(commit)},{sql_literal(artifact)},"
        f"{sql_literal(graph['normalized_sha256'])},{sql_literal(graph['version'])},"
        f"{sql_literal(GRAPHIFY_EXTRACTOR_REVISION)},{sql_literal(config_sha)},"
        f"{sql_literal(source_profile_sha256)},{sql_literal(corpus_manifest_sha256)},"
        f"{sql_literal(execution_receipt_sha256)},"
        f"{sql_literal(canonical_json(execution_receipt)) + '::jsonb' if execution_receipt is not None else 'NULL'},"
        f"{sql_literal(GRAPHIFY_RUNTIME_SHA256)},{sql_literal(GRAPHIFY_PRODUCER_SHA256)},"
        f"{len(graph['nodes'])},{len(graph['links'])},"
        f"{graph['excluded_external_nodes']},{graph['excluded_dangling_edges']},'staging');"]
    node_ids = {}
    for node in graph["nodes"]:
        identity = digest_json({"artifact": artifact, "raw_id": node["id"]})
        node_ids[node["id"]] = identity
        location = node["source_location"]
        confidence = node.get("confidence", "EXTRACTED")
        statements.append(
            "INSERT INTO dks.imported_graph_nodes(project_id,artifact_sha256,node_id,raw_id,label,confidence,"
            "source_path,source_start_byte,source_end_byte) VALUES ("
            f"{sql_literal(project_id)},{sql_literal(artifact)},{sql_literal(identity)},"
            f"{sql_literal(node['id'])},{sql_literal(node.get('label', node['id']))},{sql_literal(confidence)},"
            f"{sql_literal(location['path'])},{location['start_byte']},{location['end_byte']});")
        statements.append(
            "INSERT INTO dks.imported_graph_node_chunks(project_id,artifact_sha256,node_id,chunk_id,"
            "overlap_start_byte,overlap_end_byte) SELECT "
            f"{sql_literal(project_id)},{sql_literal(artifact)},{sql_literal(identity)},c.chunk_id,"
            f"greatest(c.start_byte,{location['start_byte']}),least(c.end_byte,{location['end_byte']}) "
            "FROM dks.revision_chunks rc JOIN dks.knowledge_chunks c USING(project_id,chunk_id) WHERE "
            f"rc.project_id={sql_literal(project_id)} AND rc.revision_id={sql_literal(commit)} "
            f"AND rc.path={sql_literal(location['path'])} AND c.start_byte<{location['end_byte']} "
            f"AND c.end_byte>{location['start_byte']};")
    for ordinal, link in enumerate(graph["links"]):
        location = link["source_location"]
        identity = digest_json({"artifact": artifact, "source": link["source"],
                                "target": link["target"], "relation": link["relation"],
                                "source_path": location["path"],
                                "source_start_byte": location["start_byte"],
                                "source_end_byte": location["end_byte"], "ordinal": ordinal})
        statements.append(
            "INSERT INTO dks.imported_graph_edges(project_id,artifact_sha256,edge_id,source_node_id,"
            "target_node_id,relation,confidence,source_path,source_start_byte,source_end_byte) VALUES ("
            f"{sql_literal(project_id)},{sql_literal(artifact)},{sql_literal(identity)},"
            f"{sql_literal(node_ids[link['source']])},{sql_literal(node_ids[link['target']])},"
            f"{sql_literal(link['relation'])},{sql_literal(link.get('confidence', 'EXTRACTED'))},"
            f"{sql_literal(location['path'])},{location['start_byte']},{location['end_byte']});")
    statements.extend([
        "DO $graph$ DECLARE expected integer; mapped integer; edge_count integer; BEGIN "
        f"expected:={len(graph['nodes'])}; SELECT count(DISTINCT node_id) INTO mapped "
        "FROM dks.imported_graph_node_chunks "
        f"WHERE project_id={sql_literal(project_id)} AND artifact_sha256={sql_literal(artifact)}; "
        "SELECT count(*) INTO edge_count FROM dks.imported_graph_edges "
        f"WHERE project_id={sql_literal(project_id)} AND artifact_sha256={sql_literal(artifact)}; "
        f"IF mapped<>expected OR edge_count<>{len(graph['links'])} THEN "
        "RAISE EXCEPTION 'Graphify projection completeness mismatch'; END IF; END $graph$;",
        f"UPDATE dks.graph_imports SET state='active' WHERE project_id={sql_literal(project_id)} "
        f"AND artifact_sha256={sql_literal(artifact)};"])
    statements.extend(ranking_fallback_statements(project_id))
    statements.append("COMMIT;")
    return statements


def validate_graphify_receipt(value, project_id, artifact_sha256, corpus_manifest_sha256):
    config_sha = digest_json(GRAPHIFY_CONFIG)
    fields = {"schema_version", "command_contract", "package", "extractor_version",
              "extractor_revision", "python_version", "runtime_sha256", "producer_sha256",
              "config_sha256", "raw_extraction_sha256",
              "corpus_manifest_sha256", "artifact_sha256", "network_disabled",
              "cache_schema_version", "cache_key_sha256", "cache_hit",
              "excluded_missing_locations", "excluded_missing_location_ids_sha256"}
    cache_key = digest_json({"project": project_id, "config_sha256": config_sha,
                             "runtime_sha256": GRAPHIFY_RUNTIME_SHA256,
                             "corpus_manifest_sha256": corpus_manifest_sha256})
    if (not isinstance(value, dict) or set(value) != fields or value.get("schema_version") != 2
            or value.get("command_contract") != "dks-graphify-code-v2"
            or value.get("package") != "graphifyy[sql]"
            or value.get("extractor_version") != "0.9.50"
            or value.get("extractor_revision") != GRAPHIFY_EXTRACTOR_REVISION
            or value.get("python_version") != "3.13.2"
            or value.get("runtime_sha256") != GRAPHIFY_RUNTIME_SHA256
            or value.get("producer_sha256") != GRAPHIFY_PRODUCER_SHA256
            or value.get("config_sha256") != config_sha
            or not SHA256_RE.fullmatch(value.get("raw_extraction_sha256", ""))
            or value.get("corpus_manifest_sha256") != corpus_manifest_sha256
            or value.get("artifact_sha256") != artifact_sha256
            or value.get("network_disabled") is not True
            or value.get("cache_schema_version") != 1
            or value.get("cache_key_sha256") != cache_key
            or type(value.get("cache_hit")) is not bool
            or type(value.get("excluded_missing_locations")) is not int
            or value["excluded_missing_locations"] < 0
            or not SHA256_RE.fullmatch(value.get("excluded_missing_location_ids_sha256", ""))):
        raise ValueError("Graphify execution receipt identity mismatch")


def load_graphify_receipt(path_value, project_id, artifact_sha256, corpus_manifest_sha256):
    path = Path(path_value).expanduser()
    try:
        details = path.lstat()
        raw = path.read_bytes()
        value = json.loads(raw, object_pairs_hook=lambda pairs: dict(pairs)
                           if len(dict(pairs)) == len(pairs) else (_ for _ in ()).throw(
                               ValueError("duplicate Graphify receipt key")))
    except (OSError, json.JSONDecodeError) as error:
        raise ValueError("Graphify execution receipt unavailable") from error
    if (not stat.S_ISREG(details.st_mode) or details.st_uid != os.getuid()
            or stat.S_IMODE(details.st_mode) & 0o077):
        raise ValueError("Graphify execution receipt identity mismatch")
    validate_graphify_receipt(value, project_id, artifact_sha256, corpus_manifest_sha256)
    return hashlib.sha256(raw).hexdigest(), value


def command_sync(args, config, project):
    embedding_space = config.get("embedding", {}).get("space_id")
    manifest_sha = config.get("embedding", {}).get("manifest_sha256")
    if not embedding_space or not SHA256_RE.fullmatch(str(manifest_sha or "")):
        raise ValueError("embedding space configuration invalid")
    repository = Path(project.get("repository", "")).expanduser()
    with PsqlSession(config) as session:
        session.execute(f"SET dks.project_id={sql_literal(args.project)};")
        locked = session.execute(
            f"SELECT pg_try_advisory_lock(hashtextextended({sql_literal(args.project)}, 0));")
        if not locked or locked[-1] != "t":
            raise RuntimeError("project sync already running")
        validate_embedding_config(config)
        rebuild_payload = None
        if getattr(args, "rebuild", False):
            rows = session.execute(projection_payload_sql(args.commit))
            if not rows:
                raise ValueError("revision is not available for rebuild comparison")
            rebuild_payload = json.loads(rows[-1])
            rebuild_payload = {key: sorted(values) for key, values in rebuild_payload.items()}
        session.execute("""
DELETE FROM dks.graph_edges WHERE run_id IN (SELECT run_id FROM dks.sync_runs WHERE state IN ('staging','ready'));
DELETE FROM dks.revision_chunks WHERE run_id IN (SELECT run_id FROM dks.sync_runs WHERE state IN ('staging','ready'));
UPDATE dks.sync_runs SET state='abandoned', finished_at=now() WHERE state IN ('staging','ready');
""")
        documents = git_documents(repository, args.commit, project.get("remote", ""),
                                  load_source_profile(project))
        count = token_counter(config)
        chunks = []
        for document in documents:
            derived = (chunk_markdown(document["data"], count)
                       if document["chunker"] == "dks-markdown-v1"
                       else chunk_source(document["data"], document["path"], count))
            for chunk in derived:
                chunk.update(path=document["path"], blob_id=document["blob_id"])
                chunks.append(chunk)
        nodes, edges = build_graph(args.project, args.commit, documents, chunks)
        embedding_ids = {
            chunk["chunk_id"]: digest_json({"chunk_id": chunk["chunk_id"],
                                             "embedding_space_id": embedding_space})
            for chunk in chunks
        }
        embedding_chunks = {identity: chunk_id for chunk_id, identity in embedding_ids.items()}
        existing = {}
        vector_hashes = {}
        if embedding_ids:
            values = ",".join(sql_literal(value) for value in embedding_ids.values())
            for line in session.execute(
                    f"SELECT json_build_object('id',embedding_id,'chunk',chunk_id,'space',embedding_space_id,'value',value::text,'sha',value_sha256)::text FROM dks.embeddings WHERE embedding_id IN ({values});"):
                row = json.loads(line)
                expected_chunk = embedding_chunks.get(row["id"])
                if row["chunk"] != expected_chunk or row["space"] != embedding_space:
                    raise RuntimeError("stored embedding association mismatch")
                vector = [float(value) for value in row["value"].strip("[]").split(",")]
                validate_stored_vector(vector, row["value"], row["sha"])
                existing[row["id"]] = vector
                vector_hashes[row["id"]] = row["sha"]
        vectors = {}
        missing = [chunk for chunk in chunks if embedding_ids[chunk["chunk_id"]] not in existing]
        for offset in range(0, len(missing), 8):
            batch = missing[offset:offset + 8]
            for chunk, vector in zip(batch, embed(config, [item["embedding_text"] for item in batch])):
                identity = embedding_ids[chunk["chunk_id"]]
                vectors[identity] = vector
                value = vector_value(vector)
                vector_hashes[identity] = hashlib.sha256(value.encode()).hexdigest()
        vectors.update(existing)
        if rebuild_payload is not None:
            projected = projected_payload(documents, chunks, embedding_space, vector_hashes, nodes, edges)
            mismatches = sorted(key for key in projected
                                if digest_json(projected[key]) != digest_json(rebuild_payload[key]))
            if mismatches:
                raise RuntimeError("rebuild identity mismatch: " + ",".join(mismatches))
        run_id = secrets.token_hex(16)
        statements = sync_statements(args.project, args.commit, run_id, embedding_space,
                                     manifest_sha, documents, chunks, vectors, nodes, edges)
        session.execute("\n".join(statements))
        session.execute(f"SELECT pg_advisory_unlock(hashtextextended({sql_literal(args.project)}, 0));")
    return {"project": args.project, "revision": args.commit, "run_id": run_id,
            "records": len(documents), "chunks": len(chunks), "nodes": len(nodes),
            "edges": len(edges), "state": "active"}


def command_rebuild(args, config, project):
    args.rebuild = True
    result = command_sync(args, config, project)
    result["projection_identity"] = projection_identity(config, args.project, args.commit)
    result["rebuild_verified"] = True
    return result


def command_sync_code(args, config, project):
    validate_code_embedding_config(config)
    service = config["code_embedding"]
    space = service.get("space_id")
    manifest_sha = service.get("manifest_sha256")
    if not isinstance(space, str) or not SHA256_RE.fullmatch(str(manifest_sha or "")):
        raise ValueError("code embedding space configuration invalid")
    with PsqlSession(config) as session:
        session.execute(f"SET dks.project_id={sql_literal(args.project)};")
        locked = session.execute(
            f"SELECT pg_try_advisory_lock(hashtextextended({sql_literal(args.project + ':code')}, 0));")
        if not locked or locked[-1] != "t":
            raise RuntimeError("code embedding sync already running")
        rows = [json.loads(line) for line in session.execute(
            "SELECT json_build_object('chunk_id',c.chunk_id,'body',c.body)::text "
            "FROM dks.revision_chunks rc JOIN dks.knowledge_chunks c USING(project_id,chunk_id) "
            f"WHERE rc.project_id={sql_literal(args.project)} AND rc.revision_id={sql_literal(args.commit)} "
            "AND c.chunker_version='dks-source-v1' GROUP BY c.chunk_id,c.body ORDER BY c.chunk_id;")]
        session.execute("\n".join(["BEGIN;",
            "INSERT INTO dks.code_embedding_spaces(project_id,embedding_space_id,manifest_sha256,dimensions) "
            f"VALUES ({sql_literal(args.project)},{sql_literal(space)},{sql_literal(manifest_sha)},3584) "
            "ON CONFLICT DO NOTHING;",
            "DO $space$ BEGIN IF NOT EXISTS (SELECT 1 FROM dks.code_embedding_spaces WHERE "
            f"project_id={sql_literal(args.project)} AND embedding_space_id={sql_literal(space)} "
            f"AND manifest_sha256={sql_literal(manifest_sha)} AND dimensions=3584) THEN "
            "RAISE EXCEPTION 'code embedding space identity mismatch'; END IF; END $space$;",
            "COMMIT;",
        ]))
        for offset in range(0, len(rows), 8):
            batch = rows[offset:offset + 8]
            values = ",".join(sql_literal(row["chunk_id"]) for row in batch)
            existing = {}
            for line in session.execute(
                    "SELECT json_build_object('chunk',chunk_id,'value',value::text,'sha',value_sha256)::text "
                    "FROM dks.code_embeddings WHERE "
                    f"project_id={sql_literal(args.project)} AND embedding_space_id={sql_literal(space)} "
                    f"AND chunk_id IN ({values});"):
                stored = json.loads(line)
                vector = [float(value) for value in stored["value"].strip("[]").split(",")]
                validate_stored_vector(vector, stored["value"], stored["sha"], 3584)
                if stored["chunk"] in existing:
                    raise RuntimeError("stored code embedding identity mismatch")
                existing[stored["chunk"]] = vector
            missing = [row for row in batch if row["chunk_id"] not in existing]
            statements = ["BEGIN;"]
            for row, vector in zip(missing, code_embed(config, [item["body"] for item in missing])):
                value = vector_value(vector)
                value_sha = hashlib.sha256(value.encode()).hexdigest()
                statements.append(
                    "DO $vector$ BEGIN IF EXISTS (SELECT 1 FROM dks.code_embeddings WHERE "
                    f"project_id={sql_literal(args.project)} AND chunk_id={sql_literal(row['chunk_id'])} "
                    f"AND embedding_space_id={sql_literal(space)} AND (value_sha256<>"
                    f"{sql_literal(value_sha)} OR value<>{sql_literal(value)}::vector(3584))) THEN "
                    "RAISE EXCEPTION 'stored code embedding identity mismatch'; END IF; END $vector$;")
                statements.append(
                    "INSERT INTO dks.code_embeddings(project_id,chunk_id,embedding_space_id,value,value_sha256) "
                    f"VALUES ({sql_literal(args.project)},{sql_literal(row['chunk_id'])},{sql_literal(space)},"
                    f"{sql_literal(value)}::vector(3584),"
                    f"{sql_literal(value_sha)}) ON CONFLICT DO NOTHING;")
            statements.append("COMMIT;")
            session.execute("\n".join(statements))
        session.execute("\n".join([
            "DO $complete$ DECLARE actual integer; BEGIN SELECT count(*) INTO actual FROM dks.code_embeddings "
            f"WHERE project_id={sql_literal(args.project)} AND embedding_space_id={sql_literal(space)} "
            f"AND chunk_id IN (SELECT chunk_id FROM dks.revision_chunks WHERE project_id={sql_literal(args.project)} "
            f"AND revision_id={sql_literal(args.commit)}); IF actual<>{len(rows)} THEN "
            "RAISE EXCEPTION 'code embedding completeness mismatch'; END IF; END $complete$;",
        ]))
        session.execute(
            f"SELECT pg_advisory_unlock(hashtextextended({sql_literal(args.project + ':code')}, 0));")
    return {"project": args.project, "commit": args.commit, "embedding_space": space,
            "embeddings": len(rows), "state": "candidate"}


def lifecycle_output(config, project, command):
    executable = str(Path(config.get("dbsctrctl", "~/.local/bin/dbsctrctl")).expanduser())
    state_root = project.get("knowledge_state_root")
    repository = Path(project.get("repository", "")).expanduser()
    if (not isinstance(state_root, str) or not Path(state_root).expanduser().is_absolute()
            or not repository.is_absolute() or not repository.is_dir()):
        raise ValueError("knowledge lifecycle repository unavailable")
    try:
        completed = subprocess.run(
            [executable, command, "--state-root", str(Path(state_root).expanduser())],
            text=True, capture_output=True, stdin=subprocess.DEVNULL, cwd=repository,
        )
    except OSError as error:
        raise RuntimeError(f"lifecycle {command} unavailable") from error
    if completed.returncode:
        raise RuntimeError(f"lifecycle {command} failed")
    return completed.stdout


def privacy_read_lock(project):
    state_root = project.get("knowledge_state_root")
    if not isinstance(state_root, str) or not Path(state_root).expanduser().is_absolute():
        raise ValueError("knowledge state root is unavailable")
    directory = Path(state_root).expanduser() / "reviews"
    path = directory / ".lock"
    if directory.is_symlink():
        raise RuntimeError("knowledge privacy lock is unsafe")
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    flags = os.O_RDWR | os.O_CREAT | os.O_APPEND | getattr(os, "O_NOFOLLOW", 0)
    descriptor = os.open(path, flags, 0o600)
    details = os.fstat(descriptor)
    if stat.S_IFMT(details.st_mode) != stat.S_IFREG or details.st_uid != os.getuid():
        os.close(descriptor)
        raise RuntimeError("knowledge privacy lock is unsafe")
    os.fchmod(descriptor, 0o600)
    handle = os.fdopen(descriptor, "a+", encoding="utf-8")
    fcntl.flock(handle, fcntl.LOCK_SH)
    return handle


def authority_activation_safe(export, current_export, status, current_status):
    return current_export["manifest"] == export["manifest"] and current_status == status


def command_sync_evidence(args, config, project):
    validate_embedding_config(config)
    raw = lifecycle_output(config, project, "knowledge-export")
    export = parse_knowledge_export(raw)
    status = json.loads(lifecycle_output(config, project, "knowledge-privacy-status"))
    if (status.get("privacy_sequence") != export["manifest"]["privacy_sequence"]
            or status.get("privacy_digest") != export["manifest"]["privacy_digest"]):
        raise RuntimeError("knowledge privacy changed during export")
    chunks = authority_chunks(export["records"], token_counter(config))
    vectors = {}
    for offset in range(0, len(chunks), 8):
        batch = chunks[offset:offset + 8]
        values = ",".join(sql_literal(item["chunk_id"]) for item in batch)
        existing = {}
        if values:
            for line in run_psql(config, args.project,
                    "SELECT DISTINCT ON (chunk_id) json_build_object('chunk',chunk_id,'value',value::text,'sha',value_sha256)::text "
                    "FROM dks.authority_embeddings WHERE project_id=current_setting('dks.project_id') "
                    f"AND embedding_space_id={sql_literal(config.get('embedding', {}).get('space_id'))} "
                    f"AND chunk_id IN ({values}) ORDER BY chunk_id,snapshot_id DESC;"):
                stored = json.loads(line)
                vector = [float(value) for value in stored["value"].strip("[]").split(",")]
                validate_stored_vector(vector, stored["value"], stored["sha"])
                existing[stored["chunk"]] = vector
        vectors.update(existing)
        missing = [item for item in batch if item["chunk_id"] not in existing]
        for chunk, vector in zip(missing, embed(config, [item["embedding_text"] for item in missing])):
            vectors[chunk["chunk_id"]] = vector
    embedding = config.get("embedding", {})
    with privacy_read_lock(project):
        current_export = parse_knowledge_export(lifecycle_output(config, project, "knowledge-export"))
        current_status = json.loads(lifecycle_output(config, project, "knowledge-privacy-status"))
        if not authority_activation_safe(export, current_export, status, current_status):
            raise RuntimeError("knowledge authority changed before activation")
        with PsqlSession(config) as session:
            session.execute(f"SET dks.project_id={sql_literal(args.project)};")
            locked = session.execute(
                f"SELECT pg_try_advisory_lock(hashtextextended({sql_literal(args.project + ':authority')}, 0));")
            if not locked or locked[-1] != "t":
                raise RuntimeError("authority sync already running")
            session.execute("\n".join(privacy_sync_statements(args.project, export)))
            session.execute("\n".join(authority_sync_statements(
                args.project, export, chunks, vectors, embedding.get("space_id"),
                embedding.get("manifest_sha256"))))
            session.execute(
                f"SELECT pg_advisory_unlock(hashtextextended({sql_literal(args.project + ':authority')}, 0));")
    return {"project": args.project, "snapshot": export["terminal"]["digest"],
            "records": len(export["records"]), "chunks": len(chunks),
            "privacy_sequence": status["privacy_sequence"], "state": "active"}


def command_import_graph(args, config, project):
    repository = Path(project.get("repository", "")).expanduser()
    documents = git_documents(repository, args.commit, project.get("remote", ""),
                              load_source_profile(project))
    corpus_path = Path(args.corpus_manifest).expanduser().resolve(strict=True)
    try:
        corpus_raw = corpus_path.read_bytes()
        corpus = json.loads(corpus_raw)
    except (OSError, json.JSONDecodeError) as error:
        raise ValueError("Graphify corpus manifest unavailable") from error
    expected_documents = [{"path": item["path"], "blob_id": item["blob_id"],
                           "content_sha256": hashlib.sha256(item["data"]).hexdigest()}
                          for item in documents]
    expected_corpus = {"schema_version": 1, "project": args.project, "commit": args.commit,
                       "source_profile_sha256": project.get("source_profile_sha256"),
                       "documents": expected_documents}
    if corpus != expected_corpus:
        raise ValueError("Graphify corpus manifest identity mismatch")
    corpus_sha = hashlib.sha256(corpus_raw).hexdigest()
    producer = Path(config.get("graphify_producer", "~/.local/bin/dbsctr-graphify")).expanduser()
    try:
        details = producer.lstat()
        producer_raw = producer.read_bytes()
        producer_sha = hashlib.sha256(producer_raw).hexdigest()
    except OSError as error:
        raise ValueError("Graphify producer unavailable") from error
    if (not stat.S_ISREG(details.st_mode) or details.st_uid != os.getuid()
            or stat.S_IMODE(details.st_mode) & 0o022
            or producer_sha != GRAPHIFY_PRODUCER_SHA256):
        raise ValueError("Graphify producer identity mismatch")
    with tempfile.TemporaryDirectory(prefix="dks-import-graph-") as temporary:
        producer_copy = Path(temporary) / "producer.py"
        producer_copy.write_bytes(producer_raw)
        producer_copy.chmod(0o500)
        path = Path(temporary) / "graph.json"
        receipt = Path(temporary) / "receipt.json"
        subprocess.run([sys.executable, str(producer_copy), "--corpus", str(corpus_path.parent),
                        "--output", str(path), "--receipt", str(receipt)],
                       check=True, stdin=subprocess.DEVNULL, capture_output=True, text=True)
        raw = path.read_bytes()
        if len(raw) > 128 * 1024 * 1024:
            raise ValueError("Graphify artifact exceeds byte bound")
        graph = json.loads(raw, object_pairs_hook=lambda pairs: dict(pairs)
                           if len(dict(pairs)) == len(pairs) else (_ for _ in ()).throw(
                               ValueError("duplicate Graphify key")))
        receipt_sha, receipt_value = load_graphify_receipt(
            receipt, args.project, hashlib.sha256(raw).hexdigest(), corpus_sha)
    validated = validate_graphify_graph(
        graph, {item["path"]: item for item in documents}, args.commit, args.version,
        hashlib.sha256(raw).hexdigest(), corpus_sha)
    with PsqlSession(config) as session:
        session.execute(f"SET dks.project_id={sql_literal(args.project)};")
        locked = session.execute(
            f"SELECT pg_try_advisory_lock(hashtextextended({sql_literal(args.project)}, 0));")
        if not locked or locked[-1] != "t":
            raise RuntimeError("project sync already running")
        session.execute("\n".join(graph_import_statements(
            args.project, args.commit, validated, project.get("source_profile_sha256"), corpus_sha,
            receipt_sha, receipt_value)))
        session.execute(f"SELECT pg_advisory_unlock(hashtextextended({sql_literal(args.project)}, 0));")
    return {"project": args.project, "commit": args.commit,
            "artifact_sha256": validated["artifact_sha256"],
            "nodes": len(validated["nodes"]), "edges": len(validated["links"]),
            "state": "active"}


def load_silver_suite(path_value, project):
    path = Path(path_value).expanduser()
    try:
        details = path.lstat()
        raw = path.read_bytes()
        value = json.loads(raw, object_pairs_hook=lambda pairs: dict(pairs)
                           if len(dict(pairs)) == len(pairs) else (_ for _ in ()).throw(
                               ValueError("duplicate silver suite key")))
    except (OSError, json.JSONDecodeError) as error:
        raise ValueError("silver suite unavailable") from error
    fields = {"schema_version", "benchmark_id", "protocol_version", "evidence_class",
              "source_revision", "generated_at", "generator", "reviewers", "strata",
              "candidate_systems", "depths", "trial_duration_seconds", "questions"}
    expected_strata = {name: 20 for name in BENCHMARK_QUERY_STRATA}
    model_fields = {"provider", "model", "prompt_sha256", "evidence_sha256"}
    model_evidence = [value.get("generator"), *(value.get("reviewers") or [])]
    if (not stat.S_ISREG(details.st_mode) or details.st_uid != os.getuid()
            or stat.S_IMODE(details.st_mode) & 0o022 or not isinstance(value, dict)
            or set(value) != fields or value.get("schema_version") != 1
            or value.get("benchmark_id") != "DKS-005"
            or value.get("protocol_version") != "dks-silver-v1"
            or value.get("evidence_class") != "silver"
            or value.get("source_revision") != DKS_005_SOURCE_REVISION
            or type(value.get("generated_at")) is not int or value["generated_at"] < 0
            or not isinstance(value.get("reviewers"), list) or len(value["reviewers"]) != 2
            or any(not isinstance(item, dict) or set(item) != model_fields
                   or any(not isinstance(item[name], str) or not item[name]
                          for name in ("provider", "model"))
                   or any(not SHA256_RE.fullmatch(item.get(name, ""))
                          for name in ("prompt_sha256", "evidence_sha256"))
                   for item in model_evidence)
            or len({item["evidence_sha256"] for item in model_evidence}) != 3
            or value.get("strata") != expected_strata
            or value.get("candidate_systems") != ["baseline", "code", "reranker", "code_reranker"]
            or value.get("depths") != [20, 50, 100]
            or value.get("trial_duration_seconds") != SILVER_TRIAL_SECONDS
            or not isinstance(value.get("questions"), list) or len(value["questions"]) != 100
            or value["generator"]["evidence_sha256"] != digest_json(value["questions"])):
        raise ValueError("silver suite is invalid")
    documents = git_documents(Path(project.get("repository", "")).expanduser(),
                              value["source_revision"], project.get("remote", ""),
                              load_source_profile(project) if project.get("source_profile_file") else None)
    corpus = {item["path"]: item["data"].decode("utf-8") for item in documents}
    seen_text = set()
    invalid_citations = []
    for offset, question in enumerate(value["questions"]):
        stratum = BENCHMARK_QUERY_STRATA[offset // 20]
        query_id = f"{stratum}-{offset % 20 + 1:03d}"
        if (not isinstance(question, dict)
                or set(question) != {"query_id", "stratum", "text", "citations"}
                or question.get("query_id") != query_id or question.get("stratum") != stratum
                or not isinstance(question.get("text"), str)
                or not question["text"] or question["text"] != question["text"].strip()
                or any(character in question["text"] for character in "\r\n\x00")
                or question["text"] in seen_text
                or not isinstance(question.get("citations"), list)
                or not 1 <= len(question["citations"]) <= 3):
            raise ValueError("silver suite question is invalid")
        seen_text.add(question["text"])
        for citation in question["citations"]:
            citation_path = citation.get("path") if isinstance(citation, dict) else None
            quote = citation.get("quote") if isinstance(citation, dict) else None
            if (not isinstance(citation, dict) or set(citation) != {"path", "quote", "grade"}
                    or not isinstance(citation_path, str) or not citation_path
                    or citation_path.startswith("/") or posixpath.normpath(citation_path) != citation_path
                    or citation_path.startswith("../") or citation.get("grade") != 3
                    or not isinstance(quote, str) or len(quote) < 16
                    or quote not in corpus.get(citation_path, "")):
                invalid_citations.append(query_id)
    if invalid_citations:
        raise ValueError("silver suite citation is invalid for "
                         + ",".join(sorted(set(invalid_citations))))
    return value, hashlib.sha256(raw).hexdigest()


def resolve_silver_citations(config, project_id, suite, session=None):
    rows = []
    for question in suite["questions"]:
        for citation in question["citations"]:
            rows.append(f"({sql_literal(question['query_id'])},{sql_literal(citation['path'])},"
                        f"{sql_literal(citation['quote'])},{citation['grade']})")
    sql = f"""
WITH declared(query_id,path,quote,grade) AS (VALUES {','.join(rows)})
SELECT json_build_object('query_id',d.query_id,'chunk_id',c.chunk_id,
                         'body_sha256',c.body_sha256,'grade',d.grade)::text
FROM declared d
JOIN dks.revision_chunks r ON r.project_id=current_setting('dks.project_id')
  AND r.revision_id={sql_literal(suite['source_revision'])} AND r.path=d.path
JOIN dks.knowledge_chunks c USING(project_id,chunk_id)
WHERE position(d.quote in c.body)>0
ORDER BY d.query_id,c.chunk_id;
"""
    values = session.execute(sql) if session else run_psql(config, project_id, sql)
    resolved = {question["query_id"]: {"judgments": {}, "expected_citations": []}
                for question in suite["questions"]}
    for line in values:
        item = json.loads(line)
        target = resolved.get(item.get("query_id"))
        if (target is None or not SHA256_RE.fullmatch(item.get("chunk_id", ""))
                or not SHA256_RE.fullmatch(item.get("body_sha256", ""))
                or item.get("grade") != 3):
            raise ValueError("silver citation resolution is invalid")
        target["judgments"][item["chunk_id"]] = item["grade"]
        if item["body_sha256"] not in target["expected_citations"]:
            target["expected_citations"].append(item["body_sha256"])
    if any(not item["judgments"] or not item["expected_citations"] for item in resolved.values()):
        raise ValueError("silver citation did not resolve to the frozen projection")
    for item in resolved.values():
        item["expected_citations"].sort()
    return resolved


def frozen_chunk_citations(config, project_id, revision):
    lines = run_psql(config, project_id, f"""
SELECT json_build_object('chunk_id',c.chunk_id,'body_sha256',c.body_sha256)::text
FROM dks.revision_chunks r JOIN dks.knowledge_chunks c USING(project_id,chunk_id)
WHERE r.project_id=current_setting('dks.project_id') AND r.revision_id={sql_literal(revision)}
ORDER BY c.chunk_id;
""")
    values = {}
    for line in lines:
        item = json.loads(line)
        if (not SHA256_RE.fullmatch(item.get("chunk_id", ""))
                or not SHA256_RE.fullmatch(item.get("body_sha256", ""))
                or (item["chunk_id"] in values
                    and values[item["chunk_id"]] != item["body_sha256"])):
            raise ValueError("frozen projection chunk identity is invalid")
        values[item["chunk_id"]] = item["body_sha256"]
    if not values:
        raise ValueError("frozen projection chunks are unavailable")
    return values


def load_silver_evidence(path_value, suite, suite_sha, config, project_id):
    path = Path(path_value).expanduser()
    try:
        details = path.lstat()
        raw = path.read_bytes()
        value = json.loads(raw, object_pairs_hook=lambda pairs: dict(pairs)
                           if len(dict(pairs)) == len(pairs) else (_ for _ in ()).throw(
                               ValueError("duplicate silver evidence key")))
    except (OSError, json.JSONDecodeError) as error:
        raise ValueError("silver evidence unavailable") from error
    identities_fields = {"source_revision", "source_profile_sha256", "source_projection_sha256",
                         "authority_snapshot_set_sha256", "authority_projection_sha256",
                         "privacy_sequence", "privacy_digest", "graph_artifact_sha256",
                         "general_embedding_manifest_sha256", "code_embedding_manifest_sha256",
                         "reranker_manifest_sha256"}
    systems = {"baseline", "code", "reranker", "code_reranker"}
    resources = value.get("resources", {}) if isinstance(value, dict) else {}
    identities = value.get("identities", {}) if isinstance(value, dict) else {}
    if (not stat.S_ISREG(details.st_mode) or details.st_uid != os.getuid()
            or stat.S_IMODE(details.st_mode) & 0o022 or not isinstance(value, dict)
            or set(value) != {"schema_version", "evidence_class", "suite_sha256", "execution_depth",
                              "reported_depths", "identities", "queries", "resources",
                              "telemetry_samples", "receipt_hmac_sha256"}
            or value.get("schema_version") != 1 or value.get("evidence_class") != "silver"
            or value.get("suite_sha256") != suite_sha or not isinstance(identities, dict)
            or value.get("execution_depth") != 100
            or value.get("reported_depths") != [20, 50, 100]
            or not SHA256_RE.fullmatch(value.get("receipt_hmac_sha256", ""))
            or set(identities) != identities_fields
            or identities.get("source_revision") != suite["source_revision"]
            or type(identities.get("privacy_sequence")) is not int
            or identities["privacy_sequence"] < 0
            or any(not SHA256_RE.fullmatch(identities.get(name, ""))
                   for name in identities_fields - {"source_revision", "privacy_sequence"})
            or not isinstance(value.get("queries"), list) or len(value["queries"]) != 100
            or not isinstance(resources, dict) or set(resources) != {"code", "reranker"}):
        raise ValueError("silver evidence is invalid")
    unsigned = {key: item for key, item in value.items() if key != "receipt_hmac_sha256"}
    if not hmac.compare_digest(value["receipt_hmac_sha256"], benchmark_receipt(config, unsigned)):
        raise ValueError("silver evidence receipt is invalid")
    resolved = resolve_silver_citations(config, project_id, suite)
    projected_chunks = frozen_chunk_citations(config, project_id, suite["source_revision"])
    seen = set()
    strata = {}
    for source, query in zip(suite["questions"], value["queries"]):
        if (not isinstance(query, dict)
                or set(query) != {"query_id", "stratum", "judgments", "expected_citations",
                                  "rankings", "citations", "runs_seconds", "repeat_rankings"}
                or query.get("query_id") != source["query_id"]
                or query.get("stratum") != source["stratum"] or query["query_id"] in seen
                or query.get("judgments") != resolved[query["query_id"]]["judgments"]
                or query.get("expected_citations") != resolved[query["query_id"]]["expected_citations"]
                or set(query.get("rankings", {})) != systems
                or any(not isinstance(ranking, list) or len(ranking) != 100
                       or len(ranking) != len(set(ranking))
                       or any(not SHA256_RE.fullmatch(item) or item not in projected_chunks
                              for item in ranking)
                       for ranking in query["rankings"].values())
                or set(query.get("citations", {})) != systems
                or any(not isinstance(items, list) or len(items) > 20
                       or len(items) != len(set(items))
                       or any(not SHA256_RE.fullmatch(item) for item in items)
                       for items in query["citations"].values())
                or set(query.get("runs_seconds", {})) != systems
                or any(not isinstance(samples, list) or len(samples) < 2
                       or any(not isinstance(item, (int, float)) or isinstance(item, bool)
                              or not math.isfinite(item) or item < 0 for item in samples)
                       for samples in query["runs_seconds"].values())
                or set(query.get("repeat_rankings", {})) != systems
                or any(not isinstance(repeats, list) or len(repeats) != 2
                        or any(not isinstance(repeat, list) or len(repeat) != 100
                               or len(repeat) != len(set(repeat))
                               or any(not SHA256_RE.fullmatch(item)
                                      or item not in projected_chunks for item in repeat)
                               for repeat in repeats)
                        for system, repeats in query["repeat_rankings"].items())):
            raise ValueError("silver query evidence is invalid")
        if any(query["citations"][system] != list(dict.fromkeys(
                projected_chunks[item] for item in query["rankings"][system][:10]))
               for system in systems):
            raise ValueError("silver query citation evidence is invalid")
        seen.add(query["query_id"])
        strata[query["stratum"]] = strata.get(query["stratum"], 0) + 1
    if strata != suite["strata"]:
        raise ValueError("silver evidence strata are invalid")
    telemetry = value["telemetry_samples"]
    if (not isinstance(telemetry, list) or len(telemetry) < 2
            or any(not isinstance(item, dict)
                   or set(item) != {"captured_at", "memory_gib", "memory_pressure", "swap_used_bytes"}
                   or not isinstance(item["captured_at"], (int, float))
                   or not isinstance(item["memory_gib"], (int, float))
                   or not math.isfinite(item["captured_at"]) or not math.isfinite(item["memory_gib"])
                   or item["captured_at"] < 0 or item["memory_gib"] < 0
                   or item["memory_pressure"] not in {"normal", "warning", "critical"}
                   or type(item["swap_used_bytes"]) is not int or item["swap_used_bytes"] < 0
                   for item in telemetry)
            or any(right["captured_at"] <= left["captured_at"]
                   or right["captured_at"] - left["captured_at"] > 15
                   for left, right in zip(telemetry, telemetry[1:]))):
        raise ValueError("silver telemetry evidence is invalid")
    measured_resource = {
        "peak_memory_gib": max(item["memory_gib"] for item in telemetry),
        "memory_pressure": max((item["memory_pressure"] for item in telemetry),
                               key=("normal", "warning", "critical").index),
        "swap_growth_bytes": max(0, max(item["swap_used_bytes"] for item in telemetry)
                                 - telemetry[0]["swap_used_bytes"]),
    }
    for resource in resources.values():
        if (not isinstance(resource, dict)
                or set(resource) != {"peak_memory_gib", "memory_pressure", "swap_growth_bytes"}
                or not isinstance(resource["peak_memory_gib"], (int, float))
                or isinstance(resource["peak_memory_gib"], bool)
                or not math.isfinite(resource["peak_memory_gib"]) or resource["peak_memory_gib"] < 0
                or resource["memory_pressure"] not in {"normal", "warning", "critical"}
                or type(resource["swap_growth_bytes"]) is not int or resource["swap_growth_bytes"] < 0
                or resource != measured_resource):
            raise ValueError("silver resource evidence is invalid")
    code = benchmark_candidate_metrics(value["queries"], "baseline", "code",
                                       suite_sha, resources["code"])
    reranker_baseline = "code" if code["eligible"] else "baseline"
    reranker_candidate = "code_reranker" if code["eligible"] else "reranker"
    return {"schema_version": 1, "evidence_class": "silver", "suite_sha256": suite_sha,
            "query_count": len(value["queries"]), "strata": strata, "matrix_complete": True,
            "identities": identities, "candidates": {"code": code, "reranker":
                benchmark_candidate_metrics(value["queries"], reranker_baseline,
                                            reranker_candidate, suite_sha, resources["reranker"])}}


def load_silver_aggregate(path_value):
    path = Path(path_value).expanduser()
    try:
        details = path.lstat()
        raw = path.read_bytes()
        value = json.loads(raw, object_pairs_hook=lambda pairs: dict(pairs)
                           if len(dict(pairs)) == len(pairs) else (_ for _ in ()).throw(
                               ValueError("duplicate silver aggregate key")))
    except (OSError, json.JSONDecodeError) as error:
        raise ValueError("silver aggregate unavailable") from error
    if (not stat.S_ISREG(details.st_mode) or details.st_uid != os.getuid()
            or stat.S_IMODE(details.st_mode) & 0o022 or not isinstance(value, dict)
            or set(value) != {"schema_version", "evidence_class", "suite_sha256", "query_count",
                              "strata", "matrix_complete", "identities", "candidates"}
            or value.get("schema_version") != 1 or value.get("evidence_class") != "silver"):
        raise ValueError("silver aggregate is invalid")
    return value, hashlib.sha256(raw).hexdigest()


def system_memory_gib():
    total = int(subprocess.run(["sysctl", "-n", "hw.memsize"], text=True,
                               capture_output=True, check=True).stdout.strip())
    output = subprocess.run(["vm_stat"], text=True, capture_output=True, check=True).stdout
    match = re.search(r"page size of (\d+) bytes", output)
    free_match = re.search(r"Pages free:\s+(\d+)\.", output)
    speculative_match = re.search(r"Pages speculative:\s+(\d+)\.", output)
    if not match or not free_match or not speculative_match:
        raise RuntimeError("memory telemetry unavailable")
    free = (int(free_match.group(1)) + int(speculative_match.group(1))) * int(match.group(1))
    return (total - free) / 1024 ** 3


def swap_used_bytes():
    output = subprocess.run(["sysctl", "-n", "vm.swapusage"], text=True,
                            capture_output=True, check=True).stdout
    match = re.search(r"used = ([0-9.]+)([KMG])", output)
    if not match:
        raise RuntimeError("swap telemetry unavailable")
    scale = {"K": 1024, "M": 1024 ** 2, "G": 1024 ** 3}[match.group(2)]
    return int(float(match.group(1)) * scale)


def memory_pressure_state(config):
    collector = Path(config.get("benchmark_collector_file", "")).expanduser()
    try:
        details = collector.lstat()
        digest = hashlib.sha256(collector.read_bytes()).hexdigest()
    except OSError as error:
        raise RuntimeError("benchmark telemetry collector unavailable") from error
    if (not stat.S_ISREG(details.st_mode) or details.st_uid != os.getuid()
            or stat.S_IMODE(details.st_mode) & 0o022
            or digest != config.get("benchmark_collector_sha256")):
        raise RuntimeError("benchmark telemetry collector identity mismatch")
    try:
        raw = subprocess.run([str(collector)], text=True, capture_output=True,
                             check=True, timeout=30).stdout
        pressure = json.loads(raw)["memory_pressure"]
    except (subprocess.SubprocessError, json.JSONDecodeError, KeyError) as error:
        raise RuntimeError("benchmark telemetry unavailable") from error
    if pressure not in {"normal", "warning", "critical"}:
        raise RuntimeError("benchmark memory pressure is invalid")
    return pressure


class BenchmarkTelemetry:
    def __init__(self, config):
        self.config = config
        self.samples = []
        self.error = None
        self.stop = threading.Event()
        self.thread = threading.Thread(target=self._run, daemon=True)

    def _sample(self):
        self.samples.append({"captured_at": time.time(), "memory_gib": system_memory_gib(),
                             "memory_pressure": memory_pressure_state(self.config),
                             "swap_used_bytes": swap_used_bytes()})

    def _run(self):
        try:
            while not self.stop.wait(5):
                self._sample()
        except Exception as error:
            self.error = error
            self.stop.set()

    def __enter__(self):
        self._sample()
        self.thread.start()
        return self

    def __exit__(self, *_args):
        self.stop.set()
        self.thread.join(timeout=30)
        if self.thread.is_alive():
            raise RuntimeError("benchmark telemetry did not stop")
        self._sample()
        if self.error:
            raise RuntimeError("benchmark telemetry failed") from self.error
        if len(self.samples) < 2 or any(
                right["captured_at"] - left["captured_at"] > 15
                for left, right in zip(self.samples, self.samples[1:])):
            raise RuntimeError("benchmark telemetry coverage is incomplete")


def benchmark_receipt_key(config):
    path = Path(config.get("embedding", {}).get("api_key_file", "")).expanduser()
    try:
        details = path.lstat()
        value = path.read_text().strip()
    except OSError as error:
        raise RuntimeError("benchmark receipt key unavailable") from error
    if (not stat.S_ISREG(details.st_mode) or details.st_uid != os.getuid()
            or stat.S_IMODE(details.st_mode) != 0o600 or not SHA256_RE.fullmatch(value)):
        raise RuntimeError("benchmark receipt key is invalid")
    return bytes.fromhex(value)


def benchmark_receipt(config, value):
    return hmac.new(benchmark_receipt_key(config), canonical_json(value).encode(),
                    hashlib.sha256).hexdigest()


def write_new_json(path_value, value):
    path = Path(path_value).expanduser()
    if not path.is_absolute() or path.exists():
        raise ValueError("benchmark output must be a new absolute path")
    parent = path.parent.resolve(strict=True)
    temporary = parent / f".{path.name}.{secrets.token_hex(8)}.tmp"
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL
                         | getattr(os, "O_NOFOLLOW", 0), 0o600)
    try:
        payload = (canonical_json(value) + "\n").encode()
        with os.fdopen(descriptor, "wb") as handle:
            descriptor = None
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        os.link(temporary, path, follow_symlinks=False)
        os.chmod(path, 0o600, follow_symlinks=False)
        directory = os.open(parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        if descriptor is not None:
            os.close(descriptor)
        temporary.unlink(missing_ok=True)


def command_benchmark_silver_run(args, config, project):
    suite, suite_sha = load_silver_suite(args.suite, project)
    if Path(args.evidence).expanduser().exists() or Path(args.aggregate).expanduser().exists():
        raise ValueError("benchmark output already exists")
    validate_embedding_config(config)
    validate_code_embedding_config(config)
    validate_reranker_config(config, config.get("reranker", {}).get("manifest_sha256"))
    for name in ("embedding", "code_embedding", "reranker"):
        validate_service_health(config, name)
    systems = ("baseline", "code", "reranker", "code_reranker")
    query_evidence = []
    with BenchmarkTelemetry(config) as telemetry, PsqlSession(config) as session:
        session.execute(f"SET dks.project_id={sql_literal(args.project)};")
        for lock_name in (args.project, args.project + ":code", args.project + ":authority"):
            locked = session.execute(
                f"SELECT pg_try_advisory_lock_shared(hashtextextended({sql_literal(lock_name)}, 0));")
            if not locked or locked[-1] != "t":
                raise RuntimeError("silver benchmark lock unavailable")
        session.execute("BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY;")
        resolved = resolve_silver_citations(config, args.project, suite, session)
        source_sha = projection_identity(config, args.project, suite["source_revision"], session)
        authority_rows = session.execute(authority_projection_payload_sql())
        graph_rows = session.execute(f"""
SELECT artifact_sha256 FROM dks.graph_imports
WHERE project_id=current_setting('dks.project_id')
  AND revision_id={sql_literal(suite['source_revision'])} AND state='active';
""")
        if len(authority_rows) != 1 or len(graph_rows) != 1:
            raise RuntimeError("silver benchmark projection identity is unavailable")
        authority = json.loads(authority_rows[0])
        identities = {
            "source_revision": suite["source_revision"],
            "source_profile_sha256": project.get("source_profile_sha256"),
            "source_projection_sha256": source_sha,
            "authority_snapshot_set_sha256": digest_json(authority["snapshots"]),
            "authority_projection_sha256": digest_json(authority),
            "privacy_sequence": int(authority["privacy_sequence"]),
            "privacy_digest": authority["privacy_digest"],
            "graph_artifact_sha256": graph_rows[0],
            "general_embedding_manifest_sha256": config["embedding"]["manifest_sha256"],
            "code_embedding_manifest_sha256": config["code_embedding"]["manifest_sha256"],
            "reranker_manifest_sha256": config["reranker"]["manifest_sha256"],
        }
        if any(not SHA256_RE.fullmatch(str(value)) for key, value in identities.items()
               if key not in {"source_revision", "privacy_sequence"}):
            raise RuntimeError("silver benchmark identity is invalid")
        for question in suite["questions"]:
            rankings, citations, runs, repeats = {}, {}, {}, {}
            for system in systems:
                samples = []
                for _ in range(2):
                    query_args = argparse.Namespace(project=args.project, text=question["text"],
                                                    commit=suite["source_revision"], limit=100,
                                                    benchmark_system=system)
                    started = time.perf_counter()
                    result = command_query_transaction(query_args, config, project, session)
                    samples.append((time.perf_counter() - started, result))
                ranking_sets = [[item["id"] for item in result["results"]]
                                for _, result in samples]
                if any(len(ranking) != 100 for ranking in ranking_sets):
                    raise RuntimeError("silver benchmark candidate depth is incomplete")
                rankings[system] = ranking_sets[0]
                repeats[system] = ranking_sets
                citations[system] = list(dict.fromkeys(
                    item["body_sha256"] for item in samples[0][1]["results"][:10]))
                runs[system] = [elapsed for elapsed, _ in samples]
            query_evidence.append({"query_id": question["query_id"], "stratum": question["stratum"],
                                   **resolved[question["query_id"]], "rankings": rankings,
                                   "citations": citations, "runs_seconds": runs,
                                   "repeat_rankings": repeats})
        session.execute("COMMIT;")
    telemetry_samples = telemetry.samples
    resource = {
        "peak_memory_gib": max(item["memory_gib"] for item in telemetry_samples),
        "memory_pressure": max((item["memory_pressure"] for item in telemetry_samples),
                               key=("normal", "warning", "critical").index),
        "swap_growth_bytes": max(0, max(item["swap_used_bytes"] for item in telemetry_samples)
                                 - telemetry_samples[0]["swap_used_bytes"]),
    }
    evidence = {"schema_version": 1, "evidence_class": "silver", "suite_sha256": suite_sha,
                "execution_depth": 100, "reported_depths": [20, 50, 100],
                "identities": identities, "queries": query_evidence,
                "resources": {"code": resource, "reranker": resource},
                "telemetry_samples": telemetry_samples}
    evidence["receipt_hmac_sha256"] = benchmark_receipt(config, evidence)
    write_new_json(args.evidence, evidence)
    try:
        aggregate = load_silver_evidence(args.evidence, suite, suite_sha, config, args.project)
        write_new_json(args.aggregate, aggregate)
    except Exception:
        Path(args.evidence).unlink(missing_ok=True)
        raise
    return {"project": args.project, "suite_sha256": suite_sha,
            "query_count": len(query_evidence), "aggregate": aggregate}


def load_benchmark_aggregate(path_value):
    path = Path(path_value).expanduser()
    try:
        details = path.lstat()
        if (not stat.S_ISREG(details.st_mode) or details.st_uid != os.getuid()
                or stat.S_IMODE(details.st_mode) & 0o022):
            raise OSError("unsafe benchmark aggregate")
        raw = path.read_bytes()
        value = json.loads(raw, object_pairs_hook=lambda pairs: dict(pairs)
                           if len(dict(pairs)) == len(pairs) else (_ for _ in ()).throw(
                               ValueError("duplicate benchmark key")))
    except (OSError, json.JSONDecodeError) as error:
        raise ValueError("benchmark aggregate unavailable") from error
    fields = {"schema_version", "manifest_sha256", "query_count", "strata", "judgment_depth",
              "duplicate_fraction", "quadratic_kappa", "matrix_complete", "candidates"}
    if (not isinstance(value, dict) or set(value) != fields or value.get("schema_version") != 2
            or not SHA256_RE.fullmatch(value.get("manifest_sha256", ""))
            or type(value.get("query_count")) is not int or value["query_count"] < 100
            or not isinstance(value.get("strata"), dict) or len(value["strata"]) < 1
            or sum(value["strata"].values()) != value["query_count"]
            or any(not isinstance(name, str) or not name or type(count) is not int or count < 20
                   for name, count in value["strata"].items())
            or value.get("judgment_depth") != 50
            or not isinstance(value.get("duplicate_fraction"), (int, float))
            or isinstance(value["duplicate_fraction"], bool) or value["duplicate_fraction"] < 0.2
            or not isinstance(value.get("quadratic_kappa"), (int, float))
            or isinstance(value["quadratic_kappa"], bool) or value["quadratic_kappa"] < 0.70
            or value.get("matrix_complete") is not True
            or set(value.get("candidates", {})) != {"code", "reranker"}):
        raise ValueError("benchmark aggregate is invalid")
    metric_fields = {"eligible", "relative_ndcg10", "absolute_ndcg10", "baseline_ndcg10",
                     "ci95_lower", "max_stratum_regression", "exact_citation_regressions",
                     "recall50_delta", "deterministic_rank", "warm_p95_seconds",
                     "peak_memory_gib", "memory_pressure", "swap_growth_bytes"}
    for candidate in value["candidates"].values():
        if (not isinstance(candidate, dict) or set(candidate) != metric_fields
                or type(candidate.get("eligible")) is not bool
                or candidate.get("deterministic_rank") is not True
                or candidate.get("memory_pressure") != "normal"
                or type(candidate.get("swap_growth_bytes")) is not int
                or candidate["swap_growth_bytes"] != 0
                or any(not isinstance(candidate.get(name), (int, float))
                       or isinstance(candidate[name], bool) or not math.isfinite(candidate[name])
                       for name in metric_fields - {"eligible", "deterministic_rank",
                                                    "memory_pressure", "swap_growth_bytes"})):
            raise ValueError("benchmark candidate metrics are invalid")
        passes = ((candidate["relative_ndcg10"] >= 0.05
                   if candidate["baseline_ndcg10"] > 0 else candidate["absolute_ndcg10"] >= 0.05)
                  and candidate["ci95_lower"] > 0
                  and candidate["max_stratum_regression"] >= -0.02
                   and candidate["exact_citation_regressions"] == 0
                  and candidate["recall50_delta"] >= 0
                  and candidate["warm_p95_seconds"] <= 30
                  and candidate["peak_memory_gib"] <= 56)
        if candidate["eligible"] != passes:
            raise ValueError("benchmark eligibility does not match metrics")
    return value, hashlib.sha256(raw).hexdigest()


def benchmark_ndcg(ranking, judgments, depth=10):
    gains = sorted((2 ** grade - 1 for grade in judgments.values()), reverse=True)[:depth]
    ideal = sum(gain / math.log2(rank + 2) for rank, gain in enumerate(gains))
    actual = sum((2 ** judgments.get(item, 0) - 1) / math.log2(rank + 2)
                 for rank, item in enumerate(ranking[:depth]))
    return actual / ideal if ideal else 0.0


def quadratic_kappa(pairs):
    size = len(pairs)
    left = [sum(a == grade for a, _ in pairs) / size for grade in range(4)]
    right = [sum(b == grade for _, b in pairs) / size for grade in range(4)]
    observed = sum(((a - b) ** 2 / 9) for a, b in pairs) / size
    expected = sum(((a - b) ** 2 / 9) * left[a] * right[b]
                   for a in range(4) for b in range(4))
    return 1.0 if expected == 0 and observed == 0 else 1 - observed / expected


def benchmark_candidate_metrics(queries, baseline_name, candidate_name, seed_sha, resource):
    deltas = {}
    baseline_scores = []
    candidate_scores = []
    recall_deltas = []
    exact_deltas = []
    latencies = []
    deterministic = True
    for query in queries:
        judgments = query["judgments"]
        baseline = benchmark_ndcg(query["rankings"][baseline_name], judgments)
        candidate = benchmark_ndcg(query["rankings"][candidate_name], judgments)
        baseline_scores.append(baseline)
        candidate_scores.append(candidate)
        deltas.setdefault(query["stratum"], []).append(candidate - baseline)
        relevant = {item for item, grade in judgments.items() if grade > 0}
        baseline_recall = len(relevant.intersection(query["rankings"][baseline_name][:50])) / len(relevant)
        candidate_recall = len(relevant.intersection(query["rankings"][candidate_name][:50])) / len(relevant)
        recall_deltas.append(candidate_recall - baseline_recall)
        expected = set(query["expected_citations"])
        exact_deltas.append(int(expected.issubset(query["citations"][candidate_name]))
                            - int(expected.issubset(query["citations"][baseline_name])))
        latencies.extend(query["runs_seconds"][candidate_name])
        deterministic = deterministic and all(
            repeat == query["rankings"][candidate_name]
            for repeat in query["repeat_rankings"][candidate_name])
    flat_deltas = [value for values in deltas.values() for value in values]
    bootstrap = []
    manifest_bytes = bytes.fromhex(seed_sha)
    for replicate in range(10000):
        sampled = []
        for stratum, values in sorted(deltas.items()):
            encoded = stratum.encode()
            for draw in range(len(values)):
                seed = (manifest_bytes + replicate.to_bytes(8, "big") + len(encoded).to_bytes(4, "big")
                        + encoded + draw.to_bytes(8, "big"))
                sampled.append(values[int.from_bytes(hashlib.sha256(seed).digest()[:8], "big") % len(values)])
        bootstrap.append(sum(sampled) / len(sampled))
    bootstrap.sort()
    baseline_mean = sum(baseline_scores) / len(baseline_scores)
    candidate_mean = sum(candidate_scores) / len(candidate_scores)
    absolute = candidate_mean - baseline_mean
    latency = sorted(latencies)
    metrics = {
        "relative_ndcg10": absolute / baseline_mean if baseline_mean else 0.0,
        "absolute_ndcg10": absolute,
        "baseline_ndcg10": baseline_mean,
        "ci95_lower": bootstrap[249],
        "max_stratum_regression": min(sum(values) / len(values) for values in deltas.values()),
        "exact_citation_regressions": sum(delta < 0 for delta in exact_deltas),
        "recall50_delta": sum(recall_deltas) / len(recall_deltas),
        "deterministic_rank": deterministic,
        "warm_p95_seconds": latency[math.ceil(0.95 * len(latency)) - 1],
        "peak_memory_gib": resource["peak_memory_gib"],
        "memory_pressure": resource["memory_pressure"],
        "swap_growth_bytes": resource["swap_growth_bytes"],
    }
    metrics["eligible"] = ((metrics["relative_ndcg10"] >= 0.05
                            if baseline_mean > 0 else absolute >= 0.05)
                           and metrics["ci95_lower"] > 0
                           and metrics["max_stratum_regression"] >= -0.02
                            and metrics["exact_citation_regressions"] == 0
                           and metrics["recall50_delta"] >= 0
                           and deterministic and metrics["warm_p95_seconds"] <= 30
                           and metrics["peak_memory_gib"] <= 56
                           and metrics["memory_pressure"] == "normal"
                           and metrics["swap_growth_bytes"] == 0)
    return metrics


def load_benchmark_evidence(path_value, manifest, manifest_sha, config):
    path = Path(path_value).expanduser()
    try:
        details = path.lstat()
        value = json.loads(path.read_bytes(), object_pairs_hook=lambda pairs: dict(pairs)
                           if len(dict(pairs)) == len(pairs) else (_ for _ in ()).throw(
                               ValueError("duplicate benchmark evidence key")))
    except (OSError, json.JSONDecodeError) as error:
        raise ValueError("benchmark evidence unavailable") from error
    systems = {"baseline", "code", "reranker", "code_reranker"}
    if (not stat.S_ISREG(details.st_mode) or details.st_uid != os.getuid()
            or stat.S_IMODE(details.st_mode) & 0o077 or not isinstance(value, dict)
            or set(value) != {"schema_version", "queries", "duplicate_assessments",
                              "adjudications", "resources", "telemetry_receipts", "run_manifests"}
            or value.get("schema_version") != 2 or not isinstance(value.get("queries"), list)
            or len(value["queries"]) != manifest["query_count"]
            or not isinstance(value.get("duplicate_assessments"), list)
            or len(value["duplicate_assessments"]) < math.ceil(len(value["queries"]) * 0.2)
            or not isinstance(value.get("adjudications"), list)
            or not isinstance(value.get("telemetry_receipts"), dict)
            or set(value["telemetry_receipts"]) != {"code", "reranker"}
            or not isinstance(value.get("run_manifests"), dict)
            or set(value["run_manifests"]) != {"code", "reranker"}
            or set(value.get("resources", {})) != {"code", "reranker"}):
        raise ValueError("benchmark evidence is invalid")
    collector = Path(config.get("benchmark_collector_file", "")).expanduser()
    try:
        collector_details = collector.lstat()
        collector_sha = hashlib.sha256(collector.read_bytes()).hexdigest()
    except OSError as error:
        raise ValueError("benchmark telemetry collector unavailable") from error
    if (not stat.S_ISREG(collector_details.st_mode) or collector_details.st_uid != os.getuid()
            or stat.S_IMODE(collector_details.st_mode) & 0o022
            or collector_sha != config.get("benchmark_collector_sha256")
            or collector_sha != manifest["telemetry_collector_sha256"]):
        raise ValueError("benchmark telemetry collector identity mismatch")
    query_identity = []
    judgment_identity = []
    result_identity = []
    strata = {}
    seen = set()
    all_run_ids = set()
    for query in value["queries"]:
        if (not isinstance(query, dict)
                or set(query) != {"query_id", "stratum", "text", "judgments", "rankings",
                                  "expected_citations", "citations", "depth_rankings",
                                  "depth_timings", "execution_receipts", "warmups_seconds", "runs_seconds",
                                  "repeat_rankings"}
                or not isinstance(query.get("query_id"), str) or not query["query_id"]
                or query["query_id"] in seen or not isinstance(query.get("stratum"), str)
                or not query["stratum"] or not isinstance(query.get("text"), str) or not query["text"]
                or not isinstance(query.get("judgments"), dict)
                or any(not isinstance(item, str) or not item or type(grade) is not int or not 0 <= grade <= 3
                       for item, grade in query["judgments"].items())
                or set(query.get("rankings", {})) != systems
                 or any(not isinstance(ranking, list) or len(ranking) != 100
                       or len(ranking) != len(set(ranking)) or any(not isinstance(item, str) or not item for item in ranking)
                       for ranking in query["rankings"].values())
                 or any(item not in query["judgments"] for ranking in query["rankings"].values()
                        for item in ranking[:50])
                 or set(query.get("depth_rankings", {})) != systems
                 or any(not isinstance(depths, dict) or set(depths) != {"20", "50", "100"}
                        or any(depths[str(depth)] != query["rankings"][system][:depth]
                               for depth in (20, 50, 100))
                        for system, depths in query["depth_rankings"].items())
                 or set(query.get("execution_receipts", {})) != systems
                 or set(query.get("depth_timings", {})) != systems
                 or any(not isinstance(depths, dict) or set(depths) != {"20", "50", "100"}
                        or any(not isinstance(samples, dict) or set(samples) != {"warmups", "runs"}
                               or not isinstance(samples["warmups"], list) or len(samples["warmups"]) != 3
                               or not isinstance(samples["runs"], list) or len(samples["runs"]) != 5
                               or any(not isinstance(number, (int, float)) or isinstance(number, bool)
                                      or not math.isfinite(number) or number < 0
                                      for number in samples["warmups"] + samples["runs"])
                               for samples in depths.values())
                        for depths in query["depth_timings"].values())
                 or any(not isinstance(receipts, dict) or set(receipts) != {"20", "50", "100"}
                        or any(not isinstance(receipt, dict)
                               or set(receipt) != {"run_id", "ranking_sha256", "timings_sha256",
                                                   "telemetry_sha256"}
                               or not isinstance(receipt["run_id"], str) or not receipt["run_id"]
                               or receipt["ranking_sha256"] != digest_json(
                                   query["depth_rankings"][system][depth])
                               or receipt["timings_sha256"] != digest_json({
                                   "warmups": query["depth_timings"][system][depth]["warmups"],
                                   "runs": query["depth_timings"][system][depth]["runs"]})
                               or not SHA256_RE.fullmatch(receipt["telemetry_sha256"])
                               for depth, receipt in receipts.items())
                        for system, receipts in query["execution_receipts"].items())
                or not any(grade > 0 for grade in query["judgments"].values())
                 or not isinstance(query.get("expected_citations"), list)
                 or not 1 <= len(query["expected_citations"]) <= 20
                 or len(query["expected_citations"]) != len(set(query["expected_citations"]))
                 or any(not SHA256_RE.fullmatch(item) for item in query["expected_citations"])
                 or set(query.get("citations", {})) != systems
                 or any(not isinstance(items, list) or len(items) > 20 or len(items) != len(set(items))
                        or any(not SHA256_RE.fullmatch(item) for item in items)
                        for items in query["citations"].values())
                or set(query.get("warmups_seconds", {})) != systems
                or any(not isinstance(samples, list) or len(samples) != 3
                       or any(not isinstance(item, (int, float)) or isinstance(item, bool)
                              or not math.isfinite(item) or item < 0 for item in samples)
                       for samples in query["warmups_seconds"].values())
                or set(query.get("runs_seconds", {})) != systems
                or any(not isinstance(samples, list) or len(samples) != 5
                       or any(not isinstance(item, (int, float)) or isinstance(item, bool)
                              or not math.isfinite(item) or item < 0 for item in samples)
                       for samples in query["runs_seconds"].values())
                or set(query.get("repeat_rankings", {})) != systems
                 or any(not isinstance(repeats, list) or len(repeats) != 2
                        or any(not isinstance(ranking, list) or len(ranking) != 100
                              or len(ranking) != len(set(ranking))
                              or any(not isinstance(item, str) or not item for item in ranking)
                              for ranking in repeats)
                       for repeats in query["repeat_rankings"].values())):
            raise ValueError("benchmark query evidence is invalid")
        seen.add(query["query_id"])
        run_ids = [receipt["run_id"] for receipts in query["execution_receipts"].values()
                   for receipt in receipts.values()]
        if len(run_ids) != 12 or len(set(run_ids)) != 12 or all_run_ids.intersection(run_ids):
            raise ValueError("benchmark execution receipts are incomplete")
        if any(query["warmups_seconds"][system] != query["depth_timings"][system]["100"]["warmups"]
               or query["runs_seconds"][system] != query["depth_timings"][system]["100"]["runs"]
               for system in systems):
            raise ValueError("benchmark summary timings do not match depth 100")
        all_run_ids.update(run_ids)
        strata[query["stratum"]] = strata.get(query["stratum"], 0) + 1
        query_identity.append([query["query_id"], query["stratum"], query["text"]])
        judgment_identity.append([query["query_id"], sorted(query["judgments"].items()),
                                  query["expected_citations"]])
        result_identity.append([query["query_id"], query["rankings"], query["expected_citations"],
                                query["citations"],
                                query["depth_rankings"], query["depth_timings"],
                                query["execution_receipts"],
                                query["warmups_seconds"], query["runs_seconds"],
                                query["repeat_rankings"]])
    pairs = []
    assignment_ids = set()
    pair_ids = set()
    for pair in value["duplicate_assessments"]:
        if (not isinstance(pair, dict)
                or set(pair) != {"original_assignment_id", "duplicate_assignment_id", "pair_id",
                                 "assessor_id", "query_id", "item_id", "randomization_sha256",
                                 "first_grade", "second_grade"}
                or any(not isinstance(pair.get(name), str) or not pair[name]
                       for name in ("original_assignment_id", "duplicate_assignment_id",
                                    "pair_id", "assessor_id", "query_id", "item_id"))
                or not SHA256_RE.fullmatch(pair.get("randomization_sha256", ""))
                or pair["query_id"] not in seen
                or pair["item_id"] not in next(query["judgments"] for query in value["queries"]
                                                if query["query_id"] == pair["query_id"])
                or pair["original_assignment_id"] == pair["duplicate_assignment_id"]
                or pair["original_assignment_id"] in assignment_ids
                or pair["duplicate_assignment_id"] in assignment_ids
                or pair["pair_id"] in pair_ids
                or any(type(pair.get(name)) is not int or not 0 <= pair[name] <= 3
                       for name in ("first_grade", "second_grade"))):
            raise ValueError("benchmark duplicate assessment is invalid")
        assignment_ids.update((pair["original_assignment_id"], pair["duplicate_assignment_id"]))
        pair_ids.add(pair["pair_id"])
        pairs.append((pair["first_grade"], pair["second_grade"]))
    adjudicated = set()
    for item in value["adjudications"]:
        if (not isinstance(item, dict)
                or set(item) != {"pair_id", "adjudicator_id", "final_grade", "reason"}
                or any(not isinstance(item.get(name), str) or not item[name]
                       for name in ("pair_id", "adjudicator_id", "reason"))
                or item["pair_id"] in adjudicated
                or type(item.get("final_grade")) is not int or not 0 <= item["final_grade"] <= 3
                or item["pair_id"] not in pair_ids):
            raise ValueError("benchmark adjudication is invalid")
        adjudicated.add(item["pair_id"])
    disagreements = {item["pair_id"] for item in value["duplicate_assessments"]
                     if item["first_grade"] != item["second_grade"]}
    if adjudicated != disagreements:
        raise ValueError("benchmark disagreements are not fully adjudicated")
    pair_by_id = {item["pair_id"]: item for item in value["duplicate_assessments"]}
    judgments_by_query = {item["query_id"]: item["judgments"] for item in value["queries"]}
    adjudication_by_pair = {item["pair_id"]: item["final_grade"] for item in value["adjudications"]}
    if any(item["final_grade"] != judgments_by_query[pair_by_id[item["pair_id"]]["query_id"]]
           [pair_by_id[item["pair_id"]]["item_id"]] for item in value["adjudications"]):
        raise ValueError("benchmark adjudication does not match frozen judgment")
    if any((adjudication_by_pair.get(pair["pair_id"], pair["first_grade"])
            != judgments_by_query[pair["query_id"]][pair["item_id"]])
           for pair in value["duplicate_assessments"]):
        raise ValueError("benchmark duplicate does not match frozen judgment")
    judgment_identity.append(["duplicates", value["duplicate_assessments"]])
    judgment_identity.append(["adjudications", value["adjudications"]])
    for resource in value["resources"].values():
        if (not isinstance(resource, dict)
                or set(resource) != {"peak_memory_gib", "memory_pressure", "swap_growth_bytes",
                                     "hardware_sku", "os_version", "power_state", "thermal_state",
                                     "captured_at", "collector_sha256", "raw_telemetry_sha256",
                                     "run_manifest_sha256"}
                or not isinstance(resource["peak_memory_gib"], (int, float))
                or isinstance(resource["peak_memory_gib"], bool) or not math.isfinite(resource["peak_memory_gib"])
                or resource["peak_memory_gib"] < 0 or not isinstance(resource["memory_pressure"], str)
                or resource["memory_pressure"] not in {"normal", "warning", "critical"}
                or type(resource["swap_growth_bytes"]) is not int or resource["swap_growth_bytes"] < 0
                or type(resource["captured_at"]) is not int or resource["captured_at"] < 0
                or any(not isinstance(resource[name], str) or not resource[name]
                       for name in ("hardware_sku", "os_version", "power_state", "thermal_state"))):
            raise ValueError("benchmark resource evidence is invalid")
        if (any(not SHA256_RE.fullmatch(resource[name]) for name in
                ("collector_sha256", "raw_telemetry_sha256", "run_manifest_sha256"))
                or resource["collector_sha256"] != manifest["telemetry_collector_sha256"]
                or [resource["hardware_sku"], resource["os_version"], resource["power_state"],
                    resource["thermal_state"]] != [manifest["hardware"][name]
                                                    for name in ("sku", "os", "power", "thermal")]):
            raise ValueError("benchmark telemetry identity is invalid")
    for name, receipt in value["telemetry_receipts"].items():
        resource = value["resources"][name]
        systems_for_resource = ({"baseline", "code"} if name == "code" else
                                {"reranker", "code_reranker"})
        expected_runs = sorted(receipt["run_id"] for query in value["queries"]
                               for system, receipts in query["execution_receipts"].items()
                               if system in systems_for_resource for receipt in receipts.values())
        run_manifest = value["run_manifests"][name]
        if (not isinstance(run_manifest, dict)
                or set(run_manifest) != {"collector_sha256", "protocol_digest", "run_ids"}
                or run_manifest.get("collector_sha256") != collector_sha
                or run_manifest.get("protocol_digest") != manifest["protocol_digest"]
                or run_manifest.get("run_ids") != expected_runs
                or digest_json(run_manifest) != resource["run_manifest_sha256"]
                or not isinstance(receipt, dict)
                or set(receipt) != {"collector_sha256", "run_manifest_sha256", "run_ids", "samples"}
                or receipt.get("collector_sha256") != resource["collector_sha256"]
                or receipt.get("run_manifest_sha256") != resource["run_manifest_sha256"]
                or receipt.get("run_ids") != expected_runs
                or receipt.get("samples") != {key: resource[key] for key in (
                    "peak_memory_gib", "memory_pressure", "swap_growth_bytes", "hardware_sku",
                    "os_version", "power_state", "thermal_state", "captured_at")}
                or digest_json(receipt) != resource["raw_telemetry_sha256"]):
            raise ValueError("benchmark telemetry receipt is invalid")
    for query in value["queries"]:
        for system, receipts in query["execution_receipts"].items():
            resource = value["resources"]["code" if system in {"baseline", "code"} else "reranker"]
            if any(receipt["telemetry_sha256"] != resource["raw_telemetry_sha256"]
                   for receipt in receipts.values()):
                raise ValueError("benchmark execution telemetry identity mismatch")
    result_identity.append(["resources", value["resources"]])
    result_identity.append(["telemetry_receipts", value["telemetry_receipts"]])
    result_identity.append(["run_manifests", value["run_manifests"]])
    if (strata != manifest["strata"]
            or digest_json(query_identity) != manifest["query_digest"]
            or digest_json(judgment_identity) != manifest["judgment_digest"]
            or digest_json(result_identity) != manifest["result_digest"]):
        raise ValueError("benchmark evidence manifest identity mismatch")
    code = benchmark_candidate_metrics(value["queries"], "baseline", "code", manifest["seed_sha256"],
                                       value["resources"]["code"])
    reranker_baseline = "code" if code["eligible"] else "baseline"
    reranker_candidate = "code_reranker" if code["eligible"] else "reranker"
    matrix_complete = all(set(query["execution_receipts"]) == systems
                          and all(set(receipts) == {"20", "50", "100"}
                                  for receipts in query["execution_receipts"].values())
                          for query in value["queries"])
    return {"schema_version": 2, "manifest_sha256": manifest_sha,
            "query_count": len(value["queries"]), "strata": strata, "judgment_depth": 50,
            "duplicate_fraction": len(pairs) / len(value["queries"]),
            "quadratic_kappa": quadratic_kappa(pairs), "matrix_complete": matrix_complete,
            "candidates": {"code": code, "reranker": benchmark_candidate_metrics(
                value["queries"], reranker_baseline, reranker_candidate, manifest["seed_sha256"],
                value["resources"]["reranker"])}}


def benchmark_protocol_identity(value):
    fields = ("benchmark_id", "protocol_version", "source_revision", "source_profile_sha256",
              "source_projection_sha256", "authority_snapshot_set_sha256",
              "authority_projection_sha256", "privacy_sequence", "privacy_digest",
              "graph_artifact_sha256", "general_embedding_manifest_sha256",
              "code_embedding_manifest_sha256", "reranker_manifest_sha256", "query_digest",
              "query_count", "strata", "depths", "seed_sha256", "hardware",
              "assessor_protocol_version", "candidate_systems", "prompts", "chunkers",
              "metrics", "thresholds", "split", "activation_order",
              "telemetry_collector_sha256")
    return {name: value[name] for name in fields}


def load_benchmark_manifest(path_value):
    path = Path(path_value).expanduser()
    try:
        details = path.lstat()
        raw = path.read_bytes()
        value = json.loads(raw, object_pairs_hook=lambda pairs: dict(pairs)
                           if len(dict(pairs)) == len(pairs) else (_ for _ in ()).throw(
                               ValueError("duplicate benchmark manifest key")))
    except (OSError, json.JSONDecodeError) as error:
        raise ValueError("benchmark manifest unavailable") from error
    fields = {"schema_version", "benchmark_id", "protocol_version", "source_revision",
              "source_profile_sha256", "source_projection_sha256",
              "authority_snapshot_set_sha256", "authority_projection_sha256",
              "privacy_sequence", "privacy_digest",
              "graph_artifact_sha256",
              "general_embedding_manifest_sha256", "code_embedding_manifest_sha256",
              "reranker_manifest_sha256", "query_digest", "judgment_digest", "query_count",
              "result_digest", "strata", "depths", "seed_sha256", "hardware", "authored_at",
              "query_approval_commit", "judgment_freeze_commit", "assessor_protocol_version",
              "candidate_systems", "prompts", "chunkers", "metrics", "thresholds", "split",
              "activation_order", "protocol_digest", "telemetry_collector_sha256"}
    hashes = {"source_profile_sha256", "graph_artifact_sha256",
              "source_projection_sha256", "authority_snapshot_set_sha256",
              "authority_projection_sha256", "privacy_digest",
              "general_embedding_manifest_sha256", "code_embedding_manifest_sha256",
              "reranker_manifest_sha256", "query_digest", "judgment_digest", "seed_sha256"}
    hashes.update({"result_digest", "protocol_digest", "telemetry_collector_sha256"})
    if (not stat.S_ISREG(details.st_mode) or details.st_uid != os.getuid()
            or stat.S_IMODE(details.st_mode) & 0o022 or not isinstance(value, dict)
            or set(value) != fields or value.get("schema_version") != 2
            or not isinstance(value.get("benchmark_id"), str) or not value["benchmark_id"]
            or value.get("protocol_version") != "dks-benchmark-v2"
            or not COMMIT_RE.fullmatch(value.get("source_revision", ""))
            or not COMMIT_RE.fullmatch(value.get("query_approval_commit", ""))
            or not COMMIT_RE.fullmatch(value.get("judgment_freeze_commit", ""))
            or type(value.get("privacy_sequence")) is not int
            or not 0 <= value["privacy_sequence"] < 2**64
            or any(not SHA256_RE.fullmatch(value.get(name, "")) for name in hashes)
            or type(value.get("query_count")) is not int or value["query_count"] < 100
            or not isinstance(value.get("strata"), dict) or sum(value["strata"].values()) != value["query_count"]
            or any(type(count) is not int or count < 20 for count in value["strata"].values())
            or value.get("depths") != [20, 50, 100]
            or value.get("assessor_protocol_version") != "dks-assessor-v2"
            or value.get("candidate_systems") != ["baseline", "code", "reranker", "code_reranker"]
            or not isinstance(value.get("prompts"), dict)
            or set(value["prompts"]) != {"general", "code", "reranker"}
            or any(not SHA256_RE.fullmatch(item) for item in value["prompts"].values())
            or value.get("chunkers") != ["dks-markdown-v1", "dks-source-v1", "dks-authority-v1"]
            or value.get("metrics") != ["ndcg10", "recall50", "exact_citation", "latency", "memory"]
            or value.get("thresholds") != {"relative_ndcg10": 0.05,
                                            "absolute_ndcg10_zero_baseline": 0.05,
                                            "ci95_lower": 0.0,
                                            "max_stratum_regression": -0.02,
                                            "warm_p95_seconds": 30.0,
                                            "peak_memory_gib": 56.0}
            or value.get("split") != {"evaluation": "frozen", "training_queries": 0}
            or value.get("activation_order") != ["baseline", "code", "reranker"]
            or digest_json(benchmark_protocol_identity(value)) != value.get("protocol_digest")
            or not isinstance(value.get("hardware"), dict)
            or set(value["hardware"]) != {"sku", "os", "power", "thermal"}
            or any(not isinstance(item, str) or not item for item in value["hardware"].values())
            or type(value.get("authored_at")) is not int or value["authored_at"] < 0):
        raise ValueError("benchmark manifest is invalid")
    return value, hashlib.sha256(raw).hexdigest()


def validate_benchmark_approval(config, project, manifest):
    source_revision = config.get("quality_benchmark_source_revision")
    query_approval = config.get("quality_benchmark_query_approval_commit")
    judgment_freeze = config.get("quality_benchmark_judgment_freeze_commit")
    query_digest = config.get("quality_benchmark_query_digest")
    protocol_digest = config.get("quality_benchmark_protocol_digest")
    judgment_digest = config.get("quality_benchmark_judgment_digest")
    if (not COMMIT_RE.fullmatch(str(source_revision or ""))
            or not COMMIT_RE.fullmatch(str(query_approval or ""))
            or not COMMIT_RE.fullmatch(str(judgment_freeze or ""))
            or not SHA256_RE.fullmatch(str(query_digest or ""))
            or not SHA256_RE.fullmatch(str(protocol_digest or ""))
            or not SHA256_RE.fullmatch(str(judgment_digest or ""))
            or source_revision != manifest["source_revision"]
            or query_approval != manifest["query_approval_commit"]
            or judgment_freeze != manifest["judgment_freeze_commit"]
            or query_digest != manifest["query_digest"]
            or protocol_digest != manifest["protocol_digest"]
            or judgment_digest != manifest["judgment_digest"]):
        raise RuntimeError("benchmark lineage is not approved")
    repository = Path(project.get("repository", "")).expanduser()
    environment = {**os.environ, "GIT_NO_REPLACE_OBJECTS": "1"}
    if len({source_revision, query_approval, judgment_freeze}) != 3:
        raise RuntimeError("benchmark lineage stages must use distinct commits")
    for older, newer in ((source_revision, query_approval), (query_approval, judgment_freeze)):
        ancestor = subprocess.run(
            ["git", "merge-base", "--is-ancestor", older, newer], cwd=repository,
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL, env=environment)
        if ancestor.returncode:
            raise RuntimeError("benchmark lineage order is invalid")
    try:
        query_raw = run_git(repository, "show", f"{query_approval}:.chezmoidata.toml", binary=True)
        freeze_raw = run_git(repository, "show", f"{judgment_freeze}:.chezmoidata.toml", binary=True)
        query_record = tomllib.loads(query_raw.decode())["dotfiles_ai"]["knowledge_store"]
        freeze_record = tomllib.loads(freeze_raw.decode())["dotfiles_ai"]["knowledge_store"]
    except (KeyError, UnicodeDecodeError, tomllib.TOMLDecodeError, subprocess.CalledProcessError) as error:
        raise RuntimeError("benchmark approval record is unavailable") from error
    if (query_record.get("quality_benchmark_source_revision") != source_revision
            or query_record.get("quality_benchmark_query_digest") != query_digest
            or query_record.get("quality_benchmark_protocol_digest") != protocol_digest
            or freeze_record.get("quality_benchmark_source_revision") != source_revision
            or freeze_record.get("quality_benchmark_query_approval_commit") != query_approval
            or freeze_record.get("quality_benchmark_query_digest") != query_digest
            or freeze_record.get("quality_benchmark_protocol_digest") != protocol_digest
            or freeze_record.get("quality_benchmark_judgment_digest") != judgment_digest):
        raise RuntimeError("benchmark lineage record does not match configured identities")


def command_activate_quality(args, config, project):
    aggregate, aggregate_sha = load_benchmark_aggregate(args.benchmark)
    manifest, manifest_sha = load_benchmark_manifest(args.manifest)
    validate_benchmark_approval(config, project, manifest)
    verified_aggregate = load_benchmark_evidence(args.evidence, manifest, manifest_sha, config)
    if (aggregate["manifest_sha256"] != manifest_sha
            or aggregate["query_count"] != manifest["query_count"]
            or aggregate["strata"] != manifest["strata"]
            or aggregate != verified_aggregate):
        raise RuntimeError("benchmark aggregate does not match verified frozen evidence")
    return activate_quality_policy(args, config, project, aggregate, aggregate_sha,
                                   manifest, manifest_sha, "human")


def command_activate_silver_trial(args, config, project):
    suite, suite_sha = load_silver_suite(args.suite, project)
    aggregate, aggregate_sha = load_silver_aggregate(args.benchmark)
    verified_aggregate = load_silver_evidence(args.evidence, suite, suite_sha, config, args.project)
    if aggregate != verified_aggregate:
        raise RuntimeError("silver aggregate does not match verified frozen evidence")
    return activate_quality_policy(args, config, project, aggregate, aggregate_sha,
                                   aggregate["identities"], suite_sha, "silver")


def activate_quality_policy(args, config, project, aggregate, aggregate_sha, manifest,
                            manifest_sha, evidence_class):
    code_enabled = aggregate["candidates"]["code"]["eligible"]
    reranker_enabled = aggregate["candidates"]["reranker"]["eligible"]
    if not code_enabled and not reranker_enabled:
        raise RuntimeError("no benchmark candidate is eligible")
    code = config.get("code_embedding", {})
    reranker_config = config.get("reranker", {})
    code_space = code.get("space_id") if code_enabled else None
    reranker_manifest = reranker_config.get("manifest_sha256") if reranker_enabled else None
    if code_enabled:
        validate_code_embedding_config(config)
    validate_embedding_config(config)
    if reranker_enabled:
        if not SHA256_RE.fullmatch(str(reranker_manifest or "")):
            raise RuntimeError("reranker manifest identity is unavailable")
        validate_reranker_config(config, reranker_manifest)
    if (manifest["source_profile_sha256"] != project.get("source_profile_sha256")
            or manifest["general_embedding_manifest_sha256"]
            != config.get("embedding", {}).get("manifest_sha256")
            or manifest["code_embedding_manifest_sha256"] != code.get("manifest_sha256")
            or manifest["reranker_manifest_sha256"] != reranker_config.get("manifest_sha256")):
        raise RuntimeError("benchmark manifest runtime identity mismatch")
    with PsqlSession(config) as session:
        session.execute(f"SET dks.project_id={sql_literal(args.project)};")
        for lock_name in (args.project, args.project + ":code", args.project + ":authority"):
            locked = session.execute(
                f"SELECT pg_try_advisory_lock(hashtextextended({sql_literal(lock_name)}, 0));")
            if not locked or locked[-1] != "t":
                raise RuntimeError("quality activation lock unavailable")
        session.execute("BEGIN;")
        revision_rows = session.execute(
            "SELECT active_revision_id FROM dks.projects "
            "WHERE project_id=current_setting('dks.project_id') FOR UPDATE;")
        if revision_rows != [manifest["source_revision"]]:
            raise RuntimeError("benchmark corpus revision is not active")
        projection_rows = session.execute(projection_payload_sql(manifest["source_revision"]))
        if len(projection_rows) != 1:
            raise RuntimeError("quality activation source projection is unavailable")
        source_projection_sha = digest_json(json.loads(projection_rows[0]))
        authority_rows = session.execute(authority_projection_payload_sql())
        if len(authority_rows) != 1:
            raise RuntimeError("quality activation authority projection is unavailable")
        authority = json.loads(authority_rows[0])
        authority_snapshot_sha = digest_json(authority["snapshots"])
        authority_projection_sha = digest_json(authority)
        if (source_projection_sha != manifest["source_projection_sha256"]
                or authority_snapshot_sha != manifest["authority_snapshot_set_sha256"]
                or authority_projection_sha != manifest["authority_projection_sha256"]
                or authority.get("privacy_sequence") != str(manifest["privacy_sequence"])
                or authority.get("privacy_digest") != manifest["privacy_digest"]):
            raise RuntimeError("benchmark authority or projection identity mismatch")
        identity_rows = session.execute(f"""
SELECT json_build_object(
  'revision',p.active_revision_id,
  'source_chunks',(SELECT count(*) FROM dks.revision_chunks rc JOIN dks.knowledge_chunks c USING(project_id,chunk_id)
      WHERE rc.project_id=p.project_id AND rc.revision_id=p.active_revision_id AND c.chunker_version='dks-source-v1'),
  'code_embeddings',(SELECT count(*) FROM dks.code_embeddings e JOIN dks.revision_chunks rc USING(project_id,chunk_id)
      WHERE rc.project_id=p.project_id AND rc.revision_id=p.active_revision_id
        AND e.embedding_space_id={sql_literal(code_space)}),
  'graph_artifact',(SELECT artifact_sha256 FROM dks.graph_imports
      WHERE project_id=p.project_id AND revision_id=p.active_revision_id AND state='active')
)::text FROM dks.projects p WHERE p.project_id=current_setting('dks.project_id');
""")
        if len(identity_rows) != 1:
            raise RuntimeError("quality activation projection is unavailable")
        identity = json.loads(identity_rows[0])
        if (code_enabled and identity["source_chunks"] != identity["code_embeddings"]
                or identity.get("graph_artifact") != manifest["graph_artifact_sha256"]):
            raise RuntimeError("quality activation projection is incomplete")
        activated_at = int(time.time())
        trial_expires_at = (activated_at + SILVER_TRIAL_SECONDS
                            if evidence_class == "silver" else None)
        policy_manifest = digest_json({"aggregate_sha256": aggregate_sha,
                                        "authority_projection_sha256": authority_projection_sha,
                                       "authority_snapshot_set_sha256": authority_snapshot_sha,
                                       "benchmark_sha256": manifest_sha,
                                        "code_embedding_space_id": code_space,
                                        "evidence_class": evidence_class,
                                       "graph_artifact_sha256": identity["graph_artifact"],
                                       "policy_id": "dks-quality-v2",
                                       "privacy_digest": authority["privacy_digest"],
                                       "privacy_sequence": manifest["privacy_sequence"],
                                       "reranker_manifest_sha256": reranker_manifest,
                                        "source_projection_sha256": source_projection_sha,
                                        "source_revision_id": identity["revision"],
                                        "trial_expires_at": trial_expires_at})
        activation_id = digest_json({"manifest_sha256": policy_manifest,
                                     "revision": identity["revision"]})
        session.execute(f"""
UPDATE dks.ranking_policies SET active=false WHERE project_id=current_setting('dks.project_id') AND active;
INSERT INTO dks.ranking_policies(project_id,activation_id,policy_id,manifest_sha256,benchmark_sha256,benchmark_aggregate_sha256,
  source_revision_id,source_projection_sha256,authority_snapshot_set_sha256,authority_projection_sha256,
  privacy_sequence,privacy_digest,
  code_embedding_space_id,graph_artifact_sha256,reranker_manifest_sha256,evidence_class,
  trial_expires_at,active,activated_at)
VALUES (current_setting('dks.project_id'),{sql_literal(activation_id)},'dks-quality-v2',
  {sql_literal(policy_manifest)},{sql_literal(manifest_sha)},{sql_literal(aggregate_sha)},
  {sql_literal(identity['revision'])},{sql_literal(source_projection_sha)},
  {sql_literal(authority_snapshot_sha)},{sql_literal(authority_projection_sha)},
  {manifest['privacy_sequence']},{sql_literal(authority['privacy_digest'])},
  {sql_literal(code_space)},
  {sql_literal(identity['graph_artifact'])},{sql_literal(reranker_manifest)},
  {sql_literal(evidence_class)},{'to_timestamp(' + str(trial_expires_at) + ')' if trial_expires_at else 'NULL'},
  true,to_timestamp({activated_at}));
COMMIT;
""")
    return {"project": args.project, "activation_id": activation_id,
            "benchmark_sha256": manifest_sha, "code": code_enabled,
            "reranker": reranker_enabled, "ranking_policy": "dks-quality-v2",
            "evidence_class": evidence_class, "trial_expires_at": trial_expires_at}


def command_benchmark_aggregate(args, config, project):
    manifest, manifest_sha = load_benchmark_manifest(args.manifest)
    return load_benchmark_evidence(args.evidence, manifest, manifest_sha, config)


def open_benchmark_directory(project, create):
    state_root = Path(project.get("knowledge_state_root", "")).expanduser()
    repository = Path(project.get("repository", "")).expanduser()
    if not state_root.is_absolute() or not repository.is_absolute():
        raise ValueError("benchmark private root is unavailable")
    try:
        state_root_resolved = state_root.resolve(strict=True)
        repository_resolved = repository.resolve(strict=True)
    except OSError as error:
        raise ValueError("benchmark private root is unavailable") from error
    private_resolved = state_root_resolved / "knowledge" / "private"
    if (private_resolved == repository_resolved
            or repository_resolved in private_resolved.parents
            or private_resolved in repository_resolved.parents):
        raise ValueError("benchmark private root is unsafe")
    directory_flags = os.O_RDONLY | os.O_DIRECTORY
    if hasattr(os, "O_CLOEXEC"):
        directory_flags |= os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        directory_flags |= os.O_NOFOLLOW
    descriptor = None
    try:
        expected = state_root.lstat()
        descriptor = os.open(state_root, directory_flags)
        actual = os.fstat(descriptor)
        if (expected.st_dev, expected.st_ino) != (actual.st_dev, actual.st_ino):
            raise OSError("state root changed")
        for name in ("knowledge", "private", "benchmarks", "DKS-005"):
            created = False
            if create and name in {"benchmarks", "DKS-005"}:
                try:
                    os.mkdir(name, 0o700, dir_fd=descriptor)
                    created = True
                except FileExistsError:
                    pass
            if created:
                os.chmod(name, 0o700, dir_fd=descriptor, follow_symlinks=False)
                os.fsync(descriptor)
            child = os.open(name, directory_flags, dir_fd=descriptor)
            os.close(descriptor)
            descriptor = child
            details = os.fstat(descriptor)
            if (not stat.S_ISDIR(details.st_mode) or details.st_uid != os.getuid()
                    or name in {"private", "benchmarks", "DKS-005"}
                    and stat.S_IMODE(details.st_mode) != 0o700):
                raise OSError("unsafe directory")
        return descriptor
    except OSError as error:
        if descriptor is not None:
            os.close(descriptor)
        raise ValueError("benchmark private root is unsafe") from error


def command_benchmark_author_init(args, config, project):
    directory = open_benchmark_directory(project, create=True)
    temporary = f".queries.tsv.{secrets.token_hex(8)}.tmp"
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    if hasattr(os, "O_CLOEXEC"):
        flags |= os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    installed = False
    descriptor = None
    try:
        descriptor = os.open(temporary, flags, 0o600, dir_fd=directory)
        try:
            os.fchmod(descriptor, 0o600)
            with os.fdopen(descriptor, "w", encoding="utf-8", newline="") as handle:
                descriptor = None
                writer = csv.writer(handle, delimiter="\t", lineterminator="\n")
                writer.writerow(("query_id", "stratum", "text"))
                for stratum in BENCHMARK_QUERY_STRATA:
                    for index in range(1, 21):
                        writer.writerow((f"{stratum}-{index:03d}", stratum, ""))
                handle.flush()
                os.fsync(handle.fileno())
            os.link(temporary, "queries.tsv", src_dir_fd=directory, dst_dir_fd=directory,
                    follow_symlinks=False)
            installed = True
            os.fsync(directory)
        finally:
            if descriptor is not None:
                os.close(descriptor)
            try:
                os.unlink(temporary, dir_fd=directory)
            except FileNotFoundError:
                pass
    except FileExistsError as error:
        raise ValueError("benchmark workbook already exists") from error
    except OSError as error:
        if installed:
            raise ValueError("benchmark workbook installed but durability is unconfirmed") from error
        raise ValueError("benchmark workbook could not be created") from error
    finally:
        os.close(directory)
    if not installed:
        raise ValueError("benchmark workbook could not be created")
    return {"schema_version": 1, "project": args.project, "benchmark_id": "DKS-005",
            "workbook": "DKS-005/queries.tsv", "query_count": 100,
            "strata": {name: 20 for name in BENCHMARK_QUERY_STRATA}}


def command_benchmark_author_validate(args, config, project):
    directory = open_benchmark_directory(project, create=False)
    flags = os.O_RDONLY
    if hasattr(os, "O_CLOEXEC"):
        flags |= os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    descriptor = None
    try:
        descriptor = os.open("queries.tsv", flags, dir_fd=directory)
        details = os.fstat(descriptor)
        if (not stat.S_ISREG(details.st_mode) or details.st_uid != os.getuid()
                or stat.S_IMODE(details.st_mode) != 0o600 or details.st_size > 1024 * 1024):
            raise OSError("unsafe workbook")
        raw = b""
        while len(raw) <= 1024 * 1024:
            chunk = os.read(descriptor, min(65536, 1024 * 1024 + 1 - len(raw)))
            if not chunk:
                break
            raw += chunk
        after = os.fstat(descriptor)
        identity = lambda value: (value.st_dev, value.st_ino, value.st_size,
                                  value.st_mtime_ns, value.st_ctime_ns)
        if len(raw) > 1024 * 1024 or len(raw) != details.st_size or identity(details) != identity(after):
            raise OSError("workbook changed")
        rows = list(csv.reader(io.StringIO(raw.decode("utf-8"), newline=""),
                               delimiter="\t", strict=True))
    except (OSError, UnicodeError, csv.Error) as error:
        raise ValueError("unsafe benchmark workbook") from error
    finally:
        if descriptor is not None:
            os.close(descriptor)
        os.close(directory)
    if not rows or rows[0] != ["query_id", "stratum", "text"] or len(rows) != 101:
        raise ValueError("benchmark workbook structure is invalid")
    identity = []
    for offset, stratum in enumerate(BENCHMARK_QUERY_STRATA):
        for index in range(1, 21):
            row = rows[1 + offset * 20 + index - 1]
            expected = f"{stratum}-{index:03d}"
            if (len(row) != 3 or row[:2] != [expected, stratum]
                    or not row[2] or row[2] != row[2].strip()
                    or any(character in row[2] for character in "\t\r\n\x00")):
                raise ValueError("benchmark workbook row is invalid")
            identity.append(row)
    return {"schema_version": 1, "project": args.project, "benchmark_id": "DKS-005",
            "source_revision": DKS_005_SOURCE_REVISION, "query_count": len(identity),
            "strata": {name: 20 for name in BENCHMARK_QUERY_STRATA},
            "query_digest": digest_json(identity)}


def command_rollback_quality(args, config, project):
    with PsqlSession(config) as session:
        session.execute(f"SET dks.project_id={sql_literal(args.project)};")
        for lock_name in (args.project, args.project + ":code", args.project + ":authority"):
            locked = session.execute(
                f"SELECT pg_try_advisory_lock(hashtextextended({sql_literal(lock_name)}, 0));")
            if not locked or locked[-1] != "t":
                raise RuntimeError("quality rollback lock unavailable")
        session.execute("""
BEGIN;
SELECT activation_id FROM dks.ranking_policies
WHERE project_id=current_setting('dks.project_id') AND active FOR UPDATE;
UPDATE dks.ranking_policies SET active=false WHERE project_id=current_setting('dks.project_id') AND active;
UPDATE dks.ranking_policies SET active=true,activated_at=now()
WHERE project_id=current_setting('dks.project_id') AND activation_id='dks-rrf-v1';
DO $rollback$ BEGIN IF NOT EXISTS (SELECT 1 FROM dks.ranking_policies
  WHERE project_id=current_setting('dks.project_id') AND activation_id='dks-rrf-v1' AND active)
  THEN RAISE EXCEPTION 'rollback policy unavailable'; END IF; END $rollback$;
COMMIT;
""")
    return {"project": args.project, "ranking_policy": "dks-rrf-v1", "state": "active"}


def command_materialize(args, config, project):
    destination = Path(args.output).expanduser()
    if not destination.is_absolute() or destination.exists():
        raise ValueError("materialized corpus output must be a new absolute path")
    parent = destination.parent.resolve(strict=True)
    repository = Path(project.get("repository", "")).expanduser()
    documents = git_documents(repository, args.commit, project.get("remote", ""),
                              load_source_profile(project))
    stage = Path(tempfile.mkdtemp(prefix=f".{destination.name}.part.", dir=parent))
    try:
        manifest = []
        for document in documents:
            path = stage / document["path"]
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_bytes(document["data"])
            path.chmod(0o444)
            manifest.append({"path": document["path"], "blob_id": document["blob_id"],
                             "content_sha256": hashlib.sha256(document["data"]).hexdigest()})
        identity = {"schema_version": 1, "project": args.project, "commit": args.commit,
                    "source_profile_sha256": project.get("source_profile_sha256"),
                    "documents": manifest}
        (stage / "dks-corpus.json").write_text(canonical_json(identity) + "\n")
        (stage / "dks-corpus.json").chmod(0o444)
        os.replace(stage, destination)
    finally:
        if stage.exists():
            shutil.rmtree(stage)
    return {"project": args.project, "commit": args.commit, "output": str(destination),
            "documents": len(documents),
            "manifest_sha256": hashlib.sha256((canonical_json(identity) + "\n").encode()).hexdigest()}


def command_reconcile(args, config, project):
    settings = reconcile_settings(config, project)
    project = {**project, "project_id": args.project}
    if not settings["enabled"] and not getattr(args, "force", False):
        return {"schema_version": 1, "project": args.project, "state": "disabled", "stages": []}
    handle = open_reconcile_lock(project)
    try:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return {"schema_version": 1, "project": args.project, "state": "busy", "stages": []}
        old_handler = signal.getsignal(signal.SIGALRM)
        signal.signal(signal.SIGALRM, lambda *_: (_ for _ in ()).throw(TimeoutError()))
        signal.alarm(settings["timeout_seconds"])
        started = int(time.time())
        try:
            commit = resolve_reconcile_commit(project, settings, refresh=True)
            stages = []
            ensure_quality_policy(config, args.project)
            status = command_status(args, config, project)
            embedding = config.get("embedding", {})
            code = config.get("code_embedding", {})
            if git_is_fresh(status, config, project, commit):
                stages.append({"name": "git", "state": "unchanged"})
            else:
                command_sync(argparse.Namespace(project=args.project, commit=commit), config, project)
                stages.append({"name": "git", "state": "updated"})
            status = command_status(args, config, project)
            if (status.get("code_chunks") == status.get("code_embeddings")
                    and status.get("code_identity") == {"embedding_space": code.get("space_id"),
                                                        "manifest_sha256": code.get("manifest_sha256")}):
                stages.append({"name": "code", "state": "unchanged"})
            else:
                command_sync_code(argparse.Namespace(project=args.project, commit=commit), config, project)
                stages.append({"name": "code", "state": "updated"})
            if graph_is_fresh(status, config, args.project, project, commit):
                stages.append({"name": "graphify", "state": "unchanged"})
            else:
                with tempfile.TemporaryDirectory(prefix="dks-reconcile-") as temporary:
                    corpus = Path(temporary) / "corpus"
                    command_materialize(argparse.Namespace(
                        project=args.project, commit=commit, output=str(corpus)), config, project)
                    command_import_graph(argparse.Namespace(
                        project=args.project, commit=commit, version=GRAPHIFY_CONFIG["version"],
                        corpus_manifest=str(corpus / "dks-corpus.json")), config, project)
                stages.append({"name": "graphify", "state": "updated"})
            status = command_status(args, config, project)
            export = parse_knowledge_export(lifecycle_output(config, project, "knowledge-export"))
            if authority_is_fresh(status, export, embedding.get("space_id")):
                stages.append({"name": "authority", "state": "unchanged"})
            else:
                command_sync_evidence(argparse.Namespace(project=args.project), config, project)
                stages.append({"name": "authority", "state": "updated"})
            return {"schema_version": 1, "project": args.project, "state": "active",
                    "revision": commit, "started_at": started, "finished_at": int(time.time()),
                    "stages": stages}
        except TimeoutError as error:
            raise RuntimeError("reconcile timed out") from error
        finally:
            signal.alarm(0)
            signal.signal(signal.SIGALRM, old_handler)
    finally:
        handle.close()


def exact_commit(value: str):
    if not COMMIT_RE.fullmatch(value):
        raise argparse.ArgumentTypeError("commit must be lowercase 40-hex")
    return value


def parser():
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--config", default=os.environ.get(
        "DKS_CONFIG", "~/.config/dotfiles-ai/knowledge/projects.json"))
    common.add_argument("--project", required=True)
    root = argparse.ArgumentParser(prog="dksctl")
    commands = root.add_subparsers(dest="command", required=True)
    sync = commands.add_parser("sync", parents=[common])
    sync.add_argument("--commit", required=True)
    rebuild = commands.add_parser("rebuild", parents=[common])
    rebuild.add_argument("--commit", required=True)
    code = commands.add_parser("sync-code", parents=[common])
    code.add_argument("--commit", required=True, type=exact_commit)
    commands.add_parser("sync-evidence", parents=[common])
    graph = commands.add_parser("import-graph", parents=[common])
    graph.add_argument("--commit", required=True, type=exact_commit)
    graph.add_argument("--version", required=True)
    graph.add_argument("--corpus-manifest", required=True)
    materialize = commands.add_parser("materialize", parents=[common])
    materialize.add_argument("--commit", required=True, type=exact_commit)
    materialize.add_argument("--output", required=True)
    activate = commands.add_parser("activate-quality", parents=[common])
    activate.add_argument("--benchmark", required=True)
    activate.add_argument("--manifest", required=True)
    activate.add_argument("--evidence", required=True)
    silver_activate = commands.add_parser("activate-silver-trial", parents=[common])
    silver_activate.add_argument("--benchmark", required=True)
    silver_activate.add_argument("--suite", required=True)
    silver_activate.add_argument("--evidence", required=True)
    benchmark = commands.add_parser("benchmark-aggregate", parents=[common])
    benchmark.add_argument("--manifest", required=True)
    benchmark.add_argument("--evidence", required=True)
    silver = commands.add_parser("benchmark-silver-run", parents=[common])
    silver.add_argument("--suite", required=True)
    silver.add_argument("--evidence", required=True)
    silver.add_argument("--aggregate", required=True)
    commands.add_parser("benchmark-author-init", parents=[common])
    commands.add_parser("benchmark-author-validate", parents=[common])
    commands.add_parser("rollback-quality", parents=[common])
    query = commands.add_parser("query", parents=[common])
    query.add_argument("--text", required=True)
    query.add_argument("--commit", type=exact_commit)
    query.add_argument("--limit", type=int, choices=range(1, 21))
    query_core = commands.add_parser("_query-core", parents=[common], help=argparse.SUPPRESS)
    query_core.add_argument("--text", required=True)
    query_core.add_argument("--commit", type=exact_commit)
    query_core.add_argument("--limit", type=int, choices=range(1, 21), default=10)
    commands.add_parser("status", parents=[common])
    commands.add_parser("doctor", parents=[common])
    reconcile = commands.add_parser("reconcile", parents=[common])
    reconcile.add_argument("--force", action="store_true")
    return root


def main(argv=None):
    args = parser().parse_args(argv)
    try:
        config = load_config(args.config)
        project = selected_project(config, args.project)
        if args.command == "sync":
            result = command_sync(args, config, project)
        elif args.command == "sync-evidence":
            result = command_sync_evidence(args, config, project)
        elif args.command == "sync-code":
            result = command_sync_code(args, config, project)
        elif args.command == "import-graph":
            result = command_import_graph(args, config, project)
        elif args.command == "materialize":
            result = command_materialize(args, config, project)
        elif args.command == "activate-quality":
            result = command_activate_quality(args, config, project)
        elif args.command == "activate-silver-trial":
            result = command_activate_silver_trial(args, config, project)
        elif args.command == "benchmark-aggregate":
            result = command_benchmark_aggregate(args, config, project)
        elif args.command == "benchmark-silver-run":
            result = command_benchmark_silver_run(args, config, project)
        elif args.command == "benchmark-author-init":
            result = command_benchmark_author_init(args, config, project)
        elif args.command == "benchmark-author-validate":
            result = command_benchmark_author_validate(args, config, project)
        elif args.command == "rollback-quality":
            result = command_rollback_quality(args, config, project)
        elif args.command == "rebuild":
            result = command_rebuild(args, config, project)
        elif args.command == "query":
            result = command_guarded_query(args, config, project)
        elif args.command == "_query-core":
            result = command_query(args, config, project)
        elif args.command == "doctor":
            result = command_doctor(args, config, project)
        elif args.command == "reconcile":
            result = command_reconcile(args, config, project)
        else:
            result = command_status(args, config, project)
        print(canonical_json(result))
        if args.command == "doctor" and not result["healthy"]:
            return 1
    except (ValueError, RuntimeError, subprocess.SubprocessError) as error:
        print(f"dksctl: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
