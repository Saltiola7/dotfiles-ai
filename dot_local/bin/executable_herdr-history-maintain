#!/usr/bin/env python3
"""Archive Herdr pane history locally and prune snapshots older than 30 days."""

import json
import os
import re
import shutil
import stat
import tempfile
from datetime import datetime, timedelta, timezone
from pathlib import Path


def main():
    source = Path(os.environ.get("HERDR_HISTORY_SOURCE", "~/.config/herdr/session-history.json")).expanduser()
    archive = Path(os.environ.get(
        "HERDR_HISTORY_ARCHIVE", "~/.local/state/dotfiles-ai/herdr-history"
    )).expanduser()
    current = datetime.fromisoformat(os.environ.get("HERDR_HISTORY_NOW", datetime.now(timezone.utc).isoformat()))
    if current.tzinfo is None:
        raise RuntimeError("HERDR_HISTORY_NOW must include a timezone")
    if source.is_symlink():
        raise RuntimeError("Herdr history source is unsafe")
    if not source.exists():
        print(json.dumps({"archived": False, "pruned": 0}, sort_keys=True))
        return
    details = source.lstat()
    if not stat.S_ISREG(details.st_mode) or details.st_uid != os.getuid():
        raise RuntimeError("Herdr history source is unsafe")
    if archive.exists() or archive.is_symlink():
        details = archive.lstat()
        if not stat.S_ISDIR(details.st_mode) or details.st_uid != os.getuid():
            raise RuntimeError("Herdr history archive is unsafe")
    else:
        archive.mkdir(parents=True, mode=0o700)
    archive.chmod(0o700)
    details = archive.lstat()
    if not stat.S_ISDIR(details.st_mode) or details.st_uid != os.getuid() or details.st_mode & 0o077:
        raise RuntimeError("Herdr history archive is unsafe")
    destination = archive / f"{current.astimezone(timezone.utc):%Y-%m-%d}.json"
    descriptor, temporary = tempfile.mkstemp(dir=archive)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "wb") as outgoing:
            source_descriptor = os.open(source, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
            source_details = os.fstat(source_descriptor)
            if not stat.S_ISREG(source_details.st_mode) or source_details.st_uid != os.getuid():
                os.close(source_descriptor)
                raise RuntimeError("Herdr history source is unsafe")
            with os.fdopen(source_descriptor, "rb") as incoming:
                shutil.copyfileobj(incoming, outgoing)
            outgoing.flush()
            os.fsync(outgoing.fileno())
        os.replace(temporary, destination)
    finally:
        Path(temporary).unlink(missing_ok=True)
    cutoff = current.astimezone(timezone.utc).date() - timedelta(days=30)
    pruned = 0
    for candidate in archive.iterdir():
        if candidate == destination:
            continue
        match = re.fullmatch(r"(\d{4}-\d{2}-\d{2})\.json", candidate.name)
        details = candidate.lstat()
        if not match or not stat.S_ISREG(details.st_mode) or details.st_uid != os.getuid():
            raise RuntimeError("Herdr history archive entry is unsafe")
        if datetime.strptime(match.group(1), "%Y-%m-%d").date() < cutoff:
            candidate.unlink()
            pruned += 1
    print(json.dumps({"archived": True, "path": destination.name, "pruned": pruned}, sort_keys=True))


if __name__ == "__main__":
    main()
