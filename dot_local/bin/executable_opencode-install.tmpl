#!/bin/bash
set -euo pipefail

{{ if and (eq .chezmoi.os "darwin") (eq .chezmoi.arch "arm64") -}}
{{ if .dotfiles_ai.state.root -}}
export DOTFILES_AI_STATE_ROOT={{ .dotfiles_ai.state.root | quote }}
export XDG_DATA_HOME={{ printf "%s/xdg/data" .dotfiles_ai.state.root | quote }}
export XDG_STATE_HOME={{ printf "%s/xdg/state" .dotfiles_ai.state.root | quote }}
[[ -f "$DOTFILES_AI_STATE_ROOT/.dotfiles-ai-state" ]] || {
    echo "centralized state root is unavailable" >&2
    exit 75
}
{{ end -}}
target="$HOME/.opencode/bin/opencode"
check_target() {
    python3 - "$target" <<'PY'
import os, pathlib, stat, sys
p = pathlib.Path(sys.argv[1])
for path in (p.parent.parent, p.parent, p):
    if not os.path.lexists(path):
        continue
    s = path.lstat()
    kind = stat.S_ISREG if path == p else stat.S_ISDIR
    if not kind(s.st_mode) or s.st_uid != os.getuid() or s.st_mode & 0o022:
        sys.exit("native OpenCode target is unsafe")
PY
}
check_target
if [[ ! -e $target ]]; then
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT
    curl --proto '=https' --proto-redir '=https' -fsSL --retry 3 --connect-timeout 10 --max-time 180 \
        https://opencode.ai/v2/install -o "$tmp/install"
    # A caller's VERSION must not pin or downgrade the missing-install bootstrap.
    env -u VERSION bash "$tmp/install" --no-modify-path
    check_target
fi
[[ -x $target && $("$target" --version) =~ ^opencode\ v2\.[0-9]+\.[0-9]+$ ]] || {
    echo "native OpenCode is unavailable or invalid; inspect the installation before retrying" >&2
    exit 75
}
exit 0
{{ end -}}

{{ if not (or .dotfiles_ai.remote_user_environment.enabled .dotfiles_ai.linux_workstation.enabled) -}}
exit 0
{{ end -}}
[[ $(uname -s) == Linux && $(uname -m) == x86_64 ]] || {
    echo "remote user environment requires Linux x86_64" >&2
    exit 1
}

version={{ .dotfiles_ai.opencode.version | quote }}
url={{ .dotfiles_ai.opencode.linux_amd64_asset_url | quote }}
sha256={{ .dotfiles_ai.opencode.linux_amd64_asset_sha256 | quote }}
directory="$HOME/.local/libexec/dotfiles-ai"
target="$directory/opencode"
lock="$HOME/.local/state/dotfiles-ai/opencode-package/release-lock.json"
if [[ -e $lock || -L $lock ]]; then
    [[ -f $lock && ! -L $lock ]] || { echo "managed OpenCode release lock is unsafe" >&2; exit 1; }
    exit 0
fi
tmp=$(mktemp -d)
trap 'rm -rf "$tmp" "$target.new"' EXIT
curl -fsSL --retry 3 --retry-all-errors --connect-timeout 10 --max-time 180 "$url" -o "$tmp/opencode.tar.gz"
printf '%s  %s\n' "$sha256" "$tmp/opencode.tar.gz" | sha256sum -c -
tar -xzf "$tmp/opencode.tar.gz" -C "$tmp" opencode
[[ -f $tmp/opencode && -x $tmp/opencode && ! -L $tmp/opencode ]] || {
    echo "OpenCode release archive is invalid" >&2
    exit 1
}
install -d -m 0700 "$directory"
install -m 0755 "$tmp/opencode" "$target.new"
[[ $($target.new --version) == "$version" ]] || { echo "managed OpenCode version mismatch" >&2; exit 1; }
mv -f "$target.new" "$target"
