#!/bin/sh
set -eu
umask 077

workspace={{ .dotfiles_ai.pm_kernel.workspace | quote }}
state_root={{ .dotfiles_ai.state.root | quote }}
output_dir="$state_root/dbsctr/knowledge/postgres"
test -d "$state_root" || { echo "pm-postgres-baseline: state root unavailable" >&2; exit 1; }
install -d -m 0700 "$output_dir"

capture() {
    image=$(sandbox-vm shell "$workspace" -- podman inspect pm-postgres --format {{ "{{.ImageName}}|{{.Image}}|{{ index .Config.Labels \"dev.dotfiles-ai.postgres.base\" }}" | quote }})
    facts=$(sandbox-vm shell "$workspace" -- podman exec pm-postgres psql -X -At -F '|' -U pm_kernel -d pm_kernel -c \
        "SELECT current_setting('server_version'), (SELECT max(version) FROM context.schema_migrations), (SELECT count(*) FROM context.tickets), (SELECT count(*) FROM context.jira_publications), (SELECT count(*) FROM context.source_envelopes)")
    data_directory=$(sandbox-vm shell "$workspace" -- podman exec pm-postgres psql -X -At -U pm_kernel -d pm_kernel -c 'SHOW data_directory')
    pg_version=$(sandbox-vm shell "$workspace" -- podman exec pm-postgres sh -c "cat '$data_directory/PG_VERSION'")
    python3 - "$image" "$facts" "$pg_version" <<'PY'
import json, sys
image, facts, pg_version = sys.argv[1:]
image_name, image_id, labeled_base = image.split("|", 2)
expected_base = "docker.io/library/postgres:19beta3@sha256:bfa69ac147240b42c3fc9005d8d173a8b0f07949c7d5c5bbc8985c17b011ec40"
accepted_names = {expected_base, expected_base.replace(":19beta3@", "@")}
if image_name not in accepted_names and labeled_base != expected_base:
    raise SystemExit("pm-postgres-baseline: running image is not same-base compatible")
version, migration, tickets, publications, envelopes = facts.split("|")
print(json.dumps({
    "image": image_name + "|" + image_id,
    "base_image": expected_base,
    "server_version": version,
    "pg_version": pg_version,
    "schema_migration": int(migration),
    "tickets": int(tickets),
    "jira_publications": int(publications),
    "source_envelopes": int(envelopes),
}, sort_keys=True, separators=(",", ":")))
PY
}

if test "${1:-}" = --compare; then
    test -f "${2:-}" || { echo "pm-postgres-baseline: comparison baseline unavailable" >&2; exit 1; }
    current=$(capture)
    python3 - "$2" "$current" <<'PY'
import json, sys
before = json.load(open(sys.argv[1]))
after = json.loads(sys.argv[2])
keys = ("server_version", "pg_version", "schema_migration", "tickets", "jira_publications", "source_envelopes")
if any(before[key] != after[key] for key in keys):
    raise SystemExit("pm-postgres-baseline: PM state changed during image migration")
print(json.dumps({"before_image": before["image"], "after_image": after["image"], "pm_state_preserved": True},
                 sort_keys=True, separators=(",", ":")))
PY
    exit
fi

stamp=$(date -u +%Y%m%dT%H%M%SZ)
final="$output_dir/pm-before-pgvector-$stamp.json"
tmp=$(mktemp "$output_dir/.pm-baseline.part.XXXXXX")
trap 'rm -f "$tmp"' EXIT HUP INT TERM
capture >"$tmp"
chmod 0600 "$tmp"
mv "$tmp" "$final"
trap - EXIT HUP INT TERM
printf '%s\n' "$final"
