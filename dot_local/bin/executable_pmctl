#!/usr/bin/env python3
import argparse
import fcntl
import hashlib
import json
import os
import re
import secrets
import shutil
import subprocess
import sys
import tempfile
from datetime import date, datetime, timezone
from pathlib import Path

STATES = {"intake", "refining", "ready", "committed", "in_progress", "blocked", "review", "done", "cancelled"}
POINTS = {None, 0.5, 1, 2, 3, 5, 8}
KINDS = {"story", "bug", "task", "spike", "epic"}
ENVELOPE_SOURCES = {"cycle_record", "review_report", "history_capture", "history_telemetry",
                    "benchmark", "provider_evaluation", "phase_profile", "execution_dag", "improvement"}
ENVELOPE_PAYLOAD_FIELDS = {
    "cycle_record": {"cycle_id", "context", "state", "risk", "delivery_intent", "method_revision", "schema_version", "gates", "metrics", "created_at", "completed_at"},
    "review_report": {"report_id", "decision", "findings", "scorecards", "trends", "proposals", "caveats", "created_at"},
    "history_capture": {"capture_id", "manifest_digest", "members", "metrics", "created_at"},
    "history_telemetry": {"cycle_id", "context", "state", "risk", "metrics", "availability", "created_at"},
    "benchmark": {"benchmark_id", "result", "metrics", "availability", "created_at"},
    "provider_evaluation": {"report_id", "manifest_digest", "rubric", "harness_identity", "members", "findings", "recommendations", "created_at"},
    "phase_profile": {"cycle_id", "phase_profile", "availability", "created_at"},
    "execution_dag": {"cycle_id", "nodes", "result", "created_at"},
    "improvement": {"worker_id", "opportunity_id", "priority", "state", "summary", "created_at", "completed_at"},
}
ENVELOPE_REQUIRED_FIELDS = {
    "cycle_record": {"cycle_id": str, "context": str, "state": str, "risk": str, "delivery_intent": str, "method_revision": str, "schema_version": int, "gates": dict},
    "review_report": {"report_id": str, "decision": str, "findings": list},
    "history_capture": {"capture_id": str, "manifest_digest": str, "members": list},
    "history_telemetry": {"cycle_id": str, "metrics": dict, "availability": str},
    "benchmark": {"benchmark_id": str, "result": str, "metrics": dict},
    "provider_evaluation": {"report_id": str, "manifest_digest": str, "rubric": dict, "members": list, "findings": list, "recommendations": list},
    "phase_profile": {"cycle_id": str, "phase_profile": dict, "availability": str},
    "execution_dag": {"cycle_id": str, "nodes": list, "result": str},
    "improvement": {"worker_id": str, "opportunity_id": str, "priority": str, "state": str, "summary": str},
}
ENVELOPE_FIELD_TYPES = {
    "cycle_id": str, "context": str, "state": str, "risk": str, "delivery_intent": str,
    "method_revision": str, "schema_version": int, "gates": dict, "metrics": dict,
    "created_at": str, "completed_at": str, "report_id": str, "decision": str,
    "findings": list, "scorecards": list, "trends": list, "proposals": list, "caveats": list,
    "capture_id": str, "manifest_digest": str, "members": list, "availability": str,
    "benchmark_id": str, "result": str, "rubric": dict, "harness_identity": dict,
    "recommendations": list, "phase_profile": dict, "nodes": list, "worker_id": str,
    "opportunity_id": str, "priority": str, "summary": str,
}
GATE_NAMES = {"domain", "behavior", "spec", "contract", "test_driven_implementation", "refactor",
              "review_integrate", "release", "deploy", "operate", "maintain_retire"}
METRIC_NAMES = {"elapsed_ms", "gate_failure_count", "gate_reopen_count", "remediation_round_count",
                "tool_call_count", "tool_error_count", "token_total", "cost_total", "session_count",
                "member_count", "source_count", "page_count"}
REQUIRED = {
    "schema_version", "id", "slug", "context", "title", "kind", "state", "priority",
    "points", "depends_on", "relations", "owns", "reads", "parallel_safe", "validation",
    "created", "updated", "completed", "commits", "jira_publications", "migration",
}
ACTIVE_COLUMNS = ("id", "title", "priority", "status", "depends_on", "owns", "reads",
                  "parallel_safe", "reason", "effort", "validation")
COMPLETED_COLUMNS = ("id", "outcome", "completed", "commit")
TICKET_ROOT = Path("data/backlog/tickets")


def fail(message):
    raise RuntimeError(message)


def scalar(value):
    value = value.strip()
    if value in {"null", "~"}:
        return None
    if value in {"true", "false"}:
        return value == "true"
    if value == "[]":
        return []
    if value.startswith(('"', "'")):
        try:
            return json.loads(value) if value.startswith('"') else value[1:-1].replace("''", "'")
        except (ValueError, json.JSONDecodeError) as error:
            fail(f"invalid quoted scalar: {error}")
    if re.fullmatch(r"-?(?:0|[1-9]\d*)(?:\.\d+)?", value):
        return float(value) if "." in value else int(value)
    if not value or value.startswith(("{", "[", "&", "*", "!", "|", ">")):
        fail("unsupported YAML scalar")
    return value


def frontmatter(text):
    lines = text.splitlines()
    if not lines or lines[0] != "---":
        fail("ticket frontmatter is missing")
    try:
        end = lines.index("---", 1)
    except ValueError:
        fail("ticket frontmatter is unterminated")
    values, index = {}, 1
    while index < end:
        line = lines[index]
        if not line or line.startswith((" ", "\t", "#")) or ":" not in line:
            fail("unsupported YAML structure")
        key, raw = line.split(":", 1)
        if not re.fullmatch(r"[a-z][a-z0-9_]*", key) or key in values:
            fail("duplicate or invalid YAML key")
        raw = raw.strip()
        if raw:
            values[key] = scalar(raw)
            index += 1
            continue
        items = []
        index += 1
        while index < end and lines[index].startswith("  - "):
            items.append(scalar(lines[index][4:]))
            index += 1
        if not items:
            fail("empty block collection is unsupported; use []")
        values[key] = items
    return values, "\n".join(lines[end + 1:]).lstrip("\n")


def ticket_paths(root):
    tickets = root / TICKET_ROOT
    if not tickets.exists():
        return []
    if tickets.is_symlink():
        fail("ticket root cannot be a symlink")
    paths = []
    for context in tickets.glob("context=*"):
        if context.is_symlink():
            fail("ticket path cannot be a symlink")
        if not context.is_dir():
            continue
        for path in context.glob("*.md"):
            if path.is_symlink():
                fail("ticket path cannot be a symlink")
            if path.is_file() and path.resolve().is_relative_to(tickets.resolve()):
                paths.append(path)
    return sorted(paths)


def validate_ticket(root, path):
    relative = path.relative_to(root).as_posix()
    try:
        values, body = frontmatter(path.read_text())
    except (OSError, UnicodeError, RuntimeError) as error:
        return None, [{"code": "invalid_ticket_yaml", "path": relative, "detail": str(error)}]
    findings = []
    if set(values) != REQUIRED:
        findings.append({"code": "invalid_ticket_schema", "path": relative})
    context_dir = path.parent.name
    context = context_dir.removeprefix("context=") if context_dir.startswith("context=") else ""
    expected = f"{values.get('id', '')}-{values.get('slug', '')}.md"
    if values.get("context") != context or path.name != expected:
        findings.append({"code": "invalid_ticket_identity", "path": relative})
    if values.get("schema_version") != 1 or not re.fullmatch(r"[A-Za-z][A-Za-z0-9]*(?:[.-][A-Za-z0-9]+)*", str(values.get("id", ""))):
        findings.append({"code": "invalid_ticket_identity", "path": relative})
    if not re.fullmatch(r"[a-z0-9]+(?:-[a-z0-9]+)*", str(values.get("slug", ""))):
        findings.append({"code": "invalid_ticket_identity", "path": relative})
    if values.get("state") not in STATES:
        findings.append({"code": "invalid_ticket_state", "path": relative})
    if values.get("points") not in POINTS:
        findings.append({"code": "invalid_ticket_points", "path": relative})
    for field in ("depends_on", "relations", "owns", "reads", "validation", "commits", "jira_publications"):
        if not isinstance(values.get(field), list) or any(not isinstance(item, str) for item in values.get(field, [])):
            findings.append({"code": "invalid_ticket_schema", "path": relative, "field": field})
    if (type(values.get("parallel_safe")) is not bool or not values.get("title") or not values.get("priority")
            or values.get("kind") not in KINDS or values.get("migration") is not None
            and not isinstance(values.get("migration"), str)):
        findings.append({"code": "invalid_ticket_schema", "path": relative})
    for field in ("created", "updated"):
        try:
            date.fromisoformat(str(values.get(field)))
        except ValueError:
            findings.append({"code": "invalid_ticket_date", "path": relative, "field": field})
    if values.get("completed") is not None:
        try:
            date.fromisoformat(str(values["completed"]))
        except ValueError:
            findings.append({"code": "invalid_ticket_date", "path": relative, "field": "completed"})
    if values.get("state") == "done" and (not values.get("completed") or not values.get("commits")):
        findings.append({"code": "invalid_ticket_completion", "path": relative})
    if values.get("state") != "done" and values.get("completed") is not None:
        findings.append({"code": "invalid_ticket_completion", "path": relative})
    for heading in ("Outcome", "Context", "Scope", "Acceptance Criteria", "Evidence", "Risks", "Review"):
        if f"## {heading}" not in body:
            findings.append({"code": "invalid_ticket_body", "path": relative, "section": heading})
    return {**values, "body": body}, findings


def inventory(root):
    records, findings, identifiers = [], [], {}
    for path in ticket_paths(root):
        values, current = validate_ticket(root, path)
        findings.extend(current)
        if values is None:
            continue
        relative = path.relative_to(root).as_posix()
        records.append({**values, "path": relative})
        identifiers.setdefault(values.get("id"), []).append(relative)
    ids = set(identifiers)
    for item_id, paths in identifiers.items():
        if len(paths) > 1:
            findings.extend({"code": "duplicate_ticket_id", "path": path, "id": item_id} for path in paths)
    for record in records:
        for dependency in record.get("depends_on", []):
            if dependency == record["id"] or dependency not in ids:
                findings.append({"code": "invalid_ticket_dependency", "path": record["path"], "id": dependency})
        for relation in record.get("relations", []):
            match = re.fullmatch(r"([a-z][a-z0-9_]*):([A-Za-z][A-Za-z0-9.-]*)", relation)
            if not match or match.group(2) == record["id"] or match.group(2) not in ids:
                findings.append({"code": "invalid_ticket_relation", "path": record["path"], "relation": relation})
    graph = {record["id"]: record.get("depends_on", []) for record in records}
    visiting, visited = set(), set()
    def walk(item_id):
        if item_id in visiting:
            return True
        if item_id in visited:
            return False
        visiting.add(item_id)
        cycle = any(dependency in graph and walk(dependency) for dependency in graph[item_id])
        visiting.remove(item_id)
        visited.add(item_id)
        return cycle
    for record in records:
        if walk(record["id"]):
            findings.append({"code": "cyclic_ticket_dependency", "path": record["path"]})
    findings.sort(key=lambda item: (item["path"], item["code"], item.get("field", "")))
    records.sort(key=lambda item: (item["context"], item["id"]))
    return records, findings


def cells(line):
    stripped = line.strip()
    if not stripped.startswith("|") or not stripped.endswith("|"):
        return None
    return tuple(cell.strip().replace("\\|", "|") for cell in re.split(r"(?<!\\)\|", stripped[1:-1]))


def table_rows(path, section, columns):
    lines = path.read_text().splitlines()
    try:
        start = lines.index(f"## {section}")
    except ValueError:
        fail(f"{path}: missing {section} section")
    indexes = [index for index in range(start + 1, len(lines)) if lines[index].strip()]
    if len(indexes) < 2 or cells(lines[indexes[0]]) != columns:
        fail(f"{path}: invalid {section} header")
    separator = cells(lines[indexes[1]])
    if separator is None or len(separator) != len(columns) or any(not re.fullmatch(r":?-{3,}:?", item) for item in separator):
        fail(f"{path}: invalid {section} separator")
    rows = []
    for index in indexes[2:]:
        if lines[index].startswith("## "):
            break
        row = cells(lines[index])
        if row is None or len(row) != len(columns):
            fail(f"{path}:{index + 1}: invalid {section} row")
        rows.append((index + 1, dict(zip(columns, row))))
    return rows


def slugify(value):
    value = re.sub(r"[^a-z0-9]+", "-", value.lower()).strip("-")
    return value[:72].rstrip("-") or "work-item"


def canonical_id(value):
    normalized = value.replace("–", "-").replace("—", "-")
    normalized = re.sub(r"[^A-Za-z0-9.-]+", "-", normalized).strip("-.")
    if not normalized or not normalized[0].isalpha():
        fail(f"backlog ID cannot be normalized safely: {value}")
    return normalized


def yaml_value(value):
    if value is None:
        return "null"
    if value is True:
        return "true"
    if value is False:
        return "false"
    if isinstance(value, (int, float)):
        return str(value)
    return json.dumps(str(value), ensure_ascii=True)


def render_ticket(context, section, line, values, source, source_commit, source_date):
    item_id = canonical_id(values["id"])
    title = values["title"] if section == "Active" else values["outcome"]
    slug = slugify(title)
    status = values.get("status")
    state = ({"pending": "intake", "in_progress": "in_progress", "active": "in_progress",
              "blocked": "blocked", "cancelled": "cancelled", "done": "review"}.get(status, "done"))
    dependencies = [] if values.get("depends_on", "-") in {None, "", "-"} else [canonical_id(item.strip()) for item in values["depends_on"].split(",")]
    commits = [] if section == "Active" else [values["commit"]]
    completed = None if section == "Active" else values["completed"]
    priority = values.get("priority", "historical")
    owns = [] if values.get("owns", "-") in {None, "", "-"} else [values["owns"]]
    reads = [] if values.get("reads", "-") in {None, "", "-"} else [values["reads"]]
    validation = [] if values.get("validation", "-") in {None, "", "-"} else [values["validation"]]
    migration = f"{source}:{line}:{hashlib.sha256(json.dumps(values, sort_keys=True).encode()).hexdigest()}"
    fields = {
        "schema_version": 1, "id": item_id, "slug": slug, "context": context, "title": title,
        "kind": "task", "state": state, "priority": priority, "points": None,
        "depends_on": dependencies, "relations": [], "owns": owns, "reads": reads,
        "parallel_safe": str(values.get("parallel_safe", "no")).lower() in {"yes", "true"},
        "validation": validation, "created": completed or source_date, "updated": source_date,
        "completed": completed, "commits": commits, "jira_publications": [], "migration": migration,
    }
    lines = ["---"]
    for key, value in fields.items():
        if isinstance(value, list):
            if value:
                lines.append(f"{key}:")
                lines.extend(f"  - {yaml_value(item)}" for item in value)
            else:
                lines.append(f"{key}: []")
        else:
            lines.append(f"{key}: {yaml_value(value)}")
    lines.extend(["---", "", "## Outcome", "", title, "", "## Context", "",
                  f"Migrated from `{source}` {section} row {line} at `{source_commit}`.", "",
                  "## Scope", "", values.get("reason", "Historical completed work."), "",
                  "## Acceptance Criteria", "", values.get("validation", "Completion evidence retained from the legacy backlog."), "",
                  "## Evidence", "", "```json", json.dumps(values, sort_keys=True, ensure_ascii=True), "```", "",
                  "## Risks", "", "Legacy values are preserved without inferred semantics.", "", "## Review", "",
                  "Migrated deterministically; further refinement remains explicit.", ""])
    relative = f"{TICKET_ROOT.as_posix()}/context={context}/{item_id}-{slug}.md"
    return relative, "\n".join(lines)


def migration_manifest(root):
    dirty = subprocess.run(["git", "-C", str(root), "status", "--porcelain", "--", "docs/specs"],
                           text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if dirty.returncode or any(line.endswith("BACKLOG.md") for line in dirty.stdout.splitlines()):
        fail("legacy backlogs must match the committed source tree")
    source_commit = git_output(root, "rev-parse", "HEAD")
    source_date = git_output(root, "show", "-s", "--format=%cs", source_commit)
    outputs, ids = [], set()
    for backlog in sorted((root / "docs/specs").glob("*/BACKLOG.md")):
        context = backlog.parent.name
        source = backlog.relative_to(root).as_posix()
        for section, columns in (("Active", ACTIVE_COLUMNS), ("Completed", COMPLETED_COLUMNS)):
            for line, values in table_rows(backlog, section, columns):
                item_id = canonical_id(values["id"])
                if item_id in ids:
                    fail(f"duplicate normalized backlog ID: {item_id}")
                ids.add(item_id)
                path, content = render_ticket(context, section, line, values, source, source_commit, source_date)
                outputs.append({"id": item_id, "legacy_id": values["id"], "source": source, "section": section.lower(), "line": line,
                                "path": path, "digest": hashlib.sha256(content.encode()).hexdigest(), "content": content})
    outputs.sort(key=lambda item: item["path"])
    return source_commit, outputs


def apply_migration(root, outputs):
    lock_path = Path(git_output(root, "rev-parse", "--git-path", "pmctl-migration.lock"))
    if not lock_path.is_absolute():
        lock_path = root / lock_path
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    with lock_path.open("a+") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        return apply_migration_locked(root, outputs)


def ticket_tree_digest(tickets):
    digest = hashlib.sha256()
    if not tickets.exists():
        return digest.hexdigest()
    for path in sorted(tickets.rglob("*")):
        if path.is_file() and not path.is_symlink():
            relative = path.relative_to(tickets).as_posix().encode()
            digest.update(len(relative).to_bytes(8, "big"))
            digest.update(relative)
            digest.update(hashlib.sha256(path.read_bytes()).digest())
    return digest.hexdigest()


def apply_migration_locked(root, outputs):
    conflicts = []
    for output in outputs:
        target = root / output["path"]
        if target.exists() and target.read_text() != output["content"]:
            conflicts.append(output["path"])
    if conflicts:
        fail(f"migration destination conflict: {conflicts[0]}")
    tickets = root / TICKET_ROOT
    starting_digest = ticket_tree_digest(tickets)
    state = root / "data/backlog/.pmctl"
    staging = state / "tickets-staging"
    backup = state / "tickets-backup"
    marker = state / "ticket-migration"
    if marker.exists():
        if backup.exists() and not tickets.exists():
            os.replace(backup, tickets)
        shutil.rmtree(staging, ignore_errors=True)
        marker.unlink()
    if staging.exists() or backup.exists():
        fail("stale migration staging requires operator review")
    staging_root = staging / "root"
    staged_tickets = staging_root / TICKET_ROOT
    if tickets.exists():
        shutil.copytree(tickets, staged_tickets)
    else:
        staged_tickets.mkdir(parents=True)
    try:
        for output in outputs:
            target = staging_root / output["path"]
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_text(output["content"])
            values, findings = validate_ticket(staging_root, target)
            if values is None or findings:
                fail(f"generated ticket is invalid: {output['path']} {findings}")
        _records, findings = inventory(staging_root)
        if findings:
            fail(f"staged ticket inventory is invalid: {findings[0]}")
        if ticket_tree_digest(tickets) != starting_digest:
            fail("canonical ticket tree changed during migration")
        marker.write_text(json.dumps({"schema_version": 1, "source": str(tickets), "backup": str(backup)}))
        if tickets.exists():
            os.replace(tickets, backup)
            if ticket_tree_digest(backup) != starting_digest:
                os.replace(backup, tickets)
                fail("canonical ticket tree changed before migration promotion")
        os.replace(staged_tickets, tickets)
        marker.unlink()
        shutil.rmtree(backup, ignore_errors=True)
    except Exception:
        if backup.exists() and not tickets.exists():
            os.replace(backup, tickets)
        raise
    finally:
        shutil.rmtree(staging, ignore_errors=True)


def safe_envelope(value):
    forbidden = re.compile(r"(?:password|secret|token|credential|authorization|cookie|transcript|prompt|command_arguments?|api[_-]?key|private[_-]?key)", re.I)
    unsafe = re.compile(r"(?:op://|-----BEGIN [A-Z ]*PRIVATE KEY-----|\bBearer\s+\S+|(?:^|\s)/(?:Users|home|Volumes|var)/|\b[^\s@]+@[^\s@]+\.[^\s@]+)", re.I)
    def visit(item):
        if isinstance(item, dict):
            if any(forbidden.search(str(key)) for key in item):
                fail("envelope contains a forbidden field")
            for child in item.values():
                visit(child)
        elif isinstance(item, list):
            for child in item:
                visit(child)
        elif isinstance(item, str) and unsafe.search(item):
            fail("envelope contains unsafe content")
    visit(value)
    required = {"schema_version", "source_id", "source_authority", "availability", "payload"}
    if (not isinstance(value, dict) or set(value) != required or type(value["schema_version"]) is not int
            or value["source_authority"] != "dbsctr" or value["availability"] not in {"available", "unavailable"}
            or not isinstance(value["source_id"], str) or not 1 <= len(value["source_id"].encode()) <= 256
            or not isinstance(value["payload"], dict)):
        fail("envelope contract is incomplete")


def validate_envelope_contract(source, value):
    if value["schema_version"] != 1:
        fail("unsupported sanitized envelope schema version")
    payload = value["payload"]
    if value["availability"] == "unavailable":
        if (set(payload) != {"reason"} or not isinstance(payload["reason"], str)
                or not 1 <= len(payload["reason"].encode()) <= 2048):
            fail("unavailable envelope must contain one bounded reason")
        return
    required = ENVELOPE_REQUIRED_FIELDS[source]
    if set(payload) - ENVELOPE_PAYLOAD_FIELDS[source] or not set(required) <= set(payload):
        fail("envelope payload does not match its versioned source contract")
    for key, expected in required.items():
        if type(payload[key]) is not expected:
            fail("envelope payload has an invalid field type")
    for key, item in payload.items():
        expected = ENVELOPE_FIELD_TYPES[key]
        if type(item) is not expected:
            fail("envelope payload has an invalid optional field type")
        validate_envelope_field(key, item)


def validate_envelope_field(key, value):
    if key == "gates":
        if set(value) - GATE_NAMES:
            fail("envelope gates contain an unknown gate")
        allowed = {"applicability": str, "result": str, "reason": str, "evidence": str,
                   "exception": dict, "owner": str}
        for gate in value.values():
            if not isinstance(gate, dict) or set(gate) - set(allowed):
                fail("envelope gate contract is invalid")
            for field, item in gate.items():
                if type(item) is not allowed[field]:
                    fail("envelope gate field type is invalid")
            exception = gate.get("exception")
            if exception is not None and (set(exception) - {"disposition", "rationale", "owner", "approved_at", "expires_at"}
                                          or any(not isinstance(item, str) for item in exception.values())):
                fail("envelope gate exception is invalid")
    elif key == "metrics":
        if set(value) - METRIC_NAMES or any(type(item) not in {int, float} or item < 0 for item in value.values()):
            fail("envelope metrics contract is invalid")
    elif key == "rubric":
        if set(value) != {"name", "version", "digest"} or any(not isinstance(item, str) for item in value.values()):
            fail("envelope rubric contract is invalid")
    elif key == "harness_identity":
        allowed = {"provider_id", "model_id", "agent_id", "role", "core_revision", "overlay_revision"}
        if set(value) != allowed or any(not isinstance(item, str) for item in value.values()):
            fail("envelope harness identity is invalid")
    elif key == "members":
        allowed = {"id", "source_id", "cycle_id", "session_id", "digest", "position"}
        if len(value) > 500 or any(not isinstance(item, dict) or not set(item) <= allowed
                                   or any(type(child) not in {str, int} for child in item.values()) for item in value):
            fail("envelope members contract is invalid")
    elif key == "nodes":
        allowed = {"id", "depends_on", "operation", "result"}
        if len(value) > 500 or any(not isinstance(item, dict) or set(item) != allowed
                                   or not isinstance(item["id"], str) or not isinstance(item["operation"], str)
                                   or not isinstance(item["result"], str) or not isinstance(item["depends_on"], list)
                                   or any(not isinstance(child, str) for child in item["depends_on"]) for item in value):
            fail("envelope DAG node contract is invalid")
    elif key == "phase_profile":
        allowed = {"availability", "elapsed_ms", "critical_path", "phase_count", "result"}
        if (set(value) - allowed
                or any(field != "critical_path" and type(item) not in {str, int}
                       for field, item in value.items())
                or not isinstance(value.get("critical_path", []), list)
                or any(not isinstance(item, str) for item in value.get("critical_path", []))):
            fail("envelope phase profile is invalid")
    elif isinstance(value, list):
        if len(value) > 500 or any(not isinstance(item, str) or not item or len(item.encode()) > 2048 for item in value):
            fail("envelope prose list is invalid")
    elif isinstance(value, str) and (not value or len(value.encode()) > 2048):
        fail("envelope scalar is invalid")


def project_envelope(args):
    raw = args.input.read_bytes()
    if len(raw) > 1024 * 1024:
        fail("envelope exceeds 1 MiB")
    value = json.loads(raw)
    if args.source not in ENVELOPE_SOURCES:
        fail("unsupported sanitized envelope source")
    safe_envelope(value)
    validate_envelope_contract(args.source, value)
    digest = hashlib.sha256(raw).hexdigest()
    payload = json.dumps(value, sort_keys=True, separators=(",", ":"))
    sql = (
        "INSERT INTO context.source_envelopes "
        "(source_type,source_id,schema_version,source_digest,source_authority,availability,payload) VALUES "
        f"({sql_literal(args.source)},{sql_literal(value['source_id'])},{value['schema_version']},"
        f"{sql_literal(digest)},{sql_literal(value['source_authority'])},{sql_literal(value['availability'])},"
        f"{sql_literal(payload)}::jsonb) ON CONFLICT DO NOTHING;\n"
    )
    completed = subprocess.run([args.psql, "-X", "-v", "ON_ERROR_STOP=1"], input=sql, text=True,
                               stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=30)
    if completed.returncode:
        fail("PostgreSQL projection failed")
    return {"schema_version": 1, "source_type": args.source, "source_id": value["source_id"],
            "availability": value["availability"], "digest": digest}


def git_output(root, *arguments):
    completed = subprocess.run(["git", "-C", str(root), *arguments], text=True,
                               stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if completed.returncode:
        fail("Git ticket identity is unavailable")
    return completed.stdout.strip()


def project_tickets(args):
    root = args.root.resolve()
    records, findings = inventory(root)
    if findings:
        fail("ticket validation failed")
    tickets = root / TICKET_ROOT
    source_identity = ticket_tree_digest(tickets)
    statements = ["BEGIN;"]
    identities = []
    for record in records:
        digest = hashlib.sha256((root / record["path"]).read_bytes()).hexdigest()
        identities.append((record["path"], digest))
        payload = json.dumps({key: value for key, value in record.items() if key != "path"},
                             sort_keys=True, separators=(",", ":"))
        statements.append(
            "INSERT INTO context.tickets (id,context,title,state,priority,points,source_commit,source_blob,payload) VALUES "
            f"({sql_literal(record['id'])},{sql_literal(record['context'])},{sql_literal(record['title'])},"
            f"{sql_literal(record['state'])},{sql_literal(record['priority'])},"
            f"{'NULL' if record['points'] is None else record['points']},{sql_literal(source_identity)},{sql_literal(digest)},"
            f"{sql_literal(payload)}::jsonb) ON CONFLICT (id) DO UPDATE SET context=EXCLUDED.context,title=EXCLUDED.title,"
            "state=EXCLUDED.state,priority=EXCLUDED.priority,points=EXCLUDED.points,source_commit=EXCLUDED.source_commit,"
            "source_blob=EXCLUDED.source_blob,payload=EXCLUDED.payload,projected_at=now();"
        )
        statements.append(
            "INSERT INTO context.ticket_revisions (ticket_id,source_commit,source_blob,payload) VALUES "
            f"({sql_literal(record['id'])},{sql_literal(source_identity)},{sql_literal(digest)},{sql_literal(payload)}::jsonb) "
            "ON CONFLICT DO NOTHING;"
        )
        statements.append(f"DELETE FROM context.ticket_relations WHERE source_id={sql_literal(record['id'])};")
        for dependency in record["depends_on"]:
            statements.append(
                "INSERT INTO context.ticket_relations (source_id,target_id,relation_type) VALUES "
                f"({sql_literal(record['id'])},{sql_literal(dependency)},'depends_on');"
            )
        for relation in record["relations"]:
            relation_type, target = relation.split(":", 1)
            statements.append(
                "INSERT INTO context.ticket_relations (source_id,target_id,relation_type) VALUES "
                f"({sql_literal(record['id'])},{sql_literal(target)},{sql_literal(relation_type)});"
            )
    identifiers = ",".join(sql_literal(record["id"]) for record in records)
    statements.append(f"DELETE FROM context.tickets WHERE id NOT IN ({identifiers});" if identifiers
                      else "DELETE FROM context.tickets;")
    statements.append(
        "INSERT INTO context.projection_checkpoints (projection,source_identity,item_count) VALUES "
        f"('tickets',{sql_literal(source_identity)},{len(records)}) ON CONFLICT (projection) DO UPDATE SET "
        "source_identity=EXCLUDED.source_identity,item_count=EXCLUDED.item_count,projected_at=now();"
    )
    statements.append("COMMIT;")
    if (ticket_tree_digest(tickets) != source_identity
            or any(hashlib.sha256((root / path).read_bytes()).hexdigest() != digest
                   for path, digest in identities)):
        fail("ticket tree changed during projection")
    completed = subprocess.run([args.psql, "-X", "-v", "ON_ERROR_STOP=1"], input="\n".join(statements) + "\n",
                               text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=30)
    if completed.returncode:
        fail("PostgreSQL ticket projection failed")
    return {"schema_version": 1, "source_identity": source_identity, "projected": len(records)}


def sql_literal(value):
    return "'" + str(value).replace("'", "''") + "'"


def jira_preview(root, manifest_path):
    raw = manifest_path.read_bytes()
    if len(raw) > 256 * 1024:
        fail("Jira manifest is oversized")
    value = json.loads(raw)
    required = {"publication_id", "target", "project", "issue_type", "summary", "description", "source_tickets"}
    publication_id = value.get("publication_id", "") if isinstance(value, dict) else ""
    target = value.get("target") if isinstance(value, dict) else None
    project = value.get("project", "") if isinstance(value, dict) else ""
    issue_type = value.get("issue_type", "") if isinstance(value, dict) else ""
    valid_target = (isinstance(target, dict) and (
        set(target) == {"mode"} and target.get("mode") == "create"
        or set(target) == {"mode", "key"} and target.get("mode") == "update"
        and re.fullmatch(r"[A-Z][A-Z0-9_]{0,15}-[1-9][0-9]*", str(target.get("key", "")))
    ))
    if (not isinstance(value, dict) or set(value) != required
            or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}", publication_id)
            or not re.fullmatch(r"[A-Z][A-Z0-9_]{0,15}", project)
            or not isinstance(issue_type, str) or not re.fullmatch(r"[A-Za-z][A-Za-z0-9 ]{0,63}", issue_type)
            or not valid_target or target.get("mode") == "update" and not target["key"].startswith(project + "-")
            or not isinstance(value["summary"], str) or not value["summary"] or len(value["summary"].encode()) > 255
            or not isinstance(value["description"], str) or not value["description"]
            or len(value["description"].encode()) > 64 * 1024 or not isinstance(value["source_tickets"], list)
            or not value["source_tickets"]):
        fail("Jira manifest is invalid")
    identities = set()
    for member in value["source_tickets"]:
        if (not isinstance(member, dict) or set(member) != {"id", "path", "sha256"}
                or not str(member["path"]).startswith(TICKET_ROOT.as_posix() + "/context=")
                or member["id"] in identities):
            fail("Jira source ticket identity is invalid")
        identities.add(member["id"])
        path = root / member["path"]
        try:
            if (path.is_symlink() or not path.is_file()
                    or not path.resolve().is_relative_to((root / TICKET_ROOT).resolve())):
                fail("Jira source ticket identity is invalid")
            raw = path.read_bytes()
        except OSError:
            fail("Jira source ticket identity is invalid")
        if hashlib.sha256(raw).hexdigest() != member["sha256"]:
            fail("Jira source ticket revision changed")
        parsed, _body = frontmatter(raw.decode("utf-8"))
        if parsed.get("id") != member["id"]:
            fail("Jira source ticket identity is invalid")
        if parsed.get("state") not in {"ready", "committed", "in_progress", "review", "done"}:
            fail("Jira source ticket is not ready for publication")
        for section in ("Outcome", "Context", "Acceptance Criteria", "Evidence"):
            match = re.search(rf"^## {re.escape(section)}\n\n(.+?)(?=\n\n## |\Z)", _body, re.MULTILINE | re.DOTALL)
            if not match or not match.group(1).strip() or match.group(1).strip().lower() == "pending":
                fail("Jira source ticket lacks publication evidence")
    payload = {**value, "label": "pmk-" + hashlib.sha256(publication_id.encode()).hexdigest()[:16]}
    canonical = json.dumps(payload, sort_keys=True, separators=(",", ":"))
    return payload, hashlib.sha256(canonical.encode()).hexdigest()


def jira_acli(options, *arguments):
    completed = subprocess.run([options.acli, "jira", "workitem", *arguments], text=True,
                               stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=30)
    if len(completed.stdout.encode()) > 1024 * 1024 or len(completed.stderr.encode()) > 1024 * 1024:
        fail("ACLI output is oversized")
    if completed.returncode:
        fail("ACLI command failed")
    try:
        return json.loads(completed.stdout)
    except json.JSONDecodeError:
        fail("ACLI returned invalid JSON")


def jira_issue(value):
    if not isinstance(value, dict) or not isinstance(value.get("key"), str):
        fail("ACLI issue result is invalid")
    fields = value.get("fields") or {}
    if not isinstance(fields, dict):
        fail("ACLI issue result is invalid")
    project = fields.get("project") or {}
    issue_type = fields.get("issuetype") or {}
    labels = fields.get("labels") or []
    key_project = value["key"].split("-", 1)[0] if "-" in value["key"] else None
    return {
        "key": value["key"],
        "project": project.get("key") if isinstance(project, dict) and project.get("key") else key_project,
        "issue_type": issue_type.get("name") if isinstance(issue_type, dict) else None,
        "summary": fields.get("summary"),
        "description": fields.get("description"),
        "labels": labels if isinstance(labels, list) and all(isinstance(item, str) for item in labels) else [],
    }


def jira_view(args, key):
    return jira_issue(jira_acli(args, "view", key, "--fields", "project,issuetype,summary,description,labels", "--json"))


def jira_search(args, manifest):
    value = jira_acli(args, "search", "--jql",
                      f'project = "{manifest["project"]}" AND labels = "{manifest["label"]}"',
                      "--fields", "key,issuetype,summary,description,labels", "--limit", "2", "--json")
    rows = value if isinstance(value, list) else value.get("issues", []) if isinstance(value, dict) else None
    if not isinstance(rows, list) or len(rows) > 2:
        fail("ACLI search result is invalid")
    return [jira_issue(row) for row in rows]


def jira_description_text(value):
    if isinstance(value, str):
        return value
    if isinstance(value, dict):
        kind = value.get("type")
        if kind == "text" and isinstance(value.get("text"), str):
            return value["text"]
        if kind == "hardBreak":
            return "\n"
        content = value.get("content", [])
        if kind in {"doc", "blockquote"}:
            return "\n\n".join(filter(None, (jira_description_text(item).strip() for item in content)))
        if kind in {"paragraph", "heading", "listItem"}:
            return "".join(jira_description_text(item) for item in content)
        if kind == "bulletList":
            return "\n".join(f"- {jira_description_text(item).strip()}" for item in content)
        if kind == "orderedList":
            return "\n".join(f"{index}. {jira_description_text(item).strip()}"
                             for index, item in enumerate(content, 1))
        return "".join(jira_description_text(item) for item in content)
    if isinstance(value, list):
        return "".join(jira_description_text(item) for item in value)
    return ""


def jira_matches(issue, manifest):
    if (issue["key"].split("-", 1)[0] != manifest["project"] or issue["project"] != manifest["project"]
            or issue["issue_type"] != manifest["issue_type"] or manifest["label"] not in issue["labels"]
            or issue["summary"] != manifest["summary"]):
        return False
    actual = jira_description_text(issue["description"]).replace("\r\n", "\n").strip()
    expected = manifest["description"].replace("\r\n", "\n").strip()
    return actual == expected


def jira_receipt_path(args, publication_id):
    root = Path.home() / ".local/state/pm-kernel/jira"
    root.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(root, 0o700)
    return root / f"{publication_id}.json"


def jira_read_receipt(args, publication_id):
    path = jira_receipt_path(args, publication_id)
    if not path.exists():
        return None
    if path.is_symlink() or path.stat().st_size > 16 * 1024:
        fail("Jira receipt is invalid")
    value = json.loads(path.read_text())
    if not isinstance(value, dict) or value.get("publication_id") != publication_id:
        fail("Jira receipt is invalid")
    return value


def jira_write_receipt(args, value):
    path = jira_receipt_path(args, value["publication_id"])
    descriptor, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        os.fchmod(descriptor, 0o600)
        stream = os.fdopen(descriptor, "w")
        descriptor = -1
        with stream:
            json.dump(value, stream, sort_keys=True, separators=(",", ":"))
            stream.write("\n")
        os.replace(temporary, path)
    except Exception:
        if descriptor >= 0:
            os.close(descriptor)
        Path(temporary).unlink(missing_ok=True)
        raise


def jira_success_receipt(manifest, digest, key):
    return {
        "schema_version": 1, "publication_id": manifest["publication_id"], "status": "succeeded",
        "operation": manifest["target"]["mode"], "jira_key": key, "preview_digest": digest,
        "source_tickets": [member["id"] for member in manifest["source_tickets"]],
    }


def jira_validate_mapping(args, manifest):
    if (not args.project or manifest["project"] != args.project
            or not args.issue_type or manifest["issue_type"] not in args.issue_type):
        fail("Jira project mapping is invalid")


def jira_publish_acli(args, manifest, digest):
    jira_validate_mapping(args, manifest)
    lock_path = jira_receipt_path(args, manifest["publication_id"]).with_suffix(".lock")
    descriptor = os.open(lock_path, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    with os.fdopen(descriptor, "w") as lock:
        os.fchmod(lock.fileno(), 0o600)
        fcntl.flock(lock, fcntl.LOCK_EX)
        return jira_publish_acli_locked(args, manifest, digest)


def jira_publish_acli_locked(args, manifest, digest):
    receipt = jira_read_receipt(args, manifest["publication_id"])
    target = manifest["target"]
    if receipt and receipt.get("status") in {"pending", "unknown"}:
        fail("Jira publication outcome is unknown; reconcile before retry")
    if receipt and receipt.get("status") == "succeeded":
        if receipt.get("preview_digest") == digest:
            fail("Jira publication already succeeded")
        if target["mode"] == "create" or receipt.get("jira_key") != target.get("key"):
            fail("Jira publication identity already succeeded")
    existing_labels = [manifest["label"]]
    if target["mode"] == "create":
        if jira_search(args, manifest):
            fail("Jira publication identity already exists")
    else:
        before = jira_view(args, target["key"])
        if not jira_matches(before, {**manifest, "summary": before["summary"], "description": before["description"]}):
            fail("Jira update target does not match publication identity")
        existing_labels = sorted(set(before["labels"] + [manifest["label"]]))
    temporary = None
    try:
        with tempfile.NamedTemporaryFile("w", encoding="utf-8", delete=False) as stream:
            temporary = stream.name
            os.fchmod(stream.fileno(), 0o600)
            stream.write(manifest["description"])
        if target["mode"] == "create":
            command = ["create", "--project", manifest["project"], "--type", manifest["issue_type"],
                       "--summary", manifest["summary"], "--description-file", temporary,
                       "--label", manifest["label"], "--json"]
        else:
            command = ["edit", "--key", target["key"], "--summary", manifest["summary"],
                       "--description-file", temporary, "--labels", ",".join(existing_labels), "--yes", "--json"]
        jira_write_receipt(args, {
            "schema_version": 1, "publication_id": manifest["publication_id"], "status": "pending",
            "operation": target["mode"], "jira_key": target.get("key"), "preview_digest": digest,
        })
        try:
            result = jira_acli(args, *command)
            key = result.get("key") if isinstance(result, dict) else None
            if not isinstance(key, str):
                fail("ACLI mutation result is invalid")
            after = jira_view(args, key)
            if key != (target.get("key") or key) or not jira_matches(after, manifest):
                fail("Jira mutation could not be verified")
        except (OSError, RuntimeError, subprocess.TimeoutExpired):
            jira_write_receipt(args, {
                "schema_version": 1, "publication_id": manifest["publication_id"], "status": "unknown",
                "operation": target["mode"], "jira_key": target.get("key"), "preview_digest": digest,
            })
            raise RuntimeError("Jira publication outcome is unknown; reconcile before retry") from None
    finally:
        if temporary:
            Path(temporary).unlink(missing_ok=True)
    jira_write_receipt(args, jira_success_receipt(manifest, digest, key))
    return {"schema_version": 1, "adapter": "acli", "preview_digest": digest,
            "source_tickets": manifest["source_tickets"], "written": True,
            "result": "succeeded", "jira_key": key}


def jira_reconcile(args, manifest, digest):
    jira_validate_mapping(args, manifest)
    receipt = jira_read_receipt(args, manifest["publication_id"])
    if (not receipt or receipt.get("status") not in {"pending", "unknown"}
            or receipt.get("preview_digest") != digest):
        fail("Jira publication has no matching unknown outcome")
    if manifest["target"]["mode"] == "create":
        matches = jira_search(args, manifest)
        if not matches:
            receipt["status"] = "not_found"
            jira_write_receipt(args, receipt)
            return {"schema_version": 1, "result": "not_found", "written": False}
        if len(matches) != 1:
            return {"schema_version": 1, "result": "ambiguous", "written": False}
        issue = jira_view(args, matches[0]["key"])
    else:
        issue = jira_view(args, manifest["target"]["key"])
    if not jira_matches(issue, manifest):
        return {"schema_version": 1, "result": "ambiguous", "written": False}
    jira_write_receipt(args, jira_success_receipt(manifest, digest, issue["key"]))
    return {"schema_version": 1, "result": "resolved", "written": False, "jira_key": issue["key"]}


def jira_project_receipt(args, manifest, digest):
    receipt = jira_read_receipt(args, manifest["publication_id"])
    expected = {"schema_version", "publication_id", "status", "operation", "jira_key",
                "preview_digest", "source_tickets"}
    source_ids = [member["id"] for member in manifest["source_tickets"]]
    if (not isinstance(receipt, dict) or set(receipt) != expected or receipt.get("schema_version") != 1
            or receipt.get("status") != "succeeded" or receipt.get("operation") != manifest["target"]["mode"]
            or receipt.get("preview_digest") != digest or receipt.get("source_tickets") != source_ids
            or not re.fullmatch(rf"{re.escape(manifest['project'])}-[1-9][0-9]*", str(receipt.get("jira_key", "")))):
        fail("Jira publication has no matching successful receipt")
    payload = json.dumps(receipt, sort_keys=True, separators=(",", ":"))
    statements = [
        "BEGIN;",
        "DO $$ BEGIN IF EXISTS (SELECT 1 FROM context.jira_publications "
        f"WHERE publication_id={sql_literal(manifest['publication_id'])} AND "
        f"(preview_digest IS DISTINCT FROM {sql_literal(digest)} OR "
        f"jira_key IS DISTINCT FROM {sql_literal(receipt['jira_key'])})) "
        "THEN RAISE EXCEPTION 'Jira publication identity conflict'; END IF; END $$;",
        "INSERT INTO context.jira_publications "
        "(publication_id,jira_key,preview_digest,adapter,outcome,payload) VALUES "
        f"({sql_literal(manifest['publication_id'])},{sql_literal(receipt['jira_key'])},"
        f"{sql_literal(digest)},'acli','succeeded',{sql_literal(payload)}::jsonb) "
        "ON CONFLICT (publication_id) DO UPDATE SET outcome=EXCLUDED.outcome,payload=EXCLUDED.payload;",
        f"DELETE FROM context.jira_publication_members WHERE publication_id={sql_literal(manifest['publication_id'])};",
    ]
    for member in manifest["source_tickets"]:
        statements.append(
            "INSERT INTO context.jira_publication_members (publication_id,ticket_id,source_blob) VALUES "
            f"({sql_literal(manifest['publication_id'])},{sql_literal(member['id'])},{sql_literal(member['sha256'])});"
        )
    statements.append("COMMIT;")
    completed = subprocess.run([args.psql, "-X", "-v", "ON_ERROR_STOP=1"],
                               input="\n".join(statements) + "\n", text=True,
                               stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=30)
    if completed.returncode:
        fail("Jira publication projection failed")
    reference = manifest["publication_id"]
    return {"schema_version": 1, "publication_id": manifest["publication_id"],
            "jira_key": receipt["jira_key"], "preview_digest": digest,
            "references": [{"ticket_id": ticket_id, "reference": reference} for ticket_id in source_ids],
            "written": False}


def sprint_review_snapshot(args):
    jql = args.jql
    digest = hashlib.sha256(jql.encode()).hexdigest()
    normalized = " ".join(jql.split())
    simple = re.fullmatch(
        r'project\s*=\s*"?([A-Z][A-Z0-9_]{0,15})"?\s+AND\s+'
        r'status\s*=\s*"?([A-Za-z][A-Za-z0-9 ]{0,63})"?', normalized, re.I)
    sprint = re.fullmatch(
        r'project\s*=\s*"?([A-Z][A-Z0-9_]{0,15})"?\s+AND\s+'
        r'status\s*=\s*"?([A-Za-z][A-Za-z0-9 ]{0,63})"?\s+AND\s+'
        r'"(cf\[[1-9][0-9]*\])"\s*=\s*([1-9][0-9]*)\s+AND\s+'
        r'"(cf\[[1-9][0-9]*\])"\s+NOT\s+IN\s+openSprints\(\)\s+AND\s+'
        r'"(cf\[[1-9][0-9]*\])"\s+NOT\s+IN\s+futureSprints\(\)\s+'
        r'ORDER\s+BY\s+created\s+DESC', normalized, re.I)
    match = simple or sprint
    status_name = match.group(2) if match else ""
    fields_match = not sprint or sprint.group(3) == sprint.group(5) == sprint.group(6)
    done_statuses = args.done_status or ["Done"]
    if (digest != args.confirm_jql_digest or not re.fullmatch(r"[A-Z][A-Z0-9_]{0,15}", args.project or "")
            or not match or match.group(1) != args.project or not fields_match
            or done_statuses != [status_name]):
        fail("Sprint Review JQL is not an exact bounded project selection")
    value = jira_acli(args, "search", "--jql", jql,
                      "--fields", "key,summary,status,description", "--limit", "200", "--json")
    rows = value if isinstance(value, list) else value.get("issues", []) if isinstance(value, dict) else None
    if not isinstance(rows, list) or len(rows) > 200:
        fail("ACLI Sprint Review result is invalid")
    issues = []
    for row in rows:
        fields = row.get("fields") if isinstance(row, dict) else None
        status = fields.get("status") if isinstance(fields, dict) else None
        parent = fields.get("parent") if isinstance(fields, dict) else None
        if (not isinstance(row.get("key") if isinstance(row, dict) else None, str)
                or not re.fullmatch(rf"{re.escape(args.project)}-[1-9][0-9]*", row["key"])
                or not isinstance(fields.get("summary") if isinstance(fields, dict) else None, str)
                or not isinstance(status, dict) or not isinstance(status.get("name"), str)
                or parent is not None and (not isinstance(parent, dict) or not isinstance(parent.get("key"), str))):
            fail("ACLI Sprint Review issue is invalid")
        issues.append({"key": row["key"], "summary": fields["summary"], "status": status["name"],
                       "parent": parent["key"] if parent else "",
                       "description": jira_description_text(fields.get("description")), "url": ""})
    raw = json.dumps(issues, sort_keys=True, separators=(",", ":")).encode()
    return raw, {"jql_digest": digest, "project": args.project,
                 "issue_keys": sorted(issue["key"] for issue in issues)}


def markdown_text(value):
    value = str(value).replace("\r", " ").replace("\n", " ")
    return re.sub(r"([\\`*_[\]()<>{}#!|])", r"\\\1", value).strip()


def private_report_directory(root, generated):
    root = root.expanduser().absolute()
    directory = root / "report_type=sprint_review" / f"snapshot_date={generated.date().isoformat()}"
    current = Path(directory.anchor)
    create_from = len(directory.parts)
    for index, part in enumerate(directory.parts[1:], 1):
        current /= part
        try:
            os.lstat(current)
        except FileNotFoundError:
            create_from = index
            break
    private_from = min(len(root.parts), create_from)
    descriptor = os.open(directory.anchor, os.O_RDONLY | os.O_DIRECTORY)
    try:
        for index, part in enumerate(directory.parts[1:], 1):
            if index >= create_from:
                try:
                    os.mkdir(part, 0o700, dir_fd=descriptor)
                except FileExistsError:
                    pass
            child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=descriptor)
            os.close(descriptor)
            descriptor = child
            if index >= private_from:
                os.fchmod(descriptor, 0o700)
        return directory, descriptor
    except Exception:
        os.close(descriptor)
        raise


def sprint_review(args):
    provenance = {}
    if bool(args.input) == bool(args.jql):
        fail("Sprint Review requires exactly one input snapshot or bounded JQL")
    if args.input:
        raw = args.input.read_bytes()
    elif args.jql:
        raw, provenance = sprint_review_snapshot(args)
    if len(raw) > 1024 * 1024:
        fail("Sprint Review input exceeds 1 MiB")
    issues = json.loads(raw)
    required = {"key", "summary", "status", "parent", "description", "url"}
    done = set(args.done_status or ["Done"])
    if (not isinstance(issues, list) or len(issues) > 200
            or any(not isinstance(issue, dict) or set(issue) != required
                   or any(type(issue[field]) is not str for field in required)
                   or not issue["key"] or not issue["summary"] or issue["status"] not in done for issue in issues)
            or len({issue["key"] for issue in issues}) != len(issues)):
        fail("Sprint Review issue snapshot is invalid")
    grouped = {}
    for issue in issues:
        grouped.setdefault(issue["parent"] or "No Parent", []).append(issue)
    lines = [f"# {markdown_text(args.title)}", "", "## Sprint Goal", "",
             markdown_text(args.sprint_goal) or "Not provided", "", "## Product Goal", "",
             markdown_text(args.product_goal) or "Not provided", "", "## What Was Done", ""]
    if not issues:
        lines.extend(["No Done work items were selected.", ""])
    for parent in sorted(grouped, key=lambda item: (item == "No Parent", item)):
        lines.extend([f"### {markdown_text(parent)}", ""])
        for issue in sorted(grouped[parent], key=lambda item: item["key"]):
            if issue["url"] and not re.fullmatch(r"https://[A-Za-z0-9./_?&=%#:+~-]+", issue["url"]):
                fail("Sprint Review issue URL is invalid")
            key = markdown_text(issue["key"])
            link = f"[{key}]({issue['url']})" if issue["url"] else key
            summary = markdown_text(issue["summary"])
            detail = markdown_text(issue["description"].strip() or issue["summary"])
            lines.extend([f"- {link}: {summary}. {detail}", ""])
    lines.extend(["## What Changed In The Environment", "",
                  "Not provided.", "", "## What's Next", "",
                  "Not provided.", "", "## Velocity / Capacity Note", "",
                  f"{len(issues)} Done work item(s) selected. Point and capacity interpretation remains a live review topic.", "",
                  "## Provenance", "", f"Source snapshot SHA-256: `{hashlib.sha256(raw).hexdigest()}`"])
    if provenance:
        lines.extend([f"JQL SHA-256: `{provenance['jql_digest']}`",
                      f"Project: `{provenance['project']}`",
                      "Issue keys: " + ", ".join(provenance["issue_keys"])])
    lines.append("")
    generated = datetime.now(timezone.utc)
    directory, directory_descriptor = private_report_directory(args.output_root, generated)
    source_digest = hashlib.sha256(raw).hexdigest()
    filename = f"sprint_review_{slugify(args.title)}_{source_digest[:16]}_{generated.strftime('%H%M%S%f')}.md"
    output = directory / filename
    temporary = f".{filename}.{secrets.token_hex(8)}"
    descriptor = os.open(temporary, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW,
                         0o600, dir_fd=directory_descriptor)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "w") as stream:
            descriptor = -1
            stream.write("\n".join(lines))
            stream.flush()
            os.fsync(stream.fileno())
        os.link(temporary, filename, src_dir_fd=directory_descriptor,
                dst_dir_fd=directory_descriptor, follow_symlinks=False)
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        try:
            os.unlink(temporary, dir_fd=directory_descriptor)
        except FileNotFoundError:
            pass
        os.close(directory_descriptor)
    return {"schema_version": 1, "issues": len(issues), "path": str(output),
            "source_digest": source_digest, **provenance}


def main():
    parser = argparse.ArgumentParser()
    commands = parser.add_subparsers(dest="command", required=True)
    tickets = commands.add_parser("tickets").add_subparsers(dest="tickets_command", required=True)
    for name in ("list", "check"):
        command = tickets.add_parser(name)
        command.add_argument("--root", type=Path, default=Path.cwd())
        command.add_argument("--json", action="store_true")
    migrate = commands.add_parser("migrate-backlogs")
    migrate.add_argument("--root", type=Path, default=Path.cwd())
    migrate.add_argument("--apply", action="store_true")
    migrate.add_argument("--json", action="store_true")
    project = commands.add_parser("project")
    project.add_argument("--source", required=True)
    project.add_argument("--input", required=True, type=Path)
    project.add_argument("--psql", default="psql")
    project.add_argument("--json", action="store_true")
    project_tickets_parser = commands.add_parser("project-tickets")
    project_tickets_parser.add_argument("--root", type=Path, default=Path.cwd())
    project_tickets_parser.add_argument("--psql", default="psql")
    project_tickets_parser.add_argument("--json", action="store_true")
    jira = commands.add_parser("jira").add_subparsers(dest="jira_command", required=True)
    preview = jira.add_parser("preview")
    preview.add_argument("--manifest", required=True, type=Path)
    preview.add_argument("--root", type=Path, default=Path.cwd())
    preview.add_argument("--json", action="store_true")
    publish = jira.add_parser("publish")
    publish.add_argument("--manifest", required=True, type=Path)
    publish.add_argument("--root", type=Path, default=Path.cwd())
    publish.add_argument("--preview-digest", required=True)
    publish.add_argument("--confirm", required=True)
    publish.add_argument("--adapter", choices=("fake", "acli"), default="fake")
    publish.add_argument("--project", default="")
    publish.add_argument("--issue-type", action="append", default=[])
    publish.add_argument("--acli", default="acli")
    publish.add_argument("--json", action="store_true")
    reconcile = jira.add_parser("reconcile")
    reconcile.add_argument("--manifest", required=True, type=Path)
    reconcile.add_argument("--root", type=Path, default=Path.cwd())
    reconcile.add_argument("--preview-digest", required=True)
    reconcile.add_argument("--project", required=True)
    reconcile.add_argument("--issue-type", action="append", required=True)
    reconcile.add_argument("--acli", default="acli")
    reconcile.add_argument("--json", action="store_true")
    project_receipt = jira.add_parser("project-receipt")
    project_receipt.add_argument("--manifest", required=True, type=Path)
    project_receipt.add_argument("--root", type=Path, default=Path.cwd())
    project_receipt.add_argument("--preview-digest", required=True)
    project_receipt.add_argument("--psql", default="psql")
    project_receipt.add_argument("--json", action="store_true")
    review = commands.add_parser("sprint-review")
    review.add_argument("--input", type=Path)
    review.add_argument("--jql")
    review.add_argument("--confirm-jql-digest", default="")
    review.add_argument("--project", default="")
    review.add_argument("--acli", default="acli")
    review.add_argument("--title", required=True)
    review.add_argument("--sprint-goal", default="")
    review.add_argument("--product-goal", default="")
    review.add_argument("--done-status", action="append")
    review.add_argument("--output-root", type=Path, default=Path("data/interim/reports"))
    review.add_argument("--json", action="store_true")
    args = parser.parse_args()
    if args.command == "tickets":
        root = args.root.resolve()
        records, findings = inventory(root)
        result = {"schema_version": 1, "tickets": records, "findings": findings}
        if args.tickets_command == "check" and findings:
            print(json.dumps(result, sort_keys=True, separators=(",", ":")))
            return 1
    elif args.command == "migrate-backlogs":
        root = args.root.resolve()
        source_commit, outputs = migration_manifest(root)
        if args.apply:
            apply_migration(root, outputs)
        result = {"schema_version": 1, "source_commit": source_commit, "applied": args.apply,
                  "tickets": [{key: value for key, value in item.items() if key != "content"} for item in outputs]}
    elif args.command == "project":
        result = project_envelope(args)
    elif args.command == "project-tickets":
        result = project_tickets(args)
    elif args.command == "jira":
        manifest, digest = jira_preview(args.root.resolve(), args.manifest)
        result = {"schema_version": 1, "payload": manifest, "preview_digest": digest, "written": False}
        if args.jira_command == "publish":
            if args.preview_digest != digest or args.confirm != digest:
                fail("Jira confirmation does not match the current preview")
            if args.adapter == "fake":
                result = {"schema_version": 1, "adapter": "fake", "preview_digest": digest,
                          "source_tickets": manifest["source_tickets"], "written": False,
                          "result": "simulated"}
            else:
                result = jira_publish_acli(args, manifest, digest)
        elif args.jira_command == "reconcile":
            if args.preview_digest != digest:
                fail("Jira reconciliation does not match the current preview")
            result = jira_reconcile(args, manifest, digest)
        elif args.jira_command == "project-receipt":
            if args.preview_digest != digest:
                fail("Jira receipt projection does not match the current preview")
            result = jira_project_receipt(args, manifest, digest)
    else:
        result = sprint_review(args)
    print(json.dumps(result, sort_keys=True, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, UnicodeError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        print(f"pmctl: {error}", file=sys.stderr)
        sys.exit(1)
