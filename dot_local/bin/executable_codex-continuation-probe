#!/usr/bin/env python3
"""Passive, bounded native-hook observations; never continuation authority."""

import argparse
import fcntl
import hashlib
import json
import os
import re
import stat
import sys
import time
import uuid

MAX_INPUT = 1024 * 1024
MAX_RECORDS = 256
EVENTS = {"SessionStart", "PreToolUse", "PostToolUse", "Stop", "Interrupt", "SessionEnd"}
TOOLS = {"Bash", "apply_patch", "exec_command", "write_stdin", "functions.exec",
         "functions.wait", "mcp__codex_app__read_thread"}
PERMISSIONS = {"default", "acceptEdits", "plan", "dontAsk", "bypassPermissions"}
OPAQUE = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,255}\Z")
IDENTITY = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}\Z")


def unique_object(pairs):
    value = {}
    for key, item in pairs:
        if key in value:
            raise ValueError("duplicate_key")
        value[key] = item
    return value


def digest(value, *, model=False):
    if value is None:
        return None
    if not isinstance(value, str) or not (OPAQUE if model else IDENTITY).fullmatch(value):
        raise ValueError("invalid_identity")
    return hashlib.sha256(value.encode("ascii")).hexdigest()


def normalized(raw):
    if len(raw) > MAX_INPUT:
        raise ValueError("input_too_large")
    value = json.loads(raw.decode("utf-8"), object_pairs_hook=unique_object)
    if not isinstance(value, dict) or value.get("hook_event_name") not in EVENTS:
        raise ValueError("invalid_event")
    if not isinstance(value.get("session_id"), str):
        raise ValueError("missing_identity")
    # Never persist unknown keys, argument/output content, paths or raw identity.
    tool = value.get("tool_name")
    mode = value.get("permission_mode")
    return {
        "schema_version": 1,
        "authority": "diagnostic_only",
        "event": value["hook_event_name"],
        "tool": tool if isinstance(tool, str) and tool in TOOLS else "other",
        "permission_mode": mode if isinstance(mode, str) and mode in PERMISSIONS else "unavailable",
        **{name + "_sha256": digest(value.get(name), model=name == "model")
           for name in ("session_id", "turn_id", "tool_use_id", "model")},
        "provider_field_present": "provider" in value or "model_provider" in value,
        "agent_field_present": "agent_id" in value,
        "observed_at_ns": time.time_ns(),
    }


def private(info, *, directory=False):
    expected = stat.S_ISDIR if directory else stat.S_ISREG
    if (not expected(info.st_mode) or info.st_uid != os.getuid()
            or info.st_mode & 0o077 or (not directory and info.st_nlink != 1)):
        raise ValueError("unsafe_storage")


def store(path, record):
    before = os.lstat(path)
    private(before, directory=True)
    directory = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        current = os.fstat(directory)
        private(current, directory=True)
        if (current.st_dev, current.st_ino) != (before.st_dev, before.st_ino):
            raise ValueError("storage_changed")
        lock = os.open(".lock", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600, dir_fd=directory)
        try:
            private(os.fstat(lock))
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            # Bound traversal as well as retained records. Never prune evidence.
            with os.scandir(directory) as entries:
                for count, _ in enumerate(entries, 1):
                    if count >= MAX_RECORDS + 1:  # includes the lock
                        raise ValueError("capacity")
            data = (json.dumps(record, sort_keys=True, separators=(",", ":")) + "\n").encode()
            if len(data) > 2048:
                raise ValueError("record_too_large")
            name = uuid.uuid4().hex + ".json"
            fd = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                         0o600, dir_fd=directory)
            try:
                with os.fdopen(fd, "wb") as output:
                    output.write(data)
                    output.flush()
                    os.fsync(output.fileno())
            except BaseException:
                os.unlink(name, dir_fd=directory)
                raise
        finally:
            os.close(lock)
    finally:
        os.close(directory)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--state", required=True)
    args = parser.parse_args()
    try:
        store(args.state, normalized(sys.stdin.buffer.read(MAX_INPUT + 1)))
    except (ValueError, TypeError, OSError, UnicodeError, RecursionError):
        # Passive diagnostics: inability to observe is never a tool permission.
        pass
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
