#!/usr/bin/env python3
import argparse
import json
import os
import sqlite3
import sys
from pathlib import Path
from urllib.parse import quote


SUPPORTED_TABLES = {
    "__drizzle_migrations", "account", "account_state", "control_account", "credential",
    "data_migration", "event", "event_sequence", "message", "migration", "part", "permission",
    "project", "project_directory", "session", "session_context_epoch", "session_input",
    "session_message", "session_share", "todo", "workspace",
}
REQUIRED_COLUMNS = {
    "project": {"id", "worktree"},
    "project_directory": {"project_id", "directory"},
    "workspace": {"id", "project_id", "directory"},
    "session": {"id", "project_id", "parent_id", "directory", "workspace_id", "path"},
    "message": {"id", "session_id", "data"},
    "part": {"id", "message_id", "session_id", "data"},
    "event": {"aggregate_id", "data"},
    "event_sequence": {"aggregate_id"},
}
IDENTITY_TABLES = ("account_state", "account", "control_account", "credential")
STRUCTURED_PATH_FIELDS = (
    ("project", "worktree"),
    ("project_directory", "directory"),
    ("workspace", "directory"),
    ("session", "directory"),
    ("session", "path"),
)
OPAQUE_PATH_FIELDS = (
    ("workspace", "extra"),
    ("session", "summary_diffs"),
    ("session", "revert"),
    ("session", "permission"),
    ("session", "metadata"),
    ("message", "data"),
    ("part", "data"),
    ("event", "data"),
)


def schema(connection: sqlite3.Connection) -> None:
    tables = {row[0] for row in connection.execute(
        "SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%'"
    )}
    missing, extra = SUPPORTED_TABLES - tables, tables - SUPPORTED_TABLES
    if missing:
        raise ValueError("required tables are missing: " + ", ".join(sorted(missing)))
    if extra:
        raise ValueError("unsupported tables: " + ", ".join(sorted(extra)))
    for table, required in REQUIRED_COLUMNS.items():
        columns = {row[1] for row in connection.execute(f"PRAGMA table_info({table})")}
        absent = required - columns
        if absent:
            raise ValueError(f"required columns are missing from {table}: " + ", ".join(sorted(absent)))


def rebased(value: str | None, mappings: dict[str, str]) -> str | None:
    if value is None:
        return None
    for old in sorted(mappings, key=len, reverse=True):
        if value == old or value.startswith(old + "/"):
            return mappings[old] + value[len(old):]
    return value


def parse_mapping(values: list[str]) -> dict[str, str]:
    result = {}
    for value in values:
        old, separator, new = value.partition("=")
        if not separator or not old.startswith("/") or not new.startswith("/") or old == new:
            raise ValueError("mappings must be distinct absolute OLD=NEW paths")
        if old in result or new in result.values():
            raise ValueError("mapping paths must be unique")
        result[old.rstrip("/") or "/"] = new.rstrip("/") or "/"
    return result


def count(connection: sqlite3.Connection, table: str) -> int:
    return connection.execute(f"SELECT COUNT(*) FROM {table}").fetchone()[0]


def validate(connection: sqlite3.Connection, old_prefixes: tuple[str, ...]) -> None:
    failures = connection.execute("PRAGMA foreign_key_check").fetchall()
    if failures:
        raise ValueError("foreign-key validation failed")
    if connection.execute("PRAGMA integrity_check").fetchone()[0] != "ok":
        raise ValueError("integrity validation failed")
    semantic_checks = {
        "session parents": "SELECT COUNT(*) FROM session c LEFT JOIN session p ON p.id=c.parent_id WHERE c.parent_id IS NOT NULL AND p.id IS NULL",
        "session workspaces": "SELECT COUNT(*) FROM session s LEFT JOIN workspace w ON w.id=s.workspace_id WHERE s.workspace_id IS NOT NULL AND w.id IS NULL",
        "part sessions": "SELECT COUNT(*) FROM part p JOIN message m ON m.id=p.message_id WHERE p.session_id<>m.session_id",
        "event aggregates": "SELECT COUNT(*) FROM event_sequence e LEFT JOIN session s ON s.id=e.aggregate_id WHERE s.id IS NULL",
    }
    for label, statement in semantic_checks.items():
        if connection.execute(statement).fetchone()[0]:
            raise ValueError(f"semantic validation failed for {label}")
    for table, column in STRUCTURED_PATH_FIELDS:
        for prefix in old_prefixes:
            if connection.execute(
                f"SELECT 1 FROM {table} WHERE {column}=? OR {column} LIKE ? LIMIT 1",
                (prefix, prefix + "/%"),
            ).fetchone():
                raise ValueError(f"structured path validation failed for {table}.{column}")


def migrate(source: Path, output: Path, projects: dict[str, str], paths: dict[str, str]) -> dict[str, int]:
    source, output = Path(source), Path(output)
    if not projects:
        raise ValueError("at least one project mapping is required")
    if not source.is_file() or source.is_symlink():
        raise ValueError("source must be a regular file")
    if output.exists() or output.is_symlink():
        raise ValueError("output already exists")
    if not output.parent.is_dir() or output.parent.is_symlink():
        raise ValueError("output parent must be a regular directory")
    if source.resolve() == output.resolve(strict=False):
        raise ValueError("source and output must differ")

    uri = f"file:{quote(str(source.resolve()), safe='/')}?mode=ro"
    try:
        print("migration stage: backup", file=sys.stderr, flush=True)
        with sqlite3.connect(uri, uri=True) as source_db:
            source_db.execute("PRAGMA query_only=ON")
            schema(source_db)
            with sqlite3.connect(output) as output_db:
                source_db.backup(output_db)

        os.chmod(output, 0o600)
        with sqlite3.connect(output) as database:
            database.execute("PRAGMA journal_mode=OFF")
            database.execute("PRAGMA synchronous=OFF")
            database.execute("PRAGMA foreign_keys=ON")
            schema(database)
            rows = database.execute(
                f"SELECT id,worktree FROM project WHERE worktree IN ({','.join('?' for _ in projects)})",
                tuple(projects),
            ).fetchall()
            if len(rows) != len(projects) or {row[1] for row in rows} != set(projects):
                raise ValueError("each declared project must exist exactly once")
            project_ids = tuple(row[0] for row in rows)
            print("migration stage: prune", file=sys.stderr, flush=True)
            database.execute(
                f"DELETE FROM event_sequence WHERE aggregate_id NOT IN "
                f"(SELECT id FROM session WHERE project_id IN ({','.join('?' for _ in project_ids)}))",
                project_ids,
            )
            database.execute(
                f"DELETE FROM project WHERE id NOT IN ({','.join('?' for _ in project_ids)})",
                project_ids,
            )
            for table in IDENTITY_TABLES:
                database.execute(f"DELETE FROM {table}")

            mappings = {**projects, **paths}
            for table, column in STRUCTURED_PATH_FIELDS:
                for rowid, value in database.execute(
                    f"SELECT rowid,{column} FROM {table} WHERE {column} IS NOT NULL"
                ).fetchall():
                    replacement = rebased(value, mappings)
                    if replacement != value:
                        database.execute(f"UPDATE {table} SET {column}=? WHERE rowid=?", (replacement, rowid))

            print("migration stage: validate", file=sys.stderr, flush=True)
            validate(database, tuple(mappings))
            opaque_mentions = 0
            for table, column in OPAQUE_PATH_FIELDS:
                for prefix in mappings:
                    opaque_mentions += database.execute(
                        f"SELECT COUNT(*) FROM {table} WHERE {column} LIKE ?", ("%" + prefix + "%",)
                    ).fetchone()[0]
            result = {
                "projects": count(database, "project"),
                "sessions": count(database, "session"),
                "messages": count(database, "message"),
                "parts": count(database, "part"),
                "events": count(database, "event"),
                "opaque_path_mentions": opaque_mentions,
            }
        return result
    except Exception:
        if output.exists() and not output.is_symlink():
            output.unlink()
        raise


def main() -> int:
    parser = argparse.ArgumentParser(description="Create a private project-scoped OpenCode history database")
    parser.add_argument("source", type=Path)
    parser.add_argument("output", type=Path)
    parser.add_argument("--project", action="append", default=[], metavar="OLD=NEW")
    parser.add_argument("--path-prefix", action="append", default=[], metavar="OLD=NEW")
    args = parser.parse_args()
    try:
        projects = parse_mapping(args.project)
        paths = parse_mapping(args.path_prefix)
        if set(projects) & set(paths):
            raise ValueError("project and path-prefix sources must be distinct")
        print(json.dumps(migrate(args.source, args.output, projects, paths), sort_keys=True))
        return 0
    except (OSError, sqlite3.Error, ValueError) as error:
        print(f"migration failed: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
