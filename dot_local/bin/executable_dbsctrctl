    worktree_list = commands.add_parser("worktree-list")
    worktree_list.add_argument("--json", action="store_true")
    worktree_list.add_argument("--now", action="store_true", help="ignore the 24-hour retention window")
    worktree_list.add_argument("--all", action="store_true")
    worktree_list.set_defaults(func=command_worktree_list)
    cleanup = commands.add_parser("cleanup")
    cleanup_target = cleanup.add_mutually_exclusive_group(required=True)
    cleanup_target.add_argument("--cycle-id")
    cleanup_target.add_argument("--completed", action="store_true")
    cleanup.add_argument("--now", action="store_true")
    cleanup.add_argument("--all", action="store_true")
    cleanup.set_defaults(func=command_cleanup)
    retire = commands.add_parser("cycle-retire")
    retire.add_argument("--cycle-id", required=True)
    retire.add_argument("--confirm", required=True)
    retire.add_argument("--disposition", required=True,
                        choices=("empty", "integrated", "superseded"))
    retire.add_argument("--reason", required=True)
    retire.set_defaults(func=command_cycle_retire)
    retire_worktree = commands.add_parser("cycle-retire-worktree")
    retire_worktree.add_argument("--cycle-id", required=True)
    retire_worktree.add_argument("--confirm", required=True)
    retire_worktree.add_argument("--reason", required=True)
    retire_worktree.set_defaults(func=command_cycle_retire_worktree)
    audit = commands.add_parser("audit")
    audit.add_argument("--commit", default="HEAD")
    audit.add_argument("--json", action="store_true")
    audit.set_defaults(func=command_audit)
    inspect = commands.add_parser("inspect")
    inspect.add_argument("--commit", default="HEAD")
    inspect.add_argument("--action", required=True, choices=("read", "tree", "search", "object"))
    inspect.add_argument("--path")
    inspect.add_argument("--query")
    inspect.add_argument("--limit", type=int)
    inspect.add_argument("--offset", type=int)
    inspect.add_argument("--cursor", type=int)
    inspect.add_argument("--excerpt", type=int)
    inspect.add_argument("--json", action="store_true", required=True)
    inspect.set_defaults(func=command_inspect)
    return result


def main():
    try:
        args = parser().parse_args()
        args.func(args)
    except (RuntimeError, OSError, json.JSONDecodeError, sqlite3.Error) as error:
        print(f"dbsctrctl: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
