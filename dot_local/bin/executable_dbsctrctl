class AnalyticsOutput(io.StringIO):
    """Bound the private projection before any bytes reach agent-facing stdout."""
    def __init__(self, budget=None):
        super().__init__()
        self.budget = budget if budget is not None else [256 * 1024]

    def write(self, value):
        self.budget[0] -= len(value.encode("utf-8"))
        if self.budget[0] < 0:
            fail("analytics projection exceeds its bound")
        return super().write(value)


def agent_analytics_output(action):
    unsafe = re.compile(r"https?://|file://|/(?:Users|home|root|tmp|private|var/folders)/|-----BEGIN [A-Z ]*PRIVATE KEY-----", re.I)
    try:
        with AnalyticsOutput() as output, AnalyticsOutput(output.budget) as errors, \
                contextlib.redirect_stdout(output), contextlib.redirect_stderr(errors):
            action()
            raw = output.getvalue()
            value = json.loads(raw, object_pairs_hook=no_duplicate_keys)
            pending = [value]
            while pending:
                item = pending.pop()
                if isinstance(item, dict):
                    if {key.lower() for key in item} & {"body", "content", "transcript", "messages", "password", "secret",
                                    "api_key", "access_token", "authorization", "credentials",
                                    "credential", "private_key", "cookie", "token"}:
                        fail("private body fields are not analytics metadata")
                    pending.extend(item.values())
                elif isinstance(item, list):
                    pending.extend(item)
                elif isinstance(item, str) and (SECRET_VALUE.search(item) or unsafe.search(item)):
                    fail("unsafe analytics projection")
                elif isinstance(item, float) and not math.isfinite(item):
                    fail("unsafe analytics projection")
            if (errors.getvalue() or not isinstance(value, dict)
                    or unsafe.search(raw) or unsafe.search(json.dumps(value))
                    or SECRET_VALUE.search(raw) or SECRET_VALUE.search(json.dumps(value))):
                fail("unsafe analytics projection")
    except SourceIndexUnavailable:
        raise
    except Exception as error:
        for reason in ("quarantined", "invalid result", "history capture is missing", "aggregate projection mismatch",
                       "intersects the excluded session family", "page coverage", "changed within the review snapshot",
                       "member columns mismatch", "review ledger is unsafe", "invalid excluded session ID",
                       "integer milliseconds", "missing", "unsafe"):
            if reason.lower() in str(error).lower():
                fail(f"analytics projection unavailable: {reason}")
        fail("analytics projection unavailable; private output was withheld")
    print(json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=True))


def main():
    capture = None
    checkpoint = None
    quiet_local = sys.argv[1:2] == ["complete-local"]
    try:
        if forgejo_internal_main(sys.argv[1:]):
            return 0
        if sys.argv[1:2] == ["history-source-validate"] and (
                len(sys.argv) != 4 or sys.argv[2] != "--envelope-json"):
            history_source_fail("invalid_arguments")
        args = parser().parse_args()
        if args.command == "initiative-amend":
            # This command owns offline admission, locks and bounded error output.
            # No generic telemetry, continuation transport or credential discovery.
            args.func(args)
            return 0
        if args.command == "provider-evaluation-save":
            fail("native_capture_authority_unavailable: retain existing reports; supplied receipt digests do not authenticate a federated capture")
        if args.command in {"improvement-register", "improvement-claim", "improvement-update", "improvement-recover"}:
            fail("native_automation_identity_unavailable: preserve existing workers and claims until a native identity route is qualified")
        if args.command in {"incident-register", "incident-update", "incident-forget"} or (
                args.command == "incident-scan" and not args.summary_only):
            fail("native_incident_invocation_unavailable: retain the fork and use incident-scan --summary-only for metadata")
        selected = local_dispatch_selection(args)
        quiet_local = quiet_local or (selected is not None and local_only_cycle(selected[3]))
        with local_cli_mutation_guard(args, selected):
            continuation_guard(args)
            if not quiet_local:
                capture = workflow_operation_start(args)
            if args.command in {"review-scan", "history-capture", "review-history", "benchmark", "provider-evaluation"} or (
                    args.command == "incident-scan" and args.summary_only):
                agent_analytics_output(lambda: args.func(args))
            else:
                outcome = args.func(args)
                if args.command == "gate-commit":
                    checkpoint = outcome
            if not quiet_local:
                workflow_operation_finish(capture, True)
        if checkpoint is not None:
            optional_shadow_checkpoint(checkpoint)
    except SourceIndexUnavailable:
        if not quiet_local:
            workflow_operation_finish(capture, False)
        print("source_index_unavailable", file=sys.stderr)
        return 75
    except SystemExit as error:
        if not quiet_local:
            workflow_operation_finish(capture, error.code in (None, 0))
        raise
    except (RuntimeError, OSError, json.JSONDecodeError, sqlite3.Error) as error:
        if not quiet_local:
            workflow_operation_finish(capture, False)
        print(f"dbsctrctl: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
