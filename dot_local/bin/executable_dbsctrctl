def fail(message):
    raise RuntimeError(message)


class SourceIndexUnavailable(RuntimeError):
    pass


class DVCCommandUnavailable(RuntimeError):
    """A sanitized DVC command failure, not evidence of unsafe output contents."""


LOCAL_COMPLETION_GIT = contextvars.ContextVar("local_completion_git", default=None)


def git_environment(environment):
    selected = LOCAL_COMPLETION_GIT.get()
    return selected if selected is not None else environment


@contextlib.contextmanager
def local_completion_git_context():
    """Keep completion reads offline and suppress configured command execution."""
    with tempfile.TemporaryDirectory(prefix="dbsctr-local-read-") as directory:
        environment = _forgejo_environment(Path(directory))
        environment.update(GIT_NO_LAZY_FETCH="1", GIT_NO_REPLACE_OBJECTS="1",
                           GIT_OPTIONAL_LOCKS="0", GIT_ALLOW_PROTOCOL="")
        settings = {"core.fsmonitor": "false", "core.hooksPath": os.devnull,
                    "core.attributesFile": os.devnull, "core.sshCommand": "false",
                    "credential.helper": "", "diff.external": "", "gc.auto": "0",
                    "maintenance.auto": "false", "protocol.allow": "never"}
        environment["GIT_CONFIG_COUNT"] = str(len(settings))
        for index, (key, value) in enumerate(settings.items()):
            environment[f"GIT_CONFIG_KEY_{index}"] = key
            environment[f"GIT_CONFIG_VALUE_{index}"] = value
        token = LOCAL_COMPLETION_GIT.set(environment)
        try:
            yield
        finally:
            LOCAL_COMPLETION_GIT.reset(token)


def require_local_read_filters(root, seen=None):
    """Refuse executable filters, including initialized nested submodules."""
    seen = set() if seen is None else seen
    root = root.resolve()
    if root in seen or len(seen) >= 64:
        fail("local completion submodule inspection is ambiguous or exceeds its bound")
    seen.add(root)
    top = inspect_git_bytes(root, "rev-parse", "--show-toplevel")
    if not top.endswith(b"\n") or Path(os.fsdecode(top[:-1])).resolve() != root:
        fail("local completion repository worktree is redirected")
    filters = git(root, "config", "--get-regexp", r"^filter\..*\.(clean|smudge|process)$", check=False)
    if filters.returncode not in (0, 1) or filters.stdout.strip():
        fail("local completion requires executable Git filters to be disabled")
    entries = inspect_git_bytes(root, "ls-files", "--stage", "-z").split(b"\0")
    for entry in entries:
        if not entry.startswith(b"160000 "):
            continue
        child = root / os.fsdecode(entry.partition(b"\t")[2])
        if child.is_symlink() or not child.resolve().is_relative_to(root):
            fail("local completion submodule path is unsafe")
        if (child / ".git").exists():
            require_local_read_filters(child, seen)


def git(root, *args, check=True, env=None):
    result = subprocess.run(
        ["git", *args], cwd=root, text=True, capture_output=True,
        env=git_environment(GIT_REPOSITORY_ENV if env is None else env),
    )
    if check and result.returncode:
        fail(result.stderr.strip() or f"git {' '.join(args)} failed")
    return result


def git_read(root, *args, check=True):
    result = subprocess.run(
        ["git", *args], cwd=root, text=True, capture_output=True,
        env=git_environment({**GIT_REPOSITORY_ENV, "GIT_OPTIONAL_LOCKS": "0"}),
    )
    if check and result.returncode:
        fail(result.stderr.strip() or f"git {' '.join(args)} failed")
    return result


def inspect_git(root, *args, check=True):
    result = subprocess.run(["git", *args], cwd=root, text=True, capture_output=True, env=git_environment(INSPECT_ENV))
    if check and result.returncode:
        fail(result.stderr.strip() or f"git {' '.join(args)} failed")
    return result


def inspect_git_bytes(root, *args):
    result = subprocess.run(["git", *args], cwd=root, capture_output=True, env=git_environment(INSPECT_ENV))
    if result.returncode:
        fail(result.stderr.decode(errors="replace").strip() or f"git {' '.join(args)} failed")
    return result.stdout


def now():
    return datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")


def root_dir():
    result = subprocess.run(["git", "rev-parse", "--show-toplevel"], text=True, capture_output=True,
                            env=git_environment(None))
    if result.returncode:
        fail("not inside a Git repository")
    return Path(result.stdout.strip())


def repo_root(value):
    try:
        result = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"], cwd=Path(value).expanduser(),
            text=True, capture_output=True,
            env={**GIT_REPOSITORY_ENV, "GIT_OPTIONAL_LOCKS": "0"},
        )
    except OSError:
        fail("Initiative source must be a Git repository")
    if result.returncode:
        fail("Initiative source must be a Git repository")
    return Path(result.stdout.strip()).resolve()


def git_dir(root):
    path = Path(git(root, "rev-parse", "--git-dir").stdout.strip())
    return path if path.is_absolute() else root / path


def common_git_dir(root):
    path = Path(git(root, "rev-parse", "--git-common-dir").stdout.strip())
    return path if path.is_absolute() else root / path


def legacy_worktree_id(root):
    return hashlib.sha256(str(root.resolve()).encode()).hexdigest()[:16]


def repository_identity(root):
    shallow = git(root, "rev-parse", "--is-shallow-repository").stdout.strip()
    if shallow != "false":
        fail("portable worktree identity requires a complete Git history")
    initial = git(root, "rev-list", "--max-parents=0", "HEAD").stdout.splitlines()
    if len(initial) != 1:
        fail("portable worktree identity requires exactly one Git root")
    return initial[0]


def worktree_id(root):
    identity = f"{repository_identity(root)}\0{branch(root) or 'detached'}"
    return hashlib.sha256(identity.encode()).hexdigest()[:16]


def worktree_for_id(root, identifier):
    if not isinstance(identifier, str) or not re.fullmatch(r"[0-9a-f]{16}", identifier):
        fail("Cycle Record contains an invalid source worktree identity")
    repository = repository_identity(root)
    candidates = []
    current = None
    for line in git(root, "worktree", "list", "--porcelain").stdout.splitlines() + [""]:
        if line.startswith("worktree "):
            current = {"path": line.removeprefix("worktree "), "branch": "detached"}
        elif current is not None and line.startswith("branch refs/heads/"):
            current["branch"] = line.removeprefix("branch refs/heads/")
        elif not line and current is not None:
            identity = f"{repository}\0{current['branch']}"
            if hashlib.sha256(identity.encode()).hexdigest()[:16] == identifier:
                candidates.append(Path(current["path"]).resolve())
            current = None
    if len(candidates) != 1:
        fail("source worktree identity changed")
    return candidates[0]


def dbsctr_state_root(value=None):
    if value:
        return Path(value).expanduser()
    if configured := os.environ.get("DBSCTR_STATE_ROOT"):
        return Path(configured).expanduser()
    if configured := os.environ.get("DOTFILES_AI_STATE_ROOT"):
        return Path(configured).expanduser() / "dbsctr"
    if configured := os.environ.get("XDG_STATE_HOME"):
        return Path(configured).expanduser() / "dbsctr"
    return Path.home() / ".local/state/dbsctr"


def worktree_registry_root(value=None):
    if value:
        return Path(value).expanduser()
    if configured := os.environ.get("DBSCTR_WORKTREE_ROOT"):
        return Path(configured).expanduser()
    return dbsctr_state_root() / "worktrees"


def opencode_database(value=None):
    if value:
        return Path(value).expanduser()
    data = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")).expanduser()
    return data / "opencode/opencode.db"


def primary_worktree(root):
    for line in git(root, "worktree", "list", "--porcelain").stdout.splitlines():
        if line.startswith("worktree "):
            return Path(line.removeprefix("worktree ")).resolve()
    fail("cannot resolve primary Git worktree")


def cycle_dir(root):
    return common_git_dir(root) / "dbsctr"


def active_path(root):
    return cycle_dir(root) / "worktrees" / worktree_id(root) / "active"


def legacy_active_path(root):
    return cycle_dir(root) / "worktrees" / legacy_worktree_id(root) / "active"


def active_pointer_id(root, path):
    if path.absolute() == (legacy_cycle_dir(root) / "active").absolute():
        safe_directory(legacy_cycle_dir(root), path.parent)
    else:
        managed_directory(root, path.parent)
    try:
        details = path.lstat()
    except OSError as error:
        fail(f"cannot inspect cycle active pointer: {error}")
    if (stat.S_IFMT(details.st_mode) != stat.S_IFREG or details.st_uid != os.getuid()
            or path.is_symlink()):
        fail("cycle active pointer is unsafe")
    cycle_id = path.read_text(encoding="utf-8").strip()
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", cycle_id):
        fail("cycle active pointer is unsafe")
    return cycle_id


def resolved_active_path(root, *, bindings=True):
    if bindings:
        local = resolved_active_path(root, bindings=False)
        if local.exists():
            identifier = active_pointer_id(root, local)
            record_path = cycle_dir(root) / "cycles" / f"{identifier}.json"
            if record_path.is_file() and native_workspace_execution(
                    read_cycle_record(root, record_path, historical=True)):
                return local
    bound = continuation_binding_for_root(root) if bindings else None
    if bound:
        path = cycle_dir(root) / "worktrees" / bound["legacy_worktree_id"] / "active"
        if path.exists() and active_pointer_id(root, path) != bound["cycle_id"]:
            raise ContinuationError("invalid_target")
        return path
    candidates = [legacy_active_path(root), legacy_cycle_dir(root) / "active"]
    with contextlib.suppress(RuntimeError):
        candidates.insert(0, active_path(root))
    for path in candidates:
        if path.exists():
            active_pointer_id(root, path)
            return path
        if path.is_symlink():
            fail("cycle active pointer is unsafe")
    return candidates[0]


def safe_directory(base, path, create=False):
    base = base.absolute()
    path = path.absolute()
    try:
        relative = path.relative_to(base)
    except ValueError:
        fail("managed DBSCTR directory escapes its root")
    if not base.exists():
        if base.is_symlink():
            fail("managed DBSCTR directory is unsafe")
        if not create:
            return False
        base.mkdir()
    details = base.lstat()
    if stat.S_IFMT(details.st_mode) != stat.S_IFDIR or details.st_uid != os.getuid() or base.is_symlink():
        fail("managed DBSCTR directory is unsafe")
    current = base
    for part in relative.parts:
        current = current / part
        if not current.exists():
            if current.is_symlink():
                fail("managed DBSCTR directory is unsafe")
            if not create:
                return False
            current.mkdir()
        details = current.lstat()
        if stat.S_IFMT(details.st_mode) != stat.S_IFDIR or details.st_uid != os.getuid() or current.is_symlink():
            fail("managed DBSCTR directory is unsafe")
    return True


def managed_directory(root, path, create=False):
    return safe_directory(cycle_dir(root), path, create)


def legacy_cycle_dir(root):
    return git_dir(root) / "dbsctr"


def atomic_json(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile("w", dir=path.parent, delete=False, encoding="utf-8") as handle:
        json.dump(value, handle, sort_keys=True, indent=2)
        handle.write("\n")
        temp = handle.name
    os.replace(temp, path)


def private_json(path, value, *, strict=False):
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(path.parent, 0o700)
    descriptor, temporary = tempfile.mkstemp(dir=path.parent)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            json.dump(value, handle, sort_keys=True, separators=(",", ":"))
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        if strict:
            fsync_directory(path.parent)
        else:
            with contextlib.suppress(OSError):
                fsync_directory(path.parent)
    finally:
        Path(temporary).unlink(missing_ok=True)


def fsync_directory(path):
    descriptor = os.open(path, os.O_RDONLY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def review_root(value=None):
    return dbsctr_state_root(value)


def review_unsafe(value):
    text = json.dumps(value, ensure_ascii=False) if not isinstance(value, str) else value
    return (SECRET_VALUE.search(text) or HIGH_ENTROPY.search(text) or
            re.search(r"\b[\w.+-]+@[\w.-]+\.[A-Za-z]{2,}\b", text) or
            re.search(r"\b(?:https?|ftp)://", text, re.I) or
             re.search(r"(?<![A-Za-z0-9._~-])(?:~|/)[^\s`)'\"\]}]+", text))


def history_source_fail(reason):
    fail(f"history_source_{reason}")


def history_source_object(value, keys):
    if not isinstance(value, dict) or set(value) != set(keys):
        history_source_fail("invalid_schema")
    return value


def history_source_integer(value, minimum=0, maximum=HISTORY_SOURCE_INTEGER_MAX):
    if isinstance(value, bool) or not isinstance(value, int) or value < minimum:
        history_source_fail("invalid_schema")
    if maximum is not None and value > maximum:
        history_source_fail("invalid_schema")
    return value


def history_source_identity(value):
    if not isinstance(value, str) or not OPAQUE_ID.fullmatch(value):
        history_source_fail("invalid_identity")
    return value


def history_source_digest(value):
    if not isinstance(value, str) or not re.fullmatch(r"[0-9a-f]{64}", value):
        history_source_fail("invalid_digest")
    return value


def history_source_canonical(value):
    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=True).encode()


def history_source_hash(value):
    return hashlib.sha256(history_source_canonical(value)).hexdigest()


def history_source_ascii(value, maximum):
    if (not isinstance(value, str) or not 1 <= len(value.encode("ascii", "ignore")) <= maximum
            or any(ord(character) < 32 or ord(character) > 126 for character in value)):
        history_source_fail("invalid_schema")
    try:
        value.encode("ascii")
    except UnicodeEncodeError:
        history_source_fail("invalid_schema")
    return value


def validate_history_source(value):
    envelope = history_source_object(value, {"request", "page"})
    request = history_source_object(envelope["request"], {"schema_version", "limit", "continuation"})
    if history_source_integer(request["schema_version"], 1, 1) != 1:
        history_source_fail("invalid_schema")
    limit = history_source_integer(request["limit"], 1, 20)

    def source(value):
        item = history_source_object(value, {"harness_id", "adapter_revision", "release"})
        history_source_identity(item["harness_id"])
        history_source_identity(item["adapter_revision"])
        history_source_ascii(item["release"], 128)
        return item

    def members(value):
        if not isinstance(value, list) or len(value) > 100:
            history_source_fail("invalid_membership")
        result = []
        seen = set()
        for raw in value:
            member = history_source_object(raw, {"session_id", "updated_at"})
            session_id = history_source_identity(member["session_id"])
            updated_at = history_source_integer(member["updated_at"])
            if session_id in seen:
                history_source_fail("invalid_membership")
            seen.add(session_id)
            result.append({"session_id": session_id, "updated_at": updated_at})
        if result != sorted(result, key=lambda item: (-item["updated_at"], item["session_id"])):
            history_source_fail("invalid_membership")
        return result

    def continuation(value):
        item = history_source_object(value, {
            "source", "snapshot_digest", "overflow", "members", "offset",
            "previous_page_digest",
        })
        item_source = source(item["source"])
        snapshot = history_source_digest(item["snapshot_digest"])
        if not isinstance(item["overflow"], bool):
            history_source_fail("invalid_schema")
        item_members = members(item["members"])
        if not item_members:
            history_source_fail("invalid_membership")
        offset = history_source_integer(item["offset"], 1, len(item_members))
        if offset >= len(item_members):
            history_source_fail("invalid_membership")
        previous = history_source_digest(item["previous_page_digest"])
        return {
            "source": item_source, "snapshot_digest": snapshot, "overflow": item["overflow"],
            "members": item_members, "offset": offset, "previous_page_digest": previous,
        }

    incoming = None if request["continuation"] is None else continuation(request["continuation"])
    page = history_source_object(envelope["page"], {
        "schema_version", "source", "snapshot_digest", "overflow", "members", "entries",
        "continuation", "page_digest",
    })
    if history_source_integer(page["schema_version"], 1, 1) != 1 or not isinstance(page["overflow"], bool):
        history_source_fail("invalid_schema")
    page_source = source(page["source"])
    page_members = members(page["members"])
    if page["overflow"] and len(page_members) != 100:
        history_source_fail("invalid_membership")
    snapshot_digest = history_source_digest(page["snapshot_digest"])
    expected_snapshot = history_source_hash({
        "members": page_members, "overflow": page["overflow"], "source": page_source,
    })
    if snapshot_digest != expected_snapshot:
        history_source_fail("snapshot_mismatch")

    start = 0
    if incoming is not None:
        start = incoming["offset"]
        if any((incoming["source"] != page_source,
                incoming["snapshot_digest"] != snapshot_digest,
                incoming["overflow"] != page["overflow"],
                incoming["members"] != page_members)):
            history_source_fail("stale_continuation")

    if not isinstance(page["entries"], list) or len(page["entries"]) > 20:
        history_source_fail("invalid_entries")
    end = min(start + limit, len(page_members))
    expected_ids = [item["session_id"] for item in page_members[start:end]]
    if len(page["entries"]) != len(expected_ids):
        history_source_fail("invalid_entries")

    source_kinds = {
        "cli", "vscode", "exec", "appServer", "subAgent", "subAgentReview",
        "subAgentCompact", "subAgentThreadSpawn", "subAgentOther", "unknown",
    }
    availability_statuses = {"available", "unavailable", "partial", "not_requested"}

    def availability(value):
        if not isinstance(value, dict) or set(value) not in ({"status"}, {"status", "reason"}):
            history_source_fail("invalid_availability")
        status = value.get("status")
        if not isinstance(status, str) or status not in availability_statuses:
            history_source_fail("invalid_availability")
        if status in {"unavailable", "partial"}:
            if set(value) != {"status", "reason"}:
                history_source_fail("invalid_availability")
            history_source_ascii(value["reason"], 256)
        elif set(value) != {"status"}:
            history_source_fail("invalid_availability")
        return status

    actual_ids = []
    for raw in page["entries"]:
        entry = history_source_object(raw, {
            "session_id", "family_id", "parent_id", "created_at", "updated_at", "workspace",
            "project_digest", "source_kind", "provider_id", "content", "tool_signals",
            "aggregates", "metrics", "availability",
        })
        session_id = history_source_identity(entry["session_id"])
        actual_ids.append(session_id)
        history_source_identity(entry["family_id"])
        if entry["parent_id"] is not None:
            history_source_identity(entry["parent_id"])
        created_at = history_source_integer(entry["created_at"])
        updated_at = history_source_integer(entry["updated_at"])
        if updated_at < created_at:
            history_source_fail("invalid_timestamp")
        if (not isinstance(entry["workspace"], str)
                or entry["workspace"] not in {"primary_worktree", "cycle_worktree", "unknown"}):
            history_source_fail("invalid_schema")
        history_source_digest(entry["project_digest"])
        if not isinstance(entry["source_kind"], str) or entry["source_kind"] not in source_kinds:
            history_source_fail("invalid_schema")
        history_source_identity(entry["provider_id"])

        content = entry["content"]
        if not isinstance(content, list) or len(content) > 100:
            history_source_fail("invalid_content")
        roles = {"user": 0, "assistant": 0}
        for raw_text in content:
            text = history_source_object(raw_text, {"role", "text"})
            if text["role"] not in roles or not isinstance(text["text"], str):
                history_source_fail("invalid_content")
            encoded = text["text"].encode("utf-8")
            if (not 1 <= len(encoded) <= 8192
                    or any(ord(character) < 32 or 127 <= ord(character) <= 159
                           for character in text["text"])
                    or review_unsafe(text["text"])
                    or re.search(
                        r"(?i)(?:[A-Z]:[\\/]|\\\\[^\\/\s]+[\\/]|(?<![\\A-Za-z0-9._-])\\(?!\\)\S+)",
                        text["text"],
                    )):
                history_source_fail("unsafe_content")
            roles[text["role"]] += 1

        signals = entry["tool_signals"]
        if not isinstance(signals, list) or len(signals) > 100:
            history_source_fail("invalid_tool_signals")
        signal_ids, error_count = set(), 0
        for raw_signal in signals:
            signal = history_source_object(raw_signal, {
                "signal_id", "tool", "status", "failure_class", "recovered", "timestamp",
            })
            if not isinstance(signal["signal_id"], str) or not re.fullmatch(r"[0-9a-f]{24}", signal["signal_id"]):
                history_source_fail("invalid_tool_signals")
            if signal["signal_id"] in signal_ids:
                history_source_fail("invalid_tool_signals")
            signal_ids.add(signal["signal_id"])
            if (not isinstance(signal["tool"], str)
                    or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}", signal["tool"])):
                history_source_fail("invalid_tool_signals")
            if (not isinstance(signal["status"], str)
                    or signal["status"] not in {"error", "failed", "completed", "success"}):
                history_source_fail("invalid_tool_signals")
            failed = signal["status"] in {"error", "failed"}
            if not isinstance(signal["failure_class"], str) or signal["failure_class"] not in {
                    "command", "permission", "timeout", "network", "validation", "unknown", "none"}:
                history_source_fail("invalid_tool_signals")
            if failed == (signal["failure_class"] == "none"):
                history_source_fail("invalid_tool_signals")
            if not isinstance(signal["recovered"], bool):
                history_source_fail("invalid_tool_signals")
            history_source_integer(signal["timestamp"])
            error_count += int(failed)

        aggregates = history_source_object(entry["aggregates"], {
            "turn_count", "user_message_count", "assistant_message_count",
            "tool_call_count", "tool_error_count",
        })
        for name in aggregates:
            history_source_integer(aggregates[name])
        if (aggregates["user_message_count"] != roles["user"]
                or aggregates["assistant_message_count"] != roles["assistant"]
                or aggregates["tool_call_count"] != len(signals)
                or aggregates["tool_error_count"] != error_count):
            history_source_fail("aggregate_mismatch")

        metrics = history_source_object(entry["metrics"], {"token_total", "cost_total"})
        if metrics["token_total"] is not None:
            history_source_integer(metrics["token_total"])
        if (metrics["cost_total"] is not None
                and (not isinstance(metrics["cost_total"], str)
                     or not re.fullmatch(r"(?:0|[1-9][0-9]*)(?:\.[0-9]{1,6})?", metrics["cost_total"]))):
            history_source_fail("invalid_metrics")
        statuses = history_source_object(entry["availability"], {"content", "tokens", "cost"})
        content_status = availability(statuses["content"])
        token_status = availability(statuses["tokens"])
        cost_status = availability(statuses["cost"])
        if content_status in {"unavailable", "not_requested"} and content:
            history_source_fail("availability_mismatch")
        if ((token_status == "available") != (metrics["token_total"] is not None)
                or token_status in {"unavailable", "not_requested"} and metrics["token_total"] is not None
                or (cost_status == "available") != (metrics["cost_total"] is not None)
                or cost_status in {"unavailable", "not_requested"} and metrics["cost_total"] is not None):
            history_source_fail("availability_mismatch")

    if actual_ids != expected_ids:
        history_source_fail("entry_membership_mismatch")
    if any(entry["updated_at"] != member["updated_at"]
           for entry, member in zip(page["entries"], page_members[start:end])):
        history_source_fail("entry_membership_mismatch")

    page_preimage = {key: page[key] for key in (
        "entries", "members", "overflow", "schema_version", "snapshot_digest", "source",
    )}
    expected_page_digest = history_source_hash(page_preimage)
    if history_source_digest(page["page_digest"]) != expected_page_digest:
        history_source_fail("page_digest_mismatch")
    if end < len(page_members):
        outgoing = continuation(page["continuation"])
        expected_outgoing = {
            "source": page_source, "snapshot_digest": snapshot_digest,
            "overflow": page["overflow"], "members": page_members, "offset": end,
            "previous_page_digest": expected_page_digest,
        }
        if outgoing != expected_outgoing:
            history_source_fail("continuation_mismatch")
    elif page["continuation"] is not None:
        history_source_fail("continuation_mismatch")
    return expected_page_digest


def command_history_source_validate(args):
    if args.envelope_json != "-":
        history_source_fail("stdin_required")
    raw = sys.stdin.buffer.read(HISTORY_SOURCE_INPUT_HARD + 1)
    if len(raw) > HISTORY_SOURCE_INPUT_HARD:
        history_source_fail("input_too_large")

    def pairs(values):
        result = {}
        for key, value in values:
            if key in result:
                history_source_fail("duplicate_key")
            result[key] = value
        return result

    try:
        value = json.loads(raw.decode("utf-8"), object_pairs_hook=pairs)
    except UnicodeDecodeError:
        history_source_fail("invalid_utf8")
    except (json.JSONDecodeError, ValueError, RecursionError):
        history_source_fail("invalid_json")
    try:
        page_digest = validate_history_source(value)
    except RuntimeError:
        raise
    except (TypeError, ValueError, OverflowError, RecursionError):
        history_source_fail("invalid_schema")
    result = {"schema_version": 1, "status": "valid", "page_digest": page_digest}
    encoded = json.dumps(result, sort_keys=True, separators=(",", ":"), ensure_ascii=True)
    if len(encoded.encode()) > HISTORY_SOURCE_OUTPUT_HARD:
        history_source_fail("output_too_large")
    print(encoded)


def review_digest(candidates, snapshot, session_ceiling=None, part_ceiling=None, database_digest=None):
    candidates = [{key: value for key, value in candidate.items() if not key.startswith("_")}
                  if isinstance(candidate, dict) else candidate for candidate in candidates]
    return hashlib.sha256(json.dumps({"candidates": candidates, "snapshot": snapshot,
                                      "session_ceiling": session_ceiling, "part_ceiling": part_ceiling,
                                      "database_digest": database_digest},
                                     separators=(",", ":"), sort_keys=True).encode()).hexdigest()


def session_id_digest(session_id):
    return hashlib.sha256(b"dbsctr-review-root\0" + session_id.encode()).hexdigest()


def review_lock(root):
    path = root / "reviews" / ".lock"
    if path.parent.is_symlink():
        fail("private review directory is unsafe")
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(path.parent, 0o700)
    private_path(path.parent, stat.S_IFDIR, 0o700, "review directory")
    flags = os.O_RDWR | os.O_CREAT | os.O_APPEND | getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(path, flags, 0o600)
        details = os.fstat(descriptor)
        if stat.S_IFMT(details.st_mode) != stat.S_IFREG or details.st_uid != os.getuid():
            fail("private review lock is unsafe")
        os.fchmod(descriptor, 0o600)
        return os.fdopen(descriptor, "a+", encoding="utf-8")
    except Exception:
        if "descriptor" in locals():
            os.close(descriptor)
        raise


def open_existing_review_lock(path):
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
    descriptor = os.open(path, flags)
    try:
        details = os.fstat(descriptor)
        if stat.S_IFMT(details.st_mode) != stat.S_IFREG or details.st_uid != os.getuid():
            fail("private review lock is unsafe")
        return os.fdopen(descriptor, "r", encoding="utf-8")
    except Exception:
        os.close(descriptor)
        raise


def excluded_review_family(connection, session, session_id):
    """Return the caller's connected parent/child family without exposing IDs."""
    sid = sqlite_name(connection, session, ("id",))
    parent = sqlite_name(connection, session, ("parentid", "parent")) if any(
        row[1].lower().replace("_", "") in ("parentid", "parent")
        for row in connection.execute(f'PRAGMA table_info("{session}")')
    ) else None
    if parent is None:
        return {session_id}
    return {str(row[0]) for row in connection.execute(f"""
        WITH RECURSIVE edges(source, target) AS (
            SELECT "{sid}", "{parent}" FROM "{session}" WHERE "{parent}" IS NOT NULL
            UNION SELECT "{parent}", "{sid}" FROM "{session}" WHERE "{parent}" IS NOT NULL
        ), excluded(session_id) AS (
            SELECT "{sid}" FROM "{session}" WHERE "{sid}" = ?
            UNION
            SELECT edges.target FROM edges JOIN excluded ON edges.source = excluded.session_id
        ) SELECT session_id FROM excluded
    """, (session_id,))} or {session_id}


def native_v2(connection):
    """Select one native schema; retained V1 rows never override V2 authority."""
    deadline = time.monotonic() + 2
    connection.execute("PRAGMA busy_timeout=2000")
    connection.set_progress_handler(lambda: int(time.monotonic() >= deadline), 1000)
    if not connection.in_transaction:
        connection.execute("BEGIN")
    objects = {name.lower(): kind for name, kind in connection.execute("SELECT name,type FROM sqlite_master")}
    if "session_v2" not in objects:
        return False
    required = {"session_v2": {"id", "parent_id", "agent"},
                "session_message": {"id", "session_id", "type", "seq", "data"}}
    for table, columns in required.items():
        if (objects.get(table) != "table" or not columns <= {
                row[1] for row in connection.execute(f'PRAGMA table_info("{table}")')}):
            fail("OpenCode native schema unavailable")
    if "session" in objects:
        if objects.get("kv") != "table":
            fail("OpenCode native conversion incomplete")
        row = connection.execute("SELECT substr(value,1,4097) FROM kv WHERE key='migration.v1-v2'").fetchone()
        try:
            value = json.loads(row[0], object_pairs_hook=no_duplicate_keys) if row and len(row[0]) <= 4096 else None
        except (ValueError, TypeError):
            value = None
        if not isinstance(value, dict) or value != {"phase": "completed"}:
            fail("OpenCode native conversion incomplete")
    return True


def native_v2_message(connection, message_id, *, assistant=False, primary=False):
    """Read scalar authority only; JSON bodies and tool output stay in SQLite."""
    if not isinstance(message_id, str) or not OPAQUE_ID.fullmatch(message_id):
        fail("OpenCode native identity unavailable")
    valid = connection.execute("SELECT json_valid(data) FROM session_message WHERE id=?", (message_id,)).fetchall()
    if valid != [(1,)]:
        fail("OpenCode native identity unavailable")
    duplicate = connection.execute(
        "SELECT 1 FROM session_message m,json_tree(m.data) j WHERE m.id=? AND typeof(j.key)='text' "
        "GROUP BY j.parent,j.key HAVING count(*)>1 LIMIT 1", (message_id,)).fetchone()
    if duplicate:
        fail("OpenCode native identity unavailable")
    rows = connection.execute(
        "SELECT s.id,s.parent_id,s.agent,m.type,json_extract(m.data,'$.agent'),"
        "json_extract(m.data,'$.model.providerID'),json_extract(m.data,'$.model.id') "
        "FROM session_message m JOIN session_v2 s ON s.id=m.session_id WHERE m.id=? LIMIT 2",
        (message_id,)).fetchall()
    if len(rows) != 1:
        fail("OpenCode native identity unavailable")
    session, parent, selected_agent, kind, actor, provider, model = rows[0]
    if (not isinstance(session, str) or not OPAQUE_ID.fullmatch(session)
            or parent is not None and (not isinstance(parent, str) or not OPAQUE_ID.fullmatch(parent))
            or primary and parent is not None):
        fail("OpenCode native identity unavailable")
    if assistant and (kind != "assistant" or not isinstance(actor, str) or not OPAQUE_ID.fullmatch(actor)
                      or selected_agent is not None and selected_agent != actor):
        fail("OpenCode native actor unavailable")
    return session, parent, actor, provider, model


def native_session_actor(database_value, session_id, message_id=None):
    connection = None
    try:
        connection = sqlite3.connect(opencode_database(database_value).as_uri() + "?mode=ro", uri=True)
        if not native_v2(connection):
            return connection.execute("SELECT parent_id,agent FROM session WHERE id=?", (session_id,)).fetchone()
        if message_id is None:
            row = connection.execute("SELECT id FROM session_message WHERE session_id=? AND type='assistant' "
                                     "ORDER BY seq DESC,id DESC LIMIT 1", (session_id,)).fetchone()
            if not row:
                fail("OpenCode native actor unavailable")
            message_id = row[0]
        session, parent, actor, _, _ = native_v2_message(connection, message_id, assistant=True)
        if session != session_id:
            fail("OpenCode native identity unavailable")
        return parent, actor
    except sqlite3.Error:
        fail("OpenCode native actor unavailable")
    finally:
        if connection is not None:
            connection.close()


def session_for_message(database_value, message_id, require_primary=False):
    if not OPAQUE_ID.fullmatch(message_id):
        fail("invalid excluded message ID")
    database = opencode_database(database_value)
    if not database.is_file():
        fail("OpenCode database is missing")
    try:
        connection = sqlite3.connect(f"file:{database}?mode=ro", uri=True)
        if native_v2(connection):
            return native_v2_message(connection, message_id, primary=require_primary)[0]
        tables = {row[0].lower(): row[0] for row in connection.execute("SELECT name FROM sqlite_master WHERE type='table'")}
        if "message" not in tables:
            fail("OpenCode database lacks required message table")
        message = tables["message"]
        mid = sqlite_name(connection, message, ("id",))
        session = sqlite_name(connection, message, ("sessionid",))
        row = connection.execute(f'SELECT "{session}" FROM "{message}" WHERE "{mid}" = ?', (message_id,)).fetchone()
        if row is None or not isinstance(row[0], str) or not OPAQUE_ID.fullmatch(row[0]):
            fail("OpenCode message has no valid session")
        session_id = row[0]
        if require_primary:
            if "session" not in tables:
                fail("OpenCode database lacks required session table")
            session_table = tables["session"]
            session_pk = sqlite_name(connection, session_table, ("id",))
            parent = sqlite_name(connection, session_table, ("parentid", "parent"))
            owner = connection.execute(
                f'SELECT "{parent}" FROM "{session_table}" WHERE "{session_pk}" = ?', (session_id,)).fetchone()
            if owner is None or owner[0] is not None:
                fail("runtime attachment requires a primary OpenCode session")
        return session_id
    except sqlite3.Error as error:
        fail("cannot read OpenCode native identity")
    finally:
        if 'connection' in locals():
            connection.close()


def harness_activation_for_message(database_value, message_id, raw):
    try:
        supplied = json.loads(raw, object_pairs_hook=no_duplicate_keys)
    except (TypeError, json.JSONDecodeError) as error:
        fail(f"invalid harness activation: {error}")
    if (not isinstance(supplied, dict) or set(supplied) != {"schema_version", "core_revision", "overlays"}
            or supplied.get("schema_version") != HARNESS_ACTIVATION_SCHEMA
            or not OPAQUE_ID.fullmatch(supplied.get("core_revision", ""))
            or not isinstance(supplied.get("overlays"), dict)
            or set(supplied["overlays"]) != {"build", "build-gpt", "build-claude"}
            or any(not OPAQUE_ID.fullmatch(value) for value in supplied["overlays"].values())):
        fail("invalid harness activation")
    database = opencode_database(database_value)
    try:
        connection = sqlite3.connect(f"file:{database}?mode=ro", uri=True)
        if native_v2(connection):
            _, _, actor, provider_id, model_id = native_v2_message(
                connection, message_id, assistant=True, primary=True)
            if (actor not in supplied["overlays"] or not isinstance(provider_id, str)
                    or not OPAQUE_ID.fullmatch(provider_id) or not isinstance(model_id, str)
                    or not ACTIVATION_MODEL_ID.fullmatch(model_id)):
                fail("OpenCode message has no exact V2 activation")
            expected = {"build-gpt": "openai", "build-claude": "google-vertex"}.get(actor)
            if expected is not None and provider_id != expected:
                fail("OpenCode harness provider does not match its primary agent")
            return {"schema_version": HARNESS_ACTIVATION_SCHEMA, "provider_id": provider_id,
                    "model_id": model_id, "agent_id": actor, "core_revision": supplied["core_revision"],
                    "overlay_revision": supplied["overlays"][actor]}
        tables = {row[0].lower(): row[0] for row in connection.execute(
            "SELECT name FROM sqlite_master WHERE type='table'")}
        if not {"session", "message"} <= set(tables):
            fail("OpenCode database lacks required session/message tables")
        session, message = tables["session"], tables["message"]
        sid, agent = sqlite_name(connection, session, ("id",)), sqlite_name(connection, session, ("agent",))
        mid, msession = sqlite_name(connection, message, ("id",)), sqlite_name(connection, message, ("sessionid",))
        data = sqlite_name(connection, message, ("data", "text", "content"))
        row = connection.execute(
            f'SELECT s."{agent}", m."{data}" FROM "{message}" m JOIN "{session}" s '
            f'ON s."{sid}"=m."{msession}" WHERE m."{mid}"=?', (message_id,)).fetchone()
        if row is None or row[0] not in supplied["overlays"]:
            fail("OpenCode message has no supported harness agent")
        body = json.loads(row[1], object_pairs_hook=no_duplicate_keys)
        if not isinstance(body, dict):
            fail("OpenCode message has no exact provider/model identity")
        model = body.get("model")
        provider_id = model.get("providerID") if isinstance(model, dict) else body.get("providerID")
        model_id = model.get("modelID") if isinstance(model, dict) else body.get("modelID")
        if (not isinstance(provider_id, str) or not OPAQUE_ID.fullmatch(provider_id)
                or not isinstance(model_id, str) or not ACTIVATION_MODEL_ID.fullmatch(model_id)):
            fail("OpenCode message has no exact provider/model identity")
        expected = {"build-gpt": "openai", "build-claude": "google-vertex-anthropic"}.get(row[0])
        if expected is not None and provider_id != expected:
            fail("OpenCode harness provider does not match its primary agent")
        return {"schema_version": HARNESS_ACTIVATION_SCHEMA, "provider_id": provider_id,
                "model_id": model_id, "agent_id": row[0], "core_revision": supplied["core_revision"],
                "overlay_revision": supplied["overlays"][row[0]]}
    except (sqlite3.Error, json.JSONDecodeError) as error:
        fail("cannot read harness activation")
    finally:
        if 'connection' in locals():
            connection.close()


def historical_excluded_family(database_value, session_id, message_id=None):
    if session_id is None and message_id is None:
        return set()
    if session_id is not None and not OPAQUE_ID.fullmatch(session_id):
        fail("invalid excluded session ID")
    database = opencode_database(database_value)
    if not database.is_file():
        fail("OpenCode database is missing")
    try:
        connection = sqlite3.connect(f"file:{database}?mode=ro", uri=True)
        tables = {row[0].lower(): row[0] for row in connection.execute("SELECT name FROM sqlite_master WHERE type='table'")}
        if "session" not in tables:
            fail("OpenCode database lacks required session table")
        roots = {value for value in (session_id, session_for_message(database_value, message_id)
                                     if message_id is not None else None) if value is not None}
        return set().union(*(excluded_review_family(connection, tables["session"], value) for value in roots))
    except sqlite3.Error as error:
        fail(f"cannot read OpenCode database: {error}")
    finally:
        if 'connection' in locals():
            connection.close()


def history_dir(root, name="", create=False):
    path = root / "reviews" / "history" / name
    if create:
        path.mkdir(parents=True, exist_ok=True, mode=0o700)
        os.chmod(path, 0o700)
    return path


def history_id(value, name="history ID"):
    if not isinstance(value, str) or not OPAQUE_ID.fullmatch(value):
        fail(f"invalid {name}")
    return value


def history_digest(value, name="digest"):
    if not isinstance(value, str) or not re.fullmatch(r"[0-9a-f]{64}", value):
        fail(f"invalid history {name}")
    return value


def model_family(value):
    name = value.rsplit("/", 1)[-1].lower()
    for family in ("gpt", "claude", "gemini", "llama", "mistral", "qwen"):
        if re.search(rf"(?:^|[._-]){family}(?:[._-]|$)", name):
            return family
    return "unavailable"


def ledger_path(root):
    return root / "reviews" / "ledger.sqlite3"


def ledger_exists(root):
    path = ledger_path(root)
    if path.exists() or path.is_symlink():
        private_path(path.parent, stat.S_IFDIR, 0o700, "review directory")
        private_path(path, stat.S_IFREG, 0o600, "review ledger")
    return path.is_file()


def private_path(path, kind, mode, name):
    try:
        details = path.lstat()
    except OSError as error:
        fail(f"cannot inspect private {name}: {error}")
    if stat.S_IFMT(details.st_mode) != kind or details.st_uid != os.getuid() or stat.S_IMODE(details.st_mode) != mode:
        fail(f"private {name} is unsafe")
    return path


def private_legacy_file(root, path):
    reviews = root / "reviews"
    private_path(reviews, stat.S_IFDIR, 0o700, "review directory")
    parent = path.parent
    while parent != reviews:
        if reviews not in parent.parents:
            fail("legacy private review path is outside its store")
        private_path(parent, stat.S_IFDIR, 0o700, "legacy review directory")
        parent = parent.parent
    private_path(path, stat.S_IFREG, 0o600, "legacy review file")
    return path


def ledger_connection(root, write=False, path=None):
    path = path or ledger_path(root)
    private_path(path.parent, stat.S_IFDIR, 0o700, "ledger directory")
    private_path(path, stat.S_IFREG, 0o600, "review ledger")
    details = path.stat()
    identity = (details.st_dev, details.st_ino, details.st_size, details.st_mtime_ns)
    receipt_key = str(path.resolve())
    try:
        connection = sqlite3.connect(str(path) if write else f"file:{path}?mode=ro", uri=not write)
        connection.execute("PRAGMA foreign_keys=ON")
        connection.execute("PRAGMA busy_timeout=5000")
        if write:
            connection.execute("PRAGMA synchronous=FULL")
            connection.execute("PRAGMA journal_mode=DELETE")
        row = connection.execute("SELECT value FROM ledger_meta WHERE key='schema_version'").fetchone()
        if row != (str(REVIEW_LEDGER_SCHEMA),):
            fail("private review ledger has an unsupported schema")
        improvement_schema = connection.execute(
            "SELECT value FROM ledger_meta WHERE key='improvement_schema'").fetchone()
        if write and improvement_schema in (("1",), ("2",), ("3",), ("4",)):
            if connection.execute("PRAGMA integrity_check").fetchone() != ("ok",):
                fail("private review ledger integrity check failed")
            if connection.execute("PRAGMA foreign_key_check").fetchone() is not None:
                fail("private review ledger foreign-key check failed")
            ensure_improvement_schema(connection)
        if write:
            ensure_capture_schema(connection)
        if write or LEDGER_INTEGRITY_RECEIPTS.get(receipt_key) != identity:
            ledger_integrity(connection)
            if write:
                LEDGER_INTEGRITY_RECEIPTS.pop(receipt_key, None)
            else:
                LEDGER_INTEGRITY_RECEIPTS[receipt_key] = identity
        if write:
            ensure_knowledge_privacy_schema(connection)
            ensure_incident_schema(connection)
        return connection
    except (sqlite3.Error, RuntimeError):
        if "connection" in locals():
            connection.close()
        raise


def ledger_schema(connection):
    connection.executescript("""
        CREATE TABLE ledger_meta (
            key TEXT PRIMARY KEY,
            value TEXT NOT NULL
        ) WITHOUT ROWID;
        CREATE TABLE review_reports (
            report_id TEXT PRIMARY KEY,
            reviewed_at INTEGER NOT NULL,
            payload TEXT NOT NULL
        ) WITHOUT ROWID;
        CREATE TABLE review_report_sessions (
            report_id TEXT NOT NULL REFERENCES review_reports(report_id) ON DELETE CASCADE,
            position INTEGER NOT NULL,
            session_id TEXT NOT NULL,
            PRIMARY KEY (report_id, position),
            UNIQUE (report_id, session_id)
        ) WITHOUT ROWID;
        CREATE TABLE review_report_cycles (
            report_id TEXT NOT NULL REFERENCES review_reports(report_id) ON DELETE CASCADE,
            position INTEGER NOT NULL,
            cycle_id TEXT NOT NULL,
            PRIMARY KEY (report_id, position),
            UNIQUE (report_id, cycle_id)
        ) WITHOUT ROWID;
        CREATE TABLE review_tombstones (
            kind TEXT NOT NULL CHECK (kind IN ('session', 'cycle', 'forgotten_session')),
            item_id TEXT NOT NULL,
            timestamp INTEGER NOT NULL,
            PRIMARY KEY (kind, item_id)
        ) WITHOUT ROWID;
        CREATE TABLE history_evidence (
            session_id TEXT PRIMARY KEY,
            completed_at INTEGER NOT NULL,
            payload TEXT NOT NULL
        ) WITHOUT ROWID;
        CREATE TABLE history_reports (
            report_id TEXT PRIMARY KEY,
            kind TEXT NOT NULL CHECK (kind IN ('report', 'cohort')),
            payload TEXT NOT NULL
        ) WITHOUT ROWID;
        CREATE TABLE history_report_members (
            report_id TEXT NOT NULL REFERENCES history_reports(report_id) ON DELETE CASCADE,
            position INTEGER NOT NULL,
            session_id TEXT NOT NULL,
            PRIMARY KEY (report_id, position),
            UNIQUE (report_id, session_id)
        ) WITHOUT ROWID;
        CREATE TABLE ledger_entries (
            scope TEXT NOT NULL CHECK (scope IN ('operational', 'history')),
            report_id TEXT NOT NULL,
            category TEXT NOT NULL CHECK (category IN ('finding', 'scorecard', 'trend', 'proposal', 'caveat')),
            position INTEGER NOT NULL,
            text TEXT NOT NULL,
            PRIMARY KEY (scope, report_id, category, position)
        ) WITHOUT ROWID;
        CREATE TABLE knowledge_privacy_tombstones (
            family TEXT NOT NULL,
            item_id TEXT NOT NULL,
            reason TEXT NOT NULL,
            timestamp INTEGER NOT NULL,
            PRIMARY KEY (family, item_id)
        ) WITHOUT ROWID;
        CREATE TABLE incidents (
            incident_id TEXT PRIMARY KEY,
            session_id TEXT NOT NULL UNIQUE,
            parent_session_id TEXT NOT NULL,
            message_id TEXT NOT NULL,
            kind TEXT NOT NULL CHECK (kind IN ('defect','friction','behavior_gap','capability_idea')),
            title TEXT NOT NULL,
            summary TEXT NOT NULL,
            state TEXT NOT NULL CHECK (state IN ('open','investigating','fixing','resolved','dismissed')),
            cycle_id TEXT,
            diagnostics TEXT NOT NULL,
            evidence TEXT NOT NULL,
            created_at INTEGER NOT NULL,
            updated_at INTEGER NOT NULL
        ) WITHOUT ROWID;
        CREATE TABLE incident_signal_dispositions (
            signal_id TEXT PRIMARY KEY,
            incident_id TEXT REFERENCES incidents(incident_id) ON DELETE SET NULL,
            disposition TEXT NOT NULL CHECK (disposition IN ('promoted','forgotten')),
            timestamp INTEGER NOT NULL
        ) WITHOUT ROWID;
    """)
    connection.execute("INSERT INTO ledger_meta VALUES ('schema_version', ?)", (str(REVIEW_LEDGER_SCHEMA),))
    connection.execute("INSERT INTO ledger_meta VALUES ('incident_schema', ?)", (str(INCIDENT_SCHEMA),))
    empty = hashlib.sha256(ledger_payload(
        {"schema_version": 1, "tombstones": []}).encode()).hexdigest()
    connection.execute("INSERT INTO ledger_meta VALUES ('knowledge_privacy_sequence', '0')")
    connection.execute("INSERT INTO ledger_meta VALUES ('knowledge_privacy_digest', ?)", (empty,))


def ledger_integrity(connection):
    if connection.execute("PRAGMA integrity_check").fetchone() != ("ok",):
        fail("private review ledger integrity check failed")
    if connection.execute("PRAGMA foreign_key_check").fetchone() is not None:
        fail("private review ledger foreign-key check failed")
    ledger_semantic_integrity(connection)


def ledger_semantic_integrity(connection):
    meta = dict(connection.execute("SELECT key, value FROM ledger_meta"))
    if (set(meta) - {"schema_version", "migration_digest", "pending_forget_cleanup", "improvement_schema", "capture_schema", "benchmark_schema", "phase_schema", "provider_evaluation_schema", "incident_schema", "knowledge_privacy_sequence", "knowledge_privacy_digest", "workflow_operation_schema"}
            or meta.get("schema_version") != str(REVIEW_LEDGER_SCHEMA)
            or "migration_digest" in meta and not re.fullmatch(r"[0-9a-f]{64}", meta["migration_digest"])
            or "pending_forget_cleanup" in meta
            and not re.fullmatch(r"\.forget-[0-9a-f]{32}", meta["pending_forget_cleanup"])
            or "improvement_schema" in meta and meta["improvement_schema"] != str(IMPROVEMENT_SCHEMA)
            or "capture_schema" in meta and meta["capture_schema"] != str(CAPTURE_SCHEMA)
            or "benchmark_schema" in meta and meta["benchmark_schema"] != str(BENCHMARK_SCHEMA)
            or "phase_schema" in meta and meta["phase_schema"] != str(PHASE_SCHEMA)
            or "provider_evaluation_schema" in meta
            and meta["provider_evaluation_schema"] != str(PROVIDER_EVALUATION_SCHEMA)
            or "incident_schema" in meta and meta["incident_schema"] != str(INCIDENT_SCHEMA)
            or "knowledge_privacy_sequence" in meta
            and (not meta["knowledge_privacy_sequence"].isdigit()
                 or not 0 <= int(meta["knowledge_privacy_sequence"]) < 2**64)
            or "knowledge_privacy_digest" in meta
            and not re.fullmatch(r"[0-9a-f]{64}", meta["knowledge_privacy_digest"])):
        fail("private review ledger metadata is invalid")
    workflow_table = connection.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='workflow_operations'").fetchone()
    if bool(workflow_table) != ("workflow_operation_schema" in meta):
        fail("unsupported_schema")
    if workflow_table:
        if meta["workflow_operation_schema"] != "1":
            fail("unsupported_schema")
        for identifier, payload in connection.execute("SELECT event_id, payload FROM workflow_operations"):
            event = json.loads(payload, object_pairs_hook=no_duplicate_keys)
            validate_workflow_operation(event)
            if identifier != event["event_id"]:
                fail("unsupported_schema")
    privacy_table = connection.execute(
        "SELECT 1 FROM sqlite_master WHERE type='table' "
        "AND name='knowledge_privacy_tombstones'").fetchone() is not None
    privacy_meta = {"knowledge_privacy_sequence", "knowledge_privacy_digest"}.intersection(meta)
    if privacy_table != (privacy_meta == {"knowledge_privacy_sequence", "knowledge_privacy_digest"}):
        fail("private review ledger privacy schema is incomplete")
    if privacy_table:
        for family, item_id, reason, timestamp in knowledge_privacy_rows(connection):
            if (not OPAQUE_ID.fullmatch(family) or not OPAQUE_ID.fullmatch(item_id)
                    or not OPAQUE_ID.fullmatch(reason) or not isinstance(timestamp, int)
                    or timestamp < REVIEW_START_MS):
                fail("private review ledger contains an invalid privacy tombstone")
        if meta["knowledge_privacy_digest"] != knowledge_privacy_digest(connection):
            fail("private review ledger privacy digest mismatch")
    incident_tables = {row[0] for row in connection.execute(
        "SELECT name FROM sqlite_master WHERE type='table' AND name IN "
        "('incidents','incident_signal_dispositions')")}
    if (incident_tables not in (set(), {"incidents", "incident_signal_dispositions"})
            or bool(incident_tables) != (meta.get("incident_schema") == str(INCIDENT_SCHEMA))):
        fail("private review ledger incident schema is incomplete")
    if incident_tables:
        for row in connection.execute(
                "SELECT incident_id,session_id,parent_session_id,message_id,kind,title,summary,state,cycle_id,"
                "diagnostics,evidence,created_at,updated_at FROM incidents"):
            incident_record(row)
        for signal_id, incident_id, disposition, timestamp in connection.execute(
                "SELECT signal_id,incident_id,disposition,timestamp FROM incident_signal_dispositions"):
            if (not re.fullmatch(r"[0-9a-f]{24}", signal_id)
                    or incident_id is not None and not re.fullmatch(r"[0-9a-f]{24}", incident_id)
                    or disposition not in ("promoted", "forgotten")
                    or type(timestamp) is not int or timestamp < REVIEW_START_MS):
                fail("private review ledger incident signal is invalid")
    names = {"session": "sessions", "cycle": "cycles", "forgotten_session": "forgotten_sessions"}
    tombstones = {"schema_version": 1, "sessions": {}, "cycles": {}, "forgotten_sessions": {}}
    for kind, item_id, timestamp in connection.execute(
            "SELECT kind, item_id, timestamp FROM review_tombstones"):
        if kind not in names:
            fail("private review ledger contains an invalid tombstone")
        tombstones[names[kind]][item_id] = timestamp
    for values in (tombstones["sessions"], tombstones["cycles"], tombstones["forgotten_sessions"]):
        if not all(isinstance(key, str) and OPAQUE_ID.fullmatch(key) and isinstance(timestamp, int)
                   and timestamp >= REVIEW_START_MS for key, timestamp in values.items()):
            fail("private review ledger contains an invalid tombstone")
    expected_entries = set()
    categories = {"findings": "finding", "scorecards": "scorecard", "trends": "trend",
                  "proposals": "proposal", "caveats": "caveat"}
    for report_id, timestamp, payload in connection.execute(
            "SELECT report_id, reviewed_at, payload FROM review_reports"):
        report, _ = validate_review_report(json.loads(payload, object_pairs_hook=no_duplicate_keys),
                                           f"{report_id}.json", timestamp)
        sessions = [row[0] for row in connection.execute(
            "SELECT session_id FROM review_report_sessions WHERE report_id=? ORDER BY position", (report_id,))]
        cycles = [row[0] for row in connection.execute(
            "SELECT cycle_id FROM review_report_cycles WHERE report_id=? ORDER BY position", (report_id,))]
        if sessions != report["session_ids"] or cycles != report.get("cycle_ids", []):
            fail("private review ledger report membership mismatch")
        expected_entries.update(("operational", report_id, category, position, text)
                                for field, category in categories.items()
                                for position, text in enumerate(report.get(field, [])))
    for session_id, completed_at, payload in connection.execute(
            "SELECT session_id, completed_at, payload FROM history_evidence"):
        evidence = validate_history_evidence(json.loads(payload, object_pairs_hook=no_duplicate_keys))
        if evidence["session_id"] != session_id or int(evidence["completed_at"]) != completed_at:
            fail("private review ledger history evidence mismatch")
    for report_id, _, payload in connection.execute("SELECT report_id, kind, payload FROM history_reports"):
        report = validate_history_report(json.loads(payload, object_pairs_hook=no_duplicate_keys))
        members = [row[0] for row in connection.execute(
            "SELECT session_id FROM history_report_members WHERE report_id=? ORDER BY position", (report_id,))]
        if report["report_id"] != report_id or members != report["cohort"]:
            fail("private review ledger history membership mismatch")
        expected_entries.update(("history", report_id, category, position, text)
                                for field, category in categories.items()
                                for position, text in enumerate(report.get(field, [])))
    actual_entries = set(connection.execute(
        "SELECT scope, report_id, category, position, text FROM ledger_entries"))
    if actual_entries != expected_entries:
        fail("private review ledger entry mismatch")
    if "improvement_schema" in meta:
        improvement_integrity(connection)
    if "capture_schema" in meta:
        capture_integrity(connection)
    if "benchmark_schema" in meta:
        benchmark_integrity(connection)
    if "phase_schema" in meta:
        phase_integrity(connection)
    if "provider_evaluation_schema" in meta:
        provider_evaluation_integrity(connection)


def ensure_improvement_schema(connection):
    row = connection.execute("SELECT value FROM ledger_meta WHERE key='improvement_schema'").fetchone()
    if row == (str(IMPROVEMENT_SCHEMA),):
        return
    if row == ("1",):
        try:
            connection.execute("BEGIN IMMEDIATE")
            connection.execute("ALTER TABLE improvement_workers ADD COLUMN priority TEXT "
                               "CHECK (priority IN ('P0','P1','P2','P3'))")
            connection.execute("UPDATE improvement_workers SET priority="
                               "CASE WHEN state='claimed' THEN 'P2' ELSE 'P1' END "
                               "WHERE opportunity_id IS NOT NULL")
            connection.execute("UPDATE ledger_meta SET value='2' WHERE key='improvement_schema'")
            connection.commit()
            row = ("2",)
        except Exception:
            connection.rollback()
            raise
    if row == ("2",):
        try:
            connection.execute("BEGIN IMMEDIATE")
            connection.execute("ALTER TABLE improvement_workers ADD COLUMN authorization TEXT NOT NULL "
                               "DEFAULT 'none' CHECK (authorization IN ('none','autonomous','operator'))")
            connection.execute("UPDATE improvement_workers SET authorization='operator' "
                               "WHERE state NOT IN ('reviewing','claimed','abandoned')")
            connection.execute("UPDATE ledger_meta SET value='3' WHERE key='improvement_schema'")
            connection.commit()
            row = ("3",)
        except Exception:
            connection.rollback()
            raise
    if row == ("3",):
        try:
            connection.execute("BEGIN IMMEDIATE")
            connection.execute("ALTER TABLE improvement_workers ADD COLUMN readiness TEXT")
            connection.execute("UPDATE improvement_workers SET authorization='operator' "
                               "WHERE authorization='autonomous'")
            connection.execute("UPDATE ledger_meta SET value='4' WHERE key='improvement_schema'")
            connection.commit()
            row = ("4",)
        except Exception:
            connection.rollback()
            raise
    if row == ("4",):
        try:
            connection.execute("BEGIN IMMEDIATE")
            connection.execute("ALTER TABLE improvement_workers ADD COLUMN kind TEXT "
                               "CHECK (kind IN ('fix','feature','process'))")
            connection.execute("ALTER TABLE improvement_workers ADD COLUMN measurement_plan TEXT")
            connection.execute("ALTER TABLE improvement_workers ADD COLUMN discovery_report TEXT")
            connection.execute("ALTER TABLE improvement_workers ADD COLUMN implementation_report TEXT")
            connection.execute("UPDATE improvement_workers SET kind='fix' WHERE opportunity_id IS NOT NULL")
            connection.execute("UPDATE ledger_meta SET value=? WHERE key='improvement_schema'",
                               (str(IMPROVEMENT_SCHEMA),))
            connection.commit()
            return
        except Exception:
            connection.rollback()
            raise
    if row is not None:
        fail("private improvement ledger has an unsupported schema")
    workers = """CREATE TABLE improvement_workers (
            worker_id TEXT PRIMARY KEY,
            session_id TEXT NOT NULL UNIQUE,
            opportunity_id TEXT UNIQUE,
            summary TEXT,
            priority TEXT CHECK (priority IN ('P0','P1','P2','P3')),
            kind TEXT CHECK (kind IN ('fix','feature','process')),
            measurement_plan TEXT,
            discovery_report TEXT,
            implementation_report TEXT,
            authorization TEXT NOT NULL DEFAULT 'none' CHECK (authorization IN ('none','autonomous','operator')),
            readiness TEXT,
            state TEXT NOT NULL CHECK (state IN (
                'reviewing', 'claimed', 'discovery', 'implementing', 'draft_pr',
                'blocked', 'merged', 'closed', 'abandoned'
            )),
            resume_state TEXT NOT NULL CHECK (resume_state IN (
                'reviewing', 'claimed', 'discovery', 'implementing', 'draft_pr'
            )),
            recovery_attempts INTEGER NOT NULL DEFAULT 0 CHECK (recovery_attempts BETWEEN 0 AND 3),
            workspace_id TEXT,
            tab_id TEXT,
            pane_id TEXT,
            cycle_id TEXT,
            pr_number INTEGER,
            pr_url TEXT,
            created_at INTEGER NOT NULL,
            updated_at INTEGER NOT NULL
        ) WITHOUT ROWID"""
    scope = """CREATE TABLE improvement_scope (
            worker_id TEXT NOT NULL REFERENCES improvement_workers(worker_id) ON DELETE CASCADE,
            path TEXT NOT NULL,
            PRIMARY KEY (worker_id, path)
        ) WITHOUT ROWID"""
    try:
        connection.execute("BEGIN IMMEDIATE")
        connection.execute(workers)
        connection.execute(scope)
        connection.execute("INSERT INTO ledger_meta VALUES ('improvement_schema', ?)",
                           (str(IMPROVEMENT_SCHEMA),))
        connection.commit()
    except Exception:
        connection.rollback()
        raise


def improvement_integrity(connection):
    expected_tables = {"improvement_workers", "improvement_scope"}
    tables = {row[0] for row in connection.execute(
        "SELECT name FROM sqlite_master WHERE type='table' AND name LIKE 'improvement_%'")}
    if tables != expected_tables:
        fail("private improvement ledger tables are invalid")
    for row in connection.execute("""
            SELECT worker_id, session_id, opportunity_id, summary, priority, kind, measurement_plan,
                   discovery_report, implementation_report, authorization, readiness, state, resume_state,
                   recovery_attempts, workspace_id, tab_id, pane_id, cycle_id,
                   pr_number, pr_url, created_at, updated_at
            FROM improvement_workers
    """):
        (worker_id, session_id, opportunity_id, summary, priority, kind, measurement_plan,
         discovery_report, implementation_report, authorization, readiness, state, resume_state, attempts, *rest) = row
        presentation_ids, cycle_id = rest[:3], rest[3]
        pr_number, pr_url, created_at, updated_at = rest[4:]
        if (not OPAQUE_ID.fullmatch(worker_id) or not OPAQUE_ID.fullmatch(session_id)
                or opportunity_id is not None and not re.fullmatch(r"[0-9a-f]{64}", opportunity_id)
                or summary is not None and (not isinstance(summary, str)
                                             or not 1 <= len(summary.encode()) <= 512 or review_unsafe(summary))
                or (opportunity_id is None) != (summary is None)
                or (opportunity_id is None) != (priority is None)
                or (opportunity_id is None) != (kind is None)
                or priority is not None and priority not in {"P0", "P1", "P2", "P3"}
                or kind is not None and kind not in {"fix", "feature", "process"}
                or kind == "feature" and measurement_plan is None
                or kind != "feature" and measurement_plan is not None
                or measurement_plan is not None and improvement_measurement_plan(measurement_plan) != measurement_plan
                or discovery_report is not None and improvement_discovery_report(discovery_report) != discovery_report
                or implementation_report is not None and improvement_implementation_report(implementation_report) != implementation_report
                or authorization not in {"none", "autonomous", "operator"}
                or readiness is not None and authorization != "autonomous"
                or authorization == "autonomous" and readiness is None
                or readiness is not None and improvement_readiness(
                    readiness, worker_id, session_id, opportunity_id) != readiness
                or state == "reviewing" and opportunity_id is not None
                or state in {"discovery", "implementing", "draft_pr"} and authorization == "none"
                or state not in IMPROVEMENT_STATES
                or resume_state not in IMPROVEMENT_RESUMABLE_STATES
                or not isinstance(attempts, int) or not 0 <= attempts <= 3
                or any(value is not None and not PRESENTATION_ID.fullmatch(value)
                       for value in presentation_ids)
                or cycle_id is not None and not OPAQUE_ID.fullmatch(cycle_id)
                or pr_number is not None and (not isinstance(pr_number, int) or pr_number < 1)
                or pr_url is not None and (not isinstance(pr_url, str) or len(pr_url) > 2048)
                or not isinstance(created_at, int) or not isinstance(updated_at, int)
                or created_at < REVIEW_START_MS or updated_at < created_at):
            fail("private improvement ledger contains an invalid worker")
    for worker_id, value in connection.execute("SELECT worker_id, path FROM improvement_scope"):
        if not OPAQUE_ID.fullmatch(worker_id) or improvement_path(value) != value:
            fail("private improvement ledger contains an invalid scope")


def ensure_capture_schema(connection):
    row = connection.execute("SELECT value FROM ledger_meta WHERE key='capture_schema'").fetchone()
    if row == (str(CAPTURE_SCHEMA),):
        return
    if row not in (None, ("1",)):
        fail("private history capture ledger has an unsupported schema")
    try:
        connection.execute("BEGIN IMMEDIATE")
        if row is None:
            connection.execute("""CREATE TABLE history_captures (
                capture_id TEXT PRIMARY KEY,
                payload TEXT NOT NULL
            ) WITHOUT ROWID""")
            connection.execute("""CREATE TABLE history_capture_members (
                capture_id TEXT NOT NULL REFERENCES history_captures(capture_id) ON DELETE CASCADE,
                position INTEGER NOT NULL,
                session_id TEXT NOT NULL,
                payload TEXT NOT NULL,
                PRIMARY KEY (capture_id, position),
                UNIQUE (capture_id, session_id)
            ) WITHOUT ROWID""")
        connection.execute("""CREATE TABLE history_capture_page_sources (
            capture_id TEXT NOT NULL REFERENCES history_captures(capture_id) ON DELETE CASCADE,
            cursor INTEGER NOT NULL,
            digest TEXT NOT NULL,
            PRIMARY KEY (capture_id, cursor)
        ) WITHOUT ROWID""")
        if row is None:
            connection.execute("INSERT INTO ledger_meta VALUES ('capture_schema', ?)", (str(CAPTURE_SCHEMA),))
        else:
            connection.execute("UPDATE ledger_meta SET value=? WHERE key='capture_schema'",
                               (str(CAPTURE_SCHEMA),))
        connection.commit()
    except Exception:
        connection.rollback()
        raise


def capture_integrity(connection):
    schema = connection.execute("SELECT value FROM ledger_meta WHERE key='capture_schema'").fetchone()
    expected = ({"history_captures", "history_capture_members", "history_capture_page_sources"}
                if schema == (str(CAPTURE_SCHEMA),) else {"history_captures", "history_capture_members"})
    tables = {row[0] for row in connection.execute(
        "SELECT name FROM sqlite_master WHERE type='table' AND name LIKE 'history_capture%'")}
    if tables != expected:
        fail("private history capture tables are invalid")
    for capture_id, payload in connection.execute("SELECT capture_id, payload FROM history_captures"):
        try:
            manifest = json.loads(payload, object_pairs_hook=no_duplicate_keys)
        except json.JSONDecodeError as error:
            fail(f"private history capture is malformed: {error}")
        if manifest.get("capture_id") != capture_id:
            fail("private history capture identity mismatch")
        members = history_capture_members(connection, capture_id)
        validate_history_capture(manifest, members)
    if "history_capture_page_sources" in expected:
        for capture_id, cursor, digest in connection.execute(
                "SELECT capture_id,cursor,digest FROM history_capture_page_sources"):
            if (not re.fullmatch(r"[0-9a-f]{24}", capture_id) or type(cursor) is not int or cursor < 0
                    or not re.fullmatch(r"[0-9a-f]{64}", digest)):
                fail("private history capture page source is invalid")


def history_capture_members(connection, capture_id):
    members = []
    for expected, (position, session_id, payload) in enumerate(connection.execute(
            "SELECT position, session_id, payload FROM history_capture_members "
            "WHERE capture_id=? ORDER BY position", (capture_id,))):
        try:
            record = json.loads(payload, object_pairs_hook=no_duplicate_keys)
        except json.JSONDecodeError as error:
            fail(f"private history capture member is malformed: {error}")
        if position != expected or record.get("session_id") != session_id:
            fail("private history capture member columns mismatch")
        members.append(record)
    return members


def ensure_provider_evaluation_schema(connection):
    row = connection.execute(
        "SELECT value FROM ledger_meta WHERE key='provider_evaluation_schema'").fetchone()
    if row == (str(PROVIDER_EVALUATION_SCHEMA),):
        return
    if row is not None:
        fail("private provider evaluation ledger has an unsupported schema")
    try:
        connection.execute("BEGIN IMMEDIATE")
        connection.execute("""CREATE TABLE provider_evaluation_reports (
            report_id TEXT PRIMARY KEY,
            rubric_key TEXT NOT NULL,
            harness_key TEXT NOT NULL,
            created_at INTEGER NOT NULL,
            payload TEXT NOT NULL
        ) WITHOUT ROWID""")
        connection.execute("""CREATE TABLE provider_evaluation_members (
            report_id TEXT NOT NULL REFERENCES provider_evaluation_reports(report_id) ON DELETE CASCADE,
            position INTEGER NOT NULL,
            rubric_key TEXT NOT NULL,
            harness_key TEXT NOT NULL,
            source_id TEXT NOT NULL,
            cycle_id TEXT NOT NULL,
            payload TEXT NOT NULL,
            PRIMARY KEY (report_id, position),
            UNIQUE (rubric_key, harness_key, source_id, cycle_id)
        ) WITHOUT ROWID""")
        connection.execute("""CREATE TABLE provider_evaluation_receipts (
            report_id TEXT PRIMARY KEY REFERENCES provider_evaluation_reports(report_id) ON DELETE CASCADE,
            payload TEXT NOT NULL
        ) WITHOUT ROWID""")
        connection.execute("""CREATE TABLE provider_evaluation_sources (
            source_id TEXT PRIMARY KEY,
            privacy_epoch_digest TEXT NOT NULL,
            availability TEXT NOT NULL CHECK (availability IN ('available', 'unavailable')),
            verified_at INTEGER NOT NULL
        ) WITHOUT ROWID""")
        connection.execute("INSERT INTO ledger_meta VALUES ('provider_evaluation_schema', ?)",
                           (str(PROVIDER_EVALUATION_SCHEMA),))
        connection.commit()
    except Exception:
        connection.rollback()
        raise


def validate_provider_evaluation_report(value):
    fields = {"schema_version", "report_id", "rubric", "harness_identity", "members", "evidence", "aggregates",
              "availability", "confounders", "findings", "recommendations", "created_at", "association_only"}
    if (not isinstance(value, dict) or set(value) != fields or value.get("schema_version") != 1
            or not re.fullmatch(r"[0-9a-f]{24}", value.get("report_id", ""))
            or value.get("association_only") is not True or type(value.get("created_at")) is not int
            or value["created_at"] < REVIEW_START_MS
            or not isinstance(value.get("members"), list) or len(value["members"]) != 5
            or not isinstance(value.get("evidence"), list) or not value["evidence"]
            or not isinstance(value.get("aggregates"), dict) or not isinstance(value.get("availability"), dict)
            or not isinstance(value.get("confounders"), list)
            or not all(isinstance(item, str) and OPAQUE_ID.fullmatch(item) for item in value["confounders"])):
        fail("provider evaluation report has an invalid schema")
    if (not isinstance(value.get("rubric"), dict) or set(value["rubric"]) != {"name", "version", "digest"}
            or not OPAQUE_ID.fullmatch(value["rubric"].get("name", ""))
            or not OPAQUE_ID.fullmatch(value["rubric"].get("version", ""))
            or not re.fullmatch(r"[0-9a-f]{64}", value["rubric"].get("digest", ""))):
        fail("provider evaluation report has an invalid rubric")
    validate_stored_harness_activation({"schema_version": 1, **value.get("harness_identity", {})})
    optional = {"tool_call_count", "tool_error_count", "provider_error_count", "delegation_count",
                "approval_count", "retry_count", "token_total", "cost_total"}
    required = {"elapsed_ms_median", "gate_failure_count", "gate_reopen_count", "remediation_round_count"}
    if (set(value["availability"]) != optional
            or any(status not in ("available", "unavailable") for status in value["availability"].values())
            or set(value["aggregates"]) != required | {name for name in optional
                                                        if value["availability"][name] == "available"}
            or any(not isinstance(item, (int, float)) or isinstance(item, bool) or not math.isfinite(item) or item < 0
                   for item in value["aggregates"].values())):
        fail("provider evaluation report has invalid aggregates")
    member_fields = {"source_id", "cycle_id", "completed_at", "context", "risk", "delivery_intent",
                     "provider_ids", "model_ids", "agent_ids", "metrics", "optional_metrics",
                     "telemetry_digest", "gate_digest"}
    for member in value["members"]:
        if (not isinstance(member, dict) or set(member) != member_fields
                or not PRESENTATION_ID.fullmatch(member.get("source_id", ""))
                or not OPAQUE_ID.fullmatch(member.get("cycle_id", ""))
                or type(member.get("completed_at")) is not int or member["completed_at"] < REVIEW_START_MS
                or not isinstance(member.get("context"), str)
                or member["context"] != "unavailable" and not OPAQUE_ID.fullmatch(member["context"])
                or member.get("risk") not in ("routine", "elevated", "critical")
                or member.get("delivery_intent") not in DELIVERY_INTENTS
                or any(not isinstance(member.get(name), list) or not member[name]
                       or member[name] != sorted(set(member[name]))
                       or any(not isinstance(item, str)
                              or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}", item)
                              for item in member[name])
                       for name in ("provider_ids", "model_ids", "agent_ids"))
                or set(member.get("optional_metrics", {})) != optional
                or any(item != "unavailable" and (not isinstance(item, (int, float))
                    or isinstance(item, bool) or not math.isfinite(item) or item < 0)
                       for item in member["optional_metrics"].values())
                or not re.fullmatch(r"[0-9a-f]{64}", member.get("telemetry_digest", ""))
                or not re.fullmatch(r"[0-9a-f]{64}", member.get("gate_digest", ""))):
            fail("provider evaluation report has invalid members")
        validate_cycle_metrics(member["metrics"])
    for source in value["evidence"]:
        if (not isinstance(source, dict)
                or set(source) != {"source_id", "capture_id", "privacy_epoch_digest", "query_digest",
                                   "exclusion_digest", "pages"}
                or not PRESENTATION_ID.fullmatch(source.get("source_id", ""))
                or not re.fullmatch(r"[0-9a-f]{24}", source.get("capture_id", ""))
                or not re.fullmatch(r"[0-9a-f]{64}", source.get("privacy_epoch_digest", ""))
                or not re.fullmatch(r"[0-9a-f]{64}", source.get("query_digest", ""))
                or source.get("exclusion_digest") is not None
                and not re.fullmatch(r"[0-9a-f]{64}", source["exclusion_digest"])
                or not isinstance(source.get("pages"), list) or not source["pages"]):
            fail("provider evaluation report has invalid evidence")
        for page in source["pages"]:
            if (not isinstance(page, dict) or set(page) != {"cursor", "digest", "member_digests"}
                    or type(page.get("cursor")) is not int or page["cursor"] < 0
                    or not re.fullmatch(r"[0-9a-f]{64}", page.get("digest", ""))
                    or not isinstance(page.get("member_digests"), list)
                    or any(not re.fullmatch(r"[0-9a-f]{64}", item) for item in page["member_digests"])):
                fail("provider evaluation report has invalid evidence")
    for name in ("findings", "recommendations"):
        items = value.get(name)
        if (not isinstance(items, list) or len(items) > 50 or any(not isinstance(item, str)
                or not 1 <= len(item.encode()) <= 512 or review_unsafe(item) for item in items)):
            fail("provider evaluation report has unsafe prose")
    return value


def provider_evaluation_integrity(connection):
    expected = {"provider_evaluation_reports", "provider_evaluation_members",
                "provider_evaluation_receipts", "provider_evaluation_sources"}
    tables = {row[0] for row in connection.execute(
        "SELECT name FROM sqlite_master WHERE type='table' AND name LIKE 'provider_evaluation_%'")}
    if tables != expected:
        fail("private provider evaluation tables are invalid")
    for report_id, rubric_key, harness_key, created_at, payload in connection.execute(
            "SELECT report_id,rubric_key,harness_key,created_at,payload FROM provider_evaluation_reports"):
        report = validate_provider_evaluation_report(json.loads(payload, object_pairs_hook=no_duplicate_keys))
        rows = list(connection.execute(
            "SELECT position,source_id,cycle_id,payload FROM provider_evaluation_members "
            "WHERE report_id=? ORDER BY position", (report_id,)))
        if (report["report_id"] != report_id or report["created_at"] != created_at or len(rows) != 5
                or any(position != expected_position for expected_position, (position, *_rest) in enumerate(rows))
                or [json.loads(row[3], object_pairs_hook=no_duplicate_keys) for row in rows] != report["members"]
                or hashlib.sha256(ledger_payload(report["rubric"]).encode()).hexdigest() != rubric_key
                or hashlib.sha256(ledger_payload(report["harness_identity"]).encode()).hexdigest() != harness_key):
            fail("private provider evaluation membership mismatch")
        receipt = connection.execute(
            "SELECT payload FROM provider_evaluation_receipts WHERE report_id=?", (report_id,)).fetchone()
        if receipt is None:
            fail("private provider evaluation receipt is missing")
        stored_receipt = validate_provider_evaluation_receipt(
            json.loads(receipt[0], object_pairs_hook=no_duplicate_keys))
        if report["evidence"] != provider_evaluation_evidence(stored_receipt):
            fail("private provider evaluation receipt mismatch")
    for source_id, digest, availability, verified_at in connection.execute(
            "SELECT source_id,privacy_epoch_digest,availability,verified_at FROM provider_evaluation_sources"):
        if (not PRESENTATION_ID.fullmatch(source_id) or not re.fullmatch(r"[0-9a-f]{64}", digest)
                or availability not in ("available", "unavailable") or type(verified_at) is not int
                or verified_at < REVIEW_START_MS):
            fail("private provider evaluation source state is invalid")


def ensure_benchmark_schema(connection):
    ensure_capture_schema(connection)
    row = connection.execute("SELECT value FROM ledger_meta WHERE key='benchmark_schema'").fetchone()
    if row == (str(BENCHMARK_SCHEMA),):
        return
    if row is not None:
        fail("private benchmark ledger has an unsupported schema")
    try:
        connection.execute("BEGIN IMMEDIATE")
        connection.execute("""CREATE TABLE benchmark_definitions (
            version TEXT PRIMARY KEY,
            metric_name TEXT NOT NULL,
            direction TEXT NOT NULL CHECK (direction IN ('higher', 'lower'))
        ) WITHOUT ROWID""")
        connection.execute("""CREATE TABLE benchmark_effects (
            benchmark_id TEXT PRIMARY KEY,
            definition_version TEXT NOT NULL REFERENCES benchmark_definitions(version),
            baseline_capture_id TEXT NOT NULL REFERENCES history_captures(capture_id),
            observation_capture_id TEXT NOT NULL REFERENCES history_captures(capture_id),
            activation_identity TEXT,
            payload TEXT NOT NULL
        ) WITHOUT ROWID""")
        connection.execute("INSERT INTO ledger_meta VALUES ('benchmark_schema', ?)",
                           (str(BENCHMARK_SCHEMA),))
        connection.commit()
    except Exception:
        connection.rollback()
        raise


def benchmark_integrity(connection):
    expected = {"benchmark_definitions", "benchmark_effects"}
    tables = {row[0] for row in connection.execute(
        "SELECT name FROM sqlite_master WHERE type='table' AND name LIKE 'benchmark_%'")}
    if tables != expected:
        fail("private benchmark ledger tables are invalid")
    definitions = {version: (metric, direction) for version, metric, direction in connection.execute(
        "SELECT version, metric_name, direction FROM benchmark_definitions")}
    if any(not OPAQUE_ID.fullmatch(version) or metric not in BENCHMARK_METRICS
           or direction not in ("higher", "lower")
           for version, (metric, direction) in definitions.items()):
        fail("private benchmark definitions are invalid")
    merges, activations = {}, {}
    for benchmark_id, version, baseline, observation, activation, payload in connection.execute(
            "SELECT benchmark_id, definition_version, baseline_capture_id, observation_capture_id, "
            "activation_identity, payload FROM benchmark_effects"):
        try:
            report = json.loads(payload, object_pairs_hook=no_duplicate_keys)
        except json.JSONDecodeError as error:
            fail(f"private benchmark evidence is malformed: {error}")
        validate_benchmark(report)
        merge_identity = report["inputs"]["merge_identity"]
        merged_at = report["inputs"]["merged_at"]
        if merge_identity in merges and merges[merge_identity] != merged_at:
            fail("private benchmark merge identity is inconsistent")
        merges[merge_identity] = merged_at
        if report["inputs"]["activation_status"] == "verified":
            verified_activation = (report["inputs"]["activation_identity"], report["inputs"]["activated_at"])
            if merge_identity in activations and activations[merge_identity] != verified_activation:
                fail("private benchmark activation identity is inconsistent")
            activations[merge_identity] = verified_activation
        if (report["benchmark_id"] != benchmark_id or report["definition"]["version"] != version
                or report["definition"]["metric"] != definitions.get(version, (None, None))[0]
                or report["definition"]["direction"] != definitions.get(version, (None, None))[1]
                or report["inputs"]["baseline_capture_id"] != baseline
                or report["inputs"]["observation_capture_id"] != observation
                or report["inputs"]["activation_identity"] != activation):
            fail("private benchmark evidence columns mismatch")
        baseline_manifest, _ = load_history_capture(connection, baseline)
        observation_manifest, _ = load_history_capture(connection, observation)
        confounders = list(report["result"]["confounders"])
        if baseline_manifest["member_count"] != observation_manifest["member_count"]:
            if "population_drift" not in confounders:
                fail("private benchmark evidence semantic mismatch")
            confounders.remove("population_drift")
        expected_report = benchmark_report(argparse.Namespace(
            definition_version=version, metric=report["definition"]["metric"],
            direction=report["definition"]["direction"],
            merge_identity=report["inputs"]["merge_identity"], merged_at=report["inputs"]["merged_at"],
            activation_status=report["inputs"]["activation_status"],
            activation_identity=report["inputs"]["activation_identity"],
            activated_at=report["inputs"]["activated_at"], evaluated_at=report["evaluated_at"],
            confounder=confounders,
        ), baseline_manifest, observation_manifest)
        if expected_report != report:
            fail("private benchmark evidence semantic mismatch")


def ensure_phase_schema(connection):
    row = connection.execute("SELECT value FROM ledger_meta WHERE key='phase_schema'").fetchone()
    if row == (str(PHASE_SCHEMA),):
        return
    if row is not None:
        fail("private phase-span ledger has an unsupported schema")
    try:
        connection.execute("BEGIN IMMEDIATE")
        connection.execute("""CREATE TABLE phase_spans (
            cycle_id TEXT NOT NULL,
            span_id TEXT NOT NULL,
            parent_span_id TEXT,
            phase TEXT NOT NULL,
            operation TEXT NOT NULL,
            attribution TEXT NOT NULL,
            dependencies TEXT NOT NULL,
            ownership_paths TEXT NOT NULL,
            started_at INTEGER NOT NULL,
            finished_at INTEGER,
            result TEXT,
            PRIMARY KEY (cycle_id, span_id)
        ) WITHOUT ROWID""")
        connection.execute("""CREATE TABLE execution_activation (
            method_revision TEXT PRIMARY KEY,
            payload TEXT NOT NULL
        ) WITHOUT ROWID""")
        connection.execute("INSERT INTO ledger_meta VALUES ('phase_schema', ?)", (str(PHASE_SCHEMA),))
        connection.commit()
    except Exception:
        connection.rollback()
        raise


def phase_path(value):
    if not isinstance(value, str):
        fail("invalid phase ownership path")
    pure = PurePosixPath(value)
    normalized = str(pure)
    if (pure.is_absolute() or not pure.parts or ".." in pure.parts or normalized in ("", ".")
            or len(normalized.encode()) > 512 or pure.parts[0].endswith(":")
            or any(ord(character) < 32 or character == "\\" for character in normalized)
            or review_unsafe(normalized)):
        fail("invalid phase ownership path")
    return normalized


def phase_record(row):
    names = ("cycle_id", "span_id", "parent_span_id", "phase", "operation", "attribution",
             "dependencies", "ownership_paths", "started_at", "finished_at", "result")
    value = dict(zip(names, row))
    try:
        value["dependencies"] = json.loads(value["dependencies"], object_pairs_hook=no_duplicate_keys)
        value["ownership_paths"] = json.loads(value["ownership_paths"], object_pairs_hook=no_duplicate_keys)
    except json.JSONDecodeError as error:
        fail(f"private phase span is malformed: {error}")
    if (not OPAQUE_ID.fullmatch(value["cycle_id"]) or not OPAQUE_ID.fullmatch(value["span_id"])
            or value["parent_span_id"] is not None and (not OPAQUE_ID.fullmatch(value["parent_span_id"])
                or value["parent_span_id"] == value["span_id"])
            or value["phase"] not in PHASES or value["operation"] not in PHASE_OPERATIONS
            or value["attribution"] not in ("explicit", "adapter", "unavailable")
            or not isinstance(value["dependencies"], list)
            or len(value["dependencies"]) > 100 or len(set(value["dependencies"])) != len(value["dependencies"])
            or any(not isinstance(item, str) or not OPAQUE_ID.fullmatch(item)
                   or item == value["span_id"] for item in value["dependencies"])
            or not isinstance(value["ownership_paths"], list) or len(value["ownership_paths"]) > 100
            or sorted(set(map(phase_path, value["ownership_paths"]))) != value["ownership_paths"]
            or not isinstance(value["started_at"], int) or value["started_at"] < REVIEW_START_MS
            or value["finished_at"] is not None and (not isinstance(value["finished_at"], int)
                or value["finished_at"] < value["started_at"])
            or (value["finished_at"] is None) != (value["result"] is None)
            or value["result"] is not None
            and value["result"] not in ("passed", "failed", "blocked", "abandoned", "unavailable")):
        fail("private phase span is invalid")
    return value


def phase_integrity(connection):
    tables = {row[0] for row in connection.execute(
        "SELECT name FROM sqlite_master WHERE type='table' AND name LIKE 'phase_%'")}
    if tables != {"phase_spans"}:
        fail("private phase-span tables are invalid")
    records = [phase_record(row) for row in connection.execute(
            "SELECT cycle_id, span_id, parent_span_id, phase, operation, attribution, dependencies, "
            "ownership_paths, started_at, finished_at, result FROM phase_spans")]
    by_cycle = {}
    for record in records:
        by_cycle.setdefault(record["cycle_id"], {})[record["span_id"]] = record
    for spans in by_cycle.values():
        for record in spans.values():
            if record["parent_span_id"] is not None and record["parent_span_id"] not in spans:
                fail("private phase span parent is missing")
            for dependency in record["dependencies"]:
                if dependency not in spans:
                    fail("private phase span dependency is missing")
                parent = spans[dependency]
                if parent["finished_at"] is None or record["started_at"] < parent["finished_at"]:
                    fail("private phase span dependency timing is invalid")
        pending = {key: set(record["dependencies"]) for key, record in spans.items()}
        while pending:
            ready = [key for key, dependencies in pending.items() if not dependencies]
            if not ready:
                fail("private phase span dependency cycle")
            for key in ready:
                pending.pop(key)
            for dependencies in pending.values():
                dependencies.difference_update(ready)
    activation_tables = {row[0] for row in connection.execute(
        "SELECT name FROM sqlite_master WHERE type='table' AND name='execution_activation'")}
    if activation_tables != {"execution_activation"}:
        fail("private execution activation table is invalid")
    for method_revision, payload in connection.execute(
            "SELECT method_revision, payload FROM execution_activation"):
        report = validate_execution_benchmark(json.loads(payload, object_pairs_hook=no_duplicate_keys))
        if report["method_revision"] != method_revision:
            fail("private execution activation identity mismatch")


def phase_rows(connection, cycle_id):
    return [phase_record(row) for row in connection.execute(
        "SELECT cycle_id, span_id, parent_span_id, phase, operation, attribution, dependencies, "
        "ownership_paths, started_at, finished_at, result FROM phase_spans "
        "WHERE cycle_id=? ORDER BY span_id", (cycle_id,))]


def unavailable_phase_report(cycle_id):
    return {"schema_version": 1, "cycle_id": cycle_id, "status": "unavailable",
            "total_wall_ms": "unavailable", "critical_path_ms": "unavailable",
            "overlap_ms": "unavailable", "principal_waits": [], "repeated_work": 0,
            "attribution_caveats": ["no_phase_spans"]}


def validate_phase_profile(value, cycle_id=None):
    fields = {"schema_version", "cycle_id", "status", "total_wall_ms", "critical_path_ms",
              "overlap_ms", "principal_waits", "repeated_work", "attribution_caveats"}
    caveats = {"no_phase_spans", "incomplete_spans", "adapter_timing", "unavailable_timing"}
    if (not isinstance(value, dict) or set(value) != fields or value.get("schema_version") != 1
            or not isinstance(value.get("cycle_id"), str) or not OPAQUE_ID.fullmatch(value["cycle_id"])
            or cycle_id is not None and value["cycle_id"] != cycle_id
            or value.get("status") not in ("complete", "partial", "unavailable")
            or type(value.get("repeated_work")) is not int or value["repeated_work"] < 0
            or not isinstance(value.get("principal_waits"), list) or len(value["principal_waits"]) > 5
            or not isinstance(value.get("attribution_caveats"), list)
            or len(set(value["attribution_caveats"])) != len(value["attribution_caveats"])
            or any(item not in caveats for item in value["attribution_caveats"])):
        fail("phase profile is invalid")
    timings = [value[name] for name in ("total_wall_ms", "critical_path_ms", "overlap_ms")]
    if (value["status"] == "complete" and any(type(item) is not int or item < 0 for item in timings)
            or value["status"] != "complete" and any(item != "unavailable" for item in timings)):
        fail("phase profile timing is invalid")
    for wait in value["principal_waits"]:
        if (not isinstance(wait, dict) or set(wait) != {"span_id", "wait_ms"}
                or not isinstance(wait.get("span_id"), str) or not OPAQUE_ID.fullmatch(wait["span_id"])
                or type(wait.get("wait_ms")) is not int or wait["wait_ms"] < 0):
            fail("phase profile wait is invalid")
    return value


def phase_report(rows, cycle_id):
    if not rows:
        return unavailable_phase_report(cycle_id)
    spans = {item["span_id"]: item for item in rows}
    missing = sorted({dependency for item in rows for dependency in item["dependencies"]
                      if dependency not in spans})
    order = []
    if not missing:
        indegree = {key: len(item["dependencies"]) for key, item in spans.items()}
        children = {key: [] for key in spans}
        for key, item in spans.items():
            for dependency in item["dependencies"]:
                children[dependency].append(key)
        ready = sorted(key for key, degree in indegree.items() if degree == 0)
        while ready:
            key = ready.pop(0)
            order.append(key)
            for child in sorted(children[key]):
                indegree[child] -= 1
                if indegree[child] == 0:
                    ready.append(child)
                    ready.sort()
    complete = (not missing and len(order) == len(spans)
                and all(item["finished_at"] is not None for item in rows))
    caveats = []
    if not complete:
        caveats.append("incomplete_spans")
    if any(item["attribution"] == "adapter" for item in rows):
        caveats.append("adapter_timing")
    if any(item["attribution"] == "unavailable" for item in rows):
        caveats.append("unavailable_timing")
    repeated = len(rows) - len({(item["phase"], item["operation"], tuple(item["ownership_paths"]))
                                for item in rows})
    if not complete:
        return validate_phase_profile({**unavailable_phase_report(cycle_id), "status": "partial",
                                       "repeated_work": repeated, "attribution_caveats": caveats})
    durations = {key: item["finished_at"] - item["started_at"] for key, item in spans.items()}
    longest = {}
    for span_id in order:
        dependencies = spans[span_id]["dependencies"]
        longest[span_id] = durations[span_id] + max(
            (longest[item] + spans[span_id]["started_at"] - spans[item]["finished_at"]
             for item in dependencies), default=0)
    started = min(item["started_at"] for item in rows)
    finished = max(item["finished_at"] for item in rows)
    total = finished - started
    waits = []
    for item in rows:
        if item["dependencies"]:
            wait = max(0, item["started_at"] - max(spans[key]["finished_at"] for key in item["dependencies"]))
            if wait:
                waits.append({"span_id": item["span_id"], "wait_ms": wait})
    waits.sort(key=lambda item: (-item["wait_ms"], item["span_id"]))
    return validate_phase_profile({"schema_version": 1, "cycle_id": cycle_id, "status": "complete",
                                   "total_wall_ms": total, "critical_path_ms": max(longest.values()),
                                   "overlap_ms": max(0, sum(durations.values()) - total),
                                   "principal_waits": waits[:5], "repeated_work": repeated,
                                   "attribution_caveats": caveats})


def load_phase_report(root, cycle_id):
    if not ledger_exists(root):
        return unavailable_phase_report(cycle_id)
    with ledger_connection(root) as connection:
        if connection.execute("SELECT value FROM ledger_meta WHERE key='phase_schema'").fetchone() is None:
            return unavailable_phase_report(cycle_id)
        return phase_report(phase_rows(connection, cycle_id), cycle_id)


def interval_union_ms(intervals):
    total, end = 0, None
    for started, finished in sorted(intervals):
        if end is None or started > end:
            total += finished - started
            end = finished
        elif finished > end:
            total += finished - end
            end = finished
    return total


def autonomous_runtime(rows):
    if not rows:
        return "unavailable", None
    if any(item["finished_at"] is None or item["attribution"] == "unavailable"
           or item["result"] == "unavailable" for item in rows):
        return "partial", None
    active = [(item["started_at"], item["finished_at"]) for item in rows
              if item["operation"] not in EXCLUDED_PHASE_OPERATIONS]
    pauses = [(item["started_at"], item["finished_at"]) for item in rows
              if item["operation"] in EXCLUDED_PHASE_OPERATIONS]
    if not active or any(max(a_start, p_start) < min(a_end, p_end)
                         for a_start, a_end in active for p_start, p_end in pauses):
        return "partial", None
    return "complete", interval_union_ms(active)


def cycle_performance_stats(values):
    if not values:
        return {"mean": "unavailable", "p50": "unavailable", "p90": "unavailable"}
    return {"mean": sum(values) // len(values), "p50": nearest_rank(values, .5),
            "p90": nearest_rank(values, .9)}


def completed_cycle_records(repository):
    records = {}
    directories = {cycle_dir(repository), cycle_dir(repository) / "cycles",
                   legacy_cycle_dir(repository)}
    for line in git(repository, "worktree", "list", "--porcelain").stdout.splitlines():
        if line.startswith("worktree "):
            worktree = Path(line.removeprefix("worktree "))
            if not worktree.is_dir():
                continue
            with contextlib.suppress(RuntimeError):
                directories.add(legacy_cycle_dir(worktree))
    paths = sorted({path for directory in directories if directory.is_dir()
                    for path in directory.glob("*.json")})
    for path in paths:
        record = read_cycle_record(repository, path, historical=True)
        cycle_id = record.get("cycle_id") if isinstance(record, dict) else None
        if not isinstance(cycle_id, str) or not OPAQUE_ID.fullmatch(cycle_id) or cycle_id != path.stem:
            fail("Cycle Record contains an invalid cycle ID")
        if record.get("state") == "completed":
            if cycle_id in records and records[cycle_id] != record:
                fail("Cycle Record identity is ambiguous")
            records[cycle_id] = record
    return [records[cycle_id] for cycle_id in sorted(records)]


def cycle_performance(records, spans, filters):
    selected = []
    quality = {"gate_failures": 0, "gate_reopenings": 0, "remediation_rounds": 0}
    metric_names = {"gate_failures": "gate_failure_count",
                    "gate_reopenings": "gate_reopen_count",
                    "remediation_rounds": "remediation_round_count"}
    for record in records:
        values = {
            "context": record.get("context", "unavailable"),
            "risk": record.get("risk", "unavailable"),
            "delivery_intent": record.get("delivery_intent", "unavailable"),
            "method_revision": record.get("method_revision", "unavailable"),
        }
        if any(values[name] != value for name, value in filters.items()):
            continue
        counters = record.get("metrics", {})
        if not isinstance(counters, dict):
            fail("Cycle Record contains invalid metrics")
        cycle_metrics = {output: counters.get(stored, 0) for output, stored in metric_names.items()}
        if any(type(value) is not int or value < 0 for value in cycle_metrics.values()):
            fail("Cycle Record contains invalid metrics")
        for name, value in cycle_metrics.items():
            quality[name] += value
        selected.append(record)

    counts = {"completed": len(selected), "complete": 0, "partial": 0, "unavailable": 0}
    autonomous, calendar = [], []
    for record in selected:
        status, elapsed = autonomous_runtime(spans.get(record["cycle_id"], []))
        counts[status] += 1
        if elapsed is not None:
            autonomous.append(elapsed)
        try:
            started = datetime.fromisoformat(record["created_at"].replace("Z", "+00:00"))
            finished = datetime.fromisoformat(record["completed_at"].replace("Z", "+00:00"))
            if finished >= started:
                calendar.append(int((finished - started).total_seconds() * 1000))
        except (AttributeError, KeyError, TypeError, ValueError):
            pass
    return {
        "schema_version": 1, "filters": filters, "counts": counts,
        "coverage_basis_points": counts["complete"] * 10000 // counts["completed"]
        if counts["completed"] else 0,
        "autonomous_runtime_ms": cycle_performance_stats(autonomous),
        "calendar_elapsed_ms": cycle_performance_stats(calendar), "quality": quality,
    }


def prune_phase_spans(root, connection=None):
    if connection is None and not ledger_exists(root):
        return 0
    owned = connection is None
    connection = connection or ledger_connection(root, write=True)
    if connection.execute("SELECT value FROM ledger_meta WHERE key='phase_schema'").fetchone() is None:
        if owned:
            connection.close()
        return 0
    cutoff_ms = int((time.time() - REVIEW_RETENTION_SECONDS) * 1000)
    removed = connection.execute(
        "DELETE FROM phase_spans WHERE coalesce(finished_at, started_at) <= ?", (cutoff_ms,)
    ).rowcount
    if owned:
        connection.commit()
        connection.close()
    return removed


def prune_phase_backup_spans(root):
    directory = root / "reviews" / "backups"
    if not directory.is_dir():
        return 0
    removed = 0
    cutoff_ms = int((time.time() - REVIEW_RETENTION_SECONDS) * 1000)
    for path in sorted(directory.glob("*.sqlite3")):
        private_path(path, stat.S_IFREG, 0o600, "review backup")
        connection = ledger_connection(root, write=True, path=path)
        try:
            if connection.execute("SELECT value FROM ledger_meta WHERE key='phase_schema'").fetchone() is None:
                continue
            connection.execute("BEGIN IMMEDIATE")
            removed += connection.execute(
                "DELETE FROM phase_spans WHERE coalesce(finished_at, started_at) <= ?", (cutoff_ms,)
            ).rowcount
            connection.commit()
        except Exception:
            connection.rollback()
            raise
        finally:
            connection.close()
    return removed


def validate_execution_benchmark(value):
    fields = {"schema_version", "method_revision", "fixture", "warmup_pairs", "pairs",
              "sample_count", "required_gate_digest", "serial_median_ms",
              "concurrent_median_ms", "improvement_percent", "activated", "recorded_at"}
    fixture_fields = {"id", "commit", "path", "blob"}
    pair_fields = {"pair_id", "serial_ms", "concurrent_ms", "serial_status", "concurrent_status",
                   "serial_gate_digest", "concurrent_gate_digest", "serial_remediation_rounds",
                   "concurrent_remediation_rounds"}
    numbers = {"serial_median_ms", "concurrent_median_ms", "improvement_percent"}
    integers = {"warmup_pairs", "sample_count", "recorded_at"}
    if (not isinstance(value, dict) or set(value) != fields or value.get("schema_version") != 1
            or not isinstance(value.get("method_revision"), str)
            or not OPAQUE_ID.fullmatch(value["method_revision"])
            or not isinstance(value.get("fixture"), dict) or set(value["fixture"]) != fixture_fields
            or not OPAQUE_ID.fullmatch(value["fixture"].get("id", ""))
            or not re.fullmatch(r"[0-9a-f]{40}(?:[0-9a-f]{24})?", value["fixture"].get("commit", ""))
            or not re.fullmatch(r"[0-9a-f]{40}(?:[0-9a-f]{24})?", value["fixture"].get("blob", ""))
            or phase_path(value["fixture"].get("path")) != value["fixture"]["path"]
            or not isinstance(value.get("pairs"), list) or not 5 <= len(value["pairs"]) <= 100
            or not re.fullmatch(r"[0-9a-f]{64}", value.get("required_gate_digest", ""))
            or any(not isinstance(value.get(name), (int, float)) or isinstance(value.get(name), bool)
                   or not math.isfinite(value[name]) or value[name] < 0 for name in numbers)
            or any(type(value.get(name)) is not int or value[name] < 0 for name in integers)
            or value["warmup_pairs"] < 1 or value["sample_count"] != len(value["pairs"])
            or not isinstance(value.get("activated"), bool)
            or value["recorded_at"] < REVIEW_START_MS):
        fail("execution benchmark result is invalid")
    pair_ids = set()
    for pair in value["pairs"]:
        if (not isinstance(pair, dict) or set(pair) != pair_fields
                or not OPAQUE_ID.fullmatch(pair.get("pair_id", "")) or pair["pair_id"] in pair_ids
                or any(type(pair.get(name)) is not int or not 1 <= pair[name] <= 86_400_000
                       for name in ("serial_ms", "concurrent_ms"))
                or pair.get("serial_status") != "passed" or pair.get("concurrent_status") != "passed"
                or pair.get("serial_gate_digest") != value["required_gate_digest"]
                or pair.get("concurrent_gate_digest") != value["required_gate_digest"]
                or any(type(pair.get(name)) is not int or pair[name] < 0 for name in (
                    "serial_remediation_rounds", "concurrent_remediation_rounds"))):
            fail("execution benchmark pair is invalid")
        pair_ids.add(pair["pair_id"])
    serial_median = median(pair["serial_ms"] for pair in value["pairs"])
    concurrent_median = median(pair["concurrent_ms"] for pair in value["pairs"])
    expected_improvement = round(
        (serial_median - concurrent_median) * 100 / serial_median, 2)
    expected = (concurrent_median <= serial_median * .9
                and all(pair["concurrent_remediation_rounds"] <= pair["serial_remediation_rounds"]
                        for pair in value["pairs"]))
    if (value["serial_median_ms"] != serial_median
            or value["concurrent_median_ms"] != concurrent_median
            or value["improvement_percent"] != expected_improvement or value["activated"] != expected):
        fail("execution benchmark activation is invalid")
    return value


def load_execution_activation(root):
    if not ledger_exists(root):
        return False
    with ledger_connection(root) as connection:
        if connection.execute("SELECT value FROM ledger_meta WHERE key='phase_schema'").fetchone() is None:
            return False
        row = connection.execute(
            "SELECT payload FROM execution_activation WHERE method_revision=?",
            (CURRENT_METHOD_REVISION,),
        ).fetchone()
        return row is not None and validate_execution_benchmark(
            json.loads(row[0], object_pairs_hook=no_duplicate_keys))["activated"]


def delete_capture_benchmarks(connection, capture_ids, timestamp):
    if connection.execute("SELECT value FROM ledger_meta WHERE key='benchmark_schema'").fetchone() is not None:
        placeholders = ",".join("?" for _ in capture_ids)
        benchmark_ids = [row[0] for row in connection.execute(
            f"SELECT benchmark_id FROM benchmark_effects WHERE baseline_capture_id IN ({placeholders}) "
            f"OR observation_capture_id IN ({placeholders})", (*capture_ids, *capture_ids))]
        connection.executemany("DELETE FROM benchmark_effects WHERE benchmark_id=?",
                               ((benchmark_id,) for benchmark_id in benchmark_ids))
        for benchmark_id in benchmark_ids:
            record_knowledge_privacy_tombstone(
                connection, "benchmark", benchmark_id, "forgotten", timestamp)
        return benchmark_ids
    return []


def legacy_review_exists(root):
    directory = root / "reviews"
    if not directory.is_dir():
        return False
    history = directory / "history"
    return any(directory.glob("*.json")) or history.is_dir() and any(history.rglob("*.json"))


def create_empty_ledger(root):
    directory = root / "reviews"
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(directory, 0o700)
    descriptor, temporary = tempfile.mkstemp(prefix=".ledger-", suffix=".sqlite3", dir=directory)
    os.close(descriptor)
    temporary = Path(temporary)
    try:
        os.chmod(temporary, 0o600)
        connection = sqlite3.connect(temporary)
        connection.execute("PRAGMA foreign_keys=ON")
        connection.execute("PRAGMA synchronous=FULL")
        ledger_schema(connection)
        connection.commit()
        ledger_integrity(connection)
        connection.close()
        os.replace(temporary, ledger_path(root))
        os.chmod(ledger_path(root), 0o600)
        fsync_directory(directory)
    finally:
        temporary.unlink(missing_ok=True)


def ensure_ledger_for_write(root):
    if not ledger_exists(root):
        if legacy_review_exists(root):
            fail("legacy private review state requires review-migrate")
        create_empty_ledger(root)
    connection = ledger_connection(root, write=True)
    recover_forget_state(root, connection)
    return connection


def ledger_payload(value):
    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=True)


def knowledge_privacy_rows(connection):
    if connection.execute(
            "SELECT 1 FROM sqlite_master WHERE type='table' AND name='knowledge_privacy_tombstones'").fetchone() is None:
        return []
    return [list(row) for row in connection.execute(
        "SELECT family,item_id,reason,timestamp FROM knowledge_privacy_tombstones "
        "ORDER BY family,item_id")]


def knowledge_privacy_digest(connection):
    return hashlib.sha256(ledger_payload(
        {"schema_version": 1, "tombstones": knowledge_privacy_rows(connection)}).encode()).hexdigest()


def ensure_knowledge_privacy_schema(connection):
    exists = connection.execute(
        "SELECT 1 FROM sqlite_master WHERE type='table' AND name='knowledge_privacy_tombstones'").fetchone()
    values = dict(connection.execute(
        "SELECT key,value FROM ledger_meta WHERE key IN "
        "('knowledge_privacy_sequence','knowledge_privacy_digest')"))
    if exists and set(values) == {"knowledge_privacy_sequence", "knowledge_privacy_digest"}:
        return
    if exists or values:
        fail("knowledge privacy schema is incomplete")
    connection.execute("BEGIN IMMEDIATE")
    try:
        connection.execute("""CREATE TABLE knowledge_privacy_tombstones (
            family TEXT NOT NULL,
            item_id TEXT NOT NULL,
            reason TEXT NOT NULL,
            timestamp INTEGER NOT NULL,
            PRIMARY KEY (family, item_id)
        ) WITHOUT ROWID""")
        connection.execute(
            "INSERT INTO knowledge_privacy_tombstones "
            "SELECT 'telemetry',item_id,'forgotten',timestamp FROM review_tombstones "
            "WHERE kind='forgotten_session'")
        count = connection.execute(
            "SELECT count(*) FROM knowledge_privacy_tombstones").fetchone()[0]
        connection.execute("INSERT INTO ledger_meta VALUES ('knowledge_privacy_sequence', ?)",
                           (str(count),))
        connection.execute("INSERT INTO ledger_meta VALUES ('knowledge_privacy_digest', ?)",
                           (knowledge_privacy_digest(connection),))
        connection.commit()
    except Exception:
        connection.rollback()
        raise


def ensure_incident_schema(connection):
    row = connection.execute("SELECT value FROM ledger_meta WHERE key='incident_schema'").fetchone()
    tables = {item[0] for item in connection.execute(
        "SELECT name FROM sqlite_master WHERE type='table' AND name IN "
        "('incidents','incident_signal_dispositions')")}
    if row == (str(INCIDENT_SCHEMA),) and tables == {"incidents", "incident_signal_dispositions"}:
        return
    if row is not None or tables:
        fail("incident schema is incomplete")
    connection.execute("BEGIN IMMEDIATE")
    try:
        connection.executescript("""
            CREATE TABLE incidents (
                incident_id TEXT PRIMARY KEY,
                session_id TEXT NOT NULL UNIQUE,
                parent_session_id TEXT NOT NULL,
                message_id TEXT NOT NULL,
                kind TEXT NOT NULL CHECK (kind IN ('defect','friction','behavior_gap','capability_idea')),
                title TEXT NOT NULL,
                summary TEXT NOT NULL,
                state TEXT NOT NULL CHECK (state IN ('open','investigating','fixing','resolved','dismissed')),
                cycle_id TEXT,
                diagnostics TEXT NOT NULL,
                evidence TEXT NOT NULL,
                created_at INTEGER NOT NULL,
                updated_at INTEGER NOT NULL
            ) WITHOUT ROWID;
            CREATE TABLE incident_signal_dispositions (
                signal_id TEXT PRIMARY KEY,
                incident_id TEXT REFERENCES incidents(incident_id) ON DELETE SET NULL,
                disposition TEXT NOT NULL CHECK (disposition IN ('promoted','forgotten')),
                timestamp INTEGER NOT NULL
            ) WITHOUT ROWID;
        """)
        connection.execute("INSERT INTO ledger_meta VALUES ('incident_schema', ?)",
                           (str(INCIDENT_SCHEMA),))
        connection.commit()
        ledger_integrity(connection)
    except Exception:
        connection.rollback()
        raise


def incident_record(row):
    (incident_id, session_id, parent_id, message_id, kind, title, summary, state,
     cycle_id, diagnostics_raw, evidence_raw, created_at, updated_at) = row
    try:
        diagnostics = json.loads(diagnostics_raw, object_pairs_hook=no_duplicate_keys)
        evidence = json.loads(evidence_raw, object_pairs_hook=no_duplicate_keys)
    except (TypeError, json.JSONDecodeError):
        fail("private review ledger incident payload is invalid")
    if (not re.fullmatch(r"[0-9a-f]{24}", incident_id)
            or not all(isinstance(value, str) and OPAQUE_ID.fullmatch(value)
                       for value in (session_id, parent_id, message_id))
            or kind not in INCIDENT_KINDS or state not in INCIDENT_STATES
            or not isinstance(title, str) or not title.startswith("INCIDENT: ") or len(title) > 128
            or not isinstance(summary, str) or not 1 <= len(summary) <= 1024
            or cycle_id is not None and (not isinstance(cycle_id, str) or not OPAQUE_ID.fullmatch(cycle_id))
            or not isinstance(diagnostics, list) or len(diagnostics) > 20
            or not isinstance(evidence, list) or len(evidence) > 20
            or not all(isinstance(value, str) and 1 <= len(value) <= 2048
                       for value in diagnostics + evidence)
            or type(created_at) is not int or type(updated_at) is not int
            or created_at < REVIEW_START_MS or updated_at < created_at):
        fail("private review ledger incident payload is invalid")
    return {
        "incident_id": incident_id, "session_id": session_id,
        "parent_session_id": parent_id, "message_id": message_id,
        "kind": kind, "title": incident_redact(title, 128),
        "summary": incident_redact(summary, 1024), "state": state,
        "cycle_id": cycle_id,
        "diagnostics": [incident_redact(value) for value in diagnostics],
        "evidence": [incident_redact(value) for value in evidence],
        "created_at": created_at, "updated_at": updated_at,
    }


def record_knowledge_privacy_tombstone(connection, family, item_id, reason, timestamp):
    if (not OPAQUE_ID.fullmatch(family) or not OPAQUE_ID.fullmatch(item_id)
            or not OPAQUE_ID.fullmatch(reason) or not isinstance(timestamp, int)
            or timestamp < REVIEW_START_MS):
        fail("invalid knowledge privacy tombstone")
    changed = connection.execute(
        "INSERT INTO knowledge_privacy_tombstones VALUES (?, ?, ?, ?) "
        "ON CONFLICT(family,item_id) DO NOTHING",
        (family, item_id, reason, timestamp),
    ).rowcount
    if not changed:
        return False
    row = connection.execute(
        "SELECT value FROM ledger_meta WHERE key='knowledge_privacy_sequence'").fetchone()
    if row is None or not row[0].isdigit() or int(row[0]) >= 2**64 - 1:
        fail("knowledge privacy sequence is invalid or exhausted")
    connection.execute("UPDATE ledger_meta SET value=? WHERE key='knowledge_privacy_sequence'",
                       (str(int(row[0]) + 1),))
    connection.execute("UPDATE ledger_meta SET value=? WHERE key='knowledge_privacy_digest'",
                       (knowledge_privacy_digest(connection),))
    return True


def ledger_entries(connection, scope, report_id, report):
    names = {"findings": "finding", "scorecards": "scorecard", "trends": "trend",
             "proposals": "proposal", "caveats": "caveat"}
    connection.execute("DELETE FROM ledger_entries WHERE scope=? AND report_id=?", (scope, report_id))
    for field, category in names.items():
        connection.executemany(
            "INSERT INTO ledger_entries VALUES (?, ?, ?, ?, ?)",
            ((scope, report_id, category, position, text) for position, text in enumerate(report.get(field, []))),
        )


def ledger_put_review_report(connection, report_id, report):
    connection.execute("INSERT OR REPLACE INTO review_reports VALUES (?, ?, ?)",
                       (report_id, report["reviewed_at"], ledger_payload(report)))
    connection.execute("DELETE FROM review_report_sessions WHERE report_id=?", (report_id,))
    connection.execute("DELETE FROM review_report_cycles WHERE report_id=?", (report_id,))
    connection.executemany("INSERT INTO review_report_sessions VALUES (?, ?, ?)",
                           ((report_id, position, value) for position, value in enumerate(report["session_ids"])))
    connection.executemany("INSERT INTO review_report_cycles VALUES (?, ?, ?)",
                           ((report_id, position, value) for position, value in enumerate(report.get("cycle_ids", []))))
    ledger_entries(connection, "operational", report_id, report)


def ledger_put_history_evidence(connection, evidence):
    connection.execute("INSERT OR REPLACE INTO history_evidence VALUES (?, ?, ?)",
                       (evidence["session_id"], int(evidence["completed_at"]), ledger_payload(evidence)))


def ledger_put_history_report(connection, kind, report):
    report_id = report["report_id"]
    connection.execute("INSERT OR REPLACE INTO history_reports VALUES (?, ?, ?)",
                       (report_id, kind, ledger_payload(report)))
    connection.execute("DELETE FROM history_report_members WHERE report_id=?", (report_id,))
    connection.executemany("INSERT INTO history_report_members VALUES (?, ?, ?)",
                           ((report_id, position, value) for position, value in enumerate(report["cohort"])))
    ledger_entries(connection, "history", report_id, report)


def ledger_content(connection):
    tombstones = {"schema_version": 1, "sessions": {}, "cycles": {}, "forgotten_sessions": {}}
    names = {"session": "sessions", "cycle": "cycles", "forgotten_session": "forgotten_sessions"}
    for kind, item_id, timestamp in connection.execute(
            "SELECT kind, item_id, timestamp FROM review_tombstones ORDER BY kind, item_id"):
        tombstones[names[kind]][item_id] = timestamp
    def payloads(query):
        return [(key, json.loads(payload, object_pairs_hook=no_duplicate_keys))
                for key, payload in connection.execute(query)]
    result = {
        "index": tombstones,
        "review_reports": payloads("SELECT report_id, payload FROM review_reports ORDER BY report_id"),
        "history_evidence": [value for _, value in payloads(
            "SELECT session_id, payload FROM history_evidence ORDER BY session_id")],
        "history_reports": payloads(
            "SELECT report_id, payload FROM history_reports WHERE kind='report' ORDER BY report_id"),
        "history_cohorts": payloads(
            "SELECT report_id, payload FROM history_reports WHERE kind='cohort' ORDER BY report_id"),
    }
    if connection.execute("SELECT value FROM ledger_meta WHERE key='capture_schema'").fetchone() is not None:
        result["history_captures"] = payloads(
            "SELECT capture_id, payload FROM history_captures ORDER BY capture_id")
    if connection.execute("SELECT value FROM ledger_meta WHERE key='benchmark_schema'").fetchone() is not None:
        result["benchmarks"] = payloads(
            "SELECT benchmark_id, payload FROM benchmark_effects ORDER BY benchmark_id")
        result["benchmark_definitions"] = [
            {"version": version, "metric": metric, "direction": direction}
            for version, metric, direction in connection.execute(
                "SELECT version, metric_name, direction FROM benchmark_definitions ORDER BY version")]
    if connection.execute("SELECT value FROM ledger_meta WHERE key='phase_schema'").fetchone() is not None:
        result["phase_spans"] = [
            phase_record(row) for row in connection.execute(
                "SELECT cycle_id, span_id, parent_span_id, phase, operation, attribution, dependencies, "
                "ownership_paths, started_at, finished_at, result FROM phase_spans ORDER BY cycle_id, span_id")]
        result["execution_activations"] = payloads(
            "SELECT method_revision, payload FROM execution_activation ORDER BY method_revision")
    if connection.execute("SELECT value FROM ledger_meta WHERE key='incident_schema'").fetchone() is not None:
        incidents = [incident_record(row) for row in connection.execute(
            "SELECT incident_id,session_id,parent_session_id,message_id,kind,title,summary,state,cycle_id,"
            "diagnostics,evidence,created_at,updated_at FROM incidents ORDER BY incident_id")]
        dispositions = [list(row) for row in connection.execute(
            "SELECT signal_id,incident_id,disposition,timestamp FROM incident_signal_dispositions "
            "ORDER BY signal_id")]
        if incidents or dispositions:
            result["incidents"] = incidents
            result["incident_signal_dispositions"] = dispositions
    return result


def content_digest(value):
    return hashlib.sha256(ledger_payload(value).encode()).hexdigest()


def backup_directory(root):
    directory = root / "reviews" / "backups"
    private_path(directory.parent, stat.S_IFDIR, 0o700, "review directory")
    if directory.is_symlink():
        fail("private review backup directory is unsafe")
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(directory, 0o700)
    private_path(directory, stat.S_IFDIR, 0o700, "backup directory")
    return directory


def file_digest(path):
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def create_ledger_backup(root, prefix="ledger"):
    if not ledger_exists(root):
        fail("private review ledger is missing")
    name = f"{int(time.time() * 1000)}-{prefix}-{uuid.uuid4().hex[:8]}.sqlite3"
    target = backup_directory(root) / name
    source = ledger_connection(root)
    destination = sqlite3.connect(target)
    try:
        source.backup(destination)
        destination.commit()
    except sqlite3.Error as error:
        target.unlink(missing_ok=True)
        fail(f"cannot back up private review ledger: {error}")
    finally:
        source.close()
        destination.close()
    os.chmod(target, 0o600)
    with ledger_connection(root, path=target) as check:
        ledger_integrity(check)
    fsync_directory(target.parent)
    return name, file_digest(target)


def backup_legacy_json(root):
    reviews = root / "reviews"
    files = legacy_json_files(root)
    name = f"{int(time.time() * 1000)}-legacy-{uuid.uuid4().hex[:8]}"
    target = backup_directory(root) / name
    target.mkdir(mode=0o700)
    digest = hashlib.sha256()
    directories = {target}
    for source in files:
        if source.is_symlink() or not source.is_file():
            fail("legacy private review state contains an unsafe file")
        relative = source.relative_to(reviews)
        destination = target / relative
        destination.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        os.chmod(destination.parent, 0o700)
        directories.update(parent for parent in destination.parents
                           if parent == target or target in parent.parents)
        shutil.copyfile(source, destination)
        os.chmod(destination, 0o600)
        with destination.open("rb") as handle:
            os.fsync(handle.fileno())
        digest.update(relative.as_posix().encode() + b"\0" + source.read_bytes())
    for directory in sorted(directories, key=lambda item: len(item.parts), reverse=True):
        fsync_directory(directory)
    fsync_directory(target.parent)
    return name, digest.hexdigest()


def legacy_json_files(root):
    reviews = root / "reviews"
    history = reviews / "history"
    if history.is_symlink():
        fail("legacy private review state contains an unsafe directory")
    entries = list(history.rglob("*")) if history.is_dir() else []
    directories = [history, *(path for path in entries if path.is_dir() or path.is_symlink())] if history.exists() else []
    files = sorted([*reviews.glob("*.json"), *(path for path in entries if path.suffix == ".json")])
    for directory in directories:
        details = directory.lstat()
        if stat.S_IFMT(details.st_mode) != stat.S_IFDIR or details.st_uid != os.getuid():
            fail("legacy private review state contains an unsafe directory")
        os.chmod(directory, 0o700)
    for path in files:
        details = path.lstat()
        if stat.S_IFMT(details.st_mode) != stat.S_IFREG or details.st_uid != os.getuid():
            fail("legacy private review state contains an unsafe file")
        os.chmod(path, 0o600)
    return files


def stage_pre_forget_state(root, name=None):
    reviews = root / "reviews"
    quarantine = reviews / (name or f".forget-{uuid.uuid4().hex}")
    quarantine.mkdir(mode=0o700)
    moved = []
    modified = {reviews, quarantine}
    try:
        for source in legacy_json_files(root):
            destination = quarantine / "legacy" / source.relative_to(reviews)
            destination.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
            os.chmod(destination.parent, 0o700)
            os.replace(source, destination)
            moved.append((source, destination))
            modified.update((source.parent, destination.parent))
            modified.update(parent for parent in destination.parents
                            if parent == quarantine or quarantine in parent.parents)
        backups = reviews / "backups"
        if backups.is_symlink():
            fail("private review backup directory is unsafe")
        if backups.is_dir():
            destination = quarantine / "backups"
            os.replace(backups, destination)
            moved.append((backups, destination))
            modified.update((backups.parent, destination.parent))
        for directory in sorted(modified):
            if directory.is_dir():
                fsync_directory(directory)
        return quarantine, moved
    except Exception:
        restore_staged_forget(quarantine, moved)
        raise


def stage_provider_evaluation_backups(root, report_ids, name):
    reviews = root / "reviews"
    quarantine = reviews / name
    quarantine.mkdir(mode=0o700)
    backups = reviews / "backups"
    moved = []
    try:
        if backups.is_symlink():
            fail("private review backup directory is unsafe")
        if backups.is_dir():
            private_path(backups, stat.S_IFDIR, 0o700, "backup directory")
            destination_root = quarantine / "provider-backups"
            for source in sorted(backups.glob("*.sqlite3")):
                private_path(source, stat.S_IFREG, 0o600, "review backup")
                affected = True
                try:
                    with ledger_connection(root, path=source) as connection:
                        if connection.execute(
                                "SELECT 1 FROM sqlite_master WHERE type='table' "
                                "AND name='provider_evaluation_reports'").fetchone() is None:
                            affected = False
                        else:
                            affected = any(connection.execute(
                                "SELECT 1 FROM provider_evaluation_reports WHERE report_id=?", (report_id,)
                            ).fetchone() is not None for report_id in report_ids)
                except (RuntimeError, sqlite3.Error):
                    pass
                if affected:
                    destination_root.mkdir(parents=True, exist_ok=True, mode=0o700)
                    os.chmod(destination_root, 0o700)
                    destination = destination_root / source.name
                    os.replace(source, destination)
                    moved.append((source, destination))
            if moved:
                fsync_directory(backups)
                fsync_directory(destination_root)
        fsync_directory(quarantine)
        fsync_directory(reviews)
        return quarantine, moved
    except Exception:
        restore_staged_forget(quarantine, moved)
        raise


def restore_staged_forget(quarantine, moved):
    modified = {quarantine.parent}
    for source, destination in reversed(moved):
        if destination.exists():
            source.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
            os.replace(destination, source)
            modified.update((source.parent, destination.parent))
            modified.update(parent for parent in source.parents
                            if parent == quarantine.parent or quarantine.parent in parent.parents)
    shutil.rmtree(quarantine, ignore_errors=True)
    for directory in sorted(modified):
        if directory.is_dir():
            fsync_directory(directory)


def discard_staged_forget(quarantine):
    shutil.rmtree(quarantine)
    fsync_directory(quarantine.parent)


def restore_forget_quarantine(quarantine):
    reviews = quarantine.parent
    moved = []
    legacy = quarantine / "legacy"
    if legacy.is_dir():
        for destination in sorted(legacy.rglob("*.json")):
            source = reviews / destination.relative_to(legacy)
            if source.exists() or source.is_symlink():
                fail("cannot recover staged private review state")
            moved.append((source, destination))
    staged_backups = quarantine / "backups"
    if staged_backups.is_dir():
        source = reviews / "backups"
        if source.exists() or source.is_symlink():
            fail("cannot recover staged private review backups")
        moved.append((source, staged_backups))
    staged_provider_backups = quarantine / "provider-backups"
    if staged_provider_backups.is_dir():
        for destination in sorted(staged_provider_backups.glob("*.sqlite3")):
            source = reviews / "backups" / destination.name
            if source.exists() or source.is_symlink():
                fail("cannot recover staged private review backups")
            moved.append((source, destination))
    restore_staged_forget(quarantine, moved)


def recover_forget_state(root, connection):
    reviews = root / "reviews"
    row = connection.execute("SELECT value FROM ledger_meta WHERE key='pending_forget_cleanup'").fetchone()
    pending = row[0] if row else None
    quarantines = sorted(reviews.glob(".forget-*")) if reviews.is_dir() else []
    for quarantine in quarantines:
        if not re.fullmatch(r"\.forget-[0-9a-f]{32}", quarantine.name):
            fail("private review forget quarantine is unsafe")
        private_path(quarantine, stat.S_IFDIR, 0o700, "forget quarantine")
        if quarantine.name == pending:
            discard_staged_forget(quarantine)
        else:
            restore_forget_quarantine(quarantine)
    if pending is not None:
        connection.execute("DELETE FROM ledger_meta WHERE key='pending_forget_cleanup'")
        connection.commit()


def require_review_lock_safe(root):
    directory = root / "reviews"
    if (directory.is_dir() and (any(directory.glob("*.json")) or (directory / "history").exists()
                                or ledger_exists(root)) and not (directory / ".lock").is_file()):
        fail("retained review state is missing its lock")


@contextlib.contextmanager
def existing_review_lock(root, exclusive=False):
    path = root / "reviews" / ".lock"
    if path.is_file():
        with open_existing_review_lock(path) as handle:
            fcntl.flock(handle, fcntl.LOCK_EX if exclusive else fcntl.LOCK_SH)
            yield
    else:
        yield


def exclusive_json(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    temp = None
    try:
        with tempfile.NamedTemporaryFile("w", dir=path.parent, delete=False, encoding="utf-8") as handle:
            temp = Path(handle.name)
            json.dump(value, handle, sort_keys=True, indent=2)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        try:
            os.link(temp, path)
        except FileExistsError:
            fail(f"cycle record already exists: {path.stem}")
    finally:
        if temp:
            temp.unlink(missing_ok=True)


def status_paths(root, read_only=False):
    if LOCAL_COMPLETION_GIT.get() is not None:
        require_local_read_filters(root)
    env = {**os.environ, "GIT_OPTIONAL_LOCKS": "0"} if read_only else None
    result = subprocess.run(
        ["git", "status", "--porcelain=v1", "-z",
         *(["--ignore-submodules=none"] if LOCAL_COMPLETION_GIT.get() is not None else [])],
        cwd=root, capture_output=True, env=git_environment(env)
    )
    if result.returncode:
        fail(result.stderr.decode(errors="replace").strip() or "git status failed")
    entries = result.stdout.split(b"\0")
    paths = []
    index = 0
    while index < len(entries):
        entry = entries[index]
        index += 1
        if not entry:
            continue
        paths.append(os.fsdecode(entry[3:]))
        if entry[0:1] in (b"R", b"C") or entry[1:2] in (b"R", b"C"):
            if index < len(entries) and entries[index]:
                paths.append(os.fsdecode(entries[index]))
                index += 1
    return paths


def branch(root):
    value = git(root, "symbolic-ref", "--quiet", "--short", "HEAD", check=False)
    return value.stdout.strip() or None


def upstream(root):
    value = git(root, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}", check=False)
    return value.stdout.strip() or None


def ahead(root, upstream_name):
    if not upstream_name:
        return []
    return git(root, "rev-list", f"{upstream_name}..HEAD").stdout.splitlines()


def remote_destination(root, upstream_name):
    remote, _ = remote_for_upstream(root, upstream_name)
    if not remote:
        return {"name": None, "push_url": None}
    url = git(root, "remote", "get-url", "--push", remote, check=False)
    return {"name": remote, "push_url": url.stdout.strip() or None}


def remote_for_upstream(root, upstream_name):
    if not upstream_name:
        return None, None
    remotes = git(root, "remote").stdout.splitlines()
    matches = [name for name in remotes if upstream_name.startswith(name + "/")]
    if not matches:
        return None, None
    remote = max(matches, key=len)
    return remote, upstream_name[len(remote) + 1:]


def relative_locator(path, base, root_name):
    try:
        relative = path.resolve().relative_to(base.resolve())
    except ValueError:
        return None
    return {"root": root_name, "path": relative.as_posix() or "."}


def locator_path(locator, roots, name, *, validate_only=False):
    if (not isinstance(locator, dict) or set(locator) != {"root", "path"}
            or locator.get("root") not in roots or not isinstance(locator.get("path"), str)):
        fail(f"invalid {name} locator")
    relative = PurePosixPath(locator["path"])
    if relative.is_absolute() or locator["path"] == "" or ".." in relative.parts:
        fail(f"invalid {name} locator")
    if validate_only:
        return None
    base = roots[locator["root"]].resolve()
    candidate = (base / Path(*relative.parts)).resolve()
    try:
        candidate.relative_to(base)
    except ValueError:
        fail(f"invalid {name} locator")
    return candidate


def schema5_fail(reason):
    fail(f"invalid schema 5 runtime: {reason}")


def validate_schema5_availability(value):
    if not isinstance(value, dict) or set(value) != RUNTIME_CAPABILITIES:
        schema5_fail("availability fields")
    statuses = {"available", "unavailable", "partial", "not_requested"}
    for capability, item in value.items():
        if not isinstance(item, dict) or item.get("status") not in statuses:
            schema5_fail(f"{capability} availability")
        status = item["status"]
        expected = {"status", "reason"} if status in {"unavailable", "partial"} else {"status"}
        if set(item) != expected:
            schema5_fail(f"{capability} availability")
        if "reason" in item:
            reason = item["reason"]
            if (not isinstance(reason, str) or not reason.isascii()
                    or not 1 <= len(reason.encode()) <= 256
                    or any(ord(character) < 32 for character in reason)):
                schema5_fail(f"{capability} reason")
    return value


def validate_schema5_ids(value, name, required):
    if (not isinstance(value, list) or required and not value or len(value) > REVIEW_MAX_LIMIT
            or not all(isinstance(item, str) and OPAQUE_ID.fullmatch(item) for item in value)):
        schema5_fail(name)
    if value != sorted(set(value)):
        schema5_fail(name)
    return value


def validate_schema5_adapter(root, record, harness_id, adapter, *, historical=False):
    required = {"schema_version", "harness_id", "adapter_revision", "session_ids",
                "worktree", "availability"}
    optional = {"turn_ids", "family_id", "activation"}
    if (not isinstance(adapter, dict) or not required.issubset(adapter)
            or not set(adapter).issubset(required | optional)
            or type(adapter.get("schema_version")) is not int or adapter["schema_version"] != 1
            or adapter.get("harness_id") != harness_id
            or adapter.get("adapter_revision") != RUNTIME_ADAPTER_REVISIONS.get(harness_id)):
        schema5_fail(f"{harness_id} adapter fields")
    validate_schema5_ids(adapter["session_ids"], f"{harness_id} session IDs", True)
    if "turn_ids" in adapter:
        validate_schema5_ids(adapter["turn_ids"], f"{harness_id} turn IDs", False)
    if "family_id" in adapter and (not isinstance(adapter["family_id"], str)
                                    or not OPAQUE_ID.fullmatch(adapter["family_id"])):
        schema5_fail(f"{harness_id} family ID")
    try:
        locator_path(adapter["worktree"], {
            "cycle_worktree": None, "primary_worktree": None,
        }, "schema 5 adapter worktree", validate_only=True)
    except RuntimeError:
        schema5_fail(f"{harness_id} worktree")
    availability = validate_schema5_availability(adapter["availability"])
    if availability["session"]["status"] != "available":
        schema5_fail(f"{harness_id} session availability")
    for field, capability in (("turn_ids", "turn"), ("family_id", "family"),
                              ("activation", "activation")):
        if (field in adapter) != (availability[capability]["status"] == "available"):
            schema5_fail(f"{harness_id} {capability} availability")
    if "activation" in adapter:
        validate_stored_harness_activation(adapter["activation"])
    return adapter


def validate_schema5_runtime(root, record, allow_synthetic_codex=False, *, historical=False):
    runtime = record.get("runtime")
    if not isinstance(runtime, dict) or not set(runtime).issubset({"adapters", "opencode"}):
        schema5_fail("runtime fields")
    adapters = runtime.get("adapters")
    if (not isinstance(adapters, dict) or len(adapters) > len(RUNTIME_ADAPTER_REVISIONS)
            or any(name not in RUNTIME_ADAPTER_REVISIONS for name in adapters)):
        schema5_fail("adapter map")
    if "codex" in adapters and not allow_synthetic_codex:
        schema5_fail("Codex adapter is unavailable")
    for harness_id, adapter in adapters.items():
        validate_schema5_adapter(root, record, harness_id, adapter, historical=historical)
    legacy = runtime.get("opencode")
    generic = adapters.get("opencode")
    if (legacy is None) != (generic is None):
        schema5_fail("OpenCode compatibility branch")
    if legacy is not None:
        required_legacy = {"session_ids", "path_root", "worktree", "directory"}
        optional_legacy = {"harness_activation"}
        if (not isinstance(legacy, dict) or not required_legacy.issubset(legacy)
                or not set(legacy).issubset(required_legacy | optional_legacy)):
            schema5_fail("legacy OpenCode branch")
        validate_schema5_ids(legacy["session_ids"], "legacy OpenCode session IDs", True)
        expected_worktree = {"root": legacy.get("path_root"), "path": legacy.get("worktree")}
        if (generic["session_ids"] != legacy.get("session_ids")
                or generic["worktree"] != expected_worktree
                or generic.get("activation") != legacy.get("harness_activation")):
            schema5_fail("OpenCode compatibility disagreement")
        directory = legacy.get("directory")
        relative = PurePosixPath(directory) if isinstance(directory, str) else None
        if (relative is None or relative.is_absolute() or directory == "" or ".." in relative.parts
                or legacy.get("path_root") not in {"cycle_worktree", "primary_worktree"}
                or legacy.get("worktree") != "."):
            schema5_fail("legacy OpenCode locator")
    return runtime


def native_workspace_execution(record):
    """Validate optional execution metadata; historical runtime identity is not authority."""
    if "execution" not in record:
        return False
    value = record["execution"]
    if (not isinstance(value, dict)
            or set(value) != {"schema_version", "mode", "origin", "attribution", "adoption"}
            or type(value["schema_version"]) is not int or value["schema_version"] != 1
            or value["mode"] != "native_workspace"
            or value["attribution"] != {"status": "unavailable", "reason": "native_identity_not_collected"}):
        fail("invalid native workspace execution metadata")
    if value["origin"] == "registered":
        if type(record.get("schema_version")) is not int or record["schema_version"] not in (5, 6) or value["adoption"] is not None:
            fail("invalid native workspace execution registration")
    elif value["origin"] == "adopted":
        adoption = value["adoption"]
        cycle_id = record.get("cycle_id")
        if (type(record.get("schema_version")) is not int or record["schema_version"] not in (3, 4, 5)
                or not isinstance(cycle_id, str) or not OPAQUE_ID.fullmatch(cycle_id)
                or not isinstance(adoption, dict)
                or set(adoption) != {"before_sha256", "state_digest", "record_backup"}
                or any(not isinstance(adoption[key], str) or not re.fullmatch(r"[0-9a-f]{64}", adoption[key])
                       for key in ("before_sha256", "state_digest"))
                or adoption["record_backup"] != f"dbsctr/migrations/{cycle_id}.{adoption['before_sha256']}.native-before.json"):
            fail("invalid native workspace execution adoption")
    else:
        fail("invalid native workspace execution origin")
    return True


def validate_initiative_approval(value):
    if (not isinstance(value, dict)
            or set(value) != {"schema_version", "method", "launch_digest", "confirmed_at"}
            or type(value["schema_version"]) is not int or value["schema_version"] != 1
            or value["method"] not in ("interactive_cli", "agent_confirmed")
            or not isinstance(value["launch_digest"], str)
            or not re.fullmatch(r"[0-9a-f]{64}", value["launch_digest"])
            or not isinstance(value["confirmed_at"], str)):
        fail("invalid Initiative confirmation provenance")
    try:
        confirmed = datetime.fromisoformat(value["confirmed_at"].replace("Z", "+00:00"))
    except ValueError:
        fail("invalid Initiative confirmation timestamp")
    if confirmed.utcoffset() != timedelta(0):
        fail("invalid Initiative confirmation timestamp")


def read_cycle_record(root, path, label="Cycle Record", *, historical=False, max_bytes=None):
    try:
        if max_bytes is None:
            text = path.read_text(encoding="utf-8")
        else:
            with path.open("rb") as stream:
                raw = stream.read(max_bytes + 1)
            if len(raw) > max_bytes:
                fail("Cycle Record exceeds metadata read budget")
            text = raw.decode("utf-8")
        record = json.loads(text, object_pairs_hook=no_duplicate_keys)
    except TimeoutError:
        if max_bytes is not None:
            raise
        fail(f"cannot read {label}: timed out")
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        fail(f"cannot read {label}: {error}")
    if not isinstance(record, dict):
        fail(f"{label} must be an object")
    if "schema_version" in record:
        schema_version = record["schema_version"]
        if type(schema_version) is not int or schema_version not in (1, 2, 3, 4, 5, 6):
            fail("unsupported Cycle Record schema")
    native = native_workspace_execution(record)
    if "initiative_approval" in record:
        validate_initiative_approval(record["initiative_approval"])
    if record.get("schema_version") == 5:
        validate_schema5_runtime(root, record, historical=historical or native)
    if record.get("schema_version") == 6:
        try:
            validate_schema6_record(root, record)
        except (KeyError, TypeError, ValueError, AttributeError):
            fail("invalid local-only Cycle Record")
        if path.stem != record["cycle_id"]:
            fail("local-only Cycle Record filename identity changed")
    if "initiative_amendments" in record or "initiative_authority_checkpoints" in record:
        with local_completion_git_context():
            try:
                validate_initiative_amendments(root, record)
            except (KeyError, TypeError, ValueError, AttributeError, OSError):
                fail("invalid Initiative amendment history")
    return record


def local_only_cycle(record):
    return record.get("schema_version") == 6


def local_delivery_lock_id(root, record):
    forge = record["delivery"]["forge"]
    return continuation_digest({"repository": {key: forge[key] for key in ("provider", "origin", "repository")},
        "common": str(common_git_dir(root).resolve()), "git_dir": record["worktree"]["git_dir"],
        "branch": record["worktree"]["branch"]})


def validate_schema6_record(root, record):
    """Validate new-mode records intrinsically, including historical completions."""
    required = {"method_revision", "schema_version", "created_at", "cycle_id", "context", "risk",
        "delivery_intent", "engineering_profile", "applicability_plan", "git", "worktree", "delivery",
        "state", "commits", "gates", "evidence", "metrics", "artifact_reviews", "runtime",
        "preservation_policy", "execution", "initiative", "initiative_approval"}
    optional = {"discovery_import", "profile_history", "graphify_check", "phase_profile", "dvc_push",
                "dvc_preservation", "local_completion", "completed_at", "source_sync",
                "initiative_amendments", "initiative_authority_checkpoints"}
    if (not required <= set(record) or not set(record) <= required | optional
            or not native_workspace_execution(record) or record["execution"]["origin"] != "registered"
            or record["delivery_intent"] != "local" or record["state"] not in {"active", "completed"}
            or not isinstance(record["cycle_id"], str) or not OPAQUE_ID.fullmatch(record["cycle_id"])
            or not isinstance(record["context"], str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_-]{0,127}", record["context"])
            or record["risk"] not in RISK_RANK):
        fail("invalid local-only Cycle Record identity")
    oid = lambda value: isinstance(value, str) and re.fullmatch(r"[0-9a-f]{40}(?:[0-9a-f]{24})?", value)
    utc = lambda value: isinstance(value, str) and datetime.fromisoformat(value.replace("Z", "+00:00")).utcoffset() == timedelta(0)
    if not utc(record["created_at"]):
        fail("invalid local-only Cycle Record timestamp")
    worktree, baseline, delivery = (record[key] for key in ("worktree", "git", "delivery"))
    if (not isinstance(worktree, dict) or set(worktree) != {"id", "locator", "git_dir", "branch", "base_commit", "created_by_dbsctr"}
            or not isinstance(baseline, dict) or set(baseline) != {"head", "branch", "upstream", "dirty_paths", "pre_cycle_ahead_commits", "remote"}
            or not isinstance(delivery, dict) or set(delivery) != {"mode", "forge", "upstream", "remote", "branch", "base_branch", "base_head", "lock_id"}
            or delivery["mode"] != "local_only" or worktree["created_by_dbsctr"] is not False
            or not isinstance(worktree["id"], str) or not re.fullmatch(r"[0-9a-f]{16}", worktree["id"])
            or baseline["dirty_paths"] != [] or baseline["pre_cycle_ahead_commits"] != []
            or not oid(baseline["head"]) or worktree["base_commit"] != baseline["head"]
            or delivery["base_head"] != baseline["head"]
            or baseline["branch"] != worktree["branch"] or delivery["branch"] != worktree["branch"]):
        fail("invalid local-only Cycle Record delivery")
    for name in (worktree["branch"], delivery["remote"], delivery["base_branch"]):
        if (not isinstance(name, str) or not name or len(name) > 1024 or name.startswith("-")
                or any(ord(character) < 33 or character in "~^:?*[\\" for character in name)
                or ".." in name or "@{" in name or name.endswith(("/", ".", ".lock"))):
            fail("invalid local-only Git selection")
    if (delivery["upstream"] != f"{delivery['remote']}/{delivery['base_branch']}"
            or baseline["upstream"] != delivery["upstream"] or worktree["branch"] == delivery["base_branch"]):
        fail("invalid local-only comparison base")
    forge = delivery["forge"]
    if (not isinstance(forge, dict) or set(forge) != {"provider", "origin", "repository", "account", "credential_source"}
            or forge["provider"] != "forgejo" or forge["credential_source"] != "osxkeychain"
            or not isinstance(forge["account"], str) or not OPAQUE_ID.fullmatch(forge["account"])):
        fail("invalid local-only credential selection")
    identity = typed_repository_identity({key: forge[key] for key in ("provider", "origin", "repository")})
    if any(identity[key] != forge[key] for key in identity):
        fail("noncanonical local-only repository identity")
    destinations = baseline["remote"]
    if (not isinstance(destinations, dict) or set(destinations) != {"fetch_urls", "push_urls", "url"}
            or destinations["url"] != identity["origin"] + "/" + identity["repository"] + ".git"):
        fail("invalid local-only destination snapshot")
    for kind in ("fetch_urls", "push_urls"):
        if (not isinstance(destinations[kind], list) or not 1 <= len(destinations[kind]) <= 16
                or any(repository_identity_from_url(url, "forgejo") != identity for url in destinations[kind])):
            fail("invalid local-only destination snapshot")
    native_git_directory(root, record)
    if delivery["lock_id"] != local_delivery_lock_id(root, record):
        fail("invalid local-only serialization identity")
    receipt = record["initiative"]
    validate_local_initiative_receipt(receipt)
    if (not isinstance(receipt, dict) or type(receipt.get("schema_version")) is not int
            or receipt.get("schema_version") != 2 or receipt.get("context") != record["context"]
            or receipt.get("repository") != identity or receipt.get("execution_owner") != "build"):
        fail("local-only registration requires its schema 2 Initiative receipt")
    typed_repository_identity(receipt["coordinator_repository"])
    for key in ("manifest_blob", "manifest_commit"):
        if not oid(receipt.get(key)):
            fail("invalid local-only Initiative provenance")
    if not isinstance(receipt.get("manifest_digest"), str) or not re.fullmatch(r"[0-9a-f]{64}", receipt["manifest_digest"]):
        fail("invalid local-only Initiative digest")
    validate_initiative_approval(record["initiative_approval"])
    profile, plan = record["engineering_profile"], record["applicability_plan"]
    if (not isinstance(profile, dict) or set(profile) != {"path", "blob"} or not oid(profile["blob"])
            or not isinstance(profile["path"], str) or not profile["path"].startswith("docs/specs/")
            or not isinstance(plan, dict) or not {"profile", "gates"} <= set(plan)
            or not set(plan) <= {"profile", "gates", "graphify"} or plan["profile"] != profile["path"]
            or not isinstance(record["gates"], dict) or set(record["gates"]) != set(GATES)
            or not isinstance(plan["gates"], dict) or set(plan["gates"]) != set(GATES)):
        fail("invalid local-only profile or gate plan")
    initiative_paths([profile["path"]], "local-only Engineering Profile")
    for name, gate in record["gates"].items():
        if (not isinstance(gate, dict) or not {"applicability", "result"} <= set(gate)
                or not set(gate) <= {"applicability", "result", "reason", "evidence", "exception"}
                or gate["applicability"] not in {"required", "not_applicable"}
                or gate["result"] not in {"pending", "passed", "failed", "unavailable", "not_run"}
                or (name in MANDATORY_GATES and gate["applicability"] != "required")
                or plan["gates"][name] != {key: value for key, value in gate.items() if key in {"applicability", "reason"}}
                or (gate["applicability"] == "not_applicable" and (gate["result"] != "not_run" or not gate.get("reason")))
                or (gate["applicability"] == "required" and gate["result"] == "not_run")
                or ("exception" in gate and not valid_gate_exception(gate))):
            fail("invalid local-only gate state")
    if (not isinstance(record["evidence"], dict) or set(record["evidence"]) != {"version", "items"}
            or type(record["evidence"]["version"]) is not int or record["evidence"]["version"] != 1
            or not isinstance(record["evidence"]["items"], dict)
            or not isinstance(record["artifact_reviews"], dict) or set(record["artifact_reviews"]) != set(ARTIFACTS)
            or not isinstance(record["metrics"], dict)
            or any(type(value) is not int or value < 0 for value in record["metrics"].values())
            or not isinstance(record["commits"], list)):
        fail("invalid local-only evidence ledger")
    for name, review in record["artifact_reviews"].items():
        if (not isinstance(review, dict) or not {"result", "reason", "reviewed_at"} <= set(review)
                or not set(review) <= {"result", "reason", "reviewed_at", "path"}
                or review["result"] not in {"pending", "changed", "unchanged"}
                or (review.get("path") is not None and review["path"] != f"docs/specs/{record['context']}/{name}.md")
                or (review["result"] == "pending" and (review["reason"] is not None or review["reviewed_at"] is not None))
                or (review["result"] != "pending" and (not isinstance(review["reason"], str)
                    or not review["reason"].strip() or not utc(review["reviewed_at"])))
                or (review["result"] == "changed" and not review.get("path"))):
            fail("invalid local-only artifact review")
    for identifier, item in record["evidence"]["items"].items():
        fields = {"id", "gate", "authority", "argv", "paths", "head", "started_at", "finished_at",
                  "result", "raw", "summary", "urls", "content"}
        if (not isinstance(item, dict) or not fields <= set(item) or not set(item) <= fields | {"commit"}
                or not isinstance(identifier, str) or not re.fullmatch(r"ev-[0-9a-f]{32}", identifier)
                or item["id"] != identifier or item["gate"] not in GATES
                or item["result"] not in {"passed", "failed", "unavailable"}
                or not isinstance(item["authority"], str) or not item["authority"]
                or not isinstance(item["argv"], list) or not 1 <= len(item["argv"]) <= 64
                or any(not isinstance(value, str) for value in item["argv"])
                or not isinstance(item["paths"], dict) or not oid(item["head"])
                or ("commit" in item and not oid(item["commit"]))
                or not utc(item["started_at"]) or not utc(item["finished_at"])
                or item["summary"] != item["result"] or not isinstance(item["urls"], list)
                or any(not isinstance(value, str) for value in item["urls"])
                or not isinstance(item["raw"], dict) or set(item["raw"]) != {"byte_count", "lower_bound", "truncated"}
                or type(item["raw"]["byte_count"]) is not int or item["raw"]["byte_count"] < 0
                or any(type(item["raw"][key]) is not bool for key in ("lower_bound", "truncated"))):
            fail("invalid local-only evidence envelope")
        initiative_paths(list(item["paths"]), "local-only evidence paths")
        if any(value is not None and not oid(value) for value in item["paths"].values()):
            fail("invalid local-only evidence blob")
        content = item["content"]
        if not isinstance(content, dict):
            fail("invalid local-only evidence content")
        if content.get("status") == "sidecar":
            if (set(content) != {"status", "path", "sha256", "byte_count", "truncated"}
                    or not isinstance(content["sha256"], str) or not re.fullmatch(r"[0-9a-f]{64}", content["sha256"])
                    or content["path"] != f"evidence/{record['cycle_id']}/{content['sha256']}"
                    or type(content["byte_count"]) is not int or not 0 <= content["byte_count"] <= EVIDENCE_SIDECAR_CAP
                    or type(content["truncated"]) is not bool):
                fail("invalid local-only evidence sidecar")
        elif content.get("status") == "withheld":
            if set(content) != {"status", "reason"} or not isinstance(content["reason"], str) or not content["reason"]:
                fail("invalid local-only withheld evidence")
        elif content != {"status": "no_content"}:
            fail("invalid local-only evidence content")
    for name, gate in record["gates"].items():
        identifier = gate.get("evidence")
        item = record["evidence"]["items"].get(identifier) if isinstance(identifier, str) else None
        if (identifier is not None and (item is None or item["gate"] != name or item["result"] != gate["result"])):
            fail("invalid local-only gate evidence binding")
        if gate["result"] in {"passed", "failed", "unavailable"} and item is None:
            fail("missing local-only gate evidence")
    commits = []
    for entry in record["commits"]:
        if (not isinstance(entry, dict) or set(entry) != {"id", "gates"} or not oid(entry["id"])
                or entry["id"] in commits or not isinstance(entry["gates"], list)
                or any(not isinstance(name, str) or name not in GATES for name in entry["gates"])
                or len(entry["gates"]) != len(set(entry["gates"]))):
            fail("invalid local-only recorded commits")
        commits.append(entry["id"])
    validate_schema5_runtime(root, record, historical=True)
    terminal = {"local_completion", "completed_at", "source_sync"}
    if record["state"] == "active":
        if terminal & set(record):
            fail("active local-only record contains completion state")
        return
    completion = record.get("local_completion")
    if (not terminal <= set(record) or not isinstance(completion, dict)
            or set(completion) != {"schema_version", "cycle_id", "repository", "base_head", "head", "tree", "recorded_commits", "completed_at", "manual_delivery"}
            or type(completion["schema_version"]) is not int or completion["schema_version"] != 1
            or completion["cycle_id"] != record["cycle_id"] or completion["repository"] != identity
            or completion["base_head"] != delivery["base_head"] or not oid(completion["head"])
            or not oid(completion["tree"]) or not commits or completion["head"] != commits[-1]
            or completion["recorded_commits"] != commits or not utc(completion["completed_at"])
            or completion["completed_at"] != record["completed_at"]
            or completion["manual_delivery"] != {"status": "pending"}
            or record["source_sync"] != {"status": "not_applicable", "reason": "local_only_completion"}):
        fail("invalid local-only completion")
    if any(gate["applicability"] == "required" and gate["result"] != "passed"
           and not (gate["result"] in {"failed", "unavailable"} and valid_gate_exception(gate))
           for gate in record["gates"].values()):
        fail("completed local-only record has incomplete gates")
    for name, review in record["artifact_reviews"].items():
        if (not isinstance(review, dict) or review.get("result") not in {"changed", "unchanged"}
                or not isinstance(review.get("reason"), str) or not review["reason"].strip()
                or not utc(review.get("reviewed_at"))):
            fail("completed local-only record has incomplete artifact reviews")
    completion_artifact_check(record)


def schema5_opencode_adapter(opencode):
    activation = opencode.get("harness_activation")
    return {
        "schema_version": 1,
        "harness_id": "opencode",
        "adapter_revision": RUNTIME_ADAPTER_REVISIONS["opencode"],
        "session_ids": sorted(opencode["session_ids"]),
        "worktree": {"root": opencode["path_root"], "path": opencode["worktree"]},
        **({"activation": activation} if activation is not None else {}),
        "availability": {
            "session": {"status": "available"},
            "turn": {"status": "not_requested"},
            "family": {"status": "not_requested"},
            "activation": {"status": "available" if activation is not None else "not_requested"},
            "history": {"status": "unavailable", "reason": "not_collected"},
        },
    }


def sync_schema5_opencode(record):
    if record.get("schema_version") != 5:
        return
    runtime = record.setdefault("runtime", {"adapters": {}})
    adapters = runtime.setdefault("adapters", {})
    opencode = runtime.get("opencode")
    if opencode is None:
        adapters.pop("opencode", None)
    else:
        opencode["session_ids"] = sorted(opencode["session_ids"])
        adapters["opencode"] = schema5_opencode_adapter(opencode)


def git_worktrees(root):
    entries = git(root, "worktree", "list", "--porcelain", "-z").stdout.split("\0\0")
    return [dict(part.split(" ", 1) for part in entry.split("\0") if " " in part)
            for entry in entries if entry]


def native_git_directory(root, record, *, common=None):
    """Use Git's existing per-worktree metadata, never a branch-name routing index."""
    details = record.get("worktree")
    if record.get("schema_version") in (4, 5, 6):
        locator_path(details.get("locator") if isinstance(details, dict) else None,
                     {"cycle_worktree": None, "dbsctr_worktrees": None}, "cycle worktree", validate_only=True)
    value = details.get("git_dir") if isinstance(details, dict) else None
    if not isinstance(value, str) or not value:
        fail("native worktree administrative binding is missing")
    common = common_git_dir(root).resolve() if common is None else common
    if record.get("schema_version") == 3 and Path(value).is_absolute():
        candidate = Path(value)
    else:
        relative = PurePosixPath(value)
        if (relative.is_absolute() or len(relative.parts) != 2 or relative.parts[0] != "worktrees"
                or relative.parts[1] in (".", "..") or "\\" in value):
            fail("native worktree administrative binding is invalid")
        candidate = common / relative
    if candidate.is_symlink() or candidate.parent.is_symlink() or candidate.resolve().parent != common / "worktrees":
        fail("native worktree administrative binding is unsafe")
    return candidate.resolve()


def record_worktree(root, record, *, bindings=True):
    if native_workspace_execution(record):
        expected = native_git_directory(root, record)
        for fields in git_worktrees(root):
            if fields.get("branch") != "refs/heads/" + record["worktree"]["branch"]:
                continue
            candidate = Path(fields["worktree"]).resolve()
            if git_dir(candidate).resolve() == expected:
                return candidate
        if record.get("state") in {"completed", "retired"}:
            return cycle_dir(root) / "removed-worktrees" / str(record["worktree"]["id"])
        fail("native worktree is missing or its branch changed")
    bound = None
    if bindings:
        with continuation_connection(root) as db:
            bound = continuation_cycle_binding(db, record.get("cycle_id"))
    if bound:
        return continuation_bound_target(root, bound)[0]
    details = record.get("worktree", {})
    if "locator" not in details:
        value = details.get("path")
        if not isinstance(value, str) or not value:
            fail("Cycle Record contains an invalid worktree path")
        return Path(value).expanduser().resolve()
    locator = details.get("locator")
    if (isinstance(locator, dict) and locator.get("root") == "cycle_worktree"
            and branch(root) != details.get("branch")):
        current = None
        candidates = []
        for line in git(root, "worktree", "list", "--porcelain").stdout.splitlines() + [""]:
            if line.startswith("worktree "):
                current = {"path": line.removeprefix("worktree ")}
            elif current is not None and line.startswith("branch "):
                current["branch"] = line.removeprefix("branch refs/heads/")
            elif not line and current is not None:
                if current.get("branch") == details.get("branch"):
                    candidates.append(Path(current["path"]).resolve())
                current = None
        if len(candidates) == 1:
            return candidates[0]
        if (record.get("state") in {"completed", "retired"}
                or record.get("cleanup", {}).get("state") in {
                    "removing_worktree", "worktree_removed", "evidence_parked"}
                or record.get("retirement", {}).get("state") in {"removing_worktree", "retired"}
                or record.get("worktree_retirement", {}).get("state") in {
                    "removing_worktree", "retired"}):
            return cycle_dir(root) / "removed-worktrees" / str(details.get("id", "unknown"))
        fail("cycle worktree is missing")
    return locator_path(details.get("locator"), {
        "cycle_worktree": root,
        "dbsctr_worktrees": worktree_registry_root(),
    }, "cycle worktree")


def record_source_worktree(root, record):
    source = record.get("source")
    if not isinstance(source, dict):
        return None
    if "locator" not in source:
        value = source.get("path")
        return Path(value).expanduser().resolve() if isinstance(value, str) and value else None
    locator = source.get("locator")
    source_root = (worktree_for_id(root, source["id"]) if "id" in source
                   else primary_worktree(root))
    return locator_path(locator, {"primary_worktree": source_root}, "source worktree")


def record_worktree_matches(root, record, worktree, *, bindings=True):
    if native_workspace_execution(record):
        return (common_git_dir(worktree).resolve() == common_git_dir(root).resolve()
                and git_dir(worktree).resolve() == native_git_directory(root, record)
                and branch(worktree) == record["worktree"]["branch"]
                and record_worktree(root, record, bindings=False) == worktree.resolve())
    bound = None
    if bindings:
        with continuation_connection(root) as db:
            bound = continuation_cycle_binding(db, record.get("cycle_id"))
    if bound:
        target, _ = continuation_bound_target(root, bound)
        return (target == worktree.resolve() and bound["legacy_worktree_id"] == record["worktree"]["id"]
                and continuation_record_identity(record) == bound["record_identity_digest"]
                and branch(target) == record["worktree"]["branch"])
    details = record.get("worktree", {})
    expected_id = (worktree_id(worktree) if "locator" in details
                   else legacy_worktree_id(worktree))
    if expected_id != details.get("id") or common_git_dir(worktree).resolve() != common_git_dir(root).resolve():
        return False
    if "locator" not in details:
        return git_dir(worktree).resolve() == Path(details.get("git_dir", "")).resolve()
    return True


def configured_upstream(root):
    current = branch(root)
    if not current:
        return None, None
    remote = git(root, "config", "--get", f"branch.{current}.remote", check=False).stdout.strip()
    merge = git(root, "config", "--get", f"branch.{current}.merge", check=False).stdout.strip()
    if not remote or not merge.startswith("refs/heads/"):
        return None, None
    return remote, merge.removeprefix("refs/heads/")


def load(root, *, bindings=True):
    active = resolved_active_path(root, bindings=bindings)
    records = cycle_dir(root) / "cycles"
    if active == legacy_cycle_dir(root) / "active":
        records = legacy_cycle_dir(root)
    if not active.exists():
        fail("no active DBSCTR cycle")
    cycle_id = active_pointer_id(root, active)
    path = records / f"{cycle_id}.json"
    if not cycle_id or not path.is_file():
        fail("active DBSCTR record is missing")
    record = read_cycle_record(root, path)
    if native_workspace_execution(record):
        verify_native_workspace_backup(root, record)
        if not record_worktree_matches(root, record, root):
            fail("native workspace checkout identity changed")
    record_worktree(root, record, bindings=bindings)
    return path, record


def save(path, record):
    if local_only_cycle(record):
        try:
            validate_schema6_record(root_dir(), record)
        except (KeyError, TypeError, ValueError, AttributeError):
            fail("invalid local-only outgoing Cycle Record")
    atomic_json(path, record)


def require_active(record):
    if record["state"] != "active":
        fail(f"cycle is {record['state']}, not active")


def require_pushable(record):
    if record["state"] not in ("active", "finalizing"):
        fail(f"cycle is {record['state']}, not pushable")


def is_v32(record):
    return record.get("schema_version") in (1, 2, 3, 4, 5, 6)


@contextlib.contextmanager
def target_lock(root, record):
    target = record.get("delivery", {}).get("lock_id")
    if not target:
        target = delivery_lock_id(record["git"]["remote"].get("push_url"), record["git"]["upstream"])
    path = cycle_dir(root) / "locks" / f"{target}.lock"
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a+", encoding="utf-8") as handle:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            fail("delivery target is locked by another DBSCTR cycle")
        yield


@contextlib.contextmanager
def evidence_lock(root, cycle_id, *, timeout=None):
    if not isinstance(cycle_id, str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", cycle_id):
        fail("invalid cycle ID for evidence lock")
    path = cycle_dir(root) / "locks" / f"evidence-{cycle_id}.lock"
    managed_directory(root, path.parent, create=True)
    descriptor = os.open(path, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    with os.fdopen(descriptor, "a+", encoding="utf-8") as handle:
        details = os.fstat(handle.fileno())
        if not stat.S_ISREG(details.st_mode) or details.st_uid != os.getuid() or details.st_nlink != 1 or details.st_mode & 0o022:
            fail("unsafe evidence lock")
        deadline = None if timeout is None else time.monotonic() + timeout
        while True:
            try:
                fcntl.flock(handle, fcntl.LOCK_EX | (fcntl.LOCK_NB if deadline is not None else 0))
                break
            except BlockingIOError:
                if deadline is None or time.monotonic() >= deadline:
                    fail("cycle evidence is busy")
                time.sleep(0.01)
        yield


def delivery_lock_id(push_url, upstream_name=None, remote_branch=None):
    if remote_branch is None:
        remote_branch = upstream_name.partition("/")[2] if upstream_name else ""
    return hashlib.sha256(f"{push_url or 'no-remote'}\0{remote_branch}".encode()).hexdigest()[:24]


def no_duplicate_keys(pairs):
    value = {}
    for key, item in pairs:
        if key in value:
            fail(f"duplicate JSON key in applicability plan: {key}")
        value[key] = item
    return value


def read_plan(source, expected_digest=None):
    try:
        raw = sys.stdin.buffer.read() if source == "-" else Path(source).read_bytes()
        if expected_digest is not None and hashlib.sha256(raw).hexdigest() != expected_digest:
            fail("applicability plan changed after approval")
        text = raw.decode("utf-8")
        value = json.loads(text, object_pairs_hook=no_duplicate_keys)
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        fail(f"cannot read applicability plan: {error}")
    if not isinstance(value, dict):
        fail("applicability plan must be a JSON object")
    return value


def initiative_no_duplicate_keys(pairs):
    value = {}
    for key, item in pairs:
        if key in value:
            fail(f"duplicate JSON key in Initiative manifest: {key}")
        value[key] = item
    return value


def initiative_fields(value, fields, label):
    if not isinstance(value, dict) or set(value) != fields:
        fail(f"{label} requires exactly: {', '.join(sorted(fields))}")


def initiative_strings(value, label, allow_empty=True):
    if (not isinstance(value, list) or any(not isinstance(item, str) or not item for item in value)
            or not allow_empty and not value):
        fail(f"{label} must be {'a non-empty' if not allow_empty else 'an'} array of strings")
    if len(value) != len(set(value)):
        fail(f"{label} contains duplicate values")


def initiative_paths(value, label):
    initiative_strings(value, label)
    for item in value:
        path = PurePosixPath(item)
        if (path.is_absolute() or item != path.as_posix() or "\\" in item
                or any(part in {"", ".", ".."} for part in path.parts)
                or any(ord(character) < 32 for character in item)
                or urlsplit(item).scheme or urlsplit(item).netloc):
            fail(f"{label} must contain normalized repository-relative paths")


def _forgejo_environment(private_home="/var/empty"):
    """Build a child-only environment without ambient transport or secret inputs."""
    return {"PATH": "/usr/bin:/bin:/usr/sbin:/sbin", "LANG": "C", "LC_ALL": "C",
            "HOME": str(private_home), "XDG_CONFIG_HOME": str(private_home),
            "GIT_CONFIG_GLOBAL": "/dev/null", "GIT_CONFIG_SYSTEM": "/dev/null",
            "GIT_CONFIG_NOSYSTEM": "1", "GIT_TERMINAL_PROMPT": "0",
            "GIT_ASKPASS": "/usr/bin/false", "SSH_ASKPASS": "/usr/bin/false",
            "GCM_INTERACTIVE": "Never", "GIT_NO_REPLACE_OBJECTS": "1",
            "GIT_ALLOW_PROTOCOL": "https", "GIT_PROTOCOL_FROM_USER": "0"}


def _forgejo_run(command, *, cwd, env, timeout=30, input=None):
    """Bound output and the whole child process group; never expose raw errors."""
    process, finished = None, False
    try:
        process = subprocess.Popen(command, cwd=cwd, env=env, start_new_session=True,
                                   stdin=subprocess.PIPE if input is not None else subprocess.DEVNULL,
                                   stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        if input is not None:
            process.stdin.write(input.encode("utf-8"))
            process.stdin.close()
        deadline = time.monotonic() + timeout
        output = {process.stdout: bytearray(), process.stderr: bytearray()}
        with selectors.DefaultSelector() as selector:
            for stream in output:
                os.set_blocking(stream.fileno(), False)
                selector.register(stream, selectors.EVENT_READ)
            while selector.get_map():
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    fail("Forgejo transport timed out")
                for key, _ in selector.select(remaining):
                    value = os.read(key.fileobj.fileno(), 8192)
                    if not value:
                        selector.unregister(key.fileobj)
                        continue
                    output[key.fileobj].extend(value)
                    if sum(map(len, output.values())) > 64 * 1024:
                        fail("Forgejo transport output unavailable")
            process.wait(timeout=max(0.001, deadline - time.monotonic()))
        finished = True
        return subprocess.CompletedProcess(command, process.returncode,
            bytes(output[process.stdout]).decode("utf-8", errors="replace"),
            bytes(output[process.stderr]).decode("utf-8", errors="replace"))
    except subprocess.TimeoutExpired:
        fail("Forgejo transport timed out")
    except OSError:
        fail("Forgejo transport unavailable")
    finally:
        if process is not None:
            if not finished or process.poll() is None:
                try:
                    os.killpg(process.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
            process.wait()
            for stream in (process.stdin, process.stdout, process.stderr):
                if stream is not None:
                    stream.close()


def _forgejo_trusted_file(value):
    try:
        path = Path(value).resolve()
        details = path.stat()
    except (OSError, RuntimeError, ValueError):
        fail("Forgejo trusted executable unavailable")
    if (not stat.S_ISREG(details.st_mode) or not os.access(path, os.X_OK)
            or details.st_uid not in {0, os.getuid()} or details.st_mode & 0o022):
        fail("Forgejo trusted executable unavailable")
    return str(path)


def _forgejo_tools():
    """Select installed native Git without consulting an inherited PATH."""
    for candidate in ("/opt/homebrew/bin/git", "/usr/local/bin/git", "/usr/bin/git"):
        if Path(candidate).is_file():
            executable = _forgejo_trusted_file(candidate)
            version = _forgejo_run([executable, "--version"], cwd="/",
                                   env=_forgejo_environment(), timeout=5)
            match = re.fullmatch(r"git version ([0-9]+)\.([0-9]+)\.([0-9]+)(?:[^\r\n]*)\n?", version.stdout)
            if version.returncode or not match or tuple(map(int, match.groups())) < (2, 56, 0):
                fail("Forgejo Basic authentication capability unavailable")
            capabilities = _forgejo_run([executable, "credential", "capability"], cwd="/",
                                        env=_forgejo_environment(), timeout=5)
            lines = capabilities.stdout.splitlines()
            if (capabilities.returncode or not lines or lines[0] != "version 0"
                    or "capability authtype" not in lines[1:]):
                fail("Forgejo Basic authentication capability unavailable")
            result = _forgejo_run([executable, "--exec-path"], cwd="/",
                                   env=_forgejo_environment(), timeout=5)
            if result.returncode or not Path(result.stdout.strip()).is_absolute():
                fail("Forgejo trusted executable unavailable")
            return executable, str(Path(result.stdout.strip()).resolve())
    fail("Forgejo trusted executable unavailable")


def _forgejo_identity(identity):
    try:
        value = typed_repository_identity(identity, "Forgejo repository")
        if value["provider"] != "forgejo":
            fail("invalid provider")
        return value
    except (RuntimeError, ValueError, TypeError, KeyError):
        fail("Forgejo repository identity unavailable")


def forgejo_remote_urls(root, remote, identity):
    """Validate every configured endpoint and reject effective local rewrites."""
    identity = _forgejo_identity(identity)
    if (not isinstance(remote, str) or len(remote) > 128
            or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._/-]*", remote)
            or any(part in {"", ".", ".."} for part in remote.split("/"))):
        fail("Forgejo remote selection unavailable")
    executable, _ = _forgejo_tools()
    environment = _forgejo_environment()
    values = {}
    for kind, key in (("fetch_urls", "url"), ("push_urls", "pushurl")):
        result = _forgejo_run([executable, "config", "--null", "--get-all",
                              f"remote.{remote}.{key}"], cwd=root, env=environment, timeout=5)
        if result.returncode not in (0, 1):
            fail("Forgejo remote selection unavailable")
        values[kind] = result.stdout.rstrip("\0").split("\0") if result.stdout else []
    if not values["fetch_urls"]:
        fail("Forgejo remote selection unavailable")
    if not values["push_urls"]:
        values["push_urls"] = list(values["fetch_urls"])
    for url in values["fetch_urls"] + values["push_urls"]:
        try:
            if repository_identity_from_url(url, "forgejo") != identity:
                fail("endpoint mismatch")
        except (RuntimeError, ValueError, TypeError, KeyError):
            fail("Forgejo remote identity mismatch")
    for kind, arguments in (("fetch_urls", []), ("push_urls", ["--push"])):
        result = _forgejo_run([executable, "remote", "get-url", *arguments, "--all", remote],
                              cwd=root, env=environment, timeout=5)
        if result.returncode or result.stdout.splitlines() != values[kind]:
            fail("Forgejo URL rewriting is unavailable")
    return {**values, "url": identity["origin"] + "/" + identity["repository"] + ".git"}


def _forgejo_security_lookup(query):
    """Read exact native internet-password matches with authentication UI denied."""
    import ctypes
    if sys.platform != "darwin":
        fail("Forgejo native credential unavailable")
    references = []
    result = ctypes.c_void_p()
    credential_result = ctypes.c_void_p()
    core, security, interaction = None, None, None
    try:
        core = ctypes.CDLL("/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation")
        security = ctypes.CDLL("/System/Library/Frameworks/Security.framework/Security")
        pointer, index = ctypes.c_void_p, ctypes.c_long
        signatures = {
            "CFDictionaryCreateMutable": ([pointer, index, pointer, pointer], pointer),
            "CFDictionarySetValue": ([pointer, pointer, pointer], None),
            "CFDictionaryGetValue": ([pointer, pointer], pointer),
            "CFStringCreateWithCString": ([pointer, ctypes.c_char_p, ctypes.c_uint32], pointer),
            "CFStringGetCString": ([pointer, pointer, index, ctypes.c_uint32], ctypes.c_ubyte),
            "CFNumberCreate": ([pointer, ctypes.c_int, pointer], pointer),
            "CFNumberGetValue": ([pointer, ctypes.c_int, pointer], ctypes.c_ubyte),
            "CFArrayGetCount": ([pointer], index),
            "CFArrayGetValueAtIndex": ([pointer, index], pointer),
            "CFArrayCreate": ([pointer, pointer, index, pointer], pointer),
            "CFDataGetLength": ([pointer], index),
            "CFDataGetBytePtr": ([pointer], pointer),
            "CFGetTypeID": ([pointer], ctypes.c_ulong),
            "CFArrayGetTypeID": ([], ctypes.c_ulong),
            "CFDictionaryGetTypeID": ([], ctypes.c_ulong),
            "CFStringGetTypeID": ([], ctypes.c_ulong),
            "CFNumberGetTypeID": ([], ctypes.c_ulong),
            "CFDataGetTypeID": ([], ctypes.c_ulong),
            "CFEqual": ([pointer, pointer], ctypes.c_ubyte), "CFRelease": ([pointer], None),
        }
        for name, (arguments, returned) in signatures.items():
            function = getattr(core, name)
            function.argtypes, function.restype = arguments, returned
        security.SecItemCopyMatching.argtypes = [pointer, ctypes.POINTER(pointer)]
        security.SecItemCopyMatching.restype = ctypes.c_int32
        security.SecKeychainItemGetTypeID.argtypes = []
        security.SecKeychainItemGetTypeID.restype = ctypes.c_ulong
        security.SecKeychainGetUserInteractionAllowed.argtypes = [ctypes.POINTER(ctypes.c_ubyte)]
        security.SecKeychainGetUserInteractionAllowed.restype = ctypes.c_int32
        security.SecKeychainSetUserInteractionAllowed.argtypes = [ctypes.c_ubyte]
        security.SecKeychainSetUserInteractionAllowed.restype = ctypes.c_int32
        previous_interaction = ctypes.c_ubyte()
        if (security.SecKeychainGetUserInteractionAllowed(ctypes.byref(previous_interaction)) != 0
                or security.SecKeychainSetUserInteractionAllowed(0) != 0):
            fail("Forgejo native credential unavailable")
        interaction = previous_interaction.value

        def symbol(library, name):
            return pointer.in_dll(library, name).value

        def string(value):
            reference = core.CFStringCreateWithCString(None, value.encode("utf-8"), 0x08000100)
            if not reference:
                raise ValueError()
            references.append(reference)
            return reference

        dictionary = core.CFDictionaryCreateMutable(None, 0,
            ctypes.addressof(ctypes.c_byte.in_dll(core, "kCFTypeDictionaryKeyCallBacks")),
            ctypes.addressof(ctypes.c_byte.in_dll(core, "kCFTypeDictionaryValueCallBacks")))
        if not dictionary:
            raise ValueError()
        references.append(dictionary)
        port = ctypes.c_int64(query["port"])
        port_value = core.CFNumberCreate(None, 4, ctypes.byref(port))
        if not port_value:
            raise ValueError()
        references.append(port_value)
        fields = {"kSecClass": symbol(security, "kSecClassInternetPassword"),
                  "kSecAttrProtocol": symbol(security, "kSecAttrProtocolHTTPS"),
                  "kSecAttrAuthenticationType": symbol(security, "kSecAttrAuthenticationTypeDefault"),
                  "kSecAttrServer": string(query["server"]), "kSecAttrPort": port_value,
                  "kSecAttrAccount": string(query["account"]), "kSecAttrPath": string(query["path"]),
                  "kSecUseAuthenticationUI": symbol(security, "kSecUseAuthenticationUIFail"),
                  "kSecMatchLimit": symbol(security, "kSecMatchLimitAll"),
                  "kSecReturnAttributes": symbol(core, "kCFBooleanTrue"),
                  "kSecReturnRef": symbol(core, "kCFBooleanTrue")}
        for key, value in fields.items():
            core.CFDictionarySetValue(dictionary, symbol(security, key), value)
        if security.SecItemCopyMatching(dictionary, ctypes.byref(result)) != 0 or not result.value:
            fail("Forgejo native credential unavailable")
        if core.CFGetTypeID(result) != core.CFArrayGetTypeID() or core.CFArrayGetCount(result) != 1:
            fail("Forgejo native credential selection unavailable")
        item = core.CFArrayGetValueAtIndex(result, 0)
        if core.CFGetTypeID(item) != core.CFDictionaryGetTypeID():
            raise ValueError()

        def attribute(record, name, expected_type):
            value = core.CFDictionaryGetValue(record, symbol(security, name))
            if not value or core.CFGetTypeID(value) != expected_type():
                raise ValueError()
            return value

        def text(record, name):
            value = attribute(record, name, core.CFStringGetTypeID)
            buffer = ctypes.create_string_buffer(8192)
            if not core.CFStringGetCString(value, buffer, len(buffer), 0x08000100):
                raise ValueError()
            return buffer.value.decode("utf-8")

        def attributes(record):
            actual_port = ctypes.c_int64()
            if not core.CFNumberGetValue(attribute(record, "kSecAttrPort", core.CFNumberGetTypeID), 4,
                                         ctypes.byref(actual_port)):
                raise ValueError()
            protocol = core.CFDictionaryGetValue(record, symbol(security, "kSecAttrProtocol"))
            https = False
            if protocol and core.CFGetTypeID(protocol) == core.CFStringGetTypeID():
                https = bool(core.CFEqual(protocol, symbol(security, "kSecAttrProtocolHTTPS")))
            elif protocol and core.CFGetTypeID(protocol) == core.CFNumberGetTypeID():
                number = ctypes.c_int64()
                https = bool(core.CFNumberGetValue(protocol, 4, ctypes.byref(number))) and number.value == int.from_bytes(b"htps", "big")
            if not https:
                raise ValueError()
            value = {"server": text(record, "kSecAttrServer"), "port": actual_port.value,
                     "account": text(record, "kSecAttrAccount"), "path": text(record, "kSecAttrPath"),
                     "protocol": "https"}
            if any(value[key] != query[key] for key in value):
                raise ValueError()
            return value

        selected = attributes(item)
        item_reference = attribute(item, "kSecValueRef", security.SecKeychainItemGetTypeID)
        entries = (pointer * 1)(item_reference)
        item_list = core.CFArrayCreate(None, entries, 1,
            ctypes.addressof(ctypes.c_byte.in_dll(core, "kCFTypeArrayCallBacks")))
        if not item_list:
            raise ValueError()
        references.append(item_list)
        data_query = core.CFDictionaryCreateMutable(None, 0,
            ctypes.addressof(ctypes.c_byte.in_dll(core, "kCFTypeDictionaryKeyCallBacks")),
            ctypes.addressof(ctypes.c_byte.in_dll(core, "kCFTypeDictionaryValueCallBacks")))
        if not data_query:
            raise ValueError()
        references.append(data_query)
        data_fields = {key: value for key, value in fields.items() if key != "kSecReturnRef"}
        data_fields.update({"kSecMatchLimit": symbol(security, "kSecMatchLimitOne"),
                            "kSecMatchItemList": item_list,
                            "kSecReturnData": symbol(core, "kCFBooleanTrue")})
        for key, value in data_fields.items():
            core.CFDictionarySetValue(data_query, symbol(security, key), value)
        if (security.SecItemCopyMatching(data_query, ctypes.byref(credential_result)) != 0
                or not credential_result.value
                or core.CFGetTypeID(credential_result) != core.CFDictionaryGetTypeID()):
            fail("Forgejo native credential unavailable")
        if attributes(credential_result) != selected:
            raise ValueError()
        data = attribute(credential_result, "kSecValueData", core.CFDataGetTypeID)
        length = core.CFDataGetLength(data)
        if not 0 < length <= 4096:
            raise ValueError()
        password = ctypes.string_at(core.CFDataGetBytePtr(data), length).decode("utf-8")
        return [{**selected, "password": password}]
    except (OSError, AttributeError, ValueError, TypeError, KeyError, ctypes.ArgumentError):
        fail("Forgejo native credential unavailable")
    finally:
        if security is not None and interaction is not None:
            security.SecKeychainSetUserInteractionAllowed(interaction)
        if core is not None:
            if credential_result.value:
                core.CFRelease(credential_result)
            if result.value:
                core.CFRelease(result)
            for reference in reversed(references):
                core.CFRelease(reference)


def forgejo_credential_helper(operation, identity, account):
    """Implement the get-only Git helper protocol; native storage is never changed."""
    if operation != "get":
        return
    identity = _forgejo_identity(identity)
    if not isinstance(account, str) or not OPAQUE_ID.fullmatch(account):
        fail("Forgejo credential selection unavailable")
    request = sys.stdin.read(8193)
    if len(request) > 8192:
        fail("Forgejo credential request unavailable")
    fields, capabilities = {}, set()
    for line in request.splitlines():
        if not line:
            break
        key, separator, value = line.partition("=")
        if key == "capability[]" and separator:
            if fields or value not in {"authtype", "state"} or value in capabilities:
                fail("Forgejo credential capability unavailable")
            capabilities.add(value)
            continue
        if key == "wwwauth[]" and separator:
            continue
        if (not separator or key in fields
                or key not in {"protocol", "host", "path", "username", "authtype"}):
            fail("Forgejo credential request unavailable")
        fields[key] = value
    if "authtype" not in capabilities or fields.pop("authtype", "basic") != "basic":
        fail("Forgejo Basic authentication capability unavailable")
    parsed = urlsplit(identity["origin"])
    expected = {"protocol": "https", "host": parsed.netloc,
                "path": identity["repository"] + ".git", "username": account}
    if fields != expected:
        fail("Forgejo credential request mismatch")
    query = {"server": parsed.hostname, "port": parsed.port or 0, "protocol": "https",
             "account": account, "path": expected["path"], "authentication": "default",
             "authentication_ui": "fail", "match_limit": "all"}
    matches = _forgejo_security_lookup(query)
    if not isinstance(matches, list) or len(matches) != 1 or not isinstance(matches[0], dict):
        fail("Forgejo native credential selection unavailable")
    item = matches[0]
    if any(item.get(key) != query[key] for key in ("server", "port", "protocol", "account", "path")):
        fail("Forgejo native credential selection mismatch")
    password = item.get("password")
    if (not isinstance(password, str) or not 0 < len(password) <= 4096
            or any(character in password for character in "\r\n\0") or "\ufffd" in password):
        fail("Forgejo native credential unavailable")
    encoded = base64.b64encode((account + ":" + password).encode("utf-8")).decode("ascii")
    sys.stdout.write(f"capability[]=authtype\nauthtype=basic\ncredential={encoded}\nephemeral=true\n\n")
    sys.stdout.flush()


def forgejo_internal_main(argv):
    """Handle the fixed internal helper before ordinary CLI or lifecycle dispatch."""
    if argv[:1] != ["_forgejo-credential"]:
        return False
    try:
        if len(argv) != 6 or argv[1] != "--identity-json" or argv[3] != "--account":
            raise ValueError()
        if argv[5] == "get":
            import pwd
            home = pwd.getpwuid(os.getuid()).pw_dir
            if (not isinstance(home, str) or not Path(home).is_absolute()
                    or any(ord(character) < 32 for character in home)):
                raise ValueError()
            # Only this isolated credential child needs the native user's
            # Keychain preferences. Its Git parent keeps the private home.
            os.environ["HOME"] = home
        forgejo_credential_helper(argv[5], json.loads(argv[2]), argv[4])
    except Exception:
        sys.stdout.write("quit=true\n\n")
        sys.stdout.flush()
    return True


def fetch_forgejo_branch(root, remote, identity, base_branch, account):
    """Fetch one comparison ref; filesystem failures retain a fixed safe category."""
    try:
        return _fetch_forgejo_branch(root, remote, identity, base_branch, account)
    except (OSError, ValueError, subprocess.SubprocessError):
        fail("Forgejo transport unavailable")


def _fetch_forgejo_branch(root, remote, identity, base_branch, account):
    """Keep source configuration outside the network transport process."""
    import shlex
    identity = _forgejo_identity(identity)
    if not isinstance(account, str) or not OPAQUE_ID.fullmatch(account):
        fail("Forgejo credential selection unavailable")
    executable, exec_path = _forgejo_tools()
    environment = _forgejo_environment()
    tracking = f"refs/remotes/{remote}/{base_branch}"
    for reference in (f"refs/heads/{base_branch}", tracking):
        if (not isinstance(base_branch, str) or len(base_branch) > 1024
                or _forgejo_run([executable, "check-ref-format", reference], cwd=root,
                                 env=environment, timeout=5).returncode):
            fail("Forgejo comparison ref unavailable")
    destinations = forgejo_remote_urls(root, remote, identity)
    common = _forgejo_run([executable, "rev-parse", "--git-common-dir"], cwd=root,
                           env=environment, timeout=5)
    object_format = _forgejo_run([executable, "rev-parse", "--show-object-format"], cwd=root,
                                  env=environment, timeout=5)
    if common.returncode or object_format.returncode or object_format.stdout.strip() not in {"sha1", "sha256"}:
        fail("Forgejo object store unavailable")
    common_path = Path(common.stdout.strip())
    object_path = ((common_path if common_path.is_absolute() else root / common_path) / "objects").resolve()
    if not object_path.is_dir():
        fail("Forgejo object store unavailable")
    previous = _forgejo_run([executable, "rev-parse", "--verify", "--quiet", tracking],
                             cwd=root, env=environment, timeout=5)
    if previous.returncode not in (0, 1):
        fail("Forgejo comparison ref unavailable")
    deadline = time.monotonic() + 30
    with tempfile.TemporaryDirectory(prefix="dbsctr-forgejo-") as directory:
        private = Path(directory)
        private.chmod(0o700)
        private_home = private / "home"
        private_home.mkdir(mode=0o700)
        control = private / "control.git"
        environment = _forgejo_environment(private_home)
        environment["GIT_EXEC_PATH"] = exec_path
        result = _forgejo_run([executable, "init", "--bare", "--template=",
                              "--object-format=" + object_format.stdout.strip(), str(control)],
                              cwd=private, env=environment, timeout=max(0.001, deadline - time.monotonic()))
        if result.returncode:
            fail("Forgejo transport initialization unavailable")
        environment.update({"GIT_DIR": str(control), "GIT_OBJECT_DIRECTORY": str(object_path)})
        helper = "!exec " + shlex.join([_forgejo_trusted_file(sys.executable), "-I", "-B",
            str(Path(__file__).resolve()), "_forgejo-credential", "--identity-json",
            json.dumps(identity, sort_keys=True, separators=(",", ":")), "--account", account])
        settings = {"core.hooksPath": "/dev/null", "credential.helper": "",
                    "credential.useHttpPath": "true", "credential.username": account,
                    "http.sslVerify": "true", "http.followRedirects": "false", "http.proxy": "",
                    "http.extraHeader": "", "http.cookieFile": "", "http.saveCookies": "false",
                    "http.emptyAuth": "false", "http.proactiveAuth": "basic", "http.delegation": "none",
                    "gc.auto": "0", "maintenance.auto": "false", "fetch.fsckObjects": "true",
                    "promisor.acceptFromServer": "none"}
        arguments = [executable]
        for key, value in settings.items():
            arguments.extend(["-c", f"{key}={value}"])
        arguments.extend(["-c", "credential.helper=" + helper, "fetch", "--no-tags",
                          "--no-recurse-submodules", "--no-auto-maintenance", "--no-write-commit-graph",
                          "--no-write-fetch-head", "--", destinations["url"],
                          f"+refs/heads/{base_branch}:refs/dbsctr-fetch/base"])
        result = _forgejo_run(arguments, cwd=control, env=environment,
                              timeout=max(0.001, deadline - time.monotonic()))
        if result.returncode:
            fail("Forgejo comparison fetch unavailable")
        observed = _forgejo_run([executable, "rev-parse", "--verify", "refs/dbsctr-fetch/base"],
                                 cwd=control, env=environment, timeout=max(0.001, deadline - time.monotonic()))
        head = observed.stdout.strip()
        if observed.returncode or not re.fullmatch(r"[0-9a-f]{40}|[0-9a-f]{64}", head):
            fail("Forgejo comparison object unavailable")
        kind = _forgejo_run([executable, "cat-file", "-t", head], cwd=control, env=environment,
                            timeout=max(0.001, deadline - time.monotonic()))
        if kind.returncode or kind.stdout.strip() != "commit":
            fail("Forgejo comparison object unavailable")
        if forgejo_remote_urls(root, remote, identity) != destinations:
            fail("Forgejo remote selection changed")
        old = previous.stdout.strip() if previous.returncode == 0 else "0" * len(head)
        result = _forgejo_run([executable, "-c", "core.hooksPath=/dev/null", "update-ref",
                              "--no-deref", tracking, head, old], cwd=root, env=_forgejo_environment(),
                              timeout=max(0.001, deadline - time.monotonic()))
        if result.returncode:
            fail("Forgejo comparison ref changed")
        return head


def initiative_repository(value, label):
    if (not isinstance(value, str)
            or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*", value)):
        fail(f"{label} must be a canonical owner/repository identity")


def typed_repository_identity(value, label="repository"):
    """Validate the full public identity without inferring a host or account."""
    if not isinstance(value, dict) or set(value) != {"provider", "origin", "repository"}:
        fail(f"{label} requires exactly provider, origin and repository")
    provider, origin, repository = (value[key] for key in ("provider", "origin", "repository"))
    if not isinstance(provider, str) or provider not in {"github", "forgejo"}:
        fail(f"{label} provider is unsupported")
    if (not isinstance(origin, str) or len(origin) > 1024
            or not re.fullmatch(r"https://[A-Za-z0-9.-]+(?::[1-9][0-9]{0,4})?", origin)):
        fail(f"{label} origin must be a canonical HTTPS authority")
    try:
        parsed = urlsplit(origin)
        hostname, port = parsed.hostname, parsed.port
    except ValueError:
        fail(f"{label} origin is invalid")
    if (not hostname or len(hostname) > 253 or hostname.endswith(".")
            or any(not re.fullmatch(r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?", part)
                   for part in hostname.split("."))
            or port is not None and not 1 <= port <= 65535):
        fail(f"{label} origin is invalid")
    canonical = "https://" + hostname + (":" + str(port) if port not in (None, 443) else "")
    if provider == "github" and canonical != "https://github.com":
        fail(f"{label} GitHub origin must be https://github.com")
    initiative_repository(repository, label)
    if any(not OPAQUE_ID.fullmatch(part) for part in repository.split("/")):
        fail(f"{label} repository components exceed their portable bounds")
    return {"provider": provider, "origin": canonical, "repository": repository}


def repository_equal(left, right):
    if isinstance(left, str) or isinstance(right, str):
        return isinstance(left, str) and isinstance(right, str) and left.lower() == right.lower()
    left = typed_repository_identity(left)
    right = typed_repository_identity(right)
    return (left["provider"] == right["provider"] and left["origin"] == right["origin"]
            and (left["repository"].lower() == right["repository"].lower()
                 if left["provider"] == "github" else left["repository"] == right["repository"]))


def repository_identity_from_url(url, provider):
    if provider == "github":
        try:
            parsed = urlsplit(url)
            if parsed.scheme == "https" and parsed.port not in (None, 443):
                fail("typed GitHub repository requires its canonical HTTPS port")
        except ValueError:
            fail("typed GitHub repository origin is invalid")
        return typed_repository_identity({"provider": provider, "origin": "https://github.com",
            "repository": github_repository_from_url(url, "GitHub repository origin is invalid")})
    if not isinstance(url, str):
        fail("repository origin is invalid")
    match = re.fullmatch(r"(https://[^/]+)/([A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*?)\.git", url)
    if not match:
        fail("Forgejo repository origin requires its canonical HTTPS Git endpoint")
    identity = typed_repository_identity({"provider": provider, "origin": match[1], "repository": match[2]})
    if url != identity["origin"] + "/" + identity["repository"] + ".git":
        fail("Forgejo repository origin must be canonical")
    return identity


def require_repository_home(root, expected, mismatch="Initiative repository identity does not match its Git origin"):
    if isinstance(expected, str):
        matches = repository_equal(git_repository_slug(root), expected)
    else:
        expected = typed_repository_identity(expected)
        matches = True
        for push in (False, True):
            arguments = ("remote", "get-url", "--all", "--push", "origin") if push else (
                "remote", "get-url", "--all", "origin")
            urls = git(root, *arguments, check=False).stdout.splitlines()
            if expected["provider"] == "forgejo":
                raw = git(root, "config", "--get-all", "remote.origin." + ("pushurl" if push else "url"),
                          check=False).stdout.splitlines()
                if push and not raw:
                    raw = git(root, "config", "--get-all", "remote.origin.url", check=False).stdout.splitlines()
                matches &= raw == urls
            matches &= bool(urls) and all(repository_equal(
                repository_identity_from_url(url, expected["provider"]), expected) for url in urls)
    if not matches:
        fail(mismatch)


def forgejo_selection(args):
    selected = [getattr(args, "forge_" + field, None)
                for field in ("provider", "origin", "repository", "account")]
    if not any(value is not None for value in selected):
        return None
    if (not all(isinstance(value, str) and value for value in selected)
            or selected[0] != "forgejo"
            or getattr(args, "github_account", None) is not None
            or getattr(args, "github_repository", None) is not None):
        fail("Forgejo selection requires all four selectors and cannot mix GitHub selectors")
    if args.delivery_intent != "local":
        fail("Forgejo supports local-only registration; remote delivery is unavailable")
    identity = typed_repository_identity(dict(zip(("provider", "origin", "repository"), selected[:3])),
                                         "Forgejo selection")
    if not OPAQUE_ID.fullmatch(selected[3]):
        fail("Forgejo account selection is invalid")
    return {**identity, "account": selected[3], "credential_source": "osxkeychain"}


def expected_repository(args, schema):
    legacy = getattr(args, "expected_repository", None)
    encoded = getattr(args, "expected_repository_json", None)
    if schema == 1:
        if encoded is not None or legacy is None:
            fail("schema 1 requires the legacy expected repository")
        initiative_repository(legacy, "expected repository")
        return legacy
    if legacy is not None or not isinstance(encoded, str):
        fail("schema 2 requires a typed expected repository JSON object")
    try:
        value = json.loads(encoded, object_pairs_hook=no_duplicate_keys)
    except (ValueError, json.JSONDecodeError):
        fail("typed expected repository JSON is invalid")
    return typed_repository_identity(value, "expected repository")


def validate_local_initiative_receipt(receipt):
    fields = {"schema_version", "initiative_id", "slice_id", "manifest_digest", "manifest_blob",
              "manifest_commit", "manifest_path", "coordinator_repository", "context", "repository",
              "requirements", "depends_on", "artifacts", "release_group", "execution_owner"}
    if (not isinstance(receipt, dict) or set(receipt) != fields
            or type(receipt["schema_version"]) is not int or receipt["schema_version"] != 2
            or receipt["execution_owner"] != "build"):
        fail("invalid local-only Initiative receipt")
    for key in ("initiative_id", "slice_id", "release_group"):
        if not isinstance(receipt[key], str) or not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,127}", receipt[key]):
            fail("invalid local-only Initiative identity")
    for key in ("coordinator_repository", "repository"):
        if typed_repository_identity(receipt[key]) != receipt[key]:
            fail("noncanonical local-only Initiative repository")
    if (not isinstance(receipt["manifest_path"], str)
            or not re.fullmatch(r"docs/initiatives/[a-z0-9][a-z0-9-]*/MANIFEST\.json", receipt["manifest_path"])):
        fail("invalid local-only Initiative manifest path")
    initiative_strings(receipt["requirements"], "local-only requirements", allow_empty=False)
    initiative_strings(receipt["depends_on"], "local-only dependencies")
    initiative_paths(receipt["artifacts"], "local-only Initiative artifacts")
    if (not receipt["artifacts"] or any(not re.fullmatch(r"INT-[0-9]{3,}", item) for item in receipt["requirements"])
            or any(not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,127}", item) for item in receipt["depends_on"])):
        fail("invalid local-only Initiative coverage")


def github_repository_from_url(url, error):
    scp = re.fullmatch(r"(?:git@)?github\.com:([^/\s]+/[^/\s]+?)(?:\.git)?", url, re.IGNORECASE)
    if scp:
        return scp.group(1)
    try:
        parsed = urlsplit(url)
        valid_user = parsed.username is None or parsed.scheme == "ssh" and parsed.username == "git"
        valid = (parsed.scheme in {"https", "ssh", "git"} and parsed.hostname == "github.com"
                 and valid_user and parsed.password is None and not parsed.query and not parsed.fragment)
    except ValueError:
        valid = False
    if not valid:
        fail(error)
    match = re.fullmatch(r"/([^/\s]+/[^/\s]+?)(?:\.git)?/?", parsed.path)
    if not match:
        fail(error)
    return match.group(1)


def git_repository_slug(root):
    url = git(root, "remote", "get-url", "origin", check=False).stdout.strip()
    return github_repository_from_url(url, "Initiative repository must have a GitHub origin")


def github_remote_url(root, remote, repository):
    for push in (False, True):
        args = ("remote", "get-url", "--push", remote) if push else ("remote", "get-url", remote)
        url = git(root, *args, check=False).stdout.strip()
        if not url or github_repository_from_url(
                url, "draft_pr delivery requires GitHub fetch and push remotes"
        ).lower() != repository.lower():
            fail("draft_pr remote must match configured GitHub repository: " + repository)
    return f"https://github.com/{repository}.git"


def require_canonical_github_url(root, url, env):
    effective = git(root, "ls-remote", "--get-url", url, env=env).stdout.strip()
    if effective != url:
        fail("Git URL rewriting is not allowed for draft_pr delivery")


def fetch_github_branch(root, remote, url, remote_branch, env):
    require_canonical_github_url(root, url, env)
    git(root, "fetch", url,
        f"+refs/heads/{remote_branch}:refs/remotes/{remote}/{remote_branch}", env=env)


def github_remote_head(root, url, remote_ref, env):
    require_canonical_github_url(root, url, env)
    return git(root, "ls-remote", "--heads", url, remote_ref, env=env).stdout.split()


def push_github_branch(root, url, remote_branch, env):
    require_canonical_github_url(root, url, env)
    git(root, "push", url, f"HEAD:{remote_branch}", env=env)


def normalize_begin_delivery(root, args, delivery_branch):
    if forgejo_selection(args) is not None:
        return
    if args.delivery_intent == "merge" and delivery_branch == args.base_branch:
        args.delivery_intent = "draft_pr"
    elif args.delivery_intent != "draft_pr" and delivery_branch == args.base_branch:
        fail("direct delivery to the protected base branch requires draft_pr")
    if args.delivery_intent != "draft_pr":
        return
    account = getattr(args, "github_account", None)
    if not account or not OPAQUE_ID.fullmatch(account):
        fail("draft_pr delivery requires a valid GitHub account")
    repository = git_repository_slug(root)
    supplied = getattr(args, "github_repository", None)
    if supplied:
        expected = repository if "/" in supplied else repository.rsplit("/", 1)[1]
        if supplied.lower() != expected.lower():
            fail("GitHub repository must match configured GitHub repository: " + repository)
    args.github_repository = repository


def initiative_acyclic(dependencies, label):
    visiting = set()
    visited = set()

    def visit(node):
        if node in visiting:
            fail(f"{label} dependency cycle includes {node}")
        if node in visited:
            return
        visiting.add(node)
        for dependency in dependencies[node]:
            visit(dependency)
        visiting.remove(node)
        visited.add(node)

    for node in sorted(dependencies):
        visit(node)


def read_initiative_manifest(source, *, raw=None):
    try:
        raw = Path(source).read_bytes() if raw is None else raw
        if len(raw) > 1024 * 1024:
            fail("Initiative manifest exceeds 1 MiB")
        value = json.loads(raw.decode("utf-8"), object_pairs_hook=initiative_no_duplicate_keys)
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        fail(f"cannot read Initiative manifest: {error}")
    initiative_fields(value, {
        "schema_version", "id", "title", "state", "coordinator_repository", "statements",
        "contexts", "slices", "release_groups",
    }, "Initiative manifest")
    if type(value["schema_version"]) is not int or value["schema_version"] not in (1, 2):
        fail("Initiative manifest schema_version must be 1 or 2")
    if not isinstance(value["id"], str) or not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,127}", value["id"]):
        fail("Initiative ID is invalid")
    if not isinstance(value["title"], str) or not value["title"].strip():
        fail("Initiative title is invalid")
    if value["schema_version"] == 2:
        value["coordinator_repository"] = typed_repository_identity(
            value["coordinator_repository"], "Initiative coordinator_repository")
    else:
        initiative_repository(value["coordinator_repository"], "Initiative coordinator_repository")
    if value["state"] not in {"captured", "discovering", "ready", "building", "delivered",
                               "blocked", "deferred", "rejected", "complete"}:
        fail("Initiative state is invalid")
    for name in ("statements", "contexts", "slices", "release_groups"):
        if not isinstance(value[name], list):
            fail(f"Initiative manifest {name} must be an array")

    statement_fields = {"id", "kind", "text", "disposition", "artifacts"}
    statements = {}
    for item in value["statements"]:
        initiative_fields(item, statement_fields, "material statement")
        identifier = item["id"]
        if not isinstance(identifier, str) or not re.fullmatch(r"INT-[0-9]{3,}", identifier):
            fail("material statement ID is invalid")
        if identifier in statements:
            fail(f"duplicate material statement ID: {identifier}")
        if item["kind"] not in {"requirement", "constraint", "decision", "risk", "idea", "non-goal"}:
            fail(f"material statement kind is invalid: {identifier}")
        if not isinstance(item["text"], str) or not item["text"].strip():
            fail(f"material statement text is invalid: {identifier}")
        if item["disposition"] not in {"open", "blocked", "ready", "delivered", "deferred", "rejected"}:
            fail(f"material statement disposition is invalid: {identifier}")
        initiative_paths(item["artifacts"], f"artifacts for {identifier}")
        statements[identifier] = item

    context_fields = {"id", "repository", "status", "depends_on"}
    contexts = {}
    for item in value["contexts"]:
        initiative_fields(item, context_fields, "context")
        identifier = item["id"]
        if not isinstance(identifier, str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_-]{0,127}", identifier):
            fail("context ID is invalid")
        if identifier in contexts:
            fail(f"duplicate context ID: {identifier}")
        if value["schema_version"] == 2:
            item["repository"] = typed_repository_identity(item["repository"], f"repository for {identifier}")
        else:
            initiative_repository(item["repository"], f"repository for {identifier}")
        initiative_strings(item["depends_on"], f"depends_on for {identifier}")
        if item["status"] not in {"captured", "approved", "discovering", "ready", "building",
                                   "delivered", "blocked", "deferred", "rejected"}:
            fail(f"context state is invalid: {identifier}")
        contexts[identifier] = item

    context_dependencies = {}
    for identifier, item in contexts.items():
        for dependency in item["depends_on"]:
            if dependency not in contexts:
                fail(f"unknown context dependency {dependency}: {identifier}")
        context_dependencies[identifier] = item["depends_on"]
    initiative_acyclic(context_dependencies, "context")

    slice_fields = {"id", "context", "state", "requirements", "depends_on", "artifacts",
                    "release_group"}
    slices = {}
    for item in value["slices"]:
        optional = {field for field in ("tickets", "execution_owner")
                    if isinstance(item, dict) and field in item}
        initiative_fields(item, slice_fields | optional, "slice")
        identifier = item["id"]
        if not isinstance(identifier, str) or not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,127}", identifier):
            fail("slice ID is invalid")
        if identifier in slices:
            fail(f"duplicate slice ID: {identifier}")
        if item["context"] not in contexts:
            fail(f"unknown context for slice {identifier}: {item['context']}")
        for field in ("requirements", "depends_on"):
            initiative_strings(item[field], f"{field} for {identifier}")
        initiative_paths(item["artifacts"], f"artifacts for {identifier}")
        if not isinstance(item["release_group"], str) or not item["release_group"]:
            fail(f"release_group is invalid: {identifier}")
        if item.get("execution_owner", "build") not in {"build", "discovery"}:
            fail(f"execution_owner is invalid: {identifier}")
        if item["state"] not in {"captured", "discovering", "ready", "building", "delivered",
                                    "blocked", "deferred", "rejected"}:
            fail(f"slice state is invalid: {identifier}")
        for requirement in item["requirements"]:
            if requirement not in statements:
                fail(f"unknown material statement {requirement} required by {identifier}")
        if item["state"] == "ready":
            if contexts[item["context"]]["status"] not in {
                    "approved", "discovering", "ready", "building", "delivered"}:
                fail(f"ready slice {identifier} context is not promotable: {item['context']}")
            for field in ("requirements", "artifacts"):
                if not item[field]:
                    fail(f"ready slice {identifier} requires {field}")
            blocked = [requirement for requirement in item["requirements"]
                       if statements[requirement]["disposition"] in {"open", "blocked"}]
            if blocked:
                fail(f"ready slice {identifier} has unresolved material statement: {blocked[0]}")
        slices[identifier] = item

    slice_dependencies = {}
    for identifier, item in slices.items():
        for dependency in item["depends_on"]:
            if dependency not in slices:
                fail(f"unknown slice dependency {dependency}: {identifier}")
        slice_dependencies[identifier] = item["depends_on"]
    initiative_acyclic(slice_dependencies, "slice")
    for identifier, item in slices.items():
        if item["state"] != "ready":
            continue
        for dependency in item["depends_on"]:
            if slices[dependency]["state"] != "delivered":
                fail(f"ready slice {identifier} dependency is not delivered: {dependency}")
        for dependency in contexts[item["context"]]["depends_on"]:
            if contexts[dependency]["status"] not in {"ready", "building", "delivered"}:
                fail(f"ready slice {identifier} context dependency is not ready: {dependency}")

    for identifier, item in statements.items():
        covered = item["artifacts"] or any(identifier in slice_item["requirements"]
                                            for slice_item in slices.values())
        if item["disposition"] not in {"deferred", "rejected"} and not covered:
            fail(f"uncovered material statement: {identifier}")

    release_fields = {"id", "members", "state"}
    release_groups = {}
    slice_release_groups = {}
    for item in value["release_groups"]:
        initiative_fields(item, release_fields, "release group")
        identifier = item["id"]
        if not isinstance(identifier, str) or not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,127}", identifier):
            fail("release-group ID is invalid")
        if identifier in release_groups:
            fail(f"duplicate release-group ID: {identifier}")
        if item["state"] not in {"planning", "ready", "building", "delivered", "blocked",
                                   "deferred", "rejected"}:
            fail(f"release-group state is invalid: {identifier}")
        initiative_strings(item["members"], f"members for {identifier}")
        for slice_id in item["members"]:
            if slice_id not in slices:
                fail(f"unknown slice {slice_id} in release group {identifier}")
            if slice_id in slice_release_groups:
                fail(f"slice {slice_id} belongs to multiple release groups")
            if slices[slice_id]["release_group"] != identifier:
                fail(f"release group mismatch for slice {slice_id}")
            slice_release_groups[slice_id] = identifier
        release_groups[identifier] = item
    for identifier, item in slices.items():
        if item["release_group"] not in release_groups:
            fail(f"unknown release group {item['release_group']} for slice {identifier}")
        if identifier not in slice_release_groups:
            fail(f"slice {identifier} is missing from release group {item['release_group']}")

    if value["state"] == "complete":
        unresolved = [identifier for identifier, item in statements.items()
                      if item["disposition"] in {"open", "blocked"}]
        nonterminal = [identifier for identifier, item in slices.items()
                       if item["state"] not in {"delivered", "deferred", "rejected"}]
        if unresolved or nonterminal:
            fail("Initiative cannot complete with open or blocked material or nonterminal slices")

    identity_value = {**value, "slices": [
        {key: field for key, field in item.items() if key != "tickets"}
        for item in value["slices"]
    ]}
    canonical = json.dumps(identity_value, sort_keys=True, separators=(",", ":"), ensure_ascii=True)
    return value, statements, contexts, slices, slice_release_groups, hashlib.sha256(canonical.encode()).hexdigest()


def initiative_summary(source):
    value, _, contexts, slices, release_groups, digest = read_initiative_manifest(source)
    return {
        "schema_version": value["schema_version"],
        "initiative_id": value["id"],
        "state": value["state"],
        "manifest_digest": digest,
        "ready_slices": sorted(identifier for identifier, item in slices.items() if item["state"] == "ready"),
        "counts": {
            "statements": len(value["statements"]),
            "contexts": len(contexts),
            "slices": len(slices),
            "release_groups": len(value["release_groups"]),
        },
    }


def command_initiative_check(args):
    print(json.dumps(initiative_summary(args.manifest), sort_keys=True, separators=(",", ":")))


def check_initiative_cycle_occupancy(root, cycle_id, receipt):
    required_record = {"schema_version", "cycle_id", "context", "state", "delivery",
                       "delivery_intent", "risk", "worktree", "applicability_plan",
                       "engineering_profile", "git", "source", "created_at", "gates",
                       "commits", "evidence", "metrics", "method_revision"}
    record_path = cycle_dir(root) / "cycles" / f"{cycle_id}.json"
    if not record_path.exists() and not record_path.is_symlink():
        return
    if record_path.is_symlink() or not record_path.is_file():
        fail(f"Initiative cycle record is unsafe: {cycle_id}")
    try:
        record = read_cycle_record(root, record_path, historical=True)
    except (OSError, ValueError, json.JSONDecodeError):
        fail(f"Initiative cycle record is invalid: {cycle_id}")
    if not isinstance(record, dict):
        fail(f"Initiative cycle record identity mismatch: {cycle_id}")
    native = native_workspace_execution(record)
    if native:
        required_record.discard("source")
    mappings = ("applicability_plan", "delivery", "engineering_profile", "evidence", "gates",
                "git", "metrics", "worktree") + (("source",) if "source" in record or not native else ())
    if (not isinstance(record, dict) or not required_record.issubset(record)
            or record.get("cycle_id") != cycle_id or type(record.get("schema_version")) is not int
            or record.get("schema_version") not in ((3, 4, 5, 6) if native else (4, 5))
            or record.get("context") != receipt["context"]
            or any(not isinstance(record.get(field), dict) for field in mappings)
            or not isinstance(record.get("commits"), list)
            or any(not isinstance(record.get(field), str) for field in (
                "context", "created_at", "delivery_intent", "method_revision", "risk", "state"))
            or (record.get("schema_version") != 3 and (
                "locator" not in record["worktree"] or "path" in record["worktree"]))
            or not isinstance(record["worktree"].get("branch"), str)):
        fail(f"Initiative cycle record identity mismatch: {cycle_id}")
    if record["schema_version"] == 5:
        validate_schema5_runtime(root, record, historical=True)
    if native:
        verify_native_workspace_backup(root, record)
        if "initiative_approval" in record:
            validate_initiative_approval(record["initiative_approval"])
    worktree = record_worktree(root, record)
    if (not worktree.is_dir() or not record_worktree_matches(root, record, worktree)
            or branch(worktree) != record["worktree"].get("branch")):
        fail(f"Initiative cycle worktree identity mismatch: {cycle_id}")
    if record.get("initiative") is None:
        fail(f"Initiative cycle ID is already occupied by an unbound cycle: {cycle_id}")
    if effective_initiative(record) != receipt:
        fail(f"Initiative cycle ID is already occupied by a different Initiative receipt: {cycle_id}")
    if record.get("state") != "active":
        fail(f"Initiative cycle ID is already occupied by a non-active cycle: {cycle_id}")


def command_initiative_cycle_check(args):
    try:
        receipt = json.loads(args.receipt_json, object_pairs_hook=no_duplicate_keys)
    except (ValueError, json.JSONDecodeError):
        fail("Initiative cycle receipt is invalid")
    required = {"schema_version", "initiative_id", "slice_id", "manifest_digest",
                "manifest_blob", "manifest_commit", "manifest_path", "coordinator_repository",
                "context", "repository", "requirements", "depends_on", "artifacts",
                "release_group", "execution_owner"}
    if (not isinstance(receipt, dict) or not required.issubset(receipt)
            or type(receipt.get("schema_version")) is not int or receipt.get("schema_version") not in (1, 2)
            or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", args.cycle_id)
            or not isinstance(receipt.get("context"), str)):
        fail("Initiative cycle receipt is invalid")
    require_repository_home(root_dir(), receipt["repository"])
    check_initiative_cycle_occupancy(root_dir(), args.cycle_id, receipt)
    print(json.dumps({"available": True}, sort_keys=True, separators=(",", ":")))


def initiative_receipt(source, slice_id, root=None, *, committed=None):
    raw = git(root, "show", f"{committed}:{source}").stdout.encode() if committed is not None else None
    value, statements, contexts, slices, release_groups, digest = read_initiative_manifest(source, raw=raw)
    item = slices.get(slice_id)
    if item is None:
        fail(f"unknown Initiative slice: {slice_id}")
    if item["state"] != "ready":
        fail(f"Initiative slice is not ready: {slice_id}")
    if item.get("execution_owner", "build") != "build":
        fail(f"Initiative slice is owned by Discovery and cannot issue a Build receipt: {slice_id}")
    identity = {}
    artifacts = sorted(set(item["artifacts"]).union(
        *(statements[requirement]["artifacts"] for requirement in item["requirements"])))
    if root is not None:
        try:
            relative = (str(source) if committed is not None else
                        Path(source).resolve().relative_to(root.resolve()).as_posix())
        except ValueError:
            fail("Initiative manifest must be inside the current repository")
        if committed is None and git(root, "status", "--porcelain=v1", "--", relative).stdout.strip():
            fail("Initiative manifest must be committed and clean before receipt")
        revision = committed or "HEAD"
        blob = git(root, "rev-parse", f"{revision}:{relative}", check=False).stdout.strip()
        if not re.fullmatch(r"[0-9a-f]{40,64}", blob):
            fail("Initiative manifest must be committed at HEAD before receipt")
        identity = {
            "manifest_blob": blob,
            "manifest_commit": git(root, "rev-parse", revision).stdout.strip(),
        }
        require_repository_home(root, value["coordinator_repository"],
            "Initiative coordinator repository does not match the source Git repository")
        for artifact in artifacts:
            if ((committed is None and git(root, "status", "--porcelain=v1", "--", artifact).stdout.strip())
                    or git(root, "cat-file", "-e", f"{revision}:{artifact}", check=False).returncode):
                fail(f"Initiative artifact must be committed and clean before receipt: {artifact}")
    receipt = {
        "schema_version": value["schema_version"],
        "initiative_id": value["id"],
        "slice_id": slice_id,
        "manifest_digest": digest,
        "coordinator_repository": value["coordinator_repository"],
        "context": item["context"],
        "repository": contexts[item["context"]]["repository"],
        "requirements": item["requirements"],
        "depends_on": item["depends_on"],
        "artifacts": artifacts,
        "release_group": release_groups.get(slice_id),
        "execution_owner": "build",
        **identity,
    }
    return receipt


def command_initiative_receipt(args):
    print(json.dumps(initiative_receipt(args.manifest, args.slice, root_dir()),
                      sort_keys=True, separators=(",", ":")))


def amendment_bytes(value):
    return (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()


def amendment_hash(data):
    return hashlib.sha256(data).hexdigest()


def amendment_location(root, cycle_id, digest, name):
    if (not isinstance(cycle_id, str) or not OPAQUE_ID.fullmatch(cycle_id)
            or not isinstance(digest, str) or not re.fullmatch(r"[0-9a-f]{64}", digest)
            or name not in {"plan.json", "before.json", "envelope.json", "outcome.json"}):
        fail("invalid Initiative amendment custody")
    return cycle_dir(root) / "evidence" / cycle_id / "initiative-amendments" / digest / name


def amendment_read(root, path):
    managed_directory(root, path.parent)
    continuation_private(path)
    with os.fdopen(os.open(path, os.O_RDONLY | os.O_NOFOLLOW), "rb") as stream:
        before = os.fstat(stream.fileno())
        if (not stat.S_ISREG(before.st_mode) or before.st_uid != os.getuid()
                or before.st_nlink != 1 or before.st_mode & 0o077):
            fail("unsafe Initiative amendment evidence")
        data = stream.read(32 * 1024 * 1024 + 1)
        after = os.fstat(stream.fileno())
    stable = lambda item: (item.st_dev, item.st_ino, item.st_size, item.st_mtime_ns,
                           item.st_ctime_ns, item.st_mode, item.st_uid, item.st_nlink)
    if len(data) > 32 * 1024 * 1024 or stable(before) != stable(after):
        fail("unstable Initiative amendment evidence")
    return data


def amendment_write_once(root, path, data):
    managed_directory(root, path.parent, create=True)
    for directory in (path.parent, path.parent.parent):
        os.chmod(directory, 0o700)
    if os.path.lexists(path):
        if amendment_read(root, path) != data:
            fail("conflicting Initiative amendment evidence")
        return
    descriptor, temporary = tempfile.mkstemp(dir=path.parent)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        os.link(temporary, path)
    finally:
        Path(temporary).unlink(missing_ok=True)
    # Persist the complete newly created directory chain, not just its leaf.
    current = path.parent
    while True:
        fsync_directory(current)
        if current == cycle_dir(root):
            break
        current = current.parent


def amendment_json(root, path):
    return json.loads(amendment_read(root, path), object_pairs_hook=no_duplicate_keys)


def amendment_tree(root, revision, closure):
    for entry in closure:
        name = entry["path"]
        actual = git(root, "ls-tree", "-z", revision, "--", name).stdout
        if actual != f"{entry['mode']} blob {entry['blob']}\t{name}\0":
            return False
        if git(root, "cat-file", "-e", entry["blob"], check=False).returncode:
            return False
    return True


def amendment_closure(root, receipt, plan):
    paths = sorted(set(receipt["artifacts"]) | {receipt["manifest_path"], plan["profile"]})
    closure = []
    for name in paths:
        if (not isinstance(name, str) or not name.startswith("docs/")
                or any(part in {"", ".", ".."} for part in name.split("/"))
                or Path(name).suffix not in {".md", ".json"}):
            fail("unsafe Initiative amendment document")
        raw = git(root, "ls-tree", "-z", receipt["manifest_commit"], "--", name).stdout
        header, separator, tail = raw.partition("\t")
        fields = header.split()
        if (separator != "\t" or tail != name + "\0" or len(fields) != 3
                or fields[0] not in {"100644", "100755"} or fields[1] != "blob"):
            fail("invalid Initiative amendment document tree")
        closure.append({"path": name, "mode": fields[0], "blob": fields[2]})
    return closure


def amendment_clean_documents(root, closure):
    for entry in closure:
        name = entry["path"]
        path = root / name
        if (path.is_symlink() or not path.is_file()
                or ("100755" if path.stat().st_mode & 0o111 else "100644") != entry["mode"]
                or any((root / parent).is_symlink() for parent in Path(name).parents if str(parent) != ".")
                or git(root, "status", "--porcelain=v1", "--", name).stdout
                or git(root, "ls-files", "--stage", "-z", "--", name).stdout
                != f"{entry['mode']} {entry['blob']} 0\t{name}\0"
                or git(root, "hash-object", "--no-filters", "--", name).stdout.strip() != entry["blob"]):
            fail("Initiative amendment selected documents are not clean")


def amendment_checkout(root, selected):
    require_local_read_filters(root)
    if any(entry and not entry.startswith("H ") for entry in git(root, "ls-files", "-v", "-z").stdout.split("\0")):
        fail("unsupported Initiative amendment index flags")
    if git(root, "ls-files", "--unmerged").stdout:
        fail("Initiative amendment index is unresolved")
    dirty = sorted(set(filter(None, (
        git(root, "diff", "--name-only", "-z", "HEAD").stdout
        + git(root, "ls-files", "--others", "--exclude-standard", "-z").stdout).split("\0"))))
    if set(dirty) & set(selected):
        fail("Initiative amendment selected documents are dirty")
    inventory = []
    for name in dirty:
        path = root / name
        if not path.resolve().is_relative_to(root.resolve()) or path.is_symlink():
            fail("unsupported Initiative amendment dirty artifact")
        if not os.path.lexists(path):
            inventory.append({"path": name, "absent": True})
            continue
        info = path.lstat()
        if not stat.S_ISREG(info.st_mode) or info.st_size > 32 * 1024 * 1024:
            fail("unsupported Initiative amendment dirty artifact")
        data = path.read_bytes()
        after = path.lstat()
        if any(getattr(after, key) != getattr(info, key) for key in
               ("st_dev", "st_ino", "st_size", "st_mtime_ns", "st_ctime_ns", "st_mode", "st_uid", "st_nlink")):
            fail("changing Initiative amendment dirty artifact")
        inventory.append({"path": name, "sha256": amendment_hash(data), "mode": stat.S_IMODE(info.st_mode)})
    index = git_dir(root) / "index"
    if index.is_symlink() or not index.is_file():
        fail("unsafe Initiative amendment index")
    return {"identity": continuation_digest([str(common_git_dir(root).resolve()),
             str(git_dir(root).resolve()), str(root.resolve())]), "branch": branch(root),
            "head": git(root, "rev-parse", "HEAD").stdout.strip(), "upstream": upstream(root),
            "index_sha256": amendment_hash(index.read_bytes()),
            "index_entries": git(root, "ls-files", "--stage", "-z").stdout,
            "dirty": inventory}


def amendment_checkout_documents(root, closure):
    for entry in closure:
        name = entry["path"]
        path = root / name
        if any((root / parent).is_symlink() for parent in Path(name).parents if str(parent) != "."):
            fail("unsafe Initiative amendment selected parent")
        tree = git(root, "ls-tree", "-z", "HEAD", "--", name).stdout
        indexed = git(root, "ls-files", "--stage", "-z", "--", name).stdout
        if not tree:
            if indexed or os.path.lexists(path):
                fail("unapproved Initiative amendment selected path")
            continue
        header, _, tail = tree.partition("\t")
        fields = header.split()
        if (len(fields) != 3 or fields[0] not in {"100644", "100755"} or fields[1] != "blob"
                or tail != name + "\0" or indexed != f"{fields[0]} {fields[2]} 0\t{name}\0"
                or path.is_symlink() or not path.is_file()
                or ("100755" if path.stat().st_mode & 0o111 else "100644") != fields[0]
                or git(root, "hash-object", "--no-filters", "--", name).stdout.strip() != fields[2]):
            fail("Initiative amendment selected checkout bytes changed")


def amendment_receipt(root, receipt):
    commit = receipt["manifest_commit"]
    path = receipt["manifest_path"]
    if (not isinstance(commit, str) or not re.fullmatch(r"[0-9a-f]{40}(?:[0-9a-f]{24})?", commit)
            or not isinstance(path, str)
            or not re.fullmatch(r"docs/initiatives/[a-z0-9][a-z0-9-]*/MANIFEST\.json", path)
            or git(root, "rev-parse", "--verify", f"{commit}^{{commit}}").stdout.strip() != commit):
        fail("invalid Initiative amendment committed authority")
    expected = initiative_receipt(path, receipt["slice_id"], root, committed=commit)
    expected["manifest_path"] = path
    if receipt != expected:
        fail("Initiative amendment receipt disagrees with committed manifest")


def amendment_replacement(before, entry):
    replacement = json.loads(json.dumps(before))
    replacement.setdefault("initiative_amendments", []).append(entry)
    for gate in replacement["gates"].values():
        if gate["applicability"] == "required":
            gate["result"] = "pending"
            gate.pop("evidence", None)
            gate.pop("exception", None)
    return replacement


def amendment_progress(before, current):
    for key in ("schema_version", "cycle_id", "context", "created_at", "method_revision",
                "initiative", "initiative_approval", "discovery_import", "git", "worktree", "delivery_intent",
                "execution", "source"):
        if before.get(key) != current.get(key):
            fail("Initiative amendment immutable history changed")
    for key in ("github", "forge", "remote", "upstream", "branch", "base_branch", "base_head", "lock_id"):
        if before.get("delivery", {}).get(key) != current.get("delivery", {}).get(key):
            fail("Initiative amendment delivery history changed")
    for key in ("commits", "initiative_amendments", "initiative_authority_checkpoints"):
        prefix = before.get(key, [])
        if current.get(key, [])[:len(prefix)] != prefix:
            fail("Initiative amendment history prefix changed")
    if RISK_RANK[current["risk"]] < RISK_RANK[before["risk"]]:
        fail("Initiative amendment risk decreased")
    for name, gate in before["gates"].items():
        if gate["applicability"] == "required" and current["gates"][name]["applicability"] != "required":
            fail("Initiative amendment required gate was weakened")
    for identifier, item in before.get("evidence", {}).get("items", {}).items():
        actual = current.get("evidence", {}).get("items", {}).get(identifier)
        if actual == item:
            continue
        if (not isinstance(actual, dict) or "commit" in item
                or {k: v for k, v in actual.items() if k != "commit"} != item
                or not any(c["id"] == actual.get("commit") and item["gate"] in c["gates"]
                           for c in current["commits"])):
            fail("Initiative amendment evidence history changed")


def offline_amendment_read(function):
    @functools.wraps(function)
    def read(root, record, *args, **kwargs):
        if LOCAL_COMPLETION_GIT.get() is not None or not (
                record.get("initiative_amendments") or record.get("initiative_authority_checkpoints")):
            return function(root, record, *args, **kwargs)
        with local_completion_git_context():
            return function(root, record, *args, **kwargs)
    return read


def amendment_checkpoint_evidence(root, record, entry, commit):
    before = amendment_json(root, common_git_dir(root) / entry["preimage_locator"])
    commit_entry = next((c for c in record["commits"] if c["id"] == commit), None)
    if (not commit_entry or not commit_entry["gates"]
            or any(c["id"] == commit for c in before["commits"])):
        return False
    changed = set(filter(None, git(root, "diff", "--name-only", "-z", commit + "^1", commit).stdout.split("\0")))
    fresh = [item for identifier, item in record["evidence"]["items"].items()
             if identifier not in before["evidence"]["items"] and item.get("commit") == commit
             and item.get("gate") in commit_entry["gates"] and item.get("result") in {"passed", "failed", "unavailable"}]
    return bool(fresh) and all(set(item["paths"]) == changed and
        evidence_path_blobs(root, changed, commit=commit) == item["paths"] for item in fresh)


@offline_amendment_read
def validate_initiative_amendments(root, record):
    entries = record.get("initiative_amendments", [])
    checkpoints = record.get("initiative_authority_checkpoints", [])
    if not isinstance(entries, list) or not isinstance(checkpoints, list):
        fail("invalid Initiative amendment chain")
    if not entries:
        if checkpoints or "initiative_amendments" in record or "initiative_authority_checkpoints" in record:
            fail("invalid empty Initiative amendment chain")
        return []
    if record.get("schema_version") not in (3, 4, 5, 6) or not native_workspace_execution(record):
        fail("unsupported Initiative amendment record")
    original = record.get("initiative")
    if not isinstance(original, dict):
        fail("missing original Initiative authority")
    prior = original
    envelopes, digests = [], []
    fields = {"schema_version", "previous_effective_receipt_digest", "receipt", "before_record_sha256",
              "preimage_locator", "launch_digest", "reason", "approval_method", "approved_at", "plan_digest",
              "envelope_sha256", "envelope_locator"}
    for index, entry in enumerate(entries):
        if (not isinstance(entry, dict) or set(entry) != fields or type(entry["schema_version"]) is not int
                or entry["schema_version"] != 1 or entry["launch_digest"] in digests
                or entry["previous_effective_receipt_digest"] != continuation_digest(prior)
                or entry["approval_method"] not in {"interactive_cli", "agent_confirmed"}
                or not isinstance(entry["reason"], str) or not entry["reason"].strip()
                or not isinstance(entry["approved_at"], str)
                or datetime.fromisoformat(entry["approved_at"].replace("Z", "+00:00")).utcoffset() != timedelta(0)):
            fail("invalid Initiative amendment entry")
        digest = entry["launch_digest"]
        paths = {name: amendment_location(root, record["cycle_id"], digest, name)
                 for name in ("before.json", "envelope.json", "outcome.json")}
        if (entry["preimage_locator"] != str(paths["before.json"].relative_to(common_git_dir(root)))
                or entry["envelope_locator"] != str(paths["envelope.json"].relative_to(common_git_dir(root)))):
            fail("invalid Initiative amendment evidence locator")
        before_bytes = amendment_read(root, paths["before.json"])
        envelope_bytes = amendment_read(root, paths["envelope.json"])
        before = json.loads(before_bytes, object_pairs_hook=no_duplicate_keys)
        envelope = json.loads(envelope_bytes, object_pairs_hook=no_duplicate_keys)
        plan = envelope["plan"]
        receipt = entry["receipt"]
        if (amendment_hash(before_bytes) != entry["before_record_sha256"]
                or amendment_hash(envelope_bytes) != entry["envelope_sha256"]
                or set(envelope) != {"schema_version", "plan", "approval_method", "approved_at"}
                or type(envelope["schema_version"]) is not int or envelope["schema_version"] != 1
                or continuation_digest(plan) != digest or plan["receipt"] != receipt
                or plan["before_record_sha256"] != entry["before_record_sha256"]
                or plan["previous_effective_receipt_digest"] != entry["previous_effective_receipt_digest"]
                or plan["reason"] != entry["reason"] or plan["plan_digest"] != entry["plan_digest"]
                or plan["source_commit"] != receipt["manifest_commit"]
                or plan["cycle_id"] != before["cycle_id"]
                or plan["applicability_plan"] != before["applicability_plan"]
                or plan["risk"] != before["risk"] or plan["delivery"] != before["delivery"]
                or envelope["approved_at"] != entry["approved_at"]
                or envelope["approval_method"] != entry["approval_method"]
                or before.get("initiative_amendments", []) != entries[:index]):
            fail("inconsistent Initiative amendment evidence")
        for key in ("initiative_id", "context", "slice_id", "repository", "coordinator_repository", "schema_version"):
            if receipt.get(key) != original.get(key):
                fail("Initiative amendment changed authority identity")
        if receipt.get("execution_owner") != "build" or receipt.get("context") != record.get("context"):
            fail("invalid Initiative amendment receipt")
        if receipt["schema_version"] == 2:
            validate_local_initiative_receipt(receipt)
        amendment_receipt(root, receipt)
        if (plan["closure"] != amendment_closure(root, receipt, before["applicability_plan"])
                or not amendment_tree(root, receipt["manifest_commit"], plan["closure"])):
            fail("Initiative amendment approved document closure changed")
        replacement = amendment_replacement(before, entry)
        expected = amendment_bytes(replacement)
        outcome = amendment_json(root, paths["outcome.json"])
        if outcome != {"schema_version": 1, "envelope_sha256": entry["envelope_sha256"],
                       "replacement": expected.decode(), "replacement_sha256": amendment_hash(expected)}:
            fail("invalid Initiative amendment outcome")
        amendment_progress(replacement, record)
        digests.append(digest)
        envelopes.append(envelope)
        prior = receipt
    # Older native schemas retain their format; amended records still cannot
    # smuggle stale evidence or an undisposed exception through a reader.
    latest_before = amendment_json(root, common_git_dir(root) / entries[-1]["preimage_locator"])
    if set(record["gates"]) != set(GATES):
        fail("invalid amended gate inventory")
    for name, gate in record["gates"].items():
        if (record["applicability_plan"]["gates"][name] !=
                {k: v for k, v in gate.items() if k in {"applicability", "reason"}}
                or name in MANDATORY_GATES and gate["applicability"] != "required"):
            fail("amended gate applicability disagrees with its required plan")
        if gate["applicability"] == "not_applicable":
            if gate["result"] != "not_run":
                fail("invalid amended non-applicable gate")
            continue
        if gate["applicability"] != "required" or gate["result"] not in {"pending", "passed", "failed", "unavailable"}:
            fail("invalid amended required gate")
        if gate["result"] == "pending":
            if "evidence" in gate or "exception" in gate:
                fail("pending amended gate contains stale disposition")
            continue
        identifier = gate.get("evidence")
        item = record["evidence"]["items"].get(identifier)
        if (identifier in latest_before["evidence"]["items"] or not item
                or item.get("gate") != name or item.get("result") != gate["result"]):
            fail("invalid or stale amended gate evidence")
        if "exception" in gate and (gate["result"] not in {"failed", "unavailable"}
                or not valid_gate_exception(gate)
                or datetime.fromisoformat(gate["exception"]["approved_at"].replace("Z", "+00:00"))
                < datetime.fromisoformat(entries[-1]["approved_at"].replace("Z", "+00:00"))):
            fail("invalid amended gate exception")
    order = -1
    for checkpoint in checkpoints:
        if (not isinstance(checkpoint, dict)
                or set(checkpoint) != {"schema_version", "launch_digest", "commit", "closure_sha256"}
                or type(checkpoint["schema_version"]) is not int or checkpoint["schema_version"] != 1
                or checkpoint["launch_digest"] not in digests):
            fail("invalid Initiative authority checkpoint")
        position = digests.index(checkpoint["launch_digest"])
        if position <= order:
            fail("duplicate or unordered Initiative authority checkpoint")
        order = position
        closure = envelopes[position]["plan"]["closure"]
        if (checkpoint["closure_sha256"] != continuation_digest(closure)
                or not amendment_checkpoint_evidence(root, record, entries[position], checkpoint["commit"])
                or not amendment_tree(root, checkpoint["commit"], closure)
                or git(root, "merge-base", "--is-ancestor", record["git"]["head"], checkpoint["commit"], check=False).returncode):
            fail("invalid Initiative authority checkpoint tree")
    return envelopes


def effective_initiative(record):
    return record["initiative_amendments"][-1]["receipt"] if record.get("initiative_amendments") else record.get("initiative")


def amendment_fresh_evidence(root, record, identifier):
    envelopes = validate_initiative_amendments(root, record)
    if envelopes:
        entry = record["initiative_amendments"][-1]
        before = amendment_json(root, common_git_dir(root) / entry["preimage_locator"])
        if identifier in before.get("evidence", {}).get("items", {}):
            fail("gate evidence predates effective Initiative authority")


@offline_amendment_read
def amendment_checkpoint(root, record, commit):
    envelopes = validate_initiative_amendments(root, record)
    if not envelopes:
        return
    digest = record["initiative_amendments"][-1]["launch_digest"]
    closure = envelopes[-1]["plan"]["closure"]
    if (not any(c["launch_digest"] == digest for c in record.get("initiative_authority_checkpoints", []))
            and amendment_tree(root, commit, closure)
            and amendment_checkpoint_evidence(root, record, record["initiative_amendments"][-1], commit)):
        record.setdefault("initiative_authority_checkpoints", []).append({"schema_version": 1,
            "launch_digest": digest, "commit": commit, "closure_sha256": continuation_digest(closure)})


@offline_amendment_read
def require_amendment_completion(root, record):
    envelopes = validate_initiative_amendments(root, record)
    if not envelopes:
        return
    digest = record["initiative_amendments"][-1]["launch_digest"]
    checkpoints = record.get("initiative_authority_checkpoints", [])
    if (not checkpoints or checkpoints[-1]["launch_digest"] != digest
            or git(root, "merge-base", "--is-ancestor", checkpoints[-1]["commit"], "HEAD", check=False).returncode
            or not amendment_tree(root, "HEAD", envelopes[-1]["plan"]["closure"])):
        fail("effective Initiative authority needs its exact Gate Commit closure at HEAD")


def amendment_selection(root, args):
    require_local_read_filters(root)
    path, record = load(root)
    require_active(record)
    if (record.get("cycle_id") != args.cycle_id or record.get("schema_version") not in (3, 4, 5, 6)
            or not native_workspace_execution(record) or not record_worktree_matches(root, record, root)
            or not isinstance(effective_initiative(record), dict)):
        fail("unsupported Initiative amendment selection")
    raw = amendment_read(root, path)
    if json.loads(raw, object_pairs_hook=no_duplicate_keys) != record:
        fail("Initiative amendment record changed")
    if not re.fullmatch(r"docs/initiatives/[a-z0-9][a-z0-9-]*/MANIFEST\.json", args.initiative_manifest):
        fail("unsafe Initiative amendment manifest")
    authority = repo_root(args.initiative_source) if args.initiative_source else root
    if common_git_dir(authority).resolve() != common_git_dir(root).resolve():
        fail("Initiative amendment requires native same-repository authority")
    require_local_read_filters(authority)
    receipt = initiative_receipt(authority / args.initiative_manifest, args.initiative_slice, authority)
    receipt["manifest_path"] = args.initiative_manifest
    original = record["initiative"]
    if receipt["manifest_digest"] != args.initiative_digest:
        fail("Initiative amendment receipt changed")
    for key in ("initiative_id", "context", "slice_id", "repository", "coordinator_repository", "schema_version"):
        if receipt[key] != original[key]:
            fail("Initiative amendment identity changed")
    require_repository_home(root, receipt["repository"])
    if upstream(root) != record["git"]["upstream"]:
        fail("Initiative amendment upstream changed")
    if local_only_cycle(record):
        destination = forgejo_remote_urls(root, record["delivery"]["remote"], receipt["repository"])
    else:
        destination = remote_destination(root, upstream(root))
        remote = destination["name"]
        push_urls = git(root, "remote", "get-url", "--push", "--all", remote).stdout.splitlines()
        if push_urls != [destination["push_url"]]:
            fail("ambiguous Initiative amendment push destination")
    if destination != record["git"]["remote"]:
        fail("Initiative amendment destination changed")
    plan = read_plan(args.plan, args.expected_plan_digest)
    profile, blob, gates, graphify = validate_plan(root, record["context"], record["delivery_intent"], plan)
    normalized = {"profile": profile, "gates": {name: {k: v for k, v in gate.items()
                   if k in ("applicability", "reason")} for name, gate in gates.items()},
                  **({"graphify": graphify} if graphify else {})}
    if (normalized != record["applicability_plan"]
            or record["engineering_profile"] != {"path": profile, "blob": blob}):
        fail("Initiative amendment applicability changed")
    closure = amendment_closure(authority, receipt, plan)
    if next(c["blob"] for c in closure if c["path"] == profile) != blob:
        fail("Initiative amendment source profile changed")
    amendment_clean_documents(authority, closure)
    # Selected checkout documents must match their current HEAD, not new authority.
    if git(root, "status", "--porcelain=v1", "--", *[c["path"] for c in closure]).stdout:
        fail("Initiative amendment selected documents are dirty")
    amendment_checkout_documents(root, closure)
    reason = args.reason
    if not isinstance(reason, str) or not reason.strip() or len(reason.encode()) > 4096 or "\0" in reason:
        fail("invalid Initiative amendment reason")
    launch = {"schema_version": 1, "cycle_id": args.cycle_id, "receipt": receipt,
              "previous_effective_receipt_digest": continuation_digest(effective_initiative(record)),
              "before_record_sha256": amendment_hash(raw), "plan_digest": args.expected_plan_digest,
              "applicability_plan": normalized, "risk": record["risk"], "delivery": record["delivery"],
              "reason": reason, "source_commit": receipt["manifest_commit"], "closure": closure,
              "destination": destination,
              "checkout": amendment_checkout(root, [c["path"] for c in closure])}
    return path, record, raw, launch


def amendment_custody(root, cycle_id):
    directory = amendment_location(root, cycle_id, "0" * 64, "plan.json").parent.parent
    if not os.path.lexists(directory):
        return []
    managed_directory(root, directory)
    prepared = []
    for child in sorted(directory.iterdir()):
        if child.is_symlink() or not child.is_dir() or not re.fullmatch(r"[0-9a-f]{64}", child.name):
            fail("unsafe Initiative amendment custody")
        managed_directory(root, child)
        leaves = list(child.iterdir())
        for item in leaves:
            if item.name not in {"plan.json", "before.json", "envelope.json", "outcome.json"}:
                fail("unknown retained Initiative amendment evidence")
            amendment_read(root, item)
        if any(item.name != "plan.json" for item in leaves):
            prepared.append(child.name)
    return prepared


def initiative_amend_offline(args):
    root = root_dir()
    digest = None
    durable = False
    try:
        with evidence_lock(root, "local-mutation-" + args.cycle_id, timeout=1), evidence_lock(root, args.cycle_id, timeout=1):
            if active_pointer_id(root, resolved_active_path(root, bindings=False)) != args.cycle_id:
                fail("Initiative amendment pointer changed")
            custody_root = amendment_location(root, args.cycle_id, "0" * 64, "plan.json").parent.parent
            durable = os.path.lexists(custody_root)
            custody = amendment_custody(root, args.cycle_id)
            durable = bool(custody)
            if args.expected_launch_digest in custody:
                durable, digest = True, args.expected_launch_digest
            admitted = read_cycle_record(root, cycle_dir(root) / "cycles" / f"{args.cycle_id}.json")
            applied = {e["launch_digest"] for e in admitted.get("initiative_amendments", [])}
            outstanding = set(custody) - applied
            durable = bool(outstanding)
            path, record, raw, launch = amendment_selection(root, args)
            current_digest = continuation_digest(launch)
            if outstanding and outstanding != {current_digest}:
                durable = True
                fail("unreconciled prepared Initiative amendment")
            if outstanding:
                durable, digest = True, current_digest
            digest = continuation_digest(launch)
            expected = args.expected_launch_digest
            # An exact applied replay must use its retained original plan, not a new
            # digest computed from the already amended record.
            previous = next((e for e in record.get("initiative_amendments", []) if e["launch_digest"] == expected), None)
            if not args.preflight and previous:
                envelope = amendment_json(root, common_git_dir(root) / previous["envelope_locator"])
                original = envelope["plan"]
                outcome = amendment_json(root, amendment_location(root, args.cycle_id, expected, "outcome.json"))
                unchanged = {k: v for k, v in launch.items() if k not in {"before_record_sha256", "previous_effective_receipt_digest"}}
                bound = {k: v for k, v in original.items() if k not in {"before_record_sha256", "previous_effective_receipt_digest"}}
                digest = expected
                if unchanged != bound or raw != outcome["replacement"].encode():
                    durable = False  # Verified history plus normal progress: stale replay, not uncertain custody.
                    fail("stale Initiative amendment replay")
                return "already_applied", digest
            if launch["receipt"] == effective_initiative(record):
                fail("Initiative authority is unchanged")
            plan_path = amendment_location(root, args.cycle_id, digest, "plan.json")
            if args.preflight:
                amendment_write_once(root, plan_path, amendment_bytes(launch))
                return "preflight", digest
            if expected != digest or amendment_json(root, plan_path) != launch:
                fail("Initiative amendment approval is stale")
            if args.approval == "interactive":
                if not sys.stdin.isatty():
                    fail("Initiative amendment requires operator confirmation")
                print(f"Type AMEND {args.cycle_id} {digest}: ", file=sys.stderr, end="", flush=True)
                if sys.stdin.readline(512).strip() != f"AMEND {args.cycle_id} {digest}":
                    fail("Initiative amendment confirmation declined")
            method = "agent_confirmed" if args.approval == "agent-confirmed" else "interactive_cli"
            if amendment_selection(root, args)[3] != launch:
                fail("Initiative amendment state changed during approval")
            envelope_path = amendment_location(root, args.cycle_id, digest, "envelope.json")
            before_path = amendment_location(root, args.cycle_id, digest, "before.json")
            outcome_path = amendment_location(root, args.cycle_id, digest, "outcome.json")
            if os.path.lexists(envelope_path):
                durable = True
                envelope = amendment_json(root, envelope_path)
                if envelope["plan"] != launch or envelope["approval_method"] != method:
                    fail("conflicting prepared Initiative amendment")
            else:
                envelope = {"schema_version": 1, "plan": launch, "approval_method": method, "approved_at": now()}
                durable = True
                amendment_write_once(root, envelope_path, amendment_bytes(envelope))
            amendment_write_once(root, before_path, raw)
            entry = {"schema_version": 1, "previous_effective_receipt_digest": launch["previous_effective_receipt_digest"],
                     "receipt": launch["receipt"], "before_record_sha256": amendment_hash(raw),
                     "preimage_locator": str(before_path.relative_to(common_git_dir(root))),
                     "launch_digest": digest, "reason": args.reason, "approval_method": method,
                     "approved_at": envelope["approved_at"], "plan_digest": args.expected_plan_digest,
                     "envelope_sha256": amendment_hash(amendment_bytes(envelope)),
                     "envelope_locator": str(envelope_path.relative_to(common_git_dir(root)))}
            replacement = amendment_replacement(record, entry)
            replacement_bytes = amendment_bytes(replacement)
            outcome = {"schema_version": 1, "envelope_sha256": entry["envelope_sha256"],
                       "replacement": replacement_bytes.decode(), "replacement_sha256": amendment_hash(replacement_bytes)}
            amendment_write_once(root, outcome_path, amendment_bytes(outcome))
            validate_initiative_amendments(root, replacement)
            if local_only_cycle(replacement):
                validate_schema6_record(root, replacement)
            if amendment_selection(root, args)[3] != launch:
                fail("Initiative amendment state changed before replacement")
            private_json(path, replacement, strict=True)
            return "applied", digest
    except (RuntimeError, OSError, ValueError, TypeError, KeyError, AttributeError):
        # Detailed inputs, private reasons and host errors never cross this result.
        status = "recovery_required" if durable else "blocked"
        return status, digest


def command_initiative_amend(args):
    with local_completion_git_context():
        status, digest = initiative_amend_offline(args)
    print(json.dumps({"schema_version": 1, "cycle_id": args.cycle_id if OPAQUE_ID.fullmatch(args.cycle_id) else None, "status": status,
                      "state_digest": digest, "reasons": [] if status in {"preflight", "applied", "already_applied"}
                      else ["amendment_recovery_required" if status == "recovery_required" else "amendment_blocked"],
                      "next_action": "continue" if status in {"applied", "already_applied"} else
                      "approve_exact_plan" if status == "preflight" else "retain_and_reconcile"}, sort_keys=True))
    if status in {"blocked", "recovery_required"}:
        raise SystemExit(75 if status == "recovery_required" else 1)


def managed_graphify_adapter():
    directory = Path(__file__).resolve().parent
    for name in ("dbsctr-project-graphify", "executable_dbsctr-project-graphify"):
        path = directory / name
        try:
            descriptor = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
        except FileNotFoundError:
            continue
        try:
            details = os.fstat(descriptor)
            content = os.read(descriptor, details.st_size + 1)
        finally:
            os.close(descriptor)
        if (stat.S_IFMT(details.st_mode) != stat.S_IFREG or details.st_uid != os.getuid()
                or not details.st_mode & stat.S_IXUSR or len(content) != details.st_size):
            fail("managed Graphify adapter is unsafe")
        return path, hashlib.sha256(content).hexdigest()
    fail("managed Graphify adapter is missing")


def archived_graphify_adapter(root, digest, source=None):
    directory = cycle_dir(root) / "graphify" / "adapters"
    managed_directory(root, directory, create=True)
    path = directory / digest
    if source is not None and not path.exists():
        descriptor = os.open(source, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
        try:
            content = os.fdopen(descriptor, "rb").read()
        finally:
            with contextlib.suppress(OSError):
                os.close(descriptor)
        if hashlib.sha256(content).hexdigest() != digest:
            fail("managed Graphify adapter identity changed")
        try:
            descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o700)
        except FileExistsError:
            pass
        else:
            with os.fdopen(descriptor, "wb") as handle:
                handle.write(content)
                handle.flush()
                os.fsync(handle.fileno())
    try:
        details = path.lstat()
        content = path.read_bytes()
    except OSError:
        fail("managed Graphify adapter snapshot is missing")
    if (path.is_symlink() or stat.S_IFMT(details.st_mode) != stat.S_IFREG
            or details.st_uid != os.getuid() or details.st_mode & 0o077
            or not details.st_mode & stat.S_IXUSR
            or hashlib.sha256(content).hexdigest() != digest):
        fail("managed Graphify adapter snapshot is unsafe")
    return path


def validate_graphify_selection(root, value, commit="HEAD", require_clean=False):
    del commit, require_clean
    if not isinstance(value, dict) or set(value) not in (
            {"version"}, {"version", "adapter_contract", "adapter_sha256"}):
        fail("graphify selection requires exactly version")
    version = value["version"]
    if not isinstance(version, str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._+-]{0,63}", version):
        fail("Graphify version is invalid")
    if len(value) == 1:
        adapter, digest = managed_graphify_adapter()
        archived_graphify_adapter(root, digest, adapter)
        normalized = {
            "version": version,
            "adapter_contract": "dbsctr-project-graphify-v1",
            "adapter_sha256": digest,
        }
    else:
        normalized = value
        if (value.get("adapter_contract") != "dbsctr-project-graphify-v1"
                or not re.fullmatch(r"[0-9a-f]{64}", value.get("adapter_sha256", ""))):
            fail("managed Graphify adapter identity is invalid")
        archived_graphify_adapter(root, value["adapter_sha256"])
    return normalized


def validate_plan(root, context, intent, plan, recorded_profile=None):
    if not set(plan) <= {"profile", "gates", "graphify"}:
        fail("applicability plan allows only profile, gates, and optional graphify")
    profile = f"docs/specs/{context}/PROFILE.md"
    profile_blob = git(root, "rev-parse", f"HEAD:{profile}", check=False).stdout.strip()
    expected_profile = recorded_profile or (profile if re.fullmatch(r"[0-9a-f]+", profile_blob)
                                              else f"docs/specs/{context}/README.md")
    if plan.get("profile") != expected_profile:
        fail(f"Engineering Profile must be {expected_profile}")
    if status := git(root, "status", "--porcelain=v1", "--", expected_profile).stdout.strip():
        fail(f"Engineering Profile must be tracked and committed: {status}")
    blob = git(root, "rev-parse", f"HEAD:{expected_profile}", check=False).stdout.strip()
    if not re.fullmatch(r"[0-9a-f]+", blob) or git(
        root, "cat-file", "-e", f"{blob}^{{blob}}", check=False
    ).returncode:
        fail("Engineering Profile is not committed at HEAD")
    gates = plan.get("gates")
    if not isinstance(gates, dict) or set(gates) != set(GATES):
        fail("applicability plan must define every gate exactly once")
    normalized = {}
    for name in GATES:
        item = gates[name]
        if not isinstance(item, dict) or item.get("applicability") not in ("required", "not_applicable"):
            fail(f"invalid applicability for gate: {name}")
        applicability = item["applicability"]
        expected_keys = {"applicability", "reason"} if applicability == "not_applicable" else {"applicability"}
        if set(item) != expected_keys:
            fail(f"invalid applicability fields for gate: {name}")
        if name in MANDATORY_GATES and applicability != "required":
            fail(f"gate is always required: {name}")
        normalized[name] = {"applicability": applicability}
        if applicability == "not_applicable":
            reason = item.get("reason")
            if not isinstance(reason, str) or not reason.strip():
                fail(f"not_applicable gate needs a reason: {name}")
            normalized[name].update({"result": "not_run", "reason": reason.strip()})
        else:
            normalized[name]["result"] = "pending"
    if intent == "release" and normalized["release"]["applicability"] != "required":
        fail("release delivery requires the release gate")
    if intent == "deploy" and normalized["deploy"]["applicability"] != "required":
        fail("deploy delivery requires the deploy gate")
    graphify = None
    if "graphify" in plan:
        graphify = validate_graphify_selection(root, plan["graphify"], require_clean=True)
    return expected_profile, blob, normalized, graphify


def disposed(gate):
    return (gate["applicability"] == "not_applicable" or gate["result"] == "passed"
            or gate["result"] in ("failed", "unavailable") and "exception" in gate)


def invalidate_later(record, gate_name):
    for name in GATES[GATES.index(gate_name) + 1:]:
        gate = record["gates"][name]
        if gate["applicability"] == "required" and gate["result"] == "passed":
            gate["result"] = "pending"
            gate.pop("evidence", None)
            gate.pop("exception", None)
            record.setdefault("metrics", {}).setdefault("gate_reopen_count", 0)
            record["metrics"]["gate_reopen_count"] += 1


def apply_gate_result(record: dict, gate_name: str, result: str, evidence: str | None = None) -> None:
    """Apply an admitted result without executing evidence or persisting state."""
    gate = record["gates"][gate_name]
    previous_result = gate["result"]
    was_disposed = disposed(gate)
    metrics = record.setdefault("metrics", {"gate_failure_count": 0, "gate_reopen_count": 0,
                                              "remediation_round_count": 0})
    gate.pop("exception", None)
    gate["result"] = result
    if evidence is not None:
        gate["evidence"] = evidence
    elif result == "pending":
        gate.pop("evidence", None)
    if is_v32(record) and was_disposed and not disposed(gate):
        invalidate_later(record, gate_name)
    if result in ("failed", "unavailable") and previous_result not in ("failed", "unavailable"):
        metrics["gate_failure_count"] += 1
    if previous_result in ("failed", "unavailable") and result == "passed":
        metrics["remediation_round_count"] += 1


def require_current_profile(root, record):
    if not is_v32(record):
        return
    profile = record["engineering_profile"]
    current = git(root, "rev-parse", f"HEAD:{profile['path']}", check=False).stdout.strip()
    if current != profile["blob"]:
        fail("Engineering Profile changed; update the applicability plan")


def apply_stricter_plan(root, record, plan):
    profile_path, profile_blob, gates, graphify = validate_plan(
        root, record["context"], record["delivery_intent"], plan,
        record["engineering_profile"]["path"],
    )
    if profile_path != record["engineering_profile"]["path"]:
        fail("Engineering Profile path changed; start a new cycle")
    previous_graphify = record["applicability_plan"].get("graphify")
    if previous_graphify and graphify is None:
        fail("Graphify selection cannot be removed")
    if previous_graphify and graphify != previous_graphify:
        fail("Graphify selection cannot change")
    if previous_graphify is None and graphify is not None and profile_blob == record["engineering_profile"]["blob"]:
        fail("Graphify selection requires a committed Engineering Profile change")
    for name, new_gate in gates.items():
        if (record["gates"][name]["applicability"] == "required"
                and new_gate["applicability"] != "required"):
            fail(f"applicability plan cannot loosen gate: {name}")
    for name, new_gate in gates.items():
        old_gate = record["gates"][name]
        if old_gate["applicability"] == "not_applicable" and new_gate["applicability"] == "required":
            old_gate.update({"applicability": "required", "result": "pending"})
            old_gate.pop("reason", None)
            old_gate.pop("exception", None)
            invalidate_later(record, name)
    if profile_blob != record["engineering_profile"]["blob"]:
        record.setdefault("profile_history", []).append({
            "blob": record["engineering_profile"]["blob"], "replaced_at": now(),
        })
        record["engineering_profile"]["blob"] = profile_blob
    record["applicability_plan"] = {"profile": profile_path, "gates": {
        name: {key: value for key, value in gate.items() if key in ("applicability", "reason")}
        for name, gate in gates.items()
    }, **({"graphify": graphify} if graphify else {})}


def artifact_check(record):
    reviews = record["artifact_reviews"]
    incomplete = [name for name in ARTIFACTS if reviews[name]["result"] == "pending"]
    if incomplete:
        fail("artifact reviews pending: " + ", ".join(incomplete))
    if not reviews["BACKLOG"]["reviewed_at"]:
        fail("BACKLOG review is incomplete")
    readme = reviews["README"]
    if readme["result"] == "unchanged" and not readme["reason"]:
        fail("README unchanged review requires a reason")
    if record["state"] in ("finalizing", "completed") and reviews["CHANGELOG"]["result"] == "pending":
        fail("CHANGELOG review is required when finalizing")


def completion_artifact_check(record):
    artifact_check(record)
    if record["artifact_reviews"]["CHANGELOG"]["result"] != "changed":
        fail("CHANGELOG must record the completed cycle before Final Push")
    changelog_path = record["artifact_reviews"]["CHANGELOG"].get("path")
    if not changelog_path:
        fail("changed CHANGELOG review needs its repository path")


def require_native_checkout(root, args, *, clean=True):
    if root.resolve() == primary_worktree(root).resolve():
        fail("select a linked worktree with Worktrunk and open its native session before registration")
    if root.resolve() not in {Path(item["worktree"]).resolve() for item in git_worktrees(root)}:
        fail("registration requires a registered Git checkout")
    if branch(root) in {None, "main", "master", args.base_branch}:
        fail("registration requires a task branch, not a protected branch")
    if any(getattr(args, key, None) is not None for key in (
            "opencode_session_id", "opencode_message_id", "opencode_worktree", "opencode_directory",
            "harness_activation_json")):
        fail("native CLI attribution is unavailable; caller-supplied runtime identity is not accepted")
    if os.environ.get("DBSCTR_IMPROVEMENT_WORKER_ID"):
        fail("native worker launch identity is unavailable; independent authorization must be qualified")
    if clean and status_paths(root):
        fail("cycle must start with a clean worktree")
    if clean and ((root / ".dvc").exists() or (root / "dvc.yaml").exists()):
        helper = Path(__file__).resolve().with_name(
            "executable_worktree-dvc-setup" if Path(__file__).name.startswith("executable_") else "worktree-dvc-setup")
        result = subprocess.run([sys.executable, str(helper), "--check"], cwd=root, env=INSPECT_ENV,
                                capture_output=True, text=True, timeout=90)
        if result.returncode:
            category = result.stderr.strip().removeprefix("worktree-dvc-setup: ")
            if category in {"managed_dvc_runtime_unavailable", "managed_dvc_runtime_unqualified",
                            "managed_dvc_backend_unavailable", "dvc_command_unavailable", "dvc_command_failed"}:
                fail("DVC registration: " + category)
            fail("DVC registration requires an explicit external reflink-only cache; run worktree-dvc-setup --cache PATH")


def require_registration_available(root, cycle_id):
    directory = cycle_dir(root)
    active = active_path(root)
    if active.exists() or legacy_active_path(root).exists() or (legacy_cycle_dir(root) / "active").exists():
        fail("an active DBSCTR cycle already exists")
    record_path = directory / "cycles" / f"{cycle_id}.json"
    if record_path.exists():
        fail(f"cycle record already exists: {cycle_id}")
    for index, candidate in enumerate((directory / "cycles").glob("*.json")):
        if index >= 10000:
            fail("active cycle inventory exceeds its bound")
        existing = read_cycle_record(root, candidate, historical=True)
        if existing.get("state") not in {"active", "finalizing"}:
            continue
        if native_workspace_execution(existing):
            same_checkout = native_git_directory(root, existing) == git_dir(root).resolve()
        else:
            same_checkout = record_worktree(root, existing, bindings=False).resolve() == root.resolve()
        if same_checkout:
            fail("an active cycle already owns this checkout; inspect it before registration")
    return record_path


@contextlib.contextmanager
def registration_lock(root, args):
    require_native_checkout(root, args, clean=False)
    if not isinstance(args.cycle_id, str) or not OPAQUE_ID.fullmatch(args.cycle_id):
        fail("cycle ID must be a bounded simple filename")
    checkout = "registration-" + hashlib.sha256(os.fsencode(str(git_dir(root).resolve()))).hexdigest()
    # Short registration transaction locks, not runtime writer leases or tool admission.
    with contextlib.ExitStack() as stack:
        for key in sorted({checkout, args.cycle_id}):
            stack.enter_context(evidence_lock(root, key, timeout=2))
        yield


def start_cycle(root, args, plan, git_env=None, discovery_import=None, initiative=None, initiative_approval=None):
    require_native_checkout(root, args)
    forge = forgejo_selection(args)
    if forge is not None:
        if (initiative is None or initiative.get("schema_version") != 2 or initiative_approval is None
                or initiative.get("repository") != {key: forge[key] for key in ("provider", "origin", "repository")}):
            fail("Forgejo requires approved typed Initiative begin")
    else:
        require_legacy_start_network(root)
    if initiative is not None:
        if initiative_approval is None:
            fail("Initiative registration requires interactive confirmation")
        validate_initiative_approval(initiative_approval)
    if not OPAQUE_ID.fullmatch(args.cycle_id):
        fail("cycle ID must be a bounded simple filename")
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_-]*", args.context):
        fail("context must be a simple bounded-context name")
    record_path = require_registration_available(root, args.cycle_id)
    dirty_paths = status_paths(root)
    if dirty_paths:
        fail("cycle must start with a clean worktree: " + ", ".join(dirty_paths))
    profile_path, profile_blob, gates, graphify = validate_plan(
        root, args.context, args.delivery_intent, plan
    )
    current_branch = branch(root)
    current_upstream = upstream(root)
    delivery_remote, delivery_branch = configured_upstream(root)
    pre_cycle_ahead = ahead(root, current_upstream)
    if discovery_import is not None:
        verify_discovery_import(root, {"discovery_import": discovery_import})
        if pre_cycle_ahead != [discovery_import["commit"]]:
            fail("Discovery import is not the exact initial cycle commit")
        pre_cycle_ahead = []
    elif pre_cycle_ahead and args.delivery_intent != "draft_pr":
        fail("unknown commits are ahead of upstream; reconcile them before registration")
    protected_base_branch = args.base_branch
    if git(root, "check-ref-format", "--branch", protected_base_branch, check=False).returncode:
        fail("invalid protected base branch")
    if forge is not None:
        if not current_upstream or not delivery_remote or delivery_branch != protected_base_branch:
            fail("Forgejo registration requires its explicit comparison-base upstream")
        base_head = git(root, "rev-parse", current_upstream).stdout.strip()
        approved_base = discovery_import["base_head"] if discovery_import else git(root, "rev-parse", "HEAD").stdout.strip()
        if base_head != approved_base:
            fail("Forgejo comparison base changed during registration")
        delivery = {"mode": "local_only", "forge": forge, "upstream": current_upstream,
                    "remote": delivery_remote, "branch": current_branch,
                    "base_branch": protected_base_branch, "base_head": base_head, "lock_id": None}
    elif args.delivery_intent == "draft_pr":
        account = getattr(args, "github_account", None)
        repository = getattr(args, "github_repository", None)
        if (not account or not OPAQUE_ID.fullmatch(account) or not repository
                or not re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", repository)):
            fail("draft_pr delivery requires a valid GitHub account and repository")
        if not current_branch or current_branch == protected_base_branch:
            fail("draft_pr delivery requires a feature branch distinct from its base")
        if not delivery_remote:
            fail("draft_pr delivery requires a configured remote")
        if git_env is None:
            delivery_url = delivery_remote
            git(root, "fetch", delivery_remote, protected_base_branch)
        else:
            delivery_url = github_remote_url(root, delivery_remote, repository)
            fetch_github_branch(root, delivery_remote, delivery_url, protected_base_branch, git_env)
        base_head = git(root, "rev-parse", f"refs/remotes/{delivery_remote}/{protected_base_branch}").stdout.strip()
        if discovery_import is not None and base_head != discovery_import["base_head"]:
            fail("protected base advanced during Discovery import; prepare a fresh launch")
        if git_env is None:
            published_head = git(
                root, "ls-remote", "--heads", delivery_remote, f"refs/heads/{current_branch}"
            ).stdout.split()
        else:
            published_head = github_remote_head(
                root, delivery_url, f"refs/heads/{current_branch}", git_env
            )
        if pre_cycle_ahead and (not published_head or published_head[0] != git(root, "rev-parse", "HEAD").stdout.strip()):
            fail("pre-cycle commits are not published on the feature branch")
        delivery = {
            "upstream": current_upstream, "remote": delivery_remote,
            "branch": current_branch, "base_branch": protected_base_branch, "base_head": base_head,
            **({"published_feature_head": published_head[0]} if published_head else {}),
            "github": {"host": "github.com", "account": account, "repository": repository},
            "lock_id": delivery_lock_id(
                (remote_destination(root, current_upstream).get("push_url")
                 if git_env is None else delivery_url),
                remote_branch=current_branch,
            ),
        }
    else:
        if delivery_branch == protected_base_branch:
            fail("direct delivery to the protected base branch requires draft_pr")
        delivery = {"upstream": current_upstream, "remote": delivery_remote,
                    "branch": delivery_branch, "protected_base_branch": protected_base_branch,
                    "lock_id": delivery_lock_id(
            remote_destination(root, current_upstream).get("push_url"), remote_branch=delivery_branch
        )}
    schema_version = 6 if forge is not None else 5
    worktree_details = {"id": worktree_id(root), "locator": {"root": "cycle_worktree", "path": "."},
                        "git_dir": git_dir(root).resolve().relative_to(common_git_dir(root).resolve()).as_posix(),
                        "branch": current_branch,
                        "base_commit": git(root, "rev-parse", "HEAD").stdout.strip(),
                        "created_by_dbsctr": False}
    record = {
        "method_revision": CURRENT_METHOD_REVISION, "schema_version": schema_version,
        "created_at": now(), "cycle_id": args.cycle_id,
        "context": args.context, "risk": args.risk, "delivery_intent": args.delivery_intent,
        "engineering_profile": {"path": profile_path, "blob": profile_blob},
        "applicability_plan": {"profile": profile_path, "gates": {
            name: {key: value for key, value in gate.items() if key in ("applicability", "reason")}
            for name, gate in gates.items()
        }, **({"graphify": graphify} if graphify else {})},
        "git": {"head": git(root, "rev-parse", "HEAD").stdout.strip(), "branch": current_branch,
                "upstream": current_upstream, "dirty_paths": dirty_paths,
                "pre_cycle_ahead_commits": pre_cycle_ahead,
                 "remote": remote_destination(root, current_upstream)},
        "worktree": worktree_details,
        "delivery": delivery,
        "state": "active", "commits": [], "gates": gates, "evidence": {"version": 1, "items": {}},
        "metrics": {"gate_failure_count": 0, "gate_reopen_count": 0, "remediation_round_count": 0},
        "artifact_reviews": {name: {"result": "pending", "reason": None, "reviewed_at": None}
                             for name in ARTIFACTS},
        "runtime": {"adapters": {}},
        **({"pr_review_policy": pr_review_birth_policy(root)} if initiative is not None
           and initiative.get("initiative_id") == "dbsctr-workflow-convergence" else {}),
        "preservation_policy": birth_policy_snapshot(root, preservation_policy_snapshot),
        "execution": {"schema_version": 1, "mode": "native_workspace", "origin": "registered",
                      "attribution": {"status": "unavailable", "reason": "native_identity_not_collected"},
                      "adoption": None},
        **({"initiative": initiative} if initiative is not None else {}),
        **({"initiative_approval": initiative_approval} if initiative is not None else {}),
    }
    if discovery_import is not None:
        record["discovery_import"] = discovery_import
        record["git"]["head"] = discovery_import["base_head"]
        record["worktree"]["base_commit"] = discovery_import["base_head"]
        record["commits"] = [{"id": discovery_import["commit"], "gates": []}]
    if forge is not None:
        record["git"]["remote"] = forgejo_remote_urls(root, delivery_remote, initiative["repository"])
        record["delivery"]["lock_id"] = local_delivery_lock_id(root, record)
        validate_schema6_record(root, record)
    active = cycle_dir(root) / "worktrees" / record["worktree"]["id"] / "active"
    exclusive_json(record_path, record)
    try:
        write_active_pointer(root, active, args.cycle_id)
    except Exception:
        record_path.unlink(missing_ok=True)
        raise
    return record


def command_start(args):
    root = root_dir()
    require_legacy_start_network(root)
    plan = read_plan(args.plan)
    with registration_lock(root, args):
        record = start_cycle(root, args, plan)
    print(record["cycle_id"])


def require_legacy_start_network(root):
    """Keep legacy local fixtures; untyped network providers cannot bypass begin."""
    remote, _ = configured_upstream(root)
    for name in sorted({"origin", remote} - {None}):
        for push in (False, True):
            arguments = ["remote", "get-url", "--all", *(["--push"] if push else []), name]
            for url in git(root, *arguments, check=False).stdout.splitlines():
                if (url.startswith(("/", "./", "../", "file://"))
                        or ":" not in url and not url.startswith("-")):
                    continue
                github_repository_from_url(url, "non-GitHub network registration requires typed Initiative begin")


def initiative_import_plan(source, authority, receipt, plan, target, args):
    base = git(source, "rev-parse", target).stdout.strip()
    result = {"base_head": base, "source_commit": receipt["manifest_commit"],
              "receipt": receipt, "plan_digest": args.expected_plan_digest,
              "repository": expected_repository(args, receipt["schema_version"]), "base_branch": args.base_branch,
              "cycle_id": args.cycle_id, "context": args.context, "risk": args.risk,
              "delivery_intent": args.delivery_intent, "artifacts": []}
    if common_git_dir(source).resolve() != common_git_dir(authority).resolve():
        return result
    commit = receipt["manifest_commit"]
    ancestor = git(source, "merge-base", base, commit).stdout.strip()
    allowed = set(receipt["artifacts"]) | {receipt["manifest_path"], plan["profile"]}
    try:
        plan_relative = Path(args.plan).resolve().relative_to(authority.resolve()).as_posix()
        if not git(authority, "cat-file", "-e", f"{commit}:{plan_relative}", check=False).returncode:
            allowed.add(plan_relative)
    except ValueError:
        pass
    changed = set(filter(None, git(source, "diff", "--name-only", "-z", ancestor, commit).stdout.split("\0")))
    namespaces = (str(Path(receipt["manifest_path"]).parent) + "/", f"docs/specs/{args.context}/")
    allowed.update(name for name in changed if name.startswith(namespaces)
                   and Path(name).suffix in {".md", ".json"})
    if not changed <= allowed:
        fail("Discovery contains changes outside receipt artifacts; isolate or declare them before launch")
    for name in sorted(allowed):
        before = git(source, "ls-tree", ancestor, "--", name).stdout
        current = git(source, "ls-tree", base, "--", name).stdout
        desired = git(authority, "ls-tree", commit, "--", name).stdout
        if current == desired:
            continue
        if not name.startswith("docs/") or any(part in {"", ".", ".."} for part in name.split("/")):
            fail("Discovery import is limited to declared documentation artifacts")
        if current != before:
            fail("Discovery artifact conflicts with the protected base; reconcile authority before approval")
        fields = desired.split()
        if len(fields) != 4 or fields[0] != "100644" or fields[1] != "blob" or fields[3] != name:
            fail("Discovery import requires regular, non-deleted documentation files")
        for parent in Path(name).parents:
            if str(parent) == ".":
                continue
            entry = git(source, "ls-tree", base, "--", parent.as_posix()).stdout
            if entry and not entry.startswith("040000 tree "):
                fail("Discovery import parent is not a Git directory")
        result["artifacts"].append({"path": name, "blob": fields[2], "mode": fields[0]})
    return result


def verify_discovery_import(root, record):
    item = record.get("discovery_import")
    if item is None:
        return
    commit, base = item["commit"], item["base_head"]
    if git(root, "rev-list", "--parents", "-n", "1", commit).stdout.split() != [commit, base]:
        fail("Discovery import parent changed")
    actual = set(filter(None, git(root, "diff", "--name-only", "-z", base, commit).stdout.split("\0")))
    if actual != {entry["path"] for entry in item["artifacts"]}:
        fail("Discovery import path set changed")
    for entry in item["artifacts"]:
        for revision in (commit, item["source_commit"]):
            tree = git(root, "ls-tree", revision, "--", entry["path"]).stdout.split()
            if tree != [entry["mode"], "blob", entry["blob"], entry["path"]]:
                fail("Discovery import blob identity changed")


def initiative_launch_plan(source, authority, receipt, plan, target, args):
    result = initiative_import_plan(source, authority, receipt, plan, target, args)
    result["checkout"] = {
        "identity_digest": continuation_digest([str(common_git_dir(source).resolve()),
                                                str(git_dir(source).resolve()), str(source.resolve())]),
        "branch": branch(source), "head": git(source, "rev-parse", "HEAD").stdout.strip(),
    }
    remote, _ = remote_for_upstream(source, target)
    result["delivery_digest"] = continuation_digest({
        "upstream": target, "destination": remote_destination(source, target),
        "fetch_url": git(source, "remote", "get-url", remote).stdout.strip(),
        "account": args.github_account, "repository": args.github_repository,
    })
    if receipt["schema_version"] == 2:
        forge = forgejo_selection(args)
        result["delivery_digest"] = continuation_digest({
            "upstream": target, "forge": forge,
            "destinations": forgejo_remote_urls(source, remote, {
                key: forge[key] for key in ("provider", "origin", "repository")}),
        })
    return result


def command_begin(args):
    if args.preflight:
        return begin_registration(args)
    with registration_lock(root_dir(), args):
        return begin_registration(args)


def begin_registration(args):
    source = root_dir()
    forge = forgejo_selection(args)
    require_native_checkout(source, args, clean=not args.resume_existing)
    if args.worktree_root is not None:
        fail("worktree allocation belongs to Worktrunk; select the checkout before registration")
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", args.cycle_id):
        fail("cycle ID must be a simple filename")
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_-]*", args.context):
        fail("context must be a simple bounded-context name")
    initiative_values = (args.initiative_manifest, args.initiative_slice, args.initiative_digest)
    if getattr(args, "approval", "interactive") == "agent-confirmed" and not all(initiative_values):
        fail("agent-confirmed approval requires Initiative registration")
    if any(value is not None for value in initiative_values) and not all(
            value is not None for value in initiative_values):
        fail("Initiative begin requires manifest, slice, and digest together")
    if args.initiative_source is not None and not all(value is not None for value in initiative_values):
        fail("Initiative source requires manifest, slice, and digest")
    if args.initiative_manifest is not None:
        if (not re.fullmatch(r"[0-9a-f]{64}", args.expected_plan_digest or "")
                or (args.expected_repository is None and getattr(args, "expected_repository_json", None) is None)):
            fail("Initiative begin requires approved plan and repository identities")
    elif forge is not None:
        fail("Forgejo local-only registration requires an approved schema 2 Initiative begin")
    initiative = None
    if args.initiative_manifest is not None:
        if not re.fullmatch(r"docs/initiatives/[a-z0-9][a-z0-9-]*/MANIFEST\.json",
                            args.initiative_manifest):
            fail("Initiative manifest must be a repository-relative docs/initiatives path")
        initiative_source = repo_root(args.initiative_source) if args.initiative_source else source
        initiative = initiative_receipt(
            initiative_source / args.initiative_manifest, args.initiative_slice, initiative_source)
        initiative["manifest_path"] = args.initiative_manifest
        if initiative["manifest_digest"] != args.initiative_digest:
            fail("Initiative manifest changed after approval")
        expected = expected_repository(args, initiative["schema_version"])
        if initiative["schema_version"] == 2:
            if initiative["repository"]["provider"] != "forgejo":
                fail("schema 2 GitHub target registration is unsupported")
            if forge is None or not repository_equal(initiative["repository"], {
                    key: forge[key] for key in ("provider", "origin", "repository")}):
                fail("Forgejo selection does not match the Initiative target identity")
        elif forge is not None:
            fail("Forgejo requires a schema 2 Initiative target identity")
        require_repository_home(source, initiative["repository"],
            "Initiative context home does not match the target Git repository")
        if not repository_equal(initiative["repository"], expected):
            fail("Initiative target repository changed after approval")
    if initiative is not None:
        if initiative["context"] != args.context:
            fail("Initiative receipt context does not match the cycle context")
        check_initiative_cycle_occupancy(source, args.cycle_id, initiative)
    if args.resume_existing and initiative is None:
        fail("resume-existing is limited to approved Initiative begin")
    plan = read_plan(args.plan, args.expected_plan_digest)
    if not (cycle_dir(source) / "cycles" / f"{args.cycle_id}.json").exists():
        require_registration_available(source, args.cycle_id)
    if initiative is not None:
        profile_source = (initiative_source if common_git_dir(source).resolve() == common_git_dir(initiative_source).resolve()
                          else source)
        validate_plan(profile_source, args.context, args.delivery_intent, plan)
    target = upstream(source)
    remote, remote_branch = configured_upstream(source)
    if (initiative is not None and (args.delivery_intent == "draft_pr" or forge is not None)
            and common_git_dir(source).resolve() == common_git_dir(initiative_source).resolve()):
        if git(source, "check-ref-format", "--branch", args.base_branch, check=False).returncode:
            fail("invalid protected base branch")
        remote, remote_branch = "origin", args.base_branch
        target = f"{remote}/{remote_branch}"
    if not target or not remote or not remote_branch:
        fail("begin requires a configured remote upstream")
    normalize_begin_delivery(source, args, remote_branch)
    if forge is not None:
        remote_url, delivery_env = None, None
    elif args.delivery_intent == "draft_pr":
        remote_url = github_remote_url(source, remote, args.github_repository)
        delivery_env = github_environment(args.github_account)
    else:
        remote_url, delivery_env = remote, None
    if forge is not None:
        fetch_forgejo_branch(source, remote, initiative["repository"], remote_branch, forge["account"])
    elif args.delivery_intent == "draft_pr":
        fetch_github_branch(source, remote, remote_url, remote_branch, delivery_env)
    else:
        git(source, "fetch", remote, remote_branch)
    launch_plan = None
    if initiative is not None:
        launch_plan = initiative_launch_plan(source, initiative_source, initiative, plan, target, args)
        if not args.resume_existing and launch_plan["checkout"]["head"] != launch_plan["base_head"]:
            fail("registration requires a clean task checkout at the approved base")
        launch_digest = continuation_digest(launch_plan)
        if getattr(args, "preflight", False):
            print(json.dumps({"schema_version": 1, "launch_digest": launch_digest, "plan": launch_plan}, sort_keys=True))
            return
        if getattr(args, "expected_launch_digest", None) != launch_digest:
            fail("Initiative launch plan changed or is missing; run preflight before approval")
    elif getattr(args, "preflight", False):
        fail("launch preflight requires an Initiative")
    elif ahead(source, target):
        fail("unknown commits are ahead of upstream; reconcile them before begin")
    branch_name = branch(source)
    if (cycle_dir(source) / "cycles" / f"{args.cycle_id}.json").exists():
        if not args.resume_existing:
            fail(f"cycle branch already exists: {branch_name}")
        record_path = cycle_dir(source) / "cycles" / f"{args.cycle_id}.json"
        if not record_path.is_file():
            fail("existing Initiative cycle record is missing")
        record = read_cycle_record(source, record_path)
        worktree = record_worktree(source, record)
        _, active_record = load(worktree)
        require_active(active_record)
        profile_path, profile_blob, gates, graphify = validate_plan(
            worktree, args.context, args.delivery_intent, plan)
        expected_plan = {"profile": profile_path, "gates": {
            name: {key: value for key, value in gate.items() if key in ("applicability", "reason")}
            for name, gate in gates.items()
        }, **({"graphify": graphify} if graphify else {})}
        protected_base = record.get("delivery", {}).get(
            "base_branch" if args.delivery_intent == "draft_pr" or forge is not None else "protected_base_branch")
        expected_github = ({"host": "github.com", "account": args.github_account,
                            "repository": args.github_repository}
                           if args.delivery_intent == "draft_pr" else None)
        if (active_record != record or record.get("cycle_id") != args.cycle_id
                or record.get("context") != args.context or record.get("risk") != args.risk
                or record.get("delivery_intent") != args.delivery_intent
                or effective_initiative(record) != initiative
                or record.get("git", {}).get("upstream") != target
                or not native_workspace_execution(record) or worktree.resolve() != source.resolve()
                or record.get("worktree", {}).get("branch") != branch_name
                or not record_worktree_matches(source, record, worktree)
                or branch(worktree) != branch_name or protected_base != args.base_branch
                or (expected_github is not None
                    and record.get("delivery", {}).get("github") != expected_github)
                or (forge is not None and (record.get("schema_version") != 6
                    or record.get("delivery", {}).get("forge") != forge
                    or record.get("delivery", {}).get("base_head") != launch_plan["base_head"]
                    or record.get("git", {}).get("remote") != forgejo_remote_urls(source, remote, initiative["repository"])))
                or record.get("engineering_profile") != {"path": profile_path, "blob": profile_blob}
                or record.get("applicability_plan") != expected_plan):
            fail("existing Initiative cycle does not match the approved launch")
        print(json.dumps({
            "cycle_id": record["cycle_id"], "branch": branch_name,
            "worktree": str(worktree), "upstream": target,
            "initiative": initiative,
            "resumed": True,
            "attribution": {"status": "unavailable", "reason": "native_identity_not_collected"},
        }, sort_keys=True))
        return
    worktree = source.resolve()
    if resolved_active_path(worktree, bindings=False).exists():
        fail("an active cycle already exists; inspect its native checkout before registration")
    if git(source, "rev-parse", "HEAD").stdout.strip() != git(source, "rev-parse", target).stdout.strip():
        fail("registration requires a checkout at the configured upstream base")
    initiative_approval = None
    if initiative is not None:
        agent_confirmed = getattr(args, "approval", "interactive") == "agent-confirmed"
        if not agent_confirmed and not sys.stdin.isatty():
            fail("Initiative registration requires interactive operator confirmation")
        approval_view = {"initiative": initiative["initiative_id"], "slice": initiative["slice_id"],
            "cycle_id": args.cycle_id, "risk": args.risk, "delivery_intent": args.delivery_intent,
            "repository": initiative["repository"], "target": target, "base_branch": args.base_branch,
            "manifest_digest": initiative["manifest_digest"], "plan_digest": args.expected_plan_digest,
            "launch_digest": launch_digest, "base_head": launch_plan["base_head"],
            **({"forge": forge} if forge is not None else {"github_account": args.github_account}),
            "import_paths": [entry["path"] for entry in launch_plan["artifacts"]]}
        confirmation = f"BEGIN {args.cycle_id} {launch_digest}"
        if agent_confirmed:
            # Caller reports explicit chat approval; this does not authenticate an actor.
            print(json.dumps(approval_view, sort_keys=True) + "\nApproval: agent-confirmed (caller assertion)",
                  file=sys.stderr, flush=True)
        else:
            print(json.dumps(approval_view, sort_keys=True) + f"\nType {confirmation}: ",
                  end="", file=sys.stderr, flush=True)
            if sys.stdin.readline(512).strip() != confirmation:
                fail("Initiative confirmation declined")
        confirmed_at = now()
        fresh_plan = read_plan(args.plan, args.expected_plan_digest)
        require_native_checkout(source, args)
        current = initiative_receipt(initiative_source / args.initiative_manifest,
                                     args.initiative_slice, initiative_source)
        current["manifest_path"] = args.initiative_manifest
        require_repository_home(source, initiative["repository"])
        require_repository_home(initiative_source, initiative["coordinator_repository"])
        if (current != initiative or root_dir().resolve() != source.resolve() or upstream(source) != target):
            fail("Initiative authority or checkout changed during confirmation; request fresh preflight")
        check_initiative_cycle_occupancy(source, args.cycle_id, current)
        require_registration_available(source, args.cycle_id)
        if forge is not None:
            fetch_forgejo_branch(source, remote, initiative["repository"], remote_branch, forge["account"])
        elif args.delivery_intent == "draft_pr":
            current_url = github_remote_url(source, remote, args.github_repository)
            fetch_github_branch(source, remote, current_url, remote_branch, delivery_env)
        else:
            git(source, "fetch", remote, remote_branch)
        fresh_launch = initiative_launch_plan(source, initiative_source, current, fresh_plan, target, args)
        if continuation_digest(fresh_launch) != launch_digest:
            fail("Initiative launch plan changed during confirmation; request fresh preflight")
        initiative_approval = {"schema_version": 1, "method": "agent_confirmed" if agent_confirmed else "interactive_cli",
                               "launch_digest": launch_digest, "confirmed_at": confirmed_at}
    discovery_import = None
    if launch_plan and launch_plan["artifacts"]:
        paths = [entry["path"] for entry in launch_plan["artifacts"]]
        git(worktree, "restore", "--source", launch_plan["source_commit"], "--staged", "--worktree", "--", *paths)
        git(worktree, "commit", "-m", "docs(discovery): import approved slice authority")
        discovery_import = {key: launch_plan[key] for key in ("base_head", "source_commit", "artifacts")}
        discovery_import["commit"] = git(worktree, "rev-parse", "HEAD").stdout.strip()
    record = start_cycle(worktree, args, plan, git_env=delivery_env,
                         discovery_import=discovery_import, initiative=initiative,
                         initiative_approval=initiative_approval)
    print(json.dumps({
        "cycle_id": record["cycle_id"], "branch": branch_name,
        "worktree": str(worktree), "upstream": target,
        **({"initiative": initiative} if initiative is not None else {}),
    }, sort_keys=True))


def cycle_runtime_locator(runtime, worktree, source):
    opencode = runtime.get("opencode") if isinstance(runtime, dict) else None
    if not isinstance(opencode, dict):
        return runtime
    runtime_worktree = Path(opencode.get("worktree", "")).expanduser().resolve()
    runtime_directory = Path(opencode.get("directory", "")).expanduser().resolve()
    if runtime_worktree == worktree.resolve():
        root_name, base = "cycle_worktree", worktree.resolve()
    elif source is not None and runtime_worktree == source.resolve():
        root_name, base = "primary_worktree", source.resolve()
    else:
        fail("OpenCode runtime worktree cannot be made portable")
    try:
        directory = runtime_directory.relative_to(base).as_posix() or "."
    except ValueError:
        fail("OpenCode runtime directory cannot be made portable")
    return {**runtime, "opencode": {
        **{key: value for key, value in opencode.items()
           if key not in {"path_root", "worktree", "directory"}},
        "path_root": root_name, "worktree": ".", "directory": directory,
    }}


def validate_active_pointer(root, pointer, cycle_id, required=False):
    managed_directory(root, pointer.parent)
    if pointer.exists():
        if active_pointer_id(root, pointer) != cycle_id:
            fail("cycle active pointer identity changed")
        return True
    if pointer.is_symlink():
        fail("cycle active pointer is unsafe")
    if required:
        fail("cycle active pointer is missing")
    return False


def write_active_pointer(root, pointer, cycle_id):
    if validate_active_pointer(root, pointer, cycle_id):
        return
    managed_directory(root, pointer.parent, create=True)
    temporary = pointer.with_suffix(".tmp")
    if temporary.exists() or temporary.is_symlink():
        fail("cycle active pointer temporary is unsafe")
    with temporary.open("x", encoding="utf-8") as handle:
        handle.write(cycle_id + "\n")
    os.replace(temporary, pointer)


def portable_cycle_record(root, record):
    worktree = record_worktree(root, record)
    registry = worktree_registry_root()
    locator = relative_locator(worktree, registry, "dbsctr_worktrees")
    if locator is None:
        fail("cycle worktree is outside configured registry")
    if (not worktree.is_dir() or not record_worktree_matches(root, record, worktree)
            or branch(worktree) != record.get("worktree", {}).get("branch")):
        fail("cycle worktree identity changed")
    source = record_source_worktree(root, record)
    if source is not None and source != primary_worktree(root):
        fail("source worktree identity changed")
    portable = json.loads(json.dumps(record))
    portable["schema_version"] = 4
    portable["worktree"] = {
        **{key: value for key, value in record["worktree"].items()
           if key not in {"id", "path", "git_dir", "locator"}},
        "id": worktree_id(worktree), "locator": locator,
    }
    if source is not None:
        portable["source"] = {
            **{key: value for key, value in record["source"].items() if key != "path"},
            "locator": {"root": "primary_worktree", "path": "."},
        }
    if "runtime" in portable:
        portable["runtime"] = cycle_runtime_locator(portable["runtime"], worktree, source)
    return worktree, portable


def command_cycle_portabilize(args):
    root = root_dir()
    cycle_id = improvement_id(args.cycle_id, "cycle ID")
    path = cycle_dir(root) / "cycles" / f"{cycle_id}.json"
    backup = cycle_dir(root) / "migrations" / f"{cycle_id}.schema3.json"
    if not path.is_file() or path.is_symlink():
        fail("cycle record is missing")
    with evidence_lock(root, cycle_id):
        record = read_cycle_record(root, path)
        if record.get("cycle_id") != cycle_id or record.get("state") != "active":
            fail("only the named active cycle can be made portable")
        managed_directory(root, backup.parent)
        if backup.exists() and (backup.is_symlink() or not backup.is_file()):
            fail("schema 3 rollback is invalid")
        legacy = read_cycle_record(root, backup, "schema 3 rollback") if backup.is_file() else None
        if legacy is not None and (legacy.get("schema_version") != 3
                                   or legacy.get("cycle_id") != cycle_id
                                   or legacy.get("state") != "active"):
            fail("schema 3 rollback is invalid")
        if args.rollback:
            if legacy is None:
                if record.get("schema_version") == 3:
                    print(json.dumps({"cycle_id": cycle_id, "schema_version": 3}, sort_keys=True))
                    return
                fail("portable cycle has no schema 3 rollback")
            if record.get("schema_version") == 4:
                current_id = record["worktree"]["id"]
            elif record.get("schema_version") == 3 and record == legacy:
                current_id = worktree_id(record_worktree(root, legacy))
            else:
                fail("portable cycle rollback state is invalid")
            old_pointer = cycle_dir(root) / "worktrees" / legacy["worktree"]["id"] / "active"
            write_active_pointer(root, old_pointer, cycle_id)
            if record != legacy:
                save(path, legacy)
            current_pointer = cycle_dir(root) / "worktrees" / current_id / "active"
            if current_pointer != old_pointer:
                validate_active_pointer(root, current_pointer, cycle_id)
                current_pointer.unlink(missing_ok=True)
            backup.unlink()
            print(json.dumps({"cycle_id": cycle_id, "schema_version": 3}, sort_keys=True))
            return
        if legacy is None:
            if record.get("schema_version") == 4:
                print(json.dumps({"cycle_id": cycle_id, "schema_version": 4}, sort_keys=True))
                return
            if record.get("schema_version") != 3:
                fail("cycle is not an unmigrated schema 3 record")
            old_pointer = cycle_dir(root) / "worktrees" / record["worktree"]["id"] / "active"
            validate_active_pointer(root, old_pointer, cycle_id, required=True)
            managed_directory(root, backup.parent, create=True)
            exclusive_json(backup, record)
            legacy = record
        if record.get("schema_version") == 3:
            old_pointer = cycle_dir(root) / "worktrees" / legacy["worktree"]["id"] / "active"
            validate_active_pointer(root, old_pointer, cycle_id, required=True)
        worktree, portable = portable_cycle_record(root, legacy)
        if record.get("schema_version") == 3 and record == legacy:
            save(path, portable)
        elif record.get("schema_version") != 4 or record != portable:
            fail("portable cycle migration state is invalid")
        new_pointer = cycle_dir(root) / "worktrees" / portable["worktree"]["id"] / "active"
        write_active_pointer(root, new_pointer, cycle_id)
        old_pointer = cycle_dir(root) / "worktrees" / legacy["worktree"]["id"] / "active"
        if old_pointer != new_pointer:
            if old_pointer.exists() or old_pointer.is_symlink():
                validate_active_pointer(root, old_pointer, cycle_id)
            old_pointer.unlink(missing_ok=True)
    print(json.dumps({"cycle_id": cycle_id, "schema_version": 4}, sort_keys=True))


def cleanup_cycle(root, cycle_id, immediate):
    path = cycle_dir(root) / "cycles" / f"{cycle_id}.json"
    if not path.is_file():
        fail(f"cycle record is missing: {cycle_id}")
    record = read_cycle_record(root, path)
    if record.get("state") != "completed":
        fail("only a completed cycle can be cleaned up")
    if record.get("worktree", {}).get("created_by_dbsctr") is not True:
        fail("cleanup only removes DBSCTR-created worktrees")
    worktree = record_worktree(root, record)
    durable_cleanup = record.get("schema_version") in (3, 4, 5)
    if not worktree.is_dir() and not durable_cleanup:
        return "already removed " + str(worktree)
    cleanup = record.get("cleanup")
    if not worktree.is_dir() and (not cleanup or cleanup.get("state") not in (
            "removing_worktree", "worktree_removed", "evidence_parked")):
        fail("cycle worktree is missing")
    branch_name = record["worktree"].get("branch")
    expected_branch = f"dbsctr/{record['context']}/{cycle_id}"
    if branch_name != expected_branch:
        fail("invalid cycle worktree branch")
    if worktree.resolve() == root.resolve():
        fail("run cleanup from another worktree")
    if cleanup and cleanup.get("state") in ("removing_worktree", "worktree_removed"):
        marker_branch = cleanup.get("branch")
        if marker_branch is not None and marker_branch != branch_name:
            fail("cleanup branch identity changed")
        if marker_branch is None:
            cleanup["branch"] = branch_name
            save(path, record)
    if not worktree.is_dir() and cleanup and cleanup.get("state") == "removing_worktree":
        registered = {line.removeprefix("worktree ") for line in
                      git(root, "worktree", "list", "--porcelain").stdout.splitlines()
                      if line.startswith("worktree ")}
        if str(worktree.resolve()) in registered:
            fail("incomplete Git worktree removal")
        record["cleanup"] = {"state": "worktree_removed", "branch": branch_name, "removed_at": now()}
        save(path, record)
        cleanup = record["cleanup"]
    completed = datetime.fromisoformat(record["completed_at"].replace("Z", "+00:00"))
    if not immediate and datetime.now(timezone.utc) - completed < timedelta(hours=24):
        fail("successful worktrees are retained for 24 hours; use --now to remove earlier")
    if worktree.is_dir() and status_paths(worktree):
        fail("refusing to remove a dirty cycle worktree")
    if worktree.is_dir() and branch(worktree) != record["worktree"]["branch"]:
        fail("cycle worktree branch changed")
    if worktree.is_dir() and not record_worktree_matches(root, record, worktree):
        fail("cycle worktree identity changed")
    recorded_commits = [entry["id"] for entry in record["commits"]]
    if worktree.is_dir() and recorded_commits and git(worktree, "rev-parse", "HEAD").stdout.strip() != recorded_commits[-1]:
        fail("cycle worktree HEAD changed")
    delivery = record.get("delivery", {})
    remote = delivery.get("remote")
    remote_branch = delivery.get("branch")
    if worktree.is_dir() and (not remote or not remote_branch):
        remote, remote_branch = remote_for_upstream(worktree, record["git"]["upstream"])
    expected = record["git"]["remote"]
    if worktree.is_dir() and expected != remote_destination(worktree, record["git"]["upstream"]):
        fail("remote push destination changed")
    if worktree.is_dir():
        if record.get("delivery_intent") == "draft_pr":
            git(worktree, "fetch", remote, f"refs/heads/{remote_branch}:refs/remotes/{remote}/{remote_branch}")
        else:
            git(worktree, "fetch", remote, remote_branch)
    target = (f"refs/remotes/{remote}/{remote_branch}" if record.get("delivery_intent") == "draft_pr"
              else record["git"]["upstream"])
    for entry in record["commits"]:
        if worktree.is_dir() and git(worktree, "merge-base", "--is-ancestor", entry["id"], target, check=False).returncode:
            fail("cycle commits are not all contained in the delivery target")
    if worktree.is_dir():
        if durable_cleanup:
            record["cleanup"] = {"state": "removing_worktree", "branch": branch_name, "started_at": now()}
            save(path, record)
        git(root, "worktree", "remove", str(worktree))
        if durable_cleanup:
            record["cleanup"] = {"state": "worktree_removed", "branch": branch_name, "removed_at": now()}
            save(path, record)
    if branch_name and git(root, "show-ref", "--verify", "--quiet", f"refs/heads/{branch_name}", check=False).returncode == 0:
        deleted = git(root, "branch", "-d", branch_name, check=False)
        if deleted.returncode:
            fail(deleted.stderr.strip() or "cannot delete cycle branch")
    if durable_cleanup:
        evidence = cycle_dir(root) / "evidence" / cycle_id
        parked = evidence.with_name(evidence.name + ".cleanup")
        cleanup = record.get("cleanup")
        if cleanup:
            if cleanup.get("state") not in ("worktree_removed", "evidence_parked"):
                fail("invalid evidence cleanup state")
            if cleanup.get("state") == "evidence_parked" and evidence.exists():
                fail("invalid evidence cleanup state")
        if cleanup and cleanup.get("state") == "worktree_removed" and parked.exists():
            if evidence.exists():
                fail("invalid evidence cleanup state")
            record["cleanup"] = {"state": "evidence_parked", "parked_at": now()}
            save(path, record)
            cleanup = record["cleanup"]
        if not cleanup and parked.exists():
            fail("untracked parked evidence directory")
        if evidence.exists():
            os.replace(evidence, parked)
            record["cleanup"] = {"state": "evidence_parked", "parked_at": now()}
            save(path, record)
        elif not cleanup or cleanup.get("state") != "evidence_parked":
            record["cleanup"] = {"state": "evidence_parked", "parked_at": now()}
            save(path, record)
        if parked.exists():
            shutil.rmtree(parked)
        path.unlink()
    return "removed " + str(worktree)


def cycle_retirement_reason(value):
    normalized = " ".join(value.split())
    if not 1 <= len(normalized.encode()) <= 512 or review_unsafe(normalized):
        fail("invalid cycle retirement reason")
    return normalized


def command_cycle_retire(args):
    root = root_dir()
    cycle_id = improvement_id(args.cycle_id, "cycle ID")
    if improvement_id(args.confirm, "confirmation") != cycle_id:
        fail("cycle confirmation does not match")
    reason = cycle_retirement_reason(args.reason)
    path = cycle_dir(root) / "cycles" / f"{cycle_id}.json"
    if not path.is_file() or path.is_symlink():
        fail("cycle record is missing")

    with evidence_lock(root, cycle_id):
        record = read_cycle_record(root, path)
        retirement = record.get("retirement")
        retrying = (record.get("state") == "active" and isinstance(retirement, dict)
                    and retirement.get("state") == "removing_worktree")
        if record.get("state") != "active" or retirement is not None and not retrying:
            fail("only an active unretired cycle can be retired")
        if record.get("cycle_id") != cycle_id:
            fail("cycle record identity mismatch")
        details = record.get("worktree", {})
        if details.get("created_by_dbsctr") is not True:
            fail("retirement only removes DBSCTR-created worktrees")
        worktree = record_worktree(root, record)
        branch_name = details.get("branch")
        expected_branch = f"dbsctr/{record['context']}/{cycle_id}"
        if branch_name != expected_branch or worktree.resolve() == root.resolve():
            fail("invalid cycle retirement worktree")
        pointer = cycle_dir(root) / "worktrees" / details.get("id", "") / "active"
        if pointer.exists() and (not pointer.is_file() or pointer.is_symlink()
                                 or pointer.read_text(encoding="utf-8").strip() != cycle_id):
            fail("cycle active pointer identity changed")
        if not pointer.exists() and not (retrying and not worktree.is_dir()):
            fail("cycle active pointer is missing")
        marker = {
            "state": "removing_worktree", "disposition": args.disposition,
            "reason": reason, "branch": branch_name,
        }
        if retrying:
            if any(retirement.get(name) != value for name, value in marker.items()):
                fail("cycle retirement retry changed")
        elif not worktree.is_dir():
            fail("cycle retirement worktree is missing")

        if worktree.is_dir():
            if status_paths(worktree):
                fail("refusing to retire a dirty cycle worktree")
            if branch(worktree) != branch_name or not record_worktree_matches(root, record, worktree):
                fail("cycle retirement worktree identity changed")
            head = git(worktree, "rev-parse", "HEAD").stdout.strip()
            commits = [entry["id"] for entry in record.get("commits", [])]
            if args.disposition == "empty":
                if commits or head != record.get("git", {}).get("head"):
                    fail("empty retirement requires an unchanged cycle baseline")
            elif args.disposition == "integrated":
                if not commits:
                    fail("integrated retirement requires recorded Gate Commits")
                remote, target_branch = remote_for_upstream(worktree, record["git"]["upstream"])
                if not remote or not target_branch:
                    fail("cycle delivery target is unavailable")
                git(worktree, "fetch", remote, target_branch)
                target = f"refs/remotes/{remote}/{target_branch}"
                if (any(git(worktree, "merge-base", "--is-ancestor", commit, target,
                            check=False).returncode for commit in commits)
                        or git(worktree, "merge-base", "--is-ancestor", head, target,
                               check=False).returncode):
                    fail("cycle work is not integrated into its delivery target")
            record["retirement"] = {**marker, "head": head, "started_at": now()}
            save(path, record)
            git(root, "worktree", "remove", str(worktree))
        elif not retrying:
            fail("cycle retirement worktree is missing")

        pointer.unlink(missing_ok=True)
        record["state"] = "retired"
        record["retired_at"] = now()
        record["retirement"] = {**record["retirement"], "state": "retired",
                                "retired_at": record["retired_at"]}
        save(path, record)
    print(json.dumps({"cycle_id": cycle_id, "state": "retired",
                      "disposition": args.disposition, "branch": branch_name}, sort_keys=True))


def command_cycle_retire_worktree(args):
    root = root_dir()
    cycle_id = improvement_id(args.cycle_id, "cycle ID")
    if improvement_id(args.confirm, "confirmation") != cycle_id:
        fail("cycle confirmation does not match")
    reason = cycle_retirement_reason(args.reason)
    path = cycle_dir(root) / "cycles" / f"{cycle_id}.json"
    if not path.is_file() or path.is_symlink():
        fail("cycle record is missing")

    with evidence_lock(root, cycle_id):
        record = read_cycle_record(root, path)
        retirement = record.get("worktree_retirement")
        retrying = (record.get("state") == "completed" and isinstance(retirement, dict)
                    and retirement.get("state") == "removing_worktree")
        if record.get("state") != "completed" or retirement is not None and not retrying:
            fail("only a completed cycle worktree can be retired")
        if record.get("cycle_id") != cycle_id:
            fail("cycle record identity mismatch")
        details = record.get("worktree", {})
        if details.get("created_by_dbsctr") is not True:
            fail("worktree retirement requires its DBSCTR-created owner cycle")
        worktree = record_worktree(root, record)
        branch_name = details.get("branch")
        expected_branch = f"dbsctr/{record['context']}/{cycle_id}"
        if branch_name != expected_branch or worktree.resolve() == root.resolve():
            fail("invalid completed cycle worktree")
        pointer = cycle_dir(root) / "worktrees" / details.get("id", "") / "active"
        if pointer.exists():
            fail("completed cycle worktree still has an active pointer")
        marker = {"state": "removing_worktree", "reason": reason, "branch": branch_name}
        if retrying:
            if any(retirement.get(name) != value for name, value in marker.items()):
                fail("completed worktree retirement retry changed")
        elif not worktree.is_dir():
            fail("completed cycle worktree is missing")

        if worktree.is_dir():
            if status_paths(worktree):
                fail("refusing to retire a dirty completed worktree")
            if branch(worktree) != branch_name or not record_worktree_matches(root, record, worktree):
                fail("completed cycle worktree identity changed")
            related = []
            for candidate in (cycle_dir(root) / "cycles").glob("*.json"):
                value = read_cycle_record(root, candidate)
                other = value.get("worktree", {})
                if (other.get("id") == details["id"]
                        or record.get("schema_version") not in (4, 5) and other.get("path") == details.get("path")):
                    related.append(value)
            if not related or any(value.get("state") != "completed" for value in related):
                fail("shared worktree has a non-completed cycle")
            remote, target_branch = remote_for_upstream(worktree, record["git"]["upstream"])
            if not remote or not target_branch:
                fail("cycle delivery target is unavailable")
            git(worktree, "fetch", remote, target_branch)
            target = f"refs/remotes/{remote}/{target_branch}"
            commits = [entry["id"] for value in related for entry in value.get("commits", [])]
            head = git(worktree, "rev-parse", "HEAD").stdout.strip()
            if (not commits or any(git(worktree, "merge-base", "--is-ancestor", commit, target,
                                       check=False).returncode for commit in commits)
                    or git(worktree, "merge-base", "--is-ancestor", head, target,
                           check=False).returncode):
                fail("shared cycle work is not integrated into its delivery target")
            record["worktree_retirement"] = {
                **marker, "head": head, "related_cycles": sorted(value["cycle_id"] for value in related),
                "started_at": now(),
            }
            save(path, record)
            git(root, "worktree", "remove", str(worktree))
        elif not retrying:
            fail("completed cycle worktree is missing")

        record["worktree_retirement"] = {
            **record["worktree_retirement"], "state": "retired", "retired_at": now(),
        }
        save(path, record)
    print(json.dumps({"cycle_id": cycle_id, "state": "completed", "worktree": "retired",
                      "branch": branch_name}, sort_keys=True))


def worktree_bytes(path):
    if not path.is_dir():
        return 0
    result = subprocess.run(["du", "-sk", str(path)], text=True, capture_output=True)
    if result.returncode:
        return None
    try:
        return int(result.stdout.split(maxsplit=1)[0]) * 1024
    except (IndexError, ValueError):
        return None


def path_within(path, root):
    try:
        path.resolve().relative_to(root.resolve())
        return True
    except ValueError:
        return False


def global_worktree_roots(registry=None):
    registry = worktree_registry_root(registry)
    if not registry.exists():
        return [], []
    if not registry.is_dir() or registry.is_symlink():
        return [], [{"repository_id": "registry", "error": "invalid_registry"}]
    registry = registry.resolve()
    repositories, failures, seen = [], [], set()
    parents = sorted(registry.iterdir())
    if len(parents) > 256:
        return [], [{"repository_id": "registry", "error": "registry_limit"}]
    for parent in parents:
        if parent.is_symlink() or not parent.is_dir() or parent.resolve().parent != registry:
            continue
        children = sorted(parent.iterdir())
        if len(children) > 1024:
            failures.append({"repository_id": hashlib.sha256(parent.name.encode()).hexdigest()[:16],
                             "error": "worktree_limit"})
            continue
        for child in children:
            if child.is_symlink() or not child.is_dir() or child.resolve().parent != parent.resolve():
                continue
            found = subprocess.run(["git", "rev-parse", "--git-common-dir"], cwd=child,
                                   text=True, capture_output=True)
            if found.returncode or not found.stdout.strip():
                continue
            common = Path(found.stdout.strip())
            common = (common if common.is_absolute() else child / common).resolve()
            if common in seen:
                continue
            seen.add(common)
            listing = subprocess.run(["git", "worktree", "list", "--porcelain"], cwd=child,
                                     text=True, capture_output=True)
            primary_line = next((line for line in listing.stdout.splitlines()
                                 if line.startswith("worktree ")), None)
            repository_id = f"{common.parent.name}-{hashlib.sha256(str(common).encode()).hexdigest()[:12]}"
            if listing.returncode or primary_line is None:
                failures.append({"repository_id": repository_id, "error": "primary_unavailable"})
                continue
            primary = Path(primary_line.removeprefix("worktree ")).resolve()
            try:
                if not primary.is_dir() or common_git_dir(primary).resolve() != common:
                    raise RuntimeError
            except RuntimeError:
                failures.append({"repository_id": repository_id, "error": "identity_changed"})
                continue
            repositories.append((repository_id, primary, parent.resolve()))
            break
    return sorted(repositories), sorted(failures, key=lambda item: item["repository_id"])


def maintenance_error(error):
    message = str(error).casefold()
    for needle, code in (
        ("retained for 24 hours", "retained_24_hours"), ("dirty", "dirty"),
        ("authentication failed", "delivery_unavailable"),
        ("repository not found", "delivery_unavailable"),
        ("fetch", "delivery_unavailable"), ("identity", "identity_changed"),
        ("branch", "branch_changed"), ("head changed", "head_changed"),
        ("missing", "missing"),
    ):
        if needle in message:
            return code
    return "cleanup_failed"


def worktree_inventory(root, immediate=False, allowed_root=None):
    records = cycle_dir(root) / "cycles"
    result = []
    for path in sorted(records.glob("*.json")):
        record = read_cycle_record(root, path)
        if record.get("worktree", {}).get("created_by_dbsctr") is not True:
            continue
        worktree = record_worktree(root, record)
        blockers = []
        shared_retired = record.get("worktree_retirement", {}).get("state") == "retired"
        if record.get("state") == "retired":
            if worktree.is_dir() or record.get("retirement", {}).get("state") != "retired":
                blockers.append("retirement_incomplete")
        elif record.get("state") != "completed":
            blockers.append("not_completed")
        elif not shared_retired:
            try:
                completed = datetime.fromisoformat(record["completed_at"].replace("Z", "+00:00"))
                if not immediate and datetime.now(timezone.utc) - completed < timedelta(hours=24):
                    blockers.append("retained_24_hours")
            except (KeyError, ValueError):
                blockers.append("invalid_completed_at")
        if worktree.is_dir():
            if allowed_root is not None and not path_within(worktree, allowed_root):
                blockers.append("outside_registry")
            if worktree.resolve() == root.resolve():
                blockers.append("current_worktree")
            if status_paths(worktree):
                blockers.append("dirty")
            if branch(worktree) != record["worktree"].get("branch"):
                blockers.append("branch_changed")
            commits = record.get("commits", [])
            if commits and git(worktree, "rev-parse", "HEAD").stdout.strip() != commits[-1]["id"]:
                blockers.append("head_changed")
            if not record_worktree_matches(root, record, worktree):
                blockers.append("identity_changed")
        elif (record.get("state") != "retired" and not shared_retired
              and record.get("cleanup", {}).get("state") not in ("worktree_removed", "evidence_parked")):
            blockers.append("missing")
        result.append({
            "bytes": worktree_bytes(worktree),
            "cleanup_candidate": (record.get("state") == "completed"
                                  and not shared_retired and not blockers),
            "cleanup_blockers": blockers,
            "cycle_id": record["cycle_id"],
            "present": worktree.is_dir(),
            "state": record.get("state"),
        })
    return result


@contextlib.contextmanager
def inventory_budget(seconds):
    """Bound local metadata/validator I/O as well as subprocess collection (Unix hosts)."""
    # ponytail: main-thread Unix timers; use a worker boundary only if embedded off-thread.
    started = time.monotonic()
    previous = signal.getsignal(signal.SIGALRM)
    timer = signal.getitimer(signal.ITIMER_REAL)
    def expired(signum, frame):
        raise TimeoutError("inventory_timeout")
    signal.signal(signal.SIGALRM, expired)
    signal.setitimer(signal.ITIMER_REAL, min(seconds, timer[0]) if timer[0] else seconds)
    try:
        yield
    finally:
        signal.setitimer(signal.ITIMER_REAL, 0)
        signal.signal(signal.SIGALRM, previous)
        if timer[0]:
            signal.setitimer(signal.ITIMER_REAL, max(0.000001, timer[0] - (time.monotonic() - started)), timer[1])


def inventory_git(root, *arguments):
    child = subprocess.Popen(["git", *arguments], cwd=root, env=INSPECT_ENV,
                             stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                             stderr=subprocess.PIPE, start_new_session=True)
    output, errors = preservation_output(child, limit=1024 * 1024, timeout=1)
    if child.returncode or errors.strip():
        fail("inventory_git_unavailable")
    return os.fsdecode(output)


def inventory_children(path, limit):
    if path.is_symlink():
        fail("inventory_source_unsafe")
    if not path.exists():
        return []
    with os.scandir(path) as entries:
        result = []
        for entry in entries:
            if len(result) == limit:
                fail("inventory_source_limit")
            result.append(Path(entry.path))
    return sorted(result)


def inventory_record_sources(common):
    # Only native common-Git and retained per-worktree lifecycle stores; no runtime DB.
    directories = [common / "dbsctr/cycles"]
    for admin in inventory_children(common / "worktrees", 1024):
        if admin.is_symlink() or not admin.is_dir():
            fail("inventory_source_unsafe")
        directories.append(admin / "dbsctr/cycles")
    files = []
    for directory in directories:
        if not safe_directory(common, directory):
            continue
        for path in inventory_children(directory, 1024):
            if path.suffix != ".json":
                continue
            details = path.lstat()
            if (not stat.S_ISREG(details.st_mode) or details.st_uid != os.getuid()
                    or details.st_nlink != 1 or details.st_size > 1024 * 1024):
                fail("inventory_source_unsafe")
            files.append((path, [str(path), details.st_ino, details.st_size, details.st_mtime_ns]))
            if len(files) > 1024:
                fail("inventory_source_limit")
    return files


def inventory_repository(seed):
    common = Path(inventory_git(seed, "rev-parse", "--path-format=absolute", "--git-common-dir").strip()).resolve()
    raw = inventory_git(seed, "worktree", "list", "--porcelain", "-z")
    members = []
    for block in raw.split("\0\0"):
        if not block:
            continue
        fields = {}
        for line in block.strip("\0").split("\0"):
            key, _, value = line.partition(" ")
            if key in fields:
                fail("inventory_membership_invalid")
            fields[key] = value
        if "worktree" not in fields or not Path(fields["worktree"]).is_absolute():
            fail("inventory_membership_invalid")
        members.append(fields)
        if len(members) > 10000:
            fail("inventory_source_limit")
    if not members:
        fail("inventory_membership_invalid")
    files = inventory_record_sources(common)
    return {"root": str(seed), "common": str(common), "members": members,
            "files": files, "digest": continuation_digest([str(common), raw, [stamp for _, stamp in files]])}


def inventory_cycles(repository):
    root, common = Path(repository["root"]), Path(repository["common"])
    records, unavailable = [], False
    for path, stamp in repository["files"]:
        try:
            record = read_cycle_record(root, path, historical=True, max_bytes=1024 * 1024)
            identifier, state = record.get("cycle_id"), record.get("state")
            if (identifier != path.stem or not OPAQUE_ID.fullmatch(identifier or "")
                    or state not in {"active", "finalizing", "completed", "retired"}):
                fail("inventory_record_invalid")
            details = record.get("worktree", {})
            if not isinstance(details, dict):
                fail("inventory_record_invalid")
            if native_workspace_execution(record):
                binding = ("admin", str(native_git_directory(root, record, common=common)))
            else:
                # Validate existing portable identity using bounded Git, never continuation routing.
                if "locator" in details:
                    locator = details["locator"]
                    locator_path(locator, {"cycle_worktree": root, "dbsctr_worktrees": worktree_registry_root()},
                                 "cycle worktree", validate_only=True)
                    initial = repository.get("initial")
                    if initial is None:
                        if inventory_git(root, "rev-parse", "--is-shallow-repository").strip() != "false":
                            fail("inventory_record_invalid")
                        initial = inventory_git(root, "rev-list", "--max-parents=0", "HEAD").splitlines()
                        if len(initial) != 1:
                            fail("inventory_record_invalid")
                        repository["initial"] = initial
                    expected = hashlib.sha256((initial[0] + "\0" + details["branch"]).encode()).hexdigest()[:16]
                    if locator["root"] == "cycle_worktree":
                        candidates = [Path(m["worktree"]) for m in repository["members"]
                                      if m.get("branch") == "refs/heads/" + details["branch"]]
                        if len(candidates) != 1:
                            fail("inventory_record_invalid")
                        located = candidates[0]
                    else:
                        located = locator_path(locator, {"dbsctr_worktrees": worktree_registry_root()}, "cycle worktree")
                else:
                    value = details.get("path")
                    if not isinstance(value, str) or not Path(value).is_absolute():
                        fail("inventory_record_invalid")
                    located = Path(value).resolve()
                    expected = legacy_worktree_id(located)
                if expected != details.get("id"):
                    fail("inventory_record_invalid")
                binding = ("path", str(located))
            if not isinstance(details.get("branch"), str):
                fail("inventory_record_invalid")
            records.append((binding, {"id": identifier, "state": state}, details["branch"]))
            details = path.lstat()
            if stamp != [str(path), details.st_ino, details.st_size, details.st_mtime_ns]:
                fail("inventory_source_changed")
        except TimeoutError:
            raise
        except (RuntimeError, OSError, ValueError, TypeError, KeyError):
            unavailable = True
    return records, unavailable


def inventory_item(repository, fields, records, unavailable):
    common, path = Path(repository["common"]), Path(fields["worktree"])
    repository_id = continuation_digest(str(common))
    reasons = ["preservation_not_checked"]
    try:
        admin = Path(inventory_git(path, "rev-parse", "--absolute-git-dir").strip()).resolve()
        actual_common = Path(inventory_git(path, "rev-parse", "--path-format=absolute", "--git-common-dir").strip()).resolve()
        if actual_common != common:
            fail("inventory_identity_changed")
        if admin != common and (admin.parent != common / "worktrees" or (common / "worktrees").is_symlink()):
            fail("inventory_identity_changed")
        membership = "registered"
    except TimeoutError:
        raise
    except (RuntimeError, OSError):
        admin, membership = None, "absent" if not path.exists() else "unknown"
        unavailable = True
        reasons.append("membership_unavailable")
    matches = [(value, branch) for (kind, binding), value, branch in records
               if (kind == "admin" and admin is not None and binding == str(admin))
               or (kind == "path" and binding == str(path.resolve()))]
    actual_branch = fields.get("branch", "").removeprefix("refs/heads/") or None
    if any(branch != actual_branch for _, branch in matches):
        reasons.append("branch_changed")
    status = "unavailable" if unavailable else "known" if matches else "unknown"
    if unavailable:
        reasons.append("cycle_records_unavailable")
    elif not matches:
        reasons.append("cycle_records_unknown")
    disposition = ("retained_active" if status == "known" and any(
        value["state"] in {"active", "finalizing"} for value, _ in matches) else "retained_unknown")
    observed = now()
    return {"repository_id": repository_id, "common_dir": str(common),
            "worktree_id": continuation_digest([str(common), str(admin) if admin else str(path)]),
            "path": str(path), "branch": actual_branch, "head": fields.get("HEAD"),
            "membership": membership, "cycles": {"status": status, "records": sorted(
                [value for value, _ in matches], key=lambda value: value["id"])},
            "evidence": {name: {"status": "unknown", "identity": None, "digest": None,
                                 "observed_at": observed, "reasons": ["not_checked"]}
                         for name in ("git_default", "dvc", "artifacts", "processes", "handoff", "policy")},
            "disposition": disposition, "reasons": reasons}


def inventory_policy_sources():
    """Read discovery hints only; this path never interprets action/consent switches."""
    home = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")).expanduser()
    path = home / "dotfiles-ai/workflow-policy.json"
    if not os.path.lexists(path):
        return [], [], None
    safe_directory(home, path.parent)
    continuation_private(path)
    if path.stat().st_size > 256 * 1024:
        fail("inventory_policy_invalid")
    raw = path.read_bytes()
    policy = json.loads(raw, object_pairs_hook=no_duplicate_keys)
    if (not isinstance(policy, dict) or type(policy.get("schema_version")) is not int
            or policy["schema_version"] != 1 or set(policy) - {
                "schema_version", "source_commit", "policy_digest", "root", "cache_root", "repositories", "naming"}
            or not re.fullmatch(r"[0-9a-f]{40}|[0-9a-f]{64}", policy.get("source_commit", ""))
            or policy.get("policy_digest") != continuation_digest({
                k: v for k, v in policy.items() if k != "policy_digest"})):
        fail("inventory_policy_invalid")
    def local_path(value):
        if not isinstance(value, str) or not value or any(c in value for c in ("$", "\0", "\\")):
            fail("inventory_policy_invalid")
        value = Path(value).expanduser()
        if not value.is_absolute() or ".." in value.parts or value.is_symlink():
            fail("inventory_policy_invalid")
        return str(value)
    roots = [local_path(policy.get("root", "~/Worktrees"))]
    entries = policy.get("repositories", [])
    if not isinstance(entries, list) or len(entries) > 256:
        fail("inventory_policy_invalid")
    repositories = []
    for entry in entries:
        if not isinstance(entry, dict) or set(entry) - {
                "repository", "root", "cache_root", "naming", "preservation", "delivery", "feedback"}:
            fail("inventory_policy_invalid")
        repositories.append(local_path(entry.get("repository")))
        if "root" in entry:
            roots.append(local_path(entry["root"]))
    if len(set(repositories)) != len(repositories):
        fail("inventory_policy_invalid")
    return repositories, sorted(set(roots)), hashlib.sha256(raw).hexdigest()


def metadata_worktree_list(args):
    with inventory_budget(5):
        root = Path(inventory_git(Path.cwd(), "rev-parse", "--show-toplevel").strip()).resolve()
        common = Path(inventory_git(root, "rev-parse", "--path-format=absolute", "--git-common-dir").strip()).resolve()
        report_directory = common / "dbsctr/inventory"
        safe_directory(common, report_directory, create=True)
        os.chmod(report_directory, 0o700)
        seeds = list(getattr(args, "repository", []) or [str(root)])
        if len(seeds) > 256 or any(not Path(value).is_absolute() for value in seeds):
            fail("inventory_scope_invalid")
        reasons, policy_digest = [], None
        if getattr(args, "all", False):
            # Retained roots are hints only; membership is always queried from native Git.
            roots = [str(worktree_registry_root())]
            try:
                configured, new_roots, policy_digest = inventory_policy_sources()
                seeds.extend(configured)
                roots.extend(new_roots)
            except TimeoutError:
                raise
            except (RuntimeError, OSError, ValueError, TypeError, KeyError):
                reasons.append("policy_sources_unavailable")
            try:
                for registry in sorted(set(roots)):
                    for parent in inventory_children(Path(registry), 256):
                        if parent.is_symlink() or not parent.is_dir():
                            continue
                        for child in inventory_children(parent, 1024):
                            if not child.is_symlink() and child.is_dir() and (child / ".git").exists():
                                seeds.append(str(child))
                                if len(seeds) > 10000:
                                    fail("inventory_source_limit")
            except TimeoutError:
                raise
            except (RuntimeError, OSError):
                reasons.append("root_discovery_unavailable")
        seeds = sorted(set(seeds))
        previous = None
        if cursor := getattr(args, "cursor", None):
            if not isinstance(cursor, str) or not re.fullmatch(r"[0-9a-f]{32}", cursor):
                fail("inventory_cursor_invalid")
            saved = report_directory / (cursor + ".json")
            continuation_private(saved)
            if saved.stat().st_size > 4 * 1024 * 1024:
                fail("inventory_cursor_invalid")
            previous = json.loads(saved.read_text(), object_pairs_hook=no_duplicate_keys)
            if (not isinstance(previous, dict) or type(previous.get("schema_version")) is not int
                    or previous["schema_version"] != 1 or previous.get("continuation") != cursor
                    or previous.get("seeds") != seeds):
                fail("inventory_cursor_invalid")
        source_stamps = []
        for seed in seeds:
            try:
                info = (Path(seed) / ".git").lstat()
                source_stamps.append([seed, info.st_ino, info.st_size, info.st_mtime_ns])
            except OSError:
                source_stamps.append([seed, None])
        scope = continuation_digest([source_stamps, policy_digest, sorted(set(reasons)),
                                     hashlib.sha256(Path(__file__).read_bytes()).hexdigest()])
    if previous and previous.get("scope_digest") != scope:
        fail("inventory_cursor_stale")
    position = previous["next_position"] if previous else [0, 0]
    if previous and (not isinstance(position, list) or len(position) != 2
            or any(type(n) is not int or n < 0 for n in position)
            or position[0] >= len(seeds)):
        fail("inventory_cursor_invalid")
    seen = set(previous["seen_repositories"] if previous else [])
    if len(seen) > 10000 or any(not isinstance(value, str) or not re.fullmatch(r"[0-9a-f]{64}", value) for value in seen):
        fail("inventory_cursor_invalid")
    items, observed, completed, attempts, next_position, cursor_repository = [], set(), 0, 0, None, None
    for index, seed in enumerate(seeds):
        if index < position[0]:
            continue
        if attempts == 256 or len(items) == 100:
            reasons.append("repository_limit" if attempts == 256 else "page_limit")
            next_position = [index, 0]
            break
        attempts += 1
        offset = position[1] if index == position[0] else 0
        member_index = offset
        repository = None
        try:
            with inventory_budget(5):
                repository = inventory_repository(Path(seed))
                repository_id = continuation_digest(repository["common"])
                if repository_id in seen:
                    continue
                observed.add(repository_id)
                if previous and index == position[0] and previous.get("cursor_repository") is not None:
                    if previous["cursor_repository"] != repository["digest"]:
                        fail("inventory_cursor_stale")
                if offset > len(repository["members"]):
                    fail("inventory_cursor_invalid")
                records, unavailable = inventory_cycles(repository)
                if unavailable:
                    reasons.append("cycle_records_unavailable")
                for member_index, fields in enumerate(repository["members"]):
                    if member_index < offset:
                        continue
                    if len(items) == 100:
                        next_position = [index, member_index]
                        cursor_repository = repository["digest"]
                        break
                    with inventory_budget(1):
                        item = inventory_item(repository, fields, records, unavailable)
                    items.append(item)
                    member_index += 1
                if next_position is None:
                    completed += 1
                    seen.add(repository_id)
        except (RuntimeError, OSError, TimeoutError, ValueError, TypeError, KeyError) as error:
            if isinstance(error, RuntimeError) and str(error) in {"inventory_cursor_stale", "inventory_cursor_invalid"}:
                raise
            reasons.append("repository_metadata_unavailable")
            if repository is not None:
                next_position = [index, member_index]
                cursor_repository = repository["digest"]
            elif isinstance(error, TimeoutError):
                next_position = [index, 0]
            elif previous and index == position[0] and previous.get("cursor_repository") is not None:
                fail("inventory_cursor_stale")
        if next_position is not None:
            break
    if next_position and len(items) == 100:
        reasons.append("page_limit")
    identifier = uuid.uuid4().hex
    coverage = {"status": "partial" if reasons else "complete", "reasons": sorted(set(reasons)),
                "repositories_seen": len(observed), "repositories_completed": completed,
                "items_seen": len(items)}
    if not observed:
        coverage.update(status="unavailable", repositories_seen=None, repositories_completed=None,
                        items_seen=None)
    report = {"schema_version": 1, "report_id": identifier, "observed_at": now(),
              "scope_digest": scope, "coverage": coverage, "items": items,
              "continuation": identifier if next_position else None,
              "next_position": next_position, "seeds": seeds,
              "seen_repositories": sorted(seen), "cursor_repository": cursor_repository}
    if len(json.dumps(report).encode()) > 4 * 1024 * 1024:
        fail("inventory_report_limit")
    with inventory_budget(5):
        private_json(report_directory / (identifier + ".json"), report)
    projection = {key: report[key] for key in ("schema_version", "report_id", "observed_at", "scope_digest",
                                              "coverage", "continuation")}
    projection["items"] = [{key: item[key] for key in ("repository_id", "worktree_id", "membership",
                                                       "disposition", "reasons")} for item in items]
    print(json.dumps(projection, sort_keys=True, separators=(",", ":")))


def command_worktree_list(args):
    try:
        return metadata_worktree_list(args)
    except (RuntimeError, OSError, TimeoutError, ValueError, TypeError, KeyError):
        fail("inventory_unavailable")


def command_cleanup(args):
    if getattr(args, "all", False):
        if args.cycle_id:
            fail("--all requires --completed")
        repositories, failed = global_worktree_roots()
        removed, reclaimed = [], 0
        for repository_id, root, allowed_root in repositories:
            for path in sorted((cycle_dir(root) / "cycles").glob("*.json")):
                try:
                    record = read_cycle_record(root, path)
                    if (record.get("state") != "completed"
                            or record.get("worktree", {}).get("created_by_dbsctr") is not True):
                        continue
                    cycle_id = record.get("cycle_id")
                    if cycle_id != path.stem or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", cycle_id or ""):
                        raise ValueError("cycle record identity mismatch")
                    worktree = record_worktree(root, record)
                    if not path_within(worktree, allowed_root):
                        failed.append({"cycle_id": cycle_id, "repository_id": repository_id,
                                       "error": "outside_registry"})
                        continue
                    before = worktree_bytes(worktree) or 0
                    cleanup_cycle(root, cycle_id, args.now)
                    reclaimed += before
                    removed.append({"cycle_id": cycle_id, "repository_id": repository_id})
                except (RuntimeError, OSError, json.JSONDecodeError, KeyError, TypeError, ValueError) as error:
                    failed.append({"cycle_id": path.stem, "repository_id": repository_id,
                                   "error": maintenance_error(error)})
        print(json.dumps({"failed": failed, "reclaimed_bytes": reclaimed, "removed": removed},
                         sort_keys=True, separators=(",", ":")))
        if failed:
            fail(f"global cleanup incomplete: {len(failed)} failures")
        return
    root = root_dir()
    if args.cycle_id:
        print(cleanup_cycle(root, args.cycle_id, args.now))
        return
    records = cycle_dir(root) / "cycles"
    cycle_ids, failed = [], []
    for path in sorted(records.glob("*.json")):
        try:
            record = read_cycle_record(root, path)
            if record.get("state") == "completed" and record.get("worktree", {}).get("created_by_dbsctr") is True:
                if record.get("cycle_id") != path.stem or not re.fullmatch(
                        r"[A-Za-z0-9][A-Za-z0-9._-]*", record.get("cycle_id", "")):
                    raise ValueError("cycle record identity mismatch")
                cycle_ids.append(record["cycle_id"])
        except (RuntimeError, OSError, json.JSONDecodeError, KeyError, TypeError, ValueError) as error:
            failed.append({"cycle_id": path.stem, "error": str(error)})
    removed = []
    for cycle_id in cycle_ids:
        try:
            cleanup_cycle(root, cycle_id, args.now)
            removed.append(cycle_id)
        except (RuntimeError, OSError, json.JSONDecodeError, KeyError, TypeError, ValueError) as error:
            failed.append({"cycle_id": cycle_id, "error": str(error)})
    print(json.dumps({"failed": failed, "removed": removed}, sort_keys=True, separators=(",", ":")))
    if failed:
        fail(f"cleanup incomplete: {len(failed)} of {len(cycle_ids)} completed worktrees failed")


def command_audit(args):
    root = root_dir()
    commit = inspect_git(root, "rev-parse", "--verify", f"{args.commit}^{{commit}}").stdout.strip()
    files = set(inspect_git(root, "ls-tree", "-r", "--name-only", commit).stdout.splitlines())
    contexts = {}
    for name in files:
        parts = PurePosixPath(name).parts
        if len(parts) == 4 and parts[:2] == ("docs", "specs") and parts[3] in (
            "README.md", "CHANGELOG.md"
        ):
            contexts.setdefault(parts[2], set()).add(parts[3])
    expected = {"README.md", "CHANGELOG.md"}
    findings = []
    inventory = []
    for context in sorted(contexts):
        present = contexts[context]
        missing = sorted(expected - present)
        inventory.append({"context": context, "present": sorted(present), "missing": missing})
        for artifact in missing:
            findings.append({
                "code": "missing_lifecycle_artifact", "severity": "medium", "context": context,
                "path": f"docs/specs/{context}/{artifact}",
            })
    graph_path = "graphify-out/GRAPH_REPORT.md"
    receipt_path = "graphify-out/graph.receipt.json"
    graph = {"present": graph_path in files, "built_from": None, "stale": None,
             "receipt_present": receipt_path in files, "receipt_valid": None}
    if graph["present"]:
        report = inspect_git(root, "show", f"{commit}:{graph_path}").stdout
        match = re.search(r"Built from commit:\s*`([0-9a-f]+)`", report)
        object_format = inspect_git(root, "rev-parse", "--show-object-format").stdout.strip()
        expected_length = 64 if object_format == "sha256" else 40
        if match and len(match.group(1)) == expected_length:
            graph["built_from"] = match.group(1)
            resolved = inspect_git(root, "rev-parse", "--verify", f"{graph['built_from']}^{{commit}}", check=False)
            if resolved.returncode:
                findings.append({
                    "code": "unverified_graph_freshness", "severity": "medium", "path": graph_path,
                    "built_from": graph["built_from"],
                })
            else:
                graph["built_from"] = resolved.stdout.strip()
                authorized = graph["built_from"] == commit
                if not authorized and inspect_git(
                        root, "merge-base", "--is-ancestor", graph["built_from"], commit,
                        check=False).returncode == 0:
                    authorized = True
                    for descendant in inspect_git(
                            root, "rev-list", "--first-parent", "--reverse", f"{graph['built_from']}..{commit}"
                    ).stdout.splitlines():
                        parents = inspect_git(root, "show", "-s", "--format=%P", descendant).stdout.split()
                        if len(parents) > 1:
                            authorized = (inspect_git(root, "rev-parse", f"{descendant}^{{tree}}").stdout
                                          == inspect_git(root, "rev-parse", f"{parents[0]}^{{tree}}").stdout)
                        else:
                            changed = inspect_git(
                                root, "diff-tree", "--no-commit-id", "--name-only", "-r", descendant
                            ).stdout.splitlines()
                            authorized = bool(changed) and all(name.startswith("graphify-out/") for name in changed)
                        if not authorized:
                            break
                graph["stale"] = not authorized
                if graph["stale"]:
                    findings.append({
                        "code": "stale_graph", "severity": "low", "path": graph_path,
                        "built_from": graph["built_from"], "audited_commit": commit,
                    })
        else:
            findings.append({
                "code": "unverified_graph_freshness", "severity": "medium", "path": graph_path,
            })
        if graph["receipt_present"]:
            try:
                receipt = json.loads(inspect_git_bytes(root, "show", f"{commit}:{receipt_path}"),
                                     object_pairs_hook=no_duplicate_keys)
                expected_receipt_keys = {
                    "schema_version", "command_contract", "batch_id", "source_head", "adapter",
                    "output_files", "output_sha256", "manifest_sha256", "created_at",
                }
                manifest = inspect_git_bytes(root, "show", f"{commit}:graphify-out/manifest.json")
                output = receipt["output_sha256"]
                output_files = sorted(name.removeprefix("graphify-out/") for name in files
                                      if name.startswith("graphify-out/") and name != receipt_path)
                adapter = receipt.get("adapter")
                adapter_path = adapter.get("adapter") if isinstance(adapter, dict) else None
                adapter_entry = (inspect_git(
                    root, "ls-tree", receipt.get("source_head", ""), "--", adapter_path,
                    check=False).stdout.strip().split() if isinstance(adapter_path, str) else [])
                legacy_adapter = (isinstance(adapter, dict)
                                  and set(adapter) == {"adapter", "version", "blob"}
                                  and len(adapter_entry) >= 4
                                  and adapter_entry[:2] == ["100755", "blob"]
                                  and adapter_entry[2] == adapter["blob"])
                managed_adapter = (isinstance(adapter, dict)
                                   and set(adapter) == {
                                       "version", "adapter_contract", "adapter_sha256"}
                                   and adapter.get("adapter_contract") == "dbsctr-project-graphify-v1"
                                   and re.fullmatch(r"[0-9a-f]{64}", adapter.get("adapter_sha256", ""))
                                   and isinstance(adapter.get("version"), str)
                                   and re.fullmatch(
                                       r"[A-Za-z0-9][A-Za-z0-9._+-]{0,63}", adapter["version"]))
                valid = (set(receipt) == expected_receipt_keys
                         and receipt.get("schema_version") == 1
                         and receipt.get("command_contract") == "dbsctr-batch-graphify-v1"
                         and receipt.get("source_head") == graph["built_from"]
                         and isinstance(receipt.get("batch_id"), str)
                         and re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9-]{0,63}", receipt["batch_id"])
                         and isinstance(receipt.get("created_at"), str) and receipt["created_at"]
                         and (legacy_adapter or managed_adapter)
                         and receipt.get("manifest_sha256") == hashlib.sha256(manifest).hexdigest()
                         and receipt.get("output_files") == output_files
                         and {"GRAPH_REPORT.md", "manifest.json"} <= set(output_files)
                         and isinstance(output, dict) and sorted(output) == output_files
                         and all(re.fullmatch(r"[0-9a-f]{64}", digest or "")
                                 and hashlib.sha256(inspect_git_bytes(
                                     root, "show", f"{commit}:graphify-out/{name}"
                                 )).hexdigest() == digest for name, digest in output.items()))
            except (KeyError, json.JSONDecodeError, RuntimeError, TypeError, UnicodeDecodeError):
                valid = False
            graph["receipt_valid"] = valid
            if not valid:
                findings.append({"code": "invalid_graph_receipt", "severity": "medium",
                                 "path": receipt_path})
        else:
            findings.append({"code": "missing_graph_receipt", "severity": "medium",
                             "path": receipt_path})
    result = {
        "mode": "lifecycle_reconciliation_audit", "commit": commit,
        "dirty_overlay_excluded": status_paths(root, read_only=True), "contexts": inventory,
        "graph": graph, "findings": findings,
    }
    if args.json:
        print(json.dumps(result, sort_keys=True, separators=(",", ":")))
    else:
        print(f"{commit} contexts={len(inventory)} findings={len(findings)}")
        for finding in findings:
            print(f"{finding['severity']} {finding['code']} {finding['path']}")


def backlog_cells(line):
    stripped = line.strip()
    if not stripped.startswith("|") or not stripped.endswith("|"):
        return None
    return tuple(cell.strip() for cell in stripped[1:-1].split("|"))


def backlog_section(lines, section, path, context):
    heading = f"## {section.title()}"
    findings = []
    try:
        heading_index = lines.index(heading)
    except ValueError:
        return [{"code": "invalid_backlog_schema", "severity": "medium", "context": context,
                 "path": path, "section": section, "line": 1}], []
    end = next((index for index in range(heading_index + 1, len(lines))
                if lines[index].startswith("## ")), len(lines))
    content = [index for index in range(heading_index + 1, end) if lines[index].strip()]
    if not content:
        return [{"code": "invalid_backlog_schema", "severity": "medium", "context": context,
                 "path": path, "section": section, "line": heading_index + 1}], []
    header_index = content[0]
    if backlog_cells(lines[header_index]) != BACKLOG_COLUMNS[section]:
        return [{"code": "invalid_backlog_schema", "severity": "medium", "context": context,
                 "path": path, "section": section, "line": header_index + 1}], []
    if len(content) < 2:
        return [{"code": "invalid_backlog_schema", "severity": "medium", "context": context,
                 "path": path, "section": section, "line": header_index + 1}], []
    separator_index = content[1]
    separator = backlog_cells(lines[separator_index])
    if (separator is None or len(separator) != len(BACKLOG_COLUMNS[section])
            or any(not re.fullmatch(r":?-{3,}:?", cell) for cell in separator)):
        return [{"code": "invalid_backlog_schema", "severity": "medium", "context": context,
                 "path": path, "section": section, "line": separator_index + 1}], []
    rows = []
    for index in content[2:]:
        cells = backlog_cells(lines[index])
        if cells is None or len(cells) != len(BACKLOG_COLUMNS[section]) or not cells[0]:
            finding = {
                "code": "invalid_backlog_schema", "severity": "medium", "context": context,
                "path": path, "section": section, "line": index + 1,
            }
            if cells and cells[0]:
                finding["item_id"] = cells[0]
                rows.append((index + 1, cells[0], None))
            findings.append(finding)
            continue
        rows.append((index + 1, cells[0], dict(zip(BACKLOG_COLUMNS[section], cells))))
    return findings, rows


def backlog_commit_reachable(root, audited_commit, evidence):
    for candidate in BACKLOG_COMMIT.findall(evidence):
        resolved = inspect_git(root, "rev-parse", "--verify", f"{candidate}^{{commit}}", check=False)
        if (not resolved.returncode
                and not inspect_git(root, "merge-base", "--is-ancestor", resolved.stdout.strip(),
                                    audited_commit, check=False).returncode):
            return True
    return False


def backlog_findings(root, commit, context, path, text):
    lines = text.splitlines()
    findings, rows = [], []
    for section in ("active", "completed"):
        section_findings, section_rows = backlog_section(lines, section, path, context)
        findings.extend(section_findings)
        rows.extend((section, *row) for row in section_rows)
    identifiers = {}
    for section, line, item_id, values in rows:
        identifiers.setdefault(item_id, []).append((section, line, item_id, values))
        if values is None:
            continue
        common = {"severity": "medium", "context": context, "path": path,
                  "section": section, "line": line, "item_id": item_id}
        if section == "active" and values["status"] not in BACKLOG_ACTIVE_STATUSES:
            findings.append({"code": "invalid_active_status", **common})
        if section == "completed":
            try:
                if not re.fullmatch(r"\d{4}-\d{2}-\d{2}", values["completed"]):
                    raise ValueError
                datetime.strptime(values["completed"], "%Y-%m-%d")
            except ValueError:
                findings.append({"code": "invalid_completed_date", **common})
            if not backlog_commit_reachable(root, commit, values["commit"]):
                findings.append({"code": "invalid_completed_commit", **common})
    for duplicates in identifiers.values():
        if len(duplicates) > 1:
            for section, line, item_id, _ in duplicates:
                findings.append({
                    "code": "duplicate_backlog_id", "severity": "medium", "context": context,
                    "path": path, "section": section, "line": line, "item_id": item_id,
                })
    rank = {"active": 0, "completed": 1, "document": 2}
    return sorted(findings, key=lambda item: (
        item["line"], item["code"], rank[item["section"]], item.get("item_id", "")))


def inspect_path(path, required=False):
    if path is None:
        if required:
            fail("--path is required for this inspect action")
        return None
    try:
        encoded = os.fsencode(path)
    except UnicodeEncodeError:
        fail("unsafe path")
    pure = PurePosixPath(path)
    if (not path or len(encoded) > 4096 or b"\0" in encoded or any(byte < 32 or byte == 127 for byte in encoded)
            or pure.is_absolute() or ".." in pure.parts or path.startswith("./")):
        fail("unsafe path")
    return path.rstrip("/")


def inspect_limit(value, default, hard, name):
    value = default if value is None else value
    if value < 1 or value > hard:
        fail(f"{name} must be between 1 and {hard}")
    return value


def inspect_object(root, commit, path):
    spec = commit if path is None else f"{commit}:{path}"
    kind = inspect_git(root, "cat-file", "-t", "--", spec, check=False)
    if kind.returncode or kind.stdout.strip() not in ("blob", "tree", "commit"):
        fail("path does not name a supported Git object at commit")
    object_id = inspect_git(root, "rev-parse", "--verify", "--end-of-options", spec).stdout.strip()
    return kind.stdout.strip(), object_id, spec


def inspect_blob_size(root, spec, strict=True):
    size = int(inspect_git(root, "cat-file", "-s", "--", spec).stdout)
    if size > 4 * 1024 * 1024:
        if strict:
            fail("blob exceeds 4194304 byte hard cap")
        return None
    return size


def inspect_text(root, spec, size):
    if size > 4 * 1024 * 1024:
        fail("blob exceeds 4194304 byte hard cap")
    data = subprocess.run(
        ["git", "cat-file", "blob", "--", spec], cwd=root, capture_output=True,
        env=INSPECT_ENV,
    )
    if data.returncode:
        fail(data.stderr.decode(errors="replace").strip() or "cannot read Git blob")
    return data.stdout


def inspect_emit(result):
    encoded = json.dumps(result, sort_keys=True, separators=(",", ":"), ensure_ascii=True).encode("utf-8")
    if len(encoded) > INSPECT_RESPONSE_HARD:
        fail("inspect response exceeds 131072 bytes")
    print(encoded.decode("utf-8"))


def inspect_page(result, key, items, cursor, limit):
    selected = items[cursor:cursor + limit]
    while selected:
        next_cursor = cursor + len(selected)
        result.update({key: selected, "truncated": next_cursor < len(items),
                       "continuation": {"cursor": next_cursor} if next_cursor < len(items) else None})
        if len(json.dumps(result, sort_keys=True, separators=(",", ":"), ensure_ascii=True).encode("utf-8")) <= INSPECT_RESPONSE_HARD:
            return
        selected.pop()
    result.update({key: [], "truncated": cursor < len(items),
                   "continuation": {"cursor": cursor} if cursor < len(items) else None})


def inspect_tree_rows(root, *args):
    with tempfile.TemporaryFile() as stderr:
        process = subprocess.Popen(["git", "ls-tree", "-z", *args], cwd=root, stdout=subprocess.PIPE,
                                   stderr=stderr, env=INSPECT_ENV)
        buffer = b""
        complete = False
        try:
            while block := process.stdout.read(4096):
                buffer += block
                while b"\0" in buffer:
                    row, buffer = buffer.split(b"\0", 1)
                    if row:
                        metadata, name = row.split(b"\t", 1)
                        yield metadata.decode("ascii").split(), os.fsdecode(name)
            complete = True
        finally:
            if not complete and process.poll() is None:
                process.terminate()
            process.wait()
            if complete and process.returncode:
                stderr.seek(0)
                fail(stderr.read(8192).decode(errors="replace").strip() or "cannot list Git tree")


def inspect_overlay(root):
    with tempfile.TemporaryFile() as stderr:
        process = subprocess.Popen(
            ["git", "status", "--porcelain=v1", "-z", "--untracked-files=all"], cwd=root,
            stdout=subprocess.PIPE, stderr=stderr, env=INSPECT_ENV,
        )
        paths, total, retained_bytes, rename = [], 0, 0, False

        def record_path(raw_path):
            nonlocal total, retained_bytes
            path = os.fsdecode(raw_path)
            total += 1
            size = len(json.dumps(path, ensure_ascii=True).encode("utf-8")) + 1
            if len(paths) < 100 and retained_bytes + size <= 64 * 1024:
                paths.append(path)
                retained_bytes += size

        buffer = b""
        while block := process.stdout.read(4096):
            buffer += block
            while b"\0" in buffer:
                record, buffer = buffer.split(b"\0", 1)
                if not record:
                    continue
                if rename:
                    record_path(record)
                    rename = False
                else:
                    status, raw_path = record[:2], record[3:]
                    rename = status[:1] in b"RC" or status[1:2] in b"RC"
                    record_path(raw_path)
        process.wait()
        if process.returncode:
            stderr.seek(0)
            fail(stderr.read(8192).decode(errors="replace").strip() or "cannot inspect dirty overlay")
    return paths, total, total > len(paths)


def inspect_utf8_page(data, offset, limit):
    try:
        data.decode("utf-8")
    except UnicodeDecodeError:
        return None, len(data)
    try:
        data[:offset].decode("utf-8")
    except UnicodeDecodeError:
        fail("offset is not a UTF-8 boundary")
    end = min(offset + limit, len(data))
    while end > offset:
        try:
            return data[offset:end].decode("utf-8"), end
        except UnicodeDecodeError as error:
            if error.reason != "unexpected end of data":
                fail("offset is not a UTF-8 boundary")
            end -= 1
    if offset < len(data):
        fail("limit does not reach a UTF-8 boundary")
    return "", end


def inspect_excerpt(line, limit):
    encoded = line.encode("utf-8")
    end = min(limit, len(encoded))
    while end:
        try:
            return encoded[:end].decode("utf-8"), len(encoded) > end
        except UnicodeDecodeError:
            end -= 1
    return "", bool(encoded)


def inspect_arguments(args):
    allowed = {
        "read": {"path", "limit", "offset"}, "tree": {"path", "limit", "cursor"},
        "search": {"path", "query", "limit", "cursor", "excerpt"}, "object": {"path"},
    }[args.action]
    for name in ("path", "query", "limit", "offset", "cursor", "excerpt"):
        if getattr(args, name) is not None and name not in allowed:
            fail(f"--{name} is not valid for inspect {args.action}")


def command_inspect(args):
    root = root_dir()
    inspect_arguments(args)
    commit = inspect_git(root, "rev-parse", "--verify", "--end-of-options", f"{args.commit}^{{commit}}", check=False)
    if commit.returncode:
        fail("--commit must resolve to a commit")
    commit = commit.stdout.strip()
    if args.cursor is not None and args.cursor < 0:
        fail("cursor must be non-negative")
    path = inspect_path(args.path, args.action == "read")
    overlay, overlay_total, overlay_truncated = inspect_overlay(root)
    result = {"action": args.action, "commit": commit, "dirty_overlay_excluded": overlay,
              "dirty_overlay_total": overlay_total, "dirty_overlay_truncated": overlay_truncated}
    if args.action == "object":
        kind, object_id, _ = inspect_object(root, commit, path)
        result.update({"path": path, "object": object_id, "type": kind,
                       "size": int(inspect_git(root, "cat-file", "-s", "--", object_id).stdout)})
    elif args.action == "read":
        kind, object_id, spec = inspect_object(root, commit, path)
        if kind != "blob":
            fail("read requires a blob path")
        size = inspect_blob_size(root, spec)
        data = inspect_text(root, spec, size)
        limit = inspect_limit(args.limit, 32768, 65536, "read limit")
        offset = args.offset or 0
        if offset < 0 or offset > len(data):
            fail("offset is outside blob")
        content, end = inspect_utf8_page(data, offset, limit)
        binary = b"\0" in data or content is None
        result.update({"path": path, "object": object_id, "binary": binary, "size": size,
                       "truncated": False if binary else end < len(data),
                       "continuation": {"offset": end} if not binary and end < len(data) else None})
        if not binary:
            result["content"] = content
    elif args.action == "tree":
        if path is None:
            object_id = inspect_git(root, "rev-parse", "--verify", "--end-of-options", f"{commit}^{{tree}}").stdout.strip()
            rows = inspect_tree_rows(root, commit)
        else:
            kind, object_id, spec = inspect_object(root, commit, path)
            if kind != "tree":
                fail("tree requires a tree path")
            rows = inspect_tree_rows(root, spec)
        limit = inspect_limit(args.limit, 50, 100, "tree limit")
        cursor = args.cursor or 0
        entries = []
        try:
            for metadata, name in rows:
                if len(entries) <= cursor + limit:
                    mode, entry_kind, entry_object = metadata
                    entries.append({"path": f"{path}/{name}" if path else name, "mode": mode,
                                    "object": entry_object, "type": entry_kind})
                else:
                    break
        finally:
            rows.close()
        if cursor > len(entries) or (cursor == len(entries) and entries):
            fail("cursor is outside available entries")
        result.update({"path": path, "object": object_id})
        inspect_page(result, "entries", entries, cursor, limit)
    else:
        if not args.query:
            fail("--query is required for search")
        if len(os.fsencode(args.query)) > 256 or any(ord(char) < 32 or ord(char) == 127 for char in args.query):
            fail("unsafe query")
        limit = inspect_limit(args.limit, 25, 100, "search limit")
        excerpt = inspect_limit(args.excerpt, 1024, 2048, "excerpt limit")
        cursor = args.cursor or 0
        matches = []
        if path is None:
            rows = inspect_tree_rows(root, "-r", commit)
            scope_is_tree = False
        else:
            kind, scoped_object, spec = inspect_object(root, commit, path)
            if kind == "blob":
                rows = iter([(["100644", "blob", scoped_object], path)])
                scope_is_tree = False
            elif kind == "tree":
                rows = inspect_tree_rows(root, "-r", spec)
                scope_is_tree = True
            else:
                fail("search path must be a blob or tree")
        try:
            for (_, kind, object_id), name in rows:
                if kind != "blob" or len(matches) > cursor + limit:
                    if len(matches) > cursor + limit:
                        break
                    continue
                size = inspect_blob_size(root, object_id, strict=False)
                if size is None:
                    continue
                data = inspect_text(root, object_id, size)
                if b"\0" in data:
                    continue
                try:
                    text = data.decode("utf-8")
                except UnicodeDecodeError:
                    continue
                for number, line in enumerate(text.splitlines(), 1):
                    if args.query in line:
                        excerpt_text, excerpt_truncated = inspect_excerpt(line, excerpt)
                        matches.append({"path": f"{path}/{name}" if path and scope_is_tree else name,
                                        "line": number, "object": object_id, "excerpt": excerpt_text,
                                        "excerpt_truncated": excerpt_truncated})
                        if len(matches) > cursor + limit:
                            break
        finally:
            close = getattr(rows, "close", None)
            if close:
                close()
        if cursor > len(matches) or (cursor == len(matches) and matches):
            fail("cursor is outside available matches")
        result["query"] = args.query
        inspect_page(result, "matches", matches, cursor, limit)
    inspect_emit(result)


def command_status(args):
    root = root_dir()
    active = resolved_active_path(root)
    if not active.exists() and args.json:
        print("null")
        return
    _, record = load(root)
    native = native_workspace_execution(record)
    if args.json:
        if native:
            record = {**record, "historical_runtime": record.get("runtime", {}), "runtime": {"adapters": {}}}
        if record.get("initiative_amendments"):
            entries = record["initiative_amendments"]
            record = {key: value for key, value in record.items()
                      if key not in {"initiative_amendments", "initiative_authority_checkpoints"}}
            record["initiative_amendments"] = {"schema_version": 1, "count": len(entries),
                "effective_receipt_digest": continuation_digest(entries[-1]["receipt"]),
                "latest_launch_digest": entries[-1]["launch_digest"]}
        print(json.dumps(record, sort_keys=True, separators=(",", ":")))
    else:
        suffix = " execution=native_workspace attribution=unavailable" if native else ""
        print(f"{record['cycle_id']} {record['state']} {record['risk']} {record['delivery_intent']}" + suffix)


class ContinuationError(RuntimeError):
    """A bounded continuation failure, never a private runtime error body."""


def continuation_digest(value):
    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(",", ":")).encode()).hexdigest()


def continuation_path(root):
    return cycle_dir(root) / "continuation" / "continuation.sqlite3"


def continuation_private(path, directory=False):
    details = path.lstat()
    if (details.st_uid != os.getuid() or details.st_mode & 0o077
            or stat.S_IFMT(details.st_mode) != (stat.S_IFDIR if directory else stat.S_IFREG)
            or not directory and details.st_nlink != 1):
        raise ContinuationError("invalid_state")


@contextlib.contextmanager
def continuation_connection(root, *, write=False, create=False):
    path = continuation_path(root)
    parent = path.parent
    if parent.parent.is_symlink():
        raise ContinuationError("invalid_state")
    if not os.path.lexists(parent):
        if not create:
            yield None
            return
        parent.mkdir(mode=0o700)
    continuation_private(parent, directory=True)
    for suffix in ("", "-journal", "-wal", "-shm"):
        candidate = Path(str(path) + suffix)
        if os.path.lexists(candidate):
            continuation_private(candidate)
    if not path.exists() and not create:
        raise ContinuationError("invalid_state")
    # Serialize first creation without treating a half-created database as valid.
    lock = None
    connection = None
    previous_umask = os.umask(0o077)
    deadline = time.monotonic() + 2
    try:
        if write:
            lock_path = parent / "state.lock"
            descriptor = os.open(lock_path, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
            lock = os.fdopen(descriptor, "a+")
            continuation_private(lock_path)
            while True:
                try:
                    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except BlockingIOError:
                    if time.monotonic() >= deadline:
                        raise ContinuationError("state_busy")
                    time.sleep(0.01)
        new = not path.exists()
        if new:
            if not create:
                raise ContinuationError("invalid_state")
            descriptor = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW, 0o600)
            os.close(descriptor)
        continuation_private(path)
        connection = sqlite3.connect(path.as_uri() + ("?mode=rw" if write else "?mode=ro"),
                                     uri=True, timeout=0)
        connection.row_factory = sqlite3.Row
        connection.execute("PRAGMA foreign_keys=ON")
        if new:
            connection.executescript("""
                BEGIN IMMEDIATE;
                CREATE TABLE metadata (version INTEGER PRIMARY KEY CHECK(version=1));
                INSERT INTO metadata VALUES (1);
                CREATE TABLE cycles (
                    cycle_id TEXT PRIMARY KEY, worktree_id TEXT NOT NULL, locator_id TEXT NOT NULL,
                    record_digest TEXT NOT NULL,
                    writer TEXT, generation INTEGER NOT NULL CHECK(generation>=0),
                    state TEXT NOT NULL CHECK(state IN
                      ('reader_only','owned','draining','recovery_required','closed')),
                    writer_event_id INTEGER REFERENCES activations(event_id));
                CREATE TABLE activations (
                    event_id INTEGER PRIMARY KEY AUTOINCREMENT,
                    cycle_id TEXT NOT NULL REFERENCES cycles(cycle_id), session_key TEXT,
                    native_session_id TEXT, kind TEXT NOT NULL CHECK(kind IN ('legacy','attach','transition')),
                    activation TEXT, predecessor INTEGER REFERENCES activations(event_id));
                CREATE TABLE routes (
                    session_key TEXT PRIMARY KEY, native_session_id TEXT NOT NULL,
                    cycle_id TEXT NOT NULL REFERENCES cycles(cycle_id), home_worktree_id TEXT NOT NULL,
                    event_id INTEGER REFERENCES activations(event_id));
                CREATE TABLE operations (
                    operation_id TEXT PRIMARY KEY, cycle_id TEXT NOT NULL REFERENCES cycles(cycle_id),
                    generation INTEGER NOT NULL, session_key TEXT NOT NULL,
                    message_id TEXT NOT NULL, call_id TEXT NOT NULL, operation_class TEXT NOT NULL,
                    state TEXT NOT NULL CHECK(state IN ('running','completed','uncertain')),
                    completion_class TEXT,
                    UNIQUE(cycle_id,generation,session_key,call_id));
                CREATE TABLE approvals (
                    receipt_id TEXT PRIMARY KEY, cycle_id TEXT NOT NULL REFERENCES cycles(cycle_id),
                    request_digest TEXT NOT NULL, binding TEXT NOT NULL, response TEXT NOT NULL);
                COMMIT;
            """)
        if [row[0] for row in connection.execute("SELECT version FROM metadata")] != [1]:
            raise ContinuationError("invalid_state")
        if connection.execute("PRAGMA foreign_key_check").fetchone() is not None:
            raise ContinuationError("invalid_state")
        # Admission and commit share a deadline; never replay a transaction body.
        while True:
            try:
                connection.execute("BEGIN IMMEDIATE" if write else "BEGIN")
                break
            except sqlite3.OperationalError as error:
                if "locked" not in str(error) or time.monotonic() >= deadline:
                    raise
                time.sleep(min(0.01, max(0, deadline - time.monotonic())))
        yield connection
        if write:
            connection.execute(f"PRAGMA busy_timeout={max(0, int((deadline - time.monotonic()) * 1000))}")
            connection.commit()
    except sqlite3.OperationalError as error:
        raise ContinuationError("state_busy" if "locked" in str(error) else "invalid_state") from None
    except (sqlite3.DatabaseError, OSError):
        raise ContinuationError("invalid_state") from None
    finally:
        if connection is not None:
            connection.close()
        if lock is not None:
            lock.close()
        os.umask(previous_umask)


def continuation_native(request, read_only=False):
    session = request.get("session_id")
    message = request.get("message_id")
    if not isinstance(session, str) or not OPAQUE_ID.fullmatch(session):
        raise ContinuationError("invalid_identity")
    try:
        if session_for_message(None, message, require_primary=True) != session:
            raise ContinuationError("invalid_identity")
        activation = harness_activation_for_message(None, message, json.dumps(request.get("harness_activation")))
    except (RuntimeError, TypeError):
        if not read_only:
            raise ContinuationError("invalid_identity") from None
        # Other primaries may inspect, but gain no mutation or activation authority.
        try:
            if session_for_message(None, message, require_primary=True) != session:
                raise ContinuationError("invalid_identity")
            owner = native_session_actor(None, session, message)
            if (not owner or not isinstance(owner[1], str) or not OPAQUE_ID.fullmatch(owner[1])
                    or owner[1] in {"build", "build-gpt", "build-claude"}):
                raise ContinuationError("invalid_identity")
            activation = None
        except (RuntimeError, TypeError, sqlite3.Error):
            raise ContinuationError("invalid_identity") from None
    boundary = hashlib.sha256(str(opencode_database().resolve()).encode()).hexdigest()
    return continuation_digest([boundary, session]), activation


def continuation_compatible(activation):
    if (activation["core_revision"] != "3.31" or activation["overlay_revision"] != {
            "build": "neutral-2026-07-26", "build-gpt": "openai-2026-07-26",
            "build-claude": "anthropic-2026-07-26"}.get(activation["agent_id"])):
        raise ContinuationError("revision_incompatible")


def continuation_target(request, session_key, purpose="active", *, repository_basis=None, bindings=True):
    try:
        # An internal adapter may supply repository basis independently of native home.
        home = Path(repository_basis if repository_basis is not None else request["runtime_worktree"]).resolve(strict=True)
        directory = home if repository_basis is not None else Path(request["runtime_directory"]).resolve(strict=True)
        invocation = root_dir().resolve()
        if directory != home and home not in directory.parents or repo_root(home) != home:
            raise ContinuationError("invalid_identity")
        if common_git_dir(home).resolve() != common_git_dir(invocation).resolve():
            raise ContinuationError("repository_mismatch")
        target = request.get("worktree")
        terminal = purpose in {"check", "finish", "recover"}
        route = None
        if target is None or terminal:
            with continuation_connection(home) as db:
                if db and purpose == "finish":
                    route = db.execute("SELECT c.locator_id,c.cycle_id FROM operations o JOIN cycles c USING(cycle_id) "
                                       "WHERE o.operation_id=? AND o.session_key=?",
                                       (request.get("operation_id"), session_key)).fetchone()
                elif db:
                    route = db.execute("SELECT c.locator_id,c.cycle_id FROM routes r JOIN cycles c USING(cycle_id) "
                                       "WHERE r.session_key=?", (session_key,)).fetchone()
                    if route is None and purpose == "recover" and isinstance(request.get("approval"), dict):
                        route = db.execute("SELECT c.locator_id,c.cycle_id FROM approvals a JOIN cycles c USING(cycle_id) "
                                           "WHERE a.receipt_id=? AND a.request_digest=?",
                                           (request["approval"].get("receipt_id"),
                                            continuation_digest([purpose, request]))).fetchone()
        if target is None:
            if route is None:
                raise ContinuationError("not_enrolled")
            target = worktree_for_id(home, route[0])
        target = Path(target).resolve(strict=True)
        if repo_root(target) != target:
            raise ContinuationError("invalid_target")
        if common_git_dir(target).resolve() != common_git_dir(home).resolve():
            raise ContinuationError("repository_mismatch")
        registered = {Path(line.removeprefix("worktree ")).resolve()
                      for line in git(home, "worktree", "list", "--porcelain").stdout.splitlines()
                      if line.startswith("worktree ")}
        if not {home, target} <= registered:
            raise ContinuationError("invalid_target")
        if resolved_active_path(target, bindings=bindings).exists():
            path, record = load(target, bindings=bindings)
        else:
            # Final Push removes the active pointer before the native after-hook.
            # Only an authenticated stored route/operation may resolve its terminal record.
            if not terminal or route is None or route[0] != worktree_id(target):
                raise ContinuationError("invalid_target")
            if not isinstance(route[1], str) or not OPAQUE_ID.fullmatch(route[1]):
                raise ContinuationError("invalid_target")
            path = cycle_dir(target) / "cycles" / f"{route[1]}.json"
            if path.is_symlink():
                raise ContinuationError("invalid_target")
            record = read_cycle_record(target, path)
            if record["state"] != "completed" or record["cycle_id"] != route[1]:
                raise ContinuationError("invalid_target")
        allowed = {"active"}
        if purpose not in {"active", "enroll"}:
            allowed.add("finalizing")
        if terminal:
            allowed.add("completed")
        if (record["state"] not in allowed
                or record_worktree(target, record, bindings=bindings) != target
                or not record_worktree_matches(target, record, target, bindings=bindings)):
            raise ContinuationError("invalid_target")
        return home, target, path, record
    except ContinuationError:
        raise
    except (KeyError, TypeError, ValueError, RuntimeError, OSError):
        raise ContinuationError("invalid_target") from None


def continuation_snapshot(db, record, path, session_key, activation, action, target_session=None, mode=None,
                           *, details=None):
    reject_native_continuation(record)
    cycle_id = record["cycle_id"]
    if continuation_cycle_binding(db, cycle_id):
        raise ContinuationError("revision_incompatible")
    cycle = db.execute("SELECT * FROM cycles WHERE cycle_id=?", (cycle_id,)).fetchone() if db else None
    if cycle:
        if (cycle["state"] not in {"reader_only", "owned", "draining", "recovery_required", "closed"}
                or type(cycle["generation"]) is not int or not 0 <= cycle["generation"] < 2**53
                or cycle["writer"] is not None and (not isinstance(cycle["writer"], str)
                                                     or not re.fullmatch(r"[0-9a-f]{64}", cycle["writer"]))
                or (cycle["state"] in {"owned", "draining", "recovery_required"}) != (cycle["writer"] is not None)):
            raise ContinuationError("invalid_state")
        if cycle["state"] == "closed" and record["state"] == "active":
            raise ContinuationError("invalid_target")
    pending = [dict(row) for row in db.execute(
        "SELECT * FROM operations WHERE cycle_id=? AND state!='completed' ORDER BY operation_id",
        (cycle_id,))] if db else []
    if len(pending) > 100:
        raise ContinuationError("invalid_state")
    previous = db.execute(
        "SELECT activation FROM activations WHERE cycle_id=? ORDER BY CASE "
        "WHEN session_key=? THEN 0 WHEN event_id=? THEN 1 WHEN kind='legacy' THEN 2 ELSE 3 END, "
        "event_id DESC LIMIT 1", (cycle_id, session_key, cycle["writer_event_id"] if cycle else None)
    ).fetchone() if db else None
    previous = json.loads(previous[0]) if previous and previous[0] is not None else None
    if details is not None:
        writer_activation = db.execute("SELECT activation FROM activations WHERE event_id=? AND cycle_id=?",
                                       (cycle["writer_event_id"], cycle_id)).fetchone() if db and cycle else None
        writer_activation = json.loads(writer_activation[0]) if writer_activation and writer_activation[0] else None
        legacy = record.get("runtime", {}).get("opencode", {}).get("harness_activation")
        for value in (previous, activation, writer_activation, legacy):
            if value is not None:
                validate_stored_harness_activation(value)
        details.update(previous_activation=previous, proposed_activation=activation,
                       writer_activation=writer_activation, recorded_legacy_activation=legacy,
                       writer_key=cycle["writer"] if cycle else None,
                       writer_relation=("self" if cycle["writer"] == session_key else
                                        "other" if cycle["writer"] else "none") if cycle else "none",
                       outstanding_operations=len(pending))
    changes = sorted(key for key in activation if previous and previous.get(key) != activation[key]) if activation else []
    snapshot = {"action": action, "cycle_id": cycle_id, "worktree_id": record["worktree"]["id"],
                "generation": cycle["generation"] if cycle else 0,
                "state_digest": continuation_digest([dict(cycle) if cycle else None, pending, previous]),
                "record_digest": hashlib.sha256(path.read_bytes()).hexdigest(),
                "session_key": session_key, "activation_digest": continuation_digest(activation),
                "target_session_id": target_session, "mode": (mode or "writer") if action == "attach" else None}
    return cycle, pending, changes, snapshot


def continuation_response(cycle=None, cycle_id=None, session_key=None):
    return {"schema_version": 1, "ok": True, "reason": "ok" if cycle else "not_enrolled",
            "cycle_id": cycle_id, "state": cycle["state"] if cycle else None,
            "generation": cycle["generation"] if cycle else 0,
            "writer_relation": ("self" if cycle["writer"] == session_key else
                                "other" if cycle["writer"] else "none") if cycle else "none",
            "activation_changes": [], "next_action": "none" if cycle else "enroll",
            "approval_binding": None, "operation_id": None, "event_id": None,
            "target_worktree_id": cycle["locator_id"] if cycle else None}


def continuation_approval(request, binding, native_context=None, *, consume=True):
    approval = request.get("approval")
    if (not isinstance(approval, dict) or set(approval) != {"receipt_id", "binding"}
            or not isinstance(approval["receipt_id"], str) or not OPAQUE_ID.fullmatch(approval["receipt_id"])
            or approval["binding"] != binding):
        raise ContinuationError("approval_required")
    if native_context is not None:
        native_context.verify_approval(request, binding, consume=consume)
    return approval["receipt_id"]


def continuation_runtime(root, cycle_id):
    """Project bounded native identities; never label mixed history as one model."""
    with continuation_connection(root) as db:
        if db is None or not db.execute("SELECT 1 FROM cycles WHERE cycle_id=?", (cycle_id,)).fetchone():
            return None
        activations = db.execute("SELECT DISTINCT activation FROM activations WHERE cycle_id=? LIMIT 2",
                                 (cycle_id,)).fetchall()
        single = (json.loads(activations[0][0]) if len(activations) == 1 and activations[0][0] else None)
        if single is not None:
            validate_stored_harness_activation(single)
        rows = db.execute("SELECT DISTINCT session_key,native_session_id FROM activations "
                          "WHERE cycle_id=? AND native_session_id IS NOT NULL LIMIT 101", (cycle_id,)).fetchall()
        boundary = hashlib.sha256(str(opencode_database().resolve()).encode()).hexdigest()
        sessions = [row[1] for row in rows if continuation_digest([boundary, row[1]]) == row[0]]
        # Unrepresented harnesses must never inherit the legacy OpenCode attribution,
        # even if provider/model strings happen to coincide.
        if len(sessions) != len(rows):
            single = None
        return {"session_ids": sessions if len(rows) <= 100 else [], "activation": single}


def continuation_storage_binding(target, record_path, record, session_key, activation):
    reject_native_continuation(record)
    path = continuation_path(target)
    continuation_private(path.parent, directory=True)
    continuation_private(path)
    files, total, deadline = [], 0, time.monotonic() + 5
    for suffix in ("", "-journal", "-wal", "-shm"):
        name = Path(str(path) + suffix)
        if not os.path.lexists(name):
            files.append([suffix, None])
            continue
        continuation_private(name)
        descriptor = os.open(name, os.O_RDONLY | os.O_NOFOLLOW)
        try:
            before = os.fstat(descriptor)
            total += before.st_size
            if total > 64 * 1024 * 1024:
                raise ContinuationError("capacity_unavailable")
            checksum, count = hashlib.sha256(), 0
            while chunk := os.read(descriptor, 65536):
                count += len(chunk)
                if count > before.st_size or time.monotonic() >= deadline:
                    raise ContinuationError("capacity_unavailable")
                checksum.update(chunk)
            after = os.fstat(descriptor)
            current = name.lstat()
            identity = lambda item: (item.st_dev, item.st_ino, item.st_size, item.st_mtime_ns, item.st_ctime_ns)
            if count != before.st_size or identity(before) != identity(after) or identity(before) != identity(current):
                raise ContinuationError("state_busy")
            files.append([suffix, identity(before), checksum.hexdigest()])
        finally:
            os.close(descriptor)
    return {"action": "storage-recover", "cycle_id": record["cycle_id"], "worktree_id": worktree_id(target),
            "repository_digest": continuation_digest(str(common_git_dir(target).resolve())),
            "actor_digest": session_key, "activation_digest": continuation_digest(activation),
            "record_digest": hashlib.sha256(record_path.read_bytes()).hexdigest(),
            "storage_digest": continuation_digest(files)}


def command_continuation_storage(args):
    response = {"schema_version": 1, "ok": False, "reason": "invalid_state", "binding": None, "recovered": False}
    descriptor = None
    db = None
    recover = args.command == "continuation-storage-recover"
    try:
        if args.request_json != "-":
            raise ContinuationError("invalid_state")
        raw = sys.stdin.buffer.read(65537)
        if len(raw) > 65536:
            raise ContinuationError("capacity_unavailable")
        request = json.loads(raw, object_pairs_hook=no_duplicate_keys)
        fields = {"schema_version", "worktree", "session_id", "message_id", "runtime_worktree",
                  "runtime_directory", "harness_activation"}
        if (not isinstance(request, dict) or set(request) - fields - ({"approval"} if recover else set())
                or type(request.get("schema_version")) is not int or request["schema_version"] != 1
                or not isinstance(request.get("worktree"), str)):
            raise ContinuationError("invalid_state")
        session_key, activation = continuation_native(request, read_only=not recover)
        if recover:
            continuation_compatible(activation)
        # Physical journal recovery cannot depend on opening the damaged logical store.
        # Exact explicit Git/record custody remains required; this grants no writer.
        _, target, record_path, record = continuation_target(request, session_key, bindings=False)
        path = continuation_path(target)
        continuation_private(path.parent, directory=True)
        lock_path = path.parent / "state.lock"
        continuation_private(lock_path)
        descriptor = os.open(lock_path, os.O_RDONLY | os.O_NOFOLLOW)
        deadline = time.monotonic() + 2
        while True:
            try:
                fcntl.flock(descriptor, (fcntl.LOCK_EX if recover else fcntl.LOCK_SH) | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise ContinuationError("state_busy")
                time.sleep(0.01)
        binding = continuation_storage_binding(target, record_path, record, session_key, activation)
        response.update(ok=True, reason="ok", binding=binding)
        if recover:
            approval = request.get("approval")
            if (not isinstance(approval, dict) or set(approval) != {"receipt_id", "binding"}
                    or not isinstance(approval["receipt_id"], str) or not OPAQUE_ID.fullmatch(approval["receipt_id"])):
                raise ContinuationError("approval_required")
            request_digest = continuation_digest(request)
            receipts = path.parent / "storage-recoveries"
            if os.path.lexists(receipts):
                continuation_private(receipts, directory=True)
            receipt = receipts / f'{approval["receipt_id"]}.json'
            if os.path.lexists(receipt):
                continuation_private(receipt)
                if receipt.stat().st_size > 8192:
                    raise ContinuationError("invalid_state")
                previous = json.loads(receipt.read_text(), object_pairs_hook=no_duplicate_keys)
                if (not isinstance(previous, dict) or set(previous) != {
                        "schema_version", "state", "request_digest", "binding", "response"}
                        or previous["schema_version"] != 1 or previous["state"] not in {"prepared", "completed"}
                        or previous["binding"] != approval["binding"]):
                    raise ContinuationError("invalid_state")
                if previous["request_digest"] != request_digest:
                    raise ContinuationError("approval_required")
                if previous.get("state") == "completed":
                    saved = previous["response"]
                    if (not isinstance(saved, dict) or set(saved) != set(response)
                            or saved["schema_version"] != 1 or saved["ok"] is not True
                            or saved["recovered"] is not True or saved["reason"] != "ok"
                            or saved["binding"] != previous["binding"]):
                        raise ContinuationError("invalid_state")
                    print(json.dumps(previous["response"], sort_keys=True, separators=(",", ":")))
                    return
            continuation_approval(request, binding)
            receipts.mkdir(mode=0o700, exist_ok=True)
            marker = {"schema_version": 1, "state": "prepared", "request_digest": request_digest,
                      "binding": binding, "response": None}
            private_json(receipt, marker)
            # Explicit consent authorizes only SQLite's physical recovery, not row edits.
            db = sqlite3.connect(path.as_uri() + "?mode=rw", uri=True, timeout=0)
            deadline = time.monotonic() + 3
            db.set_progress_handler(lambda: int(time.monotonic() >= deadline), 1000)
            db.execute("PRAGMA foreign_keys=ON")
            if ([row[0] for row in db.execute("SELECT version FROM metadata")] != [1]
                    or db.execute("PRAGMA integrity_check(1)").fetchone() != ("ok",)
                    or db.execute("PRAGMA foreign_key_check").fetchone() is not None):
                raise ContinuationError("recovery_incomplete")
            db.close()
            db = None
            response["recovered"] = True
            marker.update(state="completed", response=response)
            private_json(receipt, marker)
        print(json.dumps(response, sort_keys=True, separators=(",", ":")))
    except (RuntimeError, OSError, ValueError, TypeError, KeyError, sqlite3.Error) as error:
        reason = str(error) if isinstance(error, ContinuationError) else "invalid_state"
        if isinstance(error, sqlite3.OperationalError) and "locked" in str(error):
            reason = "state_busy"
        if reason not in {"invalid_identity", "invalid_target", "invalid_state", "state_busy", "approval_required",
                          "capacity_unavailable", "recovery_incomplete"}:
            reason = "invalid_state"
        response.update(ok=False, reason=reason, recovered=False)
        print(json.dumps(response, sort_keys=True, separators=(",", ":")))
        raise SystemExit(1)
    finally:
        if db is not None:
            db.close()
        if descriptor is not None:
            os.close(descriptor)


def native_v2_finish(native, request, operation):
    session, _, actor, _, _ = native_v2_message(native, operation["message_id"], assistant=True, primary=True)
    if session != request["session_id"] or actor not in {"build", "build-gpt", "build-claude"}:
        raise ContinuationError("invalid_identity")
    if native.execute("SELECT json_type(data,'$.content') FROM session_message WHERE id=?",
                      (operation["message_id"],)).fetchone() != ("array",):
        raise ContinuationError("invalid_state")
    rows = native.execute(
        "SELECT json_extract(j.value,'$.id'),json_extract(j.value,'$.name'),"
        "json_extract(j.value,'$.state.status'),json_extract(j.value,'$.time.created'),"
        "json_extract(j.value,'$.time.completed'),json_type(j.value,'$.time.created'),"
        "json_type(j.value,'$.time.completed'),json_extract(j.value,'$.state.metadata.status') "
        "FROM session_message m,json_each(m.data,'$.content') j WHERE m.id=? "
        "AND json_extract(j.value,'$.type')='tool' LIMIT 101", (operation["message_id"],)).fetchall()
    if len(rows) > 100:
        raise ContinuationError("invalid_state")
    matches = [row for row in rows if isinstance(row[0], str) and len(row[0]) <= 1024
               and "v2_" + hashlib.sha256(f'{operation["message_id"]}\0{row[0]}'.encode()).hexdigest()
               == operation["call_id"]]
    if len(matches) != 1:
        raise ContinuationError("invalid_identity")
    _, tool, status, start, end, start_type, end_type, shell_status = matches[0]
    if (start_type not in {"integer", "real"} or end_type not in {"integer", "real"}
            or not 0 <= start <= end < 2**53):
        raise ContinuationError("invalid_state")
    kind, outcome = operation["operation_class"], request["outcome"]
    valid_tool = (kind == "file" and tool in {"write", "edit", "patch"}
                  or kind == "shell" and tool == "shell" and shell_status == "completed"
                  or kind == "lifecycle" and isinstance(tool, str) and tool.startswith("dbsctr_"))
    if not valid_tool or status != ("error" if outcome == "native_error" else "completed"):
        raise ContinuationError("invalid_state")


def continuation_finish_outcome(request, cycle, operation, session_key, *, opencode=True):
    outcome = request.get("outcome")
    completion = "native_completion" if outcome == "completed" else "unknown_completion"
    native = None
    try:
        # Codex has its own native_context and does not use this V2 storage path.
        database = opencode_database() if opencode else None
        if database is not None and database.is_file() and outcome in {"completed", "native_error"}:
            native = sqlite3.connect(database.as_uri() + "?mode=ro", uri=True)
            if native_v2(native):
                if cycle["writer"] != session_key or outcome == "native_error" and operation["operation_class"] != "file":
                    raise ContinuationError("invalid_identity")
                native_v2_finish(native, request, operation)
                failed = outcome == "native_error" or operation["completion_class"] == "native_error"
                return "completed", "native_error" if failed else "native_completion"
    except (sqlite3.Error, RuntimeError) as error:
        if isinstance(error, ContinuationError):
            raise
        raise ContinuationError("invalid_state") from None
    finally:
        if native is not None:
            native.close()
    if outcome == "native_error":
        if operation["operation_class"] != "file" or cycle["writer"] != session_key:
            raise ContinuationError("invalid_identity")
        # An event is a hint; persisted native evidence must prove synchronous file termination.
        with sqlite3.connect(opencode_database().as_uri() + "?mode=ro", uri=True) as native:
            rows = native.execute(
                "SELECT json_extract(data,'$.tool'),json_extract(data,'$.state.status'),"
                "json_extract(data,'$.state.time.start'),json_extract(data,'$.state.time.end'),"
                "json_type(data,'$.state.time.start'),json_type(data,'$.state.time.end') "
                "FROM part WHERE session_id=? AND message_id=? "
                "AND json_extract(data,'$.type')='tool' AND json_extract(data,'$.callID')=? LIMIT 2",
                (request["session_id"], operation["message_id"], operation["call_id"])).fetchall()
        if (len(rows) != 1 or rows[0][0] not in {"apply_patch", "edit", "write"}
                or rows[0][1] != "error" or rows[0][4] not in {"integer", "real"}
                or rows[0][5] not in {"integer", "real"} or not 0 <= rows[0][2] <= rows[0][3] < 2**53):
            raise ContinuationError("invalid_state")
        outcome, completion = "completed", "native_error"
    if outcome not in {"completed", "uncertain"}:
        raise ContinuationError("invalid_state")
    return outcome, "native_error" if operation["completion_class"] == "native_error" else completion


def command_continuation(args, *, native_context=None):
    response = continuation_response()
    command = args.command.removeprefix("continuation-")
    try:
        if args.request_json != "-":
            raise ContinuationError("invalid_state")
        raw = sys.stdin.buffer.read(65537)
        if len(raw) > 65536:
            raise ContinuationError("invalid_state")
        request = json.loads(raw, object_pairs_hook=no_duplicate_keys)
        common = {"schema_version", "worktree", "session_id", "message_id", "runtime_worktree",
                  "runtime_directory", "harness_activation"}
        fields = {"check": {"action", "target_session_id", "mode"}, "enroll": {"approval"},
                  "attach": {"mode", "generation", "approval"},
                  "admit": {"generation", "call_id", "operation_class"},
                  "finish": {"operation_id", "outcome"},
                  "handover": {"generation", "target_session_id", "approval"},
                  "recover": {"generation", "approval"}}
        if (not isinstance(request, dict) or set(request) - common - fields[command]
                or type(request.get("schema_version")) is not int or request["schema_version"] != 1):
            raise ContinuationError("invalid_state")
        action = request.get("action", "check") if command == "check" else command
        if action not in fields:
            raise ContinuationError("invalid_state")
        if native_context is None:
            session_key, activation = continuation_native(request, command == "check")
            common = common_git_dir(root_dir()).resolve()
            if common_git_dir(Path(request["runtime_worktree"])).resolve() != common:
                raise ContinuationError("repository_mismatch")
            if request.get("worktree") and common_git_dir(Path(request["worktree"])).resolve() != common:
                raise ContinuationError("repository_mismatch")
            with continuation_connection(Path(request["runtime_worktree"])) as selected_db:
                selected = selected_db.execute("SELECT cycle_id FROM routes WHERE session_key=?",
                                               (session_key,)).fetchone() if selected_db else None
                explicit = request.get("worktree")
                bound = continuation_binding_for_root(Path(explicit)) if explicit else None
                if bound or (selected and not explicit and continuation_cycle_binding(selected_db, selected[0])):
                    raise ContinuationError("revision_incompatible")
            home, target, record_path, record = continuation_target(request, session_key, command)
        else:
            if set(request) & {"session_id", "message_id", "runtime_worktree", "runtime_directory", "harness_activation"}:
                raise ContinuationError("invalid_identity")
            if command == "handover" or request.get("target_session_id") is not None:
                raise ContinuationError("capability_unavailable")
            if request.get("worktree") not in (None, str(native_context.repository_basis)):
                raise ContinuationError("invalid_target")
            session_key, activation = native_context.session_key, native_context.activation
            if (not isinstance(session_key, str) or not re.fullmatch(r"[0-9a-f]{64}", session_key)
                    or not isinstance(native_context.home_id, str) or not re.fullmatch(r"[0-9a-f]{64}", native_context.home_id)):
                raise ContinuationError("invalid_identity")
            validate_stored_harness_activation(activation)
            request = {**request, "session_id": native_context.session_id, "message_id": native_context.message_id,
                       "worktree": str(native_context.repository_basis)}
            home, target, record_path, record = continuation_target(
                request, session_key, command, repository_basis=native_context.repository_basis)
            if record["cycle_id"] != native_context.cycle_id or target != native_context.repository_basis:
                raise ContinuationError("invalid_target")
        cycle_id = record["cycle_id"]
        response["cycle_id"] = cycle_id
        target_session = request.get("target_session_id")
        if target_session is not None and (not isinstance(target_session, str) or not OPAQUE_ID.fullmatch(target_session)):
            raise ContinuationError("invalid_identity")
        if command != "check":
            continuation_compatible(activation)
        if "approval" in request and (not isinstance(request["approval"], dict)
                                       or set(request["approval"]) != {"receipt_id", "binding"}):
            raise ContinuationError("approval_required")
        if command == "enroll":
            # Refused enrollment must not even create the private state directory.
            with continuation_connection(target) as db:
                _, _, _, binding = continuation_snapshot(db, record, record_path, session_key, activation, action)
                replay = db.execute("SELECT request_digest FROM approvals WHERE receipt_id=?",
                                    (request.get("approval", {}).get("receipt_id"),)).fetchone() if db else None
            if not replay:
                continuation_approval(request, binding, native_context, consume=False)
        with continuation_connection(target, write=command != "check", create=command == "enroll") as db:
            native_details = {} if native_context is not None else None
            cycle, pending, changes, binding = continuation_snapshot(
                db, record, record_path, session_key, activation, action, target_session, request.get("mode"),
                details=native_details)
            response = continuation_response(cycle, cycle_id, session_key)
            response.update(approval_binding=binding, activation_changes=changes,
                            target_worktree_id=worktree_id(target))
            if native_details is not None:
                response["approval_summary"] = native_details
            if cycle and cycle["worktree_id"] != record["worktree"]["id"]:
                raise ContinuationError("invalid_target")
            if command == "check":
                if record["state"] == "completed":
                    if not cycle or cycle["state"] == "closed":
                        raise ContinuationError("invalid_target")
                    response["next_action"] = "confirm_quiescence"
                    if action != "recover":
                        raise ContinuationError("recovery_required")
                elif activation is None:
                    response["next_action"] = "switch_to_build"
                elif cycle and cycle["state"] == "recovery_required":
                    response["next_action"] = "confirm_quiescence"
                elif cycle and pending:
                    response["next_action"] = "wait_for_completion"
            else:
                if db is None:
                    raise ContinuationError("not_enrolled")
                approval = request.get("approval")
                if approval is not None and not isinstance(approval, dict):
                    raise ContinuationError("approval_required")
                receipt = approval.get("receipt_id") if approval else None
                replay = db.execute("SELECT request_digest,response FROM approvals WHERE receipt_id=?",
                                    (receipt,)).fetchone() if receipt else None
                request_digest = continuation_digest([command, request])
                if replay:
                    if replay["request_digest"] != request_digest:
                        raise ContinuationError("approval_required")
                    print(replay["response"])
                    return
                if command == "enroll":
                    continuation_approval(request, binding, native_context)
                    if cycle is None:
                        db.execute("INSERT INTO cycles(cycle_id,worktree_id,locator_id,record_digest,generation,state) "
                                   "VALUES (?,?,?,?,0,'reader_only')",
                                   (cycle_id, record["worktree"]["id"], worktree_id(target), binding["record_digest"]))
                        legacy = record.get("runtime", {}).get("opencode", {}).get("harness_activation")
                        if legacy is not None:
                            validate_stored_harness_activation(legacy)
                        db.execute("INSERT INTO activations(cycle_id,kind,activation) VALUES (?,'legacy',?)",
                                   (cycle_id, json.dumps(legacy, sort_keys=True) if legacy is not None else None))
                elif cycle is None:
                    raise ContinuationError("not_enrolled")
                elif command == "finish":
                    operation = db.execute("SELECT * FROM operations WHERE operation_id=?",
                                           (request.get("operation_id"),)).fetchone()
                    if (not operation or operation["cycle_id"] != cycle_id
                            or operation["session_key"] != session_key):
                        raise ContinuationError("invalid_identity")
                    if operation["generation"] != cycle["generation"]:
                        raise ContinuationError("generation_changed")
                    outcome, completion = continuation_finish_outcome(
                        request, cycle, operation, session_key, opencode=native_context is None)
                    if operation["state"] != "running" and operation["state"] != outcome:
                        raise ContinuationError("invalid_state")
                    db.execute("UPDATE operations SET state=?,completion_class=? WHERE operation_id=?",
                               (outcome, completion,
                                operation["operation_id"]))
                    if outcome == "uncertain":
                        db.execute("UPDATE cycles SET state='recovery_required' WHERE cycle_id=?", (cycle_id,))
                    elif record["state"] == "completed" and not db.execute(
                            "SELECT 1 FROM operations WHERE cycle_id=? AND state!='completed' LIMIT 1",
                            (cycle_id,)).fetchone():
                        db.execute("UPDATE cycles SET state='closed',writer=NULL WHERE cycle_id=?", (cycle_id,))
                        continuation_route_version(db, session_key, advance=True)
                        db.execute("DELETE FROM routes WHERE session_key=? AND cycle_id=?", (session_key, cycle_id))
                    response["operation_id"] = operation["operation_id"]
                else:
                    generation = request.get("generation")
                    if type(generation) is not int or generation != cycle["generation"]:
                        raise ContinuationError("generation_changed")
                    if command == "attach":
                        mode = request.get("mode")
                        if mode not in {"reader", "writer"}:
                            raise ContinuationError("invalid_state")
                        if "provider_id" in changes:
                            if not approval:
                                raise ContinuationError("provider_confirmation_required")
                            continuation_approval(request, binding, native_context)
                        elif approval:
                            continuation_approval(request, binding, native_context)
                        if mode == "writer":
                            if cycle["state"] in {"recovery_required", "draining"}:
                                raise ContinuationError("recovery_required")
                            if cycle["writer"] not in (None, session_key):
                                raise ContinuationError("writer_occupied")
                            if cycle["writer"] is None:
                                if pending:
                                    raise ContinuationError("operation_in_flight")
                                db.execute("UPDATE cycles SET writer=?,generation=generation+1,state='owned' "
                                           "WHERE cycle_id=?", (session_key, cycle_id))
                        route = db.execute("SELECT * FROM routes WHERE session_key=?", (session_key,)).fetchone()
                        previous = db.execute("SELECT * FROM activations WHERE event_id=?",
                                              (route["event_id"],)).fetchone() if route else None
                        serialized = json.dumps(activation, sort_keys=True)
                        if previous and previous["cycle_id"] == cycle_id and previous["activation"] == serialized:
                            event = previous["event_id"]
                        else:
                            cursor = db.execute("INSERT INTO activations(cycle_id,session_key,native_session_id,"
                                                "kind,activation,predecessor) VALUES (?,?,?,?,?,?)", (
                                cycle_id, session_key, request["session_id"], "transition" if previous else "attach",
                                serialized, previous["event_id"] if previous and previous["cycle_id"] == cycle_id else None))
                            event = cursor.lastrowid
                        db.execute("INSERT INTO routes VALUES (?,?,?,?,?) ON CONFLICT(session_key) DO UPDATE SET "
                                   "cycle_id=excluded.cycle_id,home_worktree_id=excluded.home_worktree_id,"
                                   "event_id=excluded.event_id", (
                                       session_key, request["session_id"], cycle_id,
                                       native_context.home_id if native_context is not None else worktree_id(home), event))
                        response["event_id"] = event
                        continuation_route_version(db, session_key, advance=True)
                        if mode == "writer":
                            db.execute("UPDATE cycles SET writer_event_id=? WHERE cycle_id=?", (event, cycle_id))
                    elif command == "admit":
                        if cycle["state"] == "recovery_required":
                            raise ContinuationError("recovery_required")
                        if cycle["state"] == "draining":
                            raise ContinuationError("operation_in_flight")
                        if cycle["state"] != "owned" or cycle["writer"] != session_key:
                            raise ContinuationError("writer_occupied")
                        call = request.get("call_id")
                        kind = request.get("operation_class")
                        if (not isinstance(call, str) or not OPAQUE_ID.fullmatch(call)
                                or kind not in {"file", "shell", "lifecycle", "mcp"}):
                            raise ContinuationError("invalid_state")
                        route = db.execute("SELECT a.activation FROM routes r JOIN activations a USING(event_id) "
                                           "WHERE r.session_key=? AND r.cycle_id=?", (session_key, cycle_id)).fetchone()
                        if not route or json.loads(route[0]) != activation:
                            raise ContinuationError("invalid_identity")
                        operation = db.execute("SELECT * FROM operations WHERE cycle_id=? AND generation=? "
                                               "AND session_key=? AND call_id=?", (
                                                   cycle_id, generation, session_key, call)).fetchone()
                        if operation:
                            if operation["state"] != "running" or operation["operation_class"] != kind:
                                raise ContinuationError("invalid_state")
                            operation_id = operation["operation_id"]
                        else:
                            if len(pending) >= 100:
                                raise ContinuationError("operation_in_flight")
                            operation_id = uuid.uuid4().hex
                            db.execute("INSERT INTO operations VALUES (?,?,?,?,?,?,?,'running',NULL)", (
                                operation_id, cycle_id, generation, session_key, request["message_id"], call, kind))
                        response["operation_id"] = operation_id
                    elif command == "handover":
                        continuation_approval(request, binding, native_context)
                        if not target_session or cycle["writer"] != session_key:
                            raise ContinuationError("invalid_identity")
                        owner = native_session_actor(None, target_session)
                        if not owner or owner[0] is not None or owner[1] not in {"build", "build-gpt", "build-claude"}:
                            raise ContinuationError("invalid_identity")
                        if cycle["state"] == "recovery_required":
                            raise ContinuationError("recovery_required")
                        if pending:
                            db.execute("UPDATE cycles SET state='draining' WHERE cycle_id=?", (cycle_id,))
                        else:
                            boundary = hashlib.sha256(str(opencode_database().resolve()).encode()).hexdigest()
                            new_owner = continuation_digest([boundary, target_session])
                            db.execute("UPDATE cycles SET writer=?,generation=generation+1,state='owned' "
                                       "WHERE cycle_id=?", (new_owner, cycle_id))
                    elif command == "recover":
                        continuation_approval(request, binding, native_context)
                        if cycle["state"] not in {"owned", "draining", "recovery_required"}:
                            raise ContinuationError("invalid_state")
                        db.execute("UPDATE operations SET state='completed',completion_class='operator_quiescence' "
                                   "WHERE cycle_id=? AND state!='completed'", (cycle_id,))
                        state = "closed" if record["state"] == "completed" else "reader_only"
                        db.execute("UPDATE cycles SET writer=NULL,generation=generation+1,state=? "
                                   "WHERE cycle_id=?", (state, cycle_id))
                        if state == "closed":
                            for selected in db.execute("SELECT session_key FROM routes WHERE cycle_id=?", (cycle_id,)).fetchall():
                                continuation_route_version(db, selected[0], advance=True)
                            db.execute("DELETE FROM routes WHERE cycle_id=?", (cycle_id,))
                current = db.execute("SELECT * FROM cycles WHERE cycle_id=?", (cycle_id,)).fetchone()
                updated = continuation_response(current, cycle_id, session_key)
                response.update({key: updated[key] for key in (
                    "ok", "reason", "state", "generation", "writer_relation", "next_action")})
                if receipt:
                    db.execute("INSERT INTO approvals VALUES (?,?,?,?,?)", (
                        receipt, cycle_id, request_digest, json.dumps(binding, sort_keys=True),
                        json.dumps(response, sort_keys=True, separators=(",", ":"))))
        print(json.dumps(response, sort_keys=True, separators=(",", ":")))
    except (ContinuationError, RuntimeError, OSError, ValueError, TypeError, KeyError, sqlite3.Error) as error:
        reason = str(error) if isinstance(error, ContinuationError) else "invalid_state"
        if command == "check" and reason == "not_enrolled":
            response.update(ok=True, reason=reason, next_action="select_target")
            print(json.dumps(response, sort_keys=True, separators=(",", ":")))
            return
        response.update(ok=False, reason=reason, operation_id=None, event_id=None)
        if reason in {"invalid_target", "invalid_identity", "repository_mismatch", "registry_mismatch", "invalid_state"}:
            response.update(next_action="none", approval_binding=None)
        print(json.dumps(response, sort_keys=True, separators=(",", ":")))
        raise SystemExit(1)


CONTINUATION_V2_TABLES = {
    "worktree_bindings": (
        "binding_id TEXT PRIMARY KEY,git_dir_relative TEXT NOT NULL UNIQUE,common_dev INTEGER NOT NULL,"
        "common_ino INTEGER NOT NULL,admin_dev INTEGER NOT NULL,admin_ino INTEGER NOT NULL,"
        "locator TEXT NOT NULL,registration_digest TEXT NOT NULL"),
    "cycle_bindings": (
        "cycle_id TEXT PRIMARY KEY REFERENCES cycles(cycle_id),"
        "binding_id TEXT NOT NULL REFERENCES worktree_bindings(binding_id),"
        "legacy_worktree_id TEXT NOT NULL,record_identity_digest TEXT NOT NULL,"
        "protocol INTEGER NOT NULL CHECK(protocol=2)"),
    "route_versions": "session_key TEXT PRIMARY KEY,version INTEGER NOT NULL CHECK(version>=0 AND version<9007199254740992)",
    "control_requests": "session_key TEXT NOT NULL,request_id TEXT NOT NULL,request_digest TEXT NOT NULL,"
                        "response TEXT NOT NULL,PRIMARY KEY(session_key,request_id)",
}


def continuation_v2_schema(db, create=False):
    if db is None:
        return False
    definitions = {row[0]: (row[1], row[2]) for row in db.execute("SELECT name,type,sql FROM sqlite_master")}
    found = set(definitions)
    present = found & CONTINUATION_V2_TABLES.keys()
    if present and present != CONTINUATION_V2_TABLES.keys():
        raise ContinuationError("invalid_state")
    if not present and create:
        # Individual DDL statements stay inside the caller's transaction.
        for name, fields in CONTINUATION_V2_TABLES.items():
            db.execute(f"CREATE TABLE {name} ({fields})")
        present = CONTINUATION_V2_TABLES.keys()
        definitions = {row[0]: (row[1], row[2]) for row in db.execute("SELECT name,type,sql FROM sqlite_master")}
    if present:
        for name, fields in CONTINUATION_V2_TABLES.items():
            kind, statement = definitions[name]
            expected = f"CREATE TABLE {name} ({fields})"
            if kind != "table" or "".join((statement or "").split()) != "".join(expected.split()):
                raise ContinuationError("invalid_state")
    return bool(present)


def continuation_route_version(db, session_key, advance=False):
    if not continuation_v2_schema(db):
        return 0
    row = db.execute("SELECT version FROM route_versions WHERE session_key=?", (session_key,)).fetchone()
    version = row[0] if row else 0
    if type(version) is not int or not 0 <= version < 2**53 - int(advance):
        raise ContinuationError("capacity_unavailable")
    if advance:
        version += 1
        db.execute("INSERT INTO route_versions VALUES (?,?) ON CONFLICT(session_key) "
                   "DO UPDATE SET version=excluded.version", (session_key, version))
    return version


def continuation_cycle_binding(db, cycle_id):
    if not continuation_v2_schema(db):
        return None
    row = db.execute("SELECT * FROM cycle_bindings JOIN worktree_bindings USING(binding_id) "
                     "WHERE cycle_id=?", (cycle_id,)).fetchone()
    if row and (row["protocol"] != 2 or not re.fullmatch(r"[0-9a-f]{32}", row["binding_id"])
                or any(not re.fullmatch(r"[0-9a-f]{64}", row[key])
                       for key in ("record_identity_digest", "registration_digest"))):
        raise ContinuationError("invalid_state")
    return dict(row) if row else None


def continuation_registration(home, target):
    target = Path(target).resolve(strict=True)
    common = common_git_dir(home).resolve(strict=True)
    if repo_root(target) != target or common_git_dir(target).resolve() != common:
        raise ContinuationError("repository_mismatch")
    registered = {Path(line[9:]).resolve() for line in git(home, "worktree", "list", "--porcelain").stdout.splitlines()
                  if line.startswith("worktree ")}
    if target not in registered:
        raise ContinuationError("registration_missing")
    admin = git_dir(target).resolve(strict=True)
    relative = admin.relative_to(common).as_posix()
    if any(ord(char) < 32 for char in str(target)):
        raise ContinuationError("invalid_target")
    for directory in (common, admin):
        info = directory.lstat()
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o022:
            raise ContinuationError("registration_changed")
    if admin != common:
        backref = admin / "gitdir"
        pointer = target / ".git"
        for path in (backref, pointer):
            info = path.lstat()
            if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
                    or info.st_mode & 0o022 or info.st_nlink != 1 or info.st_size > 8192):
                raise ContinuationError("registration_changed")
        if Path(backref.read_text().strip()).resolve() != pointer:
            raise ContinuationError("registration_changed")
    value = {"git_dir_relative": relative, "common_dev": common.stat().st_dev,
             "common_ino": common.stat().st_ino, "admin_dev": admin.stat().st_dev,
             "admin_ino": admin.stat().st_ino, "locator": str(target)}
    return {**value, "registration_digest": continuation_digest(value)}


def continuation_bound_target(home, binding):
    try:
        registration = continuation_registration(home, binding["locator"])
    except ContinuationError:
        raise
    except (OSError, ValueError, RuntimeError):
        raise ContinuationError("registration_missing") from None
    if any(registration[key] != binding[key] for key in registration):
        raise ContinuationError("registration_changed")
    return Path(registration["locator"]), registration


def continuation_record_identity(record):
    return continuation_digest([record["cycle_id"], record.get("schema_version"),
                                record["worktree"]["id"], record["worktree"]["branch"]])


def continuation_binding_for_root(root):
    with continuation_connection(root) as db:
        if not continuation_v2_schema(db):
            return None
        matches = db.execute("SELECT c.cycle_id FROM cycle_bindings b JOIN worktree_bindings w USING(binding_id) "
                             "JOIN cycles c USING(cycle_id) WHERE w.locator=? AND c.state!='closed' LIMIT 2",
                             (str(root.resolve()),)).fetchall()
        if len(matches) > 1:
            raise ContinuationError("invalid_state")
        bound = continuation_cycle_binding(db, matches[0][0]) if matches else None
    if bound:
        continuation_bound_target(root, bound)
    return bound


def continuation_v2_response():
    return {"schema_version": 2, "ok": True, "reason": "ok", "cycle_id": None, "state": None,
            "generation": None, "writer_relation": None, "binding_id": None, "route_version": None,
            "activation_changes": [], "checks": {key: {"status": "not_requested", "reason": None}
                                                    for key in ("source", "target", "ownership", "storage")},
            "next_action": "none", "expected": None, "operation_id": None, "event_id": None,
            "request_id": None, "replayed": False, "local_target": None}


def continuation_v2_replay_response(value):
    """A damaged private receipt must not turn into an unbounded response body."""
    if (not isinstance(value, dict) or set(value) != set(continuation_v2_response())
            or type(value["schema_version"]) is not int or value["schema_version"] != 2
            or value["ok"] is not True or value["reason"] != "ok"
            or value["expected"] is not None or value["local_target"] is not None
            or value["replayed"] is not False or value["next_action"] != "none"
            or value["state"] not in {"reader_only", "owned", "draining", "recovery_required", "closed"}
            or value["writer_relation"] not in {"self", "other", "none"}
            or any(type(value[key]) is not int or not 0 <= value[key] < 2**53
                   for key in ("generation", "route_version"))):
        raise ContinuationError("invalid_state")
    for key in ("cycle_id", "request_id"):
        if not isinstance(value[key], str) or not OPAQUE_ID.fullmatch(value[key]):
            raise ContinuationError("invalid_state")
    for key in ("binding_id", "operation_id"):
        if value[key] is not None and (not isinstance(value[key], str) or not re.fullmatch(r"[0-9a-f]{32}", value[key])):
            raise ContinuationError("invalid_state")
    if value["event_id"] is not None and (type(value["event_id"]) is not int or not 1 <= value["event_id"] < 2**53):
        raise ContinuationError("invalid_state")
    if (not isinstance(value["activation_changes"], list) or any(key not in {
            "schema_version", "provider_id", "model_id", "agent_id", "core_revision", "overlay_revision"}
            for key in value["activation_changes"])):
        raise ContinuationError("invalid_state")
    checks = value["checks"]
    if not isinstance(checks, dict) or set(checks) != {"source", "target", "ownership", "storage"}:
        raise ContinuationError("invalid_state")
    reasons = {"source_unavailable", "branch_mismatch", "registration_missing", "registration_changed",
               "invalid_target", "repository_mismatch", "invalid_state"}
    for item in checks.values():
        if (not isinstance(item, dict) or set(item) != {"status", "reason"}
                or item["status"] not in {"available", "unavailable", "not_requested"}
                or (item["status"] == "unavailable" and item["reason"] not in reasons)
                or (item["status"] != "unavailable" and item["reason"] is not None)):
            raise ContinuationError("invalid_state")
    return value


def continuation_v2_request(request):
    common = {"schema_version", "action", "session_id", "message_id", "runtime_worktree",
              "runtime_directory", "harness_activation"}
    fields = {
        "check": ({}, {"worktree", "for_action", "mode", "target_session_id"}),
        "enroll": ({"worktree", "request_id", "expected", "approval"}, set()),
        "bind": ({"worktree", "request_id", "expected", "approval"}, set()),
        "attach": ({"request_id", "expected", "mode"}, {"worktree", "approval"}),
        "admit": ({"expected", "call_id", "operation_class"}, set()),
        "finish": ({"operation_id", "outcome"}, {"worktree"}),
        "handover": ({"request_id", "expected", "target_session_id", "approval"}, set()),
        "recover": ({"request_id", "expected", "approval"}, {"worktree"}),
        "release": ({"request_id", "expected"}, set()),
        "resolve": ({"expected"}, set()),
    }
    if not isinstance(request, dict) or request.get("action") not in fields:
        raise ContinuationError("invalid_state")
    action = request["action"]
    required, optional = fields[action]
    if (type(request.get("schema_version")) is not int or request["schema_version"] != 2
            or not common.union(required) <= request.keys()
            or request.keys() - common - set(required) - optional):
        raise ContinuationError("invalid_state")
    purpose = request.get("for_action", "check") if action == "check" else action
    if action == "finish" and "worktree" in request and request.get("outcome") != "native_error":
        raise ContinuationError("invalid_state")
    if purpose not in fields or purpose == "finish" and action == "check":
        raise ContinuationError("invalid_state")
    for field in ("request_id", "call_id", "target_session_id"):
        if field in request and (not isinstance(request[field], str) or not OPAQUE_ID.fullmatch(request[field])):
            raise ContinuationError("invalid_identity")
    if "worktree" in request and (not isinstance(request["worktree"], str) or not request["worktree"]):
        raise ContinuationError("invalid_target")
    if "mode" in request and (purpose != "attach" or request["mode"] not in {"reader", "writer"}):
        raise ContinuationError("invalid_state")
    if "target_session_id" in request and purpose != "handover":
        raise ContinuationError("invalid_state")
    if "expected" in request:
        expected = request["expected"]
        names = {"action", "cycle_id", "binding_id", "generation", "route_version", "state_digest",
                 "record_digest", "registration_digest", "session_key", "activation_digest", "mode", "target_session_id"}
        if (not isinstance(expected, dict) or set(expected) != names or expected["action"] != action
                or not isinstance(expected["cycle_id"], str) or not OPAQUE_ID.fullmatch(expected["cycle_id"])
                or any(type(expected[key]) is not int or not 0 <= expected[key] < 2**53
                       for key in ("generation", "route_version"))):
            raise ContinuationError("invalid_state")
        for key in ("state_digest", "record_digest", "registration_digest", "session_key", "activation_digest"):
            if expected[key] is None and key in {"record_digest", "registration_digest"} and action in {"recover", "release"}:
                continue
            if not isinstance(expected[key], str) or not re.fullmatch(r"[0-9a-f]{64}", expected[key]):
                raise ContinuationError("invalid_state")
        identifier = expected["binding_id"]
        if identifier is not None and (not isinstance(identifier, str) or not re.fullmatch(r"[0-9a-f]{32}", identifier)):
            raise ContinuationError("invalid_state")
        if identifier is None and action not in {"enroll", "bind", "recover", "release"}:
            raise ContinuationError("invalid_state")
        if expected["mode"] != (request.get("mode") if action == "attach" else None):
            raise ContinuationError("invalid_state")
        if expected["target_session_id"] != (request.get("target_session_id") if action == "handover" else None):
            raise ContinuationError("invalid_state")
    return action, purpose


def continuation_v2_home(request):
    home = Path(request["runtime_worktree"]).resolve(strict=True)
    directory = Path(request["runtime_directory"]).resolve(strict=True)
    if (directory != home and home not in directory.parents) or repo_root(home) != home:
        raise ContinuationError("invalid_identity")
    if common_git_dir(home).resolve() != common_git_dir(root_dir()).resolve():
        raise ContinuationError("repository_mismatch")
    continuation_registration(home, home)
    return home


def continuation_v2_snapshot(db, home, request, actor, activation, purpose):
    response = continuation_v2_response()
    response["checks"]["storage"] = {"status": "available", "reason": None}
    route = db.execute("SELECT * FROM routes WHERE session_key=?", (actor,)).fetchone() if db else None
    cycle = None
    if request["action"] == "finish" and db:
        op = db.execute("SELECT * FROM operations WHERE operation_id=?", (request["operation_id"],)).fetchone()
        if not op or op["session_key"] != actor:
            raise ContinuationError("invalid_identity")
        cycle = db.execute("SELECT * FROM cycles WHERE cycle_id=?", (op["cycle_id"],)).fetchone()
    elif route:
        cycle = db.execute("SELECT * FROM cycles WHERE cycle_id=?", (route["cycle_id"],)).fetchone()
    if cycle and (not isinstance(cycle["cycle_id"], str) or not OPAQUE_ID.fullmatch(cycle["cycle_id"])):
        raise ContinuationError("invalid_state")
    target = record_path = record = registration = None
    target_error = None
    binding = continuation_cycle_binding(db, cycle["cycle_id"]) if cycle else None
    try:
        if "worktree" in request:
            target = Path(request["worktree"]).resolve(strict=True)
            registration = continuation_registration(home, target)
            # An explicit target may select a different valid cycle, never repair an invalid route by guesswork.
            record_path, record = load(target)
            if purpose in {"release", "recover"} and route and record["cycle_id"] != route["cycle_id"]:
                raise ContinuationError("invalid_target")
            cycle = db.execute("SELECT * FROM cycles WHERE cycle_id=?", (record["cycle_id"],)).fetchone() if db else None
            binding = continuation_cycle_binding(db, record["cycle_id"])
        elif cycle:
            if binding:
                target, registration = continuation_bound_target(home, binding)
            else:
                target = worktree_for_id(home, cycle["locator_id"])
                registration = continuation_registration(home, target)
        else:
            response.update(reason="not_enrolled", next_action="select_target")
            return response, None
        if record is None:
            record_path = cycle_dir(home) / "cycles" / f'{cycle["cycle_id"]}.json'
            if record_path.is_symlink():
                raise ContinuationError("invalid_target")
            record = read_cycle_record(home, record_path)
        if cycle and record["cycle_id"] != cycle["cycle_id"]:
            raise ContinuationError("invalid_target")
        if binding:
            target, registration = continuation_bound_target(home, binding)
            if continuation_record_identity(record) != binding["record_identity_digest"]:
                raise ContinuationError("invalid_target")
            if branch(target) != record["worktree"]["branch"]:
                raise ContinuationError("branch_mismatch")
        elif not record_worktree_matches(home, record, target) or record_worktree(home, record) != target:
            raise ContinuationError("invalid_target")
        pointer = cycle_dir(home) / "worktrees" / record["worktree"]["id"] / "active"
        if record["state"] not in {"completed", "retired"}:
            if not pointer.exists():
                pointer = resolved_active_path(target)
            if not pointer.exists() or active_pointer_id(home, pointer) != record["cycle_id"]:
                raise ContinuationError("invalid_target")
        if record["state"] not in {"active", "finalizing", "completed", "retired"}:
            raise ContinuationError("invalid_target")
    except (RuntimeError, OSError, ValueError, KeyError) as error:
        target_error = str(error) if isinstance(error, ContinuationError) else "invalid_target"
        if "worktree" in request:
            raise ContinuationError(target_error) from None
    if cycle is None and record is None:
        raise ContinuationError(target_error or "not_enrolled")
    cycle_id = cycle["cycle_id"] if cycle else record["cycle_id"]
    if not isinstance(cycle_id, str) or not OPAQUE_ID.fullmatch(cycle_id):
        raise ContinuationError("invalid_state")
    # Record custody is independent of target availability, including terminal-state diagnosis.
    if record is None and cycle:
        candidate = cycle_dir(home) / "cycles" / f'{cycle_id}.json'
        try:
            if candidate.is_symlink():
                raise ValueError("unsafe")
            record = read_cycle_record(home, candidate)
            if record.get("cycle_id") != cycle_id:
                raise ValueError("identity")
            record_path = candidate
        except (RuntimeError, OSError, ValueError):
            record = record_path = None
    if record is not None:
        reject_native_continuation(record)
    pending = [dict(row) for row in db.execute(
        "SELECT * FROM operations WHERE cycle_id=? AND state!='completed' ORDER BY operation_id LIMIT 101",
        (cycle_id,))] if cycle else []
    if len(pending) > 100:
        raise ContinuationError("capacity_unavailable")
    version = continuation_route_version(db, actor)
    changes = []
    previous = None
    if cycle:
        previous_row = db.execute("SELECT activation FROM activations WHERE cycle_id=? ORDER BY "
                                  "CASE WHEN session_key=? THEN 0 WHEN event_id=? THEN 1 ELSE 2 END,"
                                  "event_id DESC LIMIT 1", (cycle_id, actor, cycle["writer_event_id"])).fetchone()
        previous = json.loads(previous_row[0]) if previous_row and previous_row[0] else None
        if previous:
            validate_stored_harness_activation(previous)
        if activation and previous:
            changes = sorted(key for key in activation if activation[key] != previous.get(key))
        if (cycle["state"] not in {"reader_only", "owned", "draining", "recovery_required", "closed"}
                or type(cycle["generation"]) is not int or not 0 <= cycle["generation"] < 2**53
                or cycle["writer"] is not None and (not isinstance(cycle["writer"], str)
                                                    or not re.fullmatch(r"[0-9a-f]{64}", cycle["writer"]))
                or (cycle["state"] in {"owned", "draining", "recovery_required"}) != (cycle["writer"] is not None)):
            raise ContinuationError("invalid_state")
    response.update(cycle_id=cycle_id, state=cycle["state"] if cycle else None,
                    generation=cycle["generation"] if cycle else 0,
                    writer_relation=("self" if cycle["writer"] == actor else "other" if cycle["writer"] else "none")
                    if cycle else "none", binding_id=binding["binding_id"] if binding else None,
                    route_version=version, activation_changes=changes)
    response["checks"]["target"] = {"status": "unavailable" if target_error else "available", "reason": target_error}
    response["checks"]["ownership"] = {"status": "available", "reason": None}
    if record:
        try:
            source = record_source_worktree(home, record)
            if source is not None and not source.is_dir():
                raise ValueError("absent")
            response["checks"]["source"] = {"status": "available" if source else "not_requested", "reason": None}
        except (RuntimeError, OSError, ValueError):
            response["checks"]["source"] = {"status": "unavailable", "reason": "source_unavailable"}
    route_only = purpose in {"release", "recover"} and route and route["cycle_id"] == cycle_id
    native_error = request["action"] == "finish" and request.get("outcome") == "native_error"
    finishing = request["action"] == "finish" and (binding is not None or native_error)
    if target_error and not route_only and not finishing and purpose != "check":
        raise ContinuationError(target_error)
    if not binding and not native_error and purpose not in {"check", "enroll", "bind", "release", "recover"}:
        raise ContinuationError("binding_required")
    if purpose in {"release", "recover"} and target_error and not route_only:
        raise ContinuationError("invalid_target")
    if not cycle and purpose not in {"check", "enroll"}:
        raise ContinuationError("not_enrolled")
    if target_error:
        response.update(reason=target_error, next_action="restore_target")
    elif not binding:
        response["next_action"] = "bind" if cycle else "enroll"
    if cycle and (pending or cycle["state"] in {"draining", "recovery_required"}):
        response["next_action"] = "confirm_quiescence"
    if activation is None:
        response["next_action"] = "switch_to_build"
    elif purpose != "check":
        response["expected"] = {
            "action": purpose, "cycle_id": cycle_id, "binding_id": response["binding_id"],
            "generation": response["generation"], "route_version": version,
            "state_digest": continuation_digest([dict(cycle) if cycle else None,
                                                 dict(route) if route else None, pending, previous, version]),
            "record_digest": hashlib.sha256(record_path.read_bytes()).hexdigest() if record_path else None,
            "registration_digest": registration["registration_digest"] if registration and not target_error else None,
            "session_key": actor, "activation_digest": continuation_digest(activation),
            "mode": request.get("mode") if purpose == "attach" else None,
            "target_session_id": request.get("target_session_id") if purpose == "handover" else None,
        }
    return response, {"cycle": cycle, "route": route, "binding": binding, "record": record,
                      "path": record_path, "target": target, "registration": registration,
                      "pending": pending, "target_error": target_error}


def continuation_v2_mutate(db, home, request, actor, activation, response, details):
    action, cycle_id = request["action"], response["cycle_id"]
    cycle, route, record = details["cycle"], details["route"], details["record"]
    pending, binding = details["pending"], details["binding"]
    terminal = (cycle and cycle["state"] == "closed") or (record and record["state"] in {"completed", "retired"})
    admit_replay = None
    if action == "admit" and cycle:
        admit_replay = db.execute("SELECT * FROM operations WHERE cycle_id=? AND generation=? AND session_key=? AND call_id=?",
                                  (cycle_id, cycle["generation"], actor, request["call_id"])).fetchone()
        if admit_replay and admit_replay["message_id"] != request["message_id"]:
            raise ContinuationError("invalid_identity")
    expected = request.get("expected")
    actual = response["expected"]
    if admit_replay:
        expected = {key: value for key, value in expected.items() if key != "state_digest"}
        actual = {key: value for key, value in actual.items() if key != "state_digest"}
    if action != "finish" and expected != actual:
        raise ContinuationError("generation_changed" if request.get("expected", {}).get("generation") != response["generation"]
                                else "route_changed")
    consent = action in {"enroll", "bind", "recover", "handover"} or "approval" in request
    if action == "attach" and "provider_id" in response["activation_changes"] and not consent:
        raise ContinuationError("provider_confirmation_required")
    if consent:
        receipt = continuation_approval(request, response["expected"])
        if db.execute("SELECT 1 FROM approvals WHERE receipt_id=?", (receipt,)).fetchone():
            raise ContinuationError("approval_required")
    if action in {"enroll", "bind", "attach", "admit"} and terminal:
        raise ContinuationError("invalid_target")
    if action in {"enroll", "bind"}:
        if record["state"] != "active" or binding:
            raise ContinuationError("invalid_target")
        if cycle and (cycle["writer"] or pending or cycle["state"] != "reader_only"):
            raise ContinuationError("recovery_required")
        continuation_v2_schema(db, create=True)
        if cycle is None:
            db.execute("INSERT INTO cycles(cycle_id,worktree_id,locator_id,record_digest,generation,state) "
                       "VALUES (?,?,?,?,0,'reader_only')", (cycle_id, record["worktree"]["id"],
                                                           worktree_id(details["target"]), response["expected"]["record_digest"]))
            legacy = record.get("runtime", {}).get("opencode", {}).get("harness_activation")
            if legacy is not None:
                validate_stored_harness_activation(legacy)
            db.execute("INSERT INTO activations(cycle_id,kind,activation) VALUES (?,'legacy',?)",
                       (cycle_id, json.dumps(legacy, sort_keys=True) if legacy else None))
        registration = details["registration"]
        existing = db.execute("SELECT * FROM worktree_bindings WHERE git_dir_relative=?",
                              (registration["git_dir_relative"],)).fetchone()
        if existing and any(existing[key] != value for key, value in registration.items()):
            raise ContinuationError("registration_changed")
        identifier = existing["binding_id"] if existing else uuid.uuid4().hex
        if db.execute("SELECT 1 FROM cycle_bindings JOIN cycles USING(cycle_id) "
                      "WHERE binding_id=? AND state!='closed' LIMIT 1", (identifier,)).fetchone():
            raise ContinuationError("invalid_target")
        if not existing:
            db.execute("INSERT INTO worktree_bindings VALUES (?,?,?,?,?,?,?,?)", (
                identifier, *(registration[key] for key in ("git_dir_relative", "common_dev", "common_ino",
                                                           "admin_dev", "admin_ino", "locator", "registration_digest"))))
        db.execute("INSERT INTO cycle_bindings VALUES (?,?,?,?,2)",
                   (cycle_id, identifier, record["worktree"]["id"], continuation_record_identity(record)))
        response["binding_id"] = identifier
    elif action == "attach":
        if route and route["cycle_id"] != cycle_id:
            old = db.execute("SELECT writer FROM cycles WHERE cycle_id=?", (route["cycle_id"],)).fetchone()
            if old and old[0] == actor:
                raise ContinuationError("writer_occupied")
        if request["mode"] == "writer":
            if cycle["state"] in {"draining", "recovery_required"}:
                raise ContinuationError("recovery_required")
            if cycle["writer"] not in {None, actor}:
                raise ContinuationError("writer_occupied")
            if cycle["writer"] is None:
                if pending:
                    raise ContinuationError("operation_in_flight")
                db.execute("UPDATE cycles SET writer=?,generation=generation+1,state='owned' WHERE cycle_id=?",
                           (actor, cycle_id))
        predecessor = route["event_id"] if route and route["cycle_id"] == cycle_id else None
        event = db.execute("INSERT INTO activations(cycle_id,session_key,native_session_id,kind,activation,predecessor) "
                           "VALUES (?,?,?,?,?,?)", (cycle_id, actor, request["session_id"],
                                                   "transition" if predecessor else "attach",
                                                   json.dumps(activation, sort_keys=True), predecessor)).lastrowid
        db.execute("INSERT INTO routes VALUES (?,?,?,?,?) ON CONFLICT(session_key) DO UPDATE SET "
                   "cycle_id=excluded.cycle_id,home_worktree_id=excluded.home_worktree_id,event_id=excluded.event_id",
                   (actor, request["session_id"], cycle_id, worktree_id(home), event))
        if request["mode"] == "writer":
            db.execute("UPDATE cycles SET writer_event_id=? WHERE cycle_id=?", (event, cycle_id))
        response.update(event_id=event, route_version=continuation_route_version(db, actor, advance=True))
    elif action == "admit":
        if cycle["state"] in {"recovery_required", "draining"}:
            raise ContinuationError("recovery_required")
        if cycle["state"] != "owned" or cycle["writer"] != actor:
            raise ContinuationError("writer_occupied")
        current = db.execute("SELECT a.activation FROM routes r JOIN activations a USING(event_id) "
                             "WHERE r.session_key=? AND r.cycle_id=?", (actor, cycle_id)).fetchone()
        if not current or json.loads(current[0]) != activation:
            raise ContinuationError("invalid_identity")
        kind = request["operation_class"]
        if kind not in {"file", "shell", "lifecycle", "mcp"}:
            raise ContinuationError("invalid_state")
        op = db.execute("SELECT * FROM operations WHERE cycle_id=? AND generation=? AND session_key=? AND call_id=?",
                        (cycle_id, cycle["generation"], actor, request["call_id"])).fetchone()
        if op:
            if op["state"] != "running" or op["operation_class"] != kind:
                raise ContinuationError("invalid_state")
            response["operation_id"] = op["operation_id"]
        else:
            if len(pending) >= 100:
                raise ContinuationError("operation_in_flight")
            identifier = uuid.uuid4().hex
            db.execute("INSERT INTO operations VALUES (?,?,?,?,?,?,?,'running',NULL)",
                       (identifier, cycle_id, cycle["generation"], actor, request["message_id"], request["call_id"], kind))
            response["operation_id"] = identifier
    elif action == "finish":
        op = db.execute("SELECT * FROM operations WHERE operation_id=?", (request["operation_id"],)).fetchone()
        if not op or op["session_key"] != actor or op["cycle_id"] != cycle_id:
            raise ContinuationError("invalid_identity")
        if op["generation"] != cycle["generation"]:
            raise ContinuationError("generation_changed")
        outcome, completion = continuation_finish_outcome(request, cycle, op, actor)
        if op["state"] not in {"running", outcome}:
            raise ContinuationError("invalid_state")
        db.execute("UPDATE operations SET state=?,completion_class=? WHERE operation_id=?", (
            outcome, completion, op["operation_id"]))
        if outcome == "uncertain":
            db.execute("UPDATE cycles SET state='recovery_required' WHERE cycle_id=?", (cycle_id,))
        elif terminal and not db.execute("SELECT 1 FROM operations WHERE cycle_id=? AND state!='completed' LIMIT 1",
                                        (cycle_id,)).fetchone():
            db.execute("UPDATE cycles SET state='closed',writer=NULL WHERE cycle_id=?", (cycle_id,))
            if route and route["cycle_id"] == cycle_id:
                continuation_route_version(db, actor, advance=True)
                db.execute("DELETE FROM routes WHERE session_key=? AND cycle_id=?", (actor, cycle_id))
        response["operation_id"] = op["operation_id"]
    elif action == "handover":
        if cycle["writer"] != actor:
            raise ContinuationError("invalid_identity")
        if cycle["state"] == "recovery_required":
            raise ContinuationError("recovery_required")
        owner = native_session_actor(None, request["target_session_id"])
        if not owner or owner[0] is not None or owner[1] not in {"build", "build-gpt", "build-claude"}:
            raise ContinuationError("invalid_identity")
        if pending:
            db.execute("UPDATE cycles SET state='draining' WHERE cycle_id=?", (cycle_id,))
        else:
            boundary = hashlib.sha256(str(opencode_database().resolve()).encode()).hexdigest()
            db.execute("UPDATE cycles SET writer=?,generation=generation+1,state='owned' WHERE cycle_id=?",
                       (continuation_digest([boundary, request["target_session_id"]]), cycle_id))
    elif action == "recover":
        if cycle["state"] not in {"owned", "draining", "recovery_required"}:
            raise ContinuationError("invalid_state")
        continuation_v2_schema(db, create=True)
        db.execute("UPDATE operations SET state='completed',completion_class='operator_quiescence' "
                   "WHERE cycle_id=? AND state!='completed'", (cycle_id,))
        db.execute("UPDATE cycles SET writer=NULL,generation=generation+1,state=? WHERE cycle_id=?",
                   ("closed" if terminal else "reader_only", cycle_id))
    elif action == "release":
        if not route or route["cycle_id"] != cycle_id:
            raise ContinuationError("route_changed")
        if any(op["session_key"] == actor for op in pending):
            raise ContinuationError("operation_in_flight")
        if cycle["writer"] == actor:
            if cycle["state"] != "owned" or pending:
                raise ContinuationError("recovery_required")
            db.execute("UPDATE cycles SET writer=NULL,generation=generation+1,state=? WHERE cycle_id=?",
                       ("closed" if terminal else "reader_only", cycle_id))
        elif terminal and cycle["writer"] is None and not pending:
            db.execute("UPDATE cycles SET state='closed' WHERE cycle_id=?", (cycle_id,))
        continuation_v2_schema(db, create=True)
        continuation_route_version(db, actor, advance=True)
        db.execute("DELETE FROM routes WHERE session_key=? AND cycle_id=?", (actor, cycle_id))
    current = db.execute("SELECT * FROM cycles WHERE cycle_id=?", (cycle_id,)).fetchone()
    if current and current["generation"] >= 2**53:
        raise ContinuationError("capacity_unavailable")
    summary = continuation_response(current, cycle_id, actor)
    response.update({key: summary[key] for key in ("state", "generation", "writer_relation")})
    response.update(reason="ok", next_action="none", expected=None, request_id=request.get("request_id"))
    if consent:
        db.execute("INSERT INTO approvals VALUES (?,?,?,?,?)", (
            receipt, cycle_id, continuation_digest(["v2", request]), json.dumps(request["expected"], sort_keys=True),
            json.dumps(response, sort_keys=True, separators=(",", ":"))))


def command_continuation_v2(args):
    response = continuation_v2_response()
    try:
        if args.request_json != "-":
            raise ContinuationError("invalid_state")
        raw = sys.stdin.buffer.read(65537)
        if len(raw) > 65536:
            raise ContinuationError("capacity_unavailable")
        request = json.loads(raw, object_pairs_hook=no_duplicate_keys)
        action, purpose = continuation_v2_request(request)
        actor, activation = continuation_native(request, read_only=action in {"check", "resolve"})
        home = continuation_v2_home(request)
        write = action not in {"check", "resolve"}
        if write:
            continuation_compatible(activation)
        if action == "enroll":
            # Verify before a missing store can be created, then recheck under its lock.
            with continuation_connection(home) as db:
                replay = (db.execute("SELECT 1 FROM control_requests WHERE session_key=? AND request_id=?",
                                     (actor, request["request_id"])).fetchone() if continuation_v2_schema(db) else None)
                if not replay:
                    prepared, _ = continuation_v2_snapshot(db, home, request, actor, activation, purpose)
                    if request["expected"] != prepared["expected"]:
                        raise ContinuationError("approval_required")
                    continuation_approval(request, prepared["expected"])
        with continuation_connection(home, write=write, create=action == "enroll") as db:
            schema = continuation_v2_schema(db)
            digest = continuation_digest(request)
            if schema and request.get("request_id"):
                replay = db.execute("SELECT request_digest,response FROM control_requests WHERE session_key=? AND request_id=?",
                                    (actor, request["request_id"])).fetchone()
                if replay:
                    if replay[0] != digest or len(replay[1].encode()) > 65536:
                        raise ContinuationError("invalid_state")
                    saved = continuation_v2_replay_response(json.loads(replay[1], object_pairs_hook=no_duplicate_keys))
                    if saved.get("cycle_id"):
                        reject_native_continuation(read_cycle_record(
                            home, cycle_dir(home) / "cycles" / f"{saved['cycle_id']}.json", historical=True))
                    saved["replayed"] = True
                    print(json.dumps(saved, sort_keys=True, separators=(",", ":")))
                    return
            response, details = continuation_v2_snapshot(db, home, request, actor, activation, purpose)
            if write:
                if db is None or details is None:
                    raise ContinuationError("not_enrolled")
                continuation_v2_mutate(db, home, request, actor, activation, response, details)
                if request.get("request_id"):
                    db.execute("INSERT INTO control_requests VALUES (?,?,?,?)", (
                        actor, request["request_id"], digest, json.dumps(response, sort_keys=True, separators=(",", ":"))))
            elif action == "resolve":
                if not details or request["expected"] != response["expected"]:
                    raise ContinuationError("route_changed")
                if details["target_error"] or not details["binding"]:
                    raise ContinuationError(details["target_error"] or "binding_required")
                response["local_target"] = {"path": str(details["target"]), "binding_id": response["binding_id"],
                                            "registration_digest": details["registration"]["registration_digest"]}
            serialized = json.dumps(response, sort_keys=True, separators=(",", ":"))
            if len(serialized.encode()) > 65536:
                raise ContinuationError("capacity_unavailable")
        print(serialized)
    except (RuntimeError, OSError, ValueError, TypeError, KeyError, sqlite3.Error) as error:
        reason = str(error) if isinstance(error, ContinuationError) else "invalid_state"
        response.update(ok=False, reason=reason, expected=None, local_target=None, operation_id=None, event_id=None)
        print(json.dumps(response, sort_keys=True, separators=(",", ":")))
        raise SystemExit(1)


CONTINUATION_READ_COMMANDS = {
    "workspace-remove-check",
    "status", "phase-report", "cycle-performance", "execution-dag", "inference-cost-report",
    "review-scan", "incident-scan", "history-source-validate", "review-history",
    "history-source-index-status", "history-capture", "history-capture-latest",
    "review-privacy-epoch", "knowledge-privacy-status", "knowledge-export",
    "provider-evaluation", "benchmark", "improvement-status", "initiative-check",
    "initiative-receipt", "initiative-cycle-check", "check", "worktree-list", "audit", "inspect",
}


def continuation_validate_operation(cycle, operation, root, requested_cycle, db=None):
    bound = continuation_cycle_binding(db, requested_cycle)
    if bound:
        target, _ = continuation_bound_target(root, bound)
        path = cycle_dir(root) / "cycles" / f"{requested_cycle}.json"
        record = read_cycle_record(root, path)
        matching = (target == root and continuation_record_identity(record) == bound["record_identity_digest"]
                    and branch(root) == record["worktree"]["branch"] and record["state"] in {"active", "finalizing"})
    else:
        matching = cycle["locator_id"] == worktree_id(root)
    if (not operation or operation["cycle_id"] != requested_cycle or operation["state"] != "running"
            or operation["generation"] != cycle["generation"] or operation["session_key"] != cycle["writer"]
            or operation["operation_class"] not in {"lifecycle", "shell"}
            or cycle["state"] not in {"owned", "draining"} or not matching):
        raise ContinuationError("continuation_admission_required")


def continuation_legacy_operation_identity(operation):
    session = session_for_message(None, operation["message_id"], require_primary=True)
    boundary = hashlib.sha256(str(opencode_database().resolve()).encode()).hexdigest()
    if continuation_digest([boundary, session]) != operation["session_key"]:
        raise ContinuationError("invalid_identity")
    owner = native_session_actor(None, session, operation["message_id"])
    if not owner or owner[1] not in {"build", "build-gpt", "build-claude"}:
        raise ContinuationError("invalid_identity")


def continuation_codex_operation_identity(root, operation):
    failed = False
    try:
        parent = (Path.home() / ".local/state/dbsctr/codex").resolve(strict=True)
        descriptor = parent / "selected.json"
        current_core = Path(__file__).resolve()
        qualification = parent / "qualification"
        if os.path.lexists(qualification):
            qualification = qualification.resolve(strict=True)
            continuation_private(qualification, directory=True)
            if current_core == qualification / "executable_dbsctrctl":
                descriptor = qualification / "selected.json"
            elif not (qualification / "restored.json").exists():
                raise ValueError("qualification_active")
        continuation_private(parent, directory=True)
        continuation_private(descriptor)
        with descriptor.open("rb") as stream:
            raw = stream.read(16385)
        if len(raw) > 16384:
            raise ValueError("descriptor_bound")
        deployment = json.loads(raw, object_pairs_hook=no_duplicate_keys)
        filename = "executable_codex-continuation" if current_core.name == "executable_dbsctrctl" else "codex-continuation"
        source = current_core.with_name(filename)
        if deployment["producer"]["path"] != str(source):
            raise ValueError("producer_mismatch")
        item = source.lstat()
        if not stat.S_ISREG(item.st_mode) or item.st_mode & 0o022 or item.st_uid != os.getuid() or item.st_nlink != 1:
            raise ValueError("producer_invalid")
        with source.open("rb") as stream:
            code = stream.read(4 * 1024 * 1024 + 1)
        if len(code) > 4 * 1024 * 1024 or hashlib.sha256(code).hexdigest() != deployment["producer"]["sha256"]:
            raise ValueError("producer_mismatch")
        namespace = {"__name__": "codex_continuation_guard", "__file__": str(source)}
        exec(compile(code, str(source), "exec"), namespace)
        namespace["verify_receipt_operation"](root, dict(operation), current_core)
    except Exception:
        # Native adapter errors are content-free, and unexpected failures remain closed.
        failed = True
    if failed:
        raise ContinuationError("invalid_identity")


def reject_native_continuation(record):
    if native_workspace_execution(record):
        raise ContinuationError("workspace_continuation_retired")


def continuation_guard(args):
    if args.command.startswith("continuation-") or args.command in {
            "attach-runtime", "cleanup", "cycle-retire", "cycle-retire-worktree", "cycle-portabilize"}:
        fail("workspace continuation commands are retired; use workspace-adopt and the native checkout")
    if args.command in {"workspace-adopt", "workspace-recover-orphan"} or args.command in CONTINUATION_READ_COMMANDS:
        return
    found = subprocess.run(["git", "rev-parse", "--show-toplevel"], env=INSPECT_ENV,
                           text=True, capture_output=True)
    if found.returncode:
        return
    root = Path(found.stdout.strip()).resolve()
    local = resolved_active_path(root, bindings=False)
    identifier = getattr(args, "cycle_id", None)
    if identifier is None and local.exists():
        identifier = active_pointer_id(root, local)
    if identifier is not None:
        if not isinstance(identifier, str) or not OPAQUE_ID.fullmatch(identifier):
            fail("invalid cycle ID")
        path = cycle_dir(root) / "cycles" / f"{identifier}.json"
        if path.is_file():
            if args.command in {"begin", "start"} and not getattr(args, "resume_existing", False):
                fail("cycle record already exists; inspect its original native checkout")
            record = read_cycle_record(root, path, historical=True)
            if native_workspace_execution(record):
                continuation_private(path)
                verify_native_workspace_backup(root, record)
                if not record_worktree_matches(root, record, root):
                    fail("native workspace checkout identity changed")
                if args.command.startswith("continuation-") or args.command in {
                        "attach-runtime", "cycle-portabilize", "cleanup", "cycle-retire-worktree"}:
                    fail("workspace execution command is retired; use the native checkout and Worktrunk")
                return
            fail("workspace_adoption_required: preserve the legacy cycle and adopt it before lifecycle writes")


def local_dispatch_selection(args):
    """Find an existing new-mode binding using local Git metadata only."""
    if args.command == "complete-local":
        return None  # The completion handler owns admission, including explicit retries.
    found = subprocess.run(["git", "rev-parse", "--show-toplevel"], env=INSPECT_ENV,
                           text=True, capture_output=True)
    if found.returncode:
        return None
    root = Path(found.stdout.strip()).resolve()
    pointer = resolved_active_path(root, bindings=False)
    identifier = getattr(args, "cycle_id", None)
    if identifier is None and pointer.exists():
        identifier = active_pointer_id(root, pointer)
    if identifier is None or not isinstance(identifier, str) or not OPAQUE_ID.fullmatch(identifier):
        return None
    path = cycle_dir(root) / "cycles" / f"{identifier}.json"
    if not path.is_file():
        return None
    # Do not introduce new validation of legacy records for unrelated commands.
    # This bounded peek only selects admission; the guard rereads strict schema 6.
    try:
        with path.open("rb") as stream:
            raw = stream.read(32 * 1024 * 1024 + 1)
        if len(raw) > 32 * 1024 * 1024:
            fail("active Cycle Record exceeds safe dispatch budget")
        record = json.loads(raw)
    except (OSError, ValueError, UnicodeError):
        fail("active Cycle Record is unreadable; mutation admission unavailable")
    execution = record.get("execution") if isinstance(record, dict) else None
    return ((root, pointer, path, record) if isinstance(record, dict) and (
        local_only_cycle(record) or isinstance(execution, dict) and execution.get("mode") == "native_workspace"
        and record.get("initiative") is not None) else None)


@contextlib.contextmanager
def local_cli_mutation_guard(args, selected):
    """Serialize native Initiative writers with amendment; legacy admission unchanged."""
    if selected is None:
        yield
        return
    root, pointer, path, before = selected
    before = read_cycle_record(root, path, historical=True)
    if not native_workspace_execution(before):
        fail("native dispatch selection changed")
    if args.command in CONTINUATION_READ_COMMANDS or (
            local_only_cycle(before) and args.command in {"final-push", "reconcile-target"}):
        yield
        return
    with evidence_lock(root, "local-mutation-" + before["cycle_id"], timeout=1):
        record = read_cycle_record(root, path, historical=True)
        if (not native_workspace_execution(record) or record["delivery"] != before["delivery"]
                or record["worktree"] != before["worktree"]
                or not pointer.exists() or active_pointer_id(root, pointer) != record["cycle_id"]
                or not record_worktree_matches(root, record, root, bindings=False)):
            fail("local-only mutation binding changed")
        if args.command in {"final-push", "reconcile-target"}:
            require_pushable(record)
        else:
            require_active(record)
        yield


def verify_native_workspace_backup(root, record):
    if not native_workspace_execution(record) or record["execution"]["origin"] != "adopted":
        return
    adoption = record["execution"]["adoption"]
    backup = common_git_dir(root) / adoption["record_backup"]
    try:
        managed_directory(root, backup.parent)
        continuation_private(backup)
        with backup.open("rb") as stream:
            raw = stream.read(8 * 1024 * 1024 + 1)
        if len(raw) > 8 * 1024 * 1024 or hashlib.sha256(raw).hexdigest() != adoption["before_sha256"]:
            fail("native workspace adoption backup is invalid")
        before = json.loads(raw, object_pairs_hook=no_duplicate_keys)
        if before.get("cycle_id") != record["cycle_id"] or "execution" in before:
            fail("native workspace adoption backup identity is invalid")
    except (OSError, ValueError, TypeError, AttributeError):
        fail("native workspace adoption backup is unavailable")


def workspace_adoption_snapshot(root, cycle_id):
    if not isinstance(cycle_id, str) or not OPAQUE_ID.fullmatch(cycle_id):
        fail("invalid workspace adoption cycle ID")
    if root.resolve() == primary_worktree(root).resolve():
        fail("workspace adoption requires a linked checkout")
    if root.resolve() not in {Path(item["worktree"]).resolve() for item in git_worktrees(root)}:
        fail("workspace adoption requires a registered Git checkout")
    path = cycle_dir(root) / "cycles" / f"{cycle_id}.json"
    managed_directory(root, path.parent)
    continuation_private(path)
    with path.open("rb") as stream:
        raw = stream.read(8 * 1024 * 1024 + 1)
    if len(raw) > 8 * 1024 * 1024:
        fail("workspace adoption record exceeds its bound")
    record = json.loads(raw, object_pairs_hook=no_duplicate_keys)
    if (not isinstance(record, dict) or record.get("cycle_id") != cycle_id
            or type(record.get("schema_version")) is not int or record["schema_version"] not in (3, 4, 5)
            or record.get("state") not in ("active", "finalizing")
            or any(not isinstance(record.get(key), dict) for key in (
                "worktree", "git", "delivery", "engineering_profile", "applicability_plan",
                "gates", "evidence", "artifact_reviews", "metrics"))
            or not isinstance(record.get("commits"), list)):
        fail("workspace adoption record is unsupported")
    if set(record["gates"]) != set(GATES) or any(
            not isinstance(gate, dict) or gate.get("applicability") not in ("required", "not_applicable")
            or gate.get("result") not in ("pending", "passed", "failed", "unavailable", "not_run")
            for gate in record["gates"].values()):
        fail("workspace adoption gate state is malformed")
    if record["schema_version"] == 5:
        validate_schema5_runtime(root, record, historical=True)
    native = native_workspace_execution(record)
    if native:
        verify_native_workspace_backup(root, record)
    if not record_worktree_matches(root, record, root) or branch(root) != record["worktree"]["branch"]:
        fail("workspace adoption checkout identity changed")
    legacy = {"store_present": False, "cycle": None, "operations": []}
    with continuation_connection(root) as db:
        if db is not None:
            legacy["store_present"] = True
            row = db.execute("SELECT * FROM cycles WHERE cycle_id=?", (cycle_id,)).fetchone()
            legacy["cycle"] = dict(row) if row else None
            for table, order in (("operations", "operation_id"), ("activations", "event_id"),
                                 ("routes", "session_key"), ("approvals", "receipt_id")):
                rows = db.execute(f"SELECT * FROM {table} WHERE cycle_id=? ORDER BY {order} LIMIT 10001",
                                  (cycle_id,)).fetchall()
                if len(rows) > 10000:
                    fail("workspace adoption legacy snapshot exceeds its bound")
                legacy[table] = [dict(item) for item in rows]
            legacy["binding"] = continuation_cycle_binding(db, cycle_id)
            if continuation_v2_schema(db):
                sessions = ("SELECT session_key FROM routes WHERE cycle_id=? UNION "
                            "SELECT session_key FROM activations WHERE cycle_id=? UNION "
                            "SELECT session_key FROM operations WHERE cycle_id=? UNION "
                            "SELECT writer FROM cycles WHERE cycle_id=?")
                for table, order in (("route_versions", "session_key"),
                                     ("control_requests", "session_key,request_id")):
                    rows = db.execute(f"SELECT * FROM {table} WHERE session_key IN ({sessions}) "
                                      f"ORDER BY {order} LIMIT 10001", (cycle_id,) * 4).fetchall()
                    if len(rows) > 10000:
                        fail("workspace adoption legacy snapshot exceeds its bound")
                    legacy[table] = [dict(item) for item in rows]
            if len(json.dumps(legacy, sort_keys=True).encode()) > 8 * 1024 * 1024:
                fail("workspace adoption legacy snapshot exceeds its byte bound")
    digest = continuation_digest({"repository": str(common_git_dir(root).resolve()),
        "git_admin": str(git_dir(root).resolve()),
        "checkout": str(root.resolve()), "branch": branch(root), "head": git(root, "rev-parse", "HEAD").stdout.strip(),
        "record_sha256": hashlib.sha256(raw).hexdigest(), "legacy": legacy})
    unresolved = (sum(item["state"] != "completed" for item in legacy["operations"])
                  if legacy["store_present"] else None)
    return path, record, raw, digest, unresolved, native


def removal_path(root, value):
    if (not isinstance(value, str) or not value or len(value) > 4096
            or any(char in value for char in ("\0", "\n", "\r")) or "://" in value
            or PurePosixPath(value).is_absolute() or ".." in PurePosixPath(value).parts
            or str(PurePosixPath(value)) == "."):
        fail("unclassifiable removal path")
    path = root / value
    if not path_within(path.resolve(), root):
        fail("removal path escapes checkout")
    return path


def removal_dvc_paths(root, value):
    if not isinstance(value, dict) or set(value) - {"committed", "uncommitted", "unchanged", "not_in_cache", "untracked"}:
        fail("unclassifiable DVC status")
    if value.get("committed") or value.get("untracked"):
        fail("DVC data requires explicit disposition")
    changes = value.get("uncommitted", {})
    if not isinstance(changes, dict) or set(changes) - {"deleted"}:
        fail("modified DVC data requires explicit disposition")
    for paths in (changes.get("deleted", []), value.get("not_in_cache", [])):
        if not isinstance(paths, list) or len(paths) > 10000:
            fail("unclassifiable DVC status")
        for name in paths:
            if os.path.lexists(removal_path(root, name)):
                fail("present DVC data lacks preservation evidence")
    unchanged = value.get("unchanged", [])
    if not isinstance(unchanged, list) or len(unchanged) > 10000:
        fail("unclassifiable DVC status")
    for name in unchanged:
        removal_path(root, name)
    return unchanged


def preservation_output(child, *, limit, timeout):
    """Read both pipes under one byte/time budget; never return partial evidence."""
    buffers, observed = (bytearray(), bytearray()), 0
    deadline = time.monotonic() + timeout
    try:
        with selectors.DefaultSelector() as selector:
            for index, stream in enumerate((child.stdout, child.stderr)):
                selector.register(stream, selectors.EVENT_READ, index)
            while selector.get_map():
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    fail("native preservation evidence unavailable")
                for key, _ in selector.select(remaining):
                    block = os.read(key.fd, 65536)
                    if not block:
                        selector.unregister(key.fileobj)
                        continue
                    observed += len(block)
                    if observed > limit:
                        fail("native preservation evidence unavailable")
                    buffers[key.data].extend(block)
        child.wait(timeout=max(0.001, deadline - time.monotonic()))
        return bytes(buffers[0]), bytes(buffers[1])
    except BaseException:
        try:
            os.killpg(child.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        child.wait(timeout=2)
        raise
    finally:
        child.stdout.close()
        child.stderr.close()


def workspace_processes(root):
    program = shutil.which("lsof")
    if program is None:
        fail("process inventory unavailable")
    child = subprocess.Popen([program, "-a", "-u", str(os.getuid()), "-F0pn"], stdin=subprocess.DEVNULL,
                             stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=INSPECT_ENV, start_new_session=True)
    output, errors = preservation_output(child, limit=8 * 1024 * 1024, timeout=30)
    if child.returncode not in (0, 1) or errors or not output:
        fail("process inventory unavailable")
    ignored = {os.getpid(), child.pid}
    found, process = set(), None
    for field in output.split(b"\0"):
        field = field.lstrip(b"\n")
        if field.startswith(b"p"):
            if not field[1:].isdigit() or len(field) > 12 or int(field[1:]) <= 0:
                fail("process inventory unavailable")
            process = int(field[1:])
        elif field.startswith(b"f"):
            # lsof emits descriptor fields even when only p/n are requested.
            if process is None or not re.fullmatch(rb"f(?:\d+|cwd|twd|rtd|txt|mem|mmap|pd|jld|ltx|tr|v86|fp\.|M\d+)", field):
                fail("process inventory unavailable")
        elif field.startswith(b"n"):
            if process is None:
                fail("process inventory unavailable")
            name = os.fsdecode(field[1:]).removesuffix(" (deleted)")
            if process not in ignored and name.startswith("/") and path_within(Path(name), root):
                found.add(process)
        elif field:
            fail("process inventory unavailable")
    if process is None:
        fail("process inventory unavailable")
    return sorted(found)


def removal_run(root, argv, *, input_text=None, accepted=(0,)):
    is_dvc = argv[0] == "dvc"
    environment = {**INSPECT_ENV, "DVC_NO_ANALYTICS": "1"} if is_dvc else INSPECT_ENV
    if is_dvc:
        helper = Path(__file__).resolve().with_name(
            "executable_managed-dvc" if Path(__file__).name.startswith("executable_") else "managed-dvc")
        argv = [sys.executable, "-I", str(helper), *argv[1:]]
    payload = input_text.encode() if input_text is not None else b""
    if len(payload) > 1024 * 1024:
        fail("native preservation evidence unavailable")
    with tempfile.TemporaryFile() if input_text is not None else contextlib.nullcontext(None) as source:
        if source is not None:
            source.write(payload)
            source.seek(0)
        try:
            child = subprocess.Popen(argv, cwd=root, env=environment, stdin=source or subprocess.DEVNULL,
                                     stdout=subprocess.PIPE, stderr=subprocess.PIPE, start_new_session=True)
            output, errors = preservation_output(child, limit=1024 * 1024, timeout=60)
        except (OSError, subprocess.SubprocessError, RuntimeError):
            if is_dvc:
                raise DVCCommandUnavailable("dvc_command_unavailable") from None
            raise
    if child.returncode not in accepted or errors.strip():
        if is_dvc:
            category = errors.decode("utf-8", errors="replace").strip().removeprefix("managed-dvc: ")
            if child.returncode != 78 or category not in {
                    "managed_dvc_runtime_unavailable", "managed_dvc_runtime_unqualified", "managed_dvc_backend_unavailable"}:
                category = "dvc_command_failed"
            raise DVCCommandUnavailable(category)
        fail("native preservation evidence unavailable")
    return output.decode("utf-8")


def removal_reservation(root):
    """Verify the inherited open description; neither its body nor its lock is consent."""
    value = os.environ.get("DBSCTR_REMOVAL_FD", "")
    if not re.fullmatch(r"[0-9]{1,10}", value):
        fail("removal_reservation_unavailable")
    descriptor = int(value)
    if descriptor > 2147483647:
        fail("removal_reservation_unavailable")
    common, admin = common_git_dir(root).resolve(), git_dir(root).resolve()
    directory = common / "agent-worktree-locks"
    if not safe_directory(common, directory):
        fail("removal_reservation_unavailable")
    if directory.stat().st_mode & 0o022:
        fail("removal_reservation_unavailable")
    path = directory / (hashlib.sha256(str(admin).encode()).hexdigest() + ".lock")
    details, named = os.fstat(descriptor), path.lstat()
    if (not stat.S_ISREG(details.st_mode) or details.st_uid != os.getuid()
            or details.st_nlink != 1 or stat.S_IMODE(details.st_mode) != 0o600
            or not stat.S_ISREG(named.st_mode)
            or (details.st_dev, details.st_ino) != (named.st_dev, named.st_ino)
            or details.st_size > 8192):
        fail("removal_reservation_unavailable")
    contender = os.open(path, os.O_RDWR | os.O_NONBLOCK | getattr(os, "O_NOFOLLOW", 0))
    try:
        other = os.fstat(contender)
        if (other.st_dev, other.st_ino) != (details.st_dev, details.st_ino):
            fail("removal_reservation_unavailable")
        try:
            fcntl.flock(contender, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            pass
        else:
            fail("removal_reservation_unavailable")
        # A separate open would also block here. Never unlock the inherited description.
        fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
    finally:
        os.close(contender)
    raw = os.pread(descriptor, 8193, 0)
    body = json.loads(raw, object_pairs_hook=no_duplicate_keys)
    fields = {"schema_version", "operation", "attempt_id", "worktree", "common_git_dir",
              "git_dir", "branch", "head", "expected_state_digest", "outcome"}
    if not isinstance(body, dict) or set(body) != fields:
        fail("removal_reservation_unavailable")
    attempt = uuid.UUID(body["attempt_id"])
    expected = body["expected_state_digest"]
    if (type(body["schema_version"]) is not int or body["schema_version"] != 1
            or body["operation"] != "remove" or attempt.version != 4
            or str(attempt) != body["attempt_id"]
            or body["worktree"] != str(root.resolve()) or body["common_git_dir"] != str(common)
            or body["git_dir"] != str(admin) or body["branch"] != "refs/heads/" + (branch(root) or "")
            or body["head"] != git(root, "--no-replace-objects", "rev-parse", "HEAD").stdout.strip()
            or body["outcome"] not in {"preflight", "started"}
            or expected is not None and (not isinstance(expected, str) or not re.fullmatch(r"[0-9a-f]{64}", expected))
            or body["outcome"] == "started" and expected is None
            or raw != os.pread(descriptor, 8193, 0)):
        fail("removal_reservation_unavailable")
    return body


def removal_default_predicates(root, records, observation):
    """Source oracle only, NOT a runtime attestation or a public evidence input.

    The invoking CLI cannot yet qualify a complete fresh default/PR observation.
    Synthetic fixtures exercise these predicates without granting that capability.
    """
    reasons = []
    primary = primary_worktree(root)
    try:
        repository, remote, default, head = (observation[key] for key in ("repository", "remote", "default", "head"))
        initiative_repository(repository, "retirement repository")
        if (not isinstance(remote, str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,127}", remote)
                or not isinstance(default, str)
                or git(root, "--no-replace-objects", "check-ref-format", "refs/heads/" + default, check=False).returncode
                or not isinstance(head, str) or not re.fullmatch(r"[0-9a-f]{40}(?:[0-9a-f]{24})?", head)
                or not records):
            fail("git_default_unavailable")
        if (observation["repository_after"] != repository or observation["default_after"] != default
                or observation["head_after"] != head or observation["fetched_head"] != head):
            reasons.append("git_default_changed")
        if (status_paths(primary) or branch(primary) != default
                or upstream(primary) != remote + "/" + default
                or git(primary, "--no-replace-objects", "rev-parse", "HEAD").stdout.strip() != head):
            reasons.append("primary_not_synchronized")
        for record in records:
            delivery = record["delivery"]
            pull = observation["pull_requests"][str(delivery["pull_request"]["number"])]
            expected = record["commits"][-1]["id"]
            if (delivery["github"]["repository"] != repository or delivery["remote"] != remote
                    or record["git"]["remote"] != remote_destination(root, record["git"]["upstream"])
                    or pull["url"] != delivery["pull_request"]["url"]
                    or pull["number"] != delivery["pull_request"]["number"]
                    or pull["repository"] != repository or pull["state"] != "MERGED"
                    or pull["headRefName"] != delivery["branch"] or pull["headRefOid"] != expected
                    or pull["baseRefName"] != delivery["base_branch"]):
                reasons.append("pr_delivery_unverified")
            obligations = [git(root, "--no-replace-objects", "rev-parse", "HEAD").stdout.strip(),
                           record["git"]["head"], record["worktree"]["base_commit"],
                           *record["git"]["pre_cycle_ahead_commits"],
                           *(entry["id"] for entry in record["commits"]), pull["mergeCommit"]["oid"]]
            for commit in obligations:
                if (not isinstance(commit, str) or not re.fullmatch(r"[0-9a-f]{40}(?:[0-9a-f]{24})?", commit)
                        or git(root, "--no-replace-objects", "merge-base", "--is-ancestor", commit, head,
                               check=False).returncode):
                    reasons.append("ultimate_default_ancestry_unverified")
    except (RuntimeError, OSError, ValueError, TypeError, KeyError, IndexError, subprocess.SubprocessError):
        reasons.append("git_default_unavailable")
    return sorted(set(reasons))


def workspace_remove_check(root):
    root = root.resolve()
    selected = "DBSCTR_REMOVAL_FD" in os.environ
    records, repository, unavailable = [], None, False
    try:
        with inventory_budget(5):
            repository = inventory_repository(root)
            summaries, unavailable = inventory_cycles(repository)
            admin = str(git_dir(root).resolve())
            ids = {value["id"] for (kind, binding), value, _ in summaries
                   if kind == "admin" and binding == admin or kind == "path" and binding == str(root)}
            for path, _ in repository["files"]:
                if path.stem in ids:
                    records.append(read_cycle_record(root, path, historical=True, max_bytes=1024 * 1024))
            selected |= any((record.get("initiative") or {}).get("initiative_id") == "dbsctr-workflow-convergence"
                            for record in records)
    except (RuntimeError, OSError, ValueError, TypeError, KeyError, TimeoutError, subprocess.SubprocessError):
        unavailable = True
    if any(local_only_cycle(record) for record in records):
        return {"schema_version": 2, "eligible": False,
                "reasons": ["unpublished_local_completion"],
                "state_digest": None, "reservation_id": None}
    if not selected:
        return legacy_workspace_remove_check(root)
    result = {"schema_version": 2, "eligible": False, "reasons": [],
              "state_digest": None, "reservation_id": None}
    try:
        reservation = removal_reservation(root)
    except (RuntimeError, OSError, ValueError, TypeError, KeyError, AttributeError, subprocess.SubprocessError):
        result["reasons"] = ["removal_reservation_unavailable"]
        return result
    result["reservation_id"] = reservation["attempt_id"]
    reasons = result["reasons"]
    # No CLI argument, historical runtime record, PID, lock or digest authenticates
    # the live invoking conversation. Qualification must precede any activation.
    reasons.extend(["ownership_unavailable", "native_handoff_unavailable", "git_default_unavailable",
                    "native_removal_coordination_unavailable"])
    if unavailable:
        reasons.append("cycle_evidence_unavailable")
    if not records:
        reasons.append("cycle_records_unknown")
    try:
        policy = preservation_policy_snapshot(root)
        if policy is None or policy["consent"].get("automatic_remove") is not True:
            reasons.append("automatic_remove_not_approved")
        for record in records:
            if record.get("state") != "completed":
                reasons.append("cycle_not_completed")
            if (not native_workspace_execution(record) or record["execution"]["origin"] != "registered"
                    or record.get("preservation_policy") is None
                    or record.get("preservation_policy") != policy):
                reasons.append("birth_policy_unavailable_or_changed")
            verify_native_workspace_backup(root, record)
            if (not isinstance(record["commits"], list)
                    or any(not isinstance(entry, dict) or not isinstance(entry.get("id"), str)
                           or not re.fullmatch(r"[0-9a-f]{40}(?:[0-9a-f]{24})?", entry["id"])
                           or not isinstance(entry.get("gates"), list) or not set(entry["gates"]) <= set(GATES)
                           for entry in record["commits"])):
                fail("incomplete_cycle_evidence")
            if (record["worktree"]["branch"] != branch(root) or not record["commits"]
                    or set(record["gates"]) != set(GATES)
                    or any(record["gates"][name].get("applicability") != "required" for name in MANDATORY_GATES)
                    or any(gate.get("applicability") not in {"required", "not_applicable"}
                           or gate.get("applicability") == "required" and gate.get("result") != "passed"
                           for gate in record["gates"].values())):
                reasons.append("incomplete_cycle_evidence")
            for name, gate in record["gates"].items():
                if gate.get("applicability") == "required":
                    item = verify_envelope(root, record, name, require_bound=True, require_head=False)
                    if not any(entry["id"] == item["commit"] and name in entry["gates"]
                               for entry in record["commits"]):
                        reasons.append("incomplete_cycle_evidence")
                elif gate.get("result") != "not_run" or not gate.get("reason"):
                    reasons.append("incomplete_cycle_evidence")
            completed = datetime.fromisoformat(record["completed_at"].replace("Z", "+00:00"))
            if completed.utcoffset() != timedelta(0) or completed > datetime.now(timezone.utc):
                reasons.append("incomplete_cycle_evidence")
            completion_artifact_check(record)
        legacy = legacy_workspace_remove_check(root, strict=True, immediate=not reasons)
        reasons.extend(legacy["reasons"])
        # Source digests are observations, never permission or live-actor evidence.
        state = {"reservation": {k: v for k, v in reservation.items() if k not in {"expected_state_digest", "outcome"}},
                 "repository": repository, "records": records, "policy": policy,
                 "status": git(root, "--no-replace-objects", "status", "--porcelain=v1", "-z").stdout,
                 "ignored": removal_run(root, ["git", "ls-files", "--others", "--ignored", "--exclude-standard", "-z"]),
                 "primary": {"path": str(primary_worktree(root)), "branch": branch(primary_worktree(root)),
                             "upstream": upstream(primary_worktree(root)),
                             "head": git(primary_worktree(root), "--no-replace-objects", "rev-parse", "HEAD").stdout.strip(),
                             "status": status_paths(primary_worktree(root))}, "reasons": sorted(set(reasons))}
        # inventory_repository contains Path source entries; serialize their identity explicitly.
        if repository is not None:
            state["repository"] = {k: v for k, v in repository.items() if k != "files"}
        result["state_digest"] = continuation_digest(state)
        if reservation["expected_state_digest"] not in {None, result["state_digest"]}:
            reasons.append("removal_state_changed")
    except (RuntimeError, OSError, ValueError, TypeError, KeyError, AttributeError, subprocess.SubprocessError):
        reasons.append("removal_evidence_unavailable")
    result["reasons"] = sorted(set(reasons))
    return result


def legacy_workspace_remove_check(root, *, strict=False, immediate=False):
    root = root.resolve()
    reasons, related, commits, candidates, preservation_records = [], [], [], [], []
    if root == primary_worktree(root) or root not in {Path(row["worktree"]).resolve() for row in git_worktrees(root)}:
        return {"schema_version": 1, "eligible": False, "reasons": ["not_registered_task_checkout"]}
    if status_paths(root):
        reasons.append("dirty_worktree")
    try:
        for index, path in enumerate((cycle_dir(root) / "cycles").glob("*.json")):
            if index >= 10000:
                fail("cycle inventory bound")
            record = read_cycle_record(root, path, historical=True)
            matches = (native_git_directory(root, record) == git_dir(root).resolve()
                       if native_workspace_execution(record) else record_worktree(root, record, bindings=False) == root)
            if not matches:
                continue
            related.append(record["cycle_id"])
            if local_only_cycle(record):
                return {"schema_version": 1, "eligible": False,
                        "reasons": ["unpublished_local_completion"], "cycle_ids": related}
            if record.get("state") in {"active", "finalizing"}:
                reasons.append("active_cycle")
                continue
            if record.get("state") not in {"completed", "retired"}:
                fail("unclassified cycle state")
            if record["state"] == "completed":
                completed = datetime.fromisoformat(record["completed_at"].replace("Z", "+00:00"))
                if not (strict and immediate) and datetime.now(timezone.utc) - completed < timedelta(hours=24):
                    reasons.append("retained_24_hours")
                if any(gate.get("applicability") == "required" and gate.get("result") != "passed"
                       and not valid_gate_exception(gate) for gate in record["gates"].values()):
                    reasons.append("incomplete_cycle_evidence")
            commits.extend(entry["id"] for entry in record["commits"])
            if record.get("dvc_preservation"):
                preservation_records.append(record)
            delivery = record.get("delivery", {})
            if delivery.get("remote"):
                if record["git"]["remote"] != remote_destination(root, record["git"]["upstream"]):
                    reasons.append("delivery_destination_changed")
                for name in (delivery.get("branch"), delivery.get("base_branch")):
                    if name:
                        candidates.append(f"{delivery['remote']}/{name}")
    except (RuntimeError, OSError, ValueError, TypeError, KeyError):
        reasons.append("cycle_evidence_unavailable")
    primary = primary_worktree(root)
    candidates.extend(filter(None, (upstream(root), upstream(primary))))
    if not candidates and branch(primary):
        candidates.append("refs/heads/" + branch(primary))
    # Strict mode cannot promote the legacy feature/upstream candidate proof into
    # ultimate-default evidence. The source-only caller retains its typed blocker.
    preserved = strict
    for candidate in (() if strict else dict.fromkeys(candidates)):
        try:
            remote, name = remote_for_upstream(root, candidate)
            if remote:
                fields = removal_run(root, ["git", "ls-remote", "--exit-code", "--heads", remote,
                                            f"refs/heads/{name}"]).split()
                local = git(root, "rev-parse", candidate).stdout.strip()
                if fields != [local, f"refs/heads/{name}"]:
                    continue
            if all(git(root, "merge-base", "--is-ancestor", revision, candidate,
                       check=False).returncode == 0 for revision in ["HEAD", *commits]):
                preserved = True
                break
        except (RuntimeError, OSError, subprocess.SubprocessError):
            continue
    if not preserved:
        reasons.append("git_delivery_unverified")
    try:
        ignored = list(filter(None, removal_run(root, ["git", "ls-files", "--others", "--ignored", "--exclude-standard", "-z"]).split("\0")))
        if len(ignored) > 10000:
            fail("ignored file inventory bound")
        data_roots = []
        metadata = removal_run(root, ["git", "ls-files", "-z"]).split("\0") if strict else []
        if (root / ".dvc").exists() or (root / "dvc.yaml").exists() or any(name.endswith(".dvc") for name in metadata):
            if (root / ".dvc").is_symlink():
                fail("unsafe DVC metadata")
            status = json.loads(removal_run(root, ["dvc", "data", "status", "--unchanged", "--json"]),
                                object_pairs_hook=no_duplicate_keys)
            data_roots = [removal_path(root, name) for name in removal_dvc_paths(root, status)]
            if strict and not data_roots:
                fail("declared DVC obligations require disposition")
            if any(path.is_dir() for path in data_roots):
                reasons.append("remote_directory_closure_unverified")
            elif data_roots and not verified_preservation_outputs(root, preservation_records, data_roots):
                reasons.append("remote_file_preservation_unverified")
            cache = Path(removal_run(root, ["dvc", "cache", "dir"]).strip()).expanduser()
            cache = (cache if cache.is_absolute() else root / cache).resolve()
            if path_within(cache, root) and cache.exists() and any(cache.iterdir()):
                fail("private cache requires disposition")
            if data_roots and path_within(cache, root):
                fail("materialized data requires a retained external cache")
        data_files = []
        for name in ignored:
            path = removal_path(root, name)
            if any(path == output or output in path.parents for output in data_roots):
                data_files.append(name)
            elif name == ".dvc/config.local":
                config = configparser.ConfigParser(interpolation=None)
                if path.is_symlink() or path.stat().st_size > 65536:
                    fail("unsafe DVC configuration")
                config.read_string(path.read_text())
                if config.defaults() or set(config.sections()) - {"cache"} or set(config["cache"]) - {"dir", "type"}:
                    fail("local configuration requires disposition")
            elif name in {".dvc/tmp/btime", ".dvc/tmp/lock", ".dvc/tmp/rwlock.lock"}:
                raw = path.read_bytes() if path.stat().st_size <= 64 else b"invalid"
                if path.is_symlink() or not re.fullmatch(rb"\s*\d*\s*", raw):
                    fail("unknown DVC internal state")
            else:
                fail("unknown ignored data requires disposition")
        if data_files and removal_run(root, ["dvc", "check-ignore", "--stdin"],
                                     input_text="\n".join(data_files) + "\n", accepted=(0, 1)).strip():
            fail("DVC-ignored output contents require disposition")
    except DVCCommandUnavailable as error:
        reasons.append(str(error))
    except (RuntimeError, OSError, ValueError, TypeError, KeyError, configparser.Error, subprocess.SubprocessError):
        reasons.append("data_disposition_required")
    try:
        if workspace_processes(root):
            reasons.append("running_processes")
    except (RuntimeError, OSError, subprocess.SubprocessError):
        reasons.append("process_inventory_unavailable")
    return {"schema_version": 1, "eligible": not reasons, "reasons": sorted(set(reasons))}


def command_workspace_remove_check(args):
    result = workspace_remove_check(root_dir())
    print(json.dumps(result, sort_keys=True))
    if not result["eligible"]:
        raise SystemExit(1)


def orphan_recovery_snapshot(root, cycle_id, successor_id):
    for identifier in (cycle_id, successor_id):
        if not isinstance(identifier, str) or not OPAQUE_ID.fullmatch(identifier):
            fail("invalid orphan recovery cycle ID")
    if cycle_id == successor_id:
        fail("orphan recovery requires a different completed successor")
    directory = cycle_dir(root) / "cycles"
    managed_directory(root, directory)
    paths = [directory / f"{identifier}.json" for identifier in (cycle_id, successor_id)]
    raw = []
    records = []
    for path in paths:
        continuation_private(path)
        with path.open("rb") as stream:
            data = stream.read(8 * 1024 * 1024 + 1)
        if len(data) > 8 * 1024 * 1024:
            fail("orphan recovery record exceeds its bound")
        raw.append(data)
        records.append(json.loads(data, object_pairs_hook=no_duplicate_keys))
    record, successor = records
    details = record.get("worktree", {})
    if (record.get("cycle_id") != cycle_id or record.get("schema_version") != 4
            or record.get("state") != "active" or record.get("execution") is not None
            or record.get("commits") != [] or record.get("retirement") is not None
            or details.get("branch") is not None or details.get("created_by_dbsctr") is not False
            or details.get("locator") != {"root": "cycle_worktree", "path": "."}
            or record.get("source") is not None):
        fail("orphan recovery requires an unbound empty legacy detached record")
    baseline = details.get("base_commit")
    if (not isinstance(baseline, str) or not re.fullmatch(r"[0-9a-f]{40}", baseline)
            or record.get("git", {}).get("head") != baseline):
        fail("orphan recovery baseline is invalid")
    if (successor.get("cycle_id") != successor_id or successor.get("state") != "completed"
            or not record.get("context") or successor.get("context") != record["context"]
            or not successor.get("commits")):
        fail("orphan recovery requires a completed same-context successor")
    for commit in successor["commits"]:
        value = commit.get("id")
        if (not isinstance(value, str) or not re.fullmatch(r"[0-9a-f]{40}", value)
                or git(root, "merge-base", "--is-ancestor", value, "HEAD", check=False).returncode):
            fail("orphan recovery successor is not integrated into this checkout")
    worktrees = git_worktrees(root)
    if any(not item.get("branch") and item.get("HEAD") == baseline for item in worktrees):
        fail("orphan recovery found a possible original detached checkout")
    digest = continuation_digest({"before": hashlib.sha256(raw[0]).hexdigest(),
        "successor": hashlib.sha256(raw[1]).hexdigest(), "worktrees": worktrees})
    return paths[0], record, raw[0], digest


def command_workspace_recover_orphan(args):
    root = root_dir().resolve()
    path, record, raw, digest = orphan_recovery_snapshot(root, args.cycle_id, args.superseded_by)
    if args.preview:
        print(json.dumps({"cycle_id": args.cycle_id, "superseded_by": args.superseded_by,
            "state_digest": digest, "requires_operator_confirmation": True,
            "effect": "retire_record_only_preserve_all_worktrees_and_evidence"}, sort_keys=True))
        return
    if args.expected_state != digest:
        fail("orphan recovery state changed; request a fresh preview")
    if not sys.stdin.isatty():
        fail("orphan recovery requires interactive operator confirmation")
    confirmation = f"RETIRE-ORPHAN {args.cycle_id} {digest}"
    print("Confirm this empty detached registration was superseded, and its old writers/jobs "
          "cannot write. No worktree, branch, history or failed evidence will be removed.\n"
          f"Type {confirmation}: ", end="", file=sys.stderr, flush=True)
    if sys.stdin.readline(512).strip() != confirmation:
        fail("orphan recovery confirmation declined")
    with evidence_lock(root, args.cycle_id, timeout=2):
        path, record, raw, current = orphan_recovery_snapshot(root, args.cycle_id, args.superseded_by)
        if current != digest:
            fail("orphan recovery state changed; request a fresh preview")
        before = hashlib.sha256(raw).hexdigest()
        backup = cycle_dir(root) / "migrations" / f"{args.cycle_id}.{before}.orphan-before.json"
        managed_directory(root, backup.parent, create=True)
        try:
            descriptor = os.open(backup, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        except FileExistsError:
            continuation_private(backup)
            if backup.read_bytes() != raw:
                fail("orphan recovery preimage conflicts")
        else:
            with os.fdopen(descriptor, "wb") as stream:
                stream.write(raw)
                stream.flush()
                os.fsync(stream.fileno())
        fsync_directory(backup.parent)
        record["state"] = "retired"
        record["retired_at"] = now()
        record["retirement"] = {"state": "retired", "disposition": "superseded",
            "method": "interactive_orphan_recovery", "superseded_by": args.superseded_by,
            "state_digest": digest, "before_sha256": before,
            "record_backup": backup.relative_to(common_git_dir(root)).as_posix(),
            "worktree_removed": False}
        private_json(path, record)
        fsync_directory(path.parent)
    print(json.dumps({"cycle_id": args.cycle_id, "state": "retired", "worktree_removed": False}))


def command_workspace_adopt(args):
    root = root_dir().resolve()
    path, record, raw, digest, unresolved, native = workspace_adoption_snapshot(root, args.cycle_id)
    if args.preview:
        print(json.dumps({"schema_version": 1, "cycle_id": args.cycle_id, "state_digest": digest,
            "already_native": native, "unresolved_legacy_operations": unresolved,
            "requires_operator_confirmation": not native}, sort_keys=True))
        return
    if native:
        fail("cycle is already native; inspect and resume it without repeated adoption")
    if args.expected_state != digest:
        fail("workspace adoption state changed; request a fresh preview")
    if not sys.stdin.isatty():
        fail("workspace adoption requires interactive operator confirmation")
    confirmation = f"ADOPT {args.cycle_id} {digest}"
    history = ("legacy operation history is absent, not proven complete" if unresolved is None
               else f"{unresolved} unresolved operations remain historical")
    print(f"Confirm old writers/jobs cannot write and {history}.\n"
          f"Type {confirmation}: ", end="", file=sys.stderr, flush=True)
    if sys.stdin.readline(512).strip() != confirmation:
        fail("workspace adoption confirmation declined")
    with evidence_lock(root, args.cycle_id, timeout=2):
        path, record, raw, current, _, native = workspace_adoption_snapshot(root, args.cycle_id)
        if current != digest or native:
            fail("workspace adoption state changed; request a fresh preview")
        before = hashlib.sha256(raw).hexdigest()
        backup = cycle_dir(root) / "migrations" / f"{args.cycle_id}.{before}.native-before.json"
        managed_directory(root, backup.parent, create=True)
        try:
            descriptor = os.open(backup, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        except FileExistsError:
            continuation_private(backup)
            with backup.open("rb") as stream:
                if stream.read(len(raw) + 1) != raw:
                    fail("workspace adoption preimage conflicts; preserve and inspect it")
        else:
            with os.fdopen(descriptor, "wb") as stream:
                stream.write(raw)
                stream.flush()
                os.fsync(stream.fileno())
        fsync_directory(backup.parent)
        if record["schema_version"] in (4, 5):
            record["worktree"]["git_dir"] = git_dir(root).resolve().relative_to(common_git_dir(root).resolve()).as_posix()
        record["execution"] = {"schema_version": 1, "mode": "native_workspace", "origin": "adopted",
            "attribution": {"status": "unavailable", "reason": "native_identity_not_collected"},
            "adoption": {"before_sha256": before, "state_digest": digest,
                         "record_backup": backup.relative_to(common_git_dir(root)).as_posix()}}
        native_workspace_execution(record)
        private_json(path, record)
        fsync_directory(path.parent)
    print(json.dumps({"cycle_id": args.cycle_id, "adopted": True, "unresolved_legacy_operations": unresolved}))


def command_attach_runtime(args):
    root = root_dir().resolve()
    if args.opencode_message_id is None:
        fail("runtime attachment requires structured message identity")
    session_id = session_for_message(None, args.opencode_message_id, require_primary=True)
    if session_id != args.opencode_session_id:
        fail("OpenCode runtime session does not own the structured message")
    activation = (harness_activation_for_message(None, args.opencode_message_id, args.harness_activation_json)
                  if args.harness_activation_json is not None else None)
    if not OPAQUE_ID.fullmatch(session_id):
        fail("invalid OpenCode session ID")
    runtime_worktree = Path(args.opencode_worktree).resolve()
    runtime_directory = Path(args.opencode_directory).resolve()
    if (not runtime_worktree.is_dir() or not runtime_directory.is_dir()
            or runtime_worktree not in runtime_directory.parents and runtime_directory != runtime_worktree):
        fail("invalid OpenCode runtime paths")
    path, record = load(root)
    cycle_id = record["cycle_id"]
    with evidence_lock(root, cycle_id):
        path, record = load(root)
        if record["cycle_id"] != cycle_id:
            fail("active DBSCTR cycle changed during runtime attachment")
        require_active(record)
        recorded_worktree = record_worktree(root, record)
        if root != recorded_worktree:
            fail("active cycle worktree identity changed")
        source_worktree = record_source_worktree(root, record)
        opencode = record.setdefault("runtime", {}).setdefault("opencode", {})
        session_ids = opencode.setdefault("session_ids", [])
        if (not isinstance(session_ids, list) or len(session_ids) > REVIEW_MAX_LIMIT
                or not all(isinstance(value, str) and OPAQUE_ID.fullmatch(value) for value in session_ids)):
            fail("Cycle Record contains invalid OpenCode runtime metadata")
        attached = session_id not in session_ids
        if attached:
            if len(session_ids) == REVIEW_MAX_LIMIT:
                fail("Cycle Record OpenCode runtime limit reached")
            session_ids.append(session_id)
        existing_activation = opencode.get("harness_activation")
        if existing_activation is not None and activation is not None and existing_activation != activation:
            fail("attached root sessions disagree on harness activation")
        if existing_activation is None and activation is not None:
            opencode["harness_activation"] = activation
        if record.get("schema_version") in (4, 5) and runtime_worktree == root:
            opencode.update({"path_root": "cycle_worktree", "worktree": "."})
            if record.get("schema_version") == 5:
                opencode["directory"] = runtime_directory.relative_to(root).as_posix() or "."
        elif record.get("schema_version") in (4, 5) and runtime_worktree == source_worktree:
            opencode.update({"path_root": "primary_worktree", "worktree": "."})
            if record.get("schema_version") == 5:
                opencode["directory"] = runtime_directory.relative_to(source_worktree).as_posix() or "."
        elif record.get("schema_version") not in (4, 5) and runtime_worktree in {root, source_worktree}:
            opencode["worktree"] = str(runtime_worktree)
        else:
            fail("invalid OpenCode runtime paths")
        sync_schema5_opencode(record)
        if record.get("schema_version") == 5:
            validate_schema5_runtime(root, record)
        save(path, record)
    print(json.dumps({"cycle_id": record["cycle_id"], "attached": attached}, sort_keys=True,
                     separators=(",", ":")))


def sqlite_name(connection, table, choices):
    columns = {row[1].lower().replace("_", ""): row[1] for row in connection.execute(f"PRAGMA table_info({table})")}
    for choice in choices:
        if choice in columns:
            return columns[choice]
    fail(f"OpenCode {table} table lacks required columns")


def review_index(root):
    if ledger_exists(root):
        with ledger_connection(root) as connection:
            value = {"schema_version": 1, "sessions": {}, "cycles": {}, "forgotten_sessions": {}}
            names = {"session": "sessions", "cycle": "cycles", "forgotten_session": "forgotten_sessions"}
            for kind, item_id, timestamp in connection.execute(
                    "SELECT kind, item_id, timestamp FROM review_tombstones"):
                value[names[kind]][item_id] = timestamp
    else:
        path = root / "reviews" / "reviewed.json"
        if not path.exists():
            value = {"schema_version": 1, "sessions": {}, "cycles": {}, "forgotten_sessions": {}}
        else:
            try:
                private_legacy_file(root, path)
                value = json.loads(path.read_text(encoding="utf-8"), object_pairs_hook=no_duplicate_keys)
            except (OSError, json.JSONDecodeError) as error:
                fail(f"cannot read reviewed tombstones: {error}")
    if (not isinstance(value, dict) or set(value) != {"schema_version", "sessions", "cycles", "forgotten_sessions"}
            or value["schema_version"] != 1 or not isinstance(value["sessions"], dict)
            or not isinstance(value["cycles"], dict) or not isinstance(value["forgotten_sessions"], dict)):
        fail("reviewed tombstones have an invalid schema")
    for values in (value["sessions"], value["cycles"], value["forgotten_sessions"]):
        if not all(isinstance(key, str) and re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}", key)
                   and isinstance(timestamp, int) and timestamp >= REVIEW_START_MS
                   for key, timestamp in values.items()):
            fail("reviewed tombstones contain invalid entries")
    return value


def validate_review_report(report, marker_name, timestamp):
    path = Path(marker_name)
    text_fields = ("findings", "scorecards", "trends", "proposals", "caveats")
    allowed = {"session_ids", "cycle_ids", "scan_digest", "snapshot", "session_ceiling", "part_ceiling", "database_digest",
               "limit", "cursor", "decision", "notes", "reviewed_at", *text_fields}
    required = {"session_ids", "scan_digest", "limit", "cursor", "decision"}
    if (not isinstance(report, dict) or set(report) - allowed or not required <= set(report)
            or not isinstance(report.get("session_ids"), list)
            or not isinstance(report.get("cycle_ids", []), list)
            or not 1 <= len(report["session_ids"]) <= REVIEW_MAX_LIMIT
            or len(report.get("cycle_ids", [])) > REVIEW_MAX_LIMIT
            or not all(isinstance(value, str) and OPAQUE_ID.fullmatch(value)
                       for value in report["session_ids"] + report.get("cycle_ids", []))
            or len(set(report["session_ids"])) != len(report["session_ids"])
            or len(set(report.get("cycle_ids", []))) != len(report.get("cycle_ids", []))
            or not isinstance(report.get("scan_digest"), str)
            or not re.fullmatch(r"[0-9a-f]{64}", report["scan_digest"])
            or not isinstance(report.get("decision"), str) or not 1 <= len(report["decision"].encode()) <= 256
            or report.get("notes") is not None and (not isinstance(report["notes"], str)
                                                     or len(report["notes"].encode()) > 2048)):
        fail("retained review report has an invalid schema")
    if (type(report["limit"]) is not int or not 1 <= report["limit"] <= REVIEW_MAX_LIMIT
            or type(report["cursor"]) is not int or report["cursor"] < 0):
        fail("retained review report has an invalid schema")
    for name in ("snapshot", "session_ceiling", "part_ceiling"):
        if name in report and (type(report[name]) is not int or report[name] < 0):
            fail("retained review report has an invalid schema")
    current = {"session_ceiling", "part_ceiling", "database_digest"} & set(report)
    if current and not {"reviewed_at", "snapshot", "session_ceiling", "part_ceiling", "database_digest"} <= set(report):
        fail("retained review report has an invalid schema")
    if "reviewed_at" in report and not current:
        fail("retained review report has an invalid schema")
    for name in text_fields:
        values = report.get(name, [])
        if not isinstance(values, list) or len(values) > 50 or not all(
                isinstance(value, str) and 1 <= len(value) <= 512 for value in values):
            fail("retained review report has an invalid schema")
    human = [str(report.get(name, "")) for name in ("decision", "notes")]
    human.extend(value for name in text_fields for value in report.get(name, []))
    if review_unsafe(" ".join(human)):
        fail("retained review report contains unsafe content")
    if not re.fullmatch(r"[0-9a-f]{24}\.json", path.name):
        fail("retained review report has an invalid marker name")
    expected = hashlib.sha256((report["scan_digest"] + "\0" + json.dumps(report, sort_keys=True)).encode()).hexdigest()[:24]
    if path.stem != expected:
        fail("retained review report marker does not match its content")
    if (not isinstance(timestamp, int) or timestamp < REVIEW_START_MS
            or timestamp > int(datetime.now(timezone.utc).timestamp() * 1000) + 1000):
        fail("retained review report has an invalid review timestamp")
    return report, timestamp


def read_review_report(path, root=None):
    try:
        if root is not None:
            private_legacy_file(root, path)
        report = json.loads(path.read_text(encoding="utf-8"), object_pairs_hook=no_duplicate_keys)
    except (OSError, json.JSONDecodeError) as error:
        fail(f"cannot read retained review report: {error}")
    return validate_review_report(report, path.name, report.get("reviewed_at", path.stat().st_mtime_ns // 1_000_000))


def review_reports(root):
    if ledger_exists(root):
        reports = []
        with ledger_connection(root) as connection:
            for report_id, payload, timestamp in connection.execute(
                    "SELECT report_id, payload, reviewed_at FROM review_reports ORDER BY report_id"):
                try:
                    report = json.loads(payload, object_pairs_hook=no_duplicate_keys)
                except json.JSONDecodeError as error:
                    fail(f"cannot read retained review report: {error}")
                report, timestamp = validate_review_report(report, f"{report_id}.json", timestamp)
                reports.append((None, report, timestamp))
        return reports
    directory = root / "reviews"
    if not directory.is_dir():
        return []
    reports = []
    for path in directory.glob("*.json"):
        if path.name == "reviewed.json":
            continue
        report, timestamp = read_review_report(path, root)
        reports.append((path, report, timestamp))
    return reports


def reviewed_ids_unlocked(root, cutoff=None):
    index = review_index(root)
    session_times = dict(index["sessions"])
    cycle_times = dict(index["cycles"])
    for _, report, timestamp in review_reports(root):
        for key in report["session_ids"]:
            session_times[key] = max(session_times.get(key, 0), timestamp)
        for key in report.get("cycle_ids", []):
            cycle_times[key] = max(cycle_times.get(key, 0), timestamp)
    sessions = {key for key, timestamp in session_times.items()
                if (cutoff is None or timestamp <= cutoff)
                and timestamp > (index["forgotten_sessions"].get(key, 0)
                                 if cutoff is None or index["forgotten_sessions"].get(key, 0) <= cutoff else 0)}
    cycles = {key for key, timestamp in cycle_times.items() if cutoff is None or timestamp <= cutoff}
    return sessions, cycles


def reviewed_ids(state_root, cutoff=None, lock=True):
    root = review_root(state_root)
    lock_path = root / "reviews" / ".lock"
    review_state = root / "reviews"
    if lock and review_state.is_dir() and (any(review_state.glob("*.json")) or ledger_exists(root)) and not lock_path.is_file():
        fail("retained review state is missing its lock")
    if lock and lock_path.is_file():
        with open_existing_review_lock(lock_path) as handle:
            fcntl.flock(handle, fcntl.LOCK_SH)
            return reviewed_ids_unlocked(root, cutoff)
    return reviewed_ids_unlocked(root, cutoff)


def update_review_index(root, sessions=(), cycles=(), timestamp=None, connection=None):
    value = review_index(root)
    timestamp = timestamp or int(datetime.now(timezone.utc).timestamp() * 1000)
    for key in sessions:
        value["sessions"][key] = max(value["sessions"].get(key, 0), timestamp)
    for key in cycles:
        value["cycles"][key] = max(value["cycles"].get(key, 0), timestamp)
    if ledger_exists(root):
        owned = connection is None
        connection = connection or ledger_connection(root, write=True)
        connection.executemany(
            "INSERT INTO review_tombstones VALUES (?, ?, ?) ON CONFLICT(kind, item_id) DO UPDATE SET timestamp=max(timestamp, excluded.timestamp)",
            [("session", key, value["sessions"][key]) for key in sessions]
            + [("cycle", key, value["cycles"][key]) for key in cycles],
        )
        if owned:
            connection.commit()
            connection.close()
    else:
        private_json(root / "reviews" / "reviewed.json", value)
    return value


def prune_review_reports(root, connection=None):
    cutoff_ms = int((time.time() - REVIEW_RETENTION_SECONDS) * 1000)
    if ledger_exists(root):
        owned = connection is None
        connection = connection or ledger_connection(root, write=True)
        expired = list(connection.execute(
            "SELECT report_id, payload, reviewed_at FROM review_reports WHERE reviewed_at <= ?", (cutoff_ms,)))
        for report_id, payload, timestamp in expired:
            report, _ = validate_review_report(json.loads(payload, object_pairs_hook=no_duplicate_keys),
                                               f"{report_id}.json", timestamp)
            update_review_index(root, report.get("session_ids", []), report.get("cycle_ids", []), timestamp,
                                connection=connection)
            connection.execute("DELETE FROM ledger_entries WHERE scope='operational' AND report_id=?", (report_id,))
            connection.execute("DELETE FROM review_reports WHERE report_id=?", (report_id,))
            record_knowledge_privacy_tombstone(
                connection, "review", report_id, "expired", max(timestamp, REVIEW_START_MS))
        if owned:
            connection.commit()
            connection.close()
        return len(expired)
    reports, malformed_expired = [], []
    directory = root / "reviews"
    for path in directory.glob("*.json") if directory.is_dir() else ():
        if path.name == "reviewed.json":
            continue
        try:
            report, timestamp = read_review_report(path, root)
            reports.append((path, report, timestamp))
        except RuntimeError:
            if path.stat().st_mtime_ns // 1_000_000 > cutoff_ms:
                raise
            malformed_expired.append(path)
    index = review_index(root)
    for _, report, timestamp in reports:
        for key in report.get("session_ids", []):
            index["sessions"][key] = max(index["sessions"].get(key, 0), timestamp)
        for key in report.get("cycle_ids", []):
            index["cycles"][key] = max(index["cycles"].get(key, 0), timestamp)
    index_path = root / "reviews" / "reviewed.json"
    if reports or index_path.exists():
        private_json(index_path, index)
    removed = 0
    for path, _, timestamp in reports:
        if timestamp <= cutoff_ms:
            path.unlink()
            removed += 1
    for path in malformed_expired:
        path.unlink()
        removed += 1
    if removed:
        descriptor = os.open(directory, os.O_RDONLY)
        try:
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
    return removed


def valid_gate_exception(gate):
    exception = gate.get("exception")
    if (not isinstance(exception, dict)
            or exception.get("kind") not in ("deferred", "accepted_risk")
            or not all(isinstance(exception.get(name), str) and exception[name].strip()
                       for name in ("rationale", "owner", "review_condition", "approved_at"))):
        return False
    try:
        approved_at = datetime.fromisoformat(exception["approved_at"].replace("Z", "+00:00"))
    except ValueError:
        return False
    return approved_at.utcoffset() == timedelta(0)


def correlated_cycles(directory, hinted_ids, session_ids=(), cache=None, exact_session_id=None,
                      with_quality=False):
    cache_key = str(directory or "")
    cached = cache.get(cache_key) if cache is not None else None
    if cached is None:
        record_dirs, resolved = [], None
        worktree = Path(directory) if directory else None
        if worktree and worktree.is_dir():
            common_result = git(worktree, "rev-parse", "--git-common-dir", check=False)
            top_result = git(worktree, "rev-parse", "--show-toplevel", check=False)
            if not common_result.returncode and not top_result.returncode:
                common = Path(common_result.stdout.strip())
                if not common.is_absolute():
                    common = worktree / common
                record_dirs.append(common.resolve() / "dbsctr/cycles")
                resolved = Path(top_result.stdout.strip()).resolve()
        local_records = any(directory_path.is_dir() and next(directory_path.glob("*.json"), None)
                            for directory_path in record_dirs)
        if not local_records:
            try:
                current_records = common_git_dir(root_dir()).resolve() / "dbsctr/cycles"
                if current_records not in record_dirs:
                    record_dirs.append(current_records)
            except RuntimeError:
                pass
        records = []
        paths = sorted({path for directory_path in record_dirs if directory_path.is_dir()
                        for path in directory_path.glob("*.json")})
        record_root = resolved or root_dir()
        for path in paths:
            try:
                record = read_cycle_record(record_root, path, historical=True)
                cycle_id = record.get("cycle_id")
                if not isinstance(cycle_id, str) or not OPAQUE_ID.fullmatch(cycle_id):
                    fail("Cycle Record contains an invalid cycle ID")
                record["_continuation"] = continuation_runtime(record_root, cycle_id)
                records.append(record)
            except (OSError, json.JSONDecodeError):
                continue
        cached = (resolved, records)
        if cache is not None:
            cache[cache_key] = cached
    resolved, records = cached
    def runtime_ids(record):
        values = record.get("runtime", {}).get("opencode", {}).get("session_ids", [])
        sessions = set(values) if isinstance(values, list) else set()
        if record.get("_continuation") is not None:
            sessions.update(record["_continuation"]["session_ids"])
        return sessions

    def unique(matches, quality):
        return (matches, quality) if len(matches) == 1 else ([], "ambiguous" if matches else None)

    def recorded_path(record, source=False):
        try:
            base = resolved or root_dir()
            return (record_source_worktree(base, record) if source
                    else record_worktree(base, record))
        except (OSError, RuntimeError, KeyError, TypeError, ValueError):
            return None

    exact_ids = {exact_session_id} if exact_session_id is not None else set(session_ids)
    exact = [record for record in records if exact_ids.intersection(runtime_ids(record))]
    hinted = [record for record in records if record["cycle_id"] in hinted_ids]
    if exact:
        matched, quality = exact, "exact" if len(exact) == 1 else "ambiguous"
    elif hinted:
        matched, quality = hinted, "exact" if len(hinted) == 1 else "ambiguous"
    else:
        family_ids = set(session_ids) - exact_ids
        family, family_quality = unique(
            [record for record in records if family_ids.intersection(runtime_ids(record))], "family"
        )
        worktrees = [record for record in records if resolved is not None
                     and recorded_path(record) == resolved]
        worktree, worktree_quality = unique(worktrees, "worktree")
        sources = [record for record in records if resolved is not None
                   and recorded_path(record, source=True) == resolved]
        source, source_quality = unique(sources, "source")
        matched, quality = next(((items, value) for items, value in (
            (family, family_quality), (worktree, worktree_quality), (source, source_quality)
        ) if items), ([], "ambiguous" if "ambiguous" in (family_quality, worktree_quality, source_quality)
                       else "unavailable"))
    if not matched:
        return ([], quality) if with_quality else []
    output = []
    for record in matched:
        cycle_worktree = recorded_path(record)
        gates = record.get("gates", {}).values()
        if any(gate.get("applicability") == "required"
               and gate.get("result") in ("failed", "unavailable")
               and not valid_gate_exception(gate) for gate in gates):
            state = "blocked"
        elif record.get("state") == "completed":
            state = "completed"
        elif record.get("state") == "active" and (cycle_worktree is None or not cycle_worktree.is_dir()):
            state = "abandoned"
        else:
            state = "active"
        risk = record.get("risk", "unavailable")
        delivery = record.get("delivery_intent", "unavailable")
        if risk not in ("routine", "elevated", "critical") or delivery not in DELIVERY_INTENTS:
            risk, delivery = "unavailable", "unavailable"
        item = {"cycle_id": record["cycle_id"], "state": state,
                "risk": risk, "delivery_intent": delivery}
        context = record.get("context")
        try:
            started = datetime.fromisoformat(record["created_at"].replace("Z", "+00:00"))
            started_at = int(started.timestamp() * 1000)
            ended_at = None
            if state == "completed":
                ended = datetime.fromisoformat(record["completed_at"].replace("Z", "+00:00"))
                ended_at = int(ended.timestamp() * 1000)
                if ended_at < started_at:
                    raise ValueError
            if isinstance(context, str) and OPAQUE_ID.fullmatch(context):
                item.update({"context": context, "started_at": started_at, "ended_at": ended_at})
        except (KeyError, TypeError, ValueError):
            pass
        if state == "completed":
            counters = record.get("metrics", {})
            cycle_metrics = {name: counters.get(name, 0) for name in (
                "gate_failure_count", "gate_reopen_count", "remediation_round_count")}
            if any(type(value) is not int or value < 0 for value in cycle_metrics.values()):
                fail("Cycle Record contains invalid metrics")
            elapsed = "unavailable"
            try:
                started = datetime.fromisoformat(record["created_at"].replace("Z", "+00:00"))
                completed = datetime.fromisoformat(record["completed_at"].replace("Z", "+00:00"))
                elapsed = max(0, int((completed - started).total_seconds() * 1000))
            except (KeyError, TypeError, ValueError):
                pass
            cycle_metrics["elapsed_ms"] = elapsed
            item["metrics"] = cycle_metrics
        activation = record.get("runtime", {}).get("opencode", {}).get("harness_activation")
        if record.get("_continuation") is not None:
            activation = record["_continuation"]["activation"]
        if activation is not None:
            item["harness_activation"] = validate_stored_harness_activation(activation)
        if "phase_profile" in record:
            item["phase_profile"] = validate_phase_profile(record["phase_profile"], record["cycle_id"])
        output.append(item)
    output = sorted(output, key=lambda item: item["cycle_id"])
    return (output, quality) if with_quality else output


def session_family_map(rows):
    adjacency = {}
    for row in rows:
        session_id, parent_id = str(row[0]), str(row[1]) if row[1] else None
        adjacency.setdefault(session_id, set())
        if parent_id:
            adjacency[session_id].add(parent_id)
            adjacency.setdefault(parent_id, set()).add(session_id)
    families, remaining = {}, set(adjacency)
    while remaining:
        member = remaining.pop()
        family, pending = {member}, [member]
        while pending:
            current = pending.pop()
            new = adjacency[current] - family
            family.update(new)
            pending.extend(new)
        remaining.difference_update(family)
        for session_id in family:
            families[session_id] = family
    return families


def review_attention(cycles, timestamp, snapshot):
    return (["dormant"] if any(item["state"] == "active" for item in cycles)
            and snapshot - timestamp >= REVIEW_DORMANT_MS else [])


def review_priority(item):
    rank = {"blocked": 0, "abandoned": 1, "completed": 3, "active": 4}
    values = [rank[cycle["state"]] for cycle in item["cycles"]]
    if "dormant" in item["attention"]:
        values.append(2)
    return min(values, default=5)


def history_source_index_path(root):
    return root / "reviews/history-source-index.sqlite3"


def history_source_refresh_lock(root):
    path = root / "reviews/.history-source-index-refresh.lock"
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(path.parent, 0o700)
    private_path(path.parent, stat.S_IFDIR, 0o700, "review directory")
    descriptor = os.open(path, os.O_RDWR | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0), 0o600)
    details = os.fstat(descriptor)
    if stat.S_IFMT(details.st_mode) != stat.S_IFREG or details.st_uid != os.getuid():
        os.close(descriptor)
        fail("history source refresh lock is unsafe")
    os.fchmod(descriptor, 0o600)
    return os.fdopen(descriptor, "a+", encoding="utf-8")


def history_privacy_epoch_digest(root):
    index = review_index(root)
    identity = {"schema_version": 1, "forgotten_sessions": sorted(index["forgotten_sessions"].items())}
    return hashlib.sha256(ledger_payload(identity).encode()).hexdigest()


def history_source_layout(database, connection=None):
    if not database.is_file() or database.is_symlink():
        fail("OpenCode database is missing or unsafe")
    details = database.stat()
    owned_connection = connection is None
    try:
        connection = connection or sqlite3.connect(f"file:{database}?mode=ro", uri=True)
        tables = {row[0].lower(): row[0] for row in connection.execute(
            "SELECT name FROM sqlite_master WHERE type='table'")}
        if not {"session", "message", "part"} <= set(tables):
            fail("OpenCode database lacks required session/message/part tables")
        session, message, part = (tables[name] for name in ("session", "message", "part"))
        def mapped(table):
            return {row[1].lower().replace("_", ""): row[1]
                    for row in connection.execute(f'PRAGMA table_info("{table}")')}

        session_columns, message_columns, part_columns = map(mapped, (session, message, part))
        def required(columns, names, label):
            value = next((columns[name] for name in names if name in columns), None)
            if value is None:
                fail(f"OpenCode {label} column is missing")
            return value

        session_id = required(session_columns, ("id",), "session identity")
        session_time = required(session_columns, ("timecreated", "createdat", "time", "timestamp"),
                                "session timestamp")
        message_id = required(message_columns, ("id",), "message identity")
        message_session = required(message_columns, ("sessionid", "session"), "message session identity")
        message_time = required(message_columns, ("timecreated", "createdat", "time", "timestamp"),
                                "message timestamp")
        message_body = required(message_columns, ("data", "text", "content"), "message body")
        part_id = required(part_columns, ("id",), "part identity")
        part_message = required(part_columns, ("messageid", "message"), "part message identity")
        part_session = required(part_columns, ("sessionid", "session"), "part session identity")
        part_time = required(part_columns, ("timecreated", "createdat", "time", "timestamp"),
                             "part timestamp")
        part_body = required(part_columns, ("data", "text", "content"), "part body")
        schema_rows = connection.execute(
            "SELECT type,name,sql FROM sqlite_master WHERE tbl_name IN (?,?,?) OR name IN (?,?,?) "
            "ORDER BY type,name", (session, message, part, session, message, part)).fetchall()
        schema_digest = hashlib.sha256(ledger_payload({
            "objects": schema_rows, "session_id": session_id, "session_time": session_time,
            "message_id": message_id, "message_session": message_session,
            "message_time": message_time, "message_body": message_body,
            "part_id": part_id, "part_message": part_message,
            "part_session": part_session, "part_time": part_time, "part_body": part_body,
        }).encode()).hexdigest()
        session_ceiling = connection.execute(f'SELECT COALESCE(MAX(rowid),0) FROM "{session}"').fetchone()[0]
        message_ceiling = connection.execute(f'SELECT COALESCE(MAX(rowid),0) FROM "{message}"').fetchone()[0]
        part_ceiling = connection.execute(f'SELECT COALESCE(MAX(rowid),0) FROM "{part}"').fetchone()[0]
    finally:
        if owned_connection and "connection" in locals():
            connection.close()
    return {"device": details.st_dev, "inode": details.st_ino, "schema_digest": schema_digest,
            "session": session, "message": message, "part": part,
            "session_columns": session_columns, "message_columns": message_columns,
            "part_columns": part_columns, "session_id": session_id, "session_time": session_time,
            "message_id": message_id, "message_session": message_session,
            "message_time": message_time, "message_updated": message_columns.get("timeupdated"),
            "message_body": message_body, "part_id": part_id, "part_message": part_message,
            "part_session": part_session, "part_time": part_time,
            "part_updated": part_columns.get("timeupdated"), "part_body": part_body,
            "session_ceiling": session_ceiling, "message_ceiling": message_ceiling,
            "part_ceiling": part_ceiling}


def open_history_source_index(root, create=False):
    path = history_source_index_path(root)
    if path.exists() or path.is_symlink():
        if path.is_symlink() or not path.is_file():
            fail("history source index is unsafe")
        details = path.stat()
        if details.st_uid != os.getuid() or details.st_mode & 0o077:
            fail("history source index is unsafe")
    elif not create:
        raise SourceIndexUnavailable("source_index_unavailable")
    else:
        path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        os.chmod(path.parent, 0o700)
    if create and path.exists():
        probe = sqlite3.connect(f"{path.resolve().as_uri()}?mode=ro", uri=True)
        try:
            version = probe.execute(
                "SELECT value FROM index_meta WHERE key='schema_version'").fetchone()
            compatible = version == (str(HISTORY_SOURCE_INDEX_SCHEMA),)
            if compatible:
                try:
                    validate_history_source_index_schema(probe)
                except (sqlite3.Error, RuntimeError):
                    compatible = False
        except sqlite3.Error:
            version, compatible = None, False
        finally:
            probe.close()
        if not compatible:
            path.unlink()
    connection = sqlite3.connect(path if create else f"{path.resolve().as_uri()}?mode=ro", uri=not create)
    if create:
        os.chmod(path, 0o600)
    connection.execute("PRAGMA foreign_keys=ON")
    return connection


def ensure_history_source_index_schema(connection):
    connection.executescript("""
        CREATE TABLE IF NOT EXISTS index_meta (
          key TEXT PRIMARY KEY,
          value TEXT NOT NULL
        ) WITHOUT ROWID;
        CREATE TABLE IF NOT EXISTS index_generations (
          generation_id TEXT PRIMARY KEY,
          state TEXT NOT NULL CHECK (state IN ('preparing','ready')),
          source_device INTEGER NOT NULL,
          source_inode INTEGER NOT NULL,
          schema_digest TEXT NOT NULL,
          privacy_epoch_digest TEXT NOT NULL,
          captured_at INTEGER NOT NULL,
          target_session_ceiling INTEGER NOT NULL,
          target_message_ceiling INTEGER NOT NULL,
          target_part_ceiling INTEGER NOT NULL,
          covered_session_ceiling INTEGER NOT NULL,
          covered_message_ceiling INTEGER NOT NULL,
          covered_part_ceiling INTEGER NOT NULL,
          session_row_count INTEGER NOT NULL,
          message_row_count INTEGER NOT NULL,
          part_row_count INTEGER NOT NULL,
          material_row_count INTEGER NOT NULL,
          created_at INTEGER NOT NULL,
          completed_at INTEGER
        );
        CREATE TABLE IF NOT EXISTS index_sessions (
          generation_id TEXT NOT NULL REFERENCES index_generations(generation_id) ON DELETE CASCADE,
          session_id TEXT NOT NULL,
          session_rowid INTEGER NOT NULL,
          parent_session_id TEXT,
          created_at INTEGER NOT NULL,
          last_activity INTEGER NOT NULL,
          eligible INTEGER NOT NULL CHECK (eligible IN (0,1)),
          review_marker INTEGER NOT NULL CHECK (review_marker IN (0,1)),
          project_digest TEXT,
          source_digest TEXT NOT NULL,
          part_count INTEGER NOT NULL,
          tool_call_count INTEGER NOT NULL,
          tool_error_count INTEGER NOT NULL,
          provider_error_count INTEGER NOT NULL,
          child_count INTEGER NOT NULL,
          delegation_count INTEGER NOT NULL,
          token_total INTEGER,
          PRIMARY KEY (generation_id,session_id),
          UNIQUE (generation_id,session_rowid)
        ) WITHOUT ROWID;
        CREATE INDEX IF NOT EXISTS index_sessions_membership
          ON index_sessions(generation_id,eligible,last_activity DESC,session_id);
        CREATE TABLE IF NOT EXISTS index_session_values (
          generation_id TEXT NOT NULL,
          session_id TEXT NOT NULL,
          kind TEXT NOT NULL CHECK (kind IN ('agent','model')),
          value TEXT NOT NULL,
          PRIMARY KEY (generation_id,session_id,kind,value),
          FOREIGN KEY (generation_id,session_id)
            REFERENCES index_sessions(generation_id,session_id) ON DELETE CASCADE
        ) WITHOUT ROWID;
        CREATE TABLE IF NOT EXISTS index_rows (
          generation_id TEXT NOT NULL REFERENCES index_generations(generation_id) ON DELETE CASCADE,
          part_rowid INTEGER NOT NULL,
          session_id TEXT NOT NULL,
          part_time INTEGER NOT NULL,
          material_kind TEXT NOT NULL CHECK (material_kind IN ('boundary','tool','both')),
          eligibility_flags INTEGER NOT NULL,
          tool_name TEXT,
          tool_key_digest TEXT,
          tool_state TEXT CHECK (tool_state IN ('success','failed','other')),
          failure_class TEXT,
          disposition_digest TEXT,
          PRIMARY KEY (generation_id,part_rowid)
        ) WITHOUT ROWID;
        CREATE INDEX IF NOT EXISTS index_rows_ascending
          ON index_rows(generation_id,session_id,part_time,part_rowid);
        CREATE INDEX IF NOT EXISTS index_rows_recovery
          ON index_rows(generation_id,session_id,tool_key_digest,part_time,part_rowid)
          WHERE tool_key_digest IS NOT NULL;
        CREATE INDEX IF NOT EXISTS index_rows_incident
          ON index_rows(generation_id,tool_state,part_time DESC,part_rowid DESC)
          WHERE tool_state='failed';
        CREATE TABLE IF NOT EXISTS active_generation (
          singleton INTEGER PRIMARY KEY CHECK (singleton=1),
          generation_id TEXT NOT NULL REFERENCES index_generations(generation_id)
        );
    """)
    row = connection.execute("SELECT value FROM index_meta WHERE key='schema_version'").fetchone()
    if row is None:
        connection.execute("INSERT INTO index_meta VALUES ('schema_version',?)",
                           (str(HISTORY_SOURCE_INDEX_SCHEMA),))
    elif row[0] != str(HISTORY_SOURCE_INDEX_SCHEMA):
        fail("history source index schema is incompatible")
    if connection.execute("SELECT count(*) FROM index_meta").fetchone()[0] != 1:
        fail("history source index metadata is invalid")


def validate_history_source_index_schema(connection):
    expected = {
        "index_meta": ("key", "value"),
        "index_generations": ("generation_id", "state", "source_device", "source_inode",
                              "schema_digest", "privacy_epoch_digest", "captured_at",
                              "target_session_ceiling", "target_message_ceiling", "target_part_ceiling",
                              "covered_session_ceiling",
                              "covered_message_ceiling", "covered_part_ceiling", "session_row_count",
                              "message_row_count", "part_row_count", "material_row_count", "created_at",
                              "completed_at"),
        "index_sessions": ("generation_id", "session_id", "session_rowid", "parent_session_id",
                           "created_at", "last_activity", "eligible", "review_marker", "project_digest",
                           "source_digest", "part_count", "tool_call_count", "tool_error_count",
                           "provider_error_count", "child_count", "delegation_count", "token_total"),
        "index_session_values": ("generation_id", "session_id", "kind", "value"),
        "index_rows": ("generation_id", "part_rowid", "session_id", "part_time", "material_kind",
                       "eligibility_flags", "tool_name", "tool_key_digest",
                       "tool_state", "failure_class", "disposition_digest"),
        "active_generation": ("singleton", "generation_id"),
    }
    expected_indexes = {"index_sessions_membership", "index_rows_ascending",
                        "index_rows_recovery", "index_rows_incident"}
    tables = {row[0] for row in connection.execute(
        "SELECT name FROM sqlite_master WHERE type='table'")}
    indexes = {row[0] for row in connection.execute(
        "SELECT name FROM sqlite_master WHERE type='index' AND name NOT LIKE 'sqlite_autoindex_%'")}
    index_sql = {name: (sql or "") for name, sql in connection.execute(
        "SELECT name,sql FROM sqlite_master WHERE type='index'")}
    columns = {table: tuple(row[1] for row in connection.execute(f'PRAGMA table_info("{table}")'))
               for table in expected if table in tables}
    row = (connection.execute("SELECT value FROM index_meta WHERE key='schema_version'").fetchone()
           if "index_meta" in tables else None)
    if (tables != set(expected) or indexes != expected_indexes
            or row != (str(HISTORY_SOURCE_INDEX_SCHEMA),)
            or any(columns.get(table) != names for table, names in expected.items())
            or connection.execute("SELECT count(*) FROM index_meta").fetchone()[0] != 1
            or "WHERE tool_key_digest IS NOT NULL" not in index_sql.get("index_rows_recovery", "")
            or "WHERE tool_state='failed'" not in index_sql.get("index_rows_incident", "")):
        raise SourceIndexUnavailable("source_index_unavailable")


HISTORY_GENERATION_COLUMNS = (
    "generation_id", "state", "source_device", "source_inode", "schema_digest",
    "privacy_epoch_digest", "captured_at", "target_session_ceiling", "target_message_ceiling",
    "target_part_ceiling", "covered_session_ceiling", "covered_message_ceiling",
    "covered_part_ceiling", "session_row_count", "message_row_count", "part_row_count",
    "material_row_count", "created_at", "completed_at",
)
HISTORY_SESSION_COLUMNS = (
    "generation_id", "session_id", "session_rowid", "parent_session_id", "created_at",
    "last_activity", "eligible", "review_marker", "project_digest", "source_digest",
    "part_count", "tool_call_count", "tool_error_count", "provider_error_count",
    "child_count", "delegation_count", "token_total",
)


def history_projection_generation(connection, generation_id):
    row = connection.execute(
        f"SELECT {','.join(HISTORY_GENERATION_COLUMNS)} FROM index_generations WHERE generation_id=?",
        (generation_id,)).fetchone()
    return dict(zip(HISTORY_GENERATION_COLUMNS, row)) if row else None


def history_projection_chain(connection, generation_id):
    generation = history_projection_generation(connection, generation_id)
    if generation is None or generation["state"] != "ready":
        raise SourceIndexUnavailable("source_index_unavailable")
    return [generation]


def history_projection_session(connection, chain, session_id):
    for generation in chain:
        row = connection.execute(
            f"SELECT {','.join(HISTORY_SESSION_COLUMNS)} FROM index_sessions "
            "WHERE generation_id=? AND session_id=?", (generation["generation_id"], session_id)).fetchone()
        if row:
            return dict(zip(HISTORY_SESSION_COLUMNS, row))
    return None


def history_projection_sessions(connection, chain):
    sessions = {}
    for generation in chain:
        for row in connection.execute(
                f"SELECT {','.join(HISTORY_SESSION_COLUMNS)} FROM index_sessions WHERE generation_id=?",
                (generation["generation_id"],)):
            sessions.setdefault(row[1], dict(zip(HISTORY_SESSION_COLUMNS, row)))
    return sessions


def history_projection_values(connection, chain, session_id, kind):
    for generation in chain:
        rows = [row[0] for row in connection.execute(
            "SELECT value FROM index_session_values WHERE generation_id=? AND session_id=? AND kind=?",
            (generation["generation_id"], session_id, kind))]
        if rows:
            return rows
        if connection.execute(
                "SELECT 1 FROM index_sessions WHERE generation_id=? AND session_id=?",
                (generation["generation_id"], session_id)).fetchone():
            return []
    return []


def history_projection_prune(connection, root, active_generation_id):
    keep = {active_generation_id}
    referenced = set()
    if ledger_exists(root):
        with ledger_connection(root) as ledger:
            for payload, in ledger.execute("SELECT payload FROM history_captures"):
                value = json.loads(payload, object_pairs_hook=no_duplicate_keys)
                generation_id = value.get("source_generation")
                if isinstance(generation_id, str) and re.fullmatch(r"[0-9a-f]{32}", generation_id):
                    referenced.add(generation_id)
    keep.update(referenced)
    for generation_id, in connection.execute(
            "SELECT generation_id FROM index_generations").fetchall():
        if generation_id not in keep:
            connection.execute("DELETE FROM index_generations WHERE generation_id=?", (generation_id,))


def history_projection_safe_value(value):
    return value if isinstance(value, str) and re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}", value) else None


def history_projection_digest(previous, value):
    seed = bytes.fromhex(previous) if previous else b""
    return hashlib.sha256(seed + hashlib.sha256(ledger_payload(value).encode()).digest()).hexdigest()


def history_projection_source_session(source, layout, session_id):
    cursor = source.execute(
        f'SELECT rowid,* FROM "{layout["session"]}" WHERE "{layout["session_id"]}"=?', (session_id,))
    row = cursor.fetchone()
    if row is None:
        return None
    names = ["rowid", *(item[0] for item in cursor.description[1:])]
    return {name.lower().replace("_", ""): value for name, value in zip(names, row)}


def history_projection_insert_session(index, source, layout, generation, session_id, forgotten, chain):
    existing = index.execute(
        "SELECT 1 FROM index_sessions WHERE generation_id=? AND session_id=?",
        (generation["generation_id"], session_id)).fetchone()
    if existing:
        return True
    if session_id in forgotten:
        return False
    inherited = history_projection_session(index, chain, session_id) if chain else None
    if inherited:
        values = [generation["generation_id"], *(inherited[name] for name in HISTORY_SESSION_COLUMNS[1:])]
        index.execute(f"INSERT INTO index_sessions VALUES ({','.join('?' for _ in values)})", values)
        for kind in ("agent", "model"):
            index.executemany("INSERT INTO index_session_values VALUES (?,?,?,?)",
                              ((generation["generation_id"], session_id, kind, value)
                               for value in history_projection_values(index, chain, session_id, kind)))
        return True
    row = history_projection_source_session(source, layout, session_id)
    if row is None:
        return False
    columns = layout["session_columns"]
    parent_name = next((name for name in ("parentid", "parent") if name in columns), None)
    parent = row.get(parent_name) if parent_name else None
    created = row.get(layout["session_time"].lower().replace("_", ""))
    if (type(row.get("rowid")) is not int or not isinstance(session_id, str)
            or not OPAQUE_ID.fullmatch(session_id) or parent is not None
            and (not isinstance(parent, str) or not OPAQUE_ID.fullmatch(parent))
            or type(created) is not int or created < 0):
        fail("OpenCode source contains invalid session projection identity")
    project_name = columns.get("projectid")
    project = row.get(project_name.lower().replace("_", "")) if project_name else None
    project_digest = hashlib.sha256(project.encode()).hexdigest() if isinstance(project, str) and project else None
    token_names = [columns[name].lower().replace("_", "") for name in (
        "tokensinput", "tokensoutput", "tokensreasoning", "tokenscacheread", "tokenscachewrite")
        if name in columns]
    tokens = [row.get(name) for name in token_names]
    token_total = sum(tokens) if tokens and all(type(value) is int and value >= 0 for value in tokens) else None
    digest = history_projection_digest(None, ["session", row["rowid"], session_id, parent, created, project, tokens])
    values = (generation["generation_id"], session_id, row["rowid"], parent, created, created,
              0, 0, project_digest, digest, 0, 0, 0, 0, 0, 0, token_total)
    index.execute(f"INSERT INTO index_sessions VALUES ({','.join('?' for _ in values)})", values)
    for kind, name in (("agent", columns.get("agent")), ("model", columns.get("model"))):
        value = history_projection_safe_value(row.get(name.lower().replace("_", "")) if name else None)
        if value:
            index.execute("INSERT INTO index_session_values VALUES (?,?,?,?)",
                          (generation["generation_id"], session_id, kind, value))
    return True


def require_history_source_index(args, part_ceiling=None, generation_id=None, session_ceiling=None):
    root = review_root(args.state_root)
    database = opencode_database(args.database)
    layout = history_source_layout(database)
    privacy_digest = history_privacy_epoch_digest(root)
    try:
        connection = open_history_source_index(root)
        validate_history_source_index_schema(connection)
        if generation_id is None:
            row = connection.execute("SELECT generation_id FROM active_generation WHERE singleton=1").fetchone()
            generation_id = row[0] if row else None
        generation = history_projection_generation(connection, generation_id)
        if (generation is None or generation["state"] != "ready"
                or (generation["source_device"], generation["source_inode"], generation["schema_digest"],
                    generation["privacy_epoch_digest"]) !=
                   (layout["device"], layout["inode"], layout["schema_digest"], privacy_digest)):
            raise SourceIndexUnavailable("source_index_unavailable")
        chain = history_projection_chain(connection, generation_id)
        required_part = generation["covered_part_ceiling"] if part_ceiling is None else part_ceiling
        required_session = generation["covered_session_ceiling"] if session_ceiling is None else session_ceiling
        if (required_part > generation["covered_part_ceiling"]
                or required_session > generation["covered_session_ceiling"]):
            raise SourceIndexUnavailable("source_index_unavailable")
        forgotten = sorted(review_index(root)["forgotten_sessions"])
    except (sqlite3.Error, RuntimeError) as error:
        if isinstance(error, SourceIndexUnavailable):
            raise
        raise SourceIndexUnavailable("source_index_unavailable") from None
    finally:
        if "connection" in locals():
            connection.close()
    return {**layout, "generation_id": generation_id, "chain_ids": [item["generation_id"] for item in chain],
            "privacy_epoch_digest": privacy_digest, "forgotten_sessions": forgotten,
            "validated_part_ceiling": required_part, "validated_session_ceiling": required_session,
            "validated_message_ceiling": generation["covered_message_ceiling"]}


def command_history_source_index_maintain(args):
    root = review_root(args.state_root)
    database = opencode_database(args.database)
    with review_lock(root) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        # Leave process startup, schema validation, commit, and JSON output inside the five-second envelope.
        deadline = time.monotonic() + 4.5
        layout = history_source_layout(database)
        privacy_digest = history_privacy_epoch_digest(root)
        forgotten = set(review_index(root)["forgotten_sessions"])
        index = open_history_source_index(root, create=True)
        source = sqlite3.connect(f"file:{database}?mode=ro", uri=True)
        try:
            ensure_history_source_index_schema(index)
            validate_history_source_index_schema(index)
            active_row = index.execute("SELECT generation_id FROM active_generation WHERE singleton=1").fetchone()
            active = history_projection_generation(index, active_row[0]) if active_row else None
            if active and ((active["source_device"], active["source_inode"], active["schema_digest"],
                            active["privacy_epoch_digest"]) !=
                           (layout["device"], layout["inode"], layout["schema_digest"], privacy_digest)
                           or active["covered_session_ceiling"] > layout["session_ceiling"]
                           or active["covered_message_ceiling"] > layout["message_ceiling"]
                           or active["covered_part_ceiling"] > layout["part_ceiling"]):
                index.execute("DELETE FROM active_generation")
                index.execute("DELETE FROM index_generations")
                index.commit()
                active = None
            preparing_row = index.execute(
                "SELECT generation_id FROM index_generations WHERE state='preparing' ORDER BY created_at DESC LIMIT 1"
            ).fetchone()
            generation = history_projection_generation(index, preparing_row[0]) if preparing_row else None
            if generation is None and active and (
                    active["covered_session_ceiling"] == layout["session_ceiling"]
                    and active["covered_message_ceiling"] == layout["message_ceiling"]
                    and active["covered_part_ceiling"] == layout["part_ceiling"]):
                active_chain = history_projection_chain(index, active["generation_id"])
                chain_ids = [item["generation_id"] for item in active_chain]
                slots = ",".join("?" for _ in chain_ids)
                cursor = source.execute(
                    f'SELECT rowid,"{layout["part_id"]}","{layout["part_message"]}",'
                    f'"{layout["part_session"]}","{layout["part_time"]}",'
                    + (f'"{layout["part_updated"]}",' if layout["part_updated"] else "")
                    + f'"{layout["part_body"]}" FROM "{layout["part"]}" WHERE rowid>? AND rowid<=? '
                    "ORDER BY rowid LIMIT ?",
                    (active["verified_part_rowid"], active["covered_part_ceiling"],
                     HISTORY_SOURCE_INDEX_CHUNK))
                invalid, last, seen = False, active["verified_part_rowid"], 0
                for row in cursor:
                    if time.monotonic() >= deadline:
                        break
                    rowid, part_id, message_id, session_id, created, *tail = row
                    updated, body = (tail if layout["part_updated"] else (created, tail[0]))
                    last, seen = rowid, seen + 1
                    if str(session_id) in forgotten:
                        continue
                    projected = index.execute(
                        f"SELECT source_digest FROM index_rows WHERE generation_id IN ({slots}) "
                        "AND part_rowid=? LIMIT 1", (*chain_ids, rowid)).fetchone()
                    digest = history_projection_digest(None, ["part", rowid, str(session_id), part_id,
                                                               message_id, created, updated,
                                                               hashlib.sha256(str(body).encode()).hexdigest()])
                    if projected is None or projected[0] != digest:
                        invalid = True
                        break
                if invalid:
                    index.execute("DELETE FROM active_generation")
                    index.execute("DELETE FROM index_generations")
                    index.commit()
                    active = None
                else:
                    verified = 0 if seen == 0 or last >= active["covered_part_ceiling"] else last
                    index.execute("UPDATE index_generations SET verified_part_rowid=?,updated_at=? "
                                  "WHERE generation_id=?",
                                  (verified, int(time.time() * 1000), active["generation_id"]))
                    index.commit()
                    result = {"schema_version": HISTORY_SOURCE_INDEX_OUTPUT_SCHEMA, "state": "ready",
                              "covered_part_ceiling": active["covered_part_ceiling"],
                              "indexed_rows": active["part_row_count"], "continuation_needed": False}
                    print(json.dumps(result, sort_keys=True, separators=(",", ":")))
                    return
            if generation is None:
                base = active if active and active["depth"] < 15 else None
                generation_id = uuid.uuid4().hex
                timestamp = int(time.time() * 1000)
                start_session = base["covered_session_ceiling"] if base else 0
                start_message = base["covered_message_ceiling"] if base else 0
                start_part = base["covered_part_ceiling"] if base else 0
                values = (generation_id, base["generation_id"] if base else None,
                          base["depth"] + 1 if base else 0, "preparing", "sessions",
                          layout["device"], layout["inode"], layout["schema_digest"], privacy_digest,
                          layout["session_ceiling"], layout["message_ceiling"], layout["part_ceiling"],
                          start_session, start_message, start_part, 0, 0, 0, 0, 0, 0, 0, 0,
                          timestamp, timestamp)
                index.execute(f"INSERT INTO index_generations VALUES ({','.join('?' for _ in values)})", values)
                index.commit()
                generation = history_projection_generation(index, generation_id)
            chain = history_projection_chain(index, generation["base_generation_id"]) if generation["base_generation_id"] else []
            phase = generation["phase"]
            processed = 0
            if phase == "sessions":
                cursor = source.execute(
                    f'SELECT "{layout["session_id"]}" FROM "{layout["session"]}" '
                    "WHERE rowid>? AND rowid<=? ORDER BY rowid LIMIT ?",
                    (generation["indexed_session_rowid"], generation["target_session_ceiling"],
                     HISTORY_SOURCE_INDEX_CHUNK))
                last, seen = generation["indexed_session_rowid"], 0
                for session_id, in cursor:
                    if time.monotonic() >= deadline:
                        break
                    row = history_projection_source_session(source, layout, str(session_id))
                    seen += 1
                    last = row["rowid"] if row else last
                    if history_projection_insert_session(index, source, layout, generation,
                                                         str(session_id), forgotten, chain):
                        processed += 1
                exhausted = last >= generation["target_session_ceiling"] or seen == 0
                if exhausted:
                    last = generation["target_session_ceiling"]
                index.execute("UPDATE index_generations SET indexed_session_rowid=?,session_row_count="
                              "session_row_count+?,phase=?,updated_at=? WHERE generation_id=?",
                              (last, processed, "messages" if exhausted else "sessions",
                               int(time.time() * 1000), generation["generation_id"]))
            elif phase == "messages":
                table = layout["message"]
                cursor = source.execute(
                    f'SELECT rowid,"{layout["message_id"]}","{layout["message_session"]}",'
                    f'"{layout["message_time"]}",'
                    + (f'"{layout["message_updated"]}",' if layout["message_updated"] else "")
                    + f'"{layout["message_body"]}" FROM "{table}" WHERE rowid>? AND rowid<=? '
                    "ORDER BY rowid LIMIT ?",
                    (generation["indexed_message_rowid"], generation["target_message_ceiling"],
                     HISTORY_SOURCE_INDEX_CHUNK))
                last, seen = generation["indexed_message_rowid"], 0
                for row in cursor:
                    if time.monotonic() >= deadline:
                        break
                    rowid, message_id, session_id, created, *tail = row
                    seen += 1
                    updated, body = (tail if layout["message_updated"] else (created, tail[0]))
                    last = rowid
                    session_id = str(session_id)
                    if session_id in forgotten or not history_projection_insert_session(
                            index, source, layout, generation, session_id, forgotten, chain):
                        continue
                    try:
                        payload = json.loads(body, object_pairs_hook=no_duplicate_keys) if isinstance(body, str) else {}
                    except (json.JSONDecodeError, RuntimeError):
                        payload = {}
                    digest = history_projection_digest(None, ["message", rowid, session_id,
                                                               message_id, created, updated,
                                                               hashlib.sha256(str(body).encode()).hexdigest()])
                    current = index.execute(
                        "SELECT source_digest FROM index_sessions WHERE generation_id=? AND session_id=?",
                        (generation["generation_id"], session_id)).fetchone()[0]
                    provider_error = int(isinstance(payload, dict) and payload.get("error") is not None)
                    index.execute("UPDATE index_sessions SET source_digest=?,provider_error_count="
                                  "provider_error_count+? WHERE generation_id=? AND session_id=?",
                                  (history_projection_digest(current, digest), provider_error,
                                   generation["generation_id"], session_id))
                    model = None
                    if isinstance(payload, dict):
                        model_value = payload.get("model")
                        model = ((model_value.get("modelID") if isinstance(model_value, dict) else None)
                                 or payload.get("modelID"))
                    model = history_projection_safe_value(model)
                    if model:
                        index.execute("INSERT OR IGNORE INTO index_session_values VALUES (?,?,?,?)",
                                      (generation["generation_id"], session_id, "model", model))
                    processed += 1
                exhausted = last >= generation["target_message_ceiling"] or seen == 0
                if exhausted:
                    last = generation["target_message_ceiling"]
                index.execute("UPDATE index_generations SET indexed_message_rowid=?,message_row_count="
                              "message_row_count+?,phase=?,updated_at=? WHERE generation_id=?",
                              (last, processed, "parts" if exhausted else "messages",
                               int(time.time() * 1000), generation["generation_id"]))
            elif phase == "parts":
                table = layout["part"]
                cursor = source.execute(
                    f'SELECT rowid,"{layout["part_id"]}","{layout["part_message"]}",'
                    f'"{layout["part_session"]}","{layout["part_time"]}",'
                    + (f'"{layout["part_updated"]}",' if layout["part_updated"] else "")
                    + f'"{layout["part_body"]}" FROM "{table}" WHERE rowid>? AND rowid<=? '
                    "ORDER BY rowid LIMIT ?",
                    (generation["indexed_part_rowid"], generation["target_part_ceiling"],
                     HISTORY_SOURCE_INDEX_CHUNK))
                last, seen = generation["indexed_part_rowid"], 0
                updates = {}
                for row in cursor:
                    if time.monotonic() >= deadline:
                        break
                    rowid, part_id, message_id, session_id, created, *tail = row
                    seen += 1
                    updated, body = (tail if layout["part_updated"] else (created, tail[0]))
                    last = rowid
                    session_id = str(session_id)
                    if session_id in forgotten or not history_projection_insert_session(
                            index, source, layout, generation, session_id, forgotten, chain):
                        continue
                    if (type(rowid) is not int or type(created) is not int or created < 0
                            or type(updated) is not int or updated < 0):
                        fail("OpenCode source contains invalid projected part identity")
                    text = str(body)
                    lowered = text[:2048].lower()
                    flags = ((1 if "dbsctr" in lowered else 0)
                             | (2 if "/discovery" in lowered else 0)
                             | (4 if "/qa" in lowered else 0)
                             | (8 if "dbsctr-improve" in lowered else 0))
                    try:
                        payload = json.loads(text, object_pairs_hook=no_duplicate_keys)
                    except (json.JSONDecodeError, RuntimeError):
                        payload = {}
                    state = payload.get("state") if isinstance(payload, dict) else None
                    raw_tool = ((payload.get("tool") or payload.get("name") or state.get("tool"))
                                if isinstance(payload, dict) and isinstance(state, dict) else None)
                    raw_tool = raw_tool if isinstance(raw_tool, str) else None
                    tool_name = incident_summary_tool(raw_tool) if raw_tool else None
                    status = str(state.get("status", "")).lower() if isinstance(state, dict) else ""
                    tool_state = ("success" if status in ("completed", "success") else
                                  "failed" if status in ("error", "failed") else
                                  "other" if raw_tool else None)
                    failure = incident_failure_class(state, status) if tool_state == "failed" else None
                    tool_key_generation = chain[-1]["generation_id"] if chain else generation["generation_id"]
                    tool_key = hashlib.sha256(
                        f"{tool_key_generation}\0{raw_tool}".encode()).hexdigest() if raw_tool else None
                    disposition = (incident_signal_id(session_id, str(message_id), str(part_id), raw_tool)
                                   if tool_state == "failed" else None)
                    digest = history_projection_digest(None, ["part", rowid, session_id, part_id,
                                                               message_id, created, updated,
                                                               hashlib.sha256(text.encode()).hexdigest()])
                    index.execute("INSERT INTO index_rows VALUES (?,?,?,?,?,?,?,?,?,?,?,?)",
                                  (generation["generation_id"], rowid, session_id, created, updated,
                                   digest, flags, tool_name, tool_key, tool_state, failure, disposition))
                    item = updates.setdefault(session_id, [0, 0, 0, 0, None])
                    item[0] += 1
                    item[1] += int(raw_tool is not None)
                    item[2] += int(tool_state == "failed")
                    item[3] = max(item[3], created)
                    item[4] = history_projection_digest(item[4], digest)
                    processed += 1
                for session_id, (parts, tools, errors, activity, digest) in updates.items():
                    current = index.execute(
                        "SELECT source_digest,last_activity FROM index_sessions WHERE generation_id=? AND session_id=?",
                        (generation["generation_id"], session_id)).fetchone()
                    index.execute("UPDATE index_sessions SET part_count=part_count+?,tool_call_count="
                                  "tool_call_count+?,tool_error_count=tool_error_count+?,last_activity=?,"
                                  "source_digest=? WHERE generation_id=? AND session_id=?",
                                  (parts, tools, errors, max(current[1], activity),
                                   history_projection_digest(current[0], digest),
                                   generation["generation_id"], session_id))
                exhausted = last >= generation["target_part_ceiling"] or seen == 0
                if exhausted:
                    last = generation["target_part_ceiling"]
                index.execute("UPDATE index_generations SET indexed_part_rowid=?,part_row_count="
                              "part_row_count+?,phase=?,updated_at=? WHERE generation_id=?",
                              (last, processed, "finalizing" if exhausted else "parts",
                               int(time.time() * 1000), generation["generation_id"]))
            else:
                local_rows = index.execute(
                    "SELECT session_id,session_rowid FROM index_sessions WHERE generation_id=? "
                    "AND session_rowid>? ORDER BY session_rowid LIMIT 500",
                    (generation["generation_id"], generation["finalized_session_rowid"])).fetchall()
                resolved = history_projection_sessions(index, [generation, *chain])
                child_counts = {}
                for item in resolved.values():
                    if item["parent_session_id"]:
                        child_counts[item["parent_session_id"]] = child_counts.get(item["parent_session_id"], 0) + 1
                last = generation["finalized_session_rowid"]
                chain_ids = [generation["generation_id"], *(item["generation_id"] for item in chain)]
                placeholders = ",".join("?" for _ in chain_ids)
                for session_id, session_rowid in local_rows:
                    if time.monotonic() >= deadline:
                        break
                    rows = index.execute(
                        f"SELECT eligibility_flags,part_time,part_rowid FROM index_rows WHERE generation_id IN "
                        f"({placeholders}) AND session_id=? ORDER BY part_time,part_rowid",
                        (*chain_ids, session_id)).fetchall()
                    boundary = rows[:16] + rows[-16:]
                    flags = 0
                    for value, _, _ in boundary:
                        flags |= value
                    agents = history_projection_values(index, [generation, *chain], session_id, "agent")
                    eligible = int(bool(flags & 7) or any(value.lower() in (
                        "reviewer-openai", "builder-openai", "builder-bedrock") for value in agents))
                    index.execute("UPDATE index_sessions SET eligible=?,review_marker=?,child_count=?,"
                                  "delegation_count=? WHERE generation_id=? AND session_id=?",
                                  (eligible, int(bool(flags & 8)), child_counts.get(session_id, 0),
                                   child_counts.get(session_id, 0), generation["generation_id"], session_id))
                    last = session_rowid
                    processed += 1
                exhausted = index.execute(
                    "SELECT 1 FROM index_sessions WHERE generation_id=? AND session_rowid>? LIMIT 1",
                    (generation["generation_id"], last)).fetchone() is None
                if exhausted:
                    timestamp = int(time.time() * 1000)
                    index.execute("UPDATE index_generations SET state='ready',phase='ready',"
                                  "covered_session_ceiling=target_session_ceiling,"
                                  "covered_message_ceiling=target_message_ceiling,"
                                  "covered_part_ceiling=target_part_ceiling,finalized_session_rowid=?,updated_at=? "
                                  "WHERE generation_id=?", (last, timestamp, generation["generation_id"]))
                    index.execute("INSERT INTO active_generation VALUES (1,?) ON CONFLICT(singleton) "
                                  "DO UPDATE SET generation_id=excluded.generation_id",
                                  (generation["generation_id"],))
                    history_projection_prune(index, root, generation["generation_id"])
                else:
                    index.execute("UPDATE index_generations SET finalized_session_rowid=?,updated_at=? "
                                  "WHERE generation_id=?",
                                  (last, int(time.time() * 1000), generation["generation_id"]))
            index.commit()
            generation = history_projection_generation(index, generation["generation_id"])
            result = {"schema_version": HISTORY_SOURCE_INDEX_OUTPUT_SCHEMA,
                      "state": generation["state"],
                      "covered_part_ceiling": (generation["covered_part_ceiling"]
                                               if generation["state"] == "ready" else
                                               active["covered_part_ceiling"] if active else 0),
                      "indexed_rows": generation["part_row_count"],
                      "continuation_needed": generation["state"] != "ready"}
        except Exception:
            index.rollback()
            raise
        finally:
            source.close()
            index.close()
    print(json.dumps(result, sort_keys=True, separators=(",", ":")))


def command_history_source_index_refresh(args):
    started = time.monotonic()
    root = review_root(args.state_root)
    database = opencode_database(args.database)
    refresh_lock = history_source_refresh_lock(root)
    try:
        fcntl.flock(refresh_lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        refresh_lock.close()
        command_history_source_index_status(SimpleNamespace(state_root=args.state_root))
        return
    if shutil.disk_usage(history_source_index_path(root).parent).free < 2048 * 1024 * 1024:
        refresh_lock.close()
        fail("history source index refresh has insufficient free space")
    source = sqlite3.connect(f"file:{database}?mode=ro", uri=True)
    source.execute("BEGIN")
    layout = history_source_layout(database, source)
    privacy_digest = history_privacy_epoch_digest(root)
    forgotten = set(review_index(root)["forgotten_sessions"])
    index = open_history_source_index(root, create=True)
    generation_id = uuid.uuid4().hex
    captured_at = int(time.time() * 1000)
    processed_source_rows = 0

    def check_refresh_bounds():
        if time.monotonic() - started >= 3600:
            fail("history source index refresh timed out")
        path = history_source_index_path(root)
        if path.exists() and path.stat().st_size > 1536 * 1024 * 1024:
            fail("history source index preparation exceeds storage limit")

    try:
        ensure_history_source_index_schema(index)
        validate_history_source_index_schema(index)
        index.execute("DELETE FROM index_generations WHERE state='preparing'")
        layout["session_ceiling"] = source.execute(
            f'SELECT COALESCE(MAX(rowid),0) FROM "{layout["session"]}"').fetchone()[0]
        layout["message_ceiling"] = source.execute(
            f'SELECT COALESCE(MAX(rowid),0) FROM "{layout["message"]}"').fetchone()[0]
        layout["part_ceiling"] = source.execute(
            f'SELECT COALESCE(MAX(rowid),0) FROM "{layout["part"]}"').fetchone()[0]
        generation = {"generation_id": generation_id}
        values = (generation_id, "preparing", layout["device"], layout["inode"],
                  layout["schema_digest"], privacy_digest, captured_at, layout["session_ceiling"],
                  layout["message_ceiling"], layout["part_ceiling"], 0, 0, 0, 0, 0, 0, 0,
                  captured_at, None)
        index.execute(f"INSERT INTO index_generations VALUES ({','.join('?' for _ in values)})", values)
        index.commit()
        stats, models, first_rows, last_rows = {}, {}, {}, {}
        for session_id, in source.execute(
                f'SELECT "{layout["session_id"]}" FROM "{layout["session"]}" '
                "WHERE rowid<=? ORDER BY rowid", (layout["session_ceiling"],)):
            session_id = str(session_id)
            if history_projection_insert_session(index, source, layout, generation,
                                                 session_id, forgotten, []):
                row = index.execute(
                    "SELECT source_digest,last_activity FROM index_sessions "
                    "WHERE generation_id=? AND session_id=?", (generation_id, session_id)).fetchone()
                stats[session_id] = [0, 0, 0, 0, row[1], row[0]]
                models[session_id] = set(history_projection_values(index, [generation], session_id, "model"))
            processed_source_rows += 1
            if processed_source_rows % 1000 == 0:
                check_refresh_bounds()
        message_count = 0
        message_query = (f'SELECT rowid,"{layout["message_id"]}","{layout["message_session"]}",'
                         f'"{layout["message_time"]}",' +
                         (f'"{layout["message_updated"]}",' if layout["message_updated"] else "") +
                         f'"{layout["message_body"]}" FROM "{layout["message"]}" '
                         "WHERE rowid<=? ORDER BY rowid")
        for row in source.execute(message_query, (layout["message_ceiling"],)):
            rowid, message_id, session_id, created, *tail = row
            session_id = str(session_id)
            if session_id not in stats:
                continue
            updated, body = (tail if layout["message_updated"] else (created, tail[0]))
            text = str(body)
            try:
                payload = json.loads(text, object_pairs_hook=no_duplicate_keys)
            except (json.JSONDecodeError, RuntimeError):
                payload = {}
            digest = history_projection_digest(None, ["message", rowid, session_id, message_id,
                                                       created, updated,
                                                       hashlib.sha256(text.encode()).hexdigest()])
            stats[session_id][3] += int(isinstance(payload, dict) and payload.get("error") is not None)
            stats[session_id][5] = history_projection_digest(stats[session_id][5], digest)
            if isinstance(payload, dict):
                model_value = payload.get("model")
                model = ((model_value.get("modelID") if isinstance(model_value, dict) else None)
                         or payload.get("modelID"))
                if model := history_projection_safe_value(model):
                    models[session_id].add(model)
            message_count += 1
            processed_source_rows += 1
            if processed_source_rows % 1000 == 0:
                check_refresh_bounds()
        part_count = 0
        part_query = (f'SELECT rowid,"{layout["part_id"]}","{layout["part_message"]}",'
                      f'"{layout["part_session"]}","{layout["part_time"]}",' +
                      (f'"{layout["part_updated"]}",' if layout["part_updated"] else "") +
                      f'"{layout["part_body"]}" FROM "{layout["part"]}" '
                      "WHERE rowid<=? ORDER BY rowid")
        for row in source.execute(part_query, (layout["part_ceiling"],)):
            rowid, part_id, message_id, session_id, created, *tail = row
            session_id = str(session_id)
            if session_id not in stats:
                continue
            updated, body = (tail if layout["part_updated"] else (created, tail[0]))
            text, lowered = str(body), str(body)[:2048].lower()
            flags = ((1 if "dbsctr" in lowered else 0) | (2 if "/discovery" in lowered else 0)
                     | (4 if "/qa" in lowered else 0) | (8 if "dbsctr-improve" in lowered else 0))
            try:
                payload = json.loads(text, object_pairs_hook=no_duplicate_keys)
            except (json.JSONDecodeError, RuntimeError):
                payload = {}
            state = payload.get("state") if isinstance(payload, dict) else None
            raw_tool = ((payload.get("tool") or payload.get("name") or state.get("tool"))
                        if isinstance(payload, dict) and isinstance(state, dict) else None)
            raw_tool = raw_tool if isinstance(raw_tool, str) else None
            tool_name = incident_summary_tool(raw_tool) if raw_tool else None
            status = str(state.get("status", "")).lower() if isinstance(state, dict) else ""
            tool_state = ("success" if status in ("completed", "success") else
                          "failed" if status in ("error", "failed") else "other" if raw_tool else None)
            failure = incident_failure_class(state, status) if tool_state == "failed" else None
            tool_key = hashlib.sha256(f"{generation_id}\0{raw_tool}".encode()).hexdigest() if raw_tool else None
            disposition = (incident_signal_id(session_id, str(message_id), str(part_id), raw_tool)
                           if tool_state == "failed" else None)
            material = (generation_id, rowid, session_id, created, "tool", flags, tool_name,
                        tool_key, tool_state, failure, disposition)
            if raw_tool:
                index.execute("INSERT INTO index_rows VALUES (?,?,?,?,?,?,?,?,?,?,?)", material)
            first = first_rows.setdefault(session_id, [])
            insort(first, (created, rowid, material))
            if len(first) > 16:
                first.pop()
            last = last_rows.setdefault(session_id, [])
            insort(last, (created, rowid, material))
            if len(last) > 16:
                last.pop(0)
            digest = history_projection_digest(None, ["part", rowid, session_id, part_id, message_id,
                                                       created, updated,
                                                       hashlib.sha256(text.encode()).hexdigest()])
            item = stats[session_id]
            item[0] += 1
            item[1] += int(raw_tool is not None)
            item[2] += int(tool_state == "failed")
            item[4] = max(item[4], created)
            item[5] = history_projection_digest(item[5], digest)
            part_count += 1
            processed_source_rows += 1
            if processed_source_rows % 1000 == 0:
                check_refresh_bounds()
        child_counts = {}
        for parent, in index.execute(
                "SELECT parent_session_id FROM index_sessions WHERE generation_id=? "
                "AND parent_session_id IS NOT NULL", (generation_id,)):
            child_counts[parent] = child_counts.get(parent, 0) + 1
        for session_id, item in stats.items():
            boundary = {item[2][1]: item[2] for item in [*first_rows.get(session_id, []),
                                                         *last_rows.get(session_id, [])]}
            flags = 0
            for row in boundary.values():
                flags |= row[5]
                index.execute("INSERT INTO index_rows VALUES (?,?,?,?,?,?,?,?,?,?,?) "
                              "ON CONFLICT(generation_id,part_rowid) DO UPDATE SET material_kind='both'",
                              (row[0], row[1], row[2], row[3], "boundary", *row[5:]))
            eligible = int(bool(flags & 7) or any(value.lower() in (
                "reviewer-openai", "builder-openai", "builder-bedrock") for value in
                (row[0] for row in index.execute(
                    "SELECT value FROM index_session_values WHERE generation_id=? "
                    "AND session_id=? AND kind='agent'", (generation_id, session_id)))))
            index.execute("UPDATE index_sessions SET eligible=?,review_marker=?,part_count=?,"
                          "tool_call_count=?,tool_error_count=?,provider_error_count=?,last_activity=?,"
                          "source_digest=?,child_count=?,delegation_count=? WHERE generation_id=? AND session_id=?",
                          (eligible, int(bool(flags & 8)), item[0], item[1], item[2], item[3], item[4],
                           item[5], child_counts.get(session_id, 0), child_counts.get(session_id, 0),
                           generation_id, session_id))
            index.executemany("INSERT OR IGNORE INTO index_session_values VALUES (?,?,?,?)",
                              ((generation_id, session_id, "model", value)
                               for value in models[session_id]))
        material_count = index.execute(
            "SELECT count(*) FROM index_rows WHERE generation_id=?", (generation_id,)).fetchone()[0]
        if history_source_index_path(root).stat().st_size > 1536 * 1024 * 1024:
            fail("history source index preparation exceeds storage limit")
        completed_at = int(time.time() * 1000)
        with review_lock(root) as activation_lock:
            fcntl.flock(activation_lock, fcntl.LOCK_EX)
            current_layout = history_source_layout(database)
            if ((current_layout["device"], current_layout["inode"], current_layout["schema_digest"])
                    != (layout["device"], layout["inode"], layout["schema_digest"])):
                fail("history projection source changed during refresh")
            if history_privacy_epoch_digest(root) != privacy_digest:
                fail("history projection privacy changed during refresh")
            index.execute("UPDATE index_generations SET state='ready',covered_session_ceiling=?,"
                          "covered_message_ceiling=?,covered_part_ceiling=?,session_row_count=?,"
                          "message_row_count=?,part_row_count=?,material_row_count=?,completed_at=? "
                          "WHERE generation_id=?", (layout["session_ceiling"], layout["message_ceiling"],
                          layout["part_ceiling"], len(stats), message_count, part_count, material_count,
                          completed_at, generation_id))
            index.execute("INSERT INTO active_generation VALUES (1,?) ON CONFLICT(singleton) "
                          "DO UPDATE SET generation_id=excluded.generation_id", (generation_id,))
            history_projection_prune(index, root, generation_id)
            page_size = index.execute("PRAGMA page_size").fetchone()[0]
            used_pages = (index.execute("PRAGMA page_count").fetchone()[0]
                          - index.execute("PRAGMA freelist_count").fetchone()[0])
            if used_pages * page_size > 1024 * 1024 * 1024:
                fail("history source index exceeds storage limit")
            index.commit()
        index.execute("VACUUM")
        result = {"schema_version": 1, "state": "ready", "captured_at": captured_at,
                  "duration_ms": int((time.monotonic() - started) * 1000),
                  "indexed_sessions": len(stats), "material_rows": material_count}
    except Exception:
        index.rollback()
        index.execute("DELETE FROM index_generations WHERE generation_id=?", (generation_id,))
        index.commit()
        raise
    finally:
        source.close()
        index.close()
        refresh_lock.close()
    print(json.dumps(result, sort_keys=True, separators=(",", ":")))


def command_history_source_index_status(args):
    root = review_root(args.state_root)
    try:
        connection = open_history_source_index(root)
        validate_history_source_index_schema(connection)
        row = connection.execute(
            "SELECT g.captured_at,g.covered_part_ceiling FROM active_generation a "
            "JOIN index_generations g ON g.generation_id=a.generation_id WHERE a.singleton=1 "
            "AND g.state='ready'").fetchone()
        preparing = connection.execute(
            "SELECT 1 FROM index_generations WHERE state='preparing' LIMIT 1").fetchone()
        state = "refreshing" if preparing else "ready" if row else "unavailable"
        captured_at, ceiling = row if row else (None, None)
        age = max(0, int(time.time()) - captured_at // 1000) if captured_at is not None else None
    except (sqlite3.Error, RuntimeError):
        state, captured_at, age, ceiling = "unavailable", None, None, None
    finally:
        if "connection" in locals():
            connection.close()
    print(json.dumps({"schema_version": 1, "state": state, "captured_at": captured_at,
                      "age_seconds": age, "covered_part_ceiling": ceiling},
                     sort_keys=True, separators=(",", ":")))


def history_projection_scan(args, snapshot):
    source_index = args.source_index
    root = review_root(args.state_root)
    try:
        index = open_history_source_index(root)
        validate_history_source_index_schema(index)
        chain = history_projection_chain(index, source_index["generation_id"])
        sessions = history_projection_sessions(index, chain)
        values = {session_id: {"agent": [], "model": []} for session_id in sessions}
        for generation in chain:
            for session_id, kind, value in index.execute(
                    "SELECT session_id,kind,value FROM index_session_values WHERE generation_id=?",
                    (generation["generation_id"],)):
                if (session_id in sessions
                        and sessions[session_id]["generation_id"] == generation["generation_id"]):
                    values[session_id][kind].append(value)
    except (sqlite3.Error, RuntimeError) as error:
        if isinstance(error, SourceIndexUnavailable):
            raise
        raise SourceIndexUnavailable("source_index_unavailable") from None
    finally:
        if "index" in locals():
            index.close()
    for session_id in source_index["forgotten_sessions"]:
        sessions.pop(session_id, None)
        values.pop(session_id, None)
    sessions = {session_id: item for session_id, item in sessions.items()
                if item["session_rowid"] <= source_index["validated_session_ceiling"]
                and REVIEW_START_MS <= item["created_at"] <= snapshot}
    values = {session_id: values[session_id] for session_id in sessions}
    adjacency = {session_id: set() for session_id in sessions}
    for session_id, item in sessions.items():
        parent = item["parent_session_id"]
        if parent in adjacency:
            adjacency[session_id].add(parent)
            adjacency[parent].add(session_id)
    seeds = {session_id for session_id, item in sessions.items() if item["eligible"]}
    eligible_ids, pending = set(seeds), list(seeds)
    while pending:
        current = pending.pop()
        for related in adjacency.get(current, ()) - eligible_ids:
            eligible_ids.add(related)
            pending.append(related)
    selected = getattr(args, "metric_session_ids", None)
    if selected is not None:
        eligible_ids.intersection_update(selected)
    improvement_sessions = set()
    if ledger_exists(root):
        with ledger_connection(root) as ledger:
            if ledger.execute(
                    "SELECT 1 FROM sqlite_master WHERE type='table' AND name='improvement_workers'").fetchone():
                improvement_sessions = {row[0] for row in ledger.execute(
                    "SELECT session_id FROM improvement_workers WHERE session_id IS NOT NULL")}
    reviewed_sessions, _ = reviewed_ids(args.state_root, snapshot, lock=not getattr(args, "lock_held", False))
    cycle_cache, identity_cache, candidates = {}, {}, []
    for session_id in eligible_ids:
        item = sessions[session_id]
        reviewed = session_id in reviewed_sessions
        if reviewed and not getattr(args, "include_reviewed", False):
            continue
        family, family_pending = {session_id}, [session_id]
        while family_pending:
            current = family_pending.pop()
            for related in adjacency.get(current, ()) - family:
                family.add(related)
                family_pending.append(related)
        membership_only = getattr(args, "membership_only", False)
        if membership_only:
            cycles, correlation = [], "unavailable"
        else:
            cycles, correlation = correlated_cycles(
                None, set(), family, cycle_cache, exact_session_id=session_id, with_quality=True)
        metrics = {
            "project_digest": item["project_digest"] or "unavailable",
            "child_count": item["child_count"], "tool_count": item["tool_call_count"],
            "tool_call_count": item["tool_call_count"], "tool_error_count": item["tool_error_count"],
            "provider_error_count": item["provider_error_count"],
            "delegation_count": item["delegation_count"], "cost_total": "unavailable",
            "token_total": item["token_total"] if item["token_total"] is not None else "unavailable",
            "model_families": sorted({model_family(value) for value in values[session_id]["model"]
                                      if model_family(value) != "unavailable"}) or "unavailable",
            "provider_ids": "unavailable", "model_ids": values[session_id]["model"] or "unavailable",
            "agent_ids": values[session_id]["agent"] or "unavailable",
            "session_relation": "child" if item["parent_session_id"] else "primary",
            "core_revisions": "unavailable", "overlay_revisions": "unavailable",
        }
        children = sorted(adjacency[session_id] - ({item["parent_session_id"]}
                          if item["parent_session_id"] else set()))[:16]
        candidate = {
            "session_id": session_id, "parent_session_id": item["parent_session_id"],
            "child_session_ids": children, "timestamp": str(item["created_at"]),
            "last_activity": str(item["last_activity"]), "cycles": cycles,
            "attention": review_attention(cycles, item["last_activity"], snapshot),
            "correlation_quality": correlation,
            "reviewed_status": "reviewed" if reviewed else "unreviewed",
            "review_session": bool(item["review_marker"] or family.intersection(improvement_sessions)),
        }
        if getattr(args, "bind_history", False):
            candidate["_history_identity"] = history_identity(
                cycles, None, family, item["project_digest"] or "unavailable", identity_cache)
        if getattr(args, "history_metrics", False):
            candidate["_history_metrics"] = metrics
            candidate["telemetry"] = history_telemetry(candidate, metrics)
        candidates.append(candidate)
    candidates.sort(key=lambda item: (int(item["last_activity"]), item["session_id"]), reverse=True)
    source_identities = {session_id: sessions[session_id]["source_digest"] for session_id in eligible_ids}
    database_digest = hashlib.sha256(ledger_payload({
        "mode": "history-source-projection-v2", "generation_id": source_index["generation_id"],
        "schema_digest": source_index["schema_digest"],
        "privacy_epoch_digest": source_index["privacy_epoch_digest"],
        "session_ceiling": source_index["validated_session_ceiling"],
        "message_ceiling": source_index["validated_message_ceiling"],
        "part_ceiling": source_index["validated_part_ceiling"],
    }).encode()).hexdigest()
    if args.database_digest is not None and args.database_digest != database_digest:
        fail("OpenCode database changed within the review snapshot")
    page = candidates if getattr(args, "history_all", False) else candidates[args.cursor:args.cursor + args.limit]
    page_identity = history_page_digest(page, source_identities, args.limit, args.cursor)
    cycles = [cycle for item in page for cycle in item["cycles"]]
    states = [cycle["state"] for cycle in cycles]
    result = {
        "schema_version": 2, "candidates": page,
        "scorecard": {"active": states.count("active"), "blocked": states.count("blocked"),
                      "abandoned": states.count("abandoned"),
                      "dormant": sum("dormant" in item["attention"] for item in page),
                      "completed": states.count("completed"),
                      "unknown": sum(not item["cycles"] for item in page)},
        "session_ids": [item["session_id"] for item in page],
        "cycle_ids": sorted({cycle["cycle_id"] for cycle in cycles}),
        "digest": review_digest(page, snapshot, source_index["validated_session_ceiling"],
                                source_index["validated_part_ceiling"], page_identity),
        "limit": args.limit, "cursor": args.cursor, "snapshot": snapshot,
        "session_ceiling": source_index["validated_session_ceiling"],
        "part_ceiling": source_index["validated_part_ceiling"],
        "database_digest": database_digest, "exclusion_digest": getattr(args, "exclusion_digest", None),
        "continuation": None,
        "_excluded_session_ids": list(source_index["forgotten_sessions"]),
        "_source_identities": source_identities,
    }
    return result


def review_scan(args):
    if args.limit < 1 or args.limit > REVIEW_MAX_LIMIT or args.cursor < 0:
        fail("review scan limit must be 1 through 100 and cursor non-negative")
    current_ms = int(datetime.now(timezone.utc).timestamp() * 1000)
    continuation = args.snapshot is not None
    snapshot = current_ms if args.snapshot is None else args.snapshot
    if not isinstance(snapshot, int) or snapshot < REVIEW_START_MS or snapshot > current_ms:
        fail("review scan snapshot must be a valid non-future millisecond cutoff")
    database = opencode_database(args.database)
    if not database.is_file():
        fail("OpenCode database is missing")
    excluded_session_id = getattr(args, "excluded_session_id", None)
    if excluded_session_id is not None and not OPAQUE_ID.fullmatch(excluded_session_id):
        fail("invalid excluded session ID")
    excluded_message_id = getattr(args, "excluded_message_id", None)
    if excluded_message_id is not None and not OPAQUE_ID.fullmatch(excluded_message_id):
        fail("invalid excluded message ID")
    if getattr(args, "source_index", None) is not None:
        return history_projection_scan(args, snapshot)
    try:
        connection = sqlite3.connect(f"file:{database}?mode=ro", uri=True)
        connection.execute("BEGIN")
        source_index = getattr(args, "source_index", None)
        tables = {row[0].lower(): row[0] for row in connection.execute("SELECT name FROM sqlite_master WHERE type='table'")}
        if not {"session", "message", "part"} <= set(tables):
            fail("OpenCode database lacks required session/message/part tables")
        session, message, part = (tables[name] for name in ("session", "message", "part"))
        exclusion_digest = getattr(args, "exclusion_digest", None)
        if exclusion_digest is not None and not re.fullmatch(r"[0-9a-f]{64}", exclusion_digest):
            fail("invalid review exclusion digest")
        session_columns = {row[1].lower().replace("_", ""): row[1]
                           for row in connection.execute(f'PRAGMA table_info("{session}")')}
        session_ceiling = args.session_ceiling
        part_ceiling = args.part_ceiling
        if continuation and (session_ceiling is None or part_ceiling is None):
            fail("review scan continuation requires row ceilings")
        if session_ceiling is None:
            session_ceiling = connection.execute(f'SELECT COALESCE(MAX(rowid), 0) FROM "{session}"').fetchone()[0]
        if part_ceiling is None:
            part_ceiling = connection.execute(f'SELECT COALESCE(MAX(rowid), 0) FROM "{part}"').fetchone()[0]
        if (type(session_ceiling) is not int or not 0 <= session_ceiling <= 2**63 - 1
                or type(part_ceiling) is not int or not 0 <= part_ceiling <= 2**63 - 1):
            fail("review scan row ceilings must be non-negative integers")
        if (source_index is not None
                and (session_ceiling != source_index["validated_session_ceiling"]
                     or part_ceiling != source_index["validated_part_ceiling"])):
            raise SourceIndexUnavailable("source_index_unavailable")
        sid = sqlite_name(connection, session, ("id",))
        selected_metric_ids = getattr(args, "metric_session_ids", None)
        if selected_metric_ids is not None:
            if (not isinstance(selected_metric_ids, set) or len(selected_metric_ids) > REVIEW_MAX_LIMIT
                    or any(not isinstance(value, str) or not OPAQUE_ID.fullmatch(value)
                           for value in selected_metric_ids)):
                fail("review history metric selection is invalid")
            selected_metric_values = tuple(sorted(selected_metric_ids))
            selected_index_filter = (
                f' AND session_id IN ({",".join("?" for _ in selected_metric_values)})'
                if selected_metric_values else " AND 0")
            selected_session_filter = (
                f' AND s."{sid}" IN ({",".join("?" for _ in selected_metric_values)})'
                if selected_metric_values else " AND 0")
        else:
            selected_metric_values, selected_index_filter, selected_session_filter = (), "", ""
        pid = sqlite_name(connection, part, ("id",))
        parent = sqlite_name(connection, session, ("parentid", "parent")) if any(
            row[1].lower().replace("_", "") in ("parentid", "parent") for row in connection.execute(f"PRAGMA table_info({session})")
        ) else None
        created = sqlite_name(connection, session, ("timecreated", "createdat", "time", "timestamp"))
        directory = sqlite_name(connection, session, ("directory",)) if any(
            row[1].lower().replace("_", "") == "directory" for row in connection.execute(f"PRAGMA table_info({session})")
        ) else None
        agent = sqlite_name(connection, session, ("agent",)) if any(
            row[1].lower().replace("_", "") == "agent" for row in connection.execute(f"PRAGMA table_info({session})")
        ) else None
        mid, msession = sqlite_name(connection, message, ("id",)), sqlite_name(connection, message, ("sessionid",))
        message_columns = {row[1].lower().replace("_", ""): row[1]
                           for row in connection.execute(f'PRAGMA table_info("{message}")')}
        mtime = next((message_columns[name] for name in ("timecreated", "createdat", "time", "timestamp")
                      if name in message_columns), None)
        mbody = next((message_columns[name] for name in ("data", "text", "content")
                      if name in message_columns), None)
        pmessage = sqlite_name(connection, part, ("messageid",))
        psession = sqlite_name(connection, part, ("sessionid", "session"))
        pbody = sqlite_name(connection, part, ("data", "text", "content"))
        part_time = sqlite_name(connection, part, ("timecreated", "createdat", "time", "timestamp"))
        part_columns = {row[1].lower().replace("_", ""): row[1]
                        for row in connection.execute(f'PRAGMA table_info("{part}")')}
        part_updated = part_columns.get("timeupdated")
        if source_index is not None:
            connection.execute("ATTACH DATABASE ? AS history_index",
                               (f"{history_source_index_path(review_root(args.state_root)).resolve().as_uri()}?mode=ro",))
            connection.execute(f"""CREATE TEMP TABLE selected_boundaries AS
                WITH ranked AS (
                  SELECT session_id,part_rowid,part_time,
                    row_number() OVER (
                      PARTITION BY session_id ORDER BY part_time,part_rowid) first_rank,
                    row_number() OVER (
                      PARTITION BY session_id ORDER BY part_time DESC,part_rowid DESC) last_rank
                   FROM history_index.index_rows
                  WHERE generation_id=? AND part_rowid<=?
                    AND material_kind IN ('boundary','both'){selected_index_filter}
                )
                SELECT session_id,part_rowid,part_time FROM ranked
                WHERE first_rank<=16 OR last_rank<=16
            """, (source_index["generation_id"], part_ceiling, *selected_metric_values))
            connection.execute("CREATE INDEX selected_boundaries_session ON selected_boundaries(session_id,part_time,part_rowid)")
            if connection.execute(
                    f'''SELECT 1 FROM selected_boundaries b JOIN "{part}" p ON p.rowid=b.part_rowid
                        WHERE p."{source_index["part_session"]}"<>b.session_id
                           OR typeof(p."{part_time}")!='integer' OR p."{part_time}"<>b.part_time LIMIT 1''').fetchone():
                raise SourceIndexUnavailable("source_index_unavailable")
        if exclusion_digest is not None:
            root = next((str(row[0]) for row in connection.execute(f'SELECT "{sid}" FROM "{session}"')
                         if session_id_digest(str(row[0])) == exclusion_digest), None)
            if root is None:
                fail("review exclusion digest does not match a session")
        else:
            root = (session_for_message(args.database, excluded_message_id)
                    if excluded_message_id is not None else excluded_session_id)
            exclusion_digest = session_id_digest(root) if root is not None else None
        excluded_sessions = excluded_review_family(connection, session, root) if root is not None else set()
        if source_index is not None:
            excluded_sessions.update(source_index["forgotten_sessions"])
        excluded = tuple(sorted(excluded_sessions))
        session_exclusion = (f' AND "{sid}" NOT IN ({",".join("?" for _ in excluded)})' if excluded else "")
        message_exclusion = (f' AND (m."{msession}" NOT IN ({",".join("?" for _ in excluded)}) '
                             f'OR m."{msession}" IS NULL)' if excluded else "")
        identity = hashlib.sha256()
        source_identities = {}
        if exclusion_digest is not None:
            identity.update(b"excluded\0" + exclusion_digest.encode())
        session_identity_columns = [sid, created]
        for value in (parent, directory, agent, session_columns.get("projectid"), session_columns.get("model"),
                      session_columns.get("cost"),
                      *(session_columns.get(name) for name in (
                          "tokensinput", "tokensoutput", "tokensreasoning", "tokenscacheread", "tokenscachewrite"
                      ))):
            if value and value not in session_identity_columns:
                session_identity_columns.append(value)
        selected = ", ".join(f'"{value}"' for value in session_identity_columns)
        for row in connection.execute(
                f'SELECT {selected} FROM "{session}" WHERE "{created}" BETWEEN ? AND ? '
                f'AND rowid <= ?{session_exclusion} ORDER BY "{sid}"',
                (REVIEW_START_MS, snapshot, session_ceiling, *excluded)):
            identity.update(b"s\0")
            encoded = json.dumps(row, sort_keys=True, default=str).encode()
            identity.update(encoded)
            source_identities.setdefault(str(row[0]), hashlib.sha256()).update(b"s\0" + encoded)
        if source_index is None and mtime and mbody:
            for row in connection.execute(
                    f'SELECT m."{msession}", m."{mid}", m."{mtime}", m."{mbody}" FROM "{message}" m '
                    f'JOIN "{session}" s ON s."{sid}"=m."{msession}" '
                    f'WHERE s."{created}" BETWEEN ? AND ? AND s.rowid <= ? '
                    f'AND m."{mtime}" BETWEEN ? AND ?{message_exclusion} ORDER BY m."{mid}"',
                    (REVIEW_START_MS, snapshot, session_ceiling, REVIEW_START_MS, snapshot, *excluded)):
                session_value, message_id, message_timestamp, message_body = row
                encoded = hashlib.sha256(
                    f"m\0{session_value}\0{message_id}\0{message_timestamp}\0".encode()
                    + hashlib.sha256(str(message_body).encode()).digest()).digest()
                identity.update(encoded)
                source_identities.setdefault(str(session_value), hashlib.sha256()).update(encoded)
        if source_index is None:
            part_identity_values = f'p."{pbody}"' + (f', p."{part_updated}"' if part_updated else '')
            part_identity_query = (
                f'SELECT m."{msession}", p."{pid}", p."{part_time}", {part_identity_values} FROM "{part}" p '
                f'LEFT JOIN "{message}" m ON p."{pmessage}"=m."{mid}" '
                f'WHERE p."{part_time}" BETWEEN ? AND ? AND p.rowid <= ?{message_exclusion} ORDER BY p."{pid}"'
            )
            for row in connection.execute(
                    part_identity_query,
                    (REVIEW_START_MS, snapshot, part_ceiling, *excluded)):
                session_value, part_id, part_timestamp, *part_values = row
                source = hashlib.sha256(f"p\0{session_value}\0{part_id}\0{part_timestamp}\0".encode())
                for part_value in part_values:
                    source.update(hashlib.sha256(str(part_value).encode()).digest())
                encoded = source.digest()
                identity.update(encoded)
                if session_value is not None:
                    source_identities.setdefault(str(session_value), hashlib.sha256()).update(encoded)
        else:
            identity.update(ledger_payload({
                "mode": "history-source-index-v1", "generation_id": source_index["generation_id"],
                "schema_digest": source_index["schema_digest"],
                "privacy_epoch_digest": source_index["privacy_epoch_digest"],
                "session_ceiling": session_ceiling, "part_ceiling": part_ceiling,
            }).encode())
        database_digest = identity.hexdigest()
        timestamp_authorities = ((session, created),) if source_index is not None else (
            (session, created), (part, part_time))
        for table, column in timestamp_authorities:
            invalid = connection.execute(
                f'SELECT 1 FROM "{table}" WHERE "{column}" IS NOT NULL '
                f'AND (typeof("{column}") != \'integer\' OR "{column}" < 100000000000) LIMIT 1'
            ).fetchone()
            if invalid:
                fail(f"OpenCode {table} timestamps must be integer milliseconds")
        parent_value = f's."{parent}"' if parent else "NULL"
        created_value = f's."{created}"'
        directory_value = f's."{directory}"' if directory else "NULL"
        agent_value = f's."{agent}"' if agent else "''"
        child_exclusion = (f' AND c."{sid}" NOT IN ({",".join("?" for _ in excluded)})' if excluded else "")
        children = (f'(SELECT group_concat(c."{sid}", ",") FROM "{session}" c '
                    f'WHERE c."{parent}"=content.session_id AND c."{created}" <= ? AND c.rowid <= ?{child_exclusion})') if parent else "NULL"
        time_filter = f'(typeof(s."{created}") = \'integer\' AND s."{created}" BETWEEN ? AND ? AND s.rowid <= ?)'
        if source_index is not None:
            body = (f'(SELECT group_concat(body, "\\n") FROM ('
                    f'SELECT substr(p."{pbody}",1,2048) body FROM selected_boundaries b '
                    f'JOIN "{part}" p ON p.rowid=b.part_rowid WHERE b.session_id=s."{sid}" '
                    f'ORDER BY b.part_time,b.part_rowid))')
            last_activity = (f'MAX({created_value}, COALESCE((SELECT MAX(part_time) '
                             f'FROM history_index.index_rows WHERE generation_id='
                             f'\'{source_index["generation_id"]}\' AND session_id=s."{sid}" '
                             f'AND part_rowid<={part_ceiling}), {created_value}))')
            body_parameters = ()
        else:
            part_order = f'p."{part_time}" DESC'
            part_source = (f'SELECT substr(p."{pbody}", 1, 2048) body FROM "{message}" m '
                           f'JOIN "{part}" p ON p."{pmessage}"=m."{mid}" WHERE m."{msession}"=s."{sid}" '
                           f'AND p."{part_time}" <= ? AND p.rowid <= ?')
            body = (f'(SELECT group_concat(body, "\\n") FROM ('
                    f'SELECT body FROM ({part_source} ORDER BY {part_order.replace(" DESC", " ASC")} LIMIT 16) '
                     f'UNION ALL SELECT body FROM ({part_source} ORDER BY {part_order} LIMIT 16)))')
            last_activity = (f'MAX({created_value}, COALESCE((SELECT MAX(p."{part_time}") FROM "{message}" m '
                             f'JOIN "{part}" p ON p."{pmessage}"=m."{mid}" WHERE m."{msession}"=s."{sid}" '
                             f'AND p."{part_time}" <= ? AND p.rowid <= ?), {created_value}))')
            body_parameters = (snapshot, part_ceiling, snapshot, part_ceiling, snapshot, part_ceiling)
        query = f"""
            WITH RECURSIVE content AS (
                SELECT s."{sid}" session_id, {parent_value} parent_id,
                       {created_value} created_at, {last_activity} last_activity,
                       {directory_value} directory,
                       {agent_value} agent, COALESCE({body}, '') body
                FROM "{session}" s
                WHERE {time_filter}{session_exclusion}{selected_session_filter}
            ), seeds AS (
                SELECT session_id FROM content
                WHERE lower(body) LIKE '%dbsctr%'
                   OR lower(body) LIKE '%/discovery%'
                   OR lower(body) LIKE '%/qa%'
                   OR lower(agent) IN ('reviewer-openai', 'builder-openai', 'builder-bedrock')
            ), edges(source, target) AS (
                SELECT session_id, parent_id FROM content WHERE parent_id IS NOT NULL
                UNION SELECT parent_id, session_id FROM content WHERE parent_id IS NOT NULL
            ), expanded(session_id) AS (
                SELECT session_id FROM seeds
                UNION SELECT edges.target FROM edges JOIN expanded ON edges.source=expanded.session_id
            )
            SELECT content.session_id, content.parent_id, content.created_at, content.last_activity,
                   {children}, content.body, content.directory, content.agent
            FROM content JOIN expanded ON expanded.session_id=content.session_id
            ORDER BY content.created_at, content.session_id
        """
        parameters = (*body_parameters, REVIEW_START_MS, snapshot, session_ceiling, *excluded,
                      *selected_metric_values,
                      *((snapshot, session_ceiling, *excluded) if parent else ()))
        rows = connection.execute(query, parameters).fetchall()
        project_digests = {}
        project_column = session_columns.get("projectid")
        if getattr(args, "bind_history", False) and project_column:
            for session_value, project_value in connection.execute(
                    f'SELECT s."{sid}",s."{project_column}" FROM "{session}" s '
                    f'WHERE {time_filter}{session_exclusion}{selected_session_filter}',
                    (REVIEW_START_MS, snapshot, session_ceiling, *excluded, *selected_metric_values)):
                if isinstance(project_value, str) and project_value:
                    project_digests[str(session_value)] = hashlib.sha256(project_value.encode()).hexdigest()
        history_metrics = {}
        if getattr(args, "history_metrics", False):
            selected_metrics = getattr(args, "metric_session_ids", None)
            wanted_sessions = ({str(row[0]) for row in rows} if selected_metrics is None
                               else {str(row[0]) for row in rows}.intersection(selected_metrics))
            cost_column = session_columns.get("cost")
            model_column = session_columns.get("model")
            token_columns = [session_columns[name] for name in (
                "tokensinput", "tokensoutput", "tokensreasoning", "tokenscacheread", "tokenscachewrite"
            ) if name in session_columns]
            scalar_columns = [value for value in (project_column, cost_column, model_column, *token_columns) if value]
            scalar_values = {}
            if scalar_columns:
                selected = ", ".join(f's."{value}"' for value in scalar_columns)
                scalar_sql = (f'SELECT s."{sid}", {selected} FROM "{session}" s '
                              f'WHERE {time_filter}')
                for scalar_row in connection.execute(scalar_sql + session_exclusion,
                                                     (REVIEW_START_MS, snapshot, session_ceiling, *excluded)):
                    if str(scalar_row[0]) in wanted_sessions:
                        scalar_values[str(scalar_row[0])] = dict(zip(scalar_columns, scalar_row[1:]))
            for session_id in wanted_sessions:
                scalar = scalar_values.get(session_id, {})
                project_value = scalar.get(project_column) if project_column else None
                project_digest = (hashlib.sha256(str(project_value).encode()).hexdigest()
                                  if isinstance(project_value, str) and project_value else "unavailable")
                cost = scalar.get(cost_column) if cost_column else None
                cost_total = (cost if isinstance(cost, (int, float)) and not isinstance(cost, bool)
                              and math.isfinite(cost) and cost >= 0 else "unavailable")
                tokens = [scalar.get(name) for name in token_columns]
                token_total = (sum(tokens) if tokens and all(type(value) is int and value >= 0 for value in tokens)
                               else "unavailable")
                model = scalar.get(model_column) if model_column else None
                family = model_family(model) if isinstance(model, str) else "unavailable"
                history_metrics[session_id] = {
                    "project_digest": project_digest, "child_count": 0 if parent else "unavailable",
                    "tool_count": 0,
                    "tool_call_count": 0, "tool_error_count": 0,
                    "provider_error_count": "unavailable", "delegation_count": 0 if parent else "unavailable",
                    "cost_total": cost_total, "token_total": token_total,
                    "model_families": [family] if family != "unavailable" else "unavailable",
                    "provider_ids": "unavailable", "model_ids": "unavailable",
                    "agent_ids": "unavailable", "session_relation": "unavailable",
                    "core_revisions": "unavailable", "overlay_revisions": "unavailable",
                }
            tool_case = (f'CASE WHEN json_valid(p."{pbody}") THEN '
                         f'CASE WHEN json_extract(p."{pbody}", \'$.type\')=\'tool\' THEN 1 ELSE 0 END ELSE 0 END')
            error_case = (f'CASE WHEN json_valid(p."{pbody}") THEN CASE WHEN '
                          f'json_extract(p."{pbody}", \'$.type\')=\'tool\' AND '
                          f'json_extract(p."{pbody}", \'$.state.status\') IN (\'error\',\'failed\') '
                          f'THEN 1 ELSE 0 END ELSE 0 END')
            if wanted_sessions:
                placeholders = ",".join("?" for _ in wanted_sessions)
                if parent:
                    delegation_sql = (f'SELECT s."{parent}", COUNT(*) FROM "{session}" s '
                                      f'WHERE s."{parent}" IN ({placeholders}) AND s."{created}" BETWEEN ? AND ? '
                                      f'AND s.rowid <= ?{session_exclusion} GROUP BY s."{parent}"')
                    delegation_args = (*sorted(wanted_sessions), REVIEW_START_MS, snapshot, session_ceiling, *excluded)
                    for session_value, delegation_count in connection.execute(delegation_sql, delegation_args):
                        session_id = str(session_value)
                        if session_id in history_metrics:
                            history_metrics[session_id]["delegation_count"] = int(delegation_count)
                            history_metrics[session_id]["child_count"] = int(delegation_count)
                metric_sql = (f'SELECT p."{psession}", SUM({tool_case}), SUM({error_case}) '
                              f'FROM "{part}" p WHERE p."{psession}" IN ({placeholders}) '
                              f'AND p."{part_time}" BETWEEN ? AND ? AND p.rowid <= ? '
                              f'GROUP BY p."{psession}"')
                metric_args = (*sorted(wanted_sessions), REVIEW_START_MS, snapshot, part_ceiling)
                for session_value, tool_calls, tool_errors in connection.execute(metric_sql, metric_args):
                    session_id = str(session_value)
                    if session_id in history_metrics:
                        history_metrics[session_id].update({
                            "tool_count": int(tool_calls or 0), "tool_call_count": int(tool_calls or 0),
                            "tool_error_count": int(tool_errors or 0),
                        })
                if mtime and mbody:
                    model_sql = (f'SELECT m."{msession}", COALESCE('
                                 f'json_extract(m."{mbody}", \'$.model.providerID\'), '
                                 f'json_extract(m."{mbody}", \'$.providerID\')), COALESCE('
                                 f'json_extract(m."{mbody}", \'$.model.modelID\'), '
                                 f'json_extract(m."{mbody}", \'$.modelID\')) FROM "{message}" m '
                                 f'WHERE m."{msession}" IN ({placeholders}) AND m."{mtime}" BETWEEN ? AND ? '
                                 f'AND json_valid(m."{mbody}"){message_exclusion}')
                    model_args = (*sorted(wanted_sessions), REVIEW_START_MS, snapshot, *excluded)
                    for session_value, provider_value, model_value in connection.execute(model_sql, model_args):
                        session_id = str(session_value)
                        family = model_family(model_value) if isinstance(model_value, str) else "unavailable"
                        if session_id in history_metrics and family != "unavailable":
                            families = history_metrics[session_id]["model_families"]
                            history_metrics[session_id]["model_families"] = sorted(
                                set(families if isinstance(families, list) else ()) | {family})
                        if session_id in history_metrics and isinstance(provider_value, str) and OPAQUE_ID.fullmatch(provider_value):
                            values = history_metrics[session_id]["provider_ids"]
                            history_metrics[session_id]["provider_ids"] = sorted(
                                set(values if isinstance(values, list) else ()) | {provider_value})
                        if (session_id in history_metrics and isinstance(model_value, str)
                                and re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}", model_value)):
                            values = history_metrics[session_id]["model_ids"]
                            history_metrics[session_id]["model_ids"] = sorted(
                                set(values if isinstance(values, list) else ()) | {model_value})
                    provider_sql = (f'SELECT m."{msession}", SUM(CASE WHEN json_valid(m."{mbody}") '
                                    f'AND json_type(m."{mbody}", \'$.error\') IS NOT NULL THEN 1 ELSE 0 END) '
                                    f'FROM "{message}" m WHERE m."{msession}" IN ({placeholders}) '
                                    f'AND m."{mtime}" BETWEEN ? AND ?{message_exclusion} GROUP BY m."{msession}"')
                    provider_args = (*sorted(wanted_sessions), REVIEW_START_MS, snapshot, *excluded)
                    for session_value, provider_errors in connection.execute(provider_sql, provider_args):
                        session_id = str(session_value)
                        if session_id in history_metrics:
                            history_metrics[session_id]["provider_error_count"] = int(provider_errors or 0)
    except sqlite3.Error as error:
        fail(f"cannot read OpenCode database: {error}")
    finally:
        if 'connection' in locals():
            connection.close()
    improvement_sessions = set()
    root = review_root(args.state_root)
    if ledger_exists(root):
        with ledger_connection(root) as ledger:
            if ledger.execute(
                    "SELECT 1 FROM sqlite_master WHERE type='table' AND name='improvement_workers'").fetchone():
                improvement_sessions = {row[0] for row in ledger.execute(
                    "SELECT session_id FROM improvement_workers WHERE session_id IS NOT NULL")}
    reviewed_sessions, _ = reviewed_ids(args.state_root, snapshot if continuation else None,
                                         lock=not getattr(args, "lock_held", False))
    eligible, cycle_cache, identity_cache = [], {}, {}
    families = session_family_map(rows)
    review_markers = {str(row[0]) for row in rows
                      if isinstance(row[5], str) and "dbsctr-improve" in row[5].lower()}
    for row in rows:
        session_id, agent_name = str(row[0]), row[7]
        if session_id in history_metrics and isinstance(agent_name, str) and OPAQUE_ID.fullmatch(agent_name):
            history_metrics[session_id]["agent_ids"] = [agent_name]
    for session_id, parent_id, timestamp, last_activity, child_ids, text, directory, agent_name in rows:
        session_id = str(session_id)
        parent_id = str(parent_id) if parent_id else None
        children_values = sorted(str(child_ids).split(","))[:16] if child_ids else []
        if (not OPAQUE_ID.fullmatch(session_id) or parent_id is not None and not OPAQUE_ID.fullmatch(parent_id)
                or not all(OPAQUE_ID.fullmatch(value) for value in children_values)):
            fail("OpenCode session metadata contains an invalid opaque ID")
        reviewed = session_id in reviewed_sessions
        if reviewed and not getattr(args, "include_reviewed", False):
            continue
        related_ids = families.get(session_id, {session_id})
        membership_only = getattr(args, "membership_only", False)
        if membership_only:
            cycles, correlation_quality = [], "unavailable"
        else:
            cycles, correlation_quality = correlated_cycles(
                directory, set(), related_ids, cycle_cache, exact_session_id=session_id, with_quality=True,
            )
        if getattr(args, "history_metrics", False):
            metrics = history_metrics.get(session_id, {})
            metrics["session_relation"] = "child" if parent_id else "primary"
            if parent_id is None:
                for name in ("model_families", "provider_ids", "model_ids", "agent_ids"):
                    related_values = [history_metrics.get(related_id, {}).get(name, "unavailable")
                                      for related_id in related_ids]
                    metrics[name] = (sorted({value for values in related_values for value in values})
                                     if all(isinstance(values, list) and values for values in related_values)
                                     else "unavailable")
            activations = [cycle.get("harness_activation") for cycle in cycles if cycle.get("harness_activation")]
            if activations:
                metrics["core_revisions"] = sorted({item["core_revision"] for item in activations})
                metrics["overlay_revisions"] = sorted({item["overlay_revision"] for item in activations})
        attention = review_attention(cycles, last_activity, snapshot)
        candidate = {"session_id": session_id, "parent_session_id": parent_id,
                         "child_session_ids": children_values,
                          "timestamp": str(timestamp)[:64] if timestamp is not None else None,
                          "last_activity": str(last_activity)[:64] if last_activity is not None else None,
                          "cycles": cycles, "attention": attention,
                           "correlation_quality": correlation_quality,
                           "reviewed_status": "reviewed" if reviewed else "unreviewed",
                            "review_session": bool(set(related_ids).intersection(
                                improvement_sessions | review_markers))}
        if getattr(args, "bind_history", False):
            candidate["_history_identity"] = history_identity(
                cycles, directory, related_ids, project_digests.get(session_id, "unavailable"), identity_cache,
            )
        if getattr(args, "history_metrics", False):
            metrics = history_metrics.get(session_id, {})
            candidate["_history_metrics"] = metrics
            candidate["telemetry"] = history_telemetry(candidate, metrics)
            if getattr(args, "bind_history", False):
                candidate["_history_identity"]["project_digest"] = metrics.get(
                    "project_digest", candidate["_history_identity"]["project_digest"])
        eligible.append(candidate)
    manifest = []
    for item in eligible:
        value = {key: field for key, field in item.items() if not key.startswith("_")}
        if getattr(args, "bind_history", False):
            value["history_identity"] = item.get("_history_identity", {})
            value["history_metrics"] = item.get("_history_metrics", {})
        manifest.append(value)
    if source_index is None:
        database_digest = hashlib.sha256(
            (database_digest + "\0" + json.dumps(manifest, sort_keys=True, separators=(",", ":"))).encode()
        ).hexdigest()
    if (continuation and args.database_digest != database_digest
            and not getattr(args, "allow_database_drift", False)):
        fail("OpenCode database changed within the review snapshot")
    if getattr(args, "include_reviewed", False):
        eligible.sort(key=lambda item: (item["last_activity"] or "", item["session_id"]), reverse=True)
    candidates = eligible if getattr(args, "history_all", False) else eligible[args.cursor:args.cursor + args.limit]
    candidates.sort(key=lambda item: (review_priority(item), item["timestamp"] or "", item["session_id"]))
    page_identity = hashlib.sha256()
    for candidate in candidates:
        session_id = candidate["session_id"]
        page_identity.update(session_id.encode() + b"\0")
        page_identity.update(source_identities.get(session_id, hashlib.sha256()).digest())
    page_digest = page_identity.hexdigest()
    session_ids = [item["session_id"] for item in candidates]
    cycle_ids = sorted({cycle["cycle_id"] for item in candidates for cycle in item["cycles"]})
    states = [cycle["state"] for item in candidates for cycle in item["cycles"]]
    result = {"schema_version": 2, "candidates": candidates, "scorecard": {
        "active": states.count("active"), "blocked": states.count("blocked"),
        "abandoned": states.count("abandoned"),
        "dormant": sum("dormant" in item["attention"] for item in candidates),
        "completed": states.count("completed"),
        "unknown": sum(not item["cycles"] for item in candidates)},
        "session_ids": session_ids, "cycle_ids": cycle_ids,
        "digest": review_digest(candidates, snapshot, session_ceiling, part_ceiling, page_digest),
        "limit": args.limit, "cursor": args.cursor, "snapshot": snapshot,
        "session_ceiling": session_ceiling, "part_ceiling": part_ceiling,
        "database_digest": database_digest,
        "exclusion_digest": exclusion_digest,
        "continuation": {"cursor": args.cursor + args.limit, "snapshot": snapshot,
                          "session_ceiling": session_ceiling, "part_ceiling": part_ceiling,
                          "database_digest": database_digest, "exclusion_digest": exclusion_digest}
         if not getattr(args, "history_all", False) and len(eligible) > args.cursor + args.limit else None}
    result["_excluded_session_ids"] = sorted(excluded_sessions)
    if getattr(args, "history_metrics", False) or source_index is not None:
        result["_source_identities"] = {key: value.hexdigest() for key, value in source_identities.items()}
    encoded = json.dumps(result, sort_keys=True, separators=(",", ":"), ensure_ascii=True)
    if (not getattr(args, "history_metrics", False) and not getattr(args, "capture_all", False)
            and len(encoded.encode()) > REVIEW_SCAN_HARD):
        fail("review scan response exceeds bound")
    return result


def command_review_scan(args):
    scan = review_scan(args)
    scan.pop("_excluded_session_ids", None)
    scan.pop("_source_identities", None)
    print(json.dumps(scan, sort_keys=True, separators=(",", ":"), ensure_ascii=True))


def incident_redact(value, limit=2048):
    text = str(value).replace("\r\n", "\n").replace("\r", "\n")
    text = re.sub(r"[^\x09\x0a\x20-\x7e]", " ", text)
    text = re.sub(r"(?i)\b(?:proxy-)?authorization\s*[:=]\s*[^\n]+",
                  "authorization=[REDACTED]", text)
    secret = r"(?:pass(?:word)?|secret|token|key|credential|auth(?:orization)?|cookie|api[_-]?key)"
    quoted = r'''(?:"(?:\\.|[^"\\\n])*"|'(?:\\.|[^'\\\n])*'|\S+)'''
    field = rf'''(?:"{secret}"|'{secret}'|\b{secret}\b)'''
    text = re.sub(rf"(--?{secret}(?:=|\s+)){quoted}",
                  lambda match: match.group(1) + "[REDACTED]", text, flags=re.I)
    text = re.sub(rf"({field}\s*[:=]\s*){quoted}",
                  lambda match: match.group(1) + "[REDACTED]", text, flags=re.I)
    text = re.sub(rf"(\bBearer\s+){quoted}",
                  lambda match: match.group(1) + "[REDACTED]", text, flags=re.I)
    text = SECRET_VALUE.sub("[REDACTED]", text)
    text = HIGH_ENTROPY.sub("[REDACTED]", text)
    return text.strip()[:limit]


def incident_scope(candidates, session_id):
    by_id = {item["session_id"]: item for item in candidates}
    if session_id not in by_id:
        fail("incident session is outside the DBSCTR review family")
    adjacency = {item_id: set() for item_id in by_id}
    for item_id, item in by_id.items():
        related = [item.get("parent_session_id"), *item.get("child_session_ids", [])]
        for value in related:
            if value in adjacency:
                adjacency[item_id].add(value)
                adjacency[value].add(item_id)
    family, pending = {session_id}, [session_id]
    while pending:
        current = pending.pop()
        new = adjacency[current] - family
        family.update(new)
        pending.extend(new)
    return family


def incident_signal_id(session_id, message_id, part_id, tool):
    return hashlib.sha256(f"{session_id}\0{message_id}\0{part_id}\0{tool}".encode()).hexdigest()[:24]


def incident_normalize_token(value):
    if not isinstance(value, str):
        return None
    value = re.sub(r"[ .\-/:]+", "_", value.strip(" \t\n\r\v\f").lower())
    return value if re.fullmatch(r"[a-z0-9_]+", value) else None


def incident_failure_class(state, status):
    error = state.get("error") if isinstance(state, dict) else None
    token = None
    if isinstance(error, dict):
        token = (incident_normalize_token(error.get("code")) if "code" in error
                 else incident_normalize_token(error.get("name")))
    mapping = {
        "timeout": "timed_out", "timed_out": "timed_out", "timeout_error": "timed_out",
        "cancelled": "cancelled", "canceled": "cancelled", "abort_error": "cancelled",
        "permission_denied": "permission_denied", "eacces": "permission_denied",
        "eperm": "permission_denied", "service_unavailable": "service_unavailable",
        "unavailable": "service_unavailable", "invalid_output": "invalid_output",
        "validation_error": "invalid_output",
    }
    normalized_status = incident_normalize_token(status)
    return mapping.get(token, "tool_error" if normalized_status == "error" else
                       "tool_failed" if normalized_status == "failed" else "unknown")


def incident_summary_tool(value):
    fixed = {"apply_patch", "bash", "glob", "grep", "question", "read", "skill", "task",
             "todowrite", "webfetch"}
    if value in fixed or isinstance(value, str) and re.fullmatch(
            r"(?:dbsctr_|dks_|herdr_)[A-Za-z0-9._:/-]+", value) and len(value) <= 128:
        return value
    return "unknown"


def incident_scan_data(args):
    session_id = getattr(args, "session_id", None)
    if session_id is not None and not OPAQUE_ID.fullmatch(session_id):
        fail("invalid incident session ID")
    scan = review_scan(argparse.Namespace(
        database=args.database, state_root=args.state_root, limit=REVIEW_MAX_LIMIT, cursor=0,
        snapshot=None,
        session_ceiling=getattr(args, "source_index", {}).get("validated_session_ceiling"),
        part_ceiling=getattr(args, "source_index", {}).get("validated_part_ceiling"), database_digest=None,
        excluded_session_id=None, excluded_message_id=None, exclusion_digest=None,
        history_metrics=not getattr(args, "summary_only", False), history_all=True,
        include_reviewed=True, bind_history=False,
        source_index=getattr(args, "source_index", None), metric_session_ids=None,
        lock_held=False,
    ))
    candidate_ids = {item["session_id"] for item in scan["candidates"]}
    scope = incident_scope(scan["candidates"], session_id) if session_id else candidate_ids
    root = review_root(args.state_root)
    dispositions = set()
    if ledger_exists(root):
        with ledger_connection(root) as ledger:
            if ledger.execute("SELECT value FROM ledger_meta WHERE key='incident_schema'").fetchone():
                dispositions = {row[0] for row in ledger.execute(
                    "SELECT signal_id FROM incident_signal_dispositions")}
    database = opencode_database(args.database)
    try:
        connection = sqlite3.connect(f"file:{database}?mode=ro", uri=True)
        connection.create_function("incident_signal_id", 4, incident_signal_id, deterministic=True)
        connection.execute("CREATE TEMP TABLE incident_dispositions(signal_id TEXT PRIMARY KEY)")
        connection.executemany("INSERT INTO incident_dispositions VALUES (?)",
                               ((signal_id,) for signal_id in dispositions))
        tables = {row[0].lower(): row[0] for row in connection.execute(
            "SELECT name FROM sqlite_master WHERE type='table'")}
        message, part = tables["message"], tables["part"]
        mid = sqlite_name(connection, message, ("id",))
        msession = sqlite_name(connection, message, ("sessionid",))
        pid = sqlite_name(connection, part, ("id",))
        pmessage = sqlite_name(connection, part, ("messageid",))
        psession = sqlite_name(connection, part, ("sessionid", "session"))
        ptime = sqlite_name(connection, part, ("timecreated", "createdat", "time", "timestamp"))
        pbody = sqlite_name(connection, part, ("data", "text", "content"))
        rows = []
        if scope:
            placeholders = ",".join("?" for _ in scope)
            body = f'''CASE WHEN json_valid(p."{pbody}") THEN p."{pbody}" ELSE '{{}}' END'''
            success_body = f'''CASE WHEN json_valid(sp."{pbody}") THEN sp."{pbody}" ELSE '{{}}' END'''
            tool = f'''coalesce(json_extract({body},'$.tool'),json_extract({body},'$.name'),
                                json_extract({body},'$.state.tool'),'unknown')'''
            success_tool = f'''coalesce(json_extract({success_body},'$.tool'),
                    json_extract({success_body},'$.name'),json_extract({success_body},'$.state.tool'),'unknown')'''
            rows = connection.execute(
                f'''SELECT m."{msession}",m."{mid}",p."{pid}",p."{ptime}",p."{pbody}",
                    EXISTS (SELECT 1 FROM "{message}" sm JOIN "{part}" sp
                            ON sp."{pmessage}"=sm."{mid}"
                            WHERE sm."{msession}"=m."{msession}" AND sp.rowid <= ?
                              AND sp."{ptime}" <= ? AND sp."{ptime}" > p."{ptime}"
                              AND json_extract({success_body},'$.type')='tool'
                              AND lower(json_extract({success_body},'$.state.status')) IN ('completed','success')
                              AND {success_tool}={tool}) AS recovered
                    FROM "{message}" m JOIN "{part}" p ON p."{pmessage}"=m."{mid}"
                    WHERE m."{msession}" IN ({placeholders}) AND p.rowid <= ? AND p."{ptime}" <= ?
                      AND json_extract({body},'$.type')='tool'
                      AND lower(json_extract({body},'$.state.status')) IN ('error','failed')
                      AND incident_signal_id(m."{msession}",m."{mid}",p."{pid}",{tool})
                          NOT IN (SELECT signal_id FROM incident_dispositions)
                    ORDER BY recovered,p."{ptime}" DESC,p."{pid}" LIMIT 101''',
                (scan["part_ceiling"], scan["snapshot"], *sorted(scope),
                 scan["part_ceiling"], scan["snapshot"]),
            ).fetchall()
    except (KeyError, sqlite3.Error) as error:
        fail(f"cannot read OpenCode incidents: {error}")
    finally:
        if "connection" in locals():
            connection.close()
    calls = []
    strict = getattr(args, "summary_only", False)
    for source_session, message_id, part_id, timestamp, raw, recovered in rows:
        try:
            payload = json.loads(raw, object_pairs_hook=no_duplicate_keys)
        except (TypeError, json.JSONDecodeError, RuntimeError):
            if strict:
                fail("incident summary selected an invalid row")
            continue
        state = payload.get("state") if isinstance(payload, dict) else None
        if not isinstance(payload, dict) or payload.get("type") != "tool" or not isinstance(state, dict):
            if strict:
                fail("incident summary selected an invalid row")
            continue
        tool_name = payload.get("tool") or payload.get("name") or state.get("tool") or "unknown"
        if not isinstance(tool_name, str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}", tool_name):
            tool_name = "unknown"
        status = state.get("status")
        if not isinstance(status, str):
            if strict:
                fail("incident summary selected an invalid row")
            continue
        calls.append({"session_id": str(source_session), "message_id": str(message_id),
                      "part_id": str(part_id), "timestamp": int(timestamp),
                      "tool": tool_name, "status": status.lower(), "state": state,
                      "recovered": bool(recovered),
                      "_failure_class": incident_failure_class(state, status)})
    incidents = []
    if ledger_exists(root):
        with ledger_connection(root) as ledger:
            if ledger.execute("SELECT value FROM ledger_meta WHERE key='incident_schema'").fetchone():
                incident_sql = (
                    "SELECT incident_id,session_id,parent_session_id,message_id,kind,title,summary,state,cycle_id,"
                    "diagnostics,evidence,created_at,updated_at FROM incidents")
                incident_args = ()
                if session_id is not None:
                    placeholders = ",".join("?" for _ in scope)
                    incident_sql += f" WHERE session_id IN ({placeholders})"
                    incident_args = tuple(sorted(scope))
                incident_sql += " ORDER BY updated_at DESC,incident_id LIMIT 101"
                for row in ledger.execute(incident_sql, incident_args):
                    item = incident_record(row)
                    item["signal_ids"] = [value[0] for value in ledger.execute(
                        "SELECT signal_id FROM incident_signal_dispositions "
                        "WHERE incident_id=? AND disposition='promoted' ORDER BY signal_id",
                        (item["incident_id"],))]
                    incidents.append(item)
    signals = []
    for item in calls:
        signal_id = incident_signal_id(item["session_id"], item["message_id"], item["part_id"], item["tool"])
        detail = item["state"].get("error", item["status"])
        if not isinstance(detail, str):
            detail = json.dumps(detail, sort_keys=True, separators=(",", ":"), ensure_ascii=True)
        signals.append({
            "signal_id": signal_id, "session_id": item["session_id"],
            "message_id": item["message_id"], "part_id": item["part_id"],
            "timestamp": item["timestamp"], "tool": item["tool"], "status": item["status"],
            "recovered": item["recovered"],
            "evidence": incident_redact(detail, 1024),
            "_failure_class": item["_failure_class"],
        })
    signals.sort(key=lambda item: (item["recovered"], -item["timestamp"], item["signal_id"]))
    result = {"schema_version": 1, "incidents": incidents[:100], "signals": signals[:100],
              "incident_overflow": len(incidents) > 100, "signal_overflow": len(rows) > 100,
              "snapshot": scan["snapshot"], "session_ceiling": scan["session_ceiling"],
              "part_ceiling": scan["part_ceiling"], "database_digest": scan["database_digest"]}
    if len(json.dumps(result, ensure_ascii=True).encode()) > REVIEW_SCAN_HARD:
        fail("incident scan response exceeds bound")
    return result


def incident_projection_summary(args, source_index):
    scan = review_scan(argparse.Namespace(
        database=args.database, state_root=args.state_root, limit=REVIEW_MAX_LIMIT, cursor=0,
        snapshot=int(datetime.now(timezone.utc).timestamp() * 1000),
        session_ceiling=source_index["validated_session_ceiling"],
        part_ceiling=source_index["validated_part_ceiling"], database_digest=None,
        excluded_session_id=None, excluded_message_id=None, exclusion_digest=None,
        history_metrics=False, history_all=True, include_reviewed=True, bind_history=False,
        source_index=source_index, metric_session_ids=None, membership_only=True,
        capture_all=True, lock_held=False,
    ))
    session_id = getattr(args, "session_id", None)
    candidate_ids = {item["session_id"] for item in scan["candidates"]}
    scope = incident_scope(scan["candidates"], session_id) if session_id else candidate_ids
    root = review_root(args.state_root)
    dispositions, incident_count, incident_overflow = set(), 0, False
    if ledger_exists(root):
        with ledger_connection(root) as ledger:
            if ledger.execute("SELECT value FROM ledger_meta WHERE key='incident_schema'").fetchone():
                dispositions = {row[0] for row in ledger.execute(
                    "SELECT signal_id FROM incident_signal_dispositions")}
                if scope:
                    placeholders = ",".join("?" for _ in scope)
                    count = ledger.execute(
                        f"SELECT count(*) FROM (SELECT 1 FROM incidents WHERE session_id IN ({placeholders}) "
                        "LIMIT 101)", tuple(sorted(scope))).fetchone()[0]
                else:
                    count = 0
                incident_count, incident_overflow = min(count, 100), count > 100
    try:
        index = open_history_source_index(root)
        validate_history_source_index_schema(index)
        chain = history_projection_chain(index, source_index["generation_id"])
        chain_ids = [item["generation_id"] for item in chain]
        if not scope:
            failed, successes = [], {}
        else:
            generation_slots = ",".join("?" for _ in chain_ids)
            session_slots = ",".join("?" for _ in scope)
            values = (*chain_ids, *sorted(scope))
            failed = index.execute(
                f"SELECT session_id,part_time,part_rowid,tool_name,tool_key_digest,failure_class,"
                f"disposition_digest FROM index_rows WHERE generation_id IN ({generation_slots}) "
                f"AND session_id IN ({session_slots}) AND tool_state='failed'",
                values).fetchall()
            successes = {}
            for projected_session, tool_key, projected_time in index.execute(
                    f"SELECT session_id,tool_key_digest,max(part_time) FROM index_rows "
                    f"WHERE generation_id IN ({generation_slots}) AND session_id IN ({session_slots}) "
                    "AND tool_state='success' GROUP BY session_id,tool_key_digest", values):
                successes[(projected_session, tool_key)] = projected_time
    except (sqlite3.Error, RuntimeError) as error:
        if isinstance(error, SourceIndexUnavailable):
            raise
        raise SourceIndexUnavailable("source_index_unavailable") from None
    finally:
        if "index" in locals():
            index.close()
    projected = []
    for projected_session, timestamp, rowid, tool, tool_key, failure, disposition in failed:
        if disposition in dispositions:
            continue
        recovered = successes.get((projected_session, tool_key), -1) > timestamp
        projected.append((recovered, -timestamp, rowid, tool or "unknown", failure or "unknown"))
    projected.sort()
    visible = projected[:100]
    groups = {}
    for recovered, _, _, tool, failure in visible:
        key = (incident_summary_tool(tool), failure, recovered)
        groups[key] = groups.get(key, 0) + 1
    return {
        "schema_version": 1, "mode": "summary", "snapshot": scan["snapshot"],
        "session_ceiling": scan["session_ceiling"], "part_ceiling": scan["part_ceiling"],
        "database_digest": scan["database_digest"], "incident_count": incident_count,
        "incident_overflow": incident_overflow, "signal_count": len(visible),
        "signal_overflow": len(projected) > 100,
        "groups": [{"tool": key[0], "failure_class": key[1], "recovered": key[2], "count": count}
                   for key, count in sorted(groups.items(), key=lambda item: (-item[1], *item[0]))],
    }


def command_incident_scan(args):
    if not getattr(args, "summary_only", False):
        result = incident_scan_data(args)
        for signal in result["signals"]:
            signal.pop("_failure_class", None)
    else:
        root = review_root(args.state_root)
        require_review_lock_safe(root)
        with existing_review_lock(root):
            args.source_index = require_history_source_index(args)
            result = incident_projection_summary(args, args.source_index)
    print(json.dumps(result, sort_keys=True, separators=(",", ":"), ensure_ascii=True))


def incident_session_parent(database, session_id, message_id):
    if session_for_message(database, message_id) != session_id:
        fail("incident message belongs to another session")
    path = opencode_database(database)
    try:
        connection = sqlite3.connect(f"file:{path}?mode=ro", uri=True)
        table = next(row[0] for row in connection.execute(
            "SELECT name FROM sqlite_master WHERE type='table'") if row[0].lower() == "session")
        sid = sqlite_name(connection, table, ("id",))
        parent = sqlite_name(connection, table, ("parentid", "parent"))
        row = connection.execute(f'SELECT "{parent}" FROM "{table}" WHERE "{sid}"=?',
                                 (session_id,)).fetchone()
    except (StopIteration, sqlite3.Error) as error:
        fail(f"cannot validate incident session: {error}")
    finally:
        if "connection" in locals():
            connection.close()
    if row is None or row[0] is None or not OPAQUE_ID.fullmatch(str(row[0])):
        fail("incident registration requires a child session")
    return str(row[0])


def command_incident_register(args):
    if (not OPAQUE_ID.fullmatch(args.session_id) or not OPAQUE_ID.fullmatch(args.message_id)
            or args.kind not in INCIDENT_KINDS or not args.title.startswith("INCIDENT: ")
            or not 11 <= len(args.title) <= 128 or not 1 <= len(args.summary) <= 1024
            or len(args.signal_id) > 20 or len(args.diagnostic) > 20 or len(args.evidence) > 20
            or len(args.signal_id) + len(args.evidence) > 20
            or not all(re.fullmatch(r"[0-9a-f]{24}", value) for value in args.signal_id)):
        fail("invalid incident registration")
    parent_id = incident_session_parent(args.database, args.session_id, args.message_id)
    scan = incident_scan_data(argparse.Namespace(
        database=args.database, state_root=args.state_root, session_id=args.session_id))
    available = {item["signal_id"]: item for item in scan["signals"]}
    missing = set(args.signal_id) - set(available)
    if missing:
        fail("incident signal is outside the incident family or already disposed")
    diagnostics = [incident_redact(value) for value in args.diagnostic]
    evidence = [incident_redact(value) for value in args.evidence]
    evidence.extend(incident_redact(f'{available[value]["tool"]}: {available[value]["evidence"]}')
                    for value in args.signal_id)
    if any(not value for value in diagnostics + evidence):
        fail("invalid incident evidence")
    title, summary = incident_redact(args.title, 128), incident_redact(args.summary, 1024)
    if not title.startswith("INCIDENT: ") or not summary:
        fail("invalid incident registration")
    incident_id = hashlib.sha256(f"incident\0{args.session_id}".encode()).hexdigest()[:24]
    timestamp = int(datetime.now(timezone.utc).timestamp() * 1000)
    root = review_root(args.state_root)
    require_review_lock_safe(root)
    with review_lock(root) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        connection = ensure_ledger_for_write(root)
        try:
            connection.execute("BEGIN IMMEDIATE")
            if connection.execute("SELECT 1 FROM incidents WHERE session_id=?", (args.session_id,)).fetchone():
                fail("incident fork is already registered")
            connection.execute(
                "INSERT INTO incidents VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?)",
                (incident_id, args.session_id, parent_id, args.message_id, args.kind, title, summary,
                 "open", None, ledger_payload(diagnostics), ledger_payload(evidence), timestamp, timestamp),
            )
            connection.executemany(
                "INSERT INTO incident_signal_dispositions VALUES (?,?,'promoted',?)",
                ((value, incident_id, timestamp) for value in args.signal_id),
            )
            connection.commit()
        except Exception:
            connection.rollback()
            raise
        finally:
            connection.close()
    item = {"incident_id": incident_id, "session_id": args.session_id,
            "parent_session_id": parent_id, "message_id": args.message_id, "kind": args.kind,
            "title": title, "summary": summary, "state": "open", "cycle_id": None,
            "diagnostics": diagnostics, "evidence": evidence, "created_at": timestamp,
            "updated_at": timestamp, "signal_ids": args.signal_id}
    print(json.dumps({"incident": item}, sort_keys=True, separators=(",", ":"), ensure_ascii=True))


def validate_incident_cycle_record(repository, record, cycle_id):
    required = {
        "schema_version", "method_revision", "cycle_id", "context", "risk", "delivery_intent",
        "created_at", "state", "worktree", "source", "git", "delivery", "engineering_profile",
        "applicability_plan", "gates", "evidence", "artifact_reviews", "commits", "metrics", "runtime",
    }
    if (not isinstance(record, dict) or not required.issubset(record)
            or record.get("schema_version") not in (4, 5)
            or record.get("cycle_id") != cycle_id
            or not OPAQUE_ID.fullmatch(str(record.get("method_revision", "")))
            or not OPAQUE_ID.fullmatch(str(record.get("context", "")))
            or record.get("risk") not in ("routine", "elevated", "critical")
            or record.get("delivery_intent") not in DELIVERY_INTENTS
            or record.get("state") not in ("active", "blocked", "abandoned", "completed")
            or not all(isinstance(record.get(name), dict) for name in (
                "worktree", "source", "git", "delivery", "engineering_profile", "applicability_plan",
                "evidence", "artifact_reviews", "metrics", "runtime"))
            or not isinstance(record.get("commits"), list)):
        fail("incident fix Cycle Record is invalid")
    try:
        created = datetime.fromisoformat(record["created_at"].replace("Z", "+00:00"))
    except (AttributeError, ValueError):
        fail("incident fix Cycle Record is invalid")
    if created.utcoffset() != timedelta(0):
        fail("incident fix Cycle Record is invalid")
    worktree = record["worktree"]
    source = record["source"]
    git_record = record["git"]
    profile = record["engineering_profile"]
    metrics = record["metrics"]
    if (not re.fullmatch(r"[0-9a-f]{16}", str(worktree.get("id", "")))
            or not re.fullmatch(r"[0-9a-f]{40}", str(worktree.get("base_commit", "")))
            or not isinstance(worktree.get("branch"), str)
            or type(worktree.get("created_by_dbsctr")) is not bool
            or not isinstance(worktree.get("locator"), dict)
            or set(worktree["locator"]) != {"root", "path"}
            or not re.fullmatch(r"[0-9a-f]{40}", str(source.get("head", "")))
            or not isinstance(source.get("locator"), dict)
            or not isinstance(source.get("dirty_paths"), list)
            or not re.fullmatch(r"[0-9a-f]{40}", str(git_record.get("head", "")))
            or not isinstance(git_record.get("dirty_paths"), list)
            or not isinstance(git_record.get("pre_cycle_ahead_commits"), list)
            or not isinstance(git_record.get("remote"), dict)
            or not isinstance(profile.get("path"), str)
            or not re.fullmatch(r"[0-9a-f]{40}", str(profile.get("blob", "")))
            or set(metrics) != {"gate_failure_count", "gate_reopen_count", "remediation_round_count"}
            or any(type(value) is not int or value < 0 for value in metrics.values())
            or record["evidence"].get("version") != 1
            or any(not isinstance(commit, dict) or not re.fullmatch(r"[0-9a-f]{40}", str(commit.get("id", "")))
                   or not isinstance(commit.get("gates"), list) or not set(commit["gates"]).issubset(GATES)
                   for commit in record["commits"])):
        fail("incident fix Cycle Record is invalid")
    gates = record.get("gates")
    items = record.get("evidence", {}).get("items")
    plan_gates = record["applicability_plan"].get("gates")
    if (not isinstance(gates, dict) or set(gates) != set(GATES) or not isinstance(items, dict)
            or not isinstance(plan_gates, dict) or set(plan_gates) != set(GATES)
            or record["applicability_plan"].get("profile") != profile["path"]):
        fail("incident fix Cycle Record is invalid")
    for name in GATES:
        gate = gates[name]
        plan_gate = plan_gates[name]
        if (not isinstance(gate, dict) or gate.get("applicability") not in ("required", "not_applicable")
                or not isinstance(plan_gate, dict) or plan_gate.get("applicability") != gate["applicability"]
                or gate.get("result") not in ("pending", "passed", "failed", "unavailable", "not_run")
                or gate["applicability"] == "not_applicable" and gate["result"] != "not_run"
                or gate["applicability"] == "required" and gate["result"] == "not_run"):
            fail("incident fix Cycle Record is invalid")
        if gate["result"] in ("passed", "failed", "unavailable"):
            evidence_id = gate.get("evidence")
            evidence = items.get(evidence_id) if isinstance(evidence_id, str) else None
            if (not isinstance(evidence, dict) or evidence.get("id") != evidence_id
                    or evidence.get("gate") != name or evidence.get("result") != gate["result"]
                    or not isinstance(evidence.get("authority"), str) or not evidence["authority"].strip()
                    or not isinstance(evidence.get("argv"), list)
                    or not all(isinstance(value, str) for value in evidence["argv"])
                    or not isinstance(evidence.get("paths"), dict)
                    or any(not isinstance(path, str) or not path or PurePosixPath(path).is_absolute()
                           or ".." in PurePosixPath(path).parts
                           or not re.fullmatch(r"[0-9a-f]{40}", str(digest))
                           for path, digest in evidence["paths"].items())
                    or evidence.get("head") != record["git"]["head"]
                    or not isinstance(evidence.get("summary"), str)
                    or not isinstance(evidence.get("urls"), list)
                    or not all(isinstance(value, str) for value in evidence["urls"])
                    or not isinstance(evidence.get("raw"), dict)
                    or set(evidence["raw"]) != {"byte_count", "lower_bound", "truncated"}
                    or type(evidence["raw"]["byte_count"]) is not int or evidence["raw"]["byte_count"] < 0
                    or type(evidence["raw"]["lower_bound"]) is not bool
                    or type(evidence["raw"]["truncated"]) is not bool):
                fail("incident fix Cycle Record evidence is invalid")
            try:
                started = datetime.fromisoformat(evidence["started_at"].replace("Z", "+00:00"))
                finished = datetime.fromisoformat(evidence["finished_at"].replace("Z", "+00:00"))
            except (AttributeError, KeyError, ValueError):
                fail("incident fix Cycle Record evidence is invalid")
            if started.utcoffset() != timedelta(0) or finished.utcoffset() != timedelta(0) or finished < started:
                fail("incident fix Cycle Record evidence is invalid")
            verify_envelope(repository, record, name, require_head=False)
        if (record["state"] == "completed" and gate["applicability"] == "required"
                and gate["result"] != "passed"
                and not (gate["result"] in ("failed", "unavailable") and valid_gate_exception(gate))):
            fail("incident completed Cycle Record has an incomplete gate")
    if record["state"] == "completed":
        try:
            completed = datetime.fromisoformat(record["completed_at"].replace("Z", "+00:00"))
        except (AttributeError, KeyError, ValueError):
            fail("incident completed Cycle Record is invalid")
        if completed.utcoffset() != timedelta(0) or completed < created:
            fail("incident completed Cycle Record is invalid")
        if (set(record["artifact_reviews"]) != {"README", "BACKLOG", "CHANGELOG"}
                or any(review.get("result") not in ("changed", "unchanged")
                       for review in record["artifact_reviews"].values())):
            fail("incident completed Cycle Record artifact reviews are invalid")
    return record


def global_cycle_record(cycle_id):
    if not OPAQUE_ID.fullmatch(cycle_id):
        fail("invalid incident cycle ID")
    roots = [root_dir()]
    repositories, failures = global_worktree_roots()
    if failures:
        fail("incident fix cycle registry is incomplete")
    roots.extend(item[1] for item in repositories)
    found, seen = [], set()
    for repository in roots:
        try:
            common = common_git_dir(repository).resolve()
        except RuntimeError:
            continue
        if common in seen:
            continue
        seen.add(common)
        path = common / "dbsctr/cycles" / f"{cycle_id}.json"
        if path.is_file() and not path.is_symlink():
            try:
                record = read_cycle_record(repository, path, "incident Cycle Record")
            except (OSError, json.JSONDecodeError) as error:
                fail(f"cannot read incident Cycle Record: {error}")
            found.append(validate_incident_cycle_record(repository, record, cycle_id))
    if len(found) != 1:
        fail("incident fix cycle is missing or ambiguous")
    return found[0]


def command_incident_update(args):
    if (not re.fullmatch(r"[0-9a-f]{24}", args.incident_id)
            or not OPAQUE_ID.fullmatch(args.session_id) or not OPAQUE_ID.fullmatch(args.message_id)):
        fail("invalid incident ID")
    incident_session_parent(args.database, args.session_id, args.message_id)
    root = review_root(args.state_root)
    require_review_lock_safe(root)
    with review_lock(root) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        connection = ensure_ledger_for_write(root)
        try:
            row = connection.execute(
                "SELECT incident_id,session_id,parent_session_id,message_id,kind,title,summary,state,cycle_id,"
                "diagnostics,evidence,created_at,updated_at FROM incidents WHERE incident_id=?",
                (args.incident_id,)).fetchone()
            if row is None:
                fail("incident is missing")
            item = incident_record(row)
            if item["session_id"] != args.session_id:
                fail("incident lifecycle write belongs to another fork")
            transitions = {"open": {"investigating", "dismissed"},
                           "investigating": {"open", "fixing", "dismissed"},
                           "fixing": {"resolved"}, "resolved": set(), "dismissed": set()}
            if args.state != item["state"] and args.state not in transitions[item["state"]]:
                fail("invalid incident state transition")
            cycle_id = item["cycle_id"]
            if args.state == "fixing":
                requested = args.cycle_id or cycle_id
                if requested is None:
                    fail("fixing incident requires one cycle ID")
                if cycle_id is not None and requested != cycle_id:
                    fail("incident fix cycle is immutable")
                global_cycle_record(requested)
                cycle_id = requested
            elif args.cycle_id is not None and args.cycle_id != cycle_id:
                fail("incident fix cycle is immutable")
            if args.state == "resolved":
                if cycle_id is None:
                    fail("incident resolution requires verified activation")
                cycle = global_cycle_record(cycle_id)
                gates = cycle.get("gates", {})
                activation = [gates.get(name) for name in ("deploy", "operate")]
                if (cycle.get("state") != "completed" or any(
                        not isinstance(gate, dict)
                        or gate.get("applicability") not in ("required", "not_applicable")
                        or gate.get("applicability") == "required" and gate.get("result") != "passed"
                        for gate in activation)):
                    fail("incident resolution requires verified activation")
            timestamp = max(int(datetime.now(timezone.utc).timestamp() * 1000), item["updated_at"] + 1)
            connection.execute("BEGIN IMMEDIATE")
            connection.execute("UPDATE incidents SET state=?,cycle_id=?,updated_at=? WHERE incident_id=?",
                               (args.state, cycle_id, timestamp, args.incident_id))
            connection.commit()
            updated = connection.execute(
                "SELECT incident_id,session_id,parent_session_id,message_id,kind,title,summary,state,cycle_id,"
                "diagnostics,evidence,created_at,updated_at FROM incidents WHERE incident_id=?",
                (args.incident_id,)).fetchone()
        except Exception:
            connection.rollback()
            raise
        finally:
            connection.close()
    print(json.dumps({"incident": incident_record(updated)}, sort_keys=True,
                     separators=(",", ":"), ensure_ascii=True))


def command_incident_forget(args):
    if (not re.fullmatch(r"[0-9a-f]{24}", args.incident_id)
            or not OPAQUE_ID.fullmatch(args.session_id) or not OPAQUE_ID.fullmatch(args.message_id)):
        fail("invalid incident ID")
    incident_session_parent(args.database, args.session_id, args.message_id)
    root = review_root(args.state_root)
    require_review_lock_safe(root)
    with review_lock(root) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        connection = ensure_ledger_for_write(root)
        row = connection.execute("SELECT session_id FROM incidents WHERE incident_id=?",
                                 (args.incident_id,)).fetchone()
        if row is None:
            fail("incident is missing")
        if row[0] != args.session_id:
            fail("incident lifecycle write belongs to another fork")
        signal_ids = [item[0] for item in connection.execute(
            "SELECT signal_id FROM incident_signal_dispositions WHERE incident_id=?", (args.incident_id,))]
        timestamp = int(datetime.now(timezone.utc).timestamp() * 1000)
        staged = None
        quarantine_name = f".forget-{uuid.uuid4().hex}"
        try:
            connection.execute("BEGIN IMMEDIATE")
            connection.execute(
                "UPDATE incident_signal_dispositions SET incident_id=NULL,disposition='forgotten',timestamp=? "
                "WHERE incident_id=?", (timestamp, args.incident_id))
            connection.execute("DELETE FROM incidents WHERE incident_id=?", (args.incident_id,))
            record_knowledge_privacy_tombstone(connection, "incident", args.incident_id, "forgotten", timestamp)
            for signal_id in signal_ids:
                record_knowledge_privacy_tombstone(
                    connection, "incident_signal", signal_id, "forgotten", timestamp)
            connection.execute("INSERT INTO ledger_meta VALUES ('pending_forget_cleanup', ?)",
                               (quarantine_name,))
            staged = stage_pre_forget_state(root, quarantine_name)
            connection.commit()
        except Exception:
            connection.rollback()
            if staged is not None:
                restore_staged_forget(*staged)
            connection.close()
            raise
        recover_forget_state(root, connection)
        connection.close()
    print(json.dumps({"forgotten": True}, sort_keys=True, separators=(",", ":")))


def history_telemetry(candidate, metrics):
    families = metrics.get("model_families", "unavailable")
    if isinstance(families, list):
        families = sorted({value for value in families if value != "unavailable"}) or "unavailable"
    errors = {}
    for source, name in (("provider_error_count", "provider_error"), ("tool_error_count", "tool_error")):
        value = metrics.get(source, "unavailable")
        if type(value) is int:
            errors[name] = value
    identities = {}
    for name in ("provider_ids", "model_ids", "agent_ids", "core_revisions", "overlay_revisions"):
        value = metrics.get(name, "unavailable")
        identities[name] = sorted(set(value)) if isinstance(value, list) and value else "unavailable"
    cycle_metrics = candidate["cycles"][0].get("metrics", {}) if len(candidate.get("cycles", [])) == 1 else {}
    availability = {
        "approval_count": "unavailable", "retry_count": "unavailable",
        "delegation_count": "available" if type(metrics.get("delegation_count")) is int else "unavailable",
        "model_families": "available" if isinstance(families, list) else "unavailable",
        "error_classes": "available" if errors else "unavailable",
        "token_total": "available" if type(metrics.get("token_total")) is int else "unavailable",
        "cost_total": "available" if isinstance(metrics.get("cost_total"), (int, float))
                      and not isinstance(metrics.get("cost_total"), bool) else "unavailable",
        **{name: "available" if isinstance(value, list) else "unavailable"
           for name, value in identities.items()},
        "session_relation": "available" if metrics.get("session_relation") in ("primary", "child") else "unavailable",
        **{name: "available" if type(cycle_metrics.get(name)) is int else "unavailable"
           for name in ("gate_failure_count", "gate_reopen_count", "remediation_round_count")},
    }
    return {
        "schema_version": TELEMETRY_SCHEMA,
        "approval_count": "unavailable", "retry_count": "unavailable",
        "delegation_count": metrics.get("delegation_count", "unavailable"),
        "model_families": families, "error_classes": errors or "unavailable",
        "token_total": metrics.get("token_total", "unavailable"),
        "cost_total": metrics.get("cost_total", "unavailable"),
        **identities, "session_relation": metrics.get("session_relation", "unavailable"),
        **{name: cycle_metrics.get(name, "unavailable")
           for name in ("gate_failure_count", "gate_reopen_count", "remediation_round_count")},
        "availability": availability,
        "attribution_status": candidate.get("correlation_quality", "unavailable"),
    }


def validate_stored_harness_activation(value):
    if (not isinstance(value, dict) or set(value) != {"schema_version", "provider_id", "model_id", "agent_id",
                                                      "core_revision", "overlay_revision"}
            or value.get("schema_version") != HARNESS_ACTIVATION_SCHEMA
            or not all(isinstance(value.get(name), str) for name in (
                "provider_id", "model_id", "agent_id", "core_revision", "overlay_revision"))
            or not OPAQUE_ID.fullmatch(value["provider_id"])
            or not ACTIVATION_MODEL_ID.fullmatch(value["model_id"])
            or not all(OPAQUE_ID.fullmatch(value[name]) for name in (
                "agent_id", "core_revision", "overlay_revision"))):
        fail("invalid harness activation")
    return value


def validate_cycle_metrics(value):
    fields = {"elapsed_ms", "gate_failure_count", "gate_reopen_count", "remediation_round_count"}
    if (not isinstance(value, dict) or set(value) != fields
            or value["elapsed_ms"] != "unavailable" and (type(value["elapsed_ms"]) is not int or value["elapsed_ms"] < 0)
            or any(type(value[name]) is not int or value[name] < 0 for name in fields - {"elapsed_ms"})):
        fail("invalid cycle metrics")
    return value


def validate_history_telemetry(value):
    legacy_fields = {"approval_count", "retry_count", "delegation_count", "model_families", "error_classes",
                     "token_total", "cost_total", "availability", "attribution_status"}
    identity_fields = {"provider_ids", "model_ids", "agent_ids", "core_revisions", "overlay_revisions"}
    counter_fields = {"gate_failure_count", "gate_reopen_count", "remediation_round_count"}
    fields = legacy_fields | identity_fields | counter_fields | {"schema_version", "session_relation"}
    current = isinstance(value, dict) and set(value) == fields
    if isinstance(value, dict) and set(value) == legacy_fields:
        fields = legacy_fields
    availability_fields = fields - {"availability", "attribution_status", "schema_version"}
    statuses = {"exact", "family", "worktree", "source", "ambiguous", "unavailable"}
    if (not isinstance(value, dict) or set(value) != fields
            or current and value.get("schema_version") != TELEMETRY_SCHEMA
            or value["approval_count"] != "unavailable" or value["retry_count"] != "unavailable"
            or (value["delegation_count"] != "unavailable"
                and (type(value["delegation_count"]) is not int or value["delegation_count"] < 0))
            or not isinstance(value["availability"], dict) or set(value["availability"]) != availability_fields
            or any(item not in ("available", "unavailable") for item in value["availability"].values())
            or value["attribution_status"] not in statuses):
        fail("review history telemetry has an invalid schema")
    if current:
        if (value["session_relation"] not in ("primary", "child", "unavailable")
                or any(value[name] != "unavailable" and (not isinstance(value[name], list) or not value[name]
                    or value[name] != sorted(set(value[name])) or any(not isinstance(item, str)
                    or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}", item) for item in value[name]))
                       for name in identity_fields)
                or any(value[name] != "unavailable" and (type(value[name]) is not int or value[name] < 0)
                       for name in counter_fields)):
            fail("review history telemetry has an invalid schema")
    families = value["model_families"]
    if families != "unavailable" and (not isinstance(families, list) or not families
            or families != sorted(set(families)) or any(item not in {"gpt", "claude", "gemini", "llama", "mistral", "qwen"} for item in families)):
        fail("review history telemetry has an invalid schema")
    errors = value["error_classes"]
    if errors != "unavailable" and (not isinstance(errors, dict) or set(errors) - {"provider_error", "tool_error"}
            or not errors or any(type(item) is not int or item < 0 for item in errors.values())):
        fail("review history telemetry has an invalid schema")
    for name in ("token_total", "cost_total"):
        item = value[name]
        if item != "unavailable" and (not isinstance(item, (int, float)) or isinstance(item, bool)
                or not math.isfinite(item) or item < 0):
            fail("review history telemetry has an invalid schema")
    return value


def validate_history_evidence(value):
    allowed = {"schema_version", "session_id", "completed_at", "method_revision", "context",
               "project_digest", "cycles", "aggregates", "snapshot", "session_ceiling",
               "part_ceiling", "database_digest", "reviewed_status", "correlation_quality", "telemetry",
               "review_session"}
    if (not isinstance(value, dict) or set(value) - allowed or value.get("schema_version") != 1
            or not isinstance(value.get("completed_at"), str) or not value["completed_at"].isdigit()
            or int(value["completed_at"]) < REVIEW_START_MS
            or not isinstance(value.get("method_revision"), str) or (value["method_revision"] != "unavailable" and not re.fullmatch(r"3\.\d+", value["method_revision"]))
            or not isinstance(value.get("context"), str) or (value["context"] != "unavailable" and not OPAQUE_ID.fullmatch(value["context"]))
            or not isinstance(value.get("project_digest"), str)
            or value.get("reviewed_status", "reviewed") not in ("reviewed", "unreviewed")
            or type(value.get("review_session", False)) is not bool
            or value.get("correlation_quality", "unavailable") not in (
                "exact", "family", "worktree", "source", "ambiguous", "unavailable")):
        fail("review history evidence has an invalid schema")
    history_id(value.get("session_id"), "history session ID")
    if value["project_digest"] != "unavailable":
        history_digest(value["project_digest"], "project digest")
    if not isinstance(value.get("cycles"), list) or len(value["cycles"]) > REVIEW_MAX_LIMIT:
        fail("review history evidence has an invalid schema")
    for cycle in value["cycles"]:
        interval_fields = {"context", "started_at", "ended_at"}
        has_interval = isinstance(cycle, dict) and interval_fields <= set(cycle)
        if (not isinstance(cycle, dict) or set(cycle) - {"cycle_id", "state", "risk", "delivery_intent",
                                                         "phase_profile", "metrics", "harness_activation",
                                                         *interval_fields}
                or not {"cycle_id", "state"} <= set(cycle)
                or cycle["state"] not in ("active", "blocked", "abandoned", "completed", "unknown")
                or "risk" in cycle and cycle["risk"] not in ("routine", "elevated", "critical", "unavailable")
                or "delivery_intent" in cycle and cycle["delivery_intent"] not in (*DELIVERY_INTENTS, "unavailable")
                or bool(interval_fields.intersection(cycle)) != has_interval
                or has_interval and (not isinstance(cycle["context"], str)
                    or not OPAQUE_ID.fullmatch(cycle["context"])
                    or type(cycle["started_at"]) is not int or cycle["started_at"] < REVIEW_START_MS
                    or cycle["ended_at"] is not None and (type(cycle["ended_at"]) is not int
                        or cycle["ended_at"] < cycle["started_at"]))):
            fail("review history evidence has an invalid schema")
        history_id(cycle.get("cycle_id"), "history cycle ID")
        if "metrics" in cycle:
            validate_cycle_metrics(cycle["metrics"])
        if "harness_activation" in cycle:
            validate_stored_harness_activation(cycle["harness_activation"])
        if "phase_profile" in cycle:
            validate_phase_profile(cycle["phase_profile"], cycle["cycle_id"])
    aggregate_names = {"candidate_count", "cycle_count", "child_count", "elapsed_ms", "tool_count", "tool_call_count",
                       "tool_error_count", "approval_count", "retry_count", "cost_total", "token_total",
                       "cycle_active_count", "cycle_blocked_count", "cycle_abandoned_count", "cycle_completed_count", "cycle_unknown_count"}
    if not isinstance(value.get("aggregates"), dict) or set(value["aggregates"]) - aggregate_names:
        fail("review history evidence has an invalid schema")
    if not all(((isinstance(item, (int, float)) and not isinstance(item, bool)
                  and math.isfinite(item) and 0 <= item <= 2**63 - 1) or item == "unavailable")
               for item in value["aggregates"].values()):
        fail("review history evidence has an invalid schema")
    for name in ("snapshot", "session_ceiling", "part_ceiling"):
        if name in value and (type(value[name]) is not int or value[name] < 0):
            fail("review history evidence has an invalid schema")
    if "database_digest" in value:
        history_digest(value["database_digest"], "database digest")
    if "telemetry" in value:
        validate_history_telemetry(value["telemetry"])
    return {**value, "correlation_quality": value.get("correlation_quality", "unavailable")}


def read_history_evidence(path, root=None):
    try:
        if root is not None:
            private_legacy_file(root, path)
        value = json.loads(path.read_text(encoding="utf-8"), object_pairs_hook=no_duplicate_keys)
    except (OSError, json.JSONDecodeError) as error:
        fail(f"cannot read review history evidence: {error}")
    return validate_history_evidence(value)


def history_evidence(root):
    if ledger_exists(root):
        records = {}
        with ledger_connection(root) as connection:
            for payload, in connection.execute("SELECT payload FROM history_evidence ORDER BY session_id"):
                record = validate_history_evidence(json.loads(payload, object_pairs_hook=no_duplicate_keys))
                records[record["session_id"]] = record
            for payload, in connection.execute("SELECT payload FROM history_reports WHERE kind='report' ORDER BY report_id"):
                for record in validate_history_report(json.loads(payload, object_pairs_hook=no_duplicate_keys))["evidence"]:
                    records.setdefault(record["session_id"], record)
        return list(records.values())
    directory = history_dir(root)
    records = {}
    if directory.is_dir():
        for path in sorted(directory.glob("*.json")):
            record = read_history_evidence(path, root)
            if path.name != f"{record['session_id']}.json":
                fail("review history evidence marker does not match its content")
            records[record["session_id"]] = record
    reports = history_dir(root, "reports")
    if reports.is_dir():
        for path in sorted(reports.glob("*.json")):
            for record in history_report(path, root)["evidence"]:
                records.setdefault(record["session_id"], record)
    return list(records.values())


def archive_review_candidates(root, scan, mark_reviewed=True, connection=None):
    if connection is not None:
        for candidate in scan["candidates"]:
            ledger_put_history_evidence(connection, candidate_history_evidence(candidate, scan, mark_reviewed))
        return
    directory = history_dir(root, create=True)
    for candidate in scan["candidates"]:
        evidence = candidate_history_evidence(candidate, scan, mark_reviewed)
        private_json(directory / f"{evidence['session_id']}.json", evidence)


def candidate_history_evidence(candidate, scan, mark_reviewed=True):
    session_id = history_id(candidate["session_id"], "history session ID")
    cycles = candidate["cycles"]
    identity = candidate.get("_history_identity") or history_identity(cycles)
    evidence = {
        "schema_version": 1, "session_id": session_id,
        "completed_at": str(candidate["last_activity"]), **identity, "cycles": cycles,
        "correlation_quality": candidate.get("correlation_quality", "unavailable"),
        "aggregates": history_aggregates(candidate), "snapshot": scan["snapshot"],
        "session_ceiling": scan["session_ceiling"], "part_ceiling": scan["part_ceiling"],
        "database_digest": scan["database_digest"],
        "reviewed_status": "reviewed" if mark_reviewed else candidate.get("reviewed_status", "unreviewed"),
    }
    if "review_session" in candidate:
        evidence["review_session"] = candidate["review_session"]
    if "telemetry" in candidate:
        evidence["telemetry"] = candidate["telemetry"]
    return validate_history_evidence(evidence)


def history_aggregates(candidate):
    states = [item["state"] for item in candidate["cycles"]]
    created, activity = candidate.get("timestamp"), candidate.get("last_activity")
    elapsed = int(activity) - int(created) if str(created).isdigit() and str(activity).isdigit() else "unavailable"
    structural = candidate.get("_history_metrics") if isinstance(candidate.get("_history_metrics"), dict) else {}
    return {"candidate_count": 1, "cycle_count": len(states),
            "child_count": structural.get("child_count", len(candidate.get("child_session_ids", []))),
            "elapsed_ms": elapsed if isinstance(elapsed, int) and elapsed >= 0 else "unavailable",
            "tool_count": structural.get("tool_count", "unavailable"),
            "tool_call_count": structural.get("tool_call_count", "unavailable"),
            "tool_error_count": structural.get("tool_error_count", "unavailable"),
            "approval_count": "unavailable", "retry_count": "unavailable",
            "cost_total": structural.get("cost_total", "unavailable"),
            "token_total": structural.get("token_total", "unavailable"),
            **{f"cycle_{state}_count": states.count(state) for state in ("active", "blocked", "abandoned", "completed", "unknown")}}


def history_capture_aggregates(records):
    names = ("candidate_count", "cycle_count", "child_count", "elapsed_ms", "tool_count",
             "tool_call_count", "tool_error_count", "approval_count", "retry_count", "cost_total",
             "token_total", "cycle_active_count", "cycle_blocked_count", "cycle_abandoned_count",
             "cycle_completed_count", "cycle_unknown_count")
    result = {}
    for name in names:
        values = [record["aggregates"].get(name, "unavailable") for record in records]
        result[name] = (sum(values) if values and all(isinstance(value, (int, float)) and not isinstance(value, bool)
                                                      for value in values) else "unavailable")
    return result


def history_capture_query(args):
    return {name: getattr(args, name, None) for name in (
        "after", "before", "method_revision", "cycle_id", "state", "context", "project_digest",
        "reviewed_status", "archive_only",
    )}


def validate_history_capture(value, members):
    allowed = {"schema_version", "capture_id", "query", "snapshot", "session_ceiling", "part_ceiling",
               "database_digest", "exclusion_digest", "page_size", "pages", "member_count",
               "members_digest", "aggregates"}
    transient = {"kind", "created_at"}
    private_index = {"source_generation"}
    if (not isinstance(value, dict) or set(value) not in (
            allowed, allowed | transient, allowed | private_index, allowed | transient | private_index)
            or value.get("schema_version") != 1
            or not isinstance(value.get("query"), dict)
            or set(value["query"]) != {"after", "before", "method_revision", "cycle_id", "state", "context",
                                       "project_digest", "reviewed_status", "archive_only"}
            or type(value["query"]["archive_only"]) is not bool
            or type(value.get("page_size")) is not int or not 1 <= value["page_size"] <= REVIEW_MAX_LIMIT
            or type(value.get("member_count")) is not int or value["member_count"] < 0
            or not isinstance(value.get("pages"), list)
            or bool(value["pages"]) != bool(value["member_count"])
            or not isinstance(value.get("aggregates"), dict)):
        fail("private history capture has an invalid schema")
    if "source_generation" in value and not re.fullmatch(r"[0-9a-f]{32}", value["source_generation"]):
        fail("private history capture has an invalid source generation")
    if transient.issubset(value) and (value["kind"] != "federated" or type(value["created_at"]) is not int
                                      or value["created_at"] < REVIEW_START_MS):
        fail("private history capture has an invalid retention identity")
    for name in ("snapshot", "session_ceiling", "part_ceiling"):
        if type(value.get(name)) is not int or value[name] < 0:
            fail("private history capture has an invalid snapshot")
    history_digest(value.get("database_digest"), "database digest")
    if value.get("exclusion_digest") is not None:
        history_digest(value["exclusion_digest"], "exclusion digest")
    history_digest(value.get("members_digest"), "capture members digest")
    for name in ("method_revision", "cycle_id", "state", "context", "reviewed_status"):
        item = value["query"][name]
        if item is not None and (not isinstance(item, str) or not OPAQUE_ID.fullmatch(item)):
            fail("private history capture has an invalid query")
    for name in ("after", "before"):
        item = value["query"][name]
        if item is not None and (type(item) is not int or item < REVIEW_START_MS):
            fail("private history capture has an invalid query")
    project_digest = value["query"]["project_digest"]
    if project_digest is not None:
        history_digest(project_digest, "project digest")
    if value["query"]["state"] not in (None, "active", "blocked", "abandoned", "completed", "unknown"):
        fail("private history capture has an invalid query")
    if value["query"]["reviewed_status"] not in (None, "reviewed", "unreviewed"):
        fail("private history capture has an invalid query")
    expected_cursor = 0
    total = 0
    for position, page in enumerate(value["pages"]):
        page_fields = {"cursor", "limit", "count", "continuation", "digest"}
        if "source_digest" in page:
            page_fields.add("source_digest")
            history_digest(page["source_digest"], "capture page source digest")
        if "source_scope" in page:
            page_fields.add("source_scope")
            if page["source_scope"] not in ("boundary", "full"):
                fail("private history capture page source scope is invalid")
        if (not isinstance(page, dict) or set(page) != page_fields
                or type(page.get("cursor")) is not int or page["cursor"] != expected_cursor
                or page.get("limit") != value["page_size"] or type(page.get("count")) is not int
                or not 1 <= page["count"] <= page["limit"]):
            fail("private history capture page coverage is invalid")
        history_digest(page.get("digest"), "capture page digest")
        if position < len(value["pages"]) - 1 and page["count"] != value["page_size"]:
            fail("private history capture page coverage is invalid")
        expected_continuation = expected_cursor + value["page_size"] if position < len(value["pages"]) - 1 else None
        if page.get("continuation") != expected_continuation:
            fail("private history capture page coverage is invalid")
        expected_cursor += value["page_size"]
        total += page["count"]
    records = [validate_history_evidence(record) for record in members]
    ids = [record["session_id"] for record in records]
    if total != value["member_count"] or len(records) != value["member_count"] or len(set(ids)) != len(ids):
        fail("private history capture membership mismatch")
    aggregate = history_capture_aggregates(records)
    if aggregate != value["aggregates"]:
        fail("private history capture aggregate projection mismatch")
    if hashlib.sha256(ledger_payload(records).encode()).hexdigest() != value["members_digest"]:
        fail("private history capture members digest mismatch")
    identity = {key: value[key] for key in value if key != "capture_id"}
    expected_id = hashlib.sha256(ledger_payload(identity).encode()).hexdigest()[:24]
    if value.get("capture_id") != expected_id:
        fail("private history capture identity mismatch")
    return value, records


def history_capture_summary(value):
    return {"schema_version": 1, "capture_id": value["capture_id"], "query": value["query"],
            "snapshot": value["snapshot"], "page_size": value["page_size"],
            "page_count": len(value["pages"]), "member_count": value["member_count"],
            "aggregates": value["aggregates"]}


def history_lens_summary(manifest, members, lens, scope, excluded_family=(), exclusion_digest=None):
    if any("review_session" not in member for member in members):
        fail("history capture review-session attribution is unavailable")
    members = [member for member in members if member["session_id"] not in excluded_family]
    selected = [member for member in members if member["review_session"] == (scope == "only")]
    aggregate_names = sorted(BENCHMARK_METRICS)
    telemetry_names = ("delegation_count", "gate_failure_count", "gate_reopen_count",
                       "remediation_round_count", "provider_error_count")

    def metrics(member):
        values = {name: member["aggregates"].get(name, "unavailable") for name in aggregate_names}
        telemetry = member.get("telemetry", {})
        for name in telemetry_names[:-1]:
            values[name] = telemetry.get(name, "unavailable")
        errors = telemetry.get("error_classes", {})
        values["provider_error_count"] = errors.get("provider_error", "unavailable") if isinstance(errors, dict) else "unavailable"
        return values

    metric_rows = [(member, metrics(member)) for member in selected]
    metric_summaries = {}
    for name in (*aggregate_names, *telemetry_names):
        values = [row[name] for _, row in metric_rows
                  if isinstance(row[name], (int, float)) and not isinstance(row[name], bool)]
        metric_summaries[name] = {
            "available_count": len(values), "unavailable_count": len(selected) - len(values),
            "total": sum(values) if values else "unavailable",
            "minimum": min(values) if values else "unavailable",
            "maximum": max(values) if values else "unavailable",
        }

    def counts(values):
        return {value: values.count(value) for value in sorted(set(values))}

    cycles = [cycle for member in selected for cycle in member["cycles"]]
    categories = {
        "cycle_state": counts([cycle["state"] for cycle in cycles]),
        "risk": counts([cycle.get("risk", "unavailable") for cycle in cycles]),
        "delivery_intent": counts([cycle.get("delivery_intent", "unavailable") for cycle in cycles]),
        "correlation_quality": counts([member["correlation_quality"] for member in selected]),
        "reviewed_status": counts([member["reviewed_status"] for member in selected]),
        "session_relation": counts([member.get("telemetry", {}).get("session_relation", "unavailable")
                                    for member in selected]),
    }

    def score(member, values):
        states = [cycle["state"] for cycle in member["cycles"]]
        risks = [cycle.get("risk", "unavailable") for cycle in member["cycles"]]
        cycle_metrics = [cycle.get("metrics", {}) for cycle in member["cycles"]]
        phase_profiles = [cycle.get("phase_profile", {}) for cycle in member["cycles"]]
        number = lambda name: values.get(name) if isinstance(values.get(name), (int, float)) else 0
        gates = sum(metric.get("gate_failure_count", 0) for metric in cycle_metrics)
        reopens = sum(metric.get("gate_reopen_count", 0) for metric in cycle_metrics)
        remediation = sum(metric.get("remediation_round_count", 0) for metric in cycle_metrics)
        repeated = sum(profile.get("repeated_work", 0) for profile in phase_profiles if isinstance(profile, dict))
        common = (risks.count("critical"), states.count("blocked"), states.count("abandoned"))
        if lens == "correctness_safety":
            return (*common, gates, reopens, number("tool_error_count"), number("provider_error_count"))
        if lens == "reliability_recovery":
            return (states.count("blocked"), states.count("abandoned"), number("provider_error_count"),
                    number("tool_error_count"), reopens, remediation)
        if lens == "performance_cost":
            return (number("cost_total"), number("token_total"), number("elapsed_ms"), number("tool_call_count"))
        if lens == "operator_experience":
            return (states.count("blocked"), number("approval_count"), number("retry_count"),
                    number("tool_error_count"), number("elapsed_ms"))
        if lens == "architecture_rnd_meta":
            return (repeated, number("child_count"), number("delegation_count"), remediation,
                    number("tool_count"))
        return (reopens, remediation, number("retry_count"), number("tool_error_count"), repeated)

    def projection(member, values, signal_score):
        cycle_rank = {"blocked": 4, "abandoned": 3, "active": 2, "unknown": 1, "completed": 0}
        projected_cycles = sorted(member["cycles"], key=lambda cycle: (
            cycle_rank.get(cycle["state"], 0), cycle.get("risk", ""), cycle["cycle_id"]), reverse=True)[:3]
        return {
            "session_id": member["session_id"], "context": member["context"],
            "completed_at": member["completed_at"], "correlation_quality": member["correlation_quality"],
            "cycles": [{name: cycle[name] for name in ("cycle_id", "state", "risk", "delivery_intent")
                        if name in cycle} | ({"metrics": cycle["metrics"]} if "metrics" in cycle else {})
                       for cycle in projected_cycles],
            "metrics": values, "signal_score": list(signal_score),
        }

    ranked = sorted(((score(member, values), member, values) for member, values in metric_rows),
                    key=lambda item: (item[0], int(item[1]["completed_at"]), item[1]["session_id"]),
                    reverse=True)
    review_count = sum(member["review_session"] for member in selected)
    return {
        "schema_version": 1, "capture_id": manifest["capture_id"], "lens": lens, "scope": scope,
        "snapshot": manifest["snapshot"], "session_ceiling": manifest["session_ceiling"],
        "part_ceiling": manifest["part_ceiling"], "database_digest": manifest["database_digest"],
        "exclusion_digest": exclusion_digest or manifest["exclusion_digest"], "query": manifest["query"],
        "member_count": len(selected),
        "members_digest": hashlib.sha256(ledger_payload(selected).encode()).hexdigest(),
        "telemetry": {"page_count": max(1, len(manifest["pages"])), "session_count": len(selected),
                      "review_session_count": review_count,
                      "excluded_review_session_count": (len(members) - len(selected)) if scope == "exclude" else 0,
                      "unattributed_session_count": 0},
        "categories": categories, "metrics": metric_summaries,
        "evidence": [projection(member, values, signal_score)
                     for signal_score, member, values in ranked[:20]],
    }


def history_page_digest(records, source_identities, limit, cursor):
    identity = hashlib.sha256()
    identity.update(f"{limit}\0{cursor}\0".encode())
    for record in records:
        session_id = record["session_id"]
        identity.update(session_id.encode() + b"\0")
        source = source_identities.get(session_id)
        identity.update(bytes.fromhex(source) if source else hashlib.sha256(
            json.dumps(record, sort_keys=True, separators=(",", ":")).encode()).digest())
    return identity.hexdigest()


def history_page_source_identities(database_value, session_ids, snapshot, part_ceiling, seeds):
    if not session_ids:
        return seeds
    database = opencode_database(database_value)
    connection = sqlite3.connect(f"file:{database}?mode=ro", uri=True)
    try:
        tables = {row[0].lower(): row[0] for row in connection.execute(
            "SELECT name FROM sqlite_master WHERE type='table'")}
        message, part = tables["message"], tables["part"]
        mid = sqlite_name(connection, message, ("id",))
        msession = sqlite_name(connection, message, ("sessionid",))
        message_columns = {row[1].lower().replace("_", ""): row[1]
                           for row in connection.execute(f'PRAGMA table_info("{message}")')}
        mbody = next((message_columns[name] for name in ("data", "text", "content")
                      if name in message_columns), None)
        mtime = next((message_columns[name] for name in ("timecreated", "createdat", "time", "timestamp")
                      if name in message_columns), None)
        mupdated = message_columns.get("timeupdated")
        pmessage = sqlite_name(connection, part, ("messageid",))
        psession = sqlite_name(connection, part, ("sessionid", "session"))
        pbody = sqlite_name(connection, part, ("data", "text", "content"))
        ptime = sqlite_name(connection, part, ("timecreated", "createdat", "time", "timestamp"))
        part_columns = {row[1].lower().replace("_", ""): row[1]
                        for row in connection.execute(f'PRAGMA table_info("{part}")')}
        pupdated = part_columns.get("timeupdated")
        placeholders = ",".join("?" for _ in session_ids)
        digests = {session_id: hashlib.sha256(bytes.fromhex(seeds.get(session_id, "0" * 64)))
                   for session_id in session_ids}
        if mbody and mtime:
            mutation = f'"{mupdated}"' if mupdated else f'"{mbody}"'
            for session_id, message_id, timestamp, mutation_value in connection.execute(
                    f'SELECT "{msession}","{mid}","{mtime}",{mutation} FROM "{message}" '
                    f'WHERE "{msession}" IN ({placeholders}) AND "{mtime}"<=? ORDER BY "{msession}","{mid}"',
                    (*sorted(session_ids), snapshot)):
                digests[str(session_id)].update(hashlib.sha256(
                    f"m\0{message_id}\0{timestamp}\0{mutation_value}".encode()).digest())
        mutation = f'p."{pupdated}"' if pupdated else f'p."{pbody}"'
        for session_id, part_id, timestamp, mutation_value in connection.execute(
                f'SELECT p."{psession}",p.rowid,p."{ptime}",{mutation} FROM "{part}" p '
                f'WHERE p."{psession}" IN ({placeholders}) AND p.rowid<=? AND p."{ptime}"<=? '
                f'ORDER BY p."{psession}",p.rowid', (*sorted(session_ids), part_ceiling, snapshot)):
            digests[str(session_id)].update(hashlib.sha256(
                f"p\0{part_id}\0{timestamp}\0{mutation_value}".encode()).digest())
        return {session_id: digest.hexdigest() for session_id, digest in digests.items()}
    except (KeyError, sqlite3.Error) as error:
        fail(f"cannot bind history page source: {error}")
    finally:
        connection.close()


def history_identity(cycles, session_directory=None, session_ids=(), project_digest="unavailable", cache=None):
    """Use only unambiguous Cycle Record structure; never session prose or paths."""
    if not cycles and not session_ids:
        return {"method_revision": "unavailable", "context": "unavailable",
                "project_digest": project_digest}
    cache_key = (str(session_directory or ""), tuple(item["cycle_id"] for item in cycles))
    if cache is not None and cache_key in cache:
        return {**cache[cache_key], "project_digest": project_digest}
    directories = []
    worktree = Path(session_directory) if session_directory else None
    if worktree and worktree.is_dir():
        result = git(worktree, "rev-parse", "--git-common-dir", check=False)
        if not result.returncode:
            directory = Path(result.stdout.strip())
            directories.append((directory if directory.is_absolute() else worktree / directory).resolve() / "dbsctr/cycles")
    try:
        current = common_git_dir(root_dir()).resolve() / "dbsctr/cycles"
        if current not in directories:
            directories.append(current)
    except RuntimeError:
        pass
    wanted = {item["cycle_id"] for item in cycles}
    records = []
    paths = sorted({path for directory in directories if directory.is_dir() for path in directory.glob("*.json")})
    for path in paths:
        try:
            value = json.loads(path.read_text(encoding="utf-8"), object_pairs_hook=no_duplicate_keys)
            runtime_ids = value.get("runtime", {}).get("opencode", {}).get("session_ids", [])
            if value.get("cycle_id") in wanted or set(session_ids).intersection(runtime_ids):
                records.append(value)
        except (OSError, json.JSONDecodeError):
            continue
    def same(name, valid):
        values = {item.get(name) for item in records if valid(item.get(name))}
        return values.pop() if len(values) == 1 and len(records) == len(wanted) else "unavailable"
    result = {"method_revision": same("method_revision", lambda value: isinstance(value, str) and re.fullmatch(r"3\.\d+", value)),
              "context": same("context", lambda value: isinstance(value, str) and OPAQUE_ID.fullmatch(value))}
    if cache is not None:
        cache[cache_key] = result
    return {**result, "project_digest": project_digest}


def validate_history_report(value, path=None):
    text_fields = {"findings", "scorecards", "trends", "proposals", "caveats"}
    allowed = {"schema_version", "report_id", "cohort", "evidence", "query_digest", "rubric", *text_fields}
    rubric = value.get("rubric") if isinstance(value, dict) else None
    if (not isinstance(value, dict) or set(value) - allowed or not {"schema_version", "report_id", "cohort", "evidence", "query_digest", "rubric", "findings"} <= set(value) or value.get("schema_version") != 1
            or not isinstance(value.get("report_id"), str) or not isinstance(value.get("cohort"), list)
            or not isinstance(value.get("evidence"), list) or len(value["cohort"]) != len(value["evidence"])
            or len(value["cohort"]) < 1 or len(value["cohort"]) > REVIEW_MAX_LIMIT
            or not isinstance(rubric, dict) or set(rubric) != {"name", "version", "digest"}
            or not all(isinstance(rubric.get(name), str) and rubric[name] for name in ("name", "version"))
            or any(not isinstance(value.get(name, []), list) or len(value.get(name, [])) > 50
                   for name in text_fields)):
        fail("review history report has an invalid schema")
    history_digest(value.get("query_digest"), "query digest")
    history_digest(rubric.get("digest"), "rubric digest")
    def valid_text(item, limit):
        return isinstance(item, str) and 1 <= len(item.encode()) <= limit and not any(ord(char) < 32 or ord(char) == 127 for char in item)
    if not valid_text(rubric["name"], 256) or not valid_text(rubric["version"], 256) or not all(
            valid_text(item, 512) for name in text_fields for item in value.get(name, [])):
        fail("review history report has an invalid schema")
    if review_unsafe(" ".join([rubric["name"], rubric["version"], *(item for name in text_fields for item in value.get(name, []))])):
        fail("review history report contains unsafe content")
    expected = hashlib.sha256(json.dumps({key: value[key] for key in value if key != "report_id"}, sort_keys=True,
                                         separators=(",", ":")).encode()).hexdigest()[:24]
    if value["report_id"] != expected or path is not None and path.name != f"{expected}.json":
        fail("review history report marker does not match its content")
    ids = [history_id(item, "history cohort ID") for item in value["cohort"]]
    if len(set(ids)) != len(ids):
        fail("review history report has duplicate cohort IDs")
    records = [validate_history_evidence(item) for item in value["evidence"]]
    if [item["session_id"] for item in records] != ids:
        fail("review history report evidence does not match its cohort")
    return value


def history_report(path, root=None):
    try:
        if root is not None:
            private_legacy_file(root, path)
        value = json.loads(path.read_text(encoding="utf-8"), object_pairs_hook=no_duplicate_keys)
    except (OSError, json.JSONDecodeError) as error:
        fail(f"invalid review history report: {error}")
    return validate_history_report(value, path)


def history_reports(root):
    if ledger_exists(root):
        with ledger_connection(root) as connection:
            return [validate_history_report(json.loads(payload, object_pairs_hook=no_duplicate_keys))
                    for payload, in connection.execute(
                        "SELECT payload FROM history_reports WHERE kind='report' ORDER BY report_id")]
    directory = history_dir(root, "reports")
    if not directory.is_dir():
        return []
    return [history_report(path, root) for path in sorted(directory.glob("*.json"))]


def history_cohorts(root):
    if ledger_exists(root):
        with ledger_connection(root) as connection:
            return [validate_history_report(json.loads(payload, object_pairs_hook=no_duplicate_keys))
                    for payload, in connection.execute(
                        "SELECT payload FROM history_reports WHERE kind='cohort' ORDER BY report_id")]
    directory = history_dir(root, "cohorts")
    if not directory.is_dir():
        return []
    return [history_report(path, root) for path in sorted(directory.glob("*.json"))]


def validate_history_report_input(value):
    text_fields = ("findings", "scorecards", "trends", "proposals", "caveats")
    scan_fields = ("snapshot", "session_ceiling", "part_ceiling", "database_digest")
    page_fields = ("limit", "cursor")
    allowed = {"schema_version", "cohort", "query_digest", "rubric", *text_fields, *scan_fields, *page_fields}
    if (not isinstance(value, dict) or set(value) - allowed
            or not {"schema_version", "cohort", "query_digest", "rubric", "findings"} <= set(value)
            or value.get("schema_version") != 1):
        fail("review history report has an invalid schema")
    cohort = value["cohort"]
    if not isinstance(cohort, list) or not 1 <= len(cohort) <= REVIEW_MAX_LIMIT:
        fail("review history report has an invalid cohort")
    ids = [history_id(item, "history cohort ID") for item in cohort]
    if len(set(ids)) != len(ids):
        fail("review history report has duplicate cohort IDs")
    history_digest(value.get("query_digest"), "query digest")
    rubric = value.get("rubric")
    if not isinstance(rubric, dict) or set(rubric) != {"name", "version", "digest"}:
        fail("review history report has an invalid schema")
    history_digest(rubric.get("digest"), "rubric digest")
    def valid_text(item, limit):
        return (isinstance(item, str) and 1 <= len(item.encode()) <= limit
                and not any(ord(char) < 32 or ord(char) == 127 for char in item))
    if not valid_text(rubric.get("name"), 256) or not valid_text(rubric.get("version"), 256):
        fail("review history report has an invalid schema")
    for name in text_fields:
        items = value.get(name, [])
        if (not isinstance(items, list) or len(items) > 50
                or not all(valid_text(item, 512) for item in items)):
            fail("review history report has an invalid schema")
    if review_unsafe(" ".join([rubric["name"], rubric["version"],
                               *(item for name in text_fields for item in value.get(name, []))])):
        fail("review history report contains unsafe content")
    present_scan = {name for name in scan_fields if name in value}
    if present_scan and present_scan != set(scan_fields):
        fail("review history report has incomplete scan identity")
    if present_scan:
        if any(type(value[name]) is not int or value[name] < 0 for name in scan_fields[:3]):
            fail("review history report has invalid scan identity")
        history_digest(value["database_digest"], "database digest")
    present_page = {name for name in page_fields if name in value}
    if present_page and present_page != set(page_fields):
        fail("review history report has incomplete page identity")
    if present_page and not present_scan:
        fail("review history report page identity requires scan identity")
    if present_page and (type(value["limit"]) is not int or not 1 <= value["limit"] <= REVIEW_MAX_LIMIT
                         or type(value["cursor"]) is not int or value["cursor"] < 0):
        fail("review history report has invalid page identity")
    return {**value, **{name: value.get(name, []) for name in text_fields}}


def review_history_page(args, lock_held=False):
    root = review_root(args.state_root)
    excluded_family = historical_excluded_family(args.database, args.excluded_session_id,
                                                 args.excluded_message_id)
    if args.limit < 1 or args.limit > REVIEW_MAX_LIMIT or args.cursor < 0:
        fail("review history limit must be 1 through 100 and cursor non-negative")
    require_review_lock_safe(root)
    with (contextlib.nullcontext() if lock_held else existing_review_lock(root)):
        records = history_evidence(root)
        reports = history_reports(root)
        history_cohorts(root)  # Fail closed on malformed retained replay evidence.
        if args.replay:
            report = next((item for item in reports if item["report_id"] == args.replay), None)
            if report is None:
                fail("review history replay report is missing")
            if set(report["cohort"]).intersection(excluded_family):
                fail("review history replay intersects the excluded session family")
            records = report["evidence"]
        elif not args.archive_only:
            aggregate_membership = getattr(args, "aggregate_membership", False)
            live = review_scan(argparse.Namespace(database=args.database, state_root=args.state_root,
                               limit=REVIEW_MAX_LIMIT, cursor=0, snapshot=args.snapshot,
                               session_ceiling=args.session_ceiling, part_ceiling=args.part_ceiling,
                                database_digest=args.database_digest, lock_held=True,
                                 include_reviewed=True, history_metrics=not aggregate_membership,
                                 history_all=True,
                                 bind_history=not getattr(args, "membership_only", False),
                                 source_index=getattr(args, "source_index", None),
                                 metric_session_ids=getattr(args, "metric_session_ids", None),
                                 membership_only=getattr(args, "membership_only", False),
                                 capture_all=getattr(args, "capture_all", False),
                                  excluded_session_id=args.excluded_session_id,
                                  excluded_message_id=args.excluded_message_id,
                                  exclusion_digest=args.exclusion_digest))
            live_candidates = live["candidates"]
            live_records = [{"schema_version": 1, "session_id": item["session_id"],
                            "completed_at": str(item["last_activity"]),
                            **item.get("_history_identity", history_identity(item["cycles"])),
                             "cycles": item["cycles"],
                             "correlation_quality": item.get("correlation_quality", "unavailable"),
                             "aggregates": history_aggregates(item),
                            "snapshot": live["snapshot"], "session_ceiling": live["session_ceiling"],
                            "part_ceiling": live["part_ceiling"], "database_digest": live["database_digest"],
                             "reviewed_status": item["reviewed_status"],
                             "review_session": item.get("review_session", False),
                             **({"telemetry": item["telemetry"]} if "telemetry" in item else {})}
                            for item in live_candidates]
            archived = {item["session_id"]: item for item in records}
            merged_records = []
            for item in live_records:
                retained = archived.get(item["session_id"], {})
                merged = {**retained, **item}
                merged["review_session"] = bool(
                    retained.get("review_session", False) or item.get("review_session", False))
                merged_records.append(merged)
            records = merged_records
            records.extend(item for key, item in archived.items() if key not in {row["session_id"] for row in live_records})
            records = [item for item in records if item["session_id"] not in excluded_family]
        else:
            records = [item for item in records if item["session_id"] not in excluded_family]
        for name, value in (("after", args.after), ("before", args.before)):
            if value is not None and value < REVIEW_START_MS:
                fail(f"review history {name} must be a valid millisecond cutoff")
        if args.after is not None and args.before is not None and args.after > args.before:
            fail("review history after must not exceed before")
        def include(record):
            timestamp = int(record["completed_at"])
            return ((args.after is None or timestamp >= args.after) and (args.before is None or timestamp <= args.before)
                    and (args.method_revision is None or record["method_revision"] == args.method_revision)
                    and (args.context is None or record["context"] == args.context)
                    and (args.project_digest is None or record["project_digest"] == args.project_digest)
                    and (args.reviewed_status is None or record.get("reviewed_status", "reviewed") == args.reviewed_status)
                    and (args.cycle_id is None or any(cycle["cycle_id"] == args.cycle_id for cycle in record["cycles"]))
                    and (args.state is None or any(cycle["state"] == args.state for cycle in record["cycles"])))
        records = sorted((record for record in records if include(record)),
                         key=lambda item: (int(item["completed_at"]), item["session_id"]), reverse=True)
        page = records[args.cursor:args.cursor + args.limit]
        if getattr(args, "source_index", None) is not None and not args.replay and not args.archive_only:
            identity_cursor = getattr(args, "source_identity_cursor", args.cursor)
            boundary_source_digest = history_page_digest(
                page, live.get("_source_identities", {}), args.limit, identity_cursor)
        empty_archive = {"snapshot": 0, "session_ceiling": 0, "part_ceiling": 0,
                         "database_digest": hashlib.sha256(b"").hexdigest(), "exclusion_digest": None}
        metadata = ({} if args.replay else live if not args.archive_only else
                    (page[-1] if page else (records[-1] if records else empty_archive)))
        result = {"schema_version": 1, "candidates": page, "session_ids": [item["session_id"] for item in page],
                  "limit": args.limit, "cursor": args.cursor,
                  "continuation": args.cursor + args.limit if len(records) > args.cursor + args.limit else None,
                  "snapshot": metadata.get("snapshot"), "session_ceiling": metadata.get("session_ceiling"),
                   "part_ceiling": metadata.get("part_ceiling"), "database_digest": metadata.get("database_digest"),
                   "exclusion_digest": metadata.get("exclusion_digest"), "query": history_capture_query(args)}
        result["digest"] = review_digest(
            page, result["snapshot"], result["session_ceiling"], result["part_ceiling"],
            history_page_digest(page, live.get("_source_identities", {}) if not args.archive_only and not args.replay else {},
                                args.limit, args.cursor),
        )
        if getattr(args, "metric_session_ids", None) is not None:
            result["_boundary_source_digest"] = boundary_source_digest
            result["_page_source_digest"] = history_page_digest(
                page, live.get("_source_identities", {}), args.limit, identity_cursor)
        for name in ("snapshot", "session_ceiling", "part_ceiling", "database_digest", "exclusion_digest"):
            supplied = getattr(args, name)
            if args.replay and supplied is not None:
                fail("review history replay uses its report ID and cursor, not a live snapshot")
            if supplied is not None and supplied != result[name]:
                fail("review history replay does not match its immutable snapshot")
        if getattr(args, "capture_all", False):
            result["_capture_records"] = records
            result["_capture_source_identities"] = (
                live.get("_source_identities", {}) if not args.archive_only and not args.replay else {})
            if getattr(args, "source_index", None) is not None:
                result["_source_generation"] = args.source_index["generation_id"]
                result["_full_source_sessions"] = [item["session_id"] for item in page]
            return result
    encoded = json.dumps({key: value for key, value in result.items() if not key.startswith("_")},
                         sort_keys=True, separators=(",", ":"), ensure_ascii=True)
    if len(encoded.encode()) > HISTORY_SCAN_HARD:
        fail("review history response exceeds bound")
    return result


def history_capture_review_page(manifest, members, limit, cursor):
    if limit != manifest["page_size"] or cursor < 0 or cursor % limit:
        fail("review history capture page identity changed")
    page = members[cursor:cursor + limit]
    continuation = cursor + limit if len(members) > cursor + limit else None
    stored = next((item for item in manifest["pages"] if item["cursor"] == cursor), None)
    if page and stored is None:
        fail("review history capture page is missing")
    result = {
        "schema_version": 1, "capture_id": manifest["capture_id"], "candidates": page,
        "session_ids": [item["session_id"] for item in page], "limit": limit, "cursor": cursor,
        "continuation": continuation, "snapshot": manifest["snapshot"],
        "session_ceiling": manifest["session_ceiling"], "part_ceiling": manifest["part_ceiling"],
        "database_digest": manifest["database_digest"], "exclusion_digest": manifest["exclusion_digest"],
        "query": manifest["query"],
        "digest": stored["digest"] if stored else review_digest(
            [], manifest["snapshot"], manifest["session_ceiling"], manifest["part_ceiling"],
            history_page_digest([], {}, limit, cursor)),
    }
    if len(json.dumps(result, sort_keys=True, separators=(",", ":")).encode()) > HISTORY_SCAN_HARD:
        fail("review history response exceeds bound")
    return result


def history_metric(values, selected_count):
    available = sorted(value for value in values if type(value) is int and value >= 0)
    if not available:
        summary = {"mean": "unavailable", "p50": "unavailable", "p90": "unavailable"}
    else:
        rank = lambda percentile: available[min(len(available) - 1, math.ceil(percentile * len(available)) - 1)]
        summary = {"mean": sum(available) // len(available), "p50": rank(.5), "p90": rank(.9)}
    return {"available_count": len(available), "unavailable_count": selected_count - len(available), **summary}


def history_aggregate_page(manifest, members, limit, cursor, source_digest):
    if limit != manifest["page_size"] or cursor < 0 or cursor % limit:
        fail("review history capture page identity changed")
    page = members[cursor:cursor + limit]
    continuation = cursor + limit if len(members) > cursor + limit else None
    selected_count = len(page)
    relation = [item.get("telemetry", {}).get("session_relation", "unavailable") for item in page]
    review = [("review" if item.get("review_session") is True else "non_review"
               if item.get("review_session") is False else "unavailable") for item in page]
    telemetry = [item.get("telemetry") for item in page]
    correlation = [item.get("correlation_quality", "unavailable") for item in page]
    cycles = [cycle for item in page for cycle in item.get("cycles", [])]
    metric_sources = {
        "elapsed_ms": [item.get("aggregates", {}).get("elapsed_ms") for item in page],
        "tokens": [item.get("telemetry", {}).get("token_total") for item in page],
        "tool_calls": [item.get("aggregates", {}).get("tool_call_count") for item in page],
        "tool_errors": [item.get("aggregates", {}).get("tool_error_count") for item in page],
        "child_sessions": [item.get("aggregates", {}).get("child_count") for item in page],
        "delegations": [item.get("telemetry", {}).get("delegation_count") for item in page],
    }

    def distribution(name):
        counts = {}
        for item in page:
            values = item.get("telemetry", {}).get(name, "unavailable")
            if isinstance(values, list):
                for value in set(values):
                    if isinstance(value, str) and re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}", value):
                        counts[value] = counts.get(value, 0) + 1
        return [{"value": value, "count": count}
                for value, count in sorted(counts.items(), key=lambda item: (-item[1], item[0]))[:100]]

    private_identity = {"mode": "aggregate-v1", "capture_id": manifest["capture_id"],
                        "snapshot": manifest["snapshot"], "session_ceiling": manifest["session_ceiling"],
                        "part_ceiling": manifest["part_ceiling"], "database_digest": manifest["database_digest"],
                        "exclusion_digest": manifest["exclusion_digest"], "query": manifest["query"],
                        "limit": limit, "cursor": cursor,
                        "session_ids": [item["session_id"] for item in page],
                        "source_digest": source_digest}
    query = manifest["query"]
    return {
        "schema_version": 1, "mode": "aggregate", "capture_id": manifest["capture_id"],
        "snapshot": manifest["snapshot"], "session_ceiling": manifest["session_ceiling"],
        "part_ceiling": manifest["part_ceiling"], "database_digest": manifest["database_digest"],
        "exclusion_digest": manifest["exclusion_digest"],
        "query": {"after": query["after"], "before": query["before"],
                  "method_revision": query["method_revision"],
                  "cycle_filter_applied": query["cycle_id"] is not None, "state": query["state"],
                  "context": query["context"], "project_digest": query["project_digest"],
                  "reviewed_status": query["reviewed_status"], "archive_only": query["archive_only"]},
        "limit": limit, "cursor": cursor, "selected_count": selected_count,
        "continuation": continuation,
        "digest": hashlib.sha256(ledger_payload(private_identity).encode()).hexdigest(),
        "cohort": {
            "sessions": {
                "relation": {name: relation.count(name) for name in ("primary", "child", "unavailable")},
                "review": {name: review.count(name) for name in ("review", "non_review", "unavailable")},
                "telemetry_available": sum(isinstance(item, dict) for item in telemetry),
                "telemetry_unavailable": sum(not isinstance(item, dict) for item in telemetry),
            },
            "correlation_quality": {name: correlation.count(name) for name in (
                "exact", "family", "worktree", "source", "ambiguous", "unavailable")},
            "cycle_states": {name: sum(cycle.get("state") == name for cycle in cycles) for name in (
                "active", "blocked", "abandoned", "completed", "unknown")},
        },
        "metrics": {name: history_metric(values, selected_count) for name, values in metric_sources.items()},
        "distributions": {"agents": distribution("agent_ids"), "models": distribution("model_ids")},
    }


def bind_history_capture_page_source(root, capture_id, cursor, digest):
    connection = ensure_ledger_for_write(root)
    try:
        ensure_capture_schema(connection)
        connection.execute("BEGIN IMMEDIATE")
        row = connection.execute(
            "SELECT digest FROM history_capture_page_sources WHERE capture_id=? AND cursor=?",
            (capture_id, cursor)).fetchone()
        if row is None:
            connection.execute("INSERT INTO history_capture_page_sources VALUES (?,?,?)",
                               (capture_id, cursor, digest))
        elif row[0] != digest:
            fail("review history capture source changed")
        connection.commit()
    except Exception:
        connection.rollback()
        raise
    finally:
        connection.close()


def aggregate_history_records(args, manifest, members, source_index, lock_held=True):
    expected = members[args.cursor:args.cursor + args.limit]
    wanted = {item["session_id"] for item in expected}
    if not expected:
        return members, hashlib.sha256(b"").hexdigest()
    query = manifest["query"]
    page_args = argparse.Namespace(
        database=args.database, state_root=args.state_root, archive_only=False,
        limit=args.limit, cursor=0, after=query["after"], before=query["before"],
        method_revision=query["method_revision"], cycle_id=query["cycle_id"], state=query["state"],
        context=query["context"], project_digest=query["project_digest"],
        reviewed_status=query["reviewed_status"], replay=None, snapshot=manifest["snapshot"],
        session_ceiling=manifest["session_ceiling"], part_ceiling=manifest["part_ceiling"],
        database_digest=manifest["database_digest"], exclusion_digest=manifest["exclusion_digest"],
        excluded_session_id=None, excluded_message_id=None, capture_all=False,
        aggregate_membership=False, source_index=source_index, metric_session_ids=wanted,
        source_identity_cursor=args.cursor,
    )
    enriched_page = review_history_page(page_args, lock_held=lock_held)
    stored_page = next((item for item in manifest["pages"] if item["cursor"] == args.cursor), None)
    aggregate_source_digest = enriched_page.pop("_page_source_digest", None)
    boundary_source_digest = enriched_page.pop("_boundary_source_digest", None)
    if stored_page is None:
        fail("review history capture source changed")
    if stored_page.get("source_scope") == "full":
        if stored_page.get("source_digest") != aggregate_source_digest:
                fail("review history capture source changed")
    else:
        if stored_page.get("source_digest") != boundary_source_digest:
                fail("review history capture source changed")
        bind_history_capture_page_source(review_root(args.state_root), manifest["capture_id"],
                                         args.cursor, aggregate_source_digest)
    enriched = enriched_page["candidates"]
    if [item["session_id"] for item in enriched] != [item["session_id"] for item in expected]:
        fail("review history capture population changed")
    result = list(members)
    result[args.cursor:args.cursor + len(enriched)] = enriched
    return result, aggregate_source_digest


def capture_history_args(args):
    return argparse.Namespace(
        database=args.database, state_root=args.state_root,
        archive_only=getattr(args, "archive_only", False),
        limit=args.page_size, cursor=0, after=args.after, before=args.before,
        method_revision=args.method_revision, cycle_id=args.cycle_id, state=args.state,
        context=args.context, project_digest=args.project_digest, reviewed_status=args.reviewed_status,
        replay=None, snapshot=None, session_ceiling=None, part_ceiling=None, database_digest=None,
        exclusion_digest=None, capture_all=True,
        excluded_session_id=args.excluded_session_id, excluded_message_id=args.excluded_message_id,
    )


def command_history_capture_save(args):
    root = review_root(args.state_root)
    with review_lock(root) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        source = review_history_page(capture_history_args(args), lock_held=True)
        manifest, _ = persist_history_capture(root, source, args.page_size)
    print(json.dumps(history_capture_summary(manifest), sort_keys=True, separators=(",", ":")))


def prune_federated_captures(connection, now):
    benchmark_exists = connection.execute(
        "SELECT 1 FROM sqlite_master WHERE type='table' AND name='benchmark_effects'").fetchone() is not None
    referenced = set()
    if benchmark_exists:
        for baseline, observation in connection.execute(
                "SELECT baseline_capture_id,observation_capture_id FROM benchmark_effects"):
            referenced.update((baseline, observation))
    for capture_id, payload in connection.execute("SELECT capture_id,payload FROM history_captures").fetchall():
        manifest = json.loads(payload, object_pairs_hook=no_duplicate_keys)
        if (manifest.get("kind") == "federated"
                and manifest.get("created_at", now) < now - FEDERATED_CAPTURE_RETENTION_MS
                and capture_id not in referenced):
            connection.execute("DELETE FROM history_captures WHERE capture_id=?", (capture_id,))


def persist_history_capture(root, source, page_size, allow_empty=False, transient=False):
    members = [validate_history_evidence(item) for item in source.pop("_capture_records")]
    source_identities = source.pop("_capture_source_identities")
    source_generation = source.pop("_source_generation", None)
    full_source_sessions = set(source.pop("_full_source_sessions", []))
    if not members and not allow_empty:
        fail("history capture query selected no evidence")
    identity = {name: source[name] for name in (
        "snapshot", "session_ceiling", "part_ceiling", "database_digest", "exclusion_digest")}
    pages = []
    for cursor in range(0, len(members), page_size):
        records = members[cursor:cursor + page_size]
        continuation = cursor + page_size if len(members) > cursor + page_size else None
        pages.append({"cursor": cursor, "limit": page_size, "count": len(records),
                      "continuation": continuation,
                      "source_scope": "full" if {item["session_id"] for item in records} <= full_source_sessions
                      else "boundary",
                      "source_digest": history_page_digest(records, source_identities, page_size, cursor),
                      "digest": review_digest(
                          records, identity["snapshot"], identity["session_ceiling"], identity["part_ceiling"],
                          history_page_digest(records, source_identities, page_size, cursor))})
    manifest = {"schema_version": 1, "query": source["query"], **identity, "page_size": page_size,
                "pages": pages, "member_count": len(members),
                "members_digest": hashlib.sha256(ledger_payload(members).encode()).hexdigest(),
                "aggregates": history_capture_aggregates(members)}
    if source_generation is not None:
        manifest["source_generation"] = source_generation
    if transient:
        manifest.update({"kind": "federated", "created_at": max(REVIEW_START_MS, int(time.time() * 1000))})
    manifest["capture_id"] = hashlib.sha256(ledger_payload(manifest).encode()).hexdigest()[:24]
    validate_history_capture(manifest, members)
    connection = ensure_ledger_for_write(root)
    ensure_capture_schema(connection)
    try:
        connection.execute("BEGIN IMMEDIATE")
        if transient:
            prune_federated_captures(connection, manifest["created_at"])
        existing = connection.execute(
            "SELECT payload FROM history_captures WHERE capture_id=?", (manifest["capture_id"],)).fetchone()
        if existing is not None and existing[0] != ledger_payload(manifest):
            fail("history capture identity collision")
        if existing is None:
            connection.execute("INSERT INTO history_captures VALUES (?, ?)",
                               (manifest["capture_id"], ledger_payload(manifest)))
            connection.executemany("INSERT INTO history_capture_members VALUES (?, ?, ?, ?)",
                                   ((manifest["capture_id"], position, record["session_id"], ledger_payload(record))
                                    for position, record in enumerate(members)))
        connection.commit()
    except Exception:
        connection.rollback()
        raise
    finally:
        connection.close()
    return manifest, members


def command_review_history(args):
    root = review_root(args.state_root)
    aggregate_only = getattr(args, "aggregate_only", False)
    if aggregate_only:
        if args.capture or args.replay or args.archive_only:
            fail("aggregate history requires a live immutable capture")
        if args.capture_id:
            changed = any(getattr(args, name) is not None for name in (
                "after", "before", "method_revision", "cycle_id", "state", "context", "project_digest",
                "reviewed_status", "snapshot", "session_ceiling", "part_ceiling", "database_digest",
                "excluded_session_id", "excluded_message_id", "exclusion_digest"))
            if changed:
                fail("review history capture query cannot change")
            require_review_lock_safe(root)
            with review_lock(root) as lock:
                fcntl.flock(lock, fcntl.LOCK_EX)
                with ledger_connection(root) as connection:
                    manifest, members = load_history_capture(connection, args.capture_id)
                if "source_generation" not in manifest:
                    raise SourceIndexUnavailable("source_index_unavailable")
                source_index = require_history_source_index(
                    args, manifest["part_ceiling"], manifest.get("source_generation"),
                    manifest["session_ceiling"])
                members, source_digest = aggregate_history_records(args, manifest, members, source_index)
        else:
            if any(getattr(args, name) is not None for name in (
                    "snapshot", "session_ceiling", "part_ceiling", "database_digest", "exclusion_digest")):
                fail("aggregate history creates its own immutable snapshot")
            with review_lock(root) as lock:
                fcntl.flock(lock, fcntl.LOCK_EX)
                source_index = require_history_source_index(args)
                membership_only = not any(getattr(args, name) is not None for name in (
                    "method_revision", "cycle_id", "state", "context", "project_digest"))
                capture_args = argparse.Namespace(**{
                    **vars(args), "aggregate_only": False, "capture": False, "capture_all": True,
                    "aggregate_membership": True, "membership_only": membership_only,
                    "source_index": source_index,
                    "session_ceiling": source_index["validated_session_ceiling"],
                    "part_ceiling": source_index["validated_part_ceiling"],
                    "metric_session_ids": None,
                })
                source = review_history_page(capture_args, lock_held=True)
                manifest, members = persist_history_capture(
                    root, source, args.limit, allow_empty=True, transient=True)
                members, source_digest = aggregate_history_records(args, manifest, members, source_index)
        result = history_aggregate_page(manifest, members, args.limit, args.cursor, source_digest)
    elif args.capture:
        if (args.capture_id or args.replay or any(getattr(args, name) is not None for name in (
                "snapshot", "session_ceiling", "part_ceiling", "database_digest", "exclusion_digest"))):
            fail("review history accepts only one capture identity")
        with review_lock(root) as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            capture_args = argparse.Namespace(**{**vars(args), "capture": False, "capture_all": True})
            source = review_history_page(capture_args, lock_held=True)
            manifest, members = persist_history_capture(root, source, args.limit, allow_empty=True, transient=True)
        result = history_capture_review_page(manifest, members, args.limit, args.cursor)
    elif args.capture_id:
        changed = (args.database is not None or args.archive_only or args.replay
                   or any(getattr(args, name) is not None for name in (
                       "after", "before", "method_revision", "cycle_id", "state", "context", "project_digest",
                       "reviewed_status", "snapshot", "session_ceiling", "part_ceiling", "database_digest",
                       "excluded_session_id", "excluded_message_id", "exclusion_digest")))
        if changed:
            fail("review history capture query cannot change")
        require_review_lock_safe(root)
        with existing_review_lock(root):
            with ledger_connection(root) as connection:
                manifest, members = load_history_capture(connection, args.capture_id)
        result = history_capture_review_page(manifest, members, args.limit, args.cursor)
    else:
        result = review_history_page(args)
    print(json.dumps(result, sort_keys=True, separators=(",", ":"), ensure_ascii=True))


def load_history_capture(connection, capture_id):
    if not isinstance(capture_id, str) or not re.fullmatch(r"[0-9a-f]{24}", capture_id):
        fail("invalid history capture ID")
    if connection.execute("SELECT value FROM ledger_meta WHERE key='capture_schema'").fetchone() is None:
        fail("history capture is missing")
    row = connection.execute("SELECT payload FROM history_captures WHERE capture_id=?", (capture_id,)).fetchone()
    if row is None:
        fail("history capture is missing")
    manifest = json.loads(row[0], object_pairs_hook=no_duplicate_keys)
    members = history_capture_members(connection, capture_id)
    return validate_history_capture(manifest, members)


def command_history_capture(args):
    root = review_root(args.state_root)
    if not ledger_exists(root):
        fail("history capture is missing")
    require_review_lock_safe(root)
    with existing_review_lock(root):
        with ledger_connection(root) as connection:
            manifest, members = load_history_capture(connection, args.capture_id)
        excluded_family = historical_excluded_family(
            args.database, args.excluded_session_id, args.excluded_message_id) if args.lens_summary else set()
        root_session = (args.excluded_session_id or session_for_message(args.database, args.excluded_message_id)
                        if args.excluded_message_id else args.excluded_session_id)
        result = (history_lens_summary(manifest, members, args.lens_summary, args.review_sessions,
                                       excluded_family, session_id_digest(root_session) if root_session else None)
                  if args.lens_summary else history_capture_summary(manifest))
        if args.cursor is not None and not args.lens_summary:
            if args.cursor < 0:
                fail("history capture cursor must be non-negative")
            page = members[args.cursor:args.cursor + args.limit]
            result.update({"cursor": args.cursor, "limit": args.limit, "members": page,
                           "continuation": args.cursor + args.limit
                           if len(members) > args.cursor + args.limit else None})
        encoded = json.dumps(result, sort_keys=True, separators=(",", ":"), ensure_ascii=True)
        if len(encoded.encode()) > HISTORY_SCAN_HARD:
            fail("history capture response exceeds bound")
        print(encoded)


def command_history_capture_latest(args):
    root = review_root(args.state_root)
    query = history_capture_query(args)
    now = max(REVIEW_START_MS, int(time.time() * 1000))
    manifest = members = None
    with review_lock(root) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if ledger_exists(root):
            with ledger_connection(root) as connection:
                if connection.execute(
                        "SELECT 1 FROM sqlite_master WHERE type='table' AND name='history_captures'").fetchone():
                    rows = connection.execute("SELECT capture_id,payload FROM history_captures").fetchall()
                    candidates = []
                    for capture_id, payload in rows:
                        value = json.loads(payload, object_pairs_hook=no_duplicate_keys)
                        if (value.get("kind") == "federated" and value.get("exclusion_digest") is None
                                and value.get("query") == query
                                and now - FEDERATED_CAPTURE_RETENTION_MS <= value.get("created_at", 0)
                                <= now + 5 * 60 * 1000):
                            candidates.append((value["created_at"], capture_id))
                    if candidates:
                        manifest, members = load_history_capture(connection, max(candidates)[1])
        if manifest is None:
            capture_args = capture_history_args(argparse.Namespace(
                **{**vars(args), "excluded_session_id": None, "excluded_message_id": None}))
            source = review_history_page(capture_args, lock_held=True)
            manifest, members = persist_history_capture(
                root, source, args.page_size, allow_empty=True, transient=True)
    result = {"schema_version": 1, "capture_id": manifest["capture_id"],
              "created_at": manifest["created_at"], "query": manifest["query"],
              "snapshot": manifest["snapshot"], "session_ceiling": manifest["session_ceiling"],
              "part_ceiling": manifest["part_ceiling"], "database_digest": manifest["database_digest"],
              "page_size": manifest["page_size"], "page_count": max(1, len(manifest["pages"])),
              "member_count": manifest["member_count"]}
    print(json.dumps(result, sort_keys=True, separators=(",", ":")))


def command_history_capture_delete(args):
    root = review_root(args.state_root)
    if not ledger_exists(root):
        fail("history capture is missing")
    require_review_lock_safe(root)
    with review_lock(root) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        connection = ledger_connection(root, write=True)
        try:
            load_history_capture(connection, args.capture_id)
            connection.execute("BEGIN IMMEDIATE")
            connection.execute("DELETE FROM history_captures WHERE capture_id=?", (args.capture_id,))
            record_knowledge_privacy_tombstone(
                connection, "history_capture", args.capture_id, "deleted",
                int(time.time() * 1000))
            connection.commit()
        except Exception:
            connection.rollback()
            raise
        finally:
            connection.close()
    print(json.dumps({"deleted": args.capture_id}, sort_keys=True))


def command_review_privacy_epoch(args):
    index = review_index(review_root(args.state_root))
    identity = {"schema_version": 1, "forgotten_sessions": sorted(index["forgotten_sessions"].items())}
    print(json.dumps({"schema_version": 1,
                      "privacy_epoch_digest": hashlib.sha256(ledger_payload(identity).encode()).hexdigest()},
                      sort_keys=True, separators=(",", ":")))


def knowledge_privacy_status(root):
    digest = hashlib.sha256(ledger_payload(
        {"schema_version": 1, "tombstones": []}).encode()).hexdigest()
    sequence = 0
    if ledger_exists(root):
        connection = ledger_connection(root)
        try:
            values = dict(connection.execute(
                "SELECT key,value FROM ledger_meta WHERE key IN "
                "('knowledge_privacy_sequence','knowledge_privacy_digest')"))
        finally:
            connection.close()
        if "knowledge_privacy_sequence" in values:
            if (set(values) != {"knowledge_privacy_sequence", "knowledge_privacy_digest"}
                    or not values["knowledge_privacy_sequence"].isdigit()
                    or not 0 <= int(values["knowledge_privacy_sequence"]) < 2**64
                    or not re.fullmatch(r"[0-9a-f]{64}", values["knowledge_privacy_digest"])):
                fail("knowledge privacy state is invalid")
            sequence = int(values["knowledge_privacy_sequence"])
            digest = values["knowledge_privacy_digest"]
    return {"schema_version": 1, "privacy_sequence": sequence, "privacy_digest": digest}


def command_knowledge_privacy_status(args):
    root = review_root(args.state_root)
    require_review_lock_safe(root)
    with existing_review_lock(root):
        value = knowledge_privacy_status(root)
    print(json.dumps(value, sort_keys=True, separators=(",", ":")))


def command_knowledge_privacy_guard(args):
    if not 0 <= args.expected_sequence < 2**64:
        fail("invalid expected privacy sequence")
    if not re.fullmatch(r"[0-9a-f]{64}", args.expected_digest):
        fail("invalid expected privacy digest")
    program = list(args.program)
    if program and program[0] == "--":
        program.pop(0)
    if not program:
        fail("privacy guard requires a program")
    root = review_root(args.state_root)
    require_review_lock_safe(root)
    with review_lock(root) as lock:
        fcntl.flock(lock, fcntl.LOCK_SH)
        current = knowledge_privacy_status(root)
        if (current["privacy_sequence"] != args.expected_sequence
                or current["privacy_digest"] != args.expected_digest):
            fail("knowledge privacy status mismatch")
        result = subprocess.run(program, stdin=subprocess.DEVNULL)
    raise SystemExit(result.returncode)


def knowledge_high_entropy_text(value, field=None):
    free_text = {"caveats", "confounders", "context", "decision", "findings", "notes",
                 "proposals", "reason", "recommendations", "scorecards", "summary", "title",
                 "trends"}
    if isinstance(value, dict):
        return any(knowledge_high_entropy_text(item, key) for key, item in value.items())
    if isinstance(value, list):
        return any(knowledge_high_entropy_text(item, field) for item in value)
    return field in free_text and isinstance(value, str) and HIGH_ENTROPY.search(value)


def knowledge_record(family, source_id, payload, retention="retained"):
    text = json.dumps(payload, ensure_ascii=False)
    if (SECRET_VALUE.search(text) or knowledge_high_entropy_text(payload)
            or re.search(r"\b[\w.+-]+@[\w.-]+\.[A-Za-z]{2,}\b", text)
            or re.search(r"\b(?:https?|ftp)://", text, re.I)
            or re.search(r"(?<![A-Za-z0-9._~-])(?:~|/)[^\s`)'\"\]}]+", text)):
        fail("knowledge export contains unsafe content")
    text = ledger_payload(payload)
    return {
        "type": "record", "schema_version": 1, "family": family,
        "record_id": hashlib.sha256(f"{family}\0{source_id}".encode()).hexdigest(),
        "revision": hashlib.sha256(text.encode()).hexdigest(),
        "retention": retention, "text": text,
    }


def knowledge_ledger_records(root):
    if not ledger_exists(root):
        return []
    connection = ledger_connection(root)
    records = []
    try:
        tables = {row[0] for row in connection.execute(
            "SELECT name FROM sqlite_master WHERE type='table'")}
        for report_id, reviewed_at, payload in connection.execute(
                "SELECT report_id,reviewed_at,payload FROM review_reports ORDER BY report_id"):
            report = json.loads(payload, object_pairs_hook=no_duplicate_keys)
            records.append(knowledge_record("review", report_id, {
                "report_id": report_id, "reviewed_at": reviewed_at,
                "decision": report.get("decision"), "notes": report.get("notes"),
                "findings": report.get("findings", []), "scorecards": report.get("scorecards", []),
                "trends": report.get("trends", []), "proposals": report.get("proposals", []),
                "caveats": report.get("caveats", []),
            }, retention="expires"))
        for report_id, kind, payload in connection.execute(
                "SELECT report_id,kind,payload FROM history_reports ORDER BY report_id"):
            records.append(knowledge_record(
                "history_report", report_id,
                {"kind": kind, "report": json.loads(payload, object_pairs_hook=no_duplicate_keys)}))
        for session_id, completed_at, payload in connection.execute(
                "SELECT session_id,completed_at,payload FROM history_evidence ORDER BY session_id"):
            evidence = json.loads(payload, object_pairs_hook=no_duplicate_keys)
            records.append(knowledge_record("telemetry", session_id, {
                "session_id": session_id, "completed_at": completed_at,
                "state": evidence.get("state"), "context": evidence.get("context"),
                "risk": evidence.get("risk"), "metrics": evidence.get("metrics", {}),
                "availability": evidence.get("availability", {}),
            }))
        if "history_captures" in tables:
            for capture_id, payload in connection.execute(
                    "SELECT capture_id,payload FROM history_captures ORDER BY capture_id"):
                manifest = json.loads(payload, object_pairs_hook=no_duplicate_keys)
                records.append(knowledge_record("history_capture", capture_id, {
                    key: manifest.get(key) for key in (
                        "capture_id", "snapshot", "session_ceiling", "part_ceiling",
                        "database_digest", "exclusion_digest", "query_digest", "member_count")
                }, retention="expires" if manifest.get("kind") == "federated" else "retained"))
        if "benchmark_effects" in tables:
            for benchmark_id, payload in connection.execute(
                    "SELECT benchmark_id,payload FROM benchmark_effects ORDER BY benchmark_id"):
                records.append(knowledge_record(
                    "benchmark", benchmark_id,
                    json.loads(payload, object_pairs_hook=no_duplicate_keys)))
        if "phase_spans" in tables:
            for row in connection.execute(
                    "SELECT cycle_id,span_id,parent_span_id,phase,operation,attribution,"
                    "started_at,finished_at,result FROM phase_spans ORDER BY cycle_id,span_id"):
                cycle_id, span_id, parent, phase, operation, attribution, started, finished, result = row
                records.append(knowledge_record("execution", f"{cycle_id}-{span_id}", {
                    "cycle_id": cycle_id, "span_id": span_id, "parent_span_id": parent,
                    "phase": phase, "operation": operation, "attribution": attribution,
                    "started_at": started, "finished_at": finished, "result": result,
                }))
        if "provider_evaluation_reports" in tables:
            for report_id, payload in connection.execute(
                    "SELECT report_id,payload FROM provider_evaluation_reports ORDER BY report_id"):
                report = json.loads(payload, object_pairs_hook=no_duplicate_keys)
                records.append(knowledge_record("provider_evaluation", report_id, {
                    key: report.get(key) for key in (
                        "report_id", "rubric", "harness_identity", "aggregates", "availability",
                        "confounders", "findings", "recommendations", "created_at")
                }))
        if "improvement_workers" in tables:
            for worker_id, opportunity_id, summary, priority, state, cycle_id, created_at, updated_at in connection.execute(
                    "SELECT worker_id,opportunity_id,summary,priority,state,cycle_id,created_at,updated_at "
                    "FROM improvement_workers ORDER BY worker_id"):
                records.append(knowledge_record("improvement", worker_id, {
                    "worker_id": worker_id, "opportunity_id": opportunity_id,
                    "summary": summary, "priority": priority, "state": state,
                    "cycle_id": cycle_id, "created_at": created_at, "updated_at": updated_at,
                }))
        if "knowledge_privacy_tombstones" in tables:
            for family, item_id, reason, timestamp in knowledge_privacy_rows(connection):
                records.append({
                    "type": "privacy", "schema_version": 1, "family": family,
                    "record_id": hashlib.sha256(f"{family}\0{item_id}".encode()).hexdigest(),
                    "reason": reason, "timestamp": timestamp,
                })
    finally:
        connection.close()
    return records


def knowledge_cycle_records(repository):
    records = []
    directory = cycle_dir(repository) / "cycles"
    for path in sorted(directory.glob("*.json")) if directory.is_dir() else ():
        try:
            cycle = read_cycle_record(repository, path, "export Cycle Record")
        except (OSError, json.JSONDecodeError) as error:
            fail(f"cannot export Cycle Record: {error}")
        cycle_id = cycle.get("cycle_id")
        if not isinstance(cycle_id, str) or not OPAQUE_ID.fullmatch(cycle_id):
            fail("cannot export invalid Cycle Record")
        records.append(knowledge_record("cycle", cycle_id, {
            "cycle_id": cycle_id, "context": cycle.get("context"), "state": cycle.get("state"),
            "risk": cycle.get("risk"), "delivery_intent": cycle.get("delivery_intent"),
            "method_revision": cycle.get("method_revision"), "schema_version": cycle.get("schema_version"),
            "gates": {name: {key: gate.get(key) for key in ("applicability", "result", "reason")
                             if gate.get(key) is not None}
                      for name, gate in sorted(cycle.get("gates", {}).items())},
            "metrics": cycle.get("metrics", {}), "created_at": cycle.get("created_at"),
            "completed_at": cycle.get("completed_at"),
        }))
        for evidence_id, item in sorted(cycle.get("evidence", {}).get("items", {}).items()):
            records.append(knowledge_record("gate_evidence", evidence_id, {
                "evidence_id": evidence_id, "cycle_id": cycle_id, "gate": item.get("gate"),
                "authority": item.get("authority"), "result": item.get("result"),
                "summary": item.get("summary"), "head": item.get("head"),
                "started_at": item.get("started_at"), "finished_at": item.get("finished_at"),
                "content_status": item.get("content", {}).get("status")
                if isinstance(item.get("content"), dict) else "unavailable",
            }))
    return records


def knowledge_export_lines(root):
    privacy = knowledge_privacy_status(root)
    ledger = ledger_exists(root)
    repository = root_dir()
    families = {
        "cycle": "available" if (cycle_dir(repository) / "cycles").is_dir() else "unavailable",
        "gate_evidence": "available" if (cycle_dir(repository) / "evidence").is_dir() else "unavailable",
        "review": "available" if ledger else "unavailable",
        "history_report": "available" if ledger else "unavailable",
        "history_capture": "available" if ledger else "unavailable",
        "telemetry": "available" if ledger else "unavailable",
        "benchmark": "available" if ledger else "unavailable",
        "execution": "available" if ledger else "unavailable",
        "provider_evaluation": "available" if ledger else "unavailable",
        "improvement": "available" if ledger else "unavailable",
    }
    records = knowledge_cycle_records(repository) + knowledge_ledger_records(root)
    records.sort(key=lambda item: (0 if item["type"] == "privacy" else 1,
                                   item.get("family", ""), item["record_id"]))
    if len(records) > 10000:
        fail("knowledge export exceeds record bound")
    manifest = {"type": "manifest", "schema_version": 1, **privacy,
                "families": families, "record_count": len(records)}
    first = json.dumps(manifest, sort_keys=True, separators=(",", ":"), ensure_ascii=True)
    encoded_records = [json.dumps(record, sort_keys=True, separators=(",", ":"), ensure_ascii=True)
                       for record in records]
    payload = "".join(f"{line}\n" for line in [first, *encoded_records])
    if len(payload.encode()) > 16 * 1024 * 1024:
        fail("knowledge export exceeds byte bound")
    terminal = json.dumps({"type": "terminal", "schema_version": 1,
                           "digest": hashlib.sha256(payload.encode()).hexdigest(),
                           "record_count": len(records)},
                          sort_keys=True, separators=(",", ":"), ensure_ascii=True)
    return [first, *encoded_records, terminal]


def command_knowledge_export(args):
    root = review_root(args.state_root)
    require_review_lock_safe(root)
    with existing_review_lock(root):
        lines = knowledge_export_lines(root)
    print("\n".join(lines))


def validate_provider_evaluation_receipt(value):
    if (not isinstance(value, dict) or set(value) != {"schema_version", "manifest_digest", "manifest_identity", "sources"}
            or value.get("schema_version") != 1
            or not re.fullmatch(r"[0-9a-f]{64}", value.get("manifest_digest", ""))
            or hashlib.sha256(ledger_payload(value.get("manifest_identity")).encode()).hexdigest()
            != value.get("manifest_digest")
            or not isinstance(value.get("sources"), list) or not 1 <= len(value["sources"]) <= 33):
        fail("provider evaluation receipt has an invalid schema")
    manifest = value["manifest_identity"]
    if (not isinstance(manifest, dict) or set(manifest) != {"filters", "sources"}
            or not isinstance(manifest.get("filters"), dict) or not isinstance(manifest.get("sources"), list)
            or [source.get("source_id") for source in manifest["sources"]]
            != [source.get("source_id") for source in value["sources"]]):
        fail("provider evaluation receipt has invalid manifest identity")
    seen = set()
    page_fields = {"schema_version", "capture_id", "candidates", "session_ids", "limit", "cursor",
                   "continuation", "snapshot", "session_ceiling", "part_ceiling", "database_digest",
                   "exclusion_digest", "query", "digest", "member_digests"}
    query_fields = {"after", "before", "method_revision", "cycle_id", "state", "context",
                    "project_digest", "reviewed_status", "archive_only"}
    for source in value["sources"]:
        if (not isinstance(source, dict) or set(source) != {"source_id", "capture_id", "privacy_epoch_digest", "pages"}
                or not PRESENTATION_ID.fullmatch(source.get("source_id", "")) or source["source_id"] in seen
                or not re.fullmatch(r"[0-9a-f]{24}", source.get("capture_id", ""))
                or not re.fullmatch(r"[0-9a-f]{64}", source.get("privacy_epoch_digest", ""))
                or not isinstance(source.get("pages"), list) or not source["pages"]):
            fail("provider evaluation receipt has invalid source identity")
        seen.add(source["source_id"])
        expected_cursor = 0
        source_identity = None
        for position, page in enumerate(source["pages"]):
            if (not isinstance(page, dict) or set(page) != page_fields or page.get("schema_version") != 1
                    or page.get("capture_id") != source["capture_id"] or page.get("cursor") != expected_cursor
                    or not re.fullmatch(r"[0-9a-f]{64}", page.get("digest", ""))
                    or type(page.get("limit")) is not int or not 1 <= page["limit"] <= REVIEW_MAX_LIMIT
                    or not isinstance(page.get("candidates"), list) or len(page["candidates"]) > page["limit"]
                    or not isinstance(page.get("session_ids"), list)
                    or page["session_ids"] != [candidate.get("session_id") for candidate in page["candidates"]]
                    or not isinstance(page.get("member_digests"), list)
                    or page["member_digests"] != [hashlib.sha256(ledger_payload(candidate).encode()).hexdigest()
                                                   for candidate in page["candidates"]]
                    or page.get("continuation") != (page["cursor"] + page["limit"]
                                                    if position < len(source["pages"]) - 1 else None)
                    or any(type(page.get(name)) is not int or page[name] < 0
                           for name in ("snapshot", "session_ceiling", "part_ceiling"))
                    or not re.fullmatch(r"[0-9a-f]{64}", page.get("database_digest", ""))
                    or page.get("exclusion_digest") is not None
                    and not re.fullmatch(r"[0-9a-f]{64}", page["exclusion_digest"])
                    or not isinstance(page.get("query"), dict) or set(page["query"]) != query_fields
                    or type(page["query"].get("archive_only")) is not bool
                    or any(item is not None and (type(item) is not int or item < REVIEW_START_MS)
                           for item in (page["query"]["after"], page["query"]["before"]))
                    or any(item is not None and (not isinstance(item, str) or not OPAQUE_ID.fullmatch(item))
                           for item in (page["query"]["cycle_id"], page["query"]["context"]))
                    or page["query"]["method_revision"] is not None
                    and (not isinstance(page["query"]["method_revision"], str)
                         or not re.fullmatch(r"\d+(?:\.\d+)*", page["query"]["method_revision"]))
                    or page["query"]["project_digest"] is not None
                    and (not isinstance(page["query"]["project_digest"], str)
                         or not re.fullmatch(r"[0-9a-f]{64}", page["query"]["project_digest"]))
                    or page["query"]["state"] not in (None, "active", "blocked", "abandoned", "completed", "unknown")
                    or page["query"]["reviewed_status"] not in (None, "reviewed", "unreviewed")):
                fail("provider evaluation receipt has invalid page identity")
            identity = {name: page[name] for name in ("capture_id", "snapshot", "session_ceiling",
                                                       "part_ceiling", "database_digest", "exclusion_digest", "query", "limit")}
            if source_identity is not None and identity != source_identity:
                fail("provider evaluation receipt source identity changed")
            source_identity = identity
            for candidate in page["candidates"]:
                validate_history_evidence(candidate)
            expected_cursor += page["limit"]
        if source["pages"][-1]["continuation"] is not None:
            fail("provider evaluation receipt is not terminal")
    if any(source["pages"][0]["query"] != manifest["filters"] for source in value["sources"]):
        fail("provider evaluation receipt query changed")
    for source, manifest_source in zip(value["sources"], manifest["sources"]):
        if not isinstance(manifest_source, dict):
            fail("provider evaluation receipt has invalid manifest identity")
        expected = {"source_id", "availability"}
        if manifest_source.get("availability") == "available":
            expected |= {"capture_id", "snapshot", "session_ceiling", "part_ceiling", "database_digest",
                         "exclusion_digest", "limit", "cursor", "continuation", "digest"}
            page = source["pages"][-1]
            if any(manifest_source.get(name) != page[name] for name in expected - {"source_id", "availability"}):
                fail("provider evaluation receipt manifest changed")
        elif manifest_source.get("availability") != "complete":
            fail("provider evaluation receipt manifest is not terminal")
        if not isinstance(manifest_source, dict) or set(manifest_source) != expected:
            fail("provider evaluation receipt has invalid manifest identity")
    if len(json.dumps(value, sort_keys=True, separators=(",", ":")).encode()) > 2 * 1024 * 1024:
        fail("provider evaluation receipt exceeds bound")
    return value


def provider_evaluation_candidates(receipt):
    eligible = []
    for source in receipt["sources"]:
        for page in source["pages"]:
            for candidate in page["candidates"]:
                if (not isinstance(candidate, dict) or candidate.get("correlation_quality") != "exact"
                        or not isinstance(candidate.get("cycles"), list) or len(candidate["cycles"]) != 1
                        or candidate["cycles"][0].get("state") != "completed"
                        or not isinstance(candidate.get("completed_at"), str) or not candidate["completed_at"].isdigit()):
                    continue
                cycle = candidate["cycles"][0]
                try:
                    activation = validate_stored_harness_activation(cycle.get("harness_activation"))
                    metrics = validate_cycle_metrics(cycle.get("metrics"))
                    telemetry = validate_history_telemetry(candidate.get("telemetry"))
                except RuntimeError:
                    continue
                if (metrics["elapsed_ms"] == "unavailable" or telemetry.get("schema_version") != TELEMETRY_SCHEMA
                        or cycle.get("risk") not in ("routine", "elevated", "critical")
                        or cycle.get("delivery_intent") not in DELIVERY_INTENTS
                        or telemetry.get("session_relation") != "primary"
                        or telemetry.get("provider_ids") != [activation["provider_id"]]
                        or not isinstance(telemetry.get("model_ids"), list)
                        or activation["model_id"] not in telemetry["model_ids"]
                        or not isinstance(telemetry.get("agent_ids"), list)
                        or activation["agent_id"] not in telemetry["agent_ids"]
                        or telemetry.get("core_revisions") != [activation["core_revision"]]
                        or telemetry.get("overlay_revisions") != [activation["overlay_revision"]]):
                    continue
                cycle_id = cycle.get("cycle_id")
                if not isinstance(cycle_id, str) or not OPAQUE_ID.fullmatch(cycle_id):
                    continue
                harness = {name: activation[name] for name in (
                    "provider_id", "model_id", "agent_id", "core_revision", "overlay_revision")}
                errors = telemetry["error_classes"] if isinstance(telemetry["error_classes"], dict) else {}
                optional_metrics = {
                    "tool_call_count": candidate.get("aggregates", {}).get("tool_call_count", "unavailable"),
                    "tool_error_count": candidate.get("aggregates", {}).get("tool_error_count", "unavailable"),
                    "provider_error_count": errors.get("provider_error", "unavailable"),
                    **{name: telemetry[name] for name in (
                        "delegation_count", "approval_count", "retry_count", "token_total", "cost_total")},
                }
                member = {"source_id": source["source_id"], "cycle_id": cycle_id,
                          "completed_at": int(candidate["completed_at"]), "context": candidate.get("context", "unavailable"),
                          "risk": cycle["risk"], "delivery_intent": cycle["delivery_intent"],
                          **{name: telemetry[name] for name in ("provider_ids", "model_ids", "agent_ids")},
                          "metrics": metrics, "optional_metrics": optional_metrics,
                          "telemetry_digest": hashlib.sha256(ledger_payload(telemetry).encode()).hexdigest(),
                          "gate_digest": hashlib.sha256(ledger_payload(metrics).encode()).hexdigest()}
                eligible.append((harness, member))
    return eligible


def provider_evaluation_evidence(receipt):
    return [{"source_id": source["source_id"], "capture_id": source["capture_id"],
             "privacy_epoch_digest": source["privacy_epoch_digest"],
             "query_digest": hashlib.sha256(ledger_payload(source["pages"][0]["query"]).encode()).hexdigest(),
             "exclusion_digest": source["pages"][0]["exclusion_digest"],
             "pages": [{"cursor": page["cursor"], "digest": page["digest"],
                         "member_digests": page["member_digests"]}
                        for page in source["pages"]]} for source in receipt["sources"]]


def command_provider_evaluation_save(args):
    try:
        raw = sys.stdin.read() if args.receipt_json == "-" else args.receipt_json
        receipt = validate_provider_evaluation_receipt(json.loads(raw, object_pairs_hook=no_duplicate_keys))
        prose = json.loads(args.report_json, object_pairs_hook=no_duplicate_keys)
    except json.JSONDecodeError as error:
        fail(f"invalid provider evaluation input: {error}")
    if (not isinstance(prose, dict) or set(prose) != {"rubric", "findings", "recommendations"}
            or not isinstance(prose.get("rubric"), dict)
            or set(prose["rubric"]) != {"name", "version", "digest"}
            or not all(isinstance(prose["rubric"].get(name), str) for name in ("name", "version", "digest"))
            or not OPAQUE_ID.fullmatch(prose["rubric"]["name"])
            or not OPAQUE_ID.fullmatch(prose["rubric"]["version"])
            or not re.fullmatch(r"[0-9a-f]{64}", prose["rubric"]["digest"])):
        fail("invalid provider evaluation rubric")
    for name in ("findings", "recommendations"):
        if (not isinstance(prose.get(name), list) or len(prose[name]) > 50
                or any(not isinstance(item, str) or not 1 <= len(item.encode()) <= 512
                       or review_unsafe(item) for item in prose[name])):
            fail("invalid provider evaluation prose")
    root = review_root(args.state_root)
    with review_lock(root) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        connection = ensure_ledger_for_write(root)
        staged = None
        committed = False
        try:
            ensure_provider_evaluation_schema(connection)
            connection.execute("BEGIN IMMEDIATE")
            current_ms = int(time.time() * 1000)
            affected_report_ids = set()
            for source in receipt["sources"]:
                previous = connection.execute(
                    "SELECT privacy_epoch_digest FROM provider_evaluation_sources WHERE source_id=?",
                    (source["source_id"],)).fetchone()
                if previous is not None and previous[0] != source["privacy_epoch_digest"]:
                    report_ids = [row[0] for row in connection.execute(
                        "SELECT DISTINCT report_id FROM provider_evaluation_members WHERE source_id=?",
                        (source["source_id"],))]
                    affected_report_ids.update(report_ids)
                    connection.executemany("DELETE FROM provider_evaluation_reports WHERE report_id=?",
                                           ((report_id,) for report_id in report_ids))
                connection.execute("INSERT INTO provider_evaluation_sources VALUES (?, ?, 'available', ?) "
                                   "ON CONFLICT(source_id) DO UPDATE SET privacy_epoch_digest=excluded.privacy_epoch_digest, "
                                   "availability='available', verified_at=excluded.verified_at",
                                   (source["source_id"], source["privacy_epoch_digest"], current_ms))
            if affected_report_ids:
                quarantine_name = f".forget-{uuid.uuid4().hex}"
                connection.execute("INSERT INTO ledger_meta VALUES ('pending_forget_cleanup', ?)",
                                   (quarantine_name,))
                staged = stage_provider_evaluation_backups(root, affected_report_ids, quarantine_name)
            rubric_key = hashlib.sha256(ledger_payload(prose["rubric"]).encode()).hexdigest()
            existing = connection.execute(
                "SELECT reports.payload FROM provider_evaluation_reports AS reports "
                "JOIN provider_evaluation_receipts AS receipts USING (report_id) "
                "WHERE reports.rubric_key=? AND receipts.payload=? ORDER BY reports.created_at, reports.report_id LIMIT 1",
                (rubric_key, ledger_payload(receipt)),
            ).fetchone()
            if existing is not None:
                connection.rollback()
                print(existing[0])
                return
            groups = {}
            for harness, member in provider_evaluation_candidates(receipt):
                harness_key = hashlib.sha256(ledger_payload(harness).encode()).hexdigest()
                used = connection.execute(
                    "SELECT 1 FROM provider_evaluation_members WHERE rubric_key=? AND harness_key=? "
                    "AND source_id=? AND cycle_id=?", (rubric_key, harness_key, member["source_id"],
                                                        member["cycle_id"])).fetchone()
                if used is None:
                    groups.setdefault((harness_key, ledger_payload(harness)), []).append(member)
            qualified = []
            for (harness_key, serialized), members in groups.items():
                members.sort(key=lambda item: (item["completed_at"], item["cycle_id"], item["source_id"]))
                if len(members) >= 5:
                    qualified.append((members[0]["completed_at"], harness_key, serialized, members[:5]))
            if not qualified:
                if staged is None:
                    connection.rollback()
                else:
                    connection.commit()
                    committed = True
                    recover_forget_state(root, connection)
                print(json.dumps({"schema_version": 1, "status": "insufficient",
                                  "eligible_count": max((len(items) for items in groups.values()), default=0)},
                                 sort_keys=True, separators=(",", ":")))
                return
            _, harness_key, serialized_harness, members = min(qualified)
            harness = json.loads(serialized_harness)
            identity = {"rubric": prose["rubric"], "harness_identity": harness,
                        "members": [{name: member[name] for name in ("source_id", "cycle_id")}
                                    for member in members]}
            report_id = hashlib.sha256(ledger_payload(identity).encode()).hexdigest()[:24]
            existing = connection.execute(
                "SELECT payload FROM provider_evaluation_reports WHERE report_id=?", (report_id,)).fetchone()
            if existing is not None:
                connection.rollback()
                print(existing[0])
                return
            optional = ("tool_call_count", "tool_error_count", "provider_error_count", "delegation_count",
                        "approval_count", "retry_count", "token_total", "cost_total")
            aggregates = {"elapsed_ms_median": median(member["metrics"]["elapsed_ms"] for member in members),
                          "gate_failure_count": sum(member["metrics"]["gate_failure_count"] for member in members),
                          "gate_reopen_count": sum(member["metrics"]["gate_reopen_count"] for member in members),
                          "remediation_round_count": sum(member["metrics"]["remediation_round_count"] for member in members)}
            availability = {name: "unavailable" for name in optional}
            for name in optional:
                values = [member["optional_metrics"][name] for member in members]
                if all(isinstance(value, (int, float)) and not isinstance(value, bool) for value in values):
                    availability[name] = "available"
                    aggregates[name] = sum(values)
            contexts = sorted({member["context"] for member in members})
            risks = sorted({member["risk"] for member in members})
            deliveries = sorted({member["delivery_intent"] for member in members})
            child_agents = {tuple(member["agent_ids"]) for member in members}
            report = {"schema_version": 1, "report_id": report_id, **identity, "members": members,
                      "evidence": provider_evaluation_evidence(receipt),
                      "aggregates": aggregates, "availability": availability,
                      "confounders": (["context_distribution"] if len(contexts) > 1 else [])
                      + (["risk_distribution"] if len(risks) > 1 else [])
                      + (["delivery_distribution"] if len(deliveries) > 1 else [])
                      + (["child_agent_distribution"] if len(child_agents) > 1
                         or any(member["agent_ids"] != [harness["agent_id"]] for member in members) else []),
                      "findings": prose["findings"], "recommendations": prose["recommendations"],
                      "created_at": current_ms, "association_only": True}
            validate_provider_evaluation_report(report)
            connection.execute("INSERT INTO provider_evaluation_reports VALUES (?, ?, ?, ?, ?)",
                               (report_id, rubric_key, harness_key, current_ms, ledger_payload(report)))
            connection.executemany("INSERT INTO provider_evaluation_members VALUES (?, ?, ?, ?, ?, ?, ?)",
                                   ((report_id, position, rubric_key, harness_key, member["source_id"],
                                     member["cycle_id"], ledger_payload(member))
                                    for position, member in enumerate(members)))
            connection.execute("INSERT INTO provider_evaluation_receipts VALUES (?, ?)",
                               (report_id, ledger_payload(receipt)))
            connection.commit()
            committed = True
            if staged is not None:
                recover_forget_state(root, connection)
        except Exception:
            if not committed:
                connection.rollback()
                if staged is not None:
                    restore_staged_forget(*staged)
            raise
        finally:
            connection.close()
    print(json.dumps(report, sort_keys=True, separators=(",", ":")))


def command_provider_evaluation(args):
    root = review_root(args.state_root)
    if not ledger_exists(root):
        print(json.dumps({"schema_version": 1, "reports": []}, sort_keys=True))
        return
    with ledger_connection(root) as connection:
        if connection.execute(
                "SELECT value FROM ledger_meta WHERE key='provider_evaluation_schema'").fetchone() is None:
            print(json.dumps({"schema_version": 1, "reports": []}, sort_keys=True))
            return
        if args.report_id is None:
            reports = [{"report_id": row[0], "created_at": row[1]} for row in connection.execute(
                "SELECT report_id,created_at FROM provider_evaluation_reports ORDER BY created_at,report_id")]
            print(json.dumps({"schema_version": 1, "reports": reports}, sort_keys=True, separators=(",", ":")))
            return
        row = connection.execute("SELECT payload FROM provider_evaluation_reports WHERE report_id=?",
                                 (args.report_id,)).fetchone()
        if row is None:
            fail("provider evaluation report is missing")
        sources = [item[0] for item in connection.execute(
            "SELECT DISTINCT source_id FROM provider_evaluation_members WHERE report_id=?", (args.report_id,))]
        stale = int(time.time() * 1000) - 8 * 24 * 60 * 60 * 1000
        if any((state := connection.execute(
                "SELECT availability,verified_at FROM provider_evaluation_sources WHERE source_id=?", (source,)).fetchone())
                is None or state[0] != "available" or state[1] < stale for source in sources):
            fail("provider evaluation report is quarantined pending source privacy verification")
        print(row[0])


def command_provider_evaluation_forget(args):
    root = review_root(args.state_root)
    require_review_lock_safe(root)
    with review_lock(root) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        connection = ledger_connection(root, write=True)
        staged = None
        committed = False
        try:
            if connection.execute("SELECT payload FROM provider_evaluation_reports WHERE report_id=?",
                                  (args.report_id,)).fetchone() is None:
                fail("provider evaluation report is missing")
            connection.execute("BEGIN IMMEDIATE")
            connection.execute("DELETE FROM provider_evaluation_reports WHERE report_id=?", (args.report_id,))
            record_knowledge_privacy_tombstone(
                connection, "provider_evaluation", args.report_id, "forgotten",
                int(time.time() * 1000))
            quarantine_name = f".forget-{uuid.uuid4().hex}"
            connection.execute("INSERT INTO ledger_meta VALUES ('pending_forget_cleanup', ?)",
                               (quarantine_name,))
            staged = stage_provider_evaluation_backups(root, {args.report_id}, quarantine_name)
            connection.commit()
            committed = True
            recover_forget_state(root, connection)
        except Exception:
            if not committed:
                connection.rollback()
                if staged is not None:
                    restore_staged_forget(*staged)
            raise
        finally:
            connection.close()
    print(json.dumps({"forgotten": args.report_id}, sort_keys=True))


def validate_benchmark(value):
    top = {"schema_version", "benchmark_id", "definition", "inputs", "windows", "result", "evaluated_at"}
    definition_fields = {"version", "metric", "direction"}
    input_fields = {"baseline_capture_id", "observation_capture_id", "merge_identity", "merged_at",
                    "activation_status", "activation_identity", "activated_at"}
    result_fields = {"classification", "baseline_value", "observation_value", "delta", "confounders",
                     "unavailable_metrics", "association_only", "reason"}
    if (not isinstance(value, dict) or set(value) != top or value.get("schema_version") != 1
            or not re.fullmatch(r"[0-9a-f]{24}", value.get("benchmark_id", ""))
            or not isinstance(value.get("definition"), dict) or set(value["definition"]) != definition_fields
            or not OPAQUE_ID.fullmatch(value["definition"].get("version", ""))
            or value["definition"].get("metric") not in BENCHMARK_METRICS
            or value["definition"].get("direction") not in ("higher", "lower")
            or not isinstance(value.get("inputs"), dict) or set(value["inputs"]) != input_fields
            or not isinstance(value.get("result"), dict) or set(value["result"]) != result_fields
            or type(value.get("evaluated_at")) is not int or value["evaluated_at"] < REVIEW_START_MS):
        fail("benchmark evidence has an invalid schema")
    inputs, result = value["inputs"], value["result"]
    if (not all(re.fullmatch(r"[0-9a-f]{24}", inputs[name] or "")
                for name in ("baseline_capture_id", "observation_capture_id"))
            or not re.fullmatch(r"[0-9a-f]{40}(?:[0-9a-f]{24})?", inputs.get("merge_identity", ""))
            or type(inputs.get("merged_at")) is not int or inputs["merged_at"] < REVIEW_START_MS
            or inputs["merged_at"] > value["evaluated_at"]
            or inputs.get("activation_status") not in ("verified", "missing", "ambiguous")):
        fail("benchmark evidence has invalid inputs")
    verified = inputs["activation_status"] == "verified"
    if (verified and (not isinstance(inputs["activation_identity"], str)
                     or not OPAQUE_ID.fullmatch(inputs["activation_identity"])
                     or type(inputs["activated_at"]) is not int
                     or not inputs["merged_at"] <= inputs["activated_at"] <= value["evaluated_at"])):
        fail("benchmark evidence has invalid activation")
    if not verified and (inputs["activation_identity"] is not None or inputs["activated_at"] is not None):
        fail("benchmark evidence has invalid activation")
    windows = value["windows"]
    if verified:
        if (not isinstance(windows, dict) or set(windows) != {"days", "baseline", "observation"}
                or windows["days"] != 30 or any(not isinstance(windows[name], dict)
                or set(windows[name]) != {"after", "before"} for name in ("baseline", "observation"))):
            fail("benchmark evidence has invalid windows")
        expected_windows = {"days": 30,
                            "baseline": {"after": inputs["activated_at"] - BENCHMARK_WINDOW_MS,
                                         "before": inputs["activated_at"] - 1},
                            "observation": {"after": inputs["activated_at"],
                                            "before": inputs["activated_at"] + BENCHMARK_WINDOW_MS - 1}}
        if windows != expected_windows:
            fail("benchmark evidence has invalid windows")
    elif windows != "unavailable":
        fail("benchmark evidence has invalid windows")
    if (result.get("classification") not in ("improved", "neutral", "regressed", "insufficient")
            or result.get("association_only") is not True
            or not isinstance(result.get("confounders"), list)
            or len(result["confounders"]) > 64
            or result["confounders"] != sorted(set(result["confounders"]))
            or any(not OPAQUE_ID.fullmatch(item) for item in result["confounders"])
            or not isinstance(result.get("unavailable_metrics"), list)
            or result["unavailable_metrics"] != sorted(set(result["unavailable_metrics"]))
            or any(item not in BENCHMARK_METRICS for item in result["unavailable_metrics"])
            or result.get("reason") not in ("complete", "activation_missing", "activation_ambiguous",
                                             "window_incomplete", "window_mismatch", "metric_unavailable")):
        fail("benchmark evidence has an invalid result")
    for name in ("baseline_value", "observation_value", "delta"):
        item = result[name]
        if item != "unavailable" and (not isinstance(item, (int, float)) or isinstance(item, bool)
                                      or not math.isfinite(item)):
            fail("benchmark evidence has an invalid result")
    if (not verified and result["reason"] != f"activation_{inputs['activation_status']}"
            or verified and value["evaluated_at"] < inputs["activated_at"] + BENCHMARK_WINDOW_MS
            and result["reason"] != "window_incomplete"
            or result["unavailable_metrics"] not in ([], [value["definition"]["metric"]])):
        fail("benchmark evidence has an invalid result")
    if result["reason"] == "complete":
        if any(item == "unavailable" for item in (result["baseline_value"], result["observation_value"])):
            fail("benchmark evidence has an invalid result")
        delta = result["observation_value"] - result["baseline_value"]
        expected = ("neutral" if delta == 0 else "improved"
                    if (delta > 0) == (value["definition"]["direction"] == "higher") else "regressed")
        if result["delta"] != delta or result["classification"] != expected:
            fail("benchmark evidence has an invalid result")
    elif result["classification"] != "insufficient" or result["delta"] != "unavailable":
        fail("benchmark evidence has an invalid result")
    identity = {key: value[key] for key in ("definition", "inputs", "windows", "result", "evaluated_at")}
    if value["benchmark_id"] != hashlib.sha256(ledger_payload(identity).encode()).hexdigest()[:24]:
        fail("benchmark evidence identity mismatch")
    return value


def benchmark_report(args, baseline, observation):
    definition = {"version": history_id(args.definition_version, "benchmark definition version"),
                  "metric": args.metric, "direction": args.direction}
    if args.metric not in BENCHMARK_METRICS:
        fail("invalid benchmark metric")
    if len(args.confounder) > 64:
        fail("benchmark confounders exceed bound")
    if not re.fullmatch(r"[0-9a-f]{40}(?:[0-9a-f]{24})?", args.merge_identity):
        fail("invalid benchmark merge identity")
    if args.merged_at < REVIEW_START_MS or args.evaluated_at < args.merged_at:
        fail("invalid benchmark event time")
    verified = args.activation_status == "verified"
    if verified and (args.activation_identity is None or args.activated_at is None):
        fail("verified benchmark activation requires identity and time")
    if not verified and (args.activation_identity is not None or args.activated_at is not None):
        fail("unverified benchmark activation cannot claim identity or time")
    if verified:
        history_id(args.activation_identity, "benchmark activation identity")
        if not args.merged_at <= args.activated_at <= args.evaluated_at:
            fail("invalid benchmark activation time")
    inputs = {"baseline_capture_id": baseline["capture_id"],
              "observation_capture_id": observation["capture_id"],
              "merge_identity": args.merge_identity, "merged_at": args.merged_at,
              "activation_status": args.activation_status,
              "activation_identity": args.activation_identity, "activated_at": args.activated_at}
    windows = "unavailable"
    reason = f"activation_{args.activation_status}" if not verified else "complete"
    if verified:
        windows = {"days": 30,
                   "baseline": {"after": args.activated_at - BENCHMARK_WINDOW_MS,
                                "before": args.activated_at - 1},
                   "observation": {"after": args.activated_at,
                                   "before": args.activated_at + BENCHMARK_WINDOW_MS - 1}}
        if args.evaluated_at < args.activated_at + BENCHMARK_WINDOW_MS:
            reason = "window_incomplete"
        elif (any(baseline["query"].get(name) != windows["baseline"][name] for name in ("after", "before"))
              or any(observation["query"].get(name) != windows["observation"][name] for name in ("after", "before"))):
            reason = "window_mismatch"
    baseline_value = baseline["aggregates"].get(args.metric, "unavailable")
    observation_value = observation["aggregates"].get(args.metric, "unavailable")
    unavailable = ([args.metric] if "unavailable" in (baseline_value, observation_value) else [])
    if reason == "complete" and unavailable:
        reason = "metric_unavailable"
    classification, delta = "insufficient", "unavailable"
    if reason == "complete":
        delta = observation_value - baseline_value
        if delta == 0:
            classification = "neutral"
        elif (delta > 0) == (args.direction == "higher"):
            classification = "improved"
        else:
            classification = "regressed"
    confounders = set(args.confounder)
    if baseline["member_count"] != observation["member_count"]:
        confounders.add("population_drift")
    result = {"classification": classification, "baseline_value": baseline_value,
              "observation_value": observation_value, "delta": delta,
              "confounders": sorted(confounders), "unavailable_metrics": unavailable,
              "association_only": True, "reason": reason}
    identity = {"definition": definition, "inputs": inputs, "windows": windows,
                "result": result, "evaluated_at": args.evaluated_at}
    report = {"schema_version": 1,
              "benchmark_id": hashlib.sha256(ledger_payload(identity).encode()).hexdigest()[:24], **identity}
    return validate_benchmark(report)


def command_benchmark_save(args):
    root = review_root(args.state_root)
    if not ledger_exists(root):
        fail("private review ledger is missing")
    if args.evaluated_at > int(datetime.now(timezone.utc).timestamp() * 1000):
        fail("benchmark evaluation time cannot be in the future")
    require_review_lock_safe(root)
    with review_lock(root) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        connection = ledger_connection(root, write=True)
        try:
            baseline, _ = load_history_capture(connection, args.baseline_capture_id)
            observation, _ = load_history_capture(connection, args.observation_capture_id)
            report = benchmark_report(args, baseline, observation)
            ensure_benchmark_schema(connection)
            connection.execute("BEGIN IMMEDIATE")
            for payload, in connection.execute("SELECT payload FROM benchmark_effects"):
                existing_report = json.loads(payload, object_pairs_hook=no_duplicate_keys)
                if existing_report["inputs"]["merge_identity"] != args.merge_identity:
                    continue
                if existing_report["inputs"]["merged_at"] != args.merged_at:
                    fail("benchmark merge identity is immutable")
                if (args.activation_status == "verified"
                        and existing_report["inputs"]["activation_status"] == "verified"
                        and (existing_report["inputs"]["activation_identity"],
                             existing_report["inputs"]["activated_at"])
                        != (args.activation_identity, args.activated_at)):
                    fail("benchmark first verified activation is immutable")
            definition = connection.execute(
                "SELECT metric_name, direction FROM benchmark_definitions WHERE version=?",
                (args.definition_version,)).fetchone()
            expected = (args.metric, args.direction)
            if definition is not None and definition != expected:
                fail("benchmark definition version is immutable")
            if definition is None:
                connection.execute("INSERT INTO benchmark_definitions VALUES (?, ?, ?)",
                                   (args.definition_version, *expected))
            existing = connection.execute("SELECT payload FROM benchmark_effects WHERE benchmark_id=?",
                                          (report["benchmark_id"],)).fetchone()
            if existing is None:
                connection.execute("INSERT INTO benchmark_effects VALUES (?, ?, ?, ?, ?, ?)",
                                   (report["benchmark_id"], args.definition_version,
                                    args.baseline_capture_id, args.observation_capture_id,
                                    args.activation_identity, ledger_payload(report)))
            elif json.loads(existing[0], object_pairs_hook=no_duplicate_keys) != report:
                fail("benchmark identity collision")
            connection.commit()
        except Exception:
            connection.rollback()
            raise
        finally:
            connection.close()
    print(json.dumps(report, sort_keys=True, separators=(",", ":")))


def command_benchmark(args):
    root = review_root(args.state_root)
    if not ledger_exists(root):
        fail("benchmark evidence is missing")
    require_review_lock_safe(root)
    with existing_review_lock(root):
        with ledger_connection(root) as connection:
            if connection.execute("SELECT value FROM ledger_meta WHERE key='benchmark_schema'").fetchone() is None:
                fail("benchmark evidence is missing")
            row = connection.execute("SELECT payload FROM benchmark_effects WHERE benchmark_id=?",
                                     (args.benchmark_id,)).fetchone()
            if row is None:
                fail("benchmark evidence is missing")
            report = validate_benchmark(json.loads(row[0], object_pairs_hook=no_duplicate_keys))
    print(json.dumps(report, sort_keys=True, separators=(",", ":")))


WORKFLOW_DIAGNOSTICS = {
    "validation-failed": "Required validation failed; retain original gate evidence.",
    "operation-failed": "Lifecycle operation failed; retain existing evidence and work.",
    "operation-complete": "Lifecycle operation completed; no causal benefit is inferred.",
    "settings-unavailable": "Optional settings unavailable; new optional actions remain disabled.",
}
WORKFLOW_FEATURES = {"automatic-delivery", "automatic-remove", "targeted-upload", "external-feedback"}


def workflow_fields(value, fields):
    if not isinstance(value, dict) or set(value) != set(fields.split()):
        fail("unsupported_schema")


def workflow_integer(value, minimum=0):
    if type(value) is not int or not minimum <= value <= 2**53 - 1:
        fail("unsupported_schema")
    return value


def workflow_digest(value):
    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(",", ":"),
                                     ensure_ascii=False, allow_nan=False).encode()).hexdigest()


def workflow_hash(value):
    if not isinstance(value, str) or not re.fullmatch(r"[0-9a-f]{64}", value):
        fail("unsupported_schema")


def workflow_time(value):
    if not isinstance(value, str) or not re.fullmatch(r"\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d(?:\.\d{1,6})?Z", value):
        fail("unsupported_schema")
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        fail("unsupported_schema")


def workflow_feature_snapshot(release, settings):
    workflow_fields(settings, "schema_version features")
    if type(settings["schema_version"]) is not int or settings["schema_version"] != 1:
        fail("unsupported_schema")
    entries = settings["features"]
    if not isinstance(entries, list) or len(entries) > 64:
        fail("unsupported_schema")
    seen, enabled, normalized = set(), [], []
    for entry in entries:
        if not isinstance(entry, dict) or set(entry) - {"feature_id", "enabled"} or "feature_id" not in entry:
            fail("unsupported_schema")
        name = entry["feature_id"]
        if (not isinstance(name, str) or name not in WORKFLOW_FEATURES or name in seen
                or type(entry.get("enabled", False)) is not bool):
            fail("unsupported_schema")
        seen.add(name)
        normalized.append({"feature_id": name, "enabled": entry.get("enabled", False)})
        if entry.get("enabled", False):
            enabled.append(name)
    value = {"schema_version": 1, "release_commit": release, "config_schema_version": 1,
             "config_digest": workflow_digest({"schema_version": 1, "features": sorted(normalized, key=lambda e: e["feature_id"])}),
             "effective_enabled_feature_ids": sorted(enabled)}
    validate_workflow_snapshot(value)
    return value


def validate_workflow_snapshot(value):
    workflow_fields(value, "schema_version release_commit config_schema_version config_digest effective_enabled_feature_ids")
    if (type(value["schema_version"]) is not int or value["schema_version"] != 1
            or type(value["config_schema_version"]) is not int or value["config_schema_version"] != 1
            or not isinstance(value["release_commit"], str)
            or not re.fullmatch(r"[0-9a-f]{40}|[0-9a-f]{64}", value["release_commit"])):
        fail("unsupported_schema")
    workflow_hash(value["config_digest"])
    ids = value["effective_enabled_feature_ids"]
    if (not isinstance(ids, list) or len(ids) > 64 or any(not isinstance(i, str) or i not in WORKFLOW_FEATURES for i in ids)
            or ids != sorted(set(ids))):
        fail("unsupported_schema")


def workflow_rollback_compatible(current, previous):
    try:
        validate_workflow_snapshot(current)
        validate_workflow_snapshot(previous)
        return current["config_schema_version"] == previous["config_schema_version"]
    except RuntimeError:
        return False


def workflow_observation(category, snapshot, timestamp):
    if category not in WORKFLOW_DIAGNOSTICS:
        fail("unsupported_schema")
    summary = WORKFLOW_DIAGNOSTICS[category]
    value = {"schema_version": 1, "observation_id": str(uuid.uuid4()), "category": category,
             "feature_id": None, "snapshot": snapshot,
             "signature": workflow_digest({"category": category, "summary": summary}), "summary": summary,
             "availability": [{"source": "native-incident", "status": "unavailable",
                               "reason": "native-incident-invocation-unavailable"}],
             "gate_outcome": "failed" if category.endswith("failed") else "unavailable",
             "retry_count": None, "first_seen": timestamp, "last_seen": timestamp, "occurrences": 1,
             "export_state": "local", "issue_number": None}
    validate_workflow_observation(value)
    return value


def validate_workflow_observation(value):
    workflow_fields(value, "schema_version observation_id category feature_id snapshot signature summary availability gate_outcome retry_count first_seen last_seen occurrences export_state issue_number")
    if type(value["schema_version"]) is not int or value["schema_version"] != 1:
        fail("unsupported_schema")
    try:
        identifier = uuid.UUID(value["observation_id"])
        if identifier.version != 4 or str(identifier) != value["observation_id"]:
            fail("unsupported_schema")
    except (ValueError, AttributeError, TypeError):
        fail("unsupported_schema")
    category = value["category"]
    # Classified public templates only. Generic redaction cannot certify arbitrary
    # private prose; never persist an input string merely because regexes miss it.
    if (not isinstance(category, str) or category not in WORKFLOW_DIAGNOSTICS
            or value["summary"] != WORKFLOW_DIAGNOSTICS[category]
            or review_unsafe(value["summary"]) or incident_redact(value["summary"]) != value["summary"]):
        fail("unclassified_payload")
    validate_workflow_snapshot(value["snapshot"])
    workflow_hash(value["signature"])
    if value["feature_id"] is not None and value["feature_id"] not in WORKFLOW_FEATURES:
        fail("unsupported_schema")
    if value["gate_outcome"] not in {"passed", "failed", "pending", "not_applicable", "unavailable"}:
        fail("unsupported_schema")
    if value["retry_count"] is not None:
        workflow_integer(value["retry_count"])
    workflow_integer(value["occurrences"], 1)
    if value["issue_number"] is not None:
        workflow_integer(value["issue_number"], 1)
    if value["export_state"] not in {"local", "pending", "published", "blocked"}:
        fail("unsupported_schema")
    if workflow_time(value["first_seen"]) > workflow_time(value["last_seen"]):
        fail("unsupported_schema")
    entries = value["availability"]
    if not isinstance(entries, list) or len(entries) > 16:
        fail("unsupported_schema")
    seen = set()
    for entry in entries:
        workflow_fields(entry, "source status reason")
        for field in ("source", "reason"):
            if entry[field] is not None and (not isinstance(entry[field], str)
                    or not re.fullmatch(r"[a-z][a-z0-9-]{0,63}", entry[field])):
                fail("unsupported_schema")
        if (entry["source"] is None or entry["source"] in seen
                or entry["status"] not in {"available", "partial", "unavailable"}
                or entry["status"] == "unavailable" and entry["reason"] is None):
            fail("unsupported_schema")
        seen.add(entry["source"])
    if len(json.dumps(value, separators=(",", ":"), ensure_ascii=False).encode()) > 16 * 1024:
        fail("record_too_large")


def workflow_dedup(value):
    return workflow_digest([value["category"], value["feature_id"], value["snapshot"]["release_commit"], value["signature"]])


def workflow_queue_update(queue, incoming, timestamp):
    if not isinstance(queue, list) or len(queue) > 256:
        fail("unsupported_schema")
    for value in queue:
        validate_workflow_observation(value)
    validate_workflow_observation(incoming)
    if len(json.dumps(queue, separators=(",", ":"), ensure_ascii=False).encode()) > 4 * 1024 * 1024:
        fail("record_too_large")
    now_time = workflow_time(timestamp)
    cutoff = now_time - timedelta(days=30)
    result = [json.loads(json.dumps(v)) for v in queue if workflow_time(v["last_seen"]) > cutoff]
    status = {"schema_version": 1, "queued": len(result), "coalesced": 0, "dropped": 0,
              "expired": len(queue) - len(result), "storage_status": "available", "error": None}
    if workflow_time(incoming["last_seen"]) > now_time:
        fail("unsupported_schema")
    if workflow_time(incoming["last_seen"]) <= cutoff:
        return result, status
    key = workflow_dedup(incoming)
    for value in result:
        if workflow_dedup(value) == key:
            value["occurrences"] = workflow_integer(value["occurrences"] + incoming["occurrences"], 1)
            value["last_seen"] = max(value["last_seen"], incoming["last_seen"], key=workflow_time)
            # Retain the first failure; later success is not a gate waiver.
            if incoming["gate_outcome"] == "failed":
                value["gate_outcome"] = "failed"
            if incoming["retry_count"] is not None:
                value["retry_count"] = incoming["retry_count"]
            status["coalesced"] = 1
            break
    else:
        if len(result) == 256:
            status.update(dropped=1, error="queue_full")
        else:
            result.append(json.loads(json.dumps(incoming)))
    if len(json.dumps(result, separators=(",", ":"), ensure_ascii=False).encode()) > 4 * 1024 * 1024:
        fail("record_too_large")
    status["queued"] = len(result)
    return result, status


def workflow_queue_path(root):
    directory = cycle_dir(root) / "evidence"
    managed_directory(root, directory, create=True)
    return directory / "workflow-feedback.json"


def workflow_queue_read(path):
    empty = {"schema_version": 1, "observations": [], "publications": {}, "status": {
        "schema_version": 1, "queued": 0, "coalesced": 0, "dropped": 0, "expired": 0,
        "storage_status": "available", "error": None}}
    if not os.path.lexists(path):
        return empty
    continuation_private(path)
    with path.open("rb") as stream:
        raw = stream.read(4 * 1024 * 1024 + 1)
    if len(raw) > 4 * 1024 * 1024:
        fail("record_too_large")
    value = json.loads(raw, object_pairs_hook=no_duplicate_keys)
    return validate_workflow_queue(value)


def validate_workflow_queue(value):
    workflow_fields(value, "schema_version observations publications status")
    if len(json.dumps(value, separators=(",", ":"), ensure_ascii=False).encode()) + 1 > 4 * 1024 * 1024:
        fail("record_too_large")
    if type(value["schema_version"]) is not int or value["schema_version"] != 1:
        fail("unsupported_schema")
    records = value["observations"]
    if not isinstance(records, list) or len(records) > 256:
        fail("unsupported_schema")
    keys = set()
    for record in records:
        validate_workflow_observation(record)
        key = workflow_dedup(record)
        if key in keys:
            fail("unsupported_schema")
        keys.add(key)
    if len(json.dumps(records, separators=(",", ":"), ensure_ascii=False).encode()) > 4 * 1024 * 1024:
        fail("record_too_large")
    status = value["status"]
    workflow_fields(status, "schema_version queued coalesced dropped expired storage_status error")
    if (type(status["schema_version"]) is not int or status["schema_version"] != 1
            or status["storage_status"] != "available" or status["queued"] != len(records)
            or status["error"] not in {None, "queue_full", "record_too_large"}):
        fail("unsupported_schema")
    for name in ("queued", "coalesced", "dropped", "expired"):
        workflow_integer(status[name])
    publications = value["publications"]
    if not isinstance(publications, dict) or len(publications) > 256:
        fail("unsupported_schema")
    for key, binding in publications.items():
        workflow_hash(key)
        workflow_fields(binding, "dedup_key export_state issue_number")
        workflow_hash(binding["dedup_key"])
        if binding["dedup_key"] not in keys or binding["export_state"] not in {"pending", "published", "blocked"}:
            fail("unsupported_schema")
        if binding["issue_number"] is not None:
            workflow_integer(binding["issue_number"], 1)
    return value


def workflow_queue_save(path, value):
    # Revalidate both before writing and before export. A strict directory fsync
    # failure reports unavailable coverage even when the rename already succeeded.
    for record in value["observations"]:
        validate_workflow_observation(record)
    keys = {workflow_dedup(record) for record in value["observations"]}
    value["publications"] = {key: binding for key, binding in value["publications"].items() if binding["dedup_key"] in keys}
    if len(json.dumps(value, separators=(",", ":"), ensure_ascii=False).encode()) + 1 > 4 * 1024 * 1024:
        fail("record_too_large")
    validate_workflow_queue(value)
    private_json(path, value, strict=True)


def workflow_queue_append(root, observation, timestamp):
    try:
        with evidence_lock(root, "workflow-feedback", timeout=1):
            path = workflow_queue_path(root)
            value = workflow_queue_read(path)
            records, status = workflow_queue_update(value["observations"], observation, timestamp)
            for name in ("coalesced", "dropped", "expired"):
                status[name] = workflow_integer(status[name] + value["status"][name])
            value.update(observations=records, status=status)
            workflow_queue_save(path, value)
            return status
    except (RuntimeError, OSError, ValueError, TypeError, KeyError, subprocess.SubprocessError) as error:
        reason = str(error) if str(error) in {"unsupported_schema", "record_too_large", "unclassified_payload"} else (
            "lock_timeout" if isinstance(error, RuntimeError) and str(error) == "cycle evidence is busy" else "storage_unavailable")
        return {"schema_version": 1, "queued": None, "coalesced": None, "dropped": None, "expired": None,
                "storage_status": "unavailable", "error": reason}


def workflow_feedback_policy(value):
    if value is None:
        value = {"schema_version": 1, "external_enabled": False, "destination": None,
                 "consent_digest": None, "payload_scope": "sanitized-diagnostic-v1"}
    workflow_fields(value, "schema_version external_enabled destination consent_digest payload_scope")
    if (type(value["schema_version"]) is not int or value["schema_version"] != 1
            or type(value["external_enabled"]) is not bool or value["payload_scope"] != "sanitized-diagnostic-v1"):
        fail("unsupported_schema")
    destination = value["destination"]
    if destination is not None and (not isinstance(destination, str) or len(destination.encode()) > 256
            or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*", destination)):
        fail("feedback_consent_unavailable")
    if value["consent_digest"] is not None:
        workflow_hash(value["consent_digest"])
    if value["external_enabled"] and (destination is None or value["consent_digest"] is None):
        fail("feedback_consent_unavailable")
    return dict(value)


def workflow_effective_policy(root):
    selected = _preservation_policy_snapshot(root, section=None, validator_timeout=1)
    if selected is None:
        return None
    entry = selected["consent"]
    feedback = workflow_feedback_policy(entry.get("feedback"))
    features = []
    for name, table, field in (("automatic-delivery", "delivery", "enabled"),
                              ("automatic-remove", "preservation", "automatic_remove")):
        enabled = entry.get(table, {}).get(field, False)
        if type(enabled) is not bool:
            fail("unsupported_schema")
        features.append({"feature_id": name, "enabled": enabled})
    features.extend([{"feature_id": "targeted-upload", "enabled": bool(entry.get("preservation", {}).get("uploads", []))},
                     {"feature_id": "external-feedback", "enabled": feedback["external_enabled"]}])
    return {"policy_digest": selected["policy_digest"], "feedback": feedback,
            "release_commit": selected["release_commit"], "settings": {"schema_version": 1, "features": features}}


def workflow_github(account, method, endpoint, fields, timeout):
    """Bounded native transport. Never forward native output/errors into feedback."""
    started = time.monotonic()
    lookup = {k: v for k, v in os.environ.items() if k not in {"GH_TOKEN", "GITHUB_TOKEN"}}
    try:
        credentials = subprocess.run(["gh", "auth", "token", "--hostname", "github.com", "--user", account],
            env=lookup, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=max(0.001, timeout))
    except (OSError, subprocess.SubprocessError):
        return {"status": "blocked"}
    if credentials.returncode or not credentials.stdout.strip() or time.monotonic() - started >= timeout:
        return {"status": "blocked"}
    environment = {**lookup, "GH_TOKEN": credentials.stdout.strip(), "GIT_TERMINAL_PROMPT": "0"}
    argv = ["gh", "api", "--hostname", "github.com", "--method", method, endpoint]
    for key, value in fields.items():
        argv.extend(["-f", f"{key}={value}"])
    try:
        result = subprocess.run(argv, env=environment, stdin=subprocess.DEVNULL, capture_output=True,
                                text=True, timeout=max(0.001, timeout - (time.monotonic() - started)))
    except subprocess.TimeoutExpired:
        return {"status": "ambiguous" if method == "POST" else "transient"}
    if result.returncode:
        # Missing credentials/permissions are never retried; unknown create
        # failures may have committed remotely, so retain pending instead.
        if re.search(r"\b(?:401|403)\b", result.stderr):
            return {"status": "blocked"}
        return {"status": "ambiguous" if method == "POST" else "transient"}
    if len(result.stdout.encode()) > 256 * 1024:
        return {"status": "ambiguous" if method == "POST" else "blocked"}
    try:
        return {"status": "success", "value": json.loads(result.stdout, object_pairs_hook=no_duplicate_keys)}
    except ValueError:
        return {"status": "ambiguous" if method == "POST" else "blocked"}


def workflow_flush(root, policy_reader, account, *, request=workflow_github, clock=time.monotonic, sleep=time.sleep,
                   wall_clock=lambda: datetime.now(timezone.utc)):
    """Internal opted-in cycle step; no CLI/import bypass or Incident authority."""
    deadline = clock() + 30
    policy = policy_reader(root)
    if policy is None or not workflow_feedback_policy(policy["feedback"])["external_enabled"]:
        return {"status": "local", "attempts": 0}
    approved = workflow_digest(policy)
    destination = policy["feedback"]["destination"]
    attempts = 0
    dispatched = False
    def call(method, endpoint, fields):
        nonlocal attempts, dispatched
        dispatched = False
        if attempts >= 3 or clock() >= deadline:
            return {"status": "pending"}
        if attempts:
            delay = 2**(attempts - 1)
            if clock() + delay >= deadline:
                return {"status": "pending"}
            sleep(delay)
        if workflow_digest(policy_reader(root)) != approved:
            return {"status": "blocked"}
        if clock() >= deadline:
            return {"status": "pending"}
        attempts += 1
        dispatched = True
        return request(account, method, endpoint, fields, max(0.001, deadline - clock()))
    try:
        with evidence_lock(root, "workflow-feedback", timeout=1):
            path = workflow_queue_path(root)
            value = workflow_queue_read(path)
            cutoff = wall_clock() - timedelta(days=30)
            retained = [r for r in value["observations"] if workflow_time(r["last_seen"]) > cutoff]
            value["status"]["expired"] = workflow_integer(value["status"]["expired"] + len(value["observations"]) - len(retained))
            value["observations"] = retained
            value["status"]["queued"] = len(retained)
            workflow_queue_save(path, value)
            # Prioritize never-published work. A bounded flush cannot repeatedly
            # update the same published row and starve the rest of the queue.
            value["observations"].sort(key=lambda r: r["export_state"] == "published")
            selected_keys = {workflow_digest([workflow_dedup(record), destination]) for record in value["observations"]}
            unresolved = False
            for record in list(value["observations"]):
                validate_workflow_observation(record)  # Export reclassification.
                marker = "dbsctr-feedback-" + workflow_digest([workflow_dedup(record), destination])
                publication_key = marker.removeprefix("dbsctr-feedback-")
                binding = value["publications"].get(publication_key)
                # Always rediscover by destination+key. No stale issue number may
                # route an update into a newly selected destination.
                query = {"q": f'repo:{destination} is:issue in:body "{marker}"', "per_page": "2"}
                while True:
                    found = call("GET", "search/issues", query)
                    if found["status"] != "transient" or attempts >= 3:
                        break
                if found["status"] != "success":
                    if found["status"] == "blocked":
                        record["export_state"] = "blocked"
                        workflow_queue_save(path, value)
                    return {"status": "blocked" if found["status"] == "blocked" else "pending", "attempts": attempts}
                listing = found["value"]
                if (not isinstance(listing, dict) or listing.get("incomplete_results") is not False
                        or type(listing.get("total_count")) is not int or listing["total_count"] not in (0, 1)
                        or not isinstance(listing.get("items"), list) or len(listing["items"]) != listing["total_count"]):
                    return {"status": "blocked", "attempts": attempts}
                body = (record["summary"] + "\n\nOccurrences: " + str(record["occurrences"]) +
                        "\nOutcome: " + record["gate_outcome"] + "\n\n<!-- " + marker + " -->")
                if binding is None and len(value["publications"]) >= 256:
                    return {"status": "blocked", "attempts": attempts}
                if listing["total_count"]:
                    issue = listing["items"][0]
                    number = workflow_integer(issue.get("number"), 1)
                    if (not isinstance(issue.get("body"), str) or marker not in issue["body"]
                            or issue.get("repository_url") != "https://api.github.com/repos/" + destination
                            or "pull_request" in issue):
                        return {"status": "blocked", "attempts": attempts}
                    outcome = call("PATCH", f"repos/{destination}/issues/{number}", {"body": body})
                else:
                    if binding is not None:
                        # Search absence after a possible create is not proof of
                        # nonexistence (index lag). Never issue a duplicate create.
                        value["observations"].remove(record)
                        value["observations"].append(record)
                        workflow_queue_save(path, value)
                        unresolved = True
                        continue
                    if attempts >= 3 or clock() >= deadline:
                        return {"status": "pending", "attempts": attempts}
                    # ponytail: at most 256 destination bindings inside the same
                    # bounded queue; explicit retention review before expansion.
                    if len(value["publications"]) >= 256:
                        return {"status": "blocked", "attempts": attempts}
                    previous = record["export_state"], record["issue_number"]
                    binding = {"dedup_key": workflow_dedup(record), "export_state": "pending", "issue_number": None}
                    value["publications"][publication_key] = binding
                    record["export_state"] = "pending"
                    workflow_queue_save(path, value)  # Persist intent BEFORE create.
                    outcome = call("POST", f"repos/{destination}/issues", {"title": "Workflow diagnostic: " + record["category"], "body": body})
                    if not dispatched:
                        record["export_state"], record["issue_number"] = previous
                        del value["publications"][publication_key]
                        workflow_queue_save(path, value)
                        return {"status": outcome["status"], "attempts": attempts}
                if outcome["status"] != "success":
                    record["export_state"] = "blocked" if outcome["status"] == "blocked" else "pending"
                    if binding is not None:
                        binding["export_state"] = record["export_state"]
                    workflow_queue_save(path, value)
                    return {"status": record["export_state"], "attempts": attempts}
                number = workflow_integer(outcome["value"].get("number"), 1)
                record.update(export_state="published", issue_number=number)
                value["publications"][publication_key] = {"dedup_key": workflow_dedup(record),
                    "export_state": "published", "issue_number": number}
                value["observations"].remove(record)
                value["observations"].append(record)
                workflow_queue_save(path, value)
                if clock() >= deadline or attempts >= 3:
                    break
            return {"status": "pending" if unresolved or any(value["publications"].get(key, {}).get("export_state") == "pending"
                    for key in selected_keys) else "bounded",
                    "attempts": attempts}
    except (RuntimeError, OSError, ValueError, TypeError, KeyError, subprocess.SubprocessError):
        return {"status": "unavailable", "attempts": attempts}


WORKFLOW_OPERATIONS = {
    "begin": "registration", "start": "registration", "record-evidence": "evidence-recording",
    "gate-commit": "gate-commit", "reconcile-target": "target-reconciliation", "final-push": "final-push",
    "record-dvc-push": "preservation", "workspace-remove-check": "removal-check",
}


def validate_workflow_operation(event):
    workflow_fields(event, "schema_version event_id operation snapshot cycle_id started_at finished_at outcome availability")
    if (type(event["schema_version"]) is not int or event["schema_version"] != 1
            or event["operation"] not in WORKFLOW_OPERATIONS.values()):
        fail("unsupported_schema")
    try:
        identifier = uuid.UUID(event["event_id"])
        if identifier.version != 4 or str(identifier) != event["event_id"]:
            fail("unsupported_schema")
    except (ValueError, TypeError, AttributeError):
        fail("unsupported_schema")
    validate_workflow_snapshot(event["snapshot"])
    if event["cycle_id"] is not None and (not isinstance(event["cycle_id"], str) or not OPAQUE_ID.fullmatch(event["cycle_id"])):
        fail("unsupported_schema")
    workflow_integer(event["started_at"], REVIEW_START_MS)
    if event["finished_at"] is not None:
        workflow_integer(event["finished_at"], event["started_at"])
    if ((event["finished_at"] is None) != (event["outcome"] is None)
            or event["outcome"] not in {None, "passed", "failed"}
            or event["availability"] != {"source": "native-attribution", "status": "unavailable",
                                         "reason": "native-identity-unavailable"}):
        fail("unsupported_schema")


def workflow_operation_coverage(connection, cycle_id):
    row = connection.execute("SELECT value FROM ledger_meta WHERE key='workflow_operation_schema'").fetchone()
    if row is None:
        return None
    if row != ("1",):
        fail("unsupported_schema")
    coverage = {"schema_version": 1, "scope": "helper-operation-intervals", "captured": 0,
                "complete": 0, "partial": 0, "failed": 0, "excluded_unassociated": 0,
                "unavailable": None, "dropped": None, "retry_count": None, "remediation_count": None,
                "coverage_status": "partial", "usage": "unavailable", "cost": "unavailable"}
    for (payload,) in connection.execute("SELECT payload FROM workflow_operations"):
        event = json.loads(payload, object_pairs_hook=no_duplicate_keys)
        validate_workflow_operation(event)
        if event["cycle_id"] is None:
            coverage["excluded_unassociated"] += 1
        elif event["cycle_id"] == cycle_id:
            coverage["captured"] += 1
            coverage["complete" if event["finished_at"] is not None else "partial"] += 1
            coverage["failed"] += int(event["outcome"] == "failed")
    return coverage


@contextlib.contextmanager
def workflow_phase_owner():
    root = review_root()
    require_review_lock_safe(root)
    with review_lock(root) as lock:
        deadline = time.monotonic() + 1
        while True:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    fail("lock_timeout")
                time.sleep(0.01)
        connection = ensure_ledger_for_write(root)
        try:
            connection.execute("PRAGMA busy_timeout=0")
            ensure_phase_schema(connection)
            row = connection.execute("SELECT value FROM ledger_meta WHERE key='workflow_operation_schema'").fetchone()
            if row is not None and row != ("1",):
                fail("unsupported_schema")
            if row is None:
                connection.execute("CREATE TABLE workflow_operations (event_id TEXT PRIMARY KEY, payload TEXT NOT NULL)")
                connection.execute("INSERT INTO ledger_meta VALUES ('workflow_operation_schema', '1')")
                connection.commit()
            yield connection
            connection.commit()
        except BaseException:
            connection.rollback()
            raise
        finally:
            connection.close()


def workflow_cycle(root, cycle_id=None):
    try:
        if cycle_id is not None:
            if not isinstance(cycle_id, str) or not OPAQUE_ID.fullmatch(cycle_id):
                return None
            path = cycle_dir(root) / "cycles" / (cycle_id + ".json")
            record = read_cycle_record(root, path)
            if record["cycle_id"] != cycle_id or not record_worktree_matches(root, record, root):
                return None
            return record
        _, record = load(root)
        return record
    except (RuntimeError, OSError, ValueError, KeyError):
        return None


def workflow_operation_start(args):
    if args.command not in WORKFLOW_OPERATIONS:
        return None
    if args.command == "begin" and getattr(args, "preflight", False):
        return None
    try:
        root = root_dir()
        policy = workflow_effective_policy(root)
        if policy is None:
            print("workflow_capture_unavailable", file=sys.stderr)
            return None  # No coherent activation selected; no optional writes.
        snapshot = workflow_feature_snapshot(policy["release_commit"], policy["settings"])
        record = None if args.command in {"begin", "start"} else workflow_cycle(root)
        event = {"schema_version": 1, "event_id": str(uuid.uuid4()), "operation": WORKFLOW_OPERATIONS[args.command],
                 "snapshot": snapshot, "cycle_id": record["cycle_id"] if record else None,
                 "started_at": max(REVIEW_START_MS, int(time.time() * 1000)), "finished_at": None,
                 "outcome": None, "availability": {"source": "native-attribution", "status": "unavailable",
                                                    "reason": "native-identity-unavailable"}}
        with workflow_phase_owner() as connection:
            connection.execute("INSERT INTO workflow_operations VALUES (?, ?)",
                               (event["event_id"], ledger_payload(event)))
            if event["cycle_id"] is not None:
                span = (event["cycle_id"], event["event_id"], None, "operation", "task", "unavailable",
                        "[]", "[]", event["started_at"], None, None)
                phase_record(span)
                connection.execute("INSERT INTO phase_spans VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)", span)
        return root, event, policy, getattr(args, "gate", None), getattr(args, "cycle_id", None)
    except (RuntimeError, OSError, ValueError, TypeError, KeyError, sqlite3.Error, subprocess.SubprocessError):
        print("workflow_capture_unavailable", file=sys.stderr)
        return None


def workflow_operation_finish(capture, succeeded):
    if capture is None:
        return
    root, event, policy, gate, requested_cycle = capture
    try:
        record = workflow_cycle(root, event["cycle_id"] or (requested_cycle if succeeded else None))
        if event["operation"] == "evidence-recording" and record and gate in record.get("gates", {}):
            succeeded = succeeded and record["gates"][gate]["result"] == "passed"
        event["finished_at"] = max(event["started_at"], int(time.time() * 1000))
        event["outcome"] = "passed" if succeeded else "failed"
        if event["cycle_id"] is None and succeeded and record and event["operation"] == "registration":
            event["cycle_id"] = record["cycle_id"]
        with workflow_phase_owner() as connection:
            stored = connection.execute("SELECT payload FROM workflow_operations WHERE event_id=?",
                                        (event["event_id"],)).fetchone()
            if stored is None:
                fail("workflow_start_unavailable")
            original = json.loads(stored[0], object_pairs_hook=no_duplicate_keys)
            if original["finished_at"] is not None:
                fail("workflow_finish_already_recorded")
            connection.execute("UPDATE workflow_operations SET payload=? WHERE event_id=?",
                               (ledger_payload(event), event["event_id"]))
            if event["cycle_id"] is not None:
                span = (event["cycle_id"], event["event_id"], None, "operation", "task", "unavailable",
                        "[]", "[]", event["started_at"], event["finished_at"], event["outcome"])
                phase_record(span)
                if original["cycle_id"] is None:
                    connection.execute("INSERT INTO phase_spans VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)", span)
                else:
                    connection.execute("UPDATE phase_spans SET finished_at=?, result=? WHERE cycle_id=? AND span_id=?",
                        (event["finished_at"], event["outcome"], event["cycle_id"], event["event_id"]))
        category = "operation-complete" if succeeded else (
            "validation-failed" if event["operation"] == "evidence-recording" else "operation-failed")
        stamp = now().replace("+00:00", "Z")
        status = workflow_queue_append(root, workflow_observation(category, event["snapshot"], stamp), stamp)
        if status["storage_status"] != "available":
            print("workflow_feedback_coverage_unavailable", file=sys.stderr)
        # Only the ordinary opted-in cycle completion step may export. Source
        # checks and scans never secretly publish or act as explicit flush routes.
        if (succeeded and event["operation"] == "final-push" and record
                and policy["feedback"]["external_enabled"]):
            account = record.get("delivery", {}).get("github", {}).get("account")
            if account:
                result = workflow_flush(root, workflow_effective_policy, account)
                print("workflow_feedback_flush_" + result["status"], file=sys.stderr)
    except (RuntimeError, OSError, ValueError, TypeError, KeyError, sqlite3.Error, subprocess.SubprocessError):
        print("workflow_capture_unavailable", file=sys.stderr)


def command_phase_span(args):
    record_path, record = load(root_dir())
    require_active(record)
    cycle_id = record["cycle_id"]
    if args.event == "start":
        if args.phase is None or args.operation is None or args.attribution is None or args.result is not None:
            fail("phase span start requires phase, operation, and attribution only")
        dependencies = sorted(set(args.dependency or []))
        ownership = sorted(set(phase_path(item) for item in (args.path or [])))
    else:
        if args.result is None or any(value is not None for value in (
                args.parent_span_id, args.phase, args.operation, args.attribution)) or args.dependency or args.path:
            fail("phase span finish requires only span ID and result")
    root = review_root(args.state_root)
    if not OPAQUE_ID.fullmatch(args.span_id):
        fail("invalid phase span ID")
    timestamp = max(REVIEW_START_MS, int(time.time() * 1000))
    require_review_lock_safe(root)
    with review_lock(root) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        connection = ensure_ledger_for_write(root)
        ensure_phase_schema(connection)
        try:
            connection.execute("BEGIN IMMEDIATE")
            if args.event == "start":
                row = (cycle_id, args.span_id, args.parent_span_id, args.phase, args.operation,
                       args.attribution, ledger_payload(dependencies), ledger_payload(ownership),
                       timestamp, None, None)
                phase_record(row)
                if args.parent_span_id is not None and connection.execute(
                        "SELECT 1 FROM phase_spans WHERE cycle_id=? AND span_id=?",
                        (cycle_id, args.parent_span_id)).fetchone() is None:
                    fail("phase span parent is missing")
                for dependency in dependencies:
                    dependency_row = connection.execute(
                        "SELECT finished_at FROM phase_spans WHERE cycle_id=? AND span_id=?",
                        (cycle_id, dependency),
                    ).fetchone()
                    if dependency_row is None or dependency_row[0] is None:
                        fail("phase span dependency is incomplete")
                    if timestamp < dependency_row[0]:
                        fail("phase span dependency timing is invalid")
                existing = connection.execute(
                    "SELECT cycle_id, span_id, parent_span_id, phase, operation, attribution, dependencies, "
                    "ownership_paths, started_at, finished_at, result FROM phase_spans "
                    "WHERE cycle_id=? AND span_id=?", (cycle_id, args.span_id),
                ).fetchone()
                if existing is None:
                    connection.execute("INSERT INTO phase_spans VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)", row)
                else:
                    existing = phase_record(existing)
                    expected = phase_record(row)
                    comparable = ("cycle_id", "span_id", "parent_span_id", "phase", "operation",
                                  "attribution", "dependencies", "ownership_paths", "finished_at", "result")
                    if any(existing[name] != expected[name] for name in comparable):
                        fail("phase span ID conflicts with existing marker")
            else:
                row = connection.execute(
                    "SELECT started_at, finished_at, result FROM phase_spans WHERE cycle_id=? AND span_id=?",
                    (cycle_id, args.span_id),
                ).fetchone()
                if row is None:
                    fail("phase span start is missing")
                if row[1] is not None:
                    if row[2] != args.result:
                        fail("phase span result conflicts with existing marker")
                else:
                    connection.execute(
                        "UPDATE phase_spans SET finished_at=max(started_at, ?), result=? "
                        "WHERE cycle_id=? AND span_id=?",
                        (timestamp, args.result, cycle_id, args.span_id),
                    )
            report = phase_report(phase_rows(connection, cycle_id), cycle_id)
            connection.commit()
            record["phase_profile"] = report
            save(record_path, record)
        except Exception:
            connection.rollback()
            raise
        finally:
            connection.close()
    print(json.dumps(report, sort_keys=True, separators=(",", ":")))


def command_phase_report(args):
    _, record = load(root_dir())
    root = review_root(args.state_root)
    require_review_lock_safe(root)
    with existing_review_lock(root):
        report = load_phase_report(root, record["cycle_id"])
        if ledger_exists(root):
            with ledger_connection(root) as connection:
                coverage = workflow_operation_coverage(connection, record["cycle_id"])
            if coverage is not None:
                report = {"schema_version": 2, "phase_profile": report, "workflow_operations": coverage}
    print(json.dumps(report, sort_keys=True, separators=(",", ":")))


def command_cycle_performance(args):
    filters = {name: value for name, value in (
        ("context", args.context), ("risk", args.risk),
        ("delivery_intent", args.delivery_intent), ("method_revision", args.method_revision),
    ) if value is not None}
    if args.context is not None and not OPAQUE_ID.fullmatch(args.context):
        fail("invalid context")
    if args.method_revision is not None and not OPAQUE_ID.fullmatch(args.method_revision):
        fail("invalid method revision")
    records = completed_cycle_records(root_dir())
    root = review_root(args.state_root)
    spans = {}
    require_review_lock_safe(root)
    if ledger_exists(root):
        with existing_review_lock(root):
            with ledger_connection(root) as connection:
                if connection.execute(
                        "SELECT value FROM ledger_meta WHERE key='phase_schema'").fetchone() is not None:
                    for record in records:
                        spans[record["cycle_id"]] = phase_rows(connection, record["cycle_id"])
    print(json.dumps(cycle_performance(records, spans, filters),
                     sort_keys=True, separators=(",", ":")))


def execution_dag(value, requested_mode, risk, activated=False):
    if (not isinstance(value, dict) or set(value) != {"nodes", "completed"}
            or not isinstance(value["nodes"], list) or not isinstance(value["completed"], list)
            or not 1 <= len(value["nodes"]) <= 100):
        fail("execution DAG has an invalid schema")
    nodes = {}
    fields = {"id", "depends_on", "operation", "ownership_paths"}
    for item in value["nodes"]:
        if (not isinstance(item, dict) or set(item) != fields
                or not isinstance(item.get("id"), str) or not OPAQUE_ID.fullmatch(item["id"])
                or item["id"] in nodes or item.get("operation") not in ("read", "readonly_qa", "reconcile")
                or not isinstance(item.get("depends_on"), list)
                or len(item["depends_on"]) > 100 or len(set(item["depends_on"])) != len(item["depends_on"])
                or any(not isinstance(dependency, str) or not OPAQUE_ID.fullmatch(dependency)
                       or dependency == item["id"] for dependency in item["depends_on"])
                or not isinstance(item.get("ownership_paths"), list)
                or not 0 <= len(item["ownership_paths"]) <= 100):
            fail("execution DAG node has an invalid operation or schema")
        nodes[item["id"]] = {**item, "depends_on": sorted(item["depends_on"]),
                             "ownership_paths": sorted(set(phase_path(path)
                                                            for path in item["ownership_paths"]))}
        if ((item["operation"] == "reconcile") != (not item["ownership_paths"])):
            fail("execution DAG reconciliation ownership is invalid")
    completed = value["completed"]
    if (len(completed) != len(set(completed)) or any(
            not isinstance(item, str) or not OPAQUE_ID.fullmatch(item) or item not in nodes
            for item in completed)):
        fail("execution DAG completed nodes are invalid")
    for item in nodes.values():
        unknown = set(item["depends_on"]) - set(nodes)
        if unknown:
            fail("execution DAG contains an unknown dependency")
    indegree = {key: len(item["depends_on"]) for key, item in nodes.items()}
    children = {key: [] for key in nodes}
    for key, item in nodes.items():
        for dependency in item["depends_on"]:
            children[dependency].append(key)
    ready = sorted(key for key, degree in indegree.items() if degree == 0)
    order = []
    while ready:
        key = ready.pop(0)
        order.append(key)
        for child in sorted(children[key]):
            indegree[child] -= 1
            if indegree[child] == 0:
                ready.append(child)
                ready.sort()
    if len(order) != len(nodes):
        fail("execution DAG contains a cycle")

    ancestors = {}
    for key in order:
        ancestors[key] = set(nodes[key]["depends_on"])
        for dependency in nodes[key]["depends_on"]:
            ancestors[key].update(ancestors[dependency])
    reconciliation = [key for key, item in nodes.items() if item["operation"] == "reconcile"]
    if len(reconciliation) != 1:
        fail("execution DAG requires one reconciliation node")
    reconciliation_id = reconciliation[0]
    workers = set(nodes) - {reconciliation_id}
    if not workers <= ancestors[reconciliation_id]:
        fail("execution DAG reconciliation must depend on every worker")
    completed_set = set(completed)
    if any(not ancestors[key] <= completed_set for key in completed_set):
        fail("execution DAG completed nodes lack completed dependencies")
    if reconciliation_id in completed_set and not workers <= completed_set:
        fail("execution DAG reconciliation completed before its workers")
    overlapping = set()
    keys = sorted(nodes)
    for position, left in enumerate(keys):
        for right in keys[position + 1:]:
            if reconciliation_id in (left, right):
                continue
            if left in ancestors[right] or right in ancestors[left]:
                continue
            left_paths = [PurePosixPath(path).parts for path in nodes[left]["ownership_paths"]]
            right_paths = [PurePosixPath(path).parts for path in nodes[right]["ownership_paths"]]
            if any(a[:len(b)] == b or b[:len(a)] == a for a in left_paths for b in right_paths):
                overlapping.update((left, right))
    reasons = []
    forced = set()
    if requested_mode == "serial":
        reasons.append("requested_serial")
        forced.update(workers)
    elif risk == "critical":
        reasons.append("critical_risk")
        forced.update(workers)
    elif overlapping:
        reasons.append("ownership_overlap")
        forced.update(overlapping)
    elif requested_mode == "benchmark":
        reasons.append("benchmark_only")
    elif not activated:
        reasons.append("benchmark_not_qualified")
        forced.update(workers)
    mode = "serial" if forced else "concurrent"
    ready_now = sorted(key for key, item in nodes.items()
                       if key not in completed and set(item["depends_on"]) <= set(completed))
    return {"schema_version": 1, "requested_mode": requested_mode, "mode": mode,
            "order": order, "ready": ready_now, "forced_serial": sorted(forced),
            "reconciliation_id": reconciliation_id, "reasons": reasons}


def command_execution_dag(args):
    _, record = load(root_dir())
    require_active(record)
    try:
        value = json.loads(args.dag_json, object_pairs_hook=no_duplicate_keys)
    except json.JSONDecodeError as error:
        fail(f"cannot read execution DAG: {error}")
    activated = load_execution_activation(review_root(args.state_root))
    print(json.dumps(execution_dag(value, args.mode, record["risk"], activated),
                     sort_keys=True, separators=(",", ":")))


def command_execution_benchmark(args):
    repository = root_dir()
    _, record = load(repository)
    require_active(record)
    fixture = {"id": args.fixture_id, "commit": args.fixture_commit,
               "path": args.fixture_path, "blob": args.fixture_blob}
    if (not OPAQUE_ID.fullmatch(fixture["id"])
            or not re.fullmatch(r"[0-9a-f]{40}(?:[0-9a-f]{24})?", fixture["commit"])
            or not fixture["path"].startswith("tests/fixtures/")
            or phase_path(fixture["path"]) != fixture["path"]
            or not re.fullmatch(r"[0-9a-f]{40}(?:[0-9a-f]{24})?", fixture["blob"])
            or git_read(repository, "merge-base", "--is-ancestor", fixture["commit"], "HEAD", check=False).returncode
            or git_read(repository, "rev-parse", f"{fixture['commit']}:{fixture['path']}", check=False).stdout.strip()
            != fixture["blob"]):
        fail("execution benchmark fixture identity is invalid")
    fixture_text = git_read(repository, "show", f"{fixture['commit']}:{fixture['path']}").stdout
    if len(fixture_text.encode()) > 64 * 1024:
        fail("execution benchmark fixture is too large")
    fixture_value = json.loads(fixture_text, object_pairs_hook=no_duplicate_keys)
    fixture_fields = {"schema_version", "fixture_id", "warmup_pairs", "measured_pairs",
                      "synthetic_delay_ms", "required_gates", "dag"}
    if (not isinstance(fixture_value, dict) or set(fixture_value) != fixture_fields
            or fixture_value.get("schema_version") != 1 or fixture_value.get("fixture_id") != fixture["id"]
            or fixture_value.get("warmup_pairs") != 1 or fixture_value.get("measured_pairs") != 5
            or type(fixture_value.get("synthetic_delay_ms")) is not int
            or not 1 <= fixture_value["synthetic_delay_ms"] <= 1000
            or not isinstance(fixture_value.get("required_gates"), list)
            or fixture_value["required_gates"] != sorted(set(fixture_value["required_gates"]))
            or any(gate not in GATES for gate in fixture_value["required_gates"])
            or not MANDATORY_GATES <= set(fixture_value["required_gates"])):
        fail("execution benchmark fixture contract is invalid")
    authorization = execution_dag(fixture_value["dag"], "benchmark", record["risk"], False)
    if authorization["mode"] != "concurrent" or authorization["reasons"] != ["benchmark_only"]:
        fail("execution benchmark fixture is not concurrency-safe")
    workers = [node for node in fixture_value["dag"]["nodes"] if node["operation"] != "reconcile"]
    if not 2 <= len(workers) <= 16 or any(len(node["ownership_paths"]) != 1 for node in workers):
        fail("execution benchmark fixture worker count is invalid")
    delay = fixture_value["synthetic_delay_ms"] / 1000
    worker_by_id = {node["id"]: node for node in workers}
    def task(node):
        path = node["ownership_paths"][0]
        result = subprocess.run(
            ["git", "show", f"{fixture['commit']}:{path}"], cwd=repository,
            stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, env=INSPECT_ENV,
        )
        if result.returncode:
            fail("execution benchmark fixture read failed")
        time.sleep(delay)
    def serial_run():
        for node_id in authorization["order"]:
            if node_id in worker_by_id:
                task(worker_by_id[node_id])
    def concurrent_run():
        completed, pending = set(), set(worker_by_id)
        while pending:
            ready = sorted(node_id for node_id in pending
                           if set(worker_by_id[node_id]["depends_on"]) <= completed)
            if not ready:
                fail("execution benchmark fixture has no ready worker")
            with concurrent.futures.ThreadPoolExecutor(max_workers=len(ready)) as pool:
                list(pool.map(task, (worker_by_id[node_id] for node_id in ready)))
            completed.update(ready)
            pending.difference_update(ready)
    serial_run()
    concurrent_run()
    gate_digest = hashlib.sha256(ledger_payload(fixture_value["required_gates"]).encode()).hexdigest()
    pairs = []
    for index in range(fixture_value["measured_pairs"]):
        started = time.monotonic()
        serial_run()
        serial_ms = max(1, round((time.monotonic() - started) * 1000))
        started = time.monotonic()
        concurrent_run()
        concurrent_ms = max(1, round((time.monotonic() - started) * 1000))
        pairs.append({"pair_id": f"pair-{index + 1}", "serial_ms": serial_ms,
                      "concurrent_ms": concurrent_ms, "serial_status": "passed",
                      "concurrent_status": "passed", "serial_gate_digest": gate_digest,
                      "concurrent_gate_digest": gate_digest, "serial_remediation_rounds": 0,
                      "concurrent_remediation_rounds": 0})
    serial_median = median(pair["serial_ms"] for pair in pairs)
    concurrent_median = median(pair["concurrent_ms"] for pair in pairs)
    improvement = round((serial_median - concurrent_median) * 100 / serial_median, 2)
    report = validate_execution_benchmark({
        "schema_version": 1, "method_revision": CURRENT_METHOD_REVISION,
        "fixture": fixture, "warmup_pairs": fixture_value["warmup_pairs"], "pairs": pairs,
        "sample_count": len(pairs), "required_gate_digest": gate_digest,
        "serial_median_ms": serial_median,
        "concurrent_median_ms": concurrent_median, "improvement_percent": improvement,
        "activated": concurrent_median <= serial_median * .9
        and all(pair["concurrent_remediation_rounds"] <= pair["serial_remediation_rounds"] for pair in pairs),
        "recorded_at": max(REVIEW_START_MS, int(time.time() * 1000)),
    })
    root = review_root(args.state_root)
    require_review_lock_safe(root)
    with review_lock(root) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        connection = ensure_ledger_for_write(root)
        ensure_phase_schema(connection)
        try:
            connection.execute("BEGIN IMMEDIATE")
            connection.execute("INSERT OR REPLACE INTO execution_activation VALUES (?, ?)",
                               (CURRENT_METHOD_REVISION, ledger_payload(report)))
            connection.commit()
        except Exception:
            connection.rollback()
            raise
        finally:
            connection.close()
    print(json.dumps(report, sort_keys=True, separators=(",", ":")))


def command_review_migrate(args):
    root = review_root(args.state_root)
    require_review_lock_safe(root)
    with review_lock(root) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if ledger_exists(root):
            with ledger_connection(root, write=True) as connection:
                recover_forget_state(root, connection)
                ledger_integrity(connection)
                migration = connection.execute(
                    "SELECT value FROM ledger_meta WHERE key='migration_digest'").fetchone()
                digest = migration[0] if migration else content_digest(ledger_content(connection))
            print(json.dumps({"migrated": False, "digest": digest}, sort_keys=True))
            return
        legacy_json_files(root)
        index = review_index(root)
        reports = [(path.stem, report) for path, report, _ in review_reports(root)]
        evidence = sorted(history_evidence(root), key=lambda item: item["session_id"])
        saved_reports = sorted(((item["report_id"], item) for item in history_reports(root)))
        cohorts = sorted(((item["report_id"], item) for item in history_cohorts(root)))
        source = {"index": index, "review_reports": reports, "history_evidence": evidence,
                  "history_reports": saved_reports, "history_cohorts": cohorts}
        source_digest = content_digest(source)
        backup_name, backup_digest = backup_legacy_json(root)
        directory = root / "reviews"
        descriptor, temporary = tempfile.mkstemp(prefix=".ledger-migrate-", suffix=".sqlite3", dir=directory)
        os.close(descriptor)
        temporary = Path(temporary)
        try:
            os.chmod(temporary, 0o600)
            connection = sqlite3.connect(temporary)
            connection.execute("PRAGMA foreign_keys=ON")
            connection.execute("PRAGMA synchronous=FULL")
            ledger_schema(connection)
            connection.commit()
            connection.execute("BEGIN IMMEDIATE")
            names = {"sessions": "session", "cycles": "cycle", "forgotten_sessions": "forgotten_session"}
            for field, kind in names.items():
                connection.executemany("INSERT INTO review_tombstones VALUES (?, ?, ?)",
                                       ((kind, key, value) for key, value in index[field].items()))
            for report_id, report in reports:
                ledger_put_review_report(connection, report_id, report)
            for item in evidence:
                ledger_put_history_evidence(connection, item)
            for _, item in saved_reports:
                ledger_put_history_report(connection, "report", item)
            for _, item in cohorts:
                ledger_put_history_report(connection, "cohort", item)
            connection.execute("INSERT INTO ledger_meta VALUES ('migration_digest', ?)", (source_digest,))
            connection.commit()
            ledger_integrity(connection)
            if content_digest(ledger_content(connection)) != source_digest:
                fail("private review ledger migration content mismatch")
            connection.close()
            os.replace(temporary, ledger_path(root))
            os.chmod(ledger_path(root), 0o600)
            history_source_index_path(root).unlink(missing_ok=True)
            fsync_directory(directory)
        except Exception:
            if "connection" in locals():
                connection.close()
            raise
        finally:
            temporary.unlink(missing_ok=True)
    print(json.dumps({"migrated": True, "digest": source_digest, "backup": backup_name,
                      "backup_digest": backup_digest}, sort_keys=True))


def command_review_backup(args):
    root = review_root(args.state_root)
    require_review_lock_safe(root)
    with review_lock(root) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        connection = ledger_connection(root, write=True)
        recover_forget_state(root, connection)
        connection.close()
        name, digest = create_ledger_backup(root)
    print(json.dumps({"backup": name, "digest": digest}, sort_keys=True))


def command_review_restore(args):
    root = review_root(args.state_root)
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}\.sqlite3", args.backup):
        fail("invalid private review backup name")
    source_path = root / "reviews" / "backups" / args.backup
    require_review_lock_safe(root)
    with review_lock(root) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        connection = ledger_connection(root, write=True)
        recover_forget_state(root, connection)
        privacy_rows = knowledge_privacy_rows(connection)
        privacy_sequence = int(connection.execute(
            "SELECT value FROM ledger_meta WHERE key='knowledge_privacy_sequence'").fetchone()[0])
        connection.close()
        if source_path.is_symlink() or not source_path.is_file():
            fail("private review backup is missing or unsafe")
        if source_path.stat().st_mode & 0o077:
            fail("private review backup permissions are too broad")
        with ledger_connection(root, path=source_path) as source:
            ledger_integrity(source)
        rollback, _ = create_ledger_backup(root, prefix="rollback")
        directory = root / "reviews"
        descriptor, temporary = tempfile.mkstemp(prefix=".ledger-restore-", suffix=".sqlite3", dir=directory)
        os.close(descriptor)
        temporary = Path(temporary)
        try:
            os.chmod(temporary, 0o600)
            source = ledger_connection(root, path=source_path)
            destination = sqlite3.connect(temporary)
            source.backup(destination)
            destination.commit()
            source.close()
            destination.close()
            restored = ledger_connection(root, write=True, path=temporary)
            try:
                restored.execute("BEGIN IMMEDIATE")
                restored_sequence = int(restored.execute(
                    "SELECT value FROM ledger_meta WHERE key='knowledge_privacy_sequence'").fetchone()[0])
                restored.executemany(
                    "INSERT INTO knowledge_privacy_tombstones VALUES (?, ?, ?, ?) "
                    "ON CONFLICT(family,item_id) DO UPDATE SET reason=excluded.reason, "
                    "timestamp=max(timestamp,excluded.timestamp)", privacy_rows)
                tombstones = knowledge_privacy_rows(restored)
                unknown = {row[0] for row in tombstones} - {
                    "telemetry", "review", "history_report", "history_capture", "benchmark",
                    "provider_evaluation", "incident", "incident_signal"}
                if unknown:
                    fail("private review restore contains unsupported privacy tombstones")
                for family, session_id, _, timestamp in tombstones:
                    if family != "telemetry":
                        continue
                    dependent = [row[0] for row in restored.execute(
                        "SELECT report_id FROM history_report_members WHERE session_id=?", (session_id,))]
                    restored.execute("DELETE FROM history_evidence WHERE session_id=?", (session_id,))
                    for report_id in dependent:
                        restored.execute("DELETE FROM ledger_entries WHERE scope='history' AND report_id=?", (report_id,))
                        restored.execute("DELETE FROM history_reports WHERE report_id=?", (report_id,))
                    if restored.execute(
                            "SELECT 1 FROM sqlite_master WHERE type='table' AND name='history_capture_members'").fetchone():
                        captures = [row[0] for row in restored.execute(
                            "SELECT capture_id FROM history_capture_members WHERE session_id=?", (session_id,))]
                        delete_capture_benchmarks(restored, captures, timestamp)
                        restored.executemany("DELETE FROM history_captures WHERE capture_id=?",
                                             ((capture_id,) for capture_id in captures))
                    restored.execute(
                        "INSERT INTO review_tombstones VALUES ('forgotten_session', ?, ?) "
                        "ON CONFLICT(kind, item_id) DO UPDATE SET timestamp=max(timestamp, excluded.timestamp)",
                        (session_id, timestamp),
                    )
                for family, report_id, _, _ in knowledge_privacy_rows(restored):
                    if family != "history_report":
                        continue
                    restored.execute("DELETE FROM ledger_entries WHERE scope='history' AND report_id=?",
                                     (report_id,))
                    restored.execute("DELETE FROM history_reports WHERE report_id=?", (report_id,))
                for family, report_id, _, _ in knowledge_privacy_rows(restored):
                    if family != "review":
                        continue
                    restored.execute("DELETE FROM ledger_entries WHERE scope='operational' AND report_id=?",
                                     (report_id,))
                    restored.execute("DELETE FROM review_reports WHERE report_id=?", (report_id,))
                for family, capture_id, _, timestamp in knowledge_privacy_rows(restored):
                    if family != "history_capture":
                        continue
                    delete_capture_benchmarks(restored, [capture_id], timestamp)
                    if restored.execute(
                            "SELECT 1 FROM sqlite_master WHERE type='table' "
                            "AND name='history_captures'").fetchone():
                        restored.execute("DELETE FROM history_captures WHERE capture_id=?", (capture_id,))
                if restored.execute(
                        "SELECT 1 FROM sqlite_master WHERE type='table' "
                        "AND name='benchmark_effects'").fetchone():
                    restored.execute("DELETE FROM benchmark_effects WHERE benchmark_id IN "
                                     "(SELECT item_id FROM knowledge_privacy_tombstones "
                                     "WHERE family='benchmark')")
                if restored.execute(
                        "SELECT 1 FROM sqlite_master WHERE type='table' "
                        "AND name='provider_evaluation_reports'").fetchone():
                    restored.execute("DELETE FROM provider_evaluation_reports WHERE report_id IN "
                                     "(SELECT item_id FROM knowledge_privacy_tombstones "
                                     "WHERE family='provider_evaluation')")
                restored.execute("DELETE FROM incidents WHERE incident_id IN "
                                 "(SELECT item_id FROM knowledge_privacy_tombstones "
                                 "WHERE family='incident')")
                restored.execute(
                    "INSERT INTO incident_signal_dispositions(signal_id,incident_id,disposition,timestamp) "
                    "SELECT item_id,NULL,'forgotten',timestamp FROM knowledge_privacy_tombstones "
                    "WHERE family='incident_signal' "
                    "ON CONFLICT(signal_id) DO UPDATE SET incident_id=NULL,disposition='forgotten',"
                    "timestamp=max(timestamp,excluded.timestamp)")
                merged_rows = knowledge_privacy_rows(restored)
                added = len({tuple(row) for row in merged_rows} - {tuple(row) for row in privacy_rows})
                sequence = max(privacy_sequence, restored_sequence) + added
                restored.execute("UPDATE ledger_meta SET value=? WHERE key='knowledge_privacy_sequence'",
                                 (str(sequence),))
                restored.execute("UPDATE ledger_meta SET value=? WHERE key='knowledge_privacy_digest'",
                                 (knowledge_privacy_digest(restored),))
                prune_phase_spans(root, connection=restored)
                restored.commit()
            except Exception:
                restored.rollback()
                raise
            finally:
                restored.close()
            with ledger_connection(root, path=temporary) as check:
                ledger_integrity(check)
            os.replace(temporary, ledger_path(root))
            os.chmod(ledger_path(root), 0o600)
            history_source_index_path(root).unlink(missing_ok=True)
            fsync_directory(directory)
        finally:
            temporary.unlink(missing_ok=True)
    print(json.dumps({"restored": args.backup, "rollback": rollback}, sort_keys=True))


def command_review_history_save(args):
    try:
        report = validate_history_report_input(json.loads(args.report_json, object_pairs_hook=no_duplicate_keys))
    except json.JSONDecodeError as error:
        fail(f"cannot read review history report: {error}")
    root = review_root(args.state_root)
    excluded_family = historical_excluded_family(args.database, args.excluded_session_id,
                                                 args.excluded_message_id)
    with review_lock(root) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        connection = ensure_ledger_for_write(root)
        records = {item["session_id"]: item for item in history_evidence(root)}
        text_fields = {"findings", "scorecards", "trends", "proposals", "caveats"}
        scan_fields = {"snapshot", "session_ceiling", "part_ceiling", "database_digest"}
        page_fields = {"limit", "cursor"}
        cohort = report["cohort"]
        ids = [history_id(item, "history cohort ID") for item in cohort]
        if set(ids).intersection(excluded_family):
            fail("review history report cohort contains an excluded session")
        missing = [item for item in ids if item not in records]
        refresh = all(name in report for name in scan_fields)
        wanted = ids if refresh else missing
        if wanted:
            if (any(type(report.get(name)) is not int for name in ("snapshot", "session_ceiling", "part_ceiling"))
                    or not isinstance(report.get("database_digest"), str)):
                fail("review history report cohort evidence is unavailable")
            history_digest(report["database_digest"], "database digest")
            page_bound = page_fields <= set(report)
            scan = review_scan(argparse.Namespace(
                database=args.database, state_root=args.state_root, limit=REVIEW_MAX_LIMIT,
                cursor=0, snapshot=report["snapshot"],
                session_ceiling=report["session_ceiling"], part_ceiling=report["part_ceiling"],
                database_digest=report["database_digest"], lock_held=True,
                include_reviewed=True, history_metrics=True, history_all=True, bind_history=True,
                excluded_session_id=args.excluded_session_id, excluded_message_id=args.excluded_message_id,
                allow_database_drift=page_bound,
            ))
            candidates = scan["candidates"]
            if set(ids).intersection(scan["_excluded_session_ids"]):
                fail("review history report cohort contains an excluded session")
            if page_bound:
                archive = {name: report[name] for name in scan_fields}
                live = {item["session_id"]: candidate_history_evidence(item, archive, mark_reviewed=False)
                        for item in candidates}
                if set(ids) - set(live) - set(records):
                    fail("review history report cohort evidence is unavailable")
                available = {key: {**records.get(key, {}), **value} for key, value in live.items()}
                available.update({key: value for key, value in records.items() if key not in live})
                page = [available[item] for item in ids]
                current_query_digest = review_digest(page, report["snapshot"], report["session_ceiling"],
                                                     report["part_ceiling"],
                                                     history_page_digest(page, scan["_source_identities"],
                                                                         report["limit"], report["cursor"]))
                if current_query_digest != report["query_digest"]:
                    fail("OpenCode database changed within the review snapshot")
            selected = {item["session_id"]: item for item in candidates if item["session_id"] in wanted}
            if set(wanted) - set(selected) - set(records):
                fail("review history report cohort evidence is unavailable")
            archive = {"snapshot": report["snapshot"], "session_ceiling": report["session_ceiling"],
                       "part_ceiling": report["part_ceiling"], "database_digest": report["database_digest"]}
            captured = {key: candidate_history_evidence(value, archive, mark_reviewed=False)
                        for key, value in selected.items()}
            records.update(captured)
        else:
            captured = {}
        stored = {key: value for key, value in report.items() if key not in scan_fields | page_fields}
        stored.update({name: report.get(name, []) for name in text_fields})
        stored["evidence"] = [records[item] for item in ids]
        report_id = hashlib.sha256(json.dumps(stored, sort_keys=True, separators=(",", ":")).encode()).hexdigest()[:24]
        stored["report_id"] = report_id
        history_report_value = validate_history_report(stored)
        try:
            connection.execute("BEGIN IMMEDIATE")
            ledger_put_history_report(connection, "report", history_report_value)
            connection.commit()
        except Exception:
            connection.rollback()
            raise
        finally:
            connection.close()
    print(json.dumps({"report_id": report_id}, sort_keys=True))


def improvement_id(value, name):
    if not isinstance(value, str) or not OPAQUE_ID.fullmatch(value):
        fail(f"invalid improvement {name}")
    return value


def improvement_presentation_id(value, name):
    if not isinstance(value, str) or not PRESENTATION_ID.fullmatch(value):
        fail(f"invalid improvement {name}")
    return value


def improvement_path(value):
    if not isinstance(value, str):
        fail("invalid improvement scope path")
    pure = PurePosixPath(value)
    normalized = str(pure)
    if pure.is_absolute() or not pure.parts or ".." in pure.parts or normalized in ("", "."):
        fail("invalid improvement scope path")
    return normalized


def improvement_summary(value):
    if not isinstance(value, str):
        fail("invalid improvement summary")
    normalized = " ".join(value.split())
    if not 1 <= len(normalized.encode()) <= 512 or review_unsafe(normalized):
        fail("unsafe improvement summary")
    return normalized


def improvement_opportunity_id(summary, kind="fix", measurement_plan=None):
    canonical = json.dumps({"summary": improvement_summary(summary).casefold(), "kind": kind,
                            "measurement_plan": measurement_plan}, sort_keys=True, separators=(",", ":"))
    return hashlib.sha256(b"dbsctr-improvement\0" + canonical.encode()).hexdigest()


def improvement_bounded_text(value, label):
    if not isinstance(value, str):
        fail(f"invalid {label}")
    normalized = " ".join(value.split())
    if not 1 <= len(normalized.encode()) <= 512 or review_unsafe(normalized):
        fail(f"unsafe {label}")
    return normalized


def improvement_json(value, label):
    try:
        payload = json.loads(value, object_pairs_hook=no_duplicate_keys) if isinstance(value, str) else value
    except json.JSONDecodeError:
        fail(f"invalid {label}")
    if not isinstance(payload, dict):
        fail(f"invalid {label}")
    return payload


def improvement_measurement_plan(value):
    payload = improvement_json(value, "improvement measurement plan")
    fields = {"schema_version", "hypothesis", "baseline", "metric", "procedure",
              "success_threshold", "evidence_path"}
    if set(payload) != fields or payload.get("schema_version") != 1:
        fail("invalid improvement measurement plan")
    for field in fields - {"schema_version", "evidence_path"}:
        payload[field] = improvement_bounded_text(payload[field], f"measurement plan {field}")
    payload["evidence_path"] = improvement_path(payload["evidence_path"])
    return json.dumps(payload, sort_keys=True, separators=(",", ":"))


def improvement_discovery_report(value):
    payload = improvement_json(value, "improvement discovery report")
    fields = {"schema_version", "interview", "assumptions", "citations", "risks", "evidence_digest"}
    if (set(payload) != fields or payload.get("schema_version") != 1
            or not isinstance(payload.get("interview"), list) or not 1 <= len(payload["interview"]) <= 20
            or not isinstance(payload.get("evidence_digest"), str)
            or not re.fullmatch(r"[0-9a-f]{64}", payload["evidence_digest"])):
        fail("invalid improvement discovery report")
    interview = []
    for item in payload["interview"]:
        if not isinstance(item, dict) or set(item) != {"question", "answer"}:
            fail("invalid improvement discovery report")
        interview.append({key: improvement_bounded_text(item[key], f"discovery {key}")
                          for key in ("question", "answer")})
    payload["interview"] = interview
    for field in ("assumptions", "citations", "risks"):
        if not isinstance(payload.get(field), list) or len(payload[field]) > 20:
            fail("invalid improvement discovery report")
        payload[field] = [improvement_bounded_text(item, f"discovery {field}") for item in payload[field]]
    return json.dumps(payload, sort_keys=True, separators=(",", ":"))


def improvement_implementation_report(value):
    payload = improvement_json(value, "improvement implementation report")
    fields = {"schema_version", "pull_request_url", "changed_paths", "diff_digest", "passed_gates"}
    if (set(payload) != fields or payload.get("schema_version") != 1
            or not isinstance(payload.get("pull_request_url"), str)
            or not re.fullmatch(r"https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/pull/[1-9][0-9]*",
                                payload["pull_request_url"])
            or not isinstance(payload.get("diff_digest"), str)
            or not re.fullmatch(r"[0-9a-f]{64}", payload["diff_digest"])):
        fail("invalid improvement implementation report")
    if (not isinstance(payload.get("changed_paths"), list) or not payload["changed_paths"]
            or payload["changed_paths"] != sorted(set(payload["changed_paths"]))):
        fail("invalid improvement implementation report")
    payload["changed_paths"] = [improvement_path(path) for path in payload["changed_paths"]]
    if (not isinstance(payload.get("passed_gates"), list)
            or payload["passed_gates"] != sorted(set(payload["passed_gates"]))
            or any(not isinstance(gate, str) or not OPAQUE_ID.fullmatch(gate) for gate in payload["passed_gates"])):
        fail("invalid improvement implementation report")
    return json.dumps(payload, sort_keys=True, separators=(",", ":"))


def improvement_readiness(value, worker_id, session_id, opportunity_id, validate_evidence=False):
    try:
        receipt = json.loads(value, object_pairs_hook=no_duplicate_keys) if isinstance(value, str) else value
    except json.JSONDecodeError:
        fail("invalid autonomous readiness receipt")
    fields = {"schema_version", "worker_id", "session_id", "opportunity_id", "risk",
              "material_questions_resolved", "evidence_digest"}
    if (not isinstance(receipt, dict) or set(receipt) != fields or receipt.get("schema_version") != 1
            or receipt.get("worker_id") != worker_id or receipt.get("session_id") != session_id
            or receipt.get("opportunity_id") != opportunity_id
            or receipt.get("risk") not in {"routine", "elevated", "critical"}
            or receipt.get("material_questions_resolved") is not True
            or not isinstance(receipt.get("evidence_digest"), str)
            or not re.fullmatch(r"[0-9a-f]{64}", receipt["evidence_digest"])):
        fail("invalid autonomous readiness receipt")
    if not validate_evidence:
        return json.dumps(receipt, sort_keys=True, separators=(",", ":"))
    path = Path(os.environ.get(
        "DBSCTR_RND_STATE", Path.home() / ".local/state/dotfiles-ai/dbsctr-rnd.sqlite3"
    )).expanduser()
    try:
        details = path.lstat()
        if (path.is_symlink() or stat.S_IFMT(details.st_mode) != stat.S_IFREG
                or details.st_uid != os.getuid() or stat.S_IMODE(details.st_mode) != 0o600):
            fail("autonomous readiness evidence is unavailable")
        connection = sqlite3.connect(f"file:{quote(str(path))}?mode=ro", uri=True, timeout=5)
        try:
            connection.execute("PRAGMA query_only=ON")
            connection.execute("PRAGMA trusted_schema=OFF")
            if connection.execute("PRAGMA integrity_check").fetchone() != ("ok",):
                fail("autonomous readiness evidence is unavailable")
            columns = tuple(row[1] for row in connection.execute("PRAGMA table_info(parallel_lens_passes)"))
            expected = ("worker_id", "lens_name", "capture_day", "manifest_digest", "outcome",
                        "recorded_at", "cadence", "no_yield_count", "quarter", "next_eligible_at",
                        "page_count", "session_count", "review_session_count",
                        "excluded_review_session_count", "unattributed_session_count", "source_count",
                         "opportunity_id", "session_id")
            if (connection.execute(
                    "SELECT value FROM scheduler_meta WHERE key='schema_version'").fetchone() not in {("7",), ("8",)}
                    or columns != expected):
                fail("autonomous readiness evidence is unavailable")
            evidence = connection.execute(
                "SELECT 1 FROM parallel_lens_passes "
                "WHERE worker_id=? AND session_id=? AND opportunity_id=? AND manifest_digest=? AND outcome='yield'",
                (worker_id, session_id, opportunity_id, receipt["evidence_digest"]),
            ).fetchone()
        finally:
            connection.close()
    except (OSError, sqlite3.Error):
        fail("autonomous readiness evidence is unavailable")
    if evidence != (1,):
        fail("autonomous readiness evidence does not match the worker")
    return json.dumps(receipt, sort_keys=True, separators=(",", ":"))


def improvement_worker(connection, worker_id):
    row = connection.execute("""
        SELECT worker_id, session_id, opportunity_id, summary, priority, kind, measurement_plan,
               discovery_report, implementation_report, authorization, readiness, state, resume_state,
               recovery_attempts, workspace_id, tab_id, pane_id, cycle_id,
               pr_number, pr_url, created_at, updated_at
        FROM improvement_workers WHERE worker_id=?
    """, (worker_id,)).fetchone()
    if row is None:
        fail("improvement worker is missing")
    names = ("worker_id", "session_id", "opportunity_id", "summary", "priority", "kind", "measurement_plan",
             "discovery_report", "implementation_report", "authorization", "readiness", "state", "resume_state",
             "recovery_attempts", "workspace_id", "tab_id", "pane_id", "cycle_id",
             "pr_number", "pr_url", "created_at", "updated_at")
    value = dict(zip(names, row))
    value["paths"] = [item[0] for item in connection.execute(
        "SELECT path FROM improvement_scope WHERE worker_id=? ORDER BY path", (worker_id,))]
    return value


def improvement_public(value):
    return {key: item for key, item in value.items() if key != "resume_state"}


def improvement_write(root, callback):
    require_review_lock_safe(root)
    with review_lock(root) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        connection = ensure_ledger_for_write(root)
        try:
            ensure_improvement_schema(connection)
            connection.execute("BEGIN IMMEDIATE")
            result = callback(connection)
            ledger_integrity(connection)
            connection.commit()
            return result
        except Exception:
            connection.rollback()
            raise
        finally:
            connection.close()


def command_improvement_claim(args):
    requested_worker_id = improvement_id(args.worker_id, "worker ID") if args.worker_id is not None else None
    session_id = improvement_id(args.session_id, "session ID")
    summary = improvement_summary(args.summary)
    priority = args.priority
    kind = args.kind
    measurement_plan = (improvement_measurement_plan(args.measurement_plan_json)
                        if args.measurement_plan_json is not None else None)
    if kind == "feature" and measurement_plan is None:
        fail("feature improvement claims require a measurement plan")
    if kind != "feature" and measurement_plan is not None:
        fail("only feature improvement claims accept a measurement plan")
    opportunity_id = improvement_opportunity_id(summary, kind, measurement_plan)
    timestamp = int(datetime.now(timezone.utc).timestamp() * 1000)
    root = review_root(args.state_root)

    def claim(connection):
        if requested_worker_id is None:
            row = connection.execute("SELECT worker_id FROM improvement_workers WHERE session_id=?",
                                     (session_id,)).fetchone()
            if row is None:
                fail("improvement worker must be registered before claiming")
            worker_id = row[0]
        else:
            worker_id = requested_worker_id
        existing = connection.execute("SELECT session_id, opportunity_id FROM improvement_workers "
                                      "WHERE worker_id=?", (worker_id,)).fetchone()
        try:
            if existing is None:
                connection.execute("""
                    INSERT INTO improvement_workers (
                        worker_id, session_id, opportunity_id, summary, priority, kind, measurement_plan,
                        state, resume_state,
                        recovery_attempts, created_at, updated_at
                    ) VALUES (?, ?, ?, ?, ?, ?, ?, 'claimed', 'claimed', 0, ?, ?)
                """, (worker_id, session_id, opportunity_id, summary, priority, kind,
                      measurement_plan, timestamp, timestamp))
            elif existing != (session_id, None):
                fail("improvement opportunity or worker is already claimed")
            else:
                connection.execute("""
                    UPDATE improvement_workers SET opportunity_id=?, summary=?, priority=?, kind=?, measurement_plan=?,
                           discovery_report=NULL, implementation_report=NULL, state='claimed', authorization='none',
                           readiness=NULL, resume_state='claimed', updated_at=? WHERE worker_id=?
                """, (opportunity_id, summary, priority, kind, measurement_plan, timestamp, worker_id))
        except sqlite3.IntegrityError:
            fail("improvement opportunity or worker is already claimed")
        return improvement_public(improvement_worker(connection, worker_id))

    print(json.dumps(improvement_write(root, claim), sort_keys=True))


def command_improvement_promote(args):
    worker_id = improvement_id(args.worker_id, "worker ID")
    if improvement_id(args.confirm, "confirmation") != worker_id:
        fail("improvement worker confirmation does not match")
    root = review_root(args.state_root)

    def promote(connection):
        current = improvement_worker(connection, worker_id)
        if current["state"] != "claimed" or current["priority"] not in {"P2", "P3"}:
            fail("only a claimed P2/P3 improvement worker can be promoted")
        timestamp = int(datetime.now(timezone.utc).timestamp() * 1000)
        connection.execute("""
            UPDATE improvement_workers SET priority='P1', authorization='operator', readiness=NULL,
                   state='discovery', resume_state='discovery', updated_at=? WHERE worker_id=?
        """, (timestamp, worker_id))
        return improvement_public(improvement_worker(connection, worker_id))

    print(json.dumps(improvement_write(root, promote), sort_keys=True))


def command_improvement_register(args):
    worker_id = improvement_id(args.worker_id, "worker ID")
    session_id = improvement_id(args.session_id, "session ID")
    identifiers = {name: improvement_presentation_id(value, name.replace("_", " "))
                    for name, value in (("workspace_id", args.workspace_id), ("tab_id", args.tab_id),
                                        ("pane_id", args.pane_id)) if value is not None}
    timestamp = int(datetime.now(timezone.utc).timestamp() * 1000)
    root = review_root(args.state_root)

    def register(connection):
        existing = connection.execute(
            "SELECT worker_id,session_id FROM improvement_workers WHERE worker_id=? OR session_id=?",
            (worker_id, session_id),
        ).fetchall()
        if existing:
            if existing == [(worker_id, session_id)]:
                return improvement_public(improvement_worker(connection, worker_id))
            fail("improvement worker is already registered")
        columns = ["worker_id", "session_id", "state", "resume_state", "recovery_attempts",
                   "created_at", "updated_at", *identifiers]
        values = [worker_id, session_id, "reviewing", "reviewing", 0, timestamp, timestamp,
                  *identifiers.values()]
        try:
            connection.execute(
                f"INSERT INTO improvement_workers ({', '.join(columns)}) VALUES ({', '.join('?' for _ in values)})",
                values,
            )
        except sqlite3.IntegrityError:
            fail("improvement worker is already registered")
        return improvement_public(improvement_worker(connection, worker_id))

    print(json.dumps(improvement_write(root, register), sort_keys=True))


def scopes_overlap(left, right):
    left, right = PurePosixPath(left).parts, PurePosixPath(right).parts
    return left[:len(right)] == right or right[:len(left)] == left


def command_improvement_update(args):
    if (args.worker_id is None) == (args.session_id is None):
        fail("improvement update requires exactly one worker or session ID")
    requested_worker_id = improvement_id(args.worker_id, "worker ID") if args.worker_id is not None else None
    requested_session_id = improvement_id(args.session_id, "session ID") if args.session_id is not None else None
    state = args.state
    identifiers = {name: improvement_presentation_id(value, name.replace("_", " "))
                    for name, value in (("workspace_id", args.workspace_id), ("tab_id", args.tab_id),
                                        ("pane_id", args.pane_id))
                    if value is not None}
    if args.cycle_id is not None:
        identifiers["cycle_id"] = improvement_id(args.cycle_id, "cycle ID")
    paths = sorted(set(improvement_path(value) for value in args.path or []))
    transitions = {
        "reviewing": {"blocked", "abandoned"},
        "claimed": {"discovery", "blocked", "abandoned"},
        "discovery": {"implementing", "blocked", "abandoned"},
        "implementing": {"blocked", "abandoned"},
        "draft_pr": {"merged", "closed", "blocked"},
        "blocked": set(), "merged": set(), "closed": set(), "abandoned": set(),
    }
    root = review_root(args.state_root)

    def update(connection):
        if requested_worker_id is None:
            row = connection.execute("SELECT worker_id FROM improvement_workers WHERE session_id=?",
                                     (requested_session_id,)).fetchone()
            if row is None:
                fail("improvement worker is missing")
            worker_id = row[0]
        else:
            worker_id = requested_worker_id
        current = improvement_worker(connection, worker_id)
        authorization = current["authorization"]
        readiness = current["readiness"]
        discovery_report = current["discovery_report"]
        if ((args.autonomous or args.readiness_json is not None or args.operator_confirm is not None)
                and not (current["state"] == "claimed" and state == "discovery")):
            fail("improvement authorization is accepted only for claimed -> discovery")
        discovery_update = (args.discovery_json is not None and current["state"] == "discovery"
                            and state == "discovery" and current["authorization"] == "operator"
                            and current["discovery_report"] is None)
        if (args.discovery_json is not None and not discovery_update
                and not (current["state"] == "claimed" and state == "discovery")):
            fail("Discovery report is accepted only when entering or completing Discovery")
        if current["state"] == "claimed" and state == "discovery":
            discovery_report = (improvement_discovery_report(args.discovery_json)
                                if args.discovery_json is not None else None)
            if args.operator_confirm == worker_id:
                if discovery_report is None:
                    fail("Discovery requires a persisted interview report")
                authorization = "operator"
                readiness = None
            elif current["priority"] in {"P0", "P1"} and args.autonomous:
                authorization = "autonomous"
                readiness = improvement_readiness(
                    args.readiness_json, worker_id, current["session_id"], current["opportunity_id"],
                    validate_evidence=True)
                receipt = json.loads(readiness)
                if (current["priority"] == "P0" and receipt["risk"] != "critical"
                        or current["priority"] == "P1" and receipt["risk"] == "critical"):
                    fail("autonomous readiness risk does not match improvement priority")
                if (discovery_report is None
                        or json.loads(discovery_report)["evidence_digest"] != receipt["evidence_digest"]):
                    fail("autonomous Discovery report does not match readiness evidence")
            else:
                fail("P0/P1 require autonomous readiness or operator confirmation; P2/P3 require promotion")
        elif discovery_update:
            discovery_report = improvement_discovery_report(args.discovery_json)
        if state != current["state"] and state not in transitions[current["state"]]:
            fail(f"invalid improvement transition: {current['state']} -> {state}")
        if state == "implementing":
            if discovery_report is None:
                fail("implementing requires a persisted Discovery interview")
            if not paths or args.cycle_id is None:
                fail("implementing requires a cycle ID and declared scope paths")
        if state == "draft_pr":
            fail("draft_pr state is recorded only by verified Final Push")
        if paths:
            if current["opportunity_id"] is None:
                fail("improvement scope requires a claimed opportunity")
            active = {"claimed", "discovery", "implementing", "draft_pr", "blocked"}
            for owner, existing in connection.execute("""
                    SELECT w.worker_id, s.path FROM improvement_scope s
                    JOIN improvement_workers w USING (worker_id)
                    WHERE w.worker_id != ? AND w.state IN (?, ?, ?, ?, ?)
            """, (worker_id, *sorted(active))):
                if any(scopes_overlap(path, existing) for path in paths):
                    fail(f"improvement scope conflicts with {owner}")
            connection.execute("DELETE FROM improvement_scope WHERE worker_id=?", (worker_id,))
            connection.executemany("INSERT INTO improvement_scope VALUES (?, ?)",
                                   ((worker_id, path) for path in paths))
        timestamp = int(datetime.now(timezone.utc).timestamp() * 1000)
        assignments = ["state=?", "updated_at=?"]
        values = [state, timestamp]
        if authorization != current["authorization"]:
            assignments.append("authorization=?")
            values.append(authorization)
        if readiness != current["readiness"]:
            assignments.append("readiness=?")
            values.append(readiness)
        if discovery_report != current["discovery_report"]:
            assignments.append("discovery_report=?")
            values.append(discovery_report)
        if state in IMPROVEMENT_RESUMABLE_STATES:
            assignments.append("resume_state=?")
            values.append(state)
        for name, value in identifiers.items():
            assignments.append(f"{name}=?")
            values.append(value)
        values.append(worker_id)
        connection.execute(f"UPDATE improvement_workers SET {', '.join(assignments)} WHERE worker_id=?", values)
        if state == "abandoned":
            connection.execute("DELETE FROM improvement_scope WHERE worker_id=?", (worker_id,))
        return improvement_public(improvement_worker(connection, worker_id))

    print(json.dumps(improvement_write(root, update), sort_keys=True))


def command_improvement_recover(args):
    worker_id = improvement_id(args.worker_id, "worker ID")
    root = review_root(args.state_root)

    def recover(connection):
        current = improvement_worker(connection, worker_id)
        if current["state"] in {"merged", "closed", "abandoned"}:
            fail("terminal improvement worker cannot be recovered")
        if (current["priority"] in {"P2", "P3"} and current["state"] == "claimed"
                and args.action != "abandon"):
            fail("P2/P3 improvement claims remain queued until promotion or abandonment")
        timestamp = int(datetime.now(timezone.utc).timestamp() * 1000)
        if args.action == "failed":
            attempts = min(current["recovery_attempts"] + 1, 3)
            state = "blocked" if attempts == 3 else current["state"]
            connection.execute("UPDATE improvement_workers SET state=?, recovery_attempts=?, updated_at=? "
                               "WHERE worker_id=?", (state, attempts, timestamp, worker_id))
        elif args.action == "retry":
            if current["state"] != "blocked":
                fail("only a blocked improvement worker can be retried")
            connection.execute("UPDATE improvement_workers SET state=resume_state, recovery_attempts=0, "
                               "updated_at=? WHERE worker_id=?", (timestamp, worker_id))
        elif args.action == "success":
            connection.execute("UPDATE improvement_workers SET recovery_attempts=0, updated_at=? WHERE worker_id=?",
                               (timestamp, worker_id))
        else:
            connection.execute("UPDATE improvement_workers SET state='abandoned', updated_at=? WHERE worker_id=?",
                               (timestamp, worker_id))
            connection.execute("DELETE FROM improvement_scope WHERE worker_id=?", (worker_id,))
        return improvement_public(improvement_worker(connection, worker_id))

    print(json.dumps(improvement_write(root, recover), sort_keys=True))


def command_improvement_forget(args):
    worker_id = improvement_id(args.worker_id, "worker ID")
    if improvement_id(args.confirm, "confirmation") != worker_id:
        fail("improvement worker confirmation does not match")
    root = review_root(args.state_root)

    def forget(connection):
        if improvement_worker(connection, worker_id)["state"] != "abandoned":
            fail("only an abandoned improvement worker can be forgotten")
        connection.execute("DELETE FROM improvement_workers WHERE worker_id=?", (worker_id,))
        return {"forgotten_worker_id": worker_id}

    print(json.dumps(improvement_write(root, forget), sort_keys=True))


def command_improvement_status(args):
    root = review_root(args.state_root)
    require_review_lock_safe(root)
    if not ledger_exists(root):
        print(json.dumps({"workers": []}, sort_keys=True))
        return
    with review_lock(root) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        connection = ledger_connection(root, write=True)
        try:
            if connection.execute("SELECT value FROM ledger_meta WHERE key='improvement_schema'").fetchone() is None:
                workers = []
            else:
                query = "SELECT worker_id FROM improvement_workers"
                values = ()
                if args.worker_id is not None:
                    query += " WHERE worker_id=?"
                    values = (improvement_id(args.worker_id, "worker ID"),)
                query += " ORDER BY created_at, worker_id"
                workers = [improvement_public(improvement_worker(connection, row[0]))
                           for row in connection.execute(query, values)]
        finally:
            connection.close()
    print(json.dumps({"workers": workers}, sort_keys=True))


def command_review_complete(args):
    try:
        raw_report = args.report_json if args.report_json is not None else Path(args.report).read_text(encoding="utf-8")
        report = json.loads(raw_report, object_pairs_hook=no_duplicate_keys)
    except (OSError, json.JSONDecodeError) as error:
        fail(f"cannot read review report: {error}")
    text_fields = ("findings", "scorecards", "trends", "proposals", "caveats")
    allowed = {"session_ids", "cycle_ids", "scan_digest", "snapshot", "session_ceiling", "part_ceiling", "database_digest",
               "exclusion_digest", "limit", "cursor", "decision", "notes", *text_fields}
    if not isinstance(report, dict) or set(report) - allowed:
        fail("review report has an invalid schema")
    sessions, cycles = report.get("session_ids"), report.get("cycle_ids", [])
    if (not isinstance(sessions, list) or not sessions or not isinstance(cycles, list)
            or not all(isinstance(value, str) and re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}", value)
                       for value in sessions + cycles)
            or len(sessions) > REVIEW_MAX_LIMIT or len(cycles) > REVIEW_MAX_LIMIT):
        fail("review report has invalid IDs")
    if len(set(sessions)) != len(sessions) or len(set(cycles)) != len(cycles):
        fail("review report IDs must be unique")
    decision, notes = report.get("decision"), report.get("notes")
    if not isinstance(decision, str) or not 1 <= len(decision.encode()) <= 256:
        fail("review report has invalid decision")
    if notes is not None and (not isinstance(notes, str) or len(notes.encode()) > 2048):
        fail("review report has invalid notes")
    digest = report.get("scan_digest")
    if not isinstance(digest, str) or args.scan_digest != digest:
        fail("review report does not match scan digest")
    if (type(report.get("snapshot")) is not int or type(report.get("session_ceiling")) is not int
            or type(report.get("part_ceiling")) is not int or type(report.get("limit")) is not int
            or type(report.get("cursor")) is not int or not 1 <= report["limit"] <= REVIEW_MAX_LIMIT
            or report["cursor"] < 0 or not 0 <= report["session_ceiling"] <= 2**63 - 1
            or not 0 <= report["part_ceiling"] <= 2**63 - 1
            or not isinstance(report.get("database_digest"), str)
            or not re.fullmatch(r"[0-9a-f]{64}", report["database_digest"])
            or report.get("exclusion_digest") is not None
            and not re.fullmatch(r"[0-9a-f]{64}", report["exclusion_digest"])):
        fail("review report requires its scan snapshot, limit, and cursor")
    for name in text_fields:
        values = report.get(name, [])
        if (not isinstance(values, list) or len(values) > 50
                or not all(isinstance(value, str) and 1 <= len(value) <= 512 for value in values)):
            fail(f"review report has invalid {name}")
    # Digests and opaque OpenCode IDs can be high entropy by design; inspect only human text.
    human_text = [str(report.get(name, "")) for name in ("decision", "notes")]
    human_text.extend(value for name in text_fields for value in report.get(name, []))
    if review_unsafe(" ".join(human_text)):
        fail("review report contains unsafe content")
    root = review_root(args.state_root)
    require_review_lock_safe(root)
    with review_lock(root) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        current_sessions, _ = reviewed_ids(args.state_root, lock=False)
        if current_sessions.intersection(sessions):
            fail("review page was already completed")
        expected = review_scan(argparse.Namespace(
            database=args.database, state_root=args.state_root,
            limit=report["limit"], cursor=report["cursor"], snapshot=report["snapshot"],
            session_ceiling=report["session_ceiling"], part_ceiling=report["part_ceiling"],
            database_digest=report["database_digest"],
            lock_held=True,
            history_metrics=False,
            excluded_session_id=args.excluded_session_id,
            excluded_message_id=args.excluded_message_id,
            exclusion_digest=report.get("exclusion_digest"),
            allow_database_drift=True,
        ))
        if (expected["session_ids"] != sessions or expected["cycle_ids"] != cycles
                or expected["digest"] != digest):
            fail("OpenCode database changed within the review snapshot")
        for candidate in expected["candidates"]:
            candidate["_history_identity"] = {
                "method_revision": "unavailable", "context": "unavailable",
                "project_digest": "unavailable",
            }
            candidate["_history_metrics"] = {}
        forgotten = review_index(root)["forgotten_sessions"]
        reviewed_at = max(int(datetime.now(timezone.utc).timestamp() * 1000), report["snapshot"] + 1,
                          *(forgotten.get(value, 0) + 1 for value in sessions))
        persisted = {key: value for key, value in report.items() if key != "exclusion_digest"}
        persisted["database_digest"] = expected["database_digest"]
        persisted.update({"cycle_ids": cycles, "reviewed_at": reviewed_at})
        name = hashlib.sha256((digest + "\0" + json.dumps(persisted, sort_keys=True)).encode()).hexdigest()[:24]
        connection = ensure_ledger_for_write(root)
        try:
            connection.execute("BEGIN IMMEDIATE")
            pruned = prune_review_reports(root, connection=connection)
            prune_phase_spans(root, connection=connection)
            archive_review_candidates(root, expected, connection=connection)
            ledger_put_review_report(connection, name, persisted)
            connection.commit()
        except Exception:
            connection.rollback()
            raise
        finally:
            connection.close()
    print(json.dumps({"digest": digest, "reviewed_sessions": len(sessions),
                      "reviewed_cycles": len(cycles), "pruned_reports": pruned}, sort_keys=True))


def command_review_prune(args):
    root = review_root(args.state_root)
    require_review_lock_safe(root)
    with review_lock(root) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        connection = ensure_ledger_for_write(root)
        try:
            connection.execute("BEGIN IMMEDIATE")
            removed = prune_review_reports(root, connection=connection)
            removed_spans = prune_phase_spans(root, connection=connection)
            connection.commit()
        except Exception:
            connection.rollback()
            raise
        finally:
            connection.close()
        removed_backup_spans = prune_phase_backup_spans(root)
    print(json.dumps({"pruned_reports": removed, "pruned_phase_spans": removed_spans,
                      "pruned_backup_phase_spans": removed_backup_spans}, sort_keys=True))


def command_review_forget(args):
    root = review_root(args.state_root)
    if not OPAQUE_ID.fullmatch(args.session_id):
        fail("invalid review forget ID")
    database = opencode_database(args.database)
    if not database.is_file() and history_source_index_path(root).exists():
        fail("review forget requires source family authority")
    forgotten_family = (historical_excluded_family(args.database, args.session_id)
                        if database.is_file() else {args.session_id})
    placeholders = ",".join("?" for _ in forgotten_family)
    family_values = tuple(sorted(forgotten_family))
    require_review_lock_safe(root)
    with review_lock(root) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        connection = ensure_ledger_for_write(root)
        history_evidence(root)
        reports = history_reports(root)
        cohorts = history_cohorts(root)
        dependent = {item["report_id"] for item in reports + cohorts
                     if set(item["cohort"]).intersection(forgotten_family)}
        capture_dependent = ([row[0] for row in connection.execute(
            f"SELECT DISTINCT capture_id FROM history_capture_members WHERE session_id IN ({placeholders})",
            family_values)]
            if connection.execute(
                "SELECT 1 FROM sqlite_master WHERE type='table' AND name='history_capture_members'").fetchone() else [])
        value = review_index(root)
        session_times = [timestamp for _, report, timestamp in review_reports(root)
                         if set(report["session_ids"]).intersection(forgotten_family)]
        session_times.extend(value["sessions"].get(session_id, 0) for session_id in forgotten_family)
        incident_ids = [row[0] for row in connection.execute(
            f"SELECT incident_id FROM incidents WHERE session_id IN ({placeholders})", family_values)]
        incident_signals = [row[0] for row in connection.execute(
            "SELECT signal_id FROM incident_signal_dispositions WHERE incident_id IN "
            f"(SELECT incident_id FROM incidents WHERE session_id IN ({placeholders}))", family_values)]
        removed = bool(forgotten_family.intersection(reviewed_ids_unlocked(root)[0])) or bool(incident_ids)
        forgotten_at = max(int(datetime.now(timezone.utc).timestamp() * 1000), max(session_times) + 1)
        staged = None
        quarantine_name = f".forget-{uuid.uuid4().hex}"
        try:
            connection.execute("BEGIN IMMEDIATE")
            prune_review_reports(root, connection=connection)
            connection.executemany("DELETE FROM history_evidence WHERE session_id=?",
                                   ((session_id,) for session_id in forgotten_family))
            for report_id in dependent:
                connection.execute("DELETE FROM ledger_entries WHERE scope='history' AND report_id=?", (report_id,))
                connection.execute("DELETE FROM history_reports WHERE report_id=?", (report_id,))
            if capture_dependent:
                delete_capture_benchmarks(connection, capture_dependent, forgotten_at)
                connection.executemany("DELETE FROM history_captures WHERE capture_id=?",
                                       ((capture_id,) for capture_id in capture_dependent))
            if incident_ids:
                connection.execute(
                    "UPDATE incident_signal_dispositions SET incident_id=NULL,disposition='forgotten',timestamp=? "
                    f"WHERE incident_id IN (SELECT incident_id FROM incidents WHERE session_id IN ({placeholders}))",
                    (forgotten_at, *family_values))
                connection.execute(f"DELETE FROM incidents WHERE session_id IN ({placeholders})", family_values)
            connection.executemany(
                "INSERT INTO review_tombstones VALUES ('forgotten_session', ?, ?) "
                "ON CONFLICT(kind, item_id) DO UPDATE SET timestamp=max(timestamp, excluded.timestamp)",
                ((session_id, forgotten_at) for session_id in forgotten_family),
            )
            for session_id in forgotten_family:
                record_knowledge_privacy_tombstone(
                    connection, "telemetry", session_id, "forgotten", forgotten_at)
            for report_id in dependent:
                record_knowledge_privacy_tombstone(
                    connection, "history_report", report_id, "forgotten", forgotten_at)
            for capture_id in capture_dependent:
                record_knowledge_privacy_tombstone(
                    connection, "history_capture", capture_id, "forgotten", forgotten_at)
            for incident_id in incident_ids:
                record_knowledge_privacy_tombstone(
                    connection, "incident", incident_id, "forgotten", forgotten_at)
            for signal_id in incident_signals:
                record_knowledge_privacy_tombstone(
                    connection, "incident_signal", signal_id, "forgotten", forgotten_at)
            connection.execute("INSERT INTO ledger_meta VALUES ('pending_forget_cleanup', ?)",
                               (quarantine_name,))
            staged = stage_pre_forget_state(root, quarantine_name)
            connection.commit()
            index_path = history_source_index_path(root)
            if index_path.exists() or index_path.is_symlink():
                if index_path.is_symlink() or not index_path.is_file():
                    fail("history source index is unsafe")
                index_path.unlink()
                fsync_directory(index_path.parent)
        except Exception:
            connection.rollback()
            if staged is not None:
                restore_staged_forget(*staged)
            connection.close()
            raise
        recover_forget_state(root, connection)
        connection.close()
    print(json.dumps({"forgotten": removed}, sort_keys=True))


def command_review(args):
    root = root_dir()
    path, record = load(root)
    require_active(record)
    if args.result == "changed" and not args.path:
        fail("changed artifact review requires --path")
    if args.path:
        expected = f"docs/specs/{record['context']}/{args.name}.md"
        if args.path != expected:
            fail(f"{args.name} path must be {expected}")
        safe_paths(root, [args.path])
    record["artifact_reviews"][args.name] = {
        "result": args.result, "reason": args.reason, "path": args.path,
        "reviewed_at": now()
    }
    save(path, record)


def evidence_text(value, limit, name):
    try:
        raw = value.encode("utf-8")
    except UnicodeEncodeError:
        fail(f"{name} must be UTF-8")
    if not value or len(raw) > limit or any(ord(char) < 32 or ord(char) == 127 for char in value):
        fail(f"invalid {name}")
    if SECRET_VALUE.search(value) or HIGH_ENTROPY.search(value):
        fail(f"unsafe {name}")
    return value


def redact_argument(value):
    if SECRET_VALUE.search(value) or HIGH_ENTROPY.search(value) or value.startswith("op://"):
        return "[REDACTED]"
    if "://" in value and re.search(r"://[^/@:]+:[^/@]+@", value):
        return "[REDACTED]"
    return value


def sanitized_argv(argv):
    if not argv or len(argv) > 64:
        fail("argv must contain 1 through 64 entries")
    output = []
    for index, value in enumerate(argv):
        if not isinstance(value, str) or "\0" in value:
            fail("invalid argv")
        if index == 0:
            name = Path(value).name
            output.append(name if name and not SECRET_VALUE.search(name) and not HIGH_ENTROPY.search(name) else "[REDACTED]")
        elif value.startswith("--"):
            output.append(value.partition("=")[0] + ("=[REDACTED]" if "=" in value else ""))
        elif value in ("-q", "-v", "-s", "-x", "-n"):
            output.append(value)
        else:
            output.append("[REDACTED]")
    if len(json.dumps(output, ensure_ascii=True, separators=(",", ":")).encode()) > 4096:
        fail("serialized argv exceeds 4096 bytes")
    return output


def safe_output(raw):
    if not raw:
        return {"status": "no_content"}, None
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError:
        return {"status": "withheld", "reason": "non_utf8"}, None
    if (SECRET_VALUE.search(text) or HIGH_ENTROPY.search(text) or "://" in text
            or re.search(r"(?:^|\s)(?:/|~)[^\s]+", text) or any(ord(char) < 32 and char not in "\n\r\t" for char in text)):
        return {"status": "withheld", "reason": "unclassified"}, None
    lines = [line for line in text.splitlines() if line]
    if not lines or not all(SAFE_EVIDENCE_LINE.fullmatch(line) for line in lines):
        return {"status": "withheld", "reason": "unclassified"}, None
    return None, text.encode("utf-8")


def write_sidecar(root, cycle_id, data):
    digest = hashlib.sha256(data).hexdigest()
    parent = common_git_dir(root) / "dbsctr" / "evidence"
    directory = parent / cycle_id
    for candidate in (parent, directory):
        if candidate.is_symlink():
            fail("unsafe evidence directory")
        candidate.mkdir(parents=True, exist_ok=True, mode=0o700)
        os.chmod(candidate, 0o700)
        candidate_stat = candidate.stat()
        if candidate_stat.st_uid != os.getuid() or candidate_stat.st_mode & 0o777 != 0o700:
            fail("unsafe evidence directory")
    target = directory / digest
    if target.exists() or target.is_symlink():
        stat = target.lstat()
        if (not target.is_file() or target.is_symlink() or stat.st_uid != os.getuid()
                or stat.st_mode & 0o777 != 0o600 or stat.st_size != len(data)
                or hashlib.sha256(target.read_bytes()).hexdigest() != digest):
            fail("unsafe evidence sidecar")
        return digest
    descriptor, temporary = tempfile.mkstemp(dir=directory)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "wb") as handle:
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        try:
            os.link(temporary, target)
        except FileExistsError:
            pass
    finally:
        Path(temporary).unlink(missing_ok=True)
    return digest


def verify_envelope(root, record, gate_name, require_bound=False, require_head=True):
    gate = record["gates"][gate_name]
    evidence_id = gate.get("evidence")
    amendment_fresh_evidence(root, record, evidence_id)
    item = record.get("evidence", {}).get("items", {}).get(evidence_id)
    if not item or item.get("gate") != gate_name or item.get("result") != gate.get("result"):
        fail(f"invalid evidence for gate: {gate_name}")
    if require_head and item.get("head") != git(root, "rev-parse", "HEAD").stdout.strip():
        fail(f"evidence HEAD is stale: {gate_name}")
    if require_bound and not item.get("commit"):
        fail(f"evidence is not bound to a commit: {gate_name}")
    content = item.get("content", {})
    if content.get("status") == "sidecar":
        if content.get("path") != f"evidence/{record['cycle_id']}/{content.get('sha256')}":
            fail("invalid evidence sidecar path")
        target = common_git_dir(root) / "dbsctr" / content["path"]
        if (not target.exists() or target.is_symlink() or not target.is_file() or target.stat().st_uid != os.getuid()
                or target.stat().st_mode & 0o777 != 0o600 or target.stat().st_size != content.get("byte_count")
                or hashlib.sha256(target.read_bytes()).hexdigest() != content.get("sha256")):
            fail("invalid evidence sidecar")
    elif content.get("status") not in ("withheld", "no_content"):
        fail("invalid evidence content")
    return item


def evidence_path_blobs(root, paths, index=False, commit=None):
    if not paths:
        return {}
    result = {}
    for name in paths if index or commit else safe_paths(root, paths):
        if commit:
            value = git(root, "rev-parse", "--verify", f"{commit}:{name}", check=False)
        elif index:
            value = git(root, "rev-parse", "--verify", f":{name}", check=False)
        elif os.path.lexists(root / name):
            value = git(root, "hash-object", "--path", name, "--", name, check=False)
        else:
            value = None
        result[name] = value.stdout.strip() if value and value.returncode == 0 else None
    return result


def command_record_evidence(args):
    root = root_dir()
    authority = evidence_text(args.authority, 128, "authority")
    argv, sanitized = list(args.program), sanitized_argv(args.program)
    path_blobs = evidence_path_blobs(root, args.path or [])
    with evidence_lock(root, resolved_active_path(root).read_text(encoding="utf-8").strip()):
        path, record = load(root)
        require_active(record)
        if record.get("schema_version") not in (3, 4, 5, 6):
            fail("record-evidence requires a schema 3 or 4 Cycle Record")
        gate = record["gates"][args.gate]
        if gate["applicability"] != "required":
            fail("evidence gate is not required")
        started, observed, cutoff, start_error = now(), 0, None, False
        raw = bytearray()
        try:
            process = subprocess.Popen(argv, cwd=root, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                       stderr=subprocess.STDOUT, shell=False, start_new_session=True)
            selector = selectors.DefaultSelector()
            selector.register(process.stdout, selectors.EVENT_READ)
            deadline = datetime.now(timezone.utc).timestamp() + args.timeout
            while selector.get_map() and not cutoff:
                remaining = deadline - datetime.now(timezone.utc).timestamp()
                if remaining <= 0:
                    cutoff = "timeout"
                    break
                for key, _ in selector.select(remaining):
                    block = os.read(key.fd, 65536)
                    if not block:
                        selector.unregister(key.fileobj)
                        continue
                    observed += len(block)
                    raw.extend(block[:max(0, EVIDENCE_RAW_CAP - len(raw))])
                    if observed > EVIDENCE_RAW_CAP:
                        cutoff = "overflow"
                        break
            if cutoff:
                os.killpg(process.pid, signal.SIGTERM)
                try:
                    process.wait(timeout=1)
                except subprocess.TimeoutExpired:
                    pass
                try:
                    os.killpg(process.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
            process.wait(timeout=2)
            selector.close()
        except subprocess.TimeoutExpired:
            cutoff = "timeout"
            if process:
                try:
                    os.killpg(process.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                process.wait()
        except OSError:
            start_error, process = True, None
        finished = now()
        result = "unavailable" if start_error or cutoff else "passed" if process.returncode == 0 else "failed"
        if result == "passed":
            incomplete = [name for name in GATES[:GATES.index(args.gate)] if not disposed(record["gates"][name])]
            if incomplete:
                fail("gate predecessors are incomplete: " + ", ".join(incomplete))
        content, retained = ({"status": "withheld", "reason": cutoff or "start_failed"}, None) if (cutoff or start_error) else safe_output(bytes(raw))
        envelope = {"id": "ev-" + uuid.uuid4().hex, "gate": args.gate, "authority": authority,
                    "argv": sanitized, "paths": path_blobs,
                    "head": git(root, "rev-parse", "HEAD").stdout.strip(),
                    "started_at": started, "finished_at": finished, "result": result,
                    "raw": {"byte_count": observed, "lower_bound": bool(cutoff), "truncated": bool(cutoff)},
                    "summary": "passed" if result == "passed" else "failed" if result == "failed" else "unavailable", "urls": []}
        if retained is not None:
            retained, truncated = retained[:EVIDENCE_SIDECAR_CAP], len(retained) > EVIDENCE_SIDECAR_CAP
            digest = write_sidecar(root, record["cycle_id"], retained)
            content = {"status": "sidecar", "path": f"evidence/{record['cycle_id']}/{digest}", "sha256": digest,
                       "byte_count": len(retained), "truncated": truncated}
        envelope["content"] = content
        evidence_id = envelope["id"]
        record["evidence"]["items"][evidence_id] = envelope
        apply_gate_result(record, args.gate, result, evidence_id)
        save(path, record)
        print(evidence_id)


def command_set_gate(args):
    root = root_dir()
    path, record = load(root)
    require_active(record)
    gate = record["gates"][args.gate]
    if record.get("schema_version") in (3, 4, 5, 6) and args.evidence is not None:
        amendment_fresh_evidence(root, record, args.evidence)
        item = record["evidence"]["items"].get(args.evidence)
        if not item or item["gate"] != args.gate or item["result"] != args.result:
            fail("schema 3 evidence must be a matching stored evidence ID")
        if item["head"] != git(root, "rev-parse", "HEAD").stdout.strip():
            fail("schema 3 evidence HEAD is stale")
    if is_v32(record) and args.result == "passed":
        incomplete = [name for name in GATES[:GATES.index(args.gate)] if not disposed(record["gates"][name])]
        if incomplete:
            fail("gate predecessors are incomplete: " + ", ".join(incomplete))
    if gate["applicability"] == "required" and args.result == "not_run":
        fail("required gates cannot use not_run")
    if gate["applicability"] == "not_applicable" and args.result != "not_run":
        fail("not_applicable gates can only use not_run")
    if gate["applicability"] == "required" and args.result in ("passed", "failed", "unavailable") and not args.evidence:
        fail(f"{args.result} required gate needs evidence")
    apply_gate_result(record, args.gate, args.result, args.evidence)
    save(path, record)


def command_set_applicability(args):
    root = root_dir()
    path, record = load(root)
    require_active(record)
    gate = record["gates"][args.gate]
    if is_v32(record):
        if args.value != "required" or gate["applicability"] != "not_applicable":
            fail("V3.2 applicability may only tighten from not_applicable to required")
        gate.update({"applicability": "required", "result": "pending"})
        gate.pop("reason", None)
        gate.pop("exception", None)
        invalidate_later(record, args.gate)
        record["applicability_plan"]["gates"][args.gate] = {"applicability": "required"}
        save(path, record)
        return
    gate["applicability"] = args.value
    if args.value == "not_applicable":
        if not args.reason:
            fail("not_applicable needs a reason")
        gate.update({"result": "not_run", "reason": args.reason})
    else:
        gate.update({"result": "pending"})
        gate.pop("reason", None)
    gate.pop("exception", None)
    save(path, record)


def adopt_profile_only_commits(root, record):
    baseline = record["git"]["head"]
    lineage = git(root, "rev-list", "--first-parent", "--reverse", f"{baseline}..HEAD").stdout.splitlines()
    recorded_ids = [entry["id"] for entry in record["commits"]]
    if len(recorded_ids) != len(set(recorded_ids)):
        fail("recorded lifecycle commits contain a duplicate")
    if any(commit not in lineage for commit in recorded_ids):
        fail("recorded lifecycle commit is missing from first-parent lineage")
    recorded = {entry["id"]: entry for entry in record["commits"]}
    profile = record["applicability_plan"]["profile"]
    for commit in lineage:
        if commit in recorded:
            continue
        changed = git(root, "diff-tree", "--no-commit-id", "--name-only", "-r", commit).stdout.splitlines()
        if changed != [profile]:
            fail("unrecorded commit changes more than the Engineering Profile")
        recorded[commit] = {"id": commit, "gates": []}
    record["commits"] = [recorded[commit] for commit in lineage]


def command_raise_risk(args):
    root = root_dir()
    path, record = load(root)
    require_active(record)
    if not is_v32(record):
        fail("raise-risk requires a V3.2 Cycle Record")
    if RISK_RANK[args.to] <= RISK_RANK[record["risk"]]:
        fail("risk may only increase")
    previous = record["risk"]
    apply_stricter_plan(root, record, read_plan(args.plan))
    adopt_profile_only_commits(root, record)
    record["risk"] = args.to
    record.setdefault("risk_history", []).append({
        "from": previous, "to": args.to, "reason": args.reason, "raised_at": now(),
    })
    save(path, record)


def command_update_plan(args):
    root = root_dir()
    path, record = load(root)
    require_active(record)
    if not is_v32(record):
        fail("update-plan requires a V3.2 Cycle Record")
    apply_stricter_plan(root, record, read_plan(args.plan))
    adopt_profile_only_commits(root, record)
    save(path, record)


def graphify_receipt_path(root, cycle_id):
    return cycle_dir(root) / "graphify" / f"{cycle_id}.json"


def graphify_output_identity(output):
    files, digests, total = [], {}, 0
    for path in sorted(output.rglob("*")):
        relative = path.relative_to(output).as_posix()
        details = path.lstat()
        if stat.S_IFMT(details.st_mode) == stat.S_IFDIR:
            continue
        if stat.S_IFMT(details.st_mode) != stat.S_IFREG or path.is_symlink():
            fail("Graphify output contains an unsafe file")
        total += details.st_size
        if len(files) >= 1024 or total > 256 * 1024 * 1024:
            fail("Graphify output exceeds bounds")
        files.append(relative)
        digests[relative] = hashlib.sha256(path.read_bytes()).hexdigest()
    if not {"GRAPH_REPORT.md", "manifest.json"} <= set(files):
        fail("Graphify output lacks its report or manifest")
    return files, digests


def run_graphify_adapter(adapter, cwd, output, selection, mode, timeout):
    environment = {name: value for name, value in os.environ.items()
                   if not re.search(r"(?:TOKEN|SECRET|PASSWORD|API_KEY|ACCESS_KEY|PRIVATE_KEY|CREDENTIAL)",
                                    name, re.I)}
    environment.update({"DBSCTR_GRAPHIFY_MODE": mode,
                        "DBSCTR_GRAPHIFY_VERSION": selection["version"]})
    if mode == "finalize":
        environment["DBSCTR_GRAPHIFY_TRANSACTION"] = "controller"
    descriptor = os.open(adapter, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    try:
        details = os.fstat(descriptor)
        content = os.read(descriptor, details.st_size + 1)
    finally:
        os.close(descriptor)
    if (stat.S_IFMT(details.st_mode) != stat.S_IFREG or len(content) != details.st_size
            or hashlib.sha256(content).hexdigest() != selection["adapter_sha256"]):
        fail("managed Graphify adapter identity changed")
    with tempfile.TemporaryDirectory(prefix="dbsctr-managed-graphify-") as private:
        executable = Path(private) / "adapter"
        executable.write_bytes(content)
        executable.chmod(0o700)
        return run_graphify_process(executable, cwd, output, environment, timeout)


def run_graphify_process(adapter, cwd, output, environment, timeout):
    with tempfile.TemporaryFile() as stdout, tempfile.TemporaryFile() as stderr:
        process = subprocess.Popen(
            [str(adapter), "--output-dir", str(output)], cwd=cwd, env=environment,
            stdin=subprocess.DEVNULL, stdout=stdout, stderr=stderr, start_new_session=True,
        )
        try:
            process.wait(timeout=timeout)
        except subprocess.TimeoutExpired:
            os.killpg(process.pid, signal.SIGTERM)
            try:
                process.wait(timeout=2)
            except subprocess.TimeoutExpired:
                os.killpg(process.pid, signal.SIGKILL)
                process.wait()
            fail("Graphify adapter timed out")
        stdout.seek(0)
        stderr.seek(0)
        output_text = stdout.read(4097)
        error_text = stderr.read(2001)
    if len(output_text) > 4096 or len(error_text) > 2000:
        fail("Graphify adapter output exceeds bounds")
    return subprocess.CompletedProcess(
        [str(adapter), "--output-dir", str(output)], process.returncode,
        output_text.decode(errors="replace"), error_text.decode(errors="replace"),
    )


def valid_graphify_check_receipt(value, record, head):
    keys = {"schema_version", "command_contract", "invocation_id", "cycle_id", "head",
            "profile", "adapter", "output_files", "output_sha256", "manifest_sha256",
            "cache", "checked_at"}
    files, digests, cache = value.get("output_files"), value.get("output_sha256"), value.get("cache")
    return (set(value) == keys and value.get("schema_version") == 1
            and value.get("command_contract") == "dbsctr-graphify-check-v1"
            and isinstance(value.get("invocation_id"), str)
            and re.fullmatch(r"[0-9a-f]{32}", value["invocation_id"])
            and value.get("cycle_id") == record["cycle_id"] and value.get("head") == head
            and value.get("profile") == record["engineering_profile"]
            and value.get("adapter") == record["applicability_plan"]["graphify"]
            and isinstance(files, list) and files == sorted(set(files))
            and {"GRAPH_REPORT.md", "manifest.json"} <= set(files)
            and isinstance(digests, dict) and sorted(digests) == files
            and all(re.fullmatch(r"[0-9a-f]{64}", digest or "") for digest in digests.values())
            and value.get("manifest_sha256") == digests.get("manifest.json")
            and isinstance(cache, dict) and set(cache) == {"hits", "misses"}
            and all(type(item) is int and item >= 0 for item in cache.values())
            and isinstance(value.get("checked_at"), str) and value["checked_at"])


def require_graphify_check(root, record):
    selection = record.get("applicability_plan", {}).get("graphify")
    if selection is None:
        return
    binding = record.get("graphify_check")
    head = git(root, "rev-parse", "HEAD").stdout.strip()
    if not isinstance(binding, dict) or binding.get("head") != head:
        fail("Graphify check is missing or stale")
    receipt = graphify_receipt_path(root, record["cycle_id"])
    if binding.get("receipt") != receipt.relative_to(cycle_dir(root)).as_posix():
        fail("Graphify check receipt path is invalid")
    try:
        details = receipt.lstat()
        raw = receipt.read_bytes()
        value = json.loads(raw, object_pairs_hook=no_duplicate_keys)
    except (OSError, json.JSONDecodeError):
        fail("Graphify check receipt is missing or invalid")
    if (stat.S_IFMT(details.st_mode) != stat.S_IFREG or details.st_uid != os.getuid()
            or receipt.is_symlink() or details.st_mode & 0o077
            or hashlib.sha256(raw).hexdigest() != binding.get("receipt_sha256")
            or not valid_graphify_check_receipt(value, record, head)):
        fail("Graphify check receipt identity is invalid")


def command_graphify_check(args):
    root = root_dir()
    path, record = load(root)
    require_active(record)
    require_current_profile(root, record)
    selection = record.get("applicability_plan", {}).get("graphify")
    if selection is None:
        fail("Graphify is not selected by the applicability plan")
    head = git(root, "rev-parse", "HEAD").stdout.strip()
    parent = Path(tempfile.mkdtemp(prefix="dbsctr-graphify-check-"))
    worktree, output = parent / "worktree", parent / "output"
    added = False
    try:
        git(root, "worktree", "add", "--detach", str(worktree), head)
        added = True
        selection = validate_graphify_selection(root, selection)
        adapter = archived_graphify_adapter(root, selection["adapter_sha256"])
        result = run_graphify_adapter(adapter, worktree, output, selection, "check", args.timeout)
        if result.returncode:
            fail(result.stderr[-2000:].strip() or "Graphify check failed")
        if len(result.stdout.encode()) > 4096:
            fail("Graphify check summary exceeds bounds")
        try:
            summary = json.loads(result.stdout or "{}", object_pairs_hook=no_duplicate_keys)
            manifest = json.loads((output / "manifest.json").read_text(encoding="utf-8"),
                                  object_pairs_hook=no_duplicate_keys)
            report = (output / "GRAPH_REPORT.md").read_text(encoding="utf-8")
        except (OSError, json.JSONDecodeError):
            fail("Graphify check output is invalid")
        if not isinstance(manifest, dict) or f"Built from commit: `{head}`" not in report:
            fail("Graphify check output does not match current HEAD")
        cache = {"hits": summary.get("cache_hits", 0), "misses": summary.get("cache_misses", 0)}
        if any(type(value) is not int or value < 0 for value in cache.values()):
            fail("Graphify cache counters are invalid")
        files, digests = graphify_output_identity(output)
        receipt_value = {
            "schema_version": 1, "command_contract": "dbsctr-graphify-check-v1",
            "invocation_id": uuid.uuid4().hex, "cycle_id": record["cycle_id"], "head": head,
            "profile": record["engineering_profile"], "adapter": selection,
            "output_files": files, "output_sha256": digests,
            "manifest_sha256": digests["manifest.json"], "cache": cache, "checked_at": now(),
        }
        receipt = graphify_receipt_path(root, record["cycle_id"])
        private_json(receipt, receipt_value)
        raw = receipt.read_bytes()
        relative = receipt.relative_to(cycle_dir(root)).as_posix()
        record["graphify_check"] = {"head": head, "receipt": relative,
                                     "receipt_sha256": hashlib.sha256(raw).hexdigest(),
                                     "checked_at": receipt_value["checked_at"]}
        save(path, record)
    finally:
        had_error = sys.exc_info()[0] is not None
        cleanup_error = None
        if added:
            removed = git(root, "worktree", "remove", "--force", str(worktree), check=False)
            if removed.returncode:
                cleanup_error = removed.stderr.strip() or "cannot remove disposable Graphify worktree"
        shutil.rmtree(parent)
        if cleanup_error and not had_error:
            fail(cleanup_error)
    print(json.dumps({"head": head, "receipt": relative, "cache": cache},
                     sort_keys=True, separators=(",", ":")))


def command_approve_exception(args):
    root = root_dir()
    path, record = load(root)
    require_active(record)
    gate = record["gates"][args.gate]
    if gate["applicability"] != "required" or gate["result"] not in ("failed", "unavailable"):
        fail("only a failed or unavailable required gate can receive an exception")
    gate["exception"] = {
        "kind": args.kind, "rationale": args.rationale, "owner": args.owner,
        "review_condition": args.review_condition, "approved_at": now(),
    }
    save(path, record)


def command_record_dvc_push(args):
    root = root_dir()
    path, record = load(root)
    require_active(record)
    if not ((root / ".dvc").exists() or (root / "dvc.yaml").exists()):
        fail("repository does not use DVC")
    head = git(root, "rev-parse", "HEAD").stdout.strip()
    if args.head != head:
        fail("DVC push evidence must match current HEAD")
    if args.declaration:
        try:
            record_declared_dvc_preservation(root, path, record, args)
        except (OSError, ValueError, TypeError, KeyError, subprocess.SubprocessError):
            fail("preservation_evidence_unavailable")
        return
    if args.upload or args.remote:
        fail("targeted preservation requires an explicit declaration and remote")
    record["dvc_push"] = {"head": head, "evidence": args.evidence, "recorded_at": now()}
    save(path, record)


def preservation_policy_snapshot(root):
    """Consume only the selected generated policy; declarations never grant consent."""
    try:
        return _preservation_policy_snapshot(root)
    except (OSError, ValueError, TypeError, KeyError, subprocess.SubprocessError):
        fail("preservation_policy_unavailable")


def _preservation_policy_snapshot(root, section="preservation", validator_timeout=None):
    config = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    source = config / "dotfiles-ai/workflow-policy.json"
    if not os.path.lexists(source):
        return None
    safe_directory(config, source.parent)
    continuation_private(source)
    if source.stat().st_size > 256 * 1024:
        fail("preservation_policy_invalid")
    with source.open("rb") as stream:
        raw = stream.read(256 * 1024 + 1)
    if len(raw) > 256 * 1024:
        fail("preservation_policy_invalid")
    helper = Path.home() / ".local/bin/workflow-policy"
    item = helper.lstat()
    if (not stat.S_ISREG(item.st_mode) or item.st_uid != os.getuid()
            or item.st_nlink != 1 or item.st_mode & 0o022):
        fail("preservation_policy_invalid")
    if validator_timeout is None:
        output = removal_run(root, [str(helper), "check"])
    else:
        checked_process = subprocess.run([str(helper), "check"], cwd=root, env=INSPECT_ENV,
            stdin=subprocess.DEVNULL, text=True, capture_output=True, timeout=validator_timeout)
        if checked_process.returncode or checked_process.stderr or len(checked_process.stdout) > 256:
            fail("preservation_policy_unavailable")
        output = checked_process.stdout
    checked = json.loads(output, object_pairs_hook=no_duplicate_keys)
    if checked != {"status": "passed"}:
        fail("preservation_policy_unavailable")
    continuation_private(source)
    with source.open("rb") as stream:
        after = stream.read(256 * 1024 + 1)
    if after != raw:
        fail("preservation_policy_changed_during_validation")
    policy = json.loads(raw, object_pairs_hook=no_duplicate_keys)
    digest = hashlib.sha256(json.dumps({k: v for k, v in policy.items() if k != "policy_digest"},
        sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode()).hexdigest()
    if policy.get("policy_digest") != digest:
        fail("preservation_policy_invalid")
    common = common_git_dir(root).resolve()
    entries = [entry for entry in policy["repositories"]
               if (Path(entry["repository"]) / ".git").resolve() == common]
    if len(entries) > 1:
        fail("preservation_policy_invalid")
    if section is None:
        return {"schema_version": 1, "policy_digest": digest, "repository": str(common),
                "release_commit": policy["source_commit"], "consent": entries[0] if entries else {}}
    consent = entries[0].get(section) if entries else None
    if consent is None:
        return None
    if type(consent.get("schema_version")) is not int or consent["schema_version"] != 1:
        fail("preservation_policy_invalid")
    return {"schema_version": 1, "policy_digest": digest, "repository": str(common), "consent": consent}


def preservation_committed_bytes(root, head, name):
    path = removal_path(root, name)
    entry = removal_run(root, ["git", "ls-tree", "-z", head, "--", name]).rstrip("\0").split("\t")
    if len(entry) != 2 or entry[1] != name or not entry[0].startswith("100644 blob "):
        fail("preservation_metadata_unavailable")
    if path.is_symlink() or not path.is_file() or path.stat().st_size > 65536:
        fail("preservation_metadata_unavailable")
    raw = removal_run(root, ["git", "show", f"{head}:{name}"]).encode()
    if raw != path.read_bytes():
        fail("preservation_metadata_changed")
    return raw


def preservation_declaration(root, head, name):
    raw = preservation_committed_bytes(root, head, name)
    value = json.loads(raw, object_pairs_hook=no_duplicate_keys)
    if (not isinstance(value, dict) or set(value) != {"schema_version", "targets"}
            or type(value["schema_version"]) is not int or value["schema_version"] != 1
            or not isinstance(value["targets"], list) or not 1 <= len(value["targets"]) <= 64):
        fail("preservation_declaration_invalid")
    outputs, seen = [], set()
    for target in value["targets"]:
        if not isinstance(target, str) or not target.endswith(".dvc") or target in seen:
            fail("preservation_declaration_invalid")
        seen.add(target)
        metadata = preservation_committed_bytes(root, head, target)
        lines = metadata.decode().splitlines()
        fields = {}
        if not lines or lines[0] != "outs:":
            fail("preservation_metadata_format_unsupported")
        # Deliberately accept only canonical single-output .dvc scalars. Never guess YAML.
        for index, line in enumerate(lines[1:]):
            match = re.fullmatch(r"(?:- |  )(md5|size|hash|path|nfiles): (.+)", line)
            if not match or match[1] in fields or (index == 0) != line.startswith("- "):
                fail("preservation_metadata_format_unsupported")
            fields[match[1]] = match[2]
        if (not {"md5", "size", "hash", "path"} <= fields.keys() or fields["hash"] != "md5"
                or not re.fullmatch(r"[0-9a-f]{32}(?:\.dir)?", fields["md5"])
                or not re.fullmatch(r"0|[1-9][0-9]{0,18}", fields["size"])
                or not re.fullmatch(r"[A-Za-z0-9_.][A-Za-z0-9_./ -]{0,1023}", fields["path"])):
            fail("preservation_metadata_format_unsupported")
        relative = str(PurePosixPath(target).parent / fields["path"])
        removal_path(root, relative)
        directory = fields["md5"].endswith(".dir")
        if directory != ("nfiles" in fields) or directory and not re.fullmatch(r"[0-9]{1,10}", fields["nfiles"]):
            fail("preservation_metadata_format_unsupported")
        if any(output["path"] == relative for output in outputs):
            fail("preservation_declaration_invalid")
        outputs.append({"target": target, "path": relative, "algorithm": "md5", "object_id": fields["md5"],
                        "kind": "directory" if directory else "file", "metadata_sha256": hashlib.sha256(metadata).hexdigest(),
                        "closure": None if directory else [{"algorithm": "md5", "object_id": fields["md5"]}]})
    return hashlib.sha256(raw).hexdigest(), outputs


def preservation_destination(root, remote):
    try:
        return _preservation_destination(root, remote)
    except (OSError, ValueError, TypeError, KeyError, subprocess.SubprocessError):
        fail("preservation_destination_unavailable")


def _preservation_destination(root, remote):
    if not isinstance(remote, str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,127}", remote):
        fail("preservation_remote_invalid")
    endpoint = removal_run(root, ["dvc", "config", f"remote.{remote}.url"]).strip()
    destination = Path(endpoint)
    if (not destination.is_absolute() or "://" in endpoint or ".." in destination.parts
            or any(p.is_symlink() for p in (destination, *destination.parents))):
        fail("preservation_backend_unsupported")
    destination = destination.resolve()
    item = destination.stat()
    if not destination.is_dir() or item.st_uid != os.getuid() or item.st_mode & 0o022:
        fail("preservation_destination_unavailable")
    for row in git_worktrees(root):
        checkout = Path(row["worktree"]).resolve()
        if path_within(destination, checkout) or path_within(checkout, destination):
            fail("preservation_destination_unsafe")
    identity = {"backend": "local", "remote": remote, "path": str(destination),
                "device": item.st_dev, "inode": item.st_ino}
    return identity, continuation_digest(identity)


def preservation_runtime(root):
    if any(key.startswith("DVC_") and key != "DVC_NO_ANALYTICS" for key in INSPECT_ENV):
        fail("preservation_environment_unsupported")
    version = removal_run(root, ["dvc", "--version"]).strip()
    doctor = removal_run(root, ["dvc", "doctor"])
    data = re.search(r"^\s*dvc_data = ([0-9.]+)\s*$", doctor, re.M)
    if version != "3.67.1" or not data or data[1] != "3.18.3":
        fail("preservation_runtime_unqualified")
    return {"dvc": version, "dvc_data": data[1], "object_format": "files/md5"}


def preservation_snapshot_matches(root, head, declaration, digest, outputs, remote, destination, policy, runtime):
    try:
        if (git(root, "rev-parse", "HEAD").stdout.strip() != head or status_paths(root)
                or preservation_policy_snapshot(root) != policy
                or preservation_declaration(root, head, declaration) != (digest, outputs)
                or preservation_destination(root, remote)[1] != destination
                or preservation_runtime(root) != runtime):
            return False
        removal_dvc_paths(root, json.loads(removal_run(root, ["dvc", "data", "status", "--unchanged", "--json"]),
                                          object_pairs_hook=no_duplicate_keys))
        return True
    except (RuntimeError, OSError, ValueError, TypeError, KeyError, subprocess.SubprocessError):
        return False


def preservation_remote_observation(root, outputs, remote):
    if any(output["kind"] == "directory" for output in outputs):
        return {"status": "unavailable", "reasons": ["remote_directory_closure_unverified"],
                "observed_at": now(), "objects": []}
    try:
        value = json.loads(removal_run(root, ["dvc", "status", "--cloud", "--json", "-r", remote,
                                            *[output["target"] for output in outputs]]), object_pairs_hook=no_duplicate_keys)
        if value != {}:
            fail("remote_objects_not_verified")
    except (RuntimeError, OSError, ValueError, subprocess.SubprocessError):
        return {"status": "unavailable", "reasons": ["remote_objects_not_verified"],
                "observed_at": now(), "objects": []}
    return {"status": "verified", "reasons": [], "observed_at": now(),
            "objects": [{"algorithm": o["algorithm"], "object_id": o["object_id"]} for o in outputs]}


def record_declared_dvc_preservation(root, record_path, record, args):
    head = git(root, "rev-parse", "HEAD").stdout.strip()
    if status_paths(root):
        fail("preservation_requires_clean_metadata_and_code")
    policy = preservation_policy_snapshot(root)
    if policy is None or record.get("preservation_policy") != policy:
        fail("preservation_consent_absent_or_changed")
    declaration_digest, outputs = preservation_declaration(root, head, args.declaration)
    runtime = preservation_runtime(root)
    destination, destination_digest = preservation_destination(root, args.remote)
    expected = {"declaration_path": args.declaration, "declaration_sha256": declaration_digest,
                "remote": args.remote, "destination_sha256": destination_digest}
    if expected not in policy["consent"].get("uploads", []):
        fail("preservation_scope_or_destination_not_approved")
    status = json.loads(removal_run(root, ["dvc", "data", "status", "--unchanged", "--json"]), object_pairs_hook=no_duplicate_keys)
    try:
        removal_dvc_paths(root, status)
    except RuntimeError:
        if args.upload or not any(o["kind"] == "directory" for o in outputs):
            raise
        # A read-only unsupported-directory observation can retain cold-cache
        # uncertainty; it never authorizes upload or verified preservation.
    # Capture before any external write. A later mismatch retains evidence and work.
    manifest = {"schema_version": 1, "repository": str(common_git_dir(root).resolve()), "head": head,
                "declaration": expected, "outputs": outputs, "runtime": runtime,
                "destination": destination, "policy_digest": policy["policy_digest"],
                "upload": {"status": "not_run"}, "verification": None}
    directory = cycle_dir(root) / "preservation" / record["cycle_id"]
    managed_directory(root, directory, create=True)
    attempt = directory / f"{uuid.uuid4().hex}.json"
    preservation_save_attempt(root, attempt, manifest)
    if args.upload:
        if not preservation_snapshot_matches(root, head, args.declaration, declaration_digest, outputs,
                                             args.remote, destination_digest, policy, runtime):
            fail("preservation_snapshot_changed")
        manifest["upload"] = {"status": "started", "observed_at": now()}
        preservation_save_attempt(root, attempt, manifest)
        try:
            removal_run(root, ["dvc", "push", "-r", args.remote, *[o["target"] for o in outputs]])
            manifest["upload"] = {"status": "succeeded", "observed_at": now()}
            preservation_save_attempt(root, attempt, manifest)
        except (RuntimeError, OSError, subprocess.SubprocessError):
            manifest["upload"] = {"status": "unknown", "observed_at": now()}
            preservation_save_attempt(root, attempt, manifest)
            fail("preservation_upload_outcome_unavailable")
    manifest["verification"] = preservation_remote_observation(root, outputs, args.remote)
    if not preservation_snapshot_matches(root, head, args.declaration, declaration_digest, outputs,
                                         args.remote, destination_digest, policy, runtime):
        reasons = manifest["verification"]["reasons"] + ["preservation_snapshot_changed"]
        manifest["verification"] = {"status": "unavailable", "reasons": reasons,
                                    "observed_at": now(), "objects": []}
    manifest["manifest_digest"] = continuation_digest(manifest)
    preservation_save_attempt(root, attempt, manifest)
    record["dvc_preservation"] = {"path": str(attempt.relative_to(cycle_dir(root))),
                                  "digest": manifest["manifest_digest"], "head": head}
    if manifest["upload"]["status"] == "succeeded":
        record["dvc_push"] = {"head": head, "evidence": "targeted_declared_upload", "recorded_at": now()}
    save(record_path, record)
    if manifest["verification"]["status"] != "verified":
        fail(manifest["verification"]["reasons"][0])


def preservation_save_attempt(root, path, manifest):
    boundary = cycle_dir(root).resolve()
    if not path_within(path.parent, boundary):
        fail("preservation_evidence_unavailable")
    try:
        private_json(path, manifest)
        directory = path.parent.resolve()
        while True:
            fsync_directory(directory)
            if directory == boundary:
                break
            directory = directory.parent
    except OSError:
        fail("preservation_durability_unavailable")


def verified_preservation_outputs(root, records, paths):
    """Requery exact file objects; neither legacy push text nor cached status is proof."""
    if not records or len(records) > 64:
        return False
    head = git(root, "rev-parse", "HEAD").stdout.strip()
    for record in records:
        try:
            reference = record["dvc_preservation"]
            if not isinstance(reference, dict) or set(reference) != {"path", "digest", "head"}:
                continue
            name = reference["path"]
            prefix = f"preservation/{record['cycle_id']}/"
            if (not isinstance(name, str) or not name.startswith(prefix)
                    or not re.fullmatch(r"[0-9a-f]{32}\.json", name[len(prefix):])
                    or reference["head"] != head):
                continue
            path = cycle_dir(root) / name
            safe_directory(cycle_dir(root), path.parent)
            continuation_private(path)
            if path.stat().st_size > 256 * 1024:
                continue
            value = json.loads(path.read_text(), object_pairs_hook=no_duplicate_keys)
            if (not isinstance(value, dict) or set(value) != {"schema_version", "repository", "head", "declaration",
                    "outputs", "runtime", "destination", "policy_digest", "upload", "verification", "manifest_digest"}
                    or type(value["schema_version"]) is not int or value["schema_version"] != 1
                    or value["manifest_digest"] != reference["digest"]
                    or value["manifest_digest"] != continuation_digest({k: v for k, v in value.items() if k != "manifest_digest"})
                    or value["head"] != head or value["repository"] != str(common_git_dir(root).resolve())
                    or not preservation_manifest_observations(value)):
                continue
            policy = preservation_policy_snapshot(root)
            if policy is None or record.get("preservation_policy") != policy or policy["policy_digest"] != value["policy_digest"]:
                continue
            declaration = value["declaration"]
            if declaration not in policy["consent"].get("uploads", []):
                continue
            if any(o["kind"] != "file" for o in value["outputs"]):
                continue
            if not set(paths) <= {removal_path(root, o["path"]) for o in value["outputs"]}:
                continue
            remote = declaration["remote"]
            if (preservation_destination(root, remote)[0] != value["destination"]
                    or not preservation_snapshot_matches(root, head, declaration["declaration_path"],
                        declaration["declaration_sha256"], value["outputs"], remote,
                        declaration["destination_sha256"], policy, value["runtime"])):
                continue
            if preservation_remote_observation(root, value["outputs"], remote)["status"] != "verified":
                continue
            if preservation_snapshot_matches(root, head, declaration["declaration_path"], declaration["declaration_sha256"],
                                             value["outputs"], remote, declaration["destination_sha256"], policy, value["runtime"]):
                return True
        except (RuntimeError, OSError, ValueError, TypeError, KeyError, subprocess.SubprocessError):
            continue
    return False


def preservation_manifest_observations(value):
    """Strict nested observation shapes; a digest does not validate a schema."""
    try:
        upload, verification = value["upload"], value["verification"]
        if not isinstance(upload, dict) or not isinstance(verification, dict):
            return False
        status = upload.get("status")
        if status == "not_run":
            if set(upload) != {"status"}:
                return False
        elif status == "succeeded":
            if set(upload) != {"status", "observed_at"}:
                return False
            stamp = datetime.fromisoformat(upload["observed_at"].replace("Z", "+00:00"))
            if stamp.utcoffset() != timedelta(0):
                return False
        else:
            return False  # Started/unknown attempts cannot qualify preservation.
        if (set(verification) != {"status", "observed_at", "reasons", "objects"}
                or verification["status"] != "verified" or verification["reasons"] != []
                or not isinstance(value["outputs"], list) or not 1 <= len(value["outputs"]) <= 64
                or any(o["kind"] != "file" for o in value["outputs"])
                or verification["objects"] != [{"algorithm": o["algorithm"], "object_id": o["object_id"]}
                                               for o in value["outputs"]]):
            return False
        stamp = datetime.fromisoformat(verification["observed_at"].replace("Z", "+00:00"))
        return stamp.utcoffset() == timedelta(0)
    except (ValueError, TypeError, KeyError, AttributeError):
        return False


def verified_upstream_template(root, name):
    """Admit only unchanged regular template bytes from the cycle's recorded target."""
    if name != ".env.template":
        return False
    try:
        _, record = load(root)
        require_active(record)
        baseline = record["git"]
        target_ref = baseline["upstream"]
        if (not target_ref or upstream(root) != target_ref
                or baseline.get("remote") != remote_destination(root, target_ref)):
            return False
        remote, remote_branch = remote_for_upstream(root, target_ref)
        if not remote or not remote_branch:
            return False
        target = git(root, "rev-parse", "--verify", target_ref + "^{commit}").stdout.strip()
        if git(root, "merge-base", "--is-ancestor", baseline["head"], target, check=False).returncode:
            return False
        pending = git(root, "rev-parse", "--verify", "-q", "MERGE_HEAD", check=False)
        if pending.returncode == 0 and pending.stdout.strip() != target:
            return False
        entry = git(root, "ls-tree", "-z", target, "--", name).stdout
        fields = entry.rstrip("\0").split("\t")
        if len(fields) != 2 or fields[1] != name:
            return False
        mode, kind, blob = fields[0].split()
        if mode not in ("100644", "100755") or kind != "blob":
            return False
        index = git(root, "ls-files", "--stage", "-z", "--", name).stdout
        if index != f"{mode} {blob} 0\t{name}\0":
            return False
        path = root / name
        if path.is_symlink() or not path.is_file():
            return False
        return git(root, "hash-object", "--no-filters", "--", name).stdout.strip() == blob
    except (RuntimeError, OSError, ValueError, TypeError, KeyError):
        return False


def safe_paths(root, paths):
    if not paths:
        fail("at least one path is required")
    cleaned = []
    for name in paths:
        pure = PurePosixPath(name)
        if pure.is_absolute() or ".." in pure.parts or name.startswith(".") and name == ".":
            fail(f"path must be repo-relative: {name}")
        basename = pure.name.lower()
        if basename == ".env" or basename.startswith(".env.") or basename in SECRET_NAMES or pure.suffix.lower() in (".key", ".pem"):
            if not verified_upstream_template(root, name):
                fail(f"refusing possible secret path: {name}")
        tracked = git(root, "ls-files", "--error-unmatch", "--", name, check=False).returncode == 0
        if not (root / pure).is_file() and not tracked:
            fail(f"path does not exist: {name}")
        if git(root, "check-ignore", "--quiet", "--", name, check=False).returncode == 0:
            fail(f"path is ignored: {name}")
        cleaned.append(name)
    return cleaned


def command_gate_commit(args):
    root = root_dir()
    path, record = load(root)
    require_active(record)
    require_current_profile(root, record)
    schema3_items = []
    for name in args.gates:
        gate = record["gates"][name]
        complete = gate["applicability"] == "not_applicable" or gate["result"] == "passed" or "exception" in gate
        if not complete:
            fail(f"gate is not complete: {name}")
        if record.get("schema_version") in (3, 4, 5, 6) and gate["result"] in ("passed", "failed", "unavailable"):
            item = verify_envelope(root, record, name)
            if set(item.get("paths", {})) != set(args.paths):
                fail(f"evidence paths differ from commit paths: {name}")
            if evidence_path_blobs(root, args.paths) != item["paths"]:
                fail(f"evidence paths changed after validation: {name}")
            schema3_items.append((name, item))
    paths = safe_paths(root, args.paths)
    staged = git(root, "diff", "--cached", "--name-only").stdout.splitlines()
    if staged and set(staged) != set(paths):
        fail("unrelated staged paths present: " + ", ".join(staged))
    if git(root, "diff", "--check", check=False).returncode:
        fail("git diff --check failed")
    git(root, "add", "--", *paths)
    for name, item in schema3_items:
        if evidence_path_blobs(root, args.paths, index=True) != item["paths"]:
            fail(f"staged paths differ from evidence: {name}")
    if git(root, "diff", "--cached", "--check", check=False).returncode:
        fail("staged git diff --check failed")
    staged = git(root, "diff", "--cached", "--name-only").stdout.splitlines()
    if set(staged) != set(paths):
        fail("staged paths differ from requested paths")
    if not staged or not git(root, "diff", "--cached", "--quiet", check=False).returncode:
        fail("staged diff is empty")
    git(root, "commit", "-m", args.message)
    commit = git(root, "rev-parse", "HEAD").stdout.strip()
    if record.get("schema_version") in (3, 4, 5, 6):
        for name, item in schema3_items:
            if evidence_path_blobs(root, args.paths, commit=commit) != item["paths"]:
                fail(f"committed paths differ from evidence: {name}")
        for name in args.gates:
            gate = record["gates"][name]
            if gate.get("evidence"):
                record["evidence"]["items"][gate["evidence"]]["commit"] = commit
    record["commits"].append({"id": commit, "gates": args.gates})
    amendment_checkpoint(root, record, commit)
    save(path, record)
    print(commit)
    return {"worktree": root.resolve(), "cycle": record["cycle_id"], "head": commit, "gates": list(args.gates)}


def optional_shadow_checkpoint(checkpoint):
    """Bounded optional enqueue after lifecycle locks; missing binding is inert."""
    registry = Path.home() / ".local/state/dotfiles-ai/continuous-validation/checkpoint-bindings"
    if not os.path.lexists(registry):
        return
    try:
        def private_record(path, maximum):
            if (not path.is_absolute() or ".." in path.parts
                    or any(parent.is_symlink() for parent in (path, *path.parents))):
                raise ValueError("unsafe checkpoint record")
            descriptor = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW)
            with os.fdopen(descriptor, "rb") as stream:
                item = os.fstat(stream.fileno())
                if (not stat.S_ISREG(item.st_mode) or item.st_uid != os.getuid()
                        or item.st_mode & 0o077 or item.st_nlink != 1 or item.st_size > maximum):
                    raise ValueError("unsafe checkpoint record")
                raw = stream.read(maximum + 1)
                if len(raw) > maximum:
                    raise ValueError("unsafe checkpoint record")
                return json.loads(raw, object_pairs_hook=no_duplicate_keys)

        root = checkpoint["worktree"]
        metadata = subprocess.run(["git", "-C", str(root), "rev-parse", "--path-format=absolute", "--git-common-dir"],
                                  capture_output=True, text=True, timeout=1,
                                  env={**GIT_REPOSITORY_ENV, "GIT_OPTIONAL_LOCKS": "0"})
        if metadata.returncode:
            raise RuntimeError("checkpoint repository unavailable")
        repository = hashlib.sha256(os.fsencode(Path(metadata.stdout.strip()).resolve())).hexdigest()
        worktree_id = hashlib.sha256(os.fsencode(root)).hexdigest()
        binding = registry / repository / worktree_id / (checkpoint["cycle"] + ".json")
        if not os.path.lexists(binding):
            return
        record = private_record(binding, 32 * 1024)
        if (record.get("repository_id") != repository or record.get("worktree") != str(root)
                or record.get("cycle_id") != checkpoint["cycle"]):
            raise ValueError("checkpoint binding changed")
        enrollment = private_record(Path(record["enrollment"]), 8 * 1024 * 1024)
        if enrollment.get("enabled") is not True or enrollment.get("checkpoints_enabled") is not True:
            return
        digest = hashlib.sha256(json.dumps(enrollment, sort_keys=True, separators=(",", ":"),
                                          ensure_ascii=True, allow_nan=False).encode()).hexdigest()
        if record.get("enrollment_digest") != digest:
            return
        source = Path(__file__).resolve().parents[2] / "private_dot_config/dotfiles-ai"
        installed = Path.home() / ".config/dotfiles-ai"
        package = source if (source / "continuous_validation").is_dir() else installed
        if not (package / "continuous_validation/checkpoints.py").is_file():
            raise RuntimeError("checkpoint owner unavailable")
        sys.path.insert(0, str(package))
        from continuous_validation.checkpoints import enqueue_gate_commit
        enqueue_gate_commit(root, checkpoint["cycle"], checkpoint["head"], checkpoint["gates"])
    except Exception:
        # Optional diagnostics never replace a completed native lifecycle outcome.
        print("continuous_validation_checkpoint_unavailable", file=sys.stderr)


def command_check(args):
    root = root_dir()
    _, record = load(root)
    if args.subject == "artifacts":
        artifact_check(record)
    elif args.subject == "pr-review":
        check_pr_review(root, record, args.recommendations, prior_source=args.prior_recommendations,
                        merge_commit=args.merge_commit, repair_check=args.repair_check, ci_source=args.ci_evidence)


def ci_text(value, maximum=512):
    if (not isinstance(value, str) or not 1 <= len(value.encode()) <= maximum
            or any(ord(c) < 32 or ord(c) == 127 for c in value)):
        fail("ci_text_invalid")
    return value


def ci_path(value, *, pattern=False):
    ci_text(value)
    parts = value.split("/")
    if (any(p in ("", ".", "..", ".dbsctr") for p in parts)
            or any(c in value for c in "\\!{}[]")
            or any("**" in p and p != "**" for p in parts)
            or not pattern and any(c in value for c in "*?")):
        fail("ci_path_invalid")
    return value


def ci_id(value):
    if not isinstance(value, str) or not re.fullmatch(r"[a-z][a-z0-9-]{0,63}", value):
        fail("ci_id_invalid")
    return value


def ci_positive(value):
    if type(value) is not int or not 1 <= value < 2**53:
        fail("ci_integer_invalid")
    return value


def ci_digest(value):
    if not isinstance(value, str) or not re.fullmatch(r"[0-9a-f]{64}", value):
        fail("ci_digest_invalid")
    return value


def ci_unique(values, minimum, maximum, validator):
    if not isinstance(values, list) or not minimum <= len(values) <= maximum:
        fail("ci_array_invalid")
    checked = [validator(v) for v in values]
    if len(set(checked)) != len(checked):
        fail("ci_duplicate")
    return checked


def validate_ci_mapping(value):
    initiative_fields(value, {"schema_version", "components", "dependencies", "checks", "broad_check_ids"}, "CI mapping")
    if type(value["schema_version"]) is not int or value["schema_version"] != 1:
        fail("ci_schema_invalid")
    def check(item):
        initiative_fields(item, {"id", "workflow_file", "job_name", "provider_repository", "definition_digest",
                                 "github_app_id", "mandatory"}, "CI check")
        path = ci_path(item["workflow_file"])
        if not path.startswith(".github/workflows/") or path.count("/") != 2:
            fail("ci_workflow_invalid")
        ci_text(item["job_name"], 256)
        if not isinstance(item["provider_repository"], str) or not re.fullmatch(
                r"[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*", item["provider_repository"]):
            fail("ci_provider_invalid")
        ci_text(item["provider_repository"], 256)
        ci_digest(item["definition_digest"]); ci_positive(item["github_app_id"])
        if type(item["mandatory"]) is not bool:
            fail("ci_mandatory_invalid")
        return ci_id(item["id"])
    checks = ci_unique(value["checks"], 1, 512, check)
    producers = [(v["workflow_file"], v["job_name"], v["provider_repository"], v["github_app_id"])
                 for v in value["checks"]]
    if len(set(producers)) != len(producers):
        fail("ci_ambiguous_producer")
    def component(item):
        initiative_fields(item, {"id", "owned_path_patterns", "check_ids"}, "CI component")
        ci_unique(item["owned_path_patterns"], 1, 128, lambda p: ci_path(p, pattern=True))
        if not set(ci_unique(item["check_ids"], 1, 512, ci_id)) <= set(checks):
            fail("ci_reference_invalid")
        return ci_id(item["id"])
    components = ci_unique(value["components"], 1, 1024, component)
    def dependency(item):
        initiative_fields(item, {"consumer", "dependency"}, "CI dependency")
        pair = (ci_id(item["consumer"]), ci_id(item["dependency"]))
        if not set(pair) <= set(components):
            fail("ci_reference_invalid")
        return pair
    ci_unique(value["dependencies"], 0, 8192, dependency)
    if not set(ci_unique(value["broad_check_ids"], 1, 512, ci_id)) <= set(checks):
        fail("ci_reference_invalid")
    return value


def ci_path_matches(pattern, path):
    # Segment DP avoids regex backtracking and permits zero-segment **.
    pieces = path.split("/")
    positions = {0}
    for segment in pattern.split("/"):
        if segment == "**":
            positions = set(range(min(positions), len(pieces) + 1)) if positions else set()
        else:
            positions = {i + 1 for i in positions if i < len(pieces) and fnmatch.fnmatchcase(pieces[i], segment)}
    return len(pieces) in positions


def ci_affected_checks(mapping, paths):
    return _ci_affected_checks(validate_ci_mapping(mapping), paths)


def _ci_affected_checks(mapping, paths):
    ci_unique(paths, 0, 16384, ci_path)
    affected, broad = set(), set()
    for path in paths:
        owners = {v["id"] for v in mapping["components"]
                  if any(ci_path_matches(p, path) for p in v["owned_path_patterns"])}
        if not owners or path.startswith(".github/"):
            broad.update(mapping["broad_check_ids"])
        affected.update(owners)
    consumers = {}
    for edge in mapping["dependencies"]:
        consumers.setdefault(edge["dependency"], set()).add(edge["consumer"])
    pending = list(affected)
    while pending:
        for consumer in consumers.get(pending.pop(), ()):
            if consumer not in affected:
                affected.add(consumer); pending.append(consumer)
    return sorted(broad | {check for v in mapping["components"] if v["id"] in affected for check in v["check_ids"]})


def validate_ci_evidence(value, mapping, head, base):
    validate_ci_mapping(mapping)
    return _validate_ci_evidence(value, {v["id"]: v for v in mapping["checks"]}, pr_review_digest(mapping), head, base)


def _validate_ci_evidence(value, checks, mapping_digest, head, base):
    fields = {"schema_version", "head", "base", "tested_oid", "tested_parents", "check_id", "definition_digest",
              "mapping_digest", "run_id", "job_id", "github_app_id", "provider_repository", "attempt",
              "observed_at", "conclusion", "toolchain_digest", "environment_digest"}
    initiative_fields(value, fields, "CI evidence")
    if type(value["schema_version"]) is not int or value["schema_version"] != 1:
        fail("ci_schema_invalid")
    for oid in (head, base, value["head"], value["base"], value["tested_oid"]):
        if not isinstance(oid, str) or not re.fullmatch(r"[0-9a-f]{40}|[0-9a-f]{64}", oid) or len(oid) != len(head):
            fail("ci_oid_invalid")
    if value["head"] != head or value["base"] != base or value["mapping_digest"] != mapping_digest:
        fail("ci_binding_changed")
    parents = value["tested_parents"]
    if (value["tested_oid"] == head and parents != []
            or value["tested_oid"] != head and parents != [base, head]):
        fail("ci_tested_parents_mismatch")
    check = checks.get(ci_id(value["check_id"]))
    if not check or any(value[k] != check[k] for k in ("definition_digest", "github_app_id", "provider_repository")):
        fail("ci_producer_mismatch")
    for key in ("run_id", "job_id", "github_app_id", "attempt"):
        ci_positive(value[key])
    for key in ("definition_digest", "mapping_digest", "toolchain_digest", "environment_digest"):
        ci_digest(value[key])
    stamp = value["observed_at"]
    if not isinstance(stamp, str) or not re.fullmatch(r"\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d(?:\.\d{1,6})?Z", stamp):
        fail("ci_time_invalid")
    try:
        datetime.fromisoformat(stamp.replace("Z", "+00:00"))
    except ValueError:
        fail("ci_time_invalid")
    ci_text(value["conclusion"], 32)
    return value  # Structural match only; never native producer authentication.


def ci_conclusion(conclusion, *, affected, allow_unrelated_pending):
    if conclusion == "success":
        return "passed"
    if conclusion in ("pending", "queued", "in_progress"):
        return "unrelated_pending" if not affected and allow_unrelated_pending is True else "pending"
    return "blocked"


def ci_git_bytes(root, *args):
    child = subprocess.Popen(["git", *args], cwd=root, env=INSPECT_ENV, stdin=subprocess.DEVNULL,
                             stdout=subprocess.PIPE, stderr=subprocess.PIPE, start_new_session=True)
    output, errors = preservation_output(child, limit=1024 * 1024, timeout=5)
    if child.returncode or errors.strip():
        fail("ci_committed_authority_unavailable")
    return output


def ci_base_blob(root, oid, path, cache):
    """Read regular committed bytes, never worktree/symlink authority or replace refs."""
    ci_path(path)
    if not isinstance(oid, str) or not re.fullmatch(r"[0-9a-f]{40}|[0-9a-f]{64}", oid):
        fail("ci_oid_invalid")
    key = (oid, path)
    if key in cache:
        return cache[key]
    def run(*args):
        return ci_git_bytes(root, *args)
    entry = run("ls-tree", "-z", oid, "--", ":(literal)" + path).split(b"\0")
    if len(entry) != 2 or not entry[0].startswith((b"100644 blob ", b"100755 blob ")):
        fail("ci_regular_authority_required")
    blob = entry[0].split(b" ", 2)[2].split(b"\t", 1)[0].decode("ascii")
    size = int(run("cat-file", "-s", blob))
    if size > 1024 * 1024 or sum(len(v) for v in cache.values()) + size > 8 * 1024 * 1024:
        fail("ci_authority_size_limit")
    raw = run("cat-file", "blob", blob)
    if len(raw) != size:
        fail("ci_authority_changed")
    cache[key] = raw
    return raw


def ci_json(raw):
    try:
        return json.loads(raw, object_pairs_hook=no_duplicate_keys)
    except (ValueError, RuntimeError, RecursionError):
        fail("ci_json_invalid")


def pr_review_private_bytes(source, limit):
    try:
        descriptor = os.open(source, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        with os.fdopen(descriptor, "rb") as stream:
            before = os.fstat(stream.fileno())
            if (not stat.S_ISREG(before.st_mode) or before.st_uid != os.getuid()
                    or stat.S_IMODE(before.st_mode) != 0o600 or before.st_nlink != 1 or before.st_size > limit):
                fail("pr_review_private_input_invalid")
            raw = stream.read(limit + 1)
            after = os.fstat(stream.fileno())
            if len(raw) > limit or any(getattr(before, key) != getattr(after, key)
                    for key in ("st_mode", "st_uid", "st_nlink", "st_size", "st_mtime_ns", "st_ctime_ns")):
                fail("pr_review_private_input_changed")
            return raw
    except OSError:
        fail("pr_review_private_input_unavailable")


def ci_review_inspection(root, values, selected, source):
    raw = pr_review_private_bytes(source, 16 * 1024 * 1024)
    evidence = ci_json(raw)
    if not isinstance(evidence, list) or len(evidence) > 16384:
        fail("ci_evidence_invalid")
    cache, prepared, summaries, consumed = {}, {}, [], set()
    for value in values:
        mapping_raw = ci_base_blob(root, value["base"], selected["mapping_path"], cache)
        if value["base"] not in prepared:
            mapping = validate_ci_mapping(ci_json(mapping_raw))
            prepared[value["base"]] = (mapping, pr_review_digest(mapping), {v["id"]: v for v in mapping["checks"]})
        mapping, mapping_digest, checks = prepared[value["base"]]
        if mapping_digest != value["mapping_digest"]:
            fail("ci_mapping_changed")
        if ci_base_blob(root, value["head"], selected["mapping_path"], cache) != mapping_raw:
            fail("ci_mapping_review_required")
        for check in mapping["checks"]:
            definition = ci_base_blob(root, value["base"], check["workflow_file"], cache)
            if hashlib.sha256(definition).hexdigest() != check["definition_digest"]:
                fail("ci_definition_changed")
            if ci_base_blob(root, value["head"], check["workflow_file"], cache) != definition:
                fail("ci_definition_review_required")
        touched = ci_git_bytes(root, "diff", "--name-only", "--no-renames", "-z", value["base"], value["head"], "--")
        paths = [p.decode("utf-8") for p in touched.split(b"\0") if p]
        mapped = _ci_affected_checks(mapping, paths)
        # Configuration/toolchain scope has no typed classification in schema 1.
        # Conservatively inspect the union of every declared check, never omit one
        # based on filenames. Consumers still own their actual CI implementations.
        matched = {}
        for index, item in enumerate(evidence):
            if not isinstance(item, dict):
                fail("ci_evidence_invalid")
            if item.get("head") != value["head"] or item.get("base") != value["base"]:
                continue
            _validate_ci_evidence(item, checks, mapping_digest, value["head"], value["base"])
            if item["tested_oid"] != value["head"]:
                pr_review_merge_ancestry(root, value, item["tested_oid"], [])
            if item["check_id"] in matched:
                fail("ci_ambiguous_evidence")
            matched[item["check_id"]] = item
            consumed.add(index)
        expected = {c["id"] for c in mapping["checks"]}
        summaries.append({"pull_request": value["pull_request"], "required_checks": sorted(expected),
                          "mapped_checks": mapped,
                          "missing_checks": sorted(expected - matched.keys()),
                          "non_success_checks": sorted(k for k, item in matched.items()
                              if ci_conclusion(item["conclusion"], affected=True, allow_unrelated_pending=False) != "passed")})
    if consumed != set(range(len(evidence))):
        fail("ci_unbound_evidence")
    return {"status": "unverified", "producer_authentication": "unavailable", "recommendations": summaries}


def pr_review_digest(value):
    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(",", ":"),
                                     ensure_ascii=False, allow_nan=False).encode()).hexdigest()


def pr_review_ref(value):
    if (not isinstance(value, str) or not value.startswith("refs/heads/") or len(value.encode()) > 255
            or any(ord(c) < 32 or ord(c) == 127 for c in value)):
        fail("pr_review_ref_invalid")
    result = subprocess.run(["git", "check-ref-format", value], capture_output=True, timeout=5)
    if result.returncode:
        fail("pr_review_ref_invalid")
    return value


def pr_review_delivery(value):
    if value is None:
        value = {"schema_version": 1}
    fields = {"schema_version", "enabled", "mode", "remote", "targets", "role",
              "allow_unrelated_pending", "delete_remote_branch", "mapping_path"}
    if (not isinstance(value, dict) or set(value) - fields
            or type(value.get("schema_version")) is not int or value["schema_version"] != 1):
        fail("pr_review_policy_invalid")
    selected = {"schema_version": 1, "enabled": False, "mode": "ordinary", "remote": "origin",
                "targets": [], "role": "integrator", "allow_unrelated_pending": False,
                "delete_remote_branch": False, **value}
    if (any(type(selected[k]) is not bool for k in ("enabled", "allow_unrelated_pending", "delete_remote_branch"))
            or selected["mode"] not in ("ordinary", "admin") or selected["role"] not in ("operator", "integrator")
            or selected["mode"] == "admin" and selected["role"] != "operator"
            or not isinstance(selected["remote"], str)
            or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,127}", selected["remote"])):
        fail("pr_review_policy_invalid")
    targets = selected["targets"]
    if not isinstance(targets, list) or len(targets) > 64:
        fail("pr_review_policy_invalid")
    for target in targets:
        pr_review_ref(target)
    if len(set(targets)) != len(targets):
        fail("pr_review_policy_invalid")
    mapping = selected.get("mapping_path")
    if mapping is not None and (not isinstance(mapping, str) or not 1 <= len(mapping.encode()) <= 512
            or PurePosixPath(mapping).is_absolute() or any(p in ("", ".", "..") for p in mapping.split("/"))
            or ".dbsctr" in mapping.split("/") or any(ord(c) < 32 or ord(c) == 127 for c in mapping)):
        fail("pr_review_policy_invalid")
    if selected["enabled"] and not mapping:
        fail("pr_review_policy_invalid")
    return selected


def pr_review_policy_snapshot(root):
    """Read activated generated bytes only. A snapshot grants no native permission."""
    try:
        config = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
        source = config / "dotfiles-ai/workflow-policy.json"
        if not os.path.lexists(source):
            return None
        safe_directory(config, source.parent)
        raw = pr_review_private_bytes(source, 256 * 1024)
        helper = Path.home() / ".local/bin/workflow-policy"
        safe_directory(Path.home(), helper.parent)
        item = helper.lstat()
        if (not stat.S_ISREG(item.st_mode) or item.st_uid != os.getuid()
                or item.st_nlink != 1 or item.st_mode & 0o022):
            fail("pr_review_policy_invalid")
        if json.loads(removal_run(root, [str(helper), "check"]), object_pairs_hook=no_duplicate_keys) != {"status": "passed"}:
            fail("pr_review_policy_unavailable")
        if pr_review_private_bytes(source, 256 * 1024) != raw:
            fail("pr_review_policy_changed")
        policy = json.loads(raw, object_pairs_hook=no_duplicate_keys)
        if (not isinstance(policy, dict) or set(policy) != {"schema_version", "source_commit", "policy_digest",
                "root", "cache_root", "repositories", "naming"}
                or type(policy["schema_version"]) is not int or policy["schema_version"] != 1
                or policy["policy_digest"] != pr_review_digest({k: v for k, v in policy.items() if k != "policy_digest"})):
            fail("pr_review_policy_invalid")
        common = common_git_dir(root).resolve()
        entries = [e for e in policy["repositories"] if (Path(e["repository"]) / ".git").resolve() == common]
        if len(entries) > 1:
            fail("pr_review_policy_invalid")
        delivery = pr_review_delivery(entries[0].get("delivery") if entries else None)
        return {"schema_version": 1, "policy_digest": policy["policy_digest"],
                "repository_id": hashlib.sha256(str(common).encode()).hexdigest(), "delivery": delivery}
    except (OSError, ValueError, TypeError, KeyError, subprocess.SubprocessError):
        fail("pr_review_policy_unavailable")


def pr_review_birth_policy(root):
    return birth_policy_snapshot(root, pr_review_policy_snapshot)


def birth_policy_snapshot(root, reader):
    try:
        return reader(root)
    except RuntimeError:
        # Source registration is not host activation. Never upgrade this absent
        # non-authorizing snapshot later when an installation becomes available.
        return None


def pr_review_batch_digest(recommendations):
    return pr_review_digest([{k: v for k, v in value.items() if k not in {"batch_digest", "approval"}}
                             for value in recommendations])


def validate_pr_recommendations(values):
    fields = {"schema_version", "repository_id", "pull_request", "head", "base", "target_ref",
              "ultimate_default_ref", "strategy", "policy_digest", "mapping_digest",
              "specification_digest", "batch_digest", "approval"}
    if not isinstance(values, list) or not 1 <= len(values) <= 32:
        fail("pr_review_batch_invalid")
    seen = set()
    for value in values:
        if (not isinstance(value, dict) or set(value) != fields
                or type(value["schema_version"]) is not int or value["schema_version"] != 1
                or type(value["pull_request"]) is not int or not 1 <= value["pull_request"] < 2**53
                or value["pull_request"] in seen or value["strategy"] != "merge"):
            fail("pr_review_recommendation_invalid")
        seen.add(value["pull_request"])
        for key in ("repository_id", "policy_digest", "mapping_digest", "specification_digest", "batch_digest"):
            if not isinstance(value[key], str) or not re.fullmatch(r"[0-9a-f]{64}", value[key]):
                fail("pr_review_recommendation_invalid")
        for key in ("head", "base"):
            if not isinstance(value[key], str) or not re.fullmatch(r"[0-9a-f]{40}|[0-9a-f]{64}", value[key]):
                fail("pr_review_recommendation_invalid")
        if len(value["head"]) != len(value["base"]):
            fail("pr_review_recommendation_invalid")
        if len(value["head"]) != len(values[0]["head"]):
            fail("pr_review_object_format_mismatch")
        pr_review_ref(value["target_ref"])
        pr_review_ref(value["ultimate_default_ref"])
        # Only the specified policy-digest approval form is machine-readable here.
        # Native checkpoint authority is not inferred from arbitrary JSON objects.
        if not isinstance(value["approval"], str) or value["approval"] != value["policy_digest"]:
            fail("pr_review_checkpoint_unavailable")
        if any(value[k] != values[0][k] for k in ("repository_id", "target_ref", "ultimate_default_ref",
                                                "policy_digest", "mapping_digest", "specification_digest")):
            fail("pr_review_batch_invalid")
    digest = pr_review_batch_digest(values)
    if any(value["batch_digest"] != digest for value in values):
        fail("pr_review_batch_changed")
    return values


def pr_review_read_recommendations(source):
    if not source:
        fail("pr_review_recommendations_required")
    raw = pr_review_private_bytes(source, 512 * 1024)
    return validate_pr_recommendations(ci_json(raw))


def pr_review_merge_ancestry(root, value, merged, gates):
    if (not isinstance(merged, str) or not re.fullmatch(r"[0-9a-f]{40}|[0-9a-f]{64}", merged)
            or len(merged) != len(value["head"])):
        fail("pr_review_merge_invalid")
    observed = inspect_git(root, "show", "-s", "--format=%P", merged, check=False)
    if observed.returncode or observed.stdout.strip().split() != [value["base"], value["head"]]:
        fail("pr_review_merge_parents_mismatch")
    if not isinstance(gates, list) or len(gates) > 1024:
        fail("pr_review_gate_ancestry_unavailable")
    for gate in [value["head"], *gates]:
        if (not isinstance(gate, str) or not re.fullmatch(r"[0-9a-f]{40}|[0-9a-f]{64}", gate)
                or inspect_git(root, "merge-base", "--is-ancestor", gate, merged, check=False).returncode):
            fail("pr_review_gate_ancestry_unavailable")


def pr_review_rebind(root, prior, updated, merged, gates):
    validate_pr_recommendations(prior)
    validate_pr_recommendations(updated)
    if len(prior) != len(updated):
        fail("pr_review_checkpoint_changed")
    if (not isinstance(merged, str) or not re.fullmatch(r"[0-9a-f]{40}|[0-9a-f]{64}", merged)
            or len(merged) != len(prior[0]["head"])):
        fail("pr_review_merge_invalid")
    parent = inspect_git(root, "show", "-s", "--format=%P", merged, check=False).stdout.split()
    matches = [i for i, value in enumerate(prior) if len(parent) == 2 and value["head"] == parent[1]]
    if len(matches) != 1 or matches[0] + 1 >= len(prior):
        fail("pr_review_planned_base_unavailable")
    completed = matches[0]
    cursor = merged
    # Prove the complete ordered prefix through native Git, not a caller boolean.
    for index in range(completed, -1, -1):
        parents = inspect_git(root, "show", "-s", "--format=%P", cursor, check=False).stdout.split()
        if len(parents) != 2 or parents[1] != prior[index]["head"]:
            fail("pr_review_planned_base_unavailable")
        if prior[index]["base"] != parents[0]:
            fail("pr_review_external_base_advance" if index == 0 else "pr_review_recorded_base_mismatch")
        pr_review_merge_ancestry(root, prior[index], cursor, gates if index == completed else [])
        cursor = parents[0]
    if cursor != prior[0]["base"]:
        fail("pr_review_external_base_advance")
    for index, (before, after) in enumerate(zip(prior, updated)):
        expected = {k: v for k, v in before.items() if k != "batch_digest"}
        if index == completed + 1:
            expected["base"] = merged
        if expected != {k: v for k, v in after.items() if k != "batch_digest"}:
            fail("pr_review_checkpoint_changed")
    # No check evidence or waiver is returned or copied. Their old base bindings
    # cannot authorize the rebound recommendation; collection belongs to CI.


def check_pr_review(root, record, source, *, prior_source=None, merge_commit=None, repair_check=None, ci_source=None):
    """Non-mutating preflight, never a merge authorization or CI result."""
    try:
        values = pr_review_read_recommendations(source)
        object_format = git(root, "rev-parse", "--show-object-format").stdout.strip()
        if object_format not in {"sha1", "sha256"} or len(values[0]["head"]) != {"sha1": 40, "sha256": 64}[object_format]:
            fail("pr_review_object_format_mismatch")
        gates = [entry["id"] for entry in record.get("commits", [])]
        if prior_source:
            if not merge_commit:
                fail("pr_review_verified_predecessor_required")
            pr_review_rebind(root, pr_review_read_recommendations(prior_source), values, merge_commit, gates)
        elif merge_commit:
            pr_review_merge_ancestry(root, values[0], merge_commit, gates)
        policy = pr_review_policy_snapshot(root)
        ci_inspection = None
        reason = "pr_review_native_evidence_unavailable"
        if policy is None or not policy["delivery"]["enabled"]:
            reason = "pr_review_automatic_delivery_disabled"
        elif record.get("pr_review_policy") != policy:
            reason = "pr_review_policy_absent_or_changed"
        else:
            selected = policy["delivery"]
            for value in values:
                if (value["repository_id"] != policy["repository_id"] or value["policy_digest"] != policy["policy_digest"]
                        or value["target_ref"] not in selected["targets"]
                        or selected["role"] == "integrator" and value["target_ref"] == value["ultimate_default_ref"]):
                    fail("pr_review_target_or_policy_not_approved")
            if ci_source is not None:
                ci_inspection = ci_review_inspection(root, values, selected, ci_source)
        if repair_check is not None:
            if not isinstance(repair_check, str) or not re.fullmatch(r"[a-z][a-z0-9-]{0,63}", repair_check):
                fail("pr_review_check_id_invalid")
            reason = "pr_review_repair_accounting_unavailable"
        print(json.dumps({"schema_version": 1, "status": "blocked", "reason": reason,
                          "recommendations": len(values), "batch_digest": values[0]["batch_digest"],
                          "ci_inspection": ci_inspection,
                          "integration_outcome": "completed_unmerged" if record.get("state") == "completed" else "unverified",
                          "retirement_authority": False}, sort_keys=True))
        fail(reason)  # Source structure/policy alone can never pass a merge gate.
    except (OSError, ValueError, TypeError, KeyError, subprocess.SubprocessError):
        fail("pr_review_evidence_unavailable")


def sync_source_checkout(record, remote, remote_branch, root=None):
    source = record.get("source")
    if not source:
        return {"status": "not_applicable", "reason": "no_recorded_source"}
    try:
        checkout = record_source_worktree(root or root_dir(), record)
        if not checkout.is_dir():
            return {"status": "skipped", "reason": "missing"}
        if status_paths(checkout):
            return {"status": "skipped", "reason": "dirty"}
        if branch(checkout) != source.get("branch"):
            return {"status": "skipped", "reason": "branch_changed"}
        if upstream(checkout) != source.get("upstream"):
            return {"status": "skipped", "reason": "upstream_changed"}
        if remote_destination(checkout, source.get("upstream")) != source.get("remote"):
            return {"status": "skipped", "reason": "target_changed"}
        git(checkout, "fetch", remote, remote_branch)
        target = source["upstream"]
        if git(checkout, "merge-base", "--is-ancestor", "HEAD", target, check=False).returncode:
            return {"status": "skipped", "reason": "diverged"}
        git(checkout, "merge", "--ff-only", target)
        return {"status": "updated", "reason": "fast_forward"}
    except (OSError, RuntimeError, KeyError):
        return {"status": "skipped", "reason": "sync_failed"}


def validate_draft_reconciliation(root, cycle_base, target_head, recorded_commits,
                                  evidence_points, review_point=None):
    if git(root, "merge-base", "--is-ancestor", target_head, "HEAD", check=False).returncode:
        fail("protected base advanced without reconciliation")
    merges = git(root, "rev-list", "--first-parent", "--merges", f"{cycle_base}..HEAD").stdout.splitlines()
    matches = [commit for commit in merges
               if git(root, "rev-parse", f"{commit}^2", check=False).stdout.strip() == target_head]
    if len(matches) != 1:
        fail("protected base reconciliation merge is missing or ambiguous")
    reconciliation = matches[0]
    first_parent = git(
        root, "rev-list", "--reverse", "--first-parent", f"{cycle_base}..HEAD"
    ).stdout.splitlines()
    if reconciliation in recorded_commits:
        if (first_parent != recorded_commits or review_point is None
                or git(root, "merge-base", "--is-ancestor", reconciliation, review_point,
                       check=False).returncode):
            fail("recorded reconciliation is not the reviewed Gate Commit")
        if any(git(root, "merge-base", "--is-ancestor", reconciliation, point,
                   check=False).returncode for point in evidence_points):
            fail("required gate evidence predates protected base reconciliation")
        return recorded_commits
    if any(git(root, "merge-base", "--is-ancestor", reconciliation, point,
               check=False).returncode for point in evidence_points):
        fail("required gate evidence predates protected base reconciliation")
    current_ahead = [commit for commit in first_parent if commit != reconciliation]
    if current_ahead != recorded_commits:
        fail("ahead commits are not exactly the recorded cycle commits")
    return current_ahead


def github_environment(account):
    lookup_env = {key: value for key, value in os.environ.items()
                  if key not in {"GH_TOKEN", "GITHUB_TOKEN"}}
    result = subprocess.run(
        ["gh", "auth", "token", "--hostname", "github.com", "--user", account],
        text=True, capture_output=True, env=lookup_env,
    )
    token = result.stdout.strip()
    if result.returncode or not token:
        fail(result.stderr.strip() or f"GitHub account is not authenticated: {account}")
    env = {**os.environ, "GH_TOKEN": token, "GIT_TERMINAL_PROMPT": "0",
           "GCM_INTERACTIVE": "Never"}
    for key in tuple(env):
        if (key in {"GIT_CONFIG", "GIT_CONFIG_COUNT", "GIT_CONFIG_PARAMETERS", "GIT_CURL_VERBOSE"}
                or re.fullmatch(r"GIT_CONFIG_(?:KEY|VALUE)_\d+", key)
                or key.startswith("GIT_TRACE")):
            del env[key]
    env.update({
        "GIT_CONFIG_COUNT": "3",
        "GIT_CONFIG_KEY_0": "credential.helper",
        "GIT_CONFIG_VALUE_0": "",
        "GIT_CONFIG_KEY_1": "credential.helper",
        "GIT_CONFIG_VALUE_1": (
            "!f() { printf '%s\\n' username=x-access-token \"password=$GH_TOKEN\"; }; f"
        ),
        "GIT_CONFIG_KEY_2": "http.extraHeader",
        "GIT_CONFIG_VALUE_2": "",
    })
    return env


def github_json(root, env, *args):
    result = subprocess.run(["gh", *args], cwd=root, env=env, text=True, capture_output=True)
    if result.returncode:
        fail(result.stderr.strip() or "GitHub CLI command failed")
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError:
        fail("GitHub CLI returned invalid JSON")


def deliver_draft_pr(root, record, env=None):
    delivery = record["delivery"]
    github = delivery["github"]
    env = env or github_environment(github["account"])
    fields = "number,url,isDraft,state,baseRefName,headRefName,headRepositoryOwner"
    owner = github["repository"].partition("/")[0]
    head = f"{owner}:{delivery['branch']}"
    existing = github_json(
        root, env, "pr", "list", "--repo", github["repository"], "--head", delivery["branch"],
        "--state", "open", "--limit", "100", "--json", fields,
    )
    if not isinstance(existing, list):
        fail("GitHub returned invalid pull requests for the feature branch")
    existing = [pull_request for pull_request in existing
                if pull_request.get("headRepositoryOwner", {}).get("login") == owner
                and pull_request.get("state") == "OPEN"]
    if len(existing) > 1:
        fail("GitHub returned ambiguous pull requests for the feature branch")
    if existing:
        pull_request = existing[0]
    else:
        title = f"{record['cycle_id']}: {record['context']} improvement"
        body = "Automated DBSCTR improvement. Human review and merge are required."
        result = subprocess.run([
            "gh", "pr", "create", "--repo", github["repository"],
            "--base", delivery["base_branch"], "--head", head,
            "--draft", "--title", title, "--body", body,
        ], cwd=root, env=env, text=True, capture_output=True)
        if result.returncode or not result.stdout.strip():
            fail(result.stderr.strip() or "GitHub draft pull request creation failed")
        pull_request = github_json(
            root, env, "pr", "view", result.stdout.strip(), "--repo", github["repository"],
            "--json", fields,
        )
    if (not isinstance(pull_request, dict) or pull_request.get("isDraft") is not True
            or pull_request.get("state") != "OPEN"
            or pull_request.get("baseRefName") != delivery["base_branch"]
            or pull_request.get("headRefName") != delivery["branch"]
            or pull_request.get("headRepositoryOwner", {}).get("login") != owner
            or type(pull_request.get("number")) is not int or pull_request["number"] < 1
            or not isinstance(pull_request.get("url"), str)
            or not pull_request["url"].startswith("https://github.com/")):
        fail("GitHub pull request is not the expected open draft")
    return {
        "number": pull_request["number"], "url": pull_request["url"], "draft": True,
        "state": "OPEN", "verified_at": now(),
    }


def batch_id(value):
    if not isinstance(value, str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9-]{0,63}", value):
        fail("invalid batch ID")
    return value


@contextlib.contextmanager
def batch_lock(root, identifier):
    path = cycle_dir(root) / "locks" / f"batch-{identifier}.lock"
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor = os.open(path, os.O_RDWR | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0), 0o600)
    try:
        details = os.fstat(descriptor)
        if stat.S_IFMT(details.st_mode) != stat.S_IFREG or details.st_uid != os.getuid():
            fail("batch lock is unsafe")
        os.fchmod(descriptor, 0o600)
        fcntl.flock(descriptor, fcntl.LOCK_EX)
        yield
    finally:
        os.close(descriptor)


def serialized_batch(function):
    def command(args):
        root = root_dir()
        with batch_lock(root, batch_id(args.batch_id)):
            return function(args)
    return command


def batch_path(root, identifier):
    return cycle_dir(root) / "batches" / f"{identifier}.json"


def batch_worktree(root, identifier):
    repository = hashlib.sha256(str(common_git_dir(root).resolve()).encode()).hexdigest()[:16]
    return dbsctr_state_root() / "batch-worktrees" / repository / identifier


def load_batch(root, identifier):
    path = batch_path(root, identifier)
    if not path.is_file() or path.is_symlink():
        fail("batch is missing")
    try:
        value = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        fail("batch metadata is invalid")
    if (value.get("schema_version") not in (1, 2) or value.get("batch_id") != identifier
            or value.get("branch") != f"rnd/batch/{identifier}"
            or value.get("worktree") != str(batch_worktree(root, identifier))):
        fail("batch metadata is invalid")
    return path, value


def batch_source_tip(value):
    return value["sources"][-1]["merge"] if value["sources"] else value["base"]


def validate_batch_tip(worktree, value):
    expected = value["base"]
    for item in value["sources"]:
        if (not isinstance(item, dict) or set(item) != {"branch", "sha", "merge"}
                or not all(isinstance(item[name], str) for name in item)
                or not re.fullmatch(r"dbsctr/[A-Za-z0-9._/-]+", item["branch"])
                or ".." in PurePosixPath(item["branch"]).parts
                or not re.fullmatch(r"[0-9a-f]{40,64}", item["sha"])
                or not re.fullmatch(r"[0-9a-f]{40,64}", item["merge"])
                or git(worktree, "show", "-s", "--format=%P", item["merge"]).stdout.split()
                != [expected, item["sha"]]):
            fail("batch merge history is invalid")
        expected = item["merge"]
    graph = value.get("graph")
    if graph is not None:
        if (not isinstance(graph, dict) or not re.fullmatch(r"[0-9a-f]{40,64}", graph.get("commit", ""))
                or git(worktree, "show", "-s", "--format=%P", graph["commit"]).stdout.split() != [expected]
                or any(not name.startswith("graphify-out/") for name in git(
                    worktree, "diff-tree", "--no-commit-id", "--name-only", "-r", graph["commit"]
                ).stdout.splitlines())):
            fail("batch graph history is invalid")
        expected = graph["commit"]
    if git(worktree, "rev-parse", "HEAD").stdout.strip() != expected:
        fail("batch tip is not the recorded merge history")


def recover_batch_merges(worktree, value, source_heads):
    expected = batch_source_tip(value)
    head = git(worktree, "rev-parse", "HEAD").stdout.strip()
    if head == expected:
        return []
    candidates = {sha: (source, sha) for source, sha, _record in source_heads}
    recovered, entries = [], []
    known = {item["branch"] for item in value["sources"]}
    for commit in git(worktree, "rev-list", "--first-parent", "--reverse", f"{expected}..{head}").stdout.splitlines():
        parents = git(worktree, "show", "-s", "--format=%P", commit).stdout.split()
        candidate = candidates.get(parents[1]) if len(parents) == 2 and parents[0] == expected else None
        if candidate is None or candidate[0] in known:
            return []
        source, sha = candidate
        entries.append({"branch": source, "sha": sha, "merge": commit})
        recovered.append(source)
        known.add(source)
        expected = commit
    if expected != head:
        return []
    value["sources"].extend(entries)
    return recovered


def batch_graph_value(worktree, value, source_head, commit):
    changed = git(worktree, "diff-tree", "--no-commit-id", "--name-only", "-r", commit).stdout.splitlines()
    if (not changed or any(not name.startswith("graphify-out/") for name in changed)
            or git(worktree, "show", "-s", "--format=%P", commit).stdout.split() != [source_head]):
        fail("batch graph history is invalid")
    try:
        receipt_raw = git(worktree, "show", f"{commit}:graphify-out/graph.receipt.json").stdout.encode()
        receipt = json.loads(receipt_raw, object_pairs_hook=no_duplicate_keys)
        report = git(worktree, "show", f"{commit}:graphify-out/GRAPH_REPORT.md").stdout.encode()
        manifest = git(worktree, "show", f"{commit}:graphify-out/manifest.json").stdout.encode()
    except (json.JSONDecodeError, RuntimeError):
        fail("batch graph receipt is invalid")
    if (receipt.get("command_contract") != "dbsctr-batch-graphify-v1"
            or receipt.get("batch_id") != value["batch_id"] or receipt.get("source_head") != source_head
            or receipt.get("adapter") != value.get("graphify")):
        fail("batch graph receipt identity is invalid")
    requires_dvc_push = any(name.removeprefix("graphify-out/").endswith(".dvc")
                            or name.removeprefix("graphify-out/") in (
                                "dvc.yaml", "dvc.lock", ".dvc/config", ".dvcignore") for name in changed)
    return {"source_head": source_head, "commit": commit,
            "report_sha256": hashlib.sha256(report).hexdigest(),
            "manifest_sha256": hashlib.sha256(manifest).hexdigest(),
            "receipt_sha256": hashlib.sha256(receipt_raw).hexdigest(),
            "requires_dvc_push": requires_dvc_push}


@contextlib.contextmanager
def graphify_finalization_transaction(worktree, output):
    parent = Path(tempfile.mkdtemp(prefix="dbsctr-batch-graphify-", dir=worktree.parent))
    preserve = False
    backup = parent / "graphify-out"
    index_raw = git(worktree, "rev-parse", "--git-path", "index").stdout.strip()
    index = Path(index_raw)
    if not index.is_absolute():
        index = worktree / index
    descriptor, index_backup_raw = tempfile.mkstemp(
        prefix=".dbsctr-graphify-index-", dir=index.parent)
    os.close(descriptor)
    index_backup = Path(index_backup_raw)
    try:
        details = output.lstat()
        if output.is_symlink() or stat.S_IFMT(details.st_mode) != stat.S_IFDIR:
            fail("canonical graph output is unsafe")
        if sys.platform == "darwin":
            result = subprocess.run(
                ["/bin/cp", "-cR", str(output), str(backup)],
                text=True, capture_output=True,
            )
            if result.returncode:
                fail(result.stderr.strip() or "cannot clone canonical graph baseline")
        else:
            shutil.copytree(output, backup, symlinks=True)
        shutil.copy2(index, index_backup)
        try:
            yield
        except BaseException:
            try:
                interrupted = parent / "interrupted"
                os.replace(output, interrupted)
                os.replace(backup, output)
                os.replace(index_backup, index)
                shutil.rmtree(interrupted)
            except BaseException as rollback_error:
                preserve = True
                fail(f"batch Graphify rollback failed: {rollback_error}")
            raise
    finally:
        if not preserve:
            shutil.rmtree(parent, ignore_errors=True)
            index_backup.unlink(missing_ok=True)


def completed_source(root, source, sha):
    matches = []
    for path in (cycle_dir(root) / "cycles").glob("*.json"):
        try:
            record = read_cycle_record(root, path)
        except (OSError, json.JSONDecodeError):
            continue
        delivery = record.get("delivery", {})
        if (record.get("state") == "completed" and record.get("delivery_intent") == "draft_pr"
                and delivery.get("branch") == source
                and delivery.get("published_feature_head") == sha):
            matches.append(record)
    if len(matches) != 1:
        fail("batch source is not one completed DBSCTR draft-PR delivery")
    return matches[0]


@serialized_batch
def command_batch_create(args):
    root = root_dir()
    identifier = batch_id(args.batch_id)
    branch_name = f"rnd/batch/{identifier}"
    path = batch_path(root, identifier)
    worktree = batch_worktree(root, identifier)
    if (not OPAQUE_ID.fullmatch(args.github_account)
            or not re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", args.github_repository)):
        fail("batch requires a valid GitHub account and repository")
    if path.exists() or worktree.exists() or git(root, "show-ref", "--verify", "--quiet",
                                                 f"refs/heads/{branch_name}", check=False).returncode == 0:
        fail("batch already exists")
    if status_paths(root):
        fail("source worktree is not clean")
    git(root, "fetch", "origin", "main")
    base = git(root, "rev-parse", "refs/remotes/origin/main").stdout.strip()
    worktree.parent.mkdir(parents=True, exist_ok=True)
    git(root, "worktree", "add", "-b", branch_name, str(worktree), base)
    value = {
        "schema_version": 2, "batch_id": identifier, "branch": branch_name,
        "base": base, "worktree": str(worktree), "sources": [],
        "state": "open", "graphify": None, "graphify_policy_set": False,
        "github": {"host": "github.com", "account": args.github_account,
                   "repository": args.github_repository}, "created_at": now(),
    }
    private_json(path, value)
    print(json.dumps(value, sort_keys=True))


def batch_source(root, source):
    if not re.fullmatch(r"dbsctr/[A-Za-z0-9._/-]+", source) or ".." in PurePosixPath(source).parts:
        fail("invalid batch source branch")
    git(root, "fetch", "origin", source)
    sha = git(root, "rev-parse", f"refs/remotes/origin/{source}").stdout.strip()
    return sha, completed_source(root, source, sha)


@serialized_batch
def command_batch_integrate(args):
    root = root_dir()
    identifier = batch_id(args.batch_id)
    sources = list(dict.fromkeys(args.source))
    if len(sources) != len(args.source):
        fail("batch source is duplicated")
    git(root, "fetch", "origin", "main")
    source_heads = [(source, *batch_source(root, source)) for source in sources]
    if args.preview:
        parent = Path(tempfile.mkdtemp(prefix=f"dbsctr-batch-{identifier}-"))
        temporary = parent / "worktree"
        added = False
        try:
            base = git(root, "rev-parse", "refs/remotes/origin/main").stdout.strip()
            git(root, "worktree", "add", "--detach", str(temporary), base)
            added = True
            for _source, sha, _record in source_heads:
                git(temporary, "merge", "--no-ff", "--no-edit", sha)
            print(json.dumps({"batch_id": identifier, "preview": True,
                              "head": git(temporary, "rev-parse", "HEAD").stdout.strip()}, sort_keys=True))
        finally:
            if added:
                removed = git(root, "worktree", "remove", "--force", str(temporary), check=False)
                if removed.returncode:
                    fail(removed.stderr.strip() or "cannot remove batch preview worktree")
            shutil.rmtree(parent)
        return
    path, value = load_batch(root, identifier)
    if value.get("state", "open") != "open":
        fail("batch source admission is closed")
    worktree = Path(value["worktree"])
    if not worktree.is_dir() or status_paths(worktree):
        fail("batch worktree is missing or dirty")
    selections = [record.get("applicability_plan", {}).get("graphify")
                  for _source, _sha, record in source_heads]
    selected = [selection for selection in selections if selection is not None]
    if selected and (len(selected) != len(selections) or any(item != selected[0] for item in selected)):
        fail("batch sources have incompatible Graphify selections")
    incoming = selected[0] if selected else None
    if value.get("graphify_policy_set", bool(value["sources"])) and value.get("graphify") != incoming:
        fail("batch Graphify selection changed")
    if selected:
        for selection, (_source, sha, _record) in zip(selections, source_heads):
            validate_graphify_selection(root, selection, sha)
    value.update({"schema_version": 2, "graphify": incoming, "graphify_policy_set": True})
    recovered = recover_batch_merges(worktree, value, source_heads)
    if recovered:
        value["updated_at"] = now()
        private_json(path, value)
        if set(recovered) == set(sources):
            print(json.dumps(value, sort_keys=True))
            return
    validate_batch_tip(worktree, value)
    if git(root, "rev-parse", "refs/remotes/origin/main").stdout.strip() != value["base"]:
        fail("protected base branch drifted")
    recorded = {item["branch"] for item in value["sources"]}
    if recorded.intersection(sources):
        fail("batch source is already integrated")
    for item in value["sources"]:
        git(root, "fetch", "origin", item["branch"])
        current = git(root, "rev-parse", f"refs/remotes/origin/{item['branch']}").stdout.strip()
        if current != item["sha"]:
            fail("batch source drifted")
    for source, sha, _record in source_heads:
        git(worktree, "merge", "--no-ff", "--no-edit", sha)
        value["sources"].append({"branch": source, "sha": sha,
                                 "merge": git(worktree, "rev-parse", "HEAD").stdout.strip()})
        value["updated_at"] = now()
        private_json(path, value)
    print(json.dumps(value, sort_keys=True))


@serialized_batch
def command_batch_finalize(args):
    root = root_dir()
    identifier = batch_id(args.batch_id)
    path, value = load_batch(root, identifier)
    if value.get("state", "open") != "open":
        fail("batch source admission is closed")
    selection = value.get("graphify")
    if not value["sources"] or not isinstance(selection, dict):
        fail("batch has no selected Graphify version")
    worktree = Path(value["worktree"])
    if not worktree.is_dir():
        fail("batch worktree is missing")
    source_head = batch_source_tip(value)
    current_head = git(worktree, "rev-parse", "HEAD").stdout.strip()
    if current_head != source_head:
        graph = batch_graph_value(worktree, value, source_head, current_head)
        value.update({"schema_version": 2, "state": "finalized", "finalized_at": now(), "graph": graph})
        private_json(path, value)
        print(json.dumps({"batch_id": identifier, "state": value["state"], "graph": graph},
                         sort_keys=True, separators=(",", ":")))
        return
    dirty = status_paths(worktree)
    if any(not name.startswith("graphify-out/") for name in dirty):
        fail("batch worktree has unrelated changes")
    validate_batch_tip(worktree, value)
    selection = validate_graphify_selection(worktree, selection, source_head)
    adapter = archived_graphify_adapter(root, selection["adapter_sha256"])
    output = worktree / "graphify-out"
    with graphify_finalization_transaction(worktree, output):
        result = run_graphify_adapter(adapter, worktree, output, selection, "finalize", args.timeout)
        if result.returncode:
            fail(result.stderr[-2000:].strip() or "batch Graphify finalization failed")
        try:
            manifest = json.loads((output / "manifest.json").read_text(encoding="utf-8"),
                                  object_pairs_hook=no_duplicate_keys)
            report = (output / "GRAPH_REPORT.md").read_text(encoding="utf-8")
        except (OSError, json.JSONDecodeError):
            fail("batch Graphify output is invalid")
        if not isinstance(manifest, dict) or f"Built from commit: `{source_head}`" not in report:
            fail("batch Graphify output does not match its source tip")
        (output / "graph.receipt.json").unlink(missing_ok=True)
        files, digests = graphify_output_identity(output)
        receipted = [name for name in files if git(
            worktree, "check-ignore", "--quiet", "--", f"graphify-out/{name}", check=False
        ).returncode != 0]
        receipt = {
            "schema_version": 1, "command_contract": "dbsctr-batch-graphify-v1",
            "batch_id": identifier, "source_head": source_head, "adapter": selection,
            "output_files": receipted, "output_sha256": {name: digests[name] for name in receipted},
            "manifest_sha256": digests["manifest.json"], "created_at": now(),
        }
        (output / "graph.receipt.json").write_text(
            json.dumps(receipt, sort_keys=True, indent=2) + "\n", encoding="utf-8")
        git(worktree, "add", "-A", "--", "graphify-out")
        changed = git(worktree, "diff", "--cached", "--name-only").stdout.splitlines()
        if not changed or any(not name.startswith("graphify-out/") for name in changed):
            fail("batch Graphify finalization must change only graphify-out")
        git(worktree, "commit", "-m", f"chore(graphify): finalize {identifier}")
    commit = git(worktree, "rev-parse", "HEAD").stdout.strip()
    graph = batch_graph_value(worktree, value, source_head, commit)
    value.update({"schema_version": 2, "state": "finalized", "finalized_at": now(),
                  "graph": graph})
    private_json(path, value)
    print(json.dumps({"batch_id": identifier, "state": value["state"], "graph": value["graph"]},
                     sort_keys=True, separators=(",", ":")))


@serialized_batch
def command_batch_record_dvc_push(args):
    root = root_dir()
    identifier = batch_id(args.batch_id)
    path, value = load_batch(root, identifier)
    graph = value.get("graph", {})
    if value.get("state") != "finalized" or not graph.get("requires_dvc_push"):
        fail("batch does not require DVC push evidence")
    if args.head != graph.get("commit"):
        fail("batch DVC push evidence must match the graph commit")
    value["dvc_push"] = {"head": args.head, "evidence": args.evidence, "recorded_at": now()}
    private_json(path, value)
    print(json.dumps(value["dvc_push"], sort_keys=True, separators=(",", ":")))


@serialized_batch
def command_batch_publish(args):
    root = root_dir()
    identifier = batch_id(args.batch_id)
    if batch_id(args.confirm) != identifier:
        fail("batch confirmation does not match")
    path, value = load_batch(root, identifier)
    worktree = Path(value["worktree"])
    if not value["sources"] or not worktree.is_dir() or status_paths(worktree):
        fail("batch is not ready for publication")
    graph = value.get("graph")
    if value.get("graphify") and value.get("state") != "finalized":
        fail("batch Graphify finalization is required")
    if graph and graph.get("requires_dvc_push") and value.get("dvc_push", {}).get("head") != graph.get("commit"):
        fail("current DVC push evidence is required")
    validate_batch_tip(worktree, value)
    git(root, "fetch", "origin", "main")
    if git(root, "rev-parse", "refs/remotes/origin/main").stdout.strip() != value["base"]:
        fail("protected base branch drifted")
    for item in value["sources"]:
        git(root, "fetch", "origin", item["branch"])
        if git(root, "rev-parse", f"refs/remotes/origin/{item['branch']}").stdout.strip() != item["sha"]:
            fail("batch source drifted")
    git(worktree, "push", "origin", f"HEAD:{value['branch']}")
    record = {"cycle_id": identifier, "context": "batch integration", "delivery": {
        "branch": value["branch"], "base_branch": "main", "github": value["github"]}}
    pull_request = deliver_draft_pr(worktree, record)
    value["pull_request"] = pull_request
    value["published_at"] = now()
    private_json(path, value)
    print(json.dumps({"batch_id": identifier, "pull_request": pull_request}, sort_keys=True))


def link_improvement_pull_request(record, pull_request, worktree=None, comparison_base=None):
    sessions = record.get("runtime", {}).get("opencode", {}).get("session_ids", [])
    binding = record.get("improvement")
    if not sessions:
        if binding is not None:
            fail("bound improvement cycle has no OpenCode session")
        return
    ledger_root = review_root()
    if not ledger_exists(ledger_root):
        if binding is not None:
            fail("bound improvement worker ledger is missing")
        return
    connection = sqlite3.connect(f"file:{ledger_path(ledger_root)}?mode=ro", uri=True)
    try:
        if connection.execute(
                "SELECT 1 FROM sqlite_master WHERE type='table' AND name='improvement_workers'"
        ).fetchone() is None:
            if binding is not None:
                fail("bound improvement worker ledger is invalid")
            return
    finally:
        connection.close()

    def link(connection):
        row = (connection.execute(
            "SELECT worker_id FROM improvement_workers WHERE worker_id=? AND session_id=? AND opportunity_id=?",
            (binding["worker_id"], binding["session_id"], binding["opportunity_id"]),
        ).fetchone() if binding is not None else connection.execute(
            "SELECT worker_id FROM improvement_workers WHERE session_id=?", (sessions[-1],)
        ).fetchone())
        if row is None:
            if binding is not None:
                fail("bound improvement worker projection is missing")
            return
        worker_id = row[0]
        if worktree is None:
            fail("improvement draft report requires the cycle worktree")
        base = comparison_base or record["delivery"]["base_head"]
        comparison = f"{base}...HEAD"
        changed_paths = sorted(set(filter(None, git(
            worktree, "diff", "--name-only", comparison).stdout.splitlines())))
        diff = git(worktree, "diff", "--binary", comparison).stdout
        implementation_report = improvement_implementation_report({
            "schema_version": 1,
            "pull_request_url": pull_request["url"],
            "changed_paths": changed_paths,
            "diff_digest": hashlib.sha256(diff.encode()).hexdigest(),
            "passed_gates": sorted(name for name, gate in record["gates"].items()
                                   if gate["result"] == "passed"),
        })
        current = improvement_worker(connection, worker_id)
        if current["state"] not in {"implementing", "draft_pr"}:
            fail("improvement worker is not ready for draft_pr delivery")
        connection.execute("""
            UPDATE improvement_workers SET state='draft_pr', resume_state='draft_pr',
                   pr_number=?, pr_url=?, implementation_report=?, updated_at=? WHERE worker_id=?
        """, (pull_request["number"], pull_request["url"],
              implementation_report, int(datetime.now(timezone.utc).timestamp() * 1000), worker_id))

    improvement_write(ledger_root, link)


def require_completion_source(root, record):
    """Validate local source authority without invoking any delivery operation."""
    verify_discovery_import(root, record)
    require_amendment_completion(root, record)
    require_current_profile(root, record)
    require_graphify_check(root, record)
    if record.get("schema_version") in (3, 4, 5, 6):
        final_head = git(root, "rev-parse", "HEAD").stdout.strip()
        for name, gate in record["gates"].items():
            if gate["applicability"] == "required" and gate["result"] in ("passed", "failed", "unavailable"):
                item = verify_envelope(root, record, name, require_head=False)
                gate_commits = {entry["id"] for entry in record["commits"] if name in entry["gates"]}
                if item.get("commit") and item["commit"] not in gate_commits:
                    fail(f"evidence commit is not bound to its gate: {name}")
                if not item.get("commit") and item.get("head") != final_head:
                    fail(f"uncommitted gate evidence HEAD is stale: {name}")
    if any(gate["applicability"] == "required" and gate["result"] != "passed"
           and not (gate["result"] in {"failed", "unavailable"} and valid_gate_exception(gate)
                    if local_only_cycle(record) else "exception" in gate)
           for gate in record["gates"].values()):
        fail("required gates have not all passed")
    completion_artifact_check(record)
    if status_paths(root):
        fail("worktree is not clean")
    baseline = record["git"]
    if not baseline["branch"] or branch(root) != baseline["branch"]:
        fail("HEAD is detached or not on the original branch")
    current_upstream = upstream(root)
    if not baseline["upstream"] or current_upstream != baseline["upstream"]:
        fail("upstream is missing or changed")


def local_completion_source(root, record):
    require_completion_source(root, record)
    base = record["delivery"]["base_head"]
    if git(root, "merge-base", "--is-ancestor", base, "HEAD", check=False).returncode:
        fail("local comparison base is outside the cycle lineage")
    commits = [entry["id"] for entry in record["commits"]]
    actual = git(root, "rev-list", "--reverse", f"{base}..HEAD").stdout.splitlines()
    if not commits or actual != commits:
        fail("ahead commits are not exactly the recorded cycle commits")
    changed = set(git(root, "diff", "--name-only", f"{base}..HEAD").stdout.splitlines())
    if record["artifact_reviews"]["CHANGELOG"]["path"] not in changed:
        fail("reviewed CHANGELOG path is not committed in this cycle")
    return (git(root, "rev-parse", "HEAD").stdout.strip(),
            git(root, "rev-parse", "HEAD^{tree}").stdout.strip(), commits)


def command_complete_local(args):
    """Persist exact local completion; explicit IDs only retry completed records."""
    with local_completion_git_context():
        complete_local_offline(args)


def complete_local_offline(args):
    root = root_dir()
    pointer = resolved_active_path(root, bindings=False)
    explicit = args.cycle_id is not None
    identifier = args.cycle_id if explicit else active_pointer_id(root, pointer)
    if not isinstance(identifier, str) or not OPAQUE_ID.fullmatch(identifier):
        fail("invalid local completion cycle ID")
    path = cycle_dir(root) / "cycles" / f"{identifier}.json"
    managed_directory(root, path.parent)
    continuation_private(path)
    record = read_cycle_record(root, path, historical=True)
    if not local_only_cycle(record):
        fail("complete-local requires a local-only Cycle Record")
    if explicit and record["state"] != "completed":
        fail("explicit cycle ID requires an already completed local-only record")
    with evidence_lock(root, "local-mutation-" + identifier, timeout=1):
        record = read_cycle_record(root, path, historical=True)
        if not local_only_cycle(record) or not record_worktree_matches(root, record, root, bindings=False):
            fail("local completion requires its original native checkout and task branch")
        if not explicit and active_pointer_id(root, pointer) != identifier:
            fail("local completion active pointer changed")
        if explicit and record["state"] != "completed":
            fail("explicit cycle ID requires an already completed local-only record")
        with target_lock(root, record):
            admitted_record = json.dumps(record, sort_keys=True)
            head, tree, commits = local_completion_source(root, record)
            if record["state"] == "completed":
                completion = record["local_completion"]
                if completion["head"] != head or completion["tree"] != tree:
                    fail("completed local source HEAD or tree changed")
            else:
                require_active(record)
                completed_at = now()
                completion = {"schema_version": 1, "cycle_id": identifier,
                    "repository": {key: record["delivery"]["forge"][key]
                                   for key in ("provider", "origin", "repository")},
                    "base_head": record["delivery"]["base_head"], "head": head, "tree": tree,
                    "recorded_commits": commits, "completed_at": completed_at,
                    "manual_delivery": {"status": "pending"}}
                record.update(state="completed", completed_at=completed_at, local_completion=completion,
                              source_sync={"status": "not_applicable", "reason": "local_only_completion"})
                validate_schema6_record(root, record)
                # CLI mutation serialization cannot prevent a manual Git operation.
                # Reobserve source immediately before atomic persistence and retain on drift.
                if (status_paths(root) or branch(root) != record["worktree"]["branch"]
                        or git(root, "rev-parse", "HEAD").stdout.strip() != head
                        or git(root, "rev-parse", "HEAD^{tree}").stdout.strip() != tree):
                    fail("local source changed during completion")
                if active_pointer_id(root, pointer) != identifier:
                    fail("local completion active pointer changed")
                if json.dumps(read_cycle_record(root, path, historical=True), sort_keys=True) != admitted_record:
                    fail("local completion record changed during validation")
                save(path, record)
            if not explicit:
                if active_pointer_id(root, pointer) != identifier:
                    fail("local completion active pointer changed; retained completion")
                pointer.unlink()
            print(json.dumps({"status": "locally_validated", **completion}, sort_keys=True))


def refuse_local_delivery(record):
    if local_only_cycle(record):
        fail("local-only cycles cannot use Final Push or target reconciliation; use complete-local")


def finish_push(root, path, record):
    refuse_local_delivery(record)
    pointer = resolved_active_path(root)
    if record["state"] == "completed":
        pointer.unlink(missing_ok=True)
        prefix = "draft_pr " + record["delivery"]["pull_request"]["url"] + " " if record["delivery_intent"] == "draft_pr" else ""
        print(prefix + "pushed " + " ".join(entry["id"] for entry in record["commits"]))
        return
    require_pushable(record)
    require_completion_source(root, record)
    baseline = record["git"]
    current_upstream = upstream(root)
    delivery = record.get("delivery", {})
    delivery_env = (github_environment(delivery["github"]["account"])
                    if record["delivery_intent"] == "draft_pr" else None)
    if (baseline["pre_cycle_ahead_commits"] and not (
            record["delivery_intent"] == "draft_pr"
            and delivery.get("published_feature_head") == baseline["head"])):
        fail("pre-cycle ahead commits would be pushed")
    remote = delivery.get("remote")
    remote_branch = delivery.get("branch")
    if not remote or not remote_branch:
        remote, remote_branch = remote_for_upstream(root, current_upstream)
    if not remote or not remote_branch:
        fail("upstream is not a remote branch")
    protected_base_branch = delivery.get("protected_base_branch")
    if (record["delivery_intent"] != "draft_pr" and protected_base_branch
            and remote_branch == protected_base_branch):
        fail("direct delivery to the protected base branch requires draft_pr")
    base_branch = (delivery.get("base_branch", "main")
                   if record["delivery_intent"] == "draft_pr" else remote_branch)
    if baseline.get("remote") != remote_destination(root, current_upstream):
        fail("remote push destination changed")
    if record["delivery_intent"] == "draft_pr":
        remote_url = github_remote_url(root, remote, delivery["github"]["repository"])
        fetch_github_branch(root, remote, remote_url, base_branch, delivery_env)
    else:
        remote_url = remote
        git(root, "fetch", remote, base_branch)
    cycle_base = baseline["head"]
    target_ref = (f"refs/remotes/{remote}/{base_branch}"
                  if record["delivery_intent"] == "draft_pr" else current_upstream)
    target_head = git(root, "rev-parse", target_ref).stdout.strip()
    recorded_commits = [entry["id"] for entry in record["commits"]]
    reconciled = False
    base_head = delivery.get("base_head", cycle_base)
    recorded_reconciliation = any(
        git(root, "rev-parse", f"{commit}^2", check=False).stdout.strip() == target_head
        for commit in recorded_commits
    )
    if (record["delivery_intent"] == "draft_pr"
            and (target_head != base_head or recorded_reconciliation)):
        evidence_points, review_point = [], None
        for name, gate in record["gates"].items():
            if gate["applicability"] == "required":
                item = record["evidence"]["items"][gate["evidence"]]
                point = item.get("commit") or item["head"]
                evidence_points.append(point)
                if name == "review_integrate":
                    review_point = point
        current_ahead = validate_draft_reconciliation(
            root, cycle_base, target_head, recorded_commits, evidence_points, review_point
        )
        reconciled = True
    else:
        if (target_head != base_head
                and (git(root, "merge-base", "--is-ancestor", cycle_base, target_head,
                         check=False).returncode
                     or git(root, "merge-base", "--is-ancestor", target_head, "HEAD",
                            check=False).returncode)):
            fail("delivery target advanced outside the cycle lineage")
        reconciled = target_head != base_head
        comparison_base = cycle_base if record["delivery_intent"] == "draft_pr" else current_upstream
        current_ahead = git(root, "rev-list", "--reverse", f"{comparison_base}..HEAD").stdout.splitlines()
    if current_ahead != recorded_commits:
        if not (record["state"] == "finalizing" and not current_ahead and reconciled
                and git(root, "rev-list", "--reverse", f"{cycle_base}..{target_head}").stdout.splitlines()[-len(recorded_commits):]
                    == recorded_commits):
            fail("ahead commits are not exactly the recorded cycle commits")
    if not current_ahead and record["state"] != "finalizing":
        fail("ahead commits are not exactly the recorded cycle commits")
    changed = set(git(root, "diff", "--name-only", f"{cycle_base}..HEAD").stdout.splitlines())
    changelog_path = record["artifact_reviews"]["CHANGELOG"]["path"]
    if changelog_path not in changed:
        fail("reviewed CHANGELOG path is not committed in this cycle")
    dvc_relevant = any(name.endswith(".dvc") or name in ("dvc.yaml", "dvc.lock", ".dvc/config", ".dvcignore")
                       for name in changed)
    if dvc_relevant:
        dvc_targets = sorted(name for name in changed if name.endswith(".dvc"))
        if any(name in changed for name in ("dvc.yaml", "dvc.lock")):
            dvc_targets.append("dvc.yaml")
        if dvc_targets:
            dvc_status = subprocess.run(["dvc", "status", *dvc_targets], cwd=root, text=True, capture_output=True)
            if dvc_status.returncode:
                fail(dvc_status.stderr.strip() or "dvc status failed")
            if "Data and pipelines are up to date." not in dvc_status.stdout:
                fail("dvc status reports changed or missing data")
        dvc_push = record.get("dvc_push")
        if not dvc_push or dvc_push["head"] != git(root, "rev-parse", "HEAD").stdout.strip():
            fail("DVC repository requires separately approved `dvc push` evidence at current HEAD")
    record["phase_profile"] = (validate_phase_profile(record["phase_profile"], record["cycle_id"])
                               if "phase_profile" in record
                               else unavailable_phase_report(record["cycle_id"]))
    if current_ahead:
        record["state"] = "finalizing"
        save(path, record)
        if record["delivery_intent"] == "draft_pr":
            remote_ref = f"refs/heads/{remote_branch}"
            existing = github_remote_head(root, remote_url, remote_ref, delivery_env)
            if existing and git(root, "merge-base", "--is-ancestor", existing[0], "HEAD", check=False).returncode:
                fail("feature branch changed remotely; normal push would not be safe")
        if record["delivery_intent"] == "draft_pr":
            push_github_branch(root, remote_url, remote_branch, delivery_env)
        else:
            git(root, "push", remote_url, f"HEAD:{remote_branch}")
    if record["delivery_intent"] == "draft_pr":
        remote_head = github_remote_head(
            root, remote_url, f"refs/heads/{remote_branch}", delivery_env
        )
        if not remote_head or git(root, "rev-parse", "HEAD").stdout.strip() != remote_head[0]:
            fail("push did not synchronize feature branch")
        record["delivery"]["pull_request"] = deliver_draft_pr(root, record, delivery_env)
        link_improvement_pull_request(record, record["delivery"]["pull_request"], root, target_head)
    elif git(root, "rev-parse", "HEAD").stdout.strip() != git(root, "rev-parse", current_upstream).stdout.strip():
        fail("push did not synchronize upstream")
    if reconciled and record["delivery_intent"] != "draft_pr":
        baseline["head"] = target_head
        baseline["reconciled_at"] = now()
    record["state"] = "completed"
    record["completed_at"] = now()
    save(path, record)
    source_sync = ({"status": "not_applicable", "reason": "draft_pr_delivery"}
                   if record["delivery_intent"] == "draft_pr"
        else sync_source_checkout(record, remote, remote_branch, root))
    record["source_sync"] = source_sync
    save(path, record)
    pointer.unlink()
    prefix = "draft_pr " + record["delivery"]["pull_request"]["url"] + " " if record["delivery_intent"] == "draft_pr" else ""
    profile = json.dumps(record["phase_profile"], sort_keys=True, separators=(",", ":"))
    print(prefix + "pushed " + " ".join(recorded_commits) + " source_sync=" + source_sync["status"]
          + " profile=" + profile)


def command_final_push(args):
    root = root_dir()
    path, record = load(root)
    refuse_local_delivery(record)
    with target_lock(root, record):
        finish_push(root, path, record)


def validate_reconciliation_paths(paths):
    if len(paths) > 8192 or any(len(name.encode("utf-8")) > 4096 for name in paths):
        fail("target reconciliation path output exceeded bounds")


def command_reconcile_target(args):
    root = root_dir()
    _, record = load(root)
    refuse_local_delivery(record)
    require_active(record)
    require_current_profile(root, record)
    if status_paths(root):
        fail("target reconciliation requires a clean worktree")
    for operation in ("MERGE_HEAD", "REBASE_HEAD", "CHERRY_PICK_HEAD", "REVERT_HEAD"):
        if git(root, "rev-parse", "--verify", "-q", operation, check=False).returncode == 0:
            fail("another Git operation is already active")

    baseline = record["git"]
    if not baseline["branch"] or branch(root) != baseline["branch"]:
        fail("HEAD is detached or not on the original branch")
    current_upstream = upstream(root)
    if not baseline["upstream"] or current_upstream != baseline["upstream"]:
        fail("upstream is missing or changed")
    if baseline["pre_cycle_ahead_commits"]:
        fail("pre-cycle ahead commits cannot be reconciled")
    if baseline.get("remote") != remote_destination(root, current_upstream):
        fail("remote push destination changed")

    recorded = [entry["id"] for entry in record["commits"]]
    first_parent = git(
        root, "rev-list", "--first-parent", "--reverse", f"{baseline['head']}..HEAD"
    ).stdout.splitlines()
    if not recorded or first_parent != recorded:
        fail("first-parent lineage is not exactly the recorded Gate Commits")

    remote, remote_branch = remote_for_upstream(root, current_upstream)
    if not remote or not remote_branch:
        fail("upstream is not a remote branch")
    with target_lock(root, record):
        git(root, "fetch", remote, remote_branch)
        target = git(root, "rev-parse", current_upstream).stdout.strip()
        if git(root, "merge-base", "--is-ancestor", baseline["head"], target,
               check=False).returncode:
            fail("delivery target no longer descends from the cycle baseline")
        if target == baseline["head"]:
            result = {"status": "up_to_date", "staged_paths": [], "conflict_paths": []}
        elif git(root, "merge-base", "--is-ancestor", target, "HEAD", check=False).returncode == 0:
            result = {"status": "integrated", "staged_paths": [], "conflict_paths": []}
        elif args.mode == "preview":
            result = {"status": "diverged", "staged_paths": [], "conflict_paths": []}
        else:
            merge_base = git(root, "merge-base", "HEAD", target).stdout.strip()
            anticipated = set()
            for side in ("HEAD", target):
                anticipated.update(filter(None, git(
                    root, "diff", "--no-renames", "--name-only", "-z", merge_base, side
                ).stdout.split("\0")))
            validate_reconciliation_paths(anticipated)
            merged = git(root, "merge", "--no-commit", "--no-ff", target, check=False)
            conflicts = sorted(set(git(
                root, "diff", "--name-only", "-z", "--diff-filter=U"
            ).stdout.split("\0")) - {""})
            staged = sorted(set(git(root, "diff", "--cached", "--name-only", "-z").stdout.split("\0")) - {""})
            if merged.returncode and not conflicts:
                fail(merged.stderr.strip() or "target merge failed without conflicts")
            validate_reconciliation_paths(set(staged) | set(conflicts))
            result = {
                "status": "conflicts" if conflicts else "prepared",
                "staged_paths": staged,
                "conflict_paths": conflicts,
            }
    print(json.dumps(result, sort_keys=True, separators=(",", ":")))


INFERENCE_TOKEN_COLUMNS = {
    "input": "tokens_input", "output": "tokens_output", "reasoning": "tokens_reasoning",
    "cache_read": "tokens_cache_read", "cache_write": "tokens_cache_write",
}


def inference_capabilities(connection):
    tables = {row[0].lower(): row[0] for row in connection.execute(
        "SELECT name FROM sqlite_master WHERE type='table'")}
    required = {
        "session": {"id", "time_created", "time_updated", "cost", *INFERENCE_TOKEN_COLUMNS.values()},
        "message": {"id", "session_id", "time_created", "time_updated", "data"},
        "part": {"id", "message_id", "session_id", "time_created", "time_updated", "data"},
    }
    capabilities = {}
    for name, canonical in required.items():
        if name not in tables:
            fail(f"OpenCode database is missing required {name} metadata table")
        columns = {row[1] for row in connection.execute(f'PRAGMA table_info("{tables[name]}")')}
        missing = sorted(canonical - columns)
        if missing:
            fail(f"OpenCode database is missing required metadata columns: {', '.join(missing)}")
        capabilities[name] = {"table": tables[name], "columns": sorted(canonical)}
    return capabilities


def inference_model(provider, model, variant):
    variant = variant if variant is not None else "default"
    if (not isinstance(provider, str) or not OPAQUE_ID.fullmatch(provider)
            or not isinstance(model, str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}", model)
            or not isinstance(variant, str) or not OPAQUE_ID.fullmatch(variant)):
        return "UNAVAILABLE", "UNAVAILABLE", "UNAVAILABLE"
    return provider, model, variant


def load_inference_mapping(path):
    if path is None:
        return {}
    try:
        value = json.loads(Path(path).expanduser().read_text(encoding="utf-8"), object_pairs_hook=no_duplicate_keys)
    except OSError:
        fail("cannot read inference context mapping")
    except json.JSONDecodeError:
        fail("inference context mapping is not valid JSON")
    sessions = value.get("sessions") if isinstance(value, dict) else None
    if (not isinstance(value, dict) or set(value) != {"schema_version", "sessions"}
            or value.get("schema_version") != 1 or not isinstance(sessions, dict)
            or any(not isinstance(key, str) or not OPAQUE_ID.fullmatch(key)
                   or not isinstance(context, str) or not OPAQUE_ID.fullmatch(context)
                   for key, context in sessions.items())):
        fail("inference context mapping has an invalid schema")
    return sessions


def inference_contexts(state_root, mapping):
    contexts = {}
    try:
        records = history_evidence(review_root(state_root))
    except (OSError, RuntimeError, json.JSONDecodeError):
        fail("cannot read sanitized DBSCTR history")
    for record in records:
        session_id = record["session_id"]
        quality = record.get("correlation_quality", "unavailable")
        intervals = []
        if quality in ("exact", "family", "ambiguous"):
            for cycle in record.get("cycles", []):
                if (cycle.get("state") not in ("completed", "active", "blocked")
                        or not isinstance(cycle.get("context"), str)
                        or type(cycle.get("started_at")) is not int
                        or cycle.get("ended_at") is not None and type(cycle["ended_at"]) is not int):
                    continue
                intervals.append({"context": cycle["context"], "started_at": cycle["started_at"],
                                  "ended_at": cycle["ended_at"]})
        contexts[session_id] = {"quality": quality, "intervals": intervals}
    for session_id, context in mapping.items():
        contexts.setdefault(session_id, {"quality": "unavailable", "intervals": []})["mapping"] = context
    return contexts


def inference_attribution(contexts, session_id, timestamp):
    evidence = contexts.get(session_id, {"quality": "unavailable", "intervals": []})
    matching = {item["context"] for item in evidence["intervals"]
                if item["started_at"] <= timestamp
                and (item["ended_at"] is None or timestamp < item["ended_at"])}
    if len(matching) > 1:
        attribution = {"context": "MULTI_CONTEXT", "status": "MULTI_CONTEXT",
                       "confidence": "UNAVAILABLE", "source": "DBSCTR_HISTORY"}
    elif matching:
        attribution = {"context": matching.pop(), "status": "ATTRIBUTED",
                       "confidence": "MEDIUM" if evidence["quality"] == "family" else "HIGH",
                       "source": "DBSCTR_HISTORY"}
    elif evidence["quality"] == "ambiguous" and not evidence["intervals"]:
        attribution = {"context": "MULTI_CONTEXT", "status": "MULTI_CONTEXT",
                       "confidence": "UNAVAILABLE", "source": "DBSCTR_HISTORY"}
    else:
        attribution = {"context": "UNKNOWN", "status": "UNKNOWN",
                       "confidence": "UNAVAILABLE", "source": "UNAVAILABLE"}
    mapped = evidence.get("mapping")
    if mapped is not None:
        if attribution["status"] == "UNKNOWN":
            attribution = {"context": mapped, "status": "ATTRIBUTED",
                           "confidence": "MEDIUM", "source": "EXPLICIT_MAPPING"}
        elif attribution["context"] != mapped:
            attribution = {"context": "MULTI_CONTEXT", "status": "MULTI_CONTEXT",
                           "confidence": "UNAVAILABLE", "source": "CONFLICT"}
    return attribution


def load_inference_rates(path):
    try:
        raw = Path(path).expanduser().read_bytes()
        value = json.loads(raw, object_pairs_hook=no_duplicate_keys)
    except OSError:
        fail("cannot read inference rate card")
    except json.JSONDecodeError:
        fail("inference rate card is not valid JSON")
    entries = value.get("entries") if isinstance(value, dict) else None
    if (not isinstance(value, dict) or set(value) != {"schema_version", "currency", "retrieved_at", "entries"}
            or value.get("schema_version") != 1 or value.get("currency") != "USD"
            or not isinstance(value.get("retrieved_at"), str) or not isinstance(entries, list)):
        fail("inference rate card has an invalid schema")
    parsed = []
    for entry in entries:
        rates = entry.get("usd_per_million_tokens") if isinstance(entry, dict) else None
        fields = {"provider", "model", "effective_from", "effective_to", "source",
                  "max_input_tokens", "usd_per_million_tokens"}
        try:
            converted = {name: (Decimal(str(rates[name])) if rates[name] is not None else None)
                         for name in INFERENCE_TOKEN_COLUMNS}
        except (KeyError, InvalidOperation, TypeError):
            fail("inference rate card has invalid token rates")
        source_value = entry.get("source") if isinstance(entry, dict) else None
        source = urlsplit(source_value) if isinstance(source_value, str) else urlsplit("")
        if (not isinstance(entry, dict) or set(entry) != fields
                or not isinstance(entry.get("provider"), str) or not OPAQUE_ID.fullmatch(entry["provider"])
                or not isinstance(entry.get("model"), str)
                or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}", entry["model"])
                or type(entry.get("effective_from")) is not int or entry["effective_from"] < 0
                or entry.get("effective_to") is not None and (type(entry["effective_to"]) is not int
                    or entry["effective_to"] <= entry["effective_from"])
                or entry.get("max_input_tokens") is not None and (type(entry["max_input_tokens"]) is not int
                    or entry["max_input_tokens"] < 1)
                or not isinstance(entry.get("source"), str) or source.scheme != "https" or not source.hostname
                or source.username is not None or source.password is not None or source.query or source.fragment
                or not isinstance(rates, dict) or set(rates) != set(INFERENCE_TOKEN_COLUMNS)
                or any(rate is not None and (not rate.is_finite() or rate < 0) for rate in converted.values())):
            fail("inference rate card has an invalid entry")
        rate_id = hashlib.sha256(json.dumps(entry, sort_keys=True, separators=(",", ":")).encode()).hexdigest()[:24]
        parsed.append({**entry, "rates": converted, "rate_id": rate_id})
    for index, entry in enumerate(parsed):
        for other in parsed[index + 1:]:
            if entry["provider"] != other["provider"] or entry["model"] != other["model"]:
                continue
            left_end = entry["effective_to"] if entry["effective_to"] is not None else 2**63 - 1
            right_end = other["effective_to"] if other["effective_to"] is not None else 2**63 - 1
            if max(entry["effective_from"], other["effective_from"]) < min(left_end, right_end):
                fail("inference rate card contains overlapping entries")
    return value, parsed, hashlib.sha256(raw).hexdigest()


def nearest_rank(values, fraction):
    ordered = sorted(values)
    return ordered[max(0, math.ceil(len(ordered) * fraction) - 1)]


def inference_number(value):
    value = round(float(value), 6)
    return int(value) if value.is_integer() else value


def inference_stats(values):
    if not values:
        return None
    return {
        "min": min(values), "p25": nearest_rank(values, .25),
        "mean": inference_number(sum(values) / len(values)), "median": inference_number(median(values)),
        "p75": nearest_rank(values, .75), "p95": nearest_rank(values, .95), "max": max(values),
        "population_standard_deviation": inference_number(pstdev(values)),
    }


def inference_money(value):
    return float(value.quantize(Decimal("0.000001")))


def inference_summary(context, records):
    token_total = sum(record["token_total"] for record in records)
    actual_covered = sum(record["token_total"] for record in records if record["actual_cost"] is not None)
    estimate_covered = sum(record["token_total"] for record in records if record["estimated_cost"] is not None)
    actual_values = [record["actual_cost"] for record in records if record["actual_cost"] is not None]
    estimate_values = [record["estimated_cost"] for record in records if record["estimated_cost"] is not None]
    grouped = {}
    for record in records:
        grouped.setdefault((record["provider"], record["model"], record["variant"]), []).append(record)
    models = []
    for (provider, model, variant), members in sorted(grouped.items()):
        models.append({
            "provider": provider, "model": model, "variant": variant,
            "session_count": len({item["session_key"] for item in members}),
            "usage_count": len(members),
            "tokens": sum(item["token_total"] for item in members),
            "actual_cost_usd": (inference_money(sum((item["actual_cost"] for item in members
                                                      if item["actual_cost"] is not None), Decimal()))
                                if any(item["actual_cost"] is not None for item in members) else None),
            "estimated_cost_usd": (inference_money(sum((item["estimated_cost"] for item in members
                                                         if item["estimated_cost"] is not None), Decimal()))
                                   if any(item["estimated_cost"] is not None for item in members) else None),
            "rate_entry_ids": sorted({item["rate_entry"]["id"] for item in members if item["rate_entry"]}),
        })
    sessions = {}
    for record in records:
        session = sessions.setdefault(record["session_key"], {"tokens": 0, "actual": Decimal(),
                                                               "estimated": Decimal(),
                                                               "has_actual": False, "has_estimated": False})
        session["tokens"] += record["token_total"]
        if record["actual_cost"] is not None:
            session["actual"] += record["actual_cost"]
            session["has_actual"] = True
        if record["estimated_cost"] is not None:
            session["estimated"] += record["estimated_cost"]
            session["has_estimated"] = True
    token_values = [item["tokens"] for item in sessions.values()]
    stats = inference_stats(token_values)
    mean = stats["mean"] if stats else 0
    attribution_tokens = sum(record["token_total"] for record in records
                             if record["attribution_status"] == "ATTRIBUTED")
    return {
        "bounded_context": context, "session_count": len(sessions), "usage_count": len(records),
        "reconciled_session_count": len({record["session_key"] for record in records if record["reconciled"]}),
        "unreconciled_session_count": len({record["session_key"] for record in records if not record["reconciled"]}),
        "reconciliation_coverage": (round(sum(record["token_total"] for record in records if record["reconciled"])
                                                  / token_total, 6) if token_total else 1.0),
        **{f"{name}_tokens": sum(record[name] for record in records) for name in INFERENCE_TOKEN_COLUMNS},
        "actual_cost_usd": inference_money(sum(actual_values, Decimal())) if actual_values else None,
        "estimated_cost_usd": inference_money(sum(estimate_values, Decimal())) if estimate_values else None,
        "actual_cost_coverage": round(actual_covered / token_total, 6) if token_total else 1.0,
        "estimated_cost_coverage": round(estimate_covered / token_total, 6) if token_total else 1.0,
        "attribution_coverage": round(attribution_tokens / token_total, 6) if token_total else 1.0,
        "attribution_statuses": {name: len({record["session_key"] for record in records
                                             if record["attribution_status"] == name})
                                 for name in ("ATTRIBUTED", "MULTI_CONTEXT", "UNKNOWN")},
        "attribution_confidence": {name: len({record["session_key"] for record in records
                                               if record["attribution_confidence"] == name})
                                   for name in ("HIGH", "MEDIUM", "UNAVAILABLE")},
        "attribution_sources": {name: len({record["session_key"] for record in records
                                            if record["attribution_source"] == name})
                                for name in ("DBSCTR_HISTORY", "EXPLICIT_MAPPING", "CONFLICT", "UNAVAILABLE")},
        "models": models, "tokens_per_session_stats": stats,
        "actual_cost_per_session_stats": inference_stats([float(item["actual"]) for item in sessions.values()
                                                           if item["has_actual"]]),
        "estimated_cost_per_session_stats": inference_stats([float(item["estimated"]) for item in sessions.values()
                                                              if item["has_estimated"]]),
        "p95_to_median_tokens": (round(stats["p95"] / stats["median"], 6)
                                  if stats and stats["median"] else None),
        "token_coefficient_of_variation": (round(stats["population_standard_deviation"] / mean, 6)
                                             if mean else None),
    }


def inference_markdown(report):
    lines = ["# OpenCode inference cost report", "", "| Bounded context | Sessions | Usage | Tokens | Actual USD | Actual coverage | Estimated USD | Estimated coverage | Attribution coverage | Reconciliation coverage | Models |", "|---|---:|---:|---:|---:|---:|---:|---:|---:|---:|---|"]
    for item in report["contexts"]:
        tokens = sum(item[f"{name}_tokens"] for name in INFERENCE_TOKEN_COLUMNS)
        models = ", ".join(sorted({f'{model["provider"]}/{model["model"]}' for model in item["models"]}))
        lines.append(f'| {item["bounded_context"]} | {item["session_count"]} | {item["usage_count"]} | {tokens} | '
                     f'{item["actual_cost_usd"] if item["actual_cost_usd"] is not None else "unavailable"} | '
                     f'{item["actual_cost_coverage"]:.1%} | '
                     f'{item["estimated_cost_usd"] if item["estimated_cost_usd"] is not None else "unavailable"} | '
                     f'{item["estimated_cost_coverage"]:.1%} | {item["attribution_coverage"]:.1%} | '
                     f'{item["reconciliation_coverage"]:.1%} | {models} |')
    lines.extend(["", "Costs are sums over covered usage; coverage shows the share of tokens represented."])
    return "\n".join(lines) + "\n"


def valid_inference_output(path):
    try:
        manifest = json.loads((path / "manifest.json").read_text(encoding="utf-8"))
        files = manifest["files"]
        return set(files) == {"inference-cost-report.json", "inference-cost-report.md"} and all(
            hashlib.sha256((path / name).read_bytes()).hexdigest() == digest
            for name, digest in files.items())
    except (KeyError, OSError, json.JSONDecodeError, TypeError):
        return False


def publish_inference_report(output, files):
    output = output.expanduser()
    output.parent.mkdir(parents=True, exist_ok=True)
    temporary = Path(tempfile.mkdtemp(prefix=f".{output.name}-", dir=output.parent))
    backup = output.parent / f".{output.name}-backup"
    try:
        if backup.exists():
            if output.exists():
                if valid_inference_output(output):
                    shutil.rmtree(backup)
                else:
                    interrupted = output.parent / f".{output.name}-interrupted"
                    if interrupted.exists():
                        fail("inference report requires manual recovery")
                    os.replace(output, interrupted)
                    os.replace(backup, output)
                    shutil.rmtree(interrupted)
            else:
                os.replace(backup, output)
        for name, content in files.items():
            (temporary / name).write_text(content, encoding="utf-8")
        if output.exists():
            os.replace(output, backup)
        try:
            os.replace(temporary, output)
        except Exception:
            if backup.exists():
                os.replace(backup, output)
            raise
        if backup.exists():
            shutil.rmtree(backup)
    finally:
        if temporary.exists():
            shutil.rmtree(temporary)


def command_inference_cost_report(args):
    database = Path(args.opencode_db).expanduser()
    if not database.is_file():
        fail("OpenCode database is missing")
    if args.after is not None and args.after < 0 or args.before is not None and args.before < 0:
        fail("inference report time bounds must be non-negative milliseconds")
    if args.after is not None and args.before is not None and args.after >= args.before:
        fail("inference report time bounds are invalid")
    rate_card, rates, rate_digest = load_inference_rates(args.rate_card)
    mapping = load_inference_mapping(args.mapping)
    try:
        connection = sqlite3.connect(f"file:{database}?mode=ro", uri=True)
        connection.execute("BEGIN")
        capabilities = inference_capabilities(connection)
        session_table = capabilities["session"]["table"]
        message_table = capabilities["message"]["table"]
        part_table = capabilities["part"]["table"]
        ceilings = {name: connection.execute(
            f'SELECT COALESCE(MAX(rowid), 0) FROM "{value["table"]}"').fetchone()[0]
                    for name, value in capabilities.items()}
        session_columns = ["id", "time_created", "time_updated", "cost", *INFERENCE_TOKEN_COLUMNS.values()]
        session_rows = connection.execute(
            f'SELECT {", ".join(f"\"{name}\"" for name in session_columns)} FROM "{session_table}" '
            f'WHERE rowid <= ? ORDER BY "id"', (ceilings["session"],),
        ).fetchall()
        part_rows = connection.execute(f'''SELECT
            p."id", p."session_id", p."time_created", p."time_updated", m."id",
            json_extract(m."data", '$.role'), json_extract(m."data", '$.providerID'),
            coalesce(json_extract(m."data", '$.modelID'), json_extract(m."data", '$.model.id')),
            coalesce(json_extract(m."data", '$.variant'), 'default'),
            json_extract(p."data", '$.cost'), json_extract(p."data", '$.tokens.input'),
            json_extract(p."data", '$.tokens.output'), json_extract(p."data", '$.tokens.reasoning'),
            json_extract(p."data", '$.tokens.cache.read'), json_extract(p."data", '$.tokens.cache.write')
            FROM "{part_table}" p
            LEFT JOIN "{message_table}" m ON m."id" = p."message_id" AND m."session_id" = p."session_id"
            WHERE p.rowid <= ? AND json_extract(p."data", '$.type') = 'step-finish'
            ORDER BY p."id"''', (ceilings["part"],)).fetchall()
    except sqlite3.Error as error:
        fail(f"cannot read OpenCode database: {error}")
    finally:
        if "connection" in locals():
            connection.close()
    source_identity, attribution_identity = hashlib.sha256(), hashlib.sha256()
    parts_by_session = {}
    for row in part_rows:
        part_id, session_id, timestamp, updated, message_id, role, provider, model, variant, raw_cost, *tokens = row
        if (not isinstance(part_id, str) or not OPAQUE_ID.fullmatch(part_id)
                or not isinstance(session_id, str) or not OPAQUE_ID.fullmatch(session_id)
                or not isinstance(message_id, str) or not OPAQUE_ID.fullmatch(message_id)
                or role != "assistant" or type(timestamp) is not int or timestamp < 0
                or type(updated) is not int or updated < timestamp
                or any(type(value) is not int for value in tokens)
                or not isinstance(raw_cost, (int, float)) or isinstance(raw_cost, bool)
                or not math.isfinite(raw_cost)):
            fail("OpenCode canonical usage metadata contains invalid values")
        provider, model, variant = inference_model(provider, model, variant)
        token_values = dict(zip(INFERENCE_TOKEN_COLUMNS, tokens))
        parts_by_session.setdefault(session_id, []).append({
            "part_key": part_id, "session_key": session_id, "timestamp": timestamp, "updated": updated,
            "provider": provider, "model": model, "variant": variant,
            "raw_cost": Decimal(str(raw_cost)), "valid_usage": raw_cost >= 0 and all(value >= 0 for value in tokens),
            "token_total": sum(tokens), **token_values,
        })
        source_identity.update(json.dumps(row, sort_keys=True, default=str).encode() + b"\0")
    contexts = inference_contexts(args.state_root, mapping)
    records = []
    for row in session_rows:
        session_id, timestamp, updated, raw_cost, *tokens = row
        if (not isinstance(session_id, str) or not OPAQUE_ID.fullmatch(session_id)
                or type(timestamp) is not int or timestamp < 0 or type(updated) is not int or updated < timestamp
                or any(type(value) is not int or value < 0 for value in tokens)
                or not isinstance(raw_cost, (int, float)) or isinstance(raw_cost, bool)
                or not math.isfinite(raw_cost) or raw_cost < 0):
            fail("OpenCode session metadata contains invalid values")
        token_values = dict(zip(INFERENCE_TOKEN_COLUMNS, tokens))
        total = sum(tokens)
        source_identity.update(json.dumps(row, sort_keys=True, default=str).encode() + b"\0")
        members = parts_by_session.pop(session_id, [])
        reconciled = (all(item["valid_usage"] for item in members)
                      and tokens == [sum(item[name] for item in members) for name in INFERENCE_TOKEN_COLUMNS]
                      and abs(sum((item["raw_cost"] for item in members), Decimal())
                              - Decimal(str(raw_cost))) <= Decimal("0.000001"))
        if not reconciled:
            if (args.after is not None and timestamp < args.after
                    or args.before is not None and timestamp >= args.before):
                continue
            actual = Decimal(str(raw_cost)) if raw_cost > 0 or total == 0 else None
            records.append({"session_key": session_id, "context": "UNKNOWN",
                            "attribution_status": "UNKNOWN", "attribution_confidence": "UNAVAILABLE",
                            "attribution_source": "UNAVAILABLE", "provider": "UNAVAILABLE",
                            "model": "UNAVAILABLE", "variant": "UNAVAILABLE", "actual_cost": actual,
                            "estimated_cost": None, "rate_entry": None, "reconciled": False,
                            "token_total": total, **token_values})
            continue
        for member in members:
            if (args.after is not None and member["timestamp"] < args.after
                    or args.before is not None and member["timestamp"] >= args.before):
                continue
            attribution = inference_attribution(contexts, session_id, member["timestamp"])
            matching = [entry for entry in rates
                        if entry["provider"] == member["provider"] and entry["model"] == member["model"]
                        and entry["effective_from"] <= member["timestamp"]
                        and (entry["effective_to"] is None or member["updated"] < entry["effective_to"])
                        and (entry["max_input_tokens"] is None or sum(member[name] for name in (
                            "input", "cache_read", "cache_write")) <= entry["max_input_tokens"])]
            estimated, rate_entry = None, None
            if len(matching) == 1 and all(
                    matching[0]["rates"][name] is not None or member[name] == 0
                    for name in INFERENCE_TOKEN_COLUMNS):
                estimated = sum((Decimal(member[name]) * (matching[0]["rates"][name] or Decimal())
                                 for name in INFERENCE_TOKEN_COLUMNS), Decimal()) / Decimal(1_000_000)
                rate_entry = {"id": matching[0]["rate_id"], "provider": member["provider"],
                              "model": member["model"], "effective_from": matching[0]["effective_from"],
                              "effective_to": matching[0]["effective_to"], "source": matching[0]["source"]}
            actual = member["raw_cost"] if member["raw_cost"] > 0 or member["token_total"] == 0 else None
            attribution_identity.update(
                f'{session_id}\0{member["part_key"]}\0{attribution["context"]}\0{attribution["status"]}\0'
                f'{attribution["confidence"]}\0{attribution["source"]}\0'.encode())
            records.append({"session_key": session_id, "context": attribution["context"],
                            "attribution_status": attribution["status"],
                            "attribution_confidence": attribution["confidence"],
                            "attribution_source": attribution["source"], "provider": member["provider"],
                            "model": member["model"], "variant": member["variant"], "actual_cost": actual,
                            "estimated_cost": estimated, "rate_entry": rate_entry, "reconciled": True,
                            "token_total": member["token_total"],
                            **{name: member[name] for name in INFERENCE_TOKEN_COLUMNS}})
    if parts_by_session:
        fail("OpenCode canonical usage references a missing session control")
    capability = {"adapter": "opencode_step_finish_v2",
                  "tables": {name: value["columns"] for name, value in capabilities.items()}}
    if args.dry_run:
        print(json.dumps({"schema_version": 2, "capabilities": capability,
                          "planned_session_count": len({record["session_key"] for record in records}),
                          "planned_usage_count": len(records),
                          "unreconciled_session_count": len({record["session_key"] for record in records
                                                              if not record["reconciled"]})},
                         sort_keys=True, separators=(",", ":")))
        return
    summaries = [inference_summary(context, [record for record in records if record["context"] == context])
                 for context in sorted({record["context"] for record in records})]
    used_rates = {record["rate_entry"]["id"]: record["rate_entry"] for record in records if record["rate_entry"]}
    report = {"schema_version": 2, "source_snapshot": {"session_ceiling": ceilings["session"],
               "message_ceiling": ceilings["message"], "part_ceiling": ceilings["part"],
               "database_digest": source_identity.hexdigest(), "after": args.after, "before": args.before,
               "attribution_digest": attribution_identity.hexdigest(), "capabilities": capability},
               "rate_card": {"schema_version": rate_card["schema_version"],
               "retrieved_at": rate_card["retrieved_at"], "digest": rate_digest,
               "used_entries": [used_rates[key] for key in sorted(used_rates)]},
               "contexts": summaries, "totals": inference_summary("ALL", records)}
    report_json = json.dumps(report, sort_keys=True, indent=2) + "\n"
    markdown = inference_markdown(report)
    generated = now()
    manifest = {"schema_version": 2, "generated_at": generated,
                "files": {"inference-cost-report.json": hashlib.sha256(report_json.encode()).hexdigest(),
                          "inference-cost-report.md": hashlib.sha256(markdown.encode()).hexdigest()},
                "source_snapshot": report["source_snapshot"], "rate_card": report["rate_card"]}
    try:
        publish_inference_report(Path(args.output_dir), {
            "inference-cost-report.json": report_json, "inference-cost-report.md": markdown,
            "manifest.json": json.dumps(manifest, sort_keys=True, indent=2) + "\n",
        })
    except OSError:
        fail("cannot publish inference report")
    print(json.dumps({"status": "written", "session_count": len({record["session_key"] for record in records}),
                      "usage_count": len(records),
                      "context_count": len(summaries)}, sort_keys=True, separators=(",", ":")))


def graphify_timeout(value):
    try:
        timeout = int(value)
    except ValueError as error:
        raise argparse.ArgumentTypeError("timeout must be an integer") from error
    if not 1 <= timeout <= 3600:
        raise argparse.ArgumentTypeError("timeout must be 1 through 3600 seconds")
    return timeout


