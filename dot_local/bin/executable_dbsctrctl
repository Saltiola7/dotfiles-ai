            started_at INTEGER NOT NULL,
            finished_at INTEGER,
            result TEXT,
            PRIMARY KEY (cycle_id, span_id)
        ) WITHOUT ROWID""")
        connection.execute("""CREATE TABLE execution_activation (
            method_revision TEXT PRIMARY KEY,
            payload TEXT NOT NULL
        ) WITHOUT ROWID""")
