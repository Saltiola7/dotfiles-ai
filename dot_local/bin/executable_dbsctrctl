        fail("private provider evaluation ledger has an unsupported schema")
    try:
        connection.execute("BEGIN IMMEDIATE")
        connection.execute("""CREATE TABLE provider_evaluation_reports (
            report_id TEXT PRIMARY KEY,
            rubric_key TEXT NOT NULL,
            harness_key TEXT NOT NULL,
            created_at INTEGER NOT NULL,
            payload TEXT NOT NULL
        ) WITHOUT ROWID""")
        connection.execute("""CREATE TABLE provider_evaluation_members (
            report_id TEXT NOT NULL REFERENCES provider_evaluation_reports(report_id) ON DELETE CASCADE,
            position INTEGER NOT NULL,
            rubric_key TEXT NOT NULL,
            harness_key TEXT NOT NULL,
            source_id TEXT NOT NULL,
            cycle_id TEXT NOT NULL,
