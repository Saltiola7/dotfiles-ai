                           (str(PROVIDER_EVALUATION_SCHEMA),))
        connection.commit()
    except Exception:
        connection.rollback()
        raise


def validate_provider_evaluation_report(value):
    fields = {"schema_version", "report_id", "rubric", "harness_identity", "members", "evidence", "aggregates",
              "availability", "confounders", "findings", "recommendations", "created_at", "association_only"}
    if (not isinstance(value, dict) or set(value) != fields or value.get("schema_version") != 1
            or not re.fullmatch(r"[0-9a-f]{24}", value.get("report_id", ""))
            or value.get("association_only") is not True or type(value.get("created_at")) is not int
            or value["created_at"] < REVIEW_START_MS
            or not isinstance(value.get("members"), list) or len(value["members"]) != 5
            or not isinstance(value.get("evidence"), list) or not value["evidence"]
            or not isinstance(value.get("aggregates"), dict) or not isinstance(value.get("availability"), dict)
            or not isinstance(value.get("confounders"), list)
            or not all(isinstance(item, str) and OPAQUE_ID.fullmatch(item) for item in value["confounders"])):
        fail("provider evaluation report has an invalid schema")
    if (not isinstance(value.get("rubric"), dict) or set(value["rubric"]) != {"name", "version", "digest"}
            or not OPAQUE_ID.fullmatch(value["rubric"].get("name", ""))
            or not OPAQUE_ID.fullmatch(value["rubric"].get("version", ""))
            or not re.fullmatch(r"[0-9a-f]{64}", value["rubric"].get("digest", ""))):
        fail("provider evaluation report has an invalid rubric")
    validate_stored_harness_activation({"schema_version": 1, **value.get("harness_identity", {})})
    optional = {"tool_call_count", "tool_error_count", "provider_error_count", "delegation_count",
                "approval_count", "retry_count", "token_total", "cost_total"}
    required = {"elapsed_ms_median", "gate_failure_count", "gate_reopen_count", "remediation_round_count"}
    if (set(value["availability"]) != optional
            or any(status not in ("available", "unavailable") for status in value["availability"].values())
            or set(value["aggregates"]) != required | {name for name in optional
                                                        if value["availability"][name] == "available"}
            or any(not isinstance(item, (int, float)) or isinstance(item, bool) or not math.isfinite(item) or item < 0
                   for item in value["aggregates"].values())):
        fail("provider evaluation report has invalid aggregates")
    member_fields = {"source_id", "cycle_id", "completed_at", "context", "risk", "delivery_intent",
                     "provider_ids", "model_ids", "agent_ids", "metrics", "optional_metrics",
                     "telemetry_digest", "gate_digest"}
    for member in value["members"]:
        if (not isinstance(member, dict) or set(member) != member_fields
                or not PRESENTATION_ID.fullmatch(member.get("source_id", ""))
                or not OPAQUE_ID.fullmatch(member.get("cycle_id", ""))
                or type(member.get("completed_at")) is not int or member["completed_at"] < REVIEW_START_MS
                or not isinstance(member.get("context"), str)
                or member["context"] != "unavailable" and not OPAQUE_ID.fullmatch(member["context"])
                or member.get("risk") not in ("routine", "elevated", "critical")
                or member.get("delivery_intent") not in DELIVERY_INTENTS
                or any(not isinstance(member.get(name), list) or not member[name]
                       or member[name] != sorted(set(member[name]))
                       or any(not isinstance(item, str)
                              or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}", item)
                              for item in member[name])
                       for name in ("provider_ids", "model_ids", "agent_ids"))
                or set(member.get("optional_metrics", {})) != optional
                or any(item != "unavailable" and (not isinstance(item, (int, float))
                    or isinstance(item, bool) or not math.isfinite(item) or item < 0)
                       for item in member["optional_metrics"].values())
                or not re.fullmatch(r"[0-9a-f]{64}", member.get("telemetry_digest", ""))
                or not re.fullmatch(r"[0-9a-f]{64}", member.get("gate_digest", ""))):
            fail("provider evaluation report has invalid members")
        validate_cycle_metrics(member["metrics"])
    for source in value["evidence"]:
        if (not isinstance(source, dict)
                or set(source) != {"source_id", "capture_id", "privacy_epoch_digest", "query_digest",
                                   "exclusion_digest", "pages"}
                or not PRESENTATION_ID.fullmatch(source.get("source_id", ""))
                or not re.fullmatch(r"[0-9a-f]{24}", source.get("capture_id", ""))
                or not re.fullmatch(r"[0-9a-f]{64}", source.get("privacy_epoch_digest", ""))
                or not re.fullmatch(r"[0-9a-f]{64}", source.get("query_digest", ""))
                or source.get("exclusion_digest") is not None
                and not re.fullmatch(r"[0-9a-f]{64}", source["exclusion_digest"])
                or not isinstance(source.get("pages"), list) or not source["pages"]):
            fail("provider evaluation report has invalid evidence")
        for page in source["pages"]:
            if (not isinstance(page, dict) or set(page) != {"cursor", "digest", "member_digests"}
                    or type(page.get("cursor")) is not int or page["cursor"] < 0
                    or not re.fullmatch(r"[0-9a-f]{64}", page.get("digest", ""))
                    or not isinstance(page.get("member_digests"), list)
                    or any(not re.fullmatch(r"[0-9a-f]{64}", item) for item in page["member_digests"])):
                fail("provider evaluation report has invalid evidence")
    for name in ("findings", "recommendations"):
        items = value.get(name)
        if (not isinstance(items, list) or len(items) > 50 or any(not isinstance(item, str)
                or not 1 <= len(item.encode()) <= 512 or review_unsafe(item) for item in items)):
            fail("provider evaluation report has unsafe prose")
    return value


def provider_evaluation_integrity(connection):
    expected = {"provider_evaluation_reports", "provider_evaluation_members",
                "provider_evaluation_receipts", "provider_evaluation_sources"}
    tables = {row[0] for row in connection.execute(
        "SELECT name FROM sqlite_master WHERE type='table' AND name LIKE 'provider_evaluation_%'")}
    if tables != expected:
        fail("private provider evaluation tables are invalid")
    for report_id, rubric_key, harness_key, created_at, payload in connection.execute(
            "SELECT report_id,rubric_key,harness_key,created_at,payload FROM provider_evaluation_reports"):
        report = validate_provider_evaluation_report(json.loads(payload, object_pairs_hook=no_duplicate_keys))
        rows = list(connection.execute(
            "SELECT position,source_id,cycle_id,payload FROM provider_evaluation_members "
            "WHERE report_id=? ORDER BY position", (report_id,)))
        if (report["report_id"] != report_id or report["created_at"] != created_at or len(rows) != 5
                or any(position != expected_position for expected_position, (position, *_rest) in enumerate(rows))
                or [json.loads(row[3], object_pairs_hook=no_duplicate_keys) for row in rows] != report["members"]
                or hashlib.sha256(ledger_payload(report["rubric"]).encode()).hexdigest() != rubric_key
                or hashlib.sha256(ledger_payload(report["harness_identity"]).encode()).hexdigest() != harness_key):
            fail("private provider evaluation membership mismatch")
        receipt = connection.execute(
            "SELECT payload FROM provider_evaluation_receipts WHERE report_id=?", (report_id,)).fetchone()
        if receipt is None:
            fail("private provider evaluation receipt is missing")
        stored_receipt = validate_provider_evaluation_receipt(
            json.loads(receipt[0], object_pairs_hook=no_duplicate_keys))
        if report["evidence"] != provider_evaluation_evidence(stored_receipt):
            fail("private provider evaluation receipt mismatch")
    for source_id, digest, availability, verified_at in connection.execute(
            "SELECT source_id,privacy_epoch_digest,availability,verified_at FROM provider_evaluation_sources"):
        if (not PRESENTATION_ID.fullmatch(source_id) or not re.fullmatch(r"[0-9a-f]{64}", digest)
                or availability not in ("available", "unavailable") or type(verified_at) is not int
                or verified_at < REVIEW_START_MS):
            fail("private provider evaluation source state is invalid")


def ensure_benchmark_schema(connection):
    ensure_capture_schema(connection)
    row = connection.execute("SELECT value FROM ledger_meta WHERE key='benchmark_schema'").fetchone()
    if row == (str(BENCHMARK_SCHEMA),):
        return
    if row is not None:
        fail("private benchmark ledger has an unsupported schema")
    try:
        connection.execute("BEGIN IMMEDIATE")
        connection.execute("""CREATE TABLE benchmark_definitions (
            version TEXT PRIMARY KEY,
            metric_name TEXT NOT NULL,
            direction TEXT NOT NULL CHECK (direction IN ('higher', 'lower'))
        ) WITHOUT ROWID""")
        connection.execute("""CREATE TABLE benchmark_effects (
            benchmark_id TEXT PRIMARY KEY,
            definition_version TEXT NOT NULL REFERENCES benchmark_definitions(version),
            baseline_capture_id TEXT NOT NULL REFERENCES history_captures(capture_id),
            observation_capture_id TEXT NOT NULL REFERENCES history_captures(capture_id),
            activation_identity TEXT,
            payload TEXT NOT NULL
        ) WITHOUT ROWID""")
        connection.execute("INSERT INTO ledger_meta VALUES ('benchmark_schema', ?)",
                           (str(BENCHMARK_SCHEMA),))
        connection.commit()
    except Exception:
        connection.rollback()
        raise


def benchmark_integrity(connection):
    expected = {"benchmark_definitions", "benchmark_effects"}
    tables = {row[0] for row in connection.execute(
        "SELECT name FROM sqlite_master WHERE type='table' AND name LIKE 'benchmark_%'")}
    if tables != expected:
        fail("private benchmark ledger tables are invalid")
    definitions = {version: (metric, direction) for version, metric, direction in connection.execute(
        "SELECT version, metric_name, direction FROM benchmark_definitions")}
    if any(not OPAQUE_ID.fullmatch(version) or metric not in BENCHMARK_METRICS
           or direction not in ("higher", "lower")
           for version, (metric, direction) in definitions.items()):
        fail("private benchmark definitions are invalid")
    merges, activations = {}, {}
    for benchmark_id, version, baseline, observation, activation, payload in connection.execute(
            "SELECT benchmark_id, definition_version, baseline_capture_id, observation_capture_id, "
            "activation_identity, payload FROM benchmark_effects"):
        try:
            report = json.loads(payload, object_pairs_hook=no_duplicate_keys)
        except json.JSONDecodeError as error:
            fail(f"private benchmark evidence is malformed: {error}")
        validate_benchmark(report)
        merge_identity = report["inputs"]["merge_identity"]
        merged_at = report["inputs"]["merged_at"]
        if merge_identity in merges and merges[merge_identity] != merged_at:
            fail("private benchmark merge identity is inconsistent")
        merges[merge_identity] = merged_at
        if report["inputs"]["activation_status"] == "verified":
            verified_activation = (report["inputs"]["activation_identity"], report["inputs"]["activated_at"])
            if merge_identity in activations and activations[merge_identity] != verified_activation:
                fail("private benchmark activation identity is inconsistent")
            activations[merge_identity] = verified_activation
        if (report["benchmark_id"] != benchmark_id or report["definition"]["version"] != version
                or report["definition"]["metric"] != definitions.get(version, (None, None))[0]
                or report["definition"]["direction"] != definitions.get(version, (None, None))[1]
                or report["inputs"]["baseline_capture_id"] != baseline
                or report["inputs"]["observation_capture_id"] != observation
                or report["inputs"]["activation_identity"] != activation):
            fail("private benchmark evidence columns mismatch")
        baseline_manifest, _ = load_history_capture(connection, baseline)
        observation_manifest, _ = load_history_capture(connection, observation)
        confounders = list(report["result"]["confounders"])
        if baseline_manifest["member_count"] != observation_manifest["member_count"]:
            if "population_drift" not in confounders:
                fail("private benchmark evidence semantic mismatch")
            confounders.remove("population_drift")
        expected_report = benchmark_report(argparse.Namespace(
            definition_version=version, metric=report["definition"]["metric"],
            direction=report["definition"]["direction"],
            merge_identity=report["inputs"]["merge_identity"], merged_at=report["inputs"]["merged_at"],
            activation_status=report["inputs"]["activation_status"],
            activation_identity=report["inputs"]["activation_identity"],
            activated_at=report["inputs"]["activated_at"], evaluated_at=report["evaluated_at"],
            confounder=confounders,
        ), baseline_manifest, observation_manifest)
        if expected_report != report:
            fail("private benchmark evidence semantic mismatch")


