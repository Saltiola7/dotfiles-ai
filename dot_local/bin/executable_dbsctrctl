def fail(message):
    raise RuntimeError(message)


def git(root, *args, check=True, env=None):
    result = subprocess.run(["git", *args], cwd=root, text=True, capture_output=True, env=env)
    if check and result.returncode:
        fail(result.stderr.strip() or f"git {' '.join(args)} failed")
    return result


def git_read(root, *args, check=True):
    result = subprocess.run(
        ["git", *args], cwd=root, text=True, capture_output=True,
        env={**os.environ, "GIT_OPTIONAL_LOCKS": "0"},
    )
    if check and result.returncode:
        fail(result.stderr.strip() or f"git {' '.join(args)} failed")
    return result


def inspect_git(root, *args, check=True):
    result = subprocess.run(["git", *args], cwd=root, text=True, capture_output=True, env=INSPECT_ENV)
    if check and result.returncode:
        fail(result.stderr.strip() or f"git {' '.join(args)} failed")
    return result


def inspect_git_bytes(root, *args):
    result = subprocess.run(["git", *args], cwd=root, capture_output=True, env=INSPECT_ENV)
    if result.returncode:
        fail(result.stderr.decode(errors="replace").strip() or f"git {' '.join(args)} failed")
    return result.stdout


def now():
    return datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")


def root_dir():
    result = subprocess.run(["git", "rev-parse", "--show-toplevel"], text=True, capture_output=True)
    if result.returncode:
        fail("not inside a Git repository")
    return Path(result.stdout.strip())


def git_dir(root):
    path = Path(git(root, "rev-parse", "--git-dir").stdout.strip())
    return path if path.is_absolute() else root / path


def common_git_dir(root):
    path = Path(git(root, "rev-parse", "--git-common-dir").stdout.strip())
    return path if path.is_absolute() else root / path


def legacy_worktree_id(root):
    return hashlib.sha256(str(root.resolve()).encode()).hexdigest()[:16]


def repository_identity(root):
    shallow = git(root, "rev-parse", "--is-shallow-repository").stdout.strip()
    if shallow != "false":
        fail("portable worktree identity requires a complete Git history")
    initial = git(root, "rev-list", "--max-parents=0", "HEAD").stdout.splitlines()
    if len(initial) != 1:
        fail("portable worktree identity requires exactly one Git root")
    return initial[0]


def worktree_id(root):
    identity = f"{repository_identity(root)}\0{branch(root) or 'detached'}"
    return hashlib.sha256(identity.encode()).hexdigest()[:16]


def dbsctr_state_root(value=None):
    if value:
        return Path(value).expanduser()
    if configured := os.environ.get("DBSCTR_STATE_ROOT"):
        return Path(configured).expanduser()
    if configured := os.environ.get("DOTFILES_AI_STATE_ROOT"):
        return Path(configured).expanduser() / "dbsctr"
    if configured := os.environ.get("XDG_STATE_HOME"):
        return Path(configured).expanduser() / "dbsctr"
    return Path.home() / ".local/state/dbsctr"


def worktree_registry_root(value=None):
    if value:
        return Path(value).expanduser()
    if configured := os.environ.get("DBSCTR_WORKTREE_ROOT"):
        return Path(configured).expanduser()
    return dbsctr_state_root() / "worktrees"


def opencode_database(value=None):
    if value:
        return Path(value).expanduser()
    data = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")).expanduser()
    return data / "opencode/opencode.db"


def primary_worktree(root):
    for line in git(root, "worktree", "list", "--porcelain").stdout.splitlines():
        if line.startswith("worktree "):
            return Path(line.removeprefix("worktree ")).resolve()
    fail("cannot resolve primary Git worktree")


def cycle_dir(root):
    return common_git_dir(root) / "dbsctr"


def active_path(root):
    return cycle_dir(root) / "worktrees" / worktree_id(root) / "active"


def legacy_active_path(root):
    return cycle_dir(root) / "worktrees" / legacy_worktree_id(root) / "active"


def active_pointer_id(root, path):
    if path.absolute() == (legacy_cycle_dir(root) / "active").absolute():
        safe_directory(legacy_cycle_dir(root), path.parent)
    else:
        managed_directory(root, path.parent)
    try:
        details = path.lstat()
    except OSError as error:
        fail(f"cannot inspect cycle active pointer: {error}")
    if (stat.S_IFMT(details.st_mode) != stat.S_IFREG or details.st_uid != os.getuid()
            or path.is_symlink()):
        fail("cycle active pointer is unsafe")
    cycle_id = path.read_text(encoding="utf-8").strip()
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", cycle_id):
        fail("cycle active pointer is unsafe")
    return cycle_id


def resolved_active_path(root):
    candidates = [legacy_active_path(root), legacy_cycle_dir(root) / "active"]
    with contextlib.suppress(RuntimeError):
        candidates.insert(0, active_path(root))
    for path in candidates:
        if path.exists():
            active_pointer_id(root, path)
            return path
        if path.is_symlink():
            fail("cycle active pointer is unsafe")
    return candidates[0]


def safe_directory(base, path, create=False):
    base = base.absolute()
    path = path.absolute()
    try:
        relative = path.relative_to(base)
    except ValueError:
        fail("managed DBSCTR directory escapes its root")
    if not base.exists():
        if base.is_symlink():
            fail("managed DBSCTR directory is unsafe")
        if not create:
            return False
        base.mkdir()
    details = base.lstat()
    if stat.S_IFMT(details.st_mode) != stat.S_IFDIR or details.st_uid != os.getuid() or base.is_symlink():
        fail("managed DBSCTR directory is unsafe")
    current = base
    for part in relative.parts:
        current = current / part
        if not current.exists():
            if current.is_symlink():
                fail("managed DBSCTR directory is unsafe")
            if not create:
                return False
            current.mkdir()
        details = current.lstat()
        if stat.S_IFMT(details.st_mode) != stat.S_IFDIR or details.st_uid != os.getuid() or current.is_symlink():
            fail("managed DBSCTR directory is unsafe")
    return True


def managed_directory(root, path, create=False):
    return safe_directory(cycle_dir(root), path, create)


def legacy_cycle_dir(root):
    return git_dir(root) / "dbsctr"


def atomic_json(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile("w", dir=path.parent, delete=False, encoding="utf-8") as handle:
        json.dump(value, handle, sort_keys=True, indent=2)
        handle.write("\n")
        temp = handle.name
    os.replace(temp, path)


def private_json(path, value):
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(path.parent, 0o700)
    descriptor, temporary = tempfile.mkstemp(dir=path.parent)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            json.dump(value, handle, sort_keys=True, separators=(",", ":"))
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        with contextlib.suppress(OSError):
            descriptor = os.open(path.parent, os.O_RDONLY)
            try:
                os.fsync(descriptor)
            finally:
                os.close(descriptor)
    finally:
        Path(temporary).unlink(missing_ok=True)


def fsync_directory(path):
    descriptor = os.open(path, os.O_RDONLY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def review_root(value=None):
    return dbsctr_state_root(value)


def review_unsafe(value):
    text = json.dumps(value, ensure_ascii=False) if not isinstance(value, str) else value
    return (SECRET_VALUE.search(text) or HIGH_ENTROPY.search(text) or
            re.search(r"\b[\w.+-]+@[\w.-]+\.[A-Za-z]{2,}\b", text) or
            re.search(r"\b(?:https?|ftp)://", text, re.I) or
            re.search(r"(?<![A-Za-z0-9._~-])(?:~|/)[^\s`)'\"\]}]+", text))


def review_digest(candidates, snapshot, session_ceiling=None, part_ceiling=None, database_digest=None):
    candidates = [{key: value for key, value in candidate.items() if not key.startswith("_")}
                  if isinstance(candidate, dict) else candidate for candidate in candidates]
    return hashlib.sha256(json.dumps({"candidates": candidates, "snapshot": snapshot,
                                      "session_ceiling": session_ceiling, "part_ceiling": part_ceiling,
                                      "database_digest": database_digest},
                                     separators=(",", ":"), sort_keys=True).encode()).hexdigest()


def session_id_digest(session_id):
    return hashlib.sha256(b"dbsctr-review-root\0" + session_id.encode()).hexdigest()


def review_lock(root):
    path = root / "reviews" / ".lock"
    if path.parent.is_symlink():
        fail("private review directory is unsafe")
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(path.parent, 0o700)
    private_path(path.parent, stat.S_IFDIR, 0o700, "review directory")
    flags = os.O_RDWR | os.O_CREAT | os.O_APPEND | getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(path, flags, 0o600)
        details = os.fstat(descriptor)
        if stat.S_IFMT(details.st_mode) != stat.S_IFREG or details.st_uid != os.getuid():
            fail("private review lock is unsafe")
        os.fchmod(descriptor, 0o600)
        return os.fdopen(descriptor, "a+", encoding="utf-8")
    except Exception:
        if "descriptor" in locals():
            os.close(descriptor)
        raise


def open_existing_review_lock(path):
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
    descriptor = os.open(path, flags)
    try:
        details = os.fstat(descriptor)
        if stat.S_IFMT(details.st_mode) != stat.S_IFREG or details.st_uid != os.getuid():
            fail("private review lock is unsafe")
        return os.fdopen(descriptor, "r", encoding="utf-8")
    except Exception:
        os.close(descriptor)
        raise


def excluded_review_family(connection, session, session_id):
    """Return the caller's connected parent/child family without exposing IDs."""
    sid = sqlite_name(connection, session, ("id",))
    parent = sqlite_name(connection, session, ("parentid", "parent")) if any(
        row[1].lower().replace("_", "") in ("parentid", "parent")
        for row in connection.execute(f'PRAGMA table_info("{session}")')
    ) else None
    if parent is None:
        return {session_id}
    return {str(row[0]) for row in connection.execute(f"""
        WITH RECURSIVE edges(source, target) AS (
            SELECT "{sid}", "{parent}" FROM "{session}" WHERE "{parent}" IS NOT NULL
            UNION SELECT "{parent}", "{sid}" FROM "{session}" WHERE "{parent}" IS NOT NULL
        ), excluded(session_id) AS (
            SELECT "{sid}" FROM "{session}" WHERE "{sid}" = ?
            UNION
            SELECT edges.target FROM edges JOIN excluded ON edges.source = excluded.session_id
        ) SELECT session_id FROM excluded
    """, (session_id,))} or {session_id}


def session_for_message(database_value, message_id, require_primary=False):
    if not OPAQUE_ID.fullmatch(message_id):
        fail("invalid excluded message ID")
    database = opencode_database(database_value)
    if not database.is_file():
        fail("OpenCode database is missing")
    try:
        connection = sqlite3.connect(f"file:{database}?mode=ro", uri=True)
        tables = {row[0].lower(): row[0] for row in connection.execute("SELECT name FROM sqlite_master WHERE type='table'")}
        if "message" not in tables:
            fail("OpenCode database lacks required message table")
        message = tables["message"]
        mid = sqlite_name(connection, message, ("id",))
        session = sqlite_name(connection, message, ("sessionid",))
        row = connection.execute(f'SELECT "{session}" FROM "{message}" WHERE "{mid}" = ?', (message_id,)).fetchone()
        if row is None or not isinstance(row[0], str) or not OPAQUE_ID.fullmatch(row[0]):
            fail("OpenCode message has no valid session")
        session_id = row[0]
        if require_primary:
            if "session" not in tables:
                fail("OpenCode database lacks required session table")
            session_table = tables["session"]
            session_pk = sqlite_name(connection, session_table, ("id",))
            parent = sqlite_name(connection, session_table, ("parentid", "parent"))
            owner = connection.execute(
                f'SELECT "{parent}" FROM "{session_table}" WHERE "{session_pk}" = ?', (session_id,)).fetchone()
            if owner is None or owner[0] is not None:
                fail("runtime attachment requires a primary OpenCode session")
        return session_id
    except sqlite3.Error as error:
        fail(f"cannot read OpenCode database: {error}")
    finally:
        if 'connection' in locals():
            connection.close()


def harness_activation_for_message(database_value, message_id, raw):
    try:
        supplied = json.loads(raw, object_pairs_hook=no_duplicate_keys)
    except (TypeError, json.JSONDecodeError) as error:
        fail(f"invalid harness activation: {error}")
    if (not isinstance(supplied, dict) or set(supplied) != {"schema_version", "core_revision", "overlays"}
            or supplied.get("schema_version") != HARNESS_ACTIVATION_SCHEMA
            or not OPAQUE_ID.fullmatch(supplied.get("core_revision", ""))
            or not isinstance(supplied.get("overlays"), dict)
            or set(supplied["overlays"]) != {"build", "build-gpt", "build-claude"}
            or any(not OPAQUE_ID.fullmatch(value) for value in supplied["overlays"].values())):
        fail("invalid harness activation")
    database = opencode_database(database_value)
    try:
        connection = sqlite3.connect(f"file:{database}?mode=ro", uri=True)
        tables = {row[0].lower(): row[0] for row in connection.execute(
            "SELECT name FROM sqlite_master WHERE type='table'")}
        if not {"session", "message"} <= set(tables):
            fail("OpenCode database lacks required session/message tables")
        session, message = tables["session"], tables["message"]
        sid, agent = sqlite_name(connection, session, ("id",)), sqlite_name(connection, session, ("agent",))
        mid, msession = sqlite_name(connection, message, ("id",)), sqlite_name(connection, message, ("sessionid",))
        data = sqlite_name(connection, message, ("data", "text", "content"))
        row = connection.execute(
            f'SELECT s."{agent}", m."{data}" FROM "{message}" m JOIN "{session}" s '
            f'ON s."{sid}"=m."{msession}" WHERE m."{mid}"=?', (message_id,)).fetchone()
        if row is None or row[0] not in supplied["overlays"]:
            fail("OpenCode message has no supported harness agent")
        body = json.loads(row[1], object_pairs_hook=no_duplicate_keys)
        if not isinstance(body, dict):
            fail("OpenCode message has no exact provider/model identity")
        model = body.get("model")
        provider_id = model.get("providerID") if isinstance(model, dict) else body.get("providerID")
        model_id = model.get("modelID") if isinstance(model, dict) else body.get("modelID")
        if (not isinstance(provider_id, str) or not OPAQUE_ID.fullmatch(provider_id)
                or not isinstance(model_id, str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}", model_id)):
            fail("OpenCode message has no exact provider/model identity")
        expected = {"build-gpt": "openai", "build-claude": "amazon-bedrock"}.get(row[0])
        if expected is not None and provider_id != expected:
            fail("OpenCode harness provider does not match its primary agent")
        return {"schema_version": HARNESS_ACTIVATION_SCHEMA, "provider_id": provider_id,
                "model_id": model_id, "agent_id": row[0], "core_revision": supplied["core_revision"],
                "overlay_revision": supplied["overlays"][row[0]]}
    except (sqlite3.Error, json.JSONDecodeError) as error:
        fail(f"cannot read harness activation: {error}")
    finally:
        if 'connection' in locals():
            connection.close()


def historical_excluded_family(database_value, session_id, message_id=None):
    if session_id is None and message_id is None:
        return set()
    if session_id is not None and not OPAQUE_ID.fullmatch(session_id):
        fail("invalid excluded session ID")
    database = opencode_database(database_value)
    if not database.is_file():
        fail("OpenCode database is missing")
    try:
        connection = sqlite3.connect(f"file:{database}?mode=ro", uri=True)
        tables = {row[0].lower(): row[0] for row in connection.execute("SELECT name FROM sqlite_master WHERE type='table'")}
        if "session" not in tables:
            fail("OpenCode database lacks required session table")
        roots = {value for value in (session_id, session_for_message(database_value, message_id)
                                     if message_id is not None else None) if value is not None}
        return set().union(*(excluded_review_family(connection, tables["session"], value) for value in roots))
    except sqlite3.Error as error:
        fail(f"cannot read OpenCode database: {error}")
    finally:
        if 'connection' in locals():
            connection.close()


def history_dir(root, name="", create=False):
    path = root / "reviews" / "history" / name
    if create:
        path.mkdir(parents=True, exist_ok=True, mode=0o700)
        os.chmod(path, 0o700)
    return path


def history_id(value, name="history ID"):
    if not isinstance(value, str) or not OPAQUE_ID.fullmatch(value):
        fail(f"invalid {name}")
    return value


def history_digest(value, name="digest"):
    if not isinstance(value, str) or not re.fullmatch(r"[0-9a-f]{64}", value):
        fail(f"invalid history {name}")
    return value


def model_family(value):
    name = value.rsplit("/", 1)[-1].lower()
    for family in ("gpt", "claude", "gemini", "llama", "mistral", "qwen"):
        if re.search(rf"(?:^|[._-]){family}(?:[._-]|$)", name):
            return family
    return "unavailable"


def ledger_path(root):
    return root / "reviews" / "ledger.sqlite3"


def ledger_exists(root):
    path = ledger_path(root)
    if path.exists() or path.is_symlink():
        private_path(path.parent, stat.S_IFDIR, 0o700, "review directory")
        private_path(path, stat.S_IFREG, 0o600, "review ledger")
    return path.is_file()


def private_path(path, kind, mode, name):
    try:
        details = path.lstat()
    except OSError as error:
        fail(f"cannot inspect private {name}: {error}")
    if stat.S_IFMT(details.st_mode) != kind or details.st_uid != os.getuid() or stat.S_IMODE(details.st_mode) != mode:
        fail(f"private {name} is unsafe")
    return path


def private_legacy_file(root, path):
    reviews = root / "reviews"
    private_path(reviews, stat.S_IFDIR, 0o700, "review directory")
    parent = path.parent
    while parent != reviews:
        if reviews not in parent.parents:
            fail("legacy private review path is outside its store")
        private_path(parent, stat.S_IFDIR, 0o700, "legacy review directory")
        parent = parent.parent
    private_path(path, stat.S_IFREG, 0o600, "legacy review file")
    return path


def ledger_connection(root, write=False, path=None):
    path = path or ledger_path(root)
    private_path(path.parent, stat.S_IFDIR, 0o700, "ledger directory")
    private_path(path, stat.S_IFREG, 0o600, "review ledger")
    try:
        connection = sqlite3.connect(str(path) if write else f"file:{path}?mode=ro", uri=not write)
        connection.execute("PRAGMA foreign_keys=ON")
        connection.execute("PRAGMA busy_timeout=5000")
        if write:
            connection.execute("PRAGMA synchronous=FULL")
            connection.execute("PRAGMA journal_mode=DELETE")
        row = connection.execute("SELECT value FROM ledger_meta WHERE key='schema_version'").fetchone()
        if row != (str(REVIEW_LEDGER_SCHEMA),):
            fail("private review ledger has an unsupported schema")
        improvement_schema = connection.execute(
            "SELECT value FROM ledger_meta WHERE key='improvement_schema'").fetchone()
        if write and improvement_schema in (("1",), ("2",), ("3",), ("4",)):
            if connection.execute("PRAGMA integrity_check").fetchone() != ("ok",):
                fail("private review ledger integrity check failed")
            if connection.execute("PRAGMA foreign_key_check").fetchone() is not None:
                fail("private review ledger foreign-key check failed")
            ensure_improvement_schema(connection)
        ledger_integrity(connection)
        if write:
            ensure_knowledge_privacy_schema(connection)
            ensure_incident_schema(connection)
        return connection
    except (sqlite3.Error, RuntimeError):
        if "connection" in locals():
            connection.close()
        raise


def ledger_schema(connection):
    connection.executescript("""
        CREATE TABLE ledger_meta (
            key TEXT PRIMARY KEY,
            value TEXT NOT NULL
        ) WITHOUT ROWID;
        CREATE TABLE review_reports (
            report_id TEXT PRIMARY KEY,
            reviewed_at INTEGER NOT NULL,
            payload TEXT NOT NULL
        ) WITHOUT ROWID;
        CREATE TABLE review_report_sessions (
            report_id TEXT NOT NULL REFERENCES review_reports(report_id) ON DELETE CASCADE,
            position INTEGER NOT NULL,
            session_id TEXT NOT NULL,
            PRIMARY KEY (report_id, position),
            UNIQUE (report_id, session_id)
        ) WITHOUT ROWID;
        CREATE TABLE review_report_cycles (
            report_id TEXT NOT NULL REFERENCES review_reports(report_id) ON DELETE CASCADE,
            position INTEGER NOT NULL,
            cycle_id TEXT NOT NULL,
            PRIMARY KEY (report_id, position),
            UNIQUE (report_id, cycle_id)
        ) WITHOUT ROWID;
        CREATE TABLE review_tombstones (
            kind TEXT NOT NULL CHECK (kind IN ('session', 'cycle', 'forgotten_session')),
            item_id TEXT NOT NULL,
            timestamp INTEGER NOT NULL,
            PRIMARY KEY (kind, item_id)
        ) WITHOUT ROWID;
        CREATE TABLE history_evidence (
            session_id TEXT PRIMARY KEY,
            completed_at INTEGER NOT NULL,
            payload TEXT NOT NULL
        ) WITHOUT ROWID;
        CREATE TABLE history_reports (
            report_id TEXT PRIMARY KEY,
            kind TEXT NOT NULL CHECK (kind IN ('report', 'cohort')),
            payload TEXT NOT NULL
        ) WITHOUT ROWID;
        CREATE TABLE history_report_members (
            report_id TEXT NOT NULL REFERENCES history_reports(report_id) ON DELETE CASCADE,
            position INTEGER NOT NULL,
            session_id TEXT NOT NULL,
            PRIMARY KEY (report_id, position),
            UNIQUE (report_id, session_id)
        ) WITHOUT ROWID;
        CREATE TABLE ledger_entries (
            scope TEXT NOT NULL CHECK (scope IN ('operational', 'history')),
            report_id TEXT NOT NULL,
            category TEXT NOT NULL CHECK (category IN ('finding', 'scorecard', 'trend', 'proposal', 'caveat')),
            position INTEGER NOT NULL,
            text TEXT NOT NULL,
            PRIMARY KEY (scope, report_id, category, position)
        ) WITHOUT ROWID;
        CREATE TABLE knowledge_privacy_tombstones (
            family TEXT NOT NULL,
            item_id TEXT NOT NULL,
            reason TEXT NOT NULL,
            timestamp INTEGER NOT NULL,
            PRIMARY KEY (family, item_id)
        ) WITHOUT ROWID;
        CREATE TABLE incidents (
            incident_id TEXT PRIMARY KEY,
            session_id TEXT NOT NULL UNIQUE,
            parent_session_id TEXT NOT NULL,
            message_id TEXT NOT NULL,
            kind TEXT NOT NULL CHECK (kind IN ('defect','friction','behavior_gap','capability_idea')),
            title TEXT NOT NULL,
            summary TEXT NOT NULL,
            state TEXT NOT NULL CHECK (state IN ('open','investigating','fixing','resolved','dismissed')),
            cycle_id TEXT,
            diagnostics TEXT NOT NULL,
            evidence TEXT NOT NULL,
            created_at INTEGER NOT NULL,
            updated_at INTEGER NOT NULL
        ) WITHOUT ROWID;
        CREATE TABLE incident_signal_dispositions (
            signal_id TEXT PRIMARY KEY,
            incident_id TEXT REFERENCES incidents(incident_id) ON DELETE SET NULL,
            disposition TEXT NOT NULL CHECK (disposition IN ('promoted','forgotten')),
            timestamp INTEGER NOT NULL
        ) WITHOUT ROWID;
    """)
    connection.execute("INSERT INTO ledger_meta VALUES ('schema_version', ?)", (str(REVIEW_LEDGER_SCHEMA),))
    connection.execute("INSERT INTO ledger_meta VALUES ('incident_schema', ?)", (str(INCIDENT_SCHEMA),))
    empty = hashlib.sha256(ledger_payload(
        {"schema_version": 1, "tombstones": []}).encode()).hexdigest()
    connection.execute("INSERT INTO ledger_meta VALUES ('knowledge_privacy_sequence', '0')")
    connection.execute("INSERT INTO ledger_meta VALUES ('knowledge_privacy_digest', ?)", (empty,))


def ledger_integrity(connection):
    if connection.execute("PRAGMA integrity_check").fetchone() != ("ok",):
        fail("private review ledger integrity check failed")
    if connection.execute("PRAGMA foreign_key_check").fetchone() is not None:
        fail("private review ledger foreign-key check failed")
    ledger_semantic_integrity(connection)


def ledger_semantic_integrity(connection):
    meta = dict(connection.execute("SELECT key, value FROM ledger_meta"))
    if (set(meta) - {"schema_version", "migration_digest", "pending_forget_cleanup", "improvement_schema", "capture_schema", "benchmark_schema", "phase_schema", "provider_evaluation_schema", "incident_schema", "knowledge_privacy_sequence", "knowledge_privacy_digest"}
            or meta.get("schema_version") != str(REVIEW_LEDGER_SCHEMA)
            or "migration_digest" in meta and not re.fullmatch(r"[0-9a-f]{64}", meta["migration_digest"])
            or "pending_forget_cleanup" in meta
            and not re.fullmatch(r"\.forget-[0-9a-f]{32}", meta["pending_forget_cleanup"])
            or "improvement_schema" in meta and meta["improvement_schema"] != str(IMPROVEMENT_SCHEMA)
            or "capture_schema" in meta and meta["capture_schema"] != str(CAPTURE_SCHEMA)
            or "benchmark_schema" in meta and meta["benchmark_schema"] != str(BENCHMARK_SCHEMA)
            or "phase_schema" in meta and meta["phase_schema"] != str(PHASE_SCHEMA)
            or "provider_evaluation_schema" in meta
            and meta["provider_evaluation_schema"] != str(PROVIDER_EVALUATION_SCHEMA)
            or "incident_schema" in meta and meta["incident_schema"] != str(INCIDENT_SCHEMA)
            or "knowledge_privacy_sequence" in meta
            and (not meta["knowledge_privacy_sequence"].isdigit()
                 or not 0 <= int(meta["knowledge_privacy_sequence"]) < 2**64)
            or "knowledge_privacy_digest" in meta
            and not re.fullmatch(r"[0-9a-f]{64}", meta["knowledge_privacy_digest"])):
        fail("private review ledger metadata is invalid")
    privacy_table = connection.execute(
        "SELECT 1 FROM sqlite_master WHERE type='table' "
        "AND name='knowledge_privacy_tombstones'").fetchone() is not None
    privacy_meta = {"knowledge_privacy_sequence", "knowledge_privacy_digest"}.intersection(meta)
    if privacy_table != (privacy_meta == {"knowledge_privacy_sequence", "knowledge_privacy_digest"}):
        fail("private review ledger privacy schema is incomplete")
    if privacy_table:
        for family, item_id, reason, timestamp in knowledge_privacy_rows(connection):
            if (not OPAQUE_ID.fullmatch(family) or not OPAQUE_ID.fullmatch(item_id)
                    or not OPAQUE_ID.fullmatch(reason) or not isinstance(timestamp, int)
                    or timestamp < REVIEW_START_MS):
                fail("private review ledger contains an invalid privacy tombstone")
        if meta["knowledge_privacy_digest"] != knowledge_privacy_digest(connection):
            fail("private review ledger privacy digest mismatch")
    incident_tables = {row[0] for row in connection.execute(
        "SELECT name FROM sqlite_master WHERE type='table' AND name IN "
        "('incidents','incident_signal_dispositions')")}
    if (incident_tables not in (set(), {"incidents", "incident_signal_dispositions"})
            or bool(incident_tables) != (meta.get("incident_schema") == str(INCIDENT_SCHEMA))):
        fail("private review ledger incident schema is incomplete")
    if incident_tables:
        for row in connection.execute(
                "SELECT incident_id,session_id,parent_session_id,message_id,kind,title,summary,state,cycle_id,"
                "diagnostics,evidence,created_at,updated_at FROM incidents"):
            incident_record(row)
        for signal_id, incident_id, disposition, timestamp in connection.execute(
                "SELECT signal_id,incident_id,disposition,timestamp FROM incident_signal_dispositions"):
            if (not re.fullmatch(r"[0-9a-f]{24}", signal_id)
                    or incident_id is not None and not re.fullmatch(r"[0-9a-f]{24}", incident_id)
                    or disposition not in ("promoted", "forgotten")
                    or type(timestamp) is not int or timestamp < REVIEW_START_MS):
                fail("private review ledger incident signal is invalid")
    names = {"session": "sessions", "cycle": "cycles", "forgotten_session": "forgotten_sessions"}
    tombstones = {"schema_version": 1, "sessions": {}, "cycles": {}, "forgotten_sessions": {}}
    for kind, item_id, timestamp in connection.execute(
            "SELECT kind, item_id, timestamp FROM review_tombstones"):
        if kind not in names:
            fail("private review ledger contains an invalid tombstone")
        tombstones[names[kind]][item_id] = timestamp
    for values in (tombstones["sessions"], tombstones["cycles"], tombstones["forgotten_sessions"]):
        if not all(isinstance(key, str) and OPAQUE_ID.fullmatch(key) and isinstance(timestamp, int)
                   and timestamp >= REVIEW_START_MS for key, timestamp in values.items()):
            fail("private review ledger contains an invalid tombstone")
    expected_entries = set()
    categories = {"findings": "finding", "scorecards": "scorecard", "trends": "trend",
                  "proposals": "proposal", "caveats": "caveat"}
    for report_id, timestamp, payload in connection.execute(
            "SELECT report_id, reviewed_at, payload FROM review_reports"):
        report, _ = validate_review_report(json.loads(payload, object_pairs_hook=no_duplicate_keys),
                                           f"{report_id}.json", timestamp)
        sessions = [row[0] for row in connection.execute(
            "SELECT session_id FROM review_report_sessions WHERE report_id=? ORDER BY position", (report_id,))]
        cycles = [row[0] for row in connection.execute(
            "SELECT cycle_id FROM review_report_cycles WHERE report_id=? ORDER BY position", (report_id,))]
        if sessions != report["session_ids"] or cycles != report.get("cycle_ids", []):
            fail("private review ledger report membership mismatch")
        expected_entries.update(("operational", report_id, category, position, text)
                                for field, category in categories.items()
                                for position, text in enumerate(report.get(field, [])))
    for session_id, completed_at, payload in connection.execute(
            "SELECT session_id, completed_at, payload FROM history_evidence"):
        evidence = validate_history_evidence(json.loads(payload, object_pairs_hook=no_duplicate_keys))
        if evidence["session_id"] != session_id or int(evidence["completed_at"]) != completed_at:
            fail("private review ledger history evidence mismatch")
    for report_id, _, payload in connection.execute("SELECT report_id, kind, payload FROM history_reports"):
        report = validate_history_report(json.loads(payload, object_pairs_hook=no_duplicate_keys))
        members = [row[0] for row in connection.execute(
            "SELECT session_id FROM history_report_members WHERE report_id=? ORDER BY position", (report_id,))]
        if report["report_id"] != report_id or members != report["cohort"]:
            fail("private review ledger history membership mismatch")
        expected_entries.update(("history", report_id, category, position, text)
                                for field, category in categories.items()
                                for position, text in enumerate(report.get(field, [])))
    actual_entries = set(connection.execute(
        "SELECT scope, report_id, category, position, text FROM ledger_entries"))
    if actual_entries != expected_entries:
        fail("private review ledger entry mismatch")
    if "improvement_schema" in meta:
        improvement_integrity(connection)
    if "capture_schema" in meta:
        capture_integrity(connection)
    if "benchmark_schema" in meta:
        benchmark_integrity(connection)
    if "phase_schema" in meta:
        phase_integrity(connection)
    if "provider_evaluation_schema" in meta:
        provider_evaluation_integrity(connection)


def ensure_improvement_schema(connection):
    row = connection.execute("SELECT value FROM ledger_meta WHERE key='improvement_schema'").fetchone()
    if row == (str(IMPROVEMENT_SCHEMA),):
        return
    if row == ("1",):
        try:
            connection.execute("BEGIN IMMEDIATE")
            connection.execute("ALTER TABLE improvement_workers ADD COLUMN priority TEXT "
                               "CHECK (priority IN ('P0','P1','P2','P3'))")
            connection.execute("UPDATE improvement_workers SET priority="
                               "CASE WHEN state='claimed' THEN 'P2' ELSE 'P1' END "
                               "WHERE opportunity_id IS NOT NULL")
            connection.execute("UPDATE ledger_meta SET value='2' WHERE key='improvement_schema'")
            connection.commit()
            row = ("2",)
        except Exception:
            connection.rollback()
            raise
    if row == ("2",):
        try:
            connection.execute("BEGIN IMMEDIATE")
            connection.execute("ALTER TABLE improvement_workers ADD COLUMN authorization TEXT NOT NULL "
                               "DEFAULT 'none' CHECK (authorization IN ('none','autonomous','operator'))")
            connection.execute("UPDATE improvement_workers SET authorization='operator' "
                               "WHERE state NOT IN ('reviewing','claimed','abandoned')")
            connection.execute("UPDATE ledger_meta SET value='3' WHERE key='improvement_schema'")
            connection.commit()
            row = ("3",)
        except Exception:
            connection.rollback()
            raise
    if row == ("3",):
        try:
            connection.execute("BEGIN IMMEDIATE")
            connection.execute("ALTER TABLE improvement_workers ADD COLUMN readiness TEXT")
            connection.execute("UPDATE improvement_workers SET authorization='operator' "
                               "WHERE authorization='autonomous'")
            connection.execute("UPDATE ledger_meta SET value='4' WHERE key='improvement_schema'")
            connection.commit()
            row = ("4",)
        except Exception:
            connection.rollback()
            raise
    if row == ("4",):
        try:
            connection.execute("BEGIN IMMEDIATE")
            connection.execute("ALTER TABLE improvement_workers ADD COLUMN kind TEXT "
                               "CHECK (kind IN ('fix','feature','process'))")
            connection.execute("ALTER TABLE improvement_workers ADD COLUMN measurement_plan TEXT")
            connection.execute("ALTER TABLE improvement_workers ADD COLUMN discovery_report TEXT")
            connection.execute("ALTER TABLE improvement_workers ADD COLUMN implementation_report TEXT")
            connection.execute("UPDATE improvement_workers SET kind='fix' WHERE opportunity_id IS NOT NULL")
            connection.execute("UPDATE ledger_meta SET value=? WHERE key='improvement_schema'",
                               (str(IMPROVEMENT_SCHEMA),))
            connection.commit()
            return
        except Exception:
            connection.rollback()
            raise
    if row is not None:
        fail("private improvement ledger has an unsupported schema")
    workers = """CREATE TABLE improvement_workers (
            worker_id TEXT PRIMARY KEY,
            session_id TEXT NOT NULL UNIQUE,
            opportunity_id TEXT UNIQUE,
            summary TEXT,
            priority TEXT CHECK (priority IN ('P0','P1','P2','P3')),
            kind TEXT CHECK (kind IN ('fix','feature','process')),
            measurement_plan TEXT,
            discovery_report TEXT,
            implementation_report TEXT,
            authorization TEXT NOT NULL DEFAULT 'none' CHECK (authorization IN ('none','autonomous','operator')),
            readiness TEXT,
            state TEXT NOT NULL CHECK (state IN (
                'reviewing', 'claimed', 'discovery', 'implementing', 'draft_pr',
                'blocked', 'merged', 'closed', 'abandoned'
            )),
            resume_state TEXT NOT NULL CHECK (resume_state IN (
                'reviewing', 'claimed', 'discovery', 'implementing', 'draft_pr'
            )),
            recovery_attempts INTEGER NOT NULL DEFAULT 0 CHECK (recovery_attempts BETWEEN 0 AND 3),
            workspace_id TEXT,
            tab_id TEXT,
            pane_id TEXT,
            cycle_id TEXT,
            pr_number INTEGER,
            pr_url TEXT,
            created_at INTEGER NOT NULL,
            updated_at INTEGER NOT NULL
        ) WITHOUT ROWID"""
    scope = """CREATE TABLE improvement_scope (
            worker_id TEXT NOT NULL REFERENCES improvement_workers(worker_id) ON DELETE CASCADE,
            path TEXT NOT NULL,
            PRIMARY KEY (worker_id, path)
        ) WITHOUT ROWID"""
    try:
        connection.execute("BEGIN IMMEDIATE")
        connection.execute(workers)
        connection.execute(scope)
        connection.execute("INSERT INTO ledger_meta VALUES ('improvement_schema', ?)",
                           (str(IMPROVEMENT_SCHEMA),))
        connection.commit()
    except Exception:
        connection.rollback()
        raise


def improvement_integrity(connection):
    expected_tables = {"improvement_workers", "improvement_scope"}
    tables = {row[0] for row in connection.execute(
        "SELECT name FROM sqlite_master WHERE type='table' AND name LIKE 'improvement_%'")}
    if tables != expected_tables:
        fail("private improvement ledger tables are invalid")
    for row in connection.execute("""
            SELECT worker_id, session_id, opportunity_id, summary, priority, kind, measurement_plan,
                   discovery_report, implementation_report, authorization, readiness, state, resume_state,
                   recovery_attempts, workspace_id, tab_id, pane_id, cycle_id,
                   pr_number, pr_url, created_at, updated_at
            FROM improvement_workers
    """):
        (worker_id, session_id, opportunity_id, summary, priority, kind, measurement_plan,
         discovery_report, implementation_report, authorization, readiness, state, resume_state, attempts, *rest) = row
        presentation_ids, cycle_id = rest[:3], rest[3]
        pr_number, pr_url, created_at, updated_at = rest[4:]
        if (not OPAQUE_ID.fullmatch(worker_id) or not OPAQUE_ID.fullmatch(session_id)
                or opportunity_id is not None and not re.fullmatch(r"[0-9a-f]{64}", opportunity_id)
                or summary is not None and (not isinstance(summary, str)
                                             or not 1 <= len(summary.encode()) <= 512 or review_unsafe(summary))
                or (opportunity_id is None) != (summary is None)
                or (opportunity_id is None) != (priority is None)
                or (opportunity_id is None) != (kind is None)
                or priority is not None and priority not in {"P0", "P1", "P2", "P3"}
                or kind is not None and kind not in {"fix", "feature", "process"}
                or kind == "feature" and measurement_plan is None
                or kind != "feature" and measurement_plan is not None
                or measurement_plan is not None and improvement_measurement_plan(measurement_plan) != measurement_plan
                or discovery_report is not None and improvement_discovery_report(discovery_report) != discovery_report
                or implementation_report is not None and improvement_implementation_report(implementation_report) != implementation_report
                or authorization not in {"none", "autonomous", "operator"}
                or readiness is not None and authorization != "autonomous"
                or authorization == "autonomous" and readiness is None
                or readiness is not None and improvement_readiness(
                    readiness, worker_id, session_id, opportunity_id) != readiness
                or state == "reviewing" and opportunity_id is not None
                or state in {"discovery", "implementing", "draft_pr"} and authorization == "none"
                or state not in IMPROVEMENT_STATES
                or resume_state not in IMPROVEMENT_RESUMABLE_STATES
                or not isinstance(attempts, int) or not 0 <= attempts <= 3
                or any(value is not None and not PRESENTATION_ID.fullmatch(value)
                       for value in presentation_ids)
                or cycle_id is not None and not OPAQUE_ID.fullmatch(cycle_id)
                or pr_number is not None and (not isinstance(pr_number, int) or pr_number < 1)
                or pr_url is not None and (not isinstance(pr_url, str) or len(pr_url) > 2048)
                or not isinstance(created_at, int) or not isinstance(updated_at, int)
                or created_at < REVIEW_START_MS or updated_at < created_at):
            fail("private improvement ledger contains an invalid worker")
    for worker_id, value in connection.execute("SELECT worker_id, path FROM improvement_scope"):
        if not OPAQUE_ID.fullmatch(worker_id) or improvement_path(value) != value:
            fail("private improvement ledger contains an invalid scope")


def ensure_capture_schema(connection):
    row = connection.execute("SELECT value FROM ledger_meta WHERE key='capture_schema'").fetchone()
    if row == (str(CAPTURE_SCHEMA),):
        return
    if row is not None:
        fail("private history capture ledger has an unsupported schema")
    try:
        connection.execute("BEGIN IMMEDIATE")
        connection.execute("""CREATE TABLE history_captures (
            capture_id TEXT PRIMARY KEY,
            payload TEXT NOT NULL
        ) WITHOUT ROWID""")
        connection.execute("""CREATE TABLE history_capture_members (
            capture_id TEXT NOT NULL REFERENCES history_captures(capture_id) ON DELETE CASCADE,
            position INTEGER NOT NULL,
            session_id TEXT NOT NULL,
            payload TEXT NOT NULL,
            PRIMARY KEY (capture_id, position),
            UNIQUE (capture_id, session_id)
        ) WITHOUT ROWID""")
        connection.execute("INSERT INTO ledger_meta VALUES ('capture_schema', ?)", (str(CAPTURE_SCHEMA),))
        connection.commit()
    except Exception:
        connection.rollback()
        raise


def capture_integrity(connection):
    expected = {"history_captures", "history_capture_members"}
    tables = {row[0] for row in connection.execute(
        "SELECT name FROM sqlite_master WHERE type='table' AND name LIKE 'history_capture%'")}
    if tables != expected:
        fail("private history capture tables are invalid")
    for capture_id, payload in connection.execute("SELECT capture_id, payload FROM history_captures"):
        try:
            manifest = json.loads(payload, object_pairs_hook=no_duplicate_keys)
        except json.JSONDecodeError as error:
            fail(f"private history capture is malformed: {error}")
        if manifest.get("capture_id") != capture_id:
            fail("private history capture identity mismatch")
        members = history_capture_members(connection, capture_id)
        validate_history_capture(manifest, members)


def history_capture_members(connection, capture_id):
    members = []
    for expected, (position, session_id, payload) in enumerate(connection.execute(
            "SELECT position, session_id, payload FROM history_capture_members "
            "WHERE capture_id=? ORDER BY position", (capture_id,))):
        try:
            record = json.loads(payload, object_pairs_hook=no_duplicate_keys)
        except json.JSONDecodeError as error:
            fail(f"private history capture member is malformed: {error}")
        if position != expected or record.get("session_id") != session_id:
            fail("private history capture member columns mismatch")
        members.append(record)
    return members


def ensure_provider_evaluation_schema(connection):
    row = connection.execute(
        "SELECT value FROM ledger_meta WHERE key='provider_evaluation_schema'").fetchone()
    if row == (str(PROVIDER_EVALUATION_SCHEMA),):
        return
    if row is not None:
        fail("private provider evaluation ledger has an unsupported schema")
    try:
        connection.execute("BEGIN IMMEDIATE")
        connection.execute("""CREATE TABLE provider_evaluation_reports (
            report_id TEXT PRIMARY KEY,
            rubric_key TEXT NOT NULL,
            harness_key TEXT NOT NULL,
            created_at INTEGER NOT NULL,
            payload TEXT NOT NULL
        ) WITHOUT ROWID""")
        connection.execute("""CREATE TABLE provider_evaluation_members (
            report_id TEXT NOT NULL REFERENCES provider_evaluation_reports(report_id) ON DELETE CASCADE,
            position INTEGER NOT NULL,
            rubric_key TEXT NOT NULL,
            harness_key TEXT NOT NULL,
            source_id TEXT NOT NULL,
            cycle_id TEXT NOT NULL,
            payload TEXT NOT NULL,
            PRIMARY KEY (report_id, position),
            UNIQUE (rubric_key, harness_key, source_id, cycle_id)
        ) WITHOUT ROWID""")
        connection.execute("""CREATE TABLE provider_evaluation_receipts (
            report_id TEXT PRIMARY KEY REFERENCES provider_evaluation_reports(report_id) ON DELETE CASCADE,
            payload TEXT NOT NULL
        ) WITHOUT ROWID""")
        connection.execute("""CREATE TABLE provider_evaluation_sources (
            source_id TEXT PRIMARY KEY,
            privacy_epoch_digest TEXT NOT NULL,
            availability TEXT NOT NULL CHECK (availability IN ('available', 'unavailable')),
            verified_at INTEGER NOT NULL
        ) WITHOUT ROWID""")
        connection.execute("INSERT INTO ledger_meta VALUES ('provider_evaluation_schema', ?)",
                           (str(PROVIDER_EVALUATION_SCHEMA),))
        connection.commit()
    except Exception:
        connection.rollback()
        raise


def validate_provider_evaluation_report(value):
    fields = {"schema_version", "report_id", "rubric", "harness_identity", "members", "evidence", "aggregates",
              "availability", "confounders", "findings", "recommendations", "created_at", "association_only"}
    if (not isinstance(value, dict) or set(value) != fields or value.get("schema_version") != 1
            or not re.fullmatch(r"[0-9a-f]{24}", value.get("report_id", ""))
            or value.get("association_only") is not True or type(value.get("created_at")) is not int
            or value["created_at"] < REVIEW_START_MS
            or not isinstance(value.get("members"), list) or len(value["members"]) != 5
            or not isinstance(value.get("evidence"), list) or not value["evidence"]
            or not isinstance(value.get("aggregates"), dict) or not isinstance(value.get("availability"), dict)
            or not isinstance(value.get("confounders"), list)
            or not all(isinstance(item, str) and OPAQUE_ID.fullmatch(item) for item in value["confounders"])):
        fail("provider evaluation report has an invalid schema")
    if (not isinstance(value.get("rubric"), dict) or set(value["rubric"]) != {"name", "version", "digest"}
            or not OPAQUE_ID.fullmatch(value["rubric"].get("name", ""))
            or not OPAQUE_ID.fullmatch(value["rubric"].get("version", ""))
            or not re.fullmatch(r"[0-9a-f]{64}", value["rubric"].get("digest", ""))):
        fail("provider evaluation report has an invalid rubric")
    validate_stored_harness_activation({"schema_version": 1, **value.get("harness_identity", {})})
    optional = {"tool_call_count", "tool_error_count", "provider_error_count", "delegation_count",
                "approval_count", "retry_count", "token_total", "cost_total"}
    required = {"elapsed_ms_median", "gate_failure_count", "gate_reopen_count", "remediation_round_count"}
    if (set(value["availability"]) != optional
            or any(status not in ("available", "unavailable") for status in value["availability"].values())
            or set(value["aggregates"]) != required | {name for name in optional
                                                        if value["availability"][name] == "available"}
            or any(not isinstance(item, (int, float)) or isinstance(item, bool) or not math.isfinite(item) or item < 0
                   for item in value["aggregates"].values())):
        fail("provider evaluation report has invalid aggregates")
    member_fields = {"source_id", "cycle_id", "completed_at", "context", "risk", "delivery_intent",
                     "provider_ids", "model_ids", "agent_ids", "metrics", "optional_metrics",
                     "telemetry_digest", "gate_digest"}
    for member in value["members"]:
        if (not isinstance(member, dict) or set(member) != member_fields
                or not PRESENTATION_ID.fullmatch(member.get("source_id", ""))
                or not OPAQUE_ID.fullmatch(member.get("cycle_id", ""))
                or type(member.get("completed_at")) is not int or member["completed_at"] < REVIEW_START_MS
                or not isinstance(member.get("context"), str)
                or member["context"] != "unavailable" and not OPAQUE_ID.fullmatch(member["context"])
                or member.get("risk") not in ("routine", "elevated", "critical")
                or member.get("delivery_intent") not in DELIVERY_INTENTS
                or any(not isinstance(member.get(name), list) or not member[name]
                       or member[name] != sorted(set(member[name]))
                       or any(not isinstance(item, str)
                              or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}", item)
                              for item in member[name])
                       for name in ("provider_ids", "model_ids", "agent_ids"))
                or set(member.get("optional_metrics", {})) != optional
                or any(item != "unavailable" and (not isinstance(item, (int, float))
                    or isinstance(item, bool) or not math.isfinite(item) or item < 0)
                       for item in member["optional_metrics"].values())
                or not re.fullmatch(r"[0-9a-f]{64}", member.get("telemetry_digest", ""))
                or not re.fullmatch(r"[0-9a-f]{64}", member.get("gate_digest", ""))):
            fail("provider evaluation report has invalid members")
        validate_cycle_metrics(member["metrics"])
    for source in value["evidence"]:
        if (not isinstance(source, dict)
                or set(source) != {"source_id", "capture_id", "privacy_epoch_digest", "query_digest",
                                   "exclusion_digest", "pages"}
                or not PRESENTATION_ID.fullmatch(source.get("source_id", ""))
                or not re.fullmatch(r"[0-9a-f]{24}", source.get("capture_id", ""))
                or not re.fullmatch(r"[0-9a-f]{64}", source.get("privacy_epoch_digest", ""))
                or not re.fullmatch(r"[0-9a-f]{64}", source.get("query_digest", ""))
                or source.get("exclusion_digest") is not None
                and not re.fullmatch(r"[0-9a-f]{64}", source["exclusion_digest"])
                or not isinstance(source.get("pages"), list) or not source["pages"]):
            fail("provider evaluation report has invalid evidence")
        for page in source["pages"]:
            if (not isinstance(page, dict) or set(page) != {"cursor", "digest", "member_digests"}
                    or type(page.get("cursor")) is not int or page["cursor"] < 0
                    or not re.fullmatch(r"[0-9a-f]{64}", page.get("digest", ""))
                    or not isinstance(page.get("member_digests"), list)
                    or any(not re.fullmatch(r"[0-9a-f]{64}", item) for item in page["member_digests"])):
                fail("provider evaluation report has invalid evidence")
    for name in ("findings", "recommendations"):
        items = value.get(name)
        if (not isinstance(items, list) or len(items) > 50 or any(not isinstance(item, str)
                or not 1 <= len(item.encode()) <= 512 or review_unsafe(item) for item in items)):
            fail("provider evaluation report has unsafe prose")
    return value


def provider_evaluation_integrity(connection):
    expected = {"provider_evaluation_reports", "provider_evaluation_members",
                "provider_evaluation_receipts", "provider_evaluation_sources"}
    tables = {row[0] for row in connection.execute(
        "SELECT name FROM sqlite_master WHERE type='table' AND name LIKE 'provider_evaluation_%'")}
    if tables != expected:
        fail("private provider evaluation tables are invalid")
    for report_id, rubric_key, harness_key, created_at, payload in connection.execute(
            "SELECT report_id,rubric_key,harness_key,created_at,payload FROM provider_evaluation_reports"):
        report = validate_provider_evaluation_report(json.loads(payload, object_pairs_hook=no_duplicate_keys))
        rows = list(connection.execute(
            "SELECT position,source_id,cycle_id,payload FROM provider_evaluation_members "
            "WHERE report_id=? ORDER BY position", (report_id,)))
        if (report["report_id"] != report_id or report["created_at"] != created_at or len(rows) != 5
                or any(position != expected_position for expected_position, (position, *_rest) in enumerate(rows))
                or [json.loads(row[3], object_pairs_hook=no_duplicate_keys) for row in rows] != report["members"]
                or hashlib.sha256(ledger_payload(report["rubric"]).encode()).hexdigest() != rubric_key
                or hashlib.sha256(ledger_payload(report["harness_identity"]).encode()).hexdigest() != harness_key):
            fail("private provider evaluation membership mismatch")
        receipt = connection.execute(
            "SELECT payload FROM provider_evaluation_receipts WHERE report_id=?", (report_id,)).fetchone()
        if receipt is None:
            fail("private provider evaluation receipt is missing")
        stored_receipt = validate_provider_evaluation_receipt(
            json.loads(receipt[0], object_pairs_hook=no_duplicate_keys))
        if report["evidence"] != provider_evaluation_evidence(stored_receipt):
            fail("private provider evaluation receipt mismatch")
    for source_id, digest, availability, verified_at in connection.execute(
            "SELECT source_id,privacy_epoch_digest,availability,verified_at FROM provider_evaluation_sources"):
        if (not PRESENTATION_ID.fullmatch(source_id) or not re.fullmatch(r"[0-9a-f]{64}", digest)
                or availability not in ("available", "unavailable") or type(verified_at) is not int
                or verified_at < REVIEW_START_MS):
            fail("private provider evaluation source state is invalid")


def ensure_benchmark_schema(connection):
    ensure_capture_schema(connection)
    row = connection.execute("SELECT value FROM ledger_meta WHERE key='benchmark_schema'").fetchone()
    if row == (str(BENCHMARK_SCHEMA),):
        return
    if row is not None:
        fail("private benchmark ledger has an unsupported schema")
    try:
        connection.execute("BEGIN IMMEDIATE")
        connection.execute("""CREATE TABLE benchmark_definitions (
            version TEXT PRIMARY KEY,
            metric_name TEXT NOT NULL,
            direction TEXT NOT NULL CHECK (direction IN ('higher', 'lower'))
        ) WITHOUT ROWID""")
        connection.execute("""CREATE TABLE benchmark_effects (
            benchmark_id TEXT PRIMARY KEY,
            definition_version TEXT NOT NULL REFERENCES benchmark_definitions(version),
            baseline_capture_id TEXT NOT NULL REFERENCES history_captures(capture_id),
            observation_capture_id TEXT NOT NULL REFERENCES history_captures(capture_id),
            activation_identity TEXT,
            payload TEXT NOT NULL
        ) WITHOUT ROWID""")
        connection.execute("INSERT INTO ledger_meta VALUES ('benchmark_schema', ?)",
                           (str(BENCHMARK_SCHEMA),))
        connection.commit()
    except Exception:
        connection.rollback()
        raise


def benchmark_integrity(connection):
    expected = {"benchmark_definitions", "benchmark_effects"}
    tables = {row[0] for row in connection.execute(
        "SELECT name FROM sqlite_master WHERE type='table' AND name LIKE 'benchmark_%'")}
    if tables != expected:
        fail("private benchmark ledger tables are invalid")
    definitions = {version: (metric, direction) for version, metric, direction in connection.execute(
        "SELECT version, metric_name, direction FROM benchmark_definitions")}
    if any(not OPAQUE_ID.fullmatch(version) or metric not in BENCHMARK_METRICS
           or direction not in ("higher", "lower")
           for version, (metric, direction) in definitions.items()):
        fail("private benchmark definitions are invalid")
    merges, activations = {}, {}
    for benchmark_id, version, baseline, observation, activation, payload in connection.execute(
            "SELECT benchmark_id, definition_version, baseline_capture_id, observation_capture_id, "
            "activation_identity, payload FROM benchmark_effects"):
        try:
            report = json.loads(payload, object_pairs_hook=no_duplicate_keys)
        except json.JSONDecodeError as error:
            fail(f"private benchmark evidence is malformed: {error}")
        validate_benchmark(report)
        merge_identity = report["inputs"]["merge_identity"]
        merged_at = report["inputs"]["merged_at"]
        if merge_identity in merges and merges[merge_identity] != merged_at:
            fail("private benchmark merge identity is inconsistent")
        merges[merge_identity] = merged_at
        if report["inputs"]["activation_status"] == "verified":
            verified_activation = (report["inputs"]["activation_identity"], report["inputs"]["activated_at"])
            if merge_identity in activations and activations[merge_identity] != verified_activation:
                fail("private benchmark activation identity is inconsistent")
            activations[merge_identity] = verified_activation
        if (report["benchmark_id"] != benchmark_id or report["definition"]["version"] != version
                or report["definition"]["metric"] != definitions.get(version, (None, None))[0]
                or report["definition"]["direction"] != definitions.get(version, (None, None))[1]
                or report["inputs"]["baseline_capture_id"] != baseline
                or report["inputs"]["observation_capture_id"] != observation
                or report["inputs"]["activation_identity"] != activation):
            fail("private benchmark evidence columns mismatch")
        baseline_manifest, _ = load_history_capture(connection, baseline)
        observation_manifest, _ = load_history_capture(connection, observation)
        confounders = list(report["result"]["confounders"])
        if baseline_manifest["member_count"] != observation_manifest["member_count"]:
            if "population_drift" not in confounders:
                fail("private benchmark evidence semantic mismatch")
            confounders.remove("population_drift")
        expected_report = benchmark_report(argparse.Namespace(
            definition_version=version, metric=report["definition"]["metric"],
            direction=report["definition"]["direction"],
            merge_identity=report["inputs"]["merge_identity"], merged_at=report["inputs"]["merged_at"],
            activation_status=report["inputs"]["activation_status"],
            activation_identity=report["inputs"]["activation_identity"],
            activated_at=report["inputs"]["activated_at"], evaluated_at=report["evaluated_at"],
            confounder=confounders,
        ), baseline_manifest, observation_manifest)
        if expected_report != report:
            fail("private benchmark evidence semantic mismatch")


def ensure_phase_schema(connection):
    row = connection.execute("SELECT value FROM ledger_meta WHERE key='phase_schema'").fetchone()
    if row == (str(PHASE_SCHEMA),):
        return
    if row is not None:
        fail("private phase-span ledger has an unsupported schema")
    try:
        connection.execute("BEGIN IMMEDIATE")
        connection.execute("""CREATE TABLE phase_spans (
            cycle_id TEXT NOT NULL,
            span_id TEXT NOT NULL,
            parent_span_id TEXT,
            phase TEXT NOT NULL,
            operation TEXT NOT NULL,
            attribution TEXT NOT NULL,
            dependencies TEXT NOT NULL,
            ownership_paths TEXT NOT NULL,
            started_at INTEGER NOT NULL,
            finished_at INTEGER,
            result TEXT,
            PRIMARY KEY (cycle_id, span_id)
        ) WITHOUT ROWID""")
        connection.execute("""CREATE TABLE execution_activation (
            method_revision TEXT PRIMARY KEY,
            payload TEXT NOT NULL
        ) WITHOUT ROWID""")
        connection.execute("INSERT INTO ledger_meta VALUES ('phase_schema', ?)", (str(PHASE_SCHEMA),))
        connection.commit()
    except Exception:
        connection.rollback()
        raise


def phase_path(value):
    if not isinstance(value, str):
        fail("invalid phase ownership path")
    pure = PurePosixPath(value)
    normalized = str(pure)
    if (pure.is_absolute() or not pure.parts or ".." in pure.parts or normalized in ("", ".")
            or len(normalized.encode()) > 512 or pure.parts[0].endswith(":")
            or any(ord(character) < 32 or character == "\\" for character in normalized)
            or review_unsafe(normalized)):
        fail("invalid phase ownership path")
    return normalized


def phase_record(row):
    names = ("cycle_id", "span_id", "parent_span_id", "phase", "operation", "attribution",
             "dependencies", "ownership_paths", "started_at", "finished_at", "result")
    value = dict(zip(names, row))
    try:
        value["dependencies"] = json.loads(value["dependencies"], object_pairs_hook=no_duplicate_keys)
        value["ownership_paths"] = json.loads(value["ownership_paths"], object_pairs_hook=no_duplicate_keys)
    except json.JSONDecodeError as error:
        fail(f"private phase span is malformed: {error}")
    if (not OPAQUE_ID.fullmatch(value["cycle_id"]) or not OPAQUE_ID.fullmatch(value["span_id"])
            or value["parent_span_id"] is not None and (not OPAQUE_ID.fullmatch(value["parent_span_id"])
                or value["parent_span_id"] == value["span_id"])
            or value["phase"] not in PHASES or value["operation"] not in PHASE_OPERATIONS
            or value["attribution"] not in ("explicit", "adapter", "unavailable")
            or not isinstance(value["dependencies"], list)
            or len(value["dependencies"]) > 100 or len(set(value["dependencies"])) != len(value["dependencies"])
            or any(not isinstance(item, str) or not OPAQUE_ID.fullmatch(item)
                   or item == value["span_id"] for item in value["dependencies"])
            or not isinstance(value["ownership_paths"], list) or len(value["ownership_paths"]) > 100
            or sorted(set(map(phase_path, value["ownership_paths"]))) != value["ownership_paths"]
            or not isinstance(value["started_at"], int) or value["started_at"] < REVIEW_START_MS
            or value["finished_at"] is not None and (not isinstance(value["finished_at"], int)
                or value["finished_at"] < value["started_at"])
            or (value["finished_at"] is None) != (value["result"] is None)
            or value["result"] is not None
            and value["result"] not in ("passed", "failed", "blocked", "abandoned", "unavailable")):
        fail("private phase span is invalid")
    return value


def phase_integrity(connection):
    tables = {row[0] for row in connection.execute(
        "SELECT name FROM sqlite_master WHERE type='table' AND name LIKE 'phase_%'")}
    if tables != {"phase_spans"}:
        fail("private phase-span tables are invalid")
    records = [phase_record(row) for row in connection.execute(
            "SELECT cycle_id, span_id, parent_span_id, phase, operation, attribution, dependencies, "
            "ownership_paths, started_at, finished_at, result FROM phase_spans")]
    by_cycle = {}
    for record in records:
        by_cycle.setdefault(record["cycle_id"], {})[record["span_id"]] = record
    for spans in by_cycle.values():
        for record in spans.values():
            if record["parent_span_id"] is not None and record["parent_span_id"] not in spans:
                fail("private phase span parent is missing")
            for dependency in record["dependencies"]:
                if dependency not in spans:
                    fail("private phase span dependency is missing")
                parent = spans[dependency]
                if parent["finished_at"] is None or record["started_at"] < parent["finished_at"]:
                    fail("private phase span dependency timing is invalid")
        pending = {key: set(record["dependencies"]) for key, record in spans.items()}
        while pending:
            ready = [key for key, dependencies in pending.items() if not dependencies]
            if not ready:
                fail("private phase span dependency cycle")
            for key in ready:
                pending.pop(key)
            for dependencies in pending.values():
                dependencies.difference_update(ready)
    activation_tables = {row[0] for row in connection.execute(
        "SELECT name FROM sqlite_master WHERE type='table' AND name='execution_activation'")}
    if activation_tables != {"execution_activation"}:
        fail("private execution activation table is invalid")
    for method_revision, payload in connection.execute(
            "SELECT method_revision, payload FROM execution_activation"):
        report = validate_execution_benchmark(json.loads(payload, object_pairs_hook=no_duplicate_keys))
        if report["method_revision"] != method_revision:
            fail("private execution activation identity mismatch")


def phase_rows(connection, cycle_id):
    return [phase_record(row) for row in connection.execute(
        "SELECT cycle_id, span_id, parent_span_id, phase, operation, attribution, dependencies, "
        "ownership_paths, started_at, finished_at, result FROM phase_spans "
        "WHERE cycle_id=? ORDER BY span_id", (cycle_id,))]


def unavailable_phase_report(cycle_id):
    return {"schema_version": 1, "cycle_id": cycle_id, "status": "unavailable",
            "total_wall_ms": "unavailable", "critical_path_ms": "unavailable",
            "overlap_ms": "unavailable", "principal_waits": [], "repeated_work": 0,
            "attribution_caveats": ["no_phase_spans"]}


def validate_phase_profile(value, cycle_id=None):
    fields = {"schema_version", "cycle_id", "status", "total_wall_ms", "critical_path_ms",
              "overlap_ms", "principal_waits", "repeated_work", "attribution_caveats"}
    caveats = {"no_phase_spans", "incomplete_spans", "adapter_timing", "unavailable_timing"}
    if (not isinstance(value, dict) or set(value) != fields or value.get("schema_version") != 1
            or not isinstance(value.get("cycle_id"), str) or not OPAQUE_ID.fullmatch(value["cycle_id"])
            or cycle_id is not None and value["cycle_id"] != cycle_id
            or value.get("status") not in ("complete", "partial", "unavailable")
            or type(value.get("repeated_work")) is not int or value["repeated_work"] < 0
            or not isinstance(value.get("principal_waits"), list) or len(value["principal_waits"]) > 5
            or not isinstance(value.get("attribution_caveats"), list)
            or len(set(value["attribution_caveats"])) != len(value["attribution_caveats"])
            or any(item not in caveats for item in value["attribution_caveats"])):
        fail("phase profile is invalid")
    timings = [value[name] for name in ("total_wall_ms", "critical_path_ms", "overlap_ms")]
    if (value["status"] == "complete" and any(type(item) is not int or item < 0 for item in timings)
            or value["status"] != "complete" and any(item != "unavailable" for item in timings)):
        fail("phase profile timing is invalid")
    for wait in value["principal_waits"]:
        if (not isinstance(wait, dict) or set(wait) != {"span_id", "wait_ms"}
                or not isinstance(wait.get("span_id"), str) or not OPAQUE_ID.fullmatch(wait["span_id"])
                or type(wait.get("wait_ms")) is not int or wait["wait_ms"] < 0):
            fail("phase profile wait is invalid")
    return value


def phase_report(rows, cycle_id):
    if not rows:
        return unavailable_phase_report(cycle_id)
    spans = {item["span_id"]: item for item in rows}
    missing = sorted({dependency for item in rows for dependency in item["dependencies"]
                      if dependency not in spans})
    order = []
    if not missing:
        indegree = {key: len(item["dependencies"]) for key, item in spans.items()}
        children = {key: [] for key in spans}
        for key, item in spans.items():
            for dependency in item["dependencies"]:
                children[dependency].append(key)
        ready = sorted(key for key, degree in indegree.items() if degree == 0)
        while ready:
            key = ready.pop(0)
            order.append(key)
            for child in sorted(children[key]):
                indegree[child] -= 1
                if indegree[child] == 0:
                    ready.append(child)
                    ready.sort()
    complete = (not missing and len(order) == len(spans)
                and all(item["finished_at"] is not None for item in rows))
    caveats = []
    if not complete:
        caveats.append("incomplete_spans")
    if any(item["attribution"] == "adapter" for item in rows):
        caveats.append("adapter_timing")
    if any(item["attribution"] == "unavailable" for item in rows):
        caveats.append("unavailable_timing")
    repeated = len(rows) - len({(item["phase"], item["operation"], tuple(item["ownership_paths"]))
                                for item in rows})
    if not complete:
        return validate_phase_profile({**unavailable_phase_report(cycle_id), "status": "partial",
                                       "repeated_work": repeated, "attribution_caveats": caveats})
    durations = {key: item["finished_at"] - item["started_at"] for key, item in spans.items()}
    longest = {}
    for span_id in order:
        dependencies = spans[span_id]["dependencies"]
        longest[span_id] = durations[span_id] + max(
            (longest[item] + spans[span_id]["started_at"] - spans[item]["finished_at"]
             for item in dependencies), default=0)
    started = min(item["started_at"] for item in rows)
    finished = max(item["finished_at"] for item in rows)
    total = finished - started
    waits = []
    for item in rows:
        if item["dependencies"]:
            wait = max(0, item["started_at"] - max(spans[key]["finished_at"] for key in item["dependencies"]))
            if wait:
                waits.append({"span_id": item["span_id"], "wait_ms": wait})
    waits.sort(key=lambda item: (-item["wait_ms"], item["span_id"]))
    return validate_phase_profile({"schema_version": 1, "cycle_id": cycle_id, "status": "complete",
                                   "total_wall_ms": total, "critical_path_ms": max(longest.values()),
                                   "overlap_ms": max(0, sum(durations.values()) - total),
                                   "principal_waits": waits[:5], "repeated_work": repeated,
                                   "attribution_caveats": caveats})


def load_phase_report(root, cycle_id):
    if not ledger_exists(root):
        return unavailable_phase_report(cycle_id)
    with ledger_connection(root) as connection:
        if connection.execute("SELECT value FROM ledger_meta WHERE key='phase_schema'").fetchone() is None:
            return unavailable_phase_report(cycle_id)
        return phase_report(phase_rows(connection, cycle_id), cycle_id)


def interval_union_ms(intervals):
    total, end = 0, None
    for started, finished in sorted(intervals):
        if end is None or started > end:
            total += finished - started
            end = finished
        elif finished > end:
            total += finished - end
            end = finished
    return total


def autonomous_runtime(rows):
    if not rows:
        return "unavailable", None
    if any(item["finished_at"] is None or item["attribution"] == "unavailable"
           or item["result"] == "unavailable" for item in rows):
        return "partial", None
    active = [(item["started_at"], item["finished_at"]) for item in rows
              if item["operation"] not in EXCLUDED_PHASE_OPERATIONS]
    pauses = [(item["started_at"], item["finished_at"]) for item in rows
              if item["operation"] in EXCLUDED_PHASE_OPERATIONS]
    if not active or any(max(a_start, p_start) < min(a_end, p_end)
                         for a_start, a_end in active for p_start, p_end in pauses):
        return "partial", None
    return "complete", interval_union_ms(active)


def cycle_performance_stats(values):
    if not values:
        return {"mean": "unavailable", "p50": "unavailable", "p90": "unavailable"}
    return {"mean": sum(values) // len(values), "p50": nearest_rank(values, .5),
            "p90": nearest_rank(values, .9)}


def completed_cycle_records(repository):
    records = {}
    directories = {cycle_dir(repository), cycle_dir(repository) / "cycles",
                   legacy_cycle_dir(repository)}
    for line in git(repository, "worktree", "list", "--porcelain").stdout.splitlines():
        if line.startswith("worktree "):
            with contextlib.suppress(RuntimeError):
                directories.add(legacy_cycle_dir(Path(line.removeprefix("worktree "))))
    paths = sorted({path for directory in directories if directory.is_dir()
                    for path in directory.glob("*.json")})
    for path in paths:
        try:
            record = json.loads(path.read_text(encoding="utf-8"), object_pairs_hook=no_duplicate_keys)
        except (OSError, json.JSONDecodeError) as error:
            fail(f"cannot read Cycle Record: {error}")
        cycle_id = record.get("cycle_id") if isinstance(record, dict) else None
        if not isinstance(cycle_id, str) or not OPAQUE_ID.fullmatch(cycle_id) or cycle_id != path.stem:
            fail("Cycle Record contains an invalid cycle ID")
        if record.get("state") == "completed":
            if cycle_id in records and records[cycle_id] != record:
                fail("Cycle Record identity is ambiguous")
            records[cycle_id] = record
    return [records[cycle_id] for cycle_id in sorted(records)]


def cycle_performance(records, spans, filters):
    selected = []
    quality = {"gate_failures": 0, "gate_reopenings": 0, "remediation_rounds": 0}
    metric_names = {"gate_failures": "gate_failure_count",
                    "gate_reopenings": "gate_reopen_count",
                    "remediation_rounds": "remediation_round_count"}
    for record in records:
        values = {
            "context": record.get("context", "unavailable"),
            "risk": record.get("risk", "unavailable"),
            "delivery_intent": record.get("delivery_intent", "unavailable"),
            "method_revision": record.get("method_revision", "unavailable"),
        }
        if any(values[name] != value for name, value in filters.items()):
            continue
        counters = record.get("metrics", {})
        if not isinstance(counters, dict):
            fail("Cycle Record contains invalid metrics")
        cycle_metrics = {output: counters.get(stored, 0) for output, stored in metric_names.items()}
        if any(type(value) is not int or value < 0 for value in cycle_metrics.values()):
            fail("Cycle Record contains invalid metrics")
        for name, value in cycle_metrics.items():
            quality[name] += value
        selected.append(record)

    counts = {"completed": len(selected), "complete": 0, "partial": 0, "unavailable": 0}
    autonomous, calendar = [], []
    for record in selected:
        status, elapsed = autonomous_runtime(spans.get(record["cycle_id"], []))
        counts[status] += 1
        if elapsed is not None:
            autonomous.append(elapsed)
        try:
            started = datetime.fromisoformat(record["created_at"].replace("Z", "+00:00"))
            finished = datetime.fromisoformat(record["completed_at"].replace("Z", "+00:00"))
            if finished >= started:
                calendar.append(int((finished - started).total_seconds() * 1000))
        except (AttributeError, KeyError, TypeError, ValueError):
            pass
    return {
        "schema_version": 1, "filters": filters, "counts": counts,
        "coverage_basis_points": counts["complete"] * 10000 // counts["completed"]
        if counts["completed"] else 0,
        "autonomous_runtime_ms": cycle_performance_stats(autonomous),
        "calendar_elapsed_ms": cycle_performance_stats(calendar), "quality": quality,
    }


def prune_phase_spans(root, connection=None):
    if connection is None and not ledger_exists(root):
        return 0
    owned = connection is None
    connection = connection or ledger_connection(root, write=True)
    if connection.execute("SELECT value FROM ledger_meta WHERE key='phase_schema'").fetchone() is None:
        if owned:
            connection.close()
        return 0
    cutoff_ms = int((time.time() - REVIEW_RETENTION_SECONDS) * 1000)
    removed = connection.execute(
        "DELETE FROM phase_spans WHERE coalesce(finished_at, started_at) <= ?", (cutoff_ms,)
    ).rowcount
    if owned:
        connection.commit()
        connection.close()
    return removed


def prune_phase_backup_spans(root):
    directory = root / "reviews" / "backups"
    if not directory.is_dir():
        return 0
    removed = 0
    cutoff_ms = int((time.time() - REVIEW_RETENTION_SECONDS) * 1000)
    for path in sorted(directory.glob("*.sqlite3")):
        private_path(path, stat.S_IFREG, 0o600, "review backup")
        connection = ledger_connection(root, write=True, path=path)
        try:
            if connection.execute("SELECT value FROM ledger_meta WHERE key='phase_schema'").fetchone() is None:
                continue
            connection.execute("BEGIN IMMEDIATE")
            removed += connection.execute(
                "DELETE FROM phase_spans WHERE coalesce(finished_at, started_at) <= ?", (cutoff_ms,)
            ).rowcount
            connection.commit()
        except Exception:
            connection.rollback()
            raise
        finally:
            connection.close()
    return removed


def validate_execution_benchmark(value):
    fields = {"schema_version", "method_revision", "fixture", "warmup_pairs", "pairs",
              "sample_count", "required_gate_digest", "serial_median_ms",
              "concurrent_median_ms", "improvement_percent", "activated", "recorded_at"}
    fixture_fields = {"id", "commit", "path", "blob"}
    pair_fields = {"pair_id", "serial_ms", "concurrent_ms", "serial_status", "concurrent_status",
                   "serial_gate_digest", "concurrent_gate_digest", "serial_remediation_rounds",
                   "concurrent_remediation_rounds"}
    numbers = {"serial_median_ms", "concurrent_median_ms", "improvement_percent"}
    integers = {"warmup_pairs", "sample_count", "recorded_at"}
    if (not isinstance(value, dict) or set(value) != fields or value.get("schema_version") != 1
            or not isinstance(value.get("method_revision"), str)
            or not OPAQUE_ID.fullmatch(value["method_revision"])
            or not isinstance(value.get("fixture"), dict) or set(value["fixture"]) != fixture_fields
            or not OPAQUE_ID.fullmatch(value["fixture"].get("id", ""))
            or not re.fullmatch(r"[0-9a-f]{40}(?:[0-9a-f]{24})?", value["fixture"].get("commit", ""))
            or not re.fullmatch(r"[0-9a-f]{40}(?:[0-9a-f]{24})?", value["fixture"].get("blob", ""))
            or phase_path(value["fixture"].get("path")) != value["fixture"]["path"]
            or not isinstance(value.get("pairs"), list) or not 5 <= len(value["pairs"]) <= 100
            or not re.fullmatch(r"[0-9a-f]{64}", value.get("required_gate_digest", ""))
            or any(not isinstance(value.get(name), (int, float)) or isinstance(value.get(name), bool)
                   or not math.isfinite(value[name]) or value[name] < 0 for name in numbers)
            or any(type(value.get(name)) is not int or value[name] < 0 for name in integers)
            or value["warmup_pairs"] < 1 or value["sample_count"] != len(value["pairs"])
            or not isinstance(value.get("activated"), bool)
            or value["recorded_at"] < REVIEW_START_MS):
        fail("execution benchmark result is invalid")
    pair_ids = set()
    for pair in value["pairs"]:
        if (not isinstance(pair, dict) or set(pair) != pair_fields
                or not OPAQUE_ID.fullmatch(pair.get("pair_id", "")) or pair["pair_id"] in pair_ids
                or any(type(pair.get(name)) is not int or not 1 <= pair[name] <= 86_400_000
                       for name in ("serial_ms", "concurrent_ms"))
                or pair.get("serial_status") != "passed" or pair.get("concurrent_status") != "passed"
                or pair.get("serial_gate_digest") != value["required_gate_digest"]
                or pair.get("concurrent_gate_digest") != value["required_gate_digest"]
                or any(type(pair.get(name)) is not int or pair[name] < 0 for name in (
                    "serial_remediation_rounds", "concurrent_remediation_rounds"))):
            fail("execution benchmark pair is invalid")
        pair_ids.add(pair["pair_id"])
    serial_median = median(pair["serial_ms"] for pair in value["pairs"])
    concurrent_median = median(pair["concurrent_ms"] for pair in value["pairs"])
    expected_improvement = round(
        (serial_median - concurrent_median) * 100 / serial_median, 2)
    expected = (concurrent_median <= serial_median * .9
                and all(pair["concurrent_remediation_rounds"] <= pair["serial_remediation_rounds"]
                        for pair in value["pairs"]))
    if (value["serial_median_ms"] != serial_median
            or value["concurrent_median_ms"] != concurrent_median
            or value["improvement_percent"] != expected_improvement or value["activated"] != expected):
        fail("execution benchmark activation is invalid")
    return value


def load_execution_activation(root):
    if not ledger_exists(root):
        return False
    with ledger_connection(root) as connection:
        if connection.execute("SELECT value FROM ledger_meta WHERE key='phase_schema'").fetchone() is None:
            return False
        row = connection.execute(
            "SELECT payload FROM execution_activation WHERE method_revision=?",
            (CURRENT_METHOD_REVISION,),
        ).fetchone()
        return row is not None and validate_execution_benchmark(
            json.loads(row[0], object_pairs_hook=no_duplicate_keys))["activated"]


def delete_capture_benchmarks(connection, capture_ids, timestamp):
    if connection.execute("SELECT value FROM ledger_meta WHERE key='benchmark_schema'").fetchone() is not None:
        placeholders = ",".join("?" for _ in capture_ids)
        benchmark_ids = [row[0] for row in connection.execute(
            f"SELECT benchmark_id FROM benchmark_effects WHERE baseline_capture_id IN ({placeholders}) "
            f"OR observation_capture_id IN ({placeholders})", (*capture_ids, *capture_ids))]
        connection.executemany("DELETE FROM benchmark_effects WHERE benchmark_id=?",
                               ((benchmark_id,) for benchmark_id in benchmark_ids))
        for benchmark_id in benchmark_ids:
            record_knowledge_privacy_tombstone(
                connection, "benchmark", benchmark_id, "forgotten", timestamp)
        return benchmark_ids
    return []


def legacy_review_exists(root):
    directory = root / "reviews"
    if not directory.is_dir():
        return False
    history = directory / "history"
    return any(directory.glob("*.json")) or history.is_dir() and any(history.rglob("*.json"))


def create_empty_ledger(root):
    directory = root / "reviews"
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(directory, 0o700)
    descriptor, temporary = tempfile.mkstemp(prefix=".ledger-", suffix=".sqlite3", dir=directory)
    os.close(descriptor)
    temporary = Path(temporary)
    try:
        os.chmod(temporary, 0o600)
        connection = sqlite3.connect(temporary)
        connection.execute("PRAGMA foreign_keys=ON")
        connection.execute("PRAGMA synchronous=FULL")
        ledger_schema(connection)
        connection.commit()
        ledger_integrity(connection)
        connection.close()
        os.replace(temporary, ledger_path(root))
        os.chmod(ledger_path(root), 0o600)
        fsync_directory(directory)
    finally:
        temporary.unlink(missing_ok=True)


def ensure_ledger_for_write(root):
    if not ledger_exists(root):
        if legacy_review_exists(root):
            fail("legacy private review state requires review-migrate")
        create_empty_ledger(root)
    connection = ledger_connection(root, write=True)
    recover_forget_state(root, connection)
    return connection


def ledger_payload(value):
    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=True)


def knowledge_privacy_rows(connection):
    if connection.execute(
            "SELECT 1 FROM sqlite_master WHERE type='table' AND name='knowledge_privacy_tombstones'").fetchone() is None:
        return []
    return [list(row) for row in connection.execute(
        "SELECT family,item_id,reason,timestamp FROM knowledge_privacy_tombstones "
        "ORDER BY family,item_id")]


def knowledge_privacy_digest(connection):
    return hashlib.sha256(ledger_payload(
        {"schema_version": 1, "tombstones": knowledge_privacy_rows(connection)}).encode()).hexdigest()


def ensure_knowledge_privacy_schema(connection):
    exists = connection.execute(
        "SELECT 1 FROM sqlite_master WHERE type='table' AND name='knowledge_privacy_tombstones'").fetchone()
    values = dict(connection.execute(
        "SELECT key,value FROM ledger_meta WHERE key IN "
        "('knowledge_privacy_sequence','knowledge_privacy_digest')"))
    if exists and set(values) == {"knowledge_privacy_sequence", "knowledge_privacy_digest"}:
        return
    if exists or values:
        fail("knowledge privacy schema is incomplete")
    connection.execute("BEGIN IMMEDIATE")
    try:
        connection.execute("""CREATE TABLE knowledge_privacy_tombstones (
            family TEXT NOT NULL,
            item_id TEXT NOT NULL,
            reason TEXT NOT NULL,
            timestamp INTEGER NOT NULL,
            PRIMARY KEY (family, item_id)
        ) WITHOUT ROWID""")
        connection.execute(
            "INSERT INTO knowledge_privacy_tombstones "
            "SELECT 'telemetry',item_id,'forgotten',timestamp FROM review_tombstones "
            "WHERE kind='forgotten_session'")
        count = connection.execute(
            "SELECT count(*) FROM knowledge_privacy_tombstones").fetchone()[0]
        connection.execute("INSERT INTO ledger_meta VALUES ('knowledge_privacy_sequence', ?)",
                           (str(count),))
        connection.execute("INSERT INTO ledger_meta VALUES ('knowledge_privacy_digest', ?)",
                           (knowledge_privacy_digest(connection),))
        connection.commit()
    except Exception:
        connection.rollback()
        raise


def ensure_incident_schema(connection):
    row = connection.execute("SELECT value FROM ledger_meta WHERE key='incident_schema'").fetchone()
    tables = {item[0] for item in connection.execute(
        "SELECT name FROM sqlite_master WHERE type='table' AND name IN "
        "('incidents','incident_signal_dispositions')")}
    if row == (str(INCIDENT_SCHEMA),) and tables == {"incidents", "incident_signal_dispositions"}:
        return
    if row is not None or tables:
        fail("incident schema is incomplete")
    connection.execute("BEGIN IMMEDIATE")
    try:
        connection.executescript("""
            CREATE TABLE incidents (
                incident_id TEXT PRIMARY KEY,
                session_id TEXT NOT NULL UNIQUE,
                parent_session_id TEXT NOT NULL,
                message_id TEXT NOT NULL,
                kind TEXT NOT NULL CHECK (kind IN ('defect','friction','behavior_gap','capability_idea')),
                title TEXT NOT NULL,
                summary TEXT NOT NULL,
                state TEXT NOT NULL CHECK (state IN ('open','investigating','fixing','resolved','dismissed')),
                cycle_id TEXT,
                diagnostics TEXT NOT NULL,
                evidence TEXT NOT NULL,
                created_at INTEGER NOT NULL,
                updated_at INTEGER NOT NULL
            ) WITHOUT ROWID;
            CREATE TABLE incident_signal_dispositions (
                signal_id TEXT PRIMARY KEY,
                incident_id TEXT REFERENCES incidents(incident_id) ON DELETE SET NULL,
                disposition TEXT NOT NULL CHECK (disposition IN ('promoted','forgotten')),
                timestamp INTEGER NOT NULL
            ) WITHOUT ROWID;
        """)
        connection.execute("INSERT INTO ledger_meta VALUES ('incident_schema', ?)",
                           (str(INCIDENT_SCHEMA),))
        connection.commit()
        ledger_integrity(connection)
    except Exception:
        connection.rollback()
        raise


def incident_record(row):
    (incident_id, session_id, parent_id, message_id, kind, title, summary, state,
     cycle_id, diagnostics_raw, evidence_raw, created_at, updated_at) = row
    try:
        diagnostics = json.loads(diagnostics_raw, object_pairs_hook=no_duplicate_keys)
        evidence = json.loads(evidence_raw, object_pairs_hook=no_duplicate_keys)
    except (TypeError, json.JSONDecodeError):
        fail("private review ledger incident payload is invalid")
    if (not re.fullmatch(r"[0-9a-f]{24}", incident_id)
            or not all(isinstance(value, str) and OPAQUE_ID.fullmatch(value)
                       for value in (session_id, parent_id, message_id))
            or kind not in INCIDENT_KINDS or state not in INCIDENT_STATES
            or not isinstance(title, str) or not title.startswith("INCIDENT: ") or len(title) > 128
            or not isinstance(summary, str) or not 1 <= len(summary) <= 1024
            or cycle_id is not None and (not isinstance(cycle_id, str) or not OPAQUE_ID.fullmatch(cycle_id))
            or not isinstance(diagnostics, list) or len(diagnostics) > 20
            or not isinstance(evidence, list) or len(evidence) > 20
            or not all(isinstance(value, str) and 1 <= len(value) <= 2048
                       for value in diagnostics + evidence)
            or type(created_at) is not int or type(updated_at) is not int
            or created_at < REVIEW_START_MS or updated_at < created_at):
        fail("private review ledger incident payload is invalid")
    return {
        "incident_id": incident_id, "session_id": session_id,
        "parent_session_id": parent_id, "message_id": message_id,
        "kind": kind, "title": incident_redact(title, 128),
        "summary": incident_redact(summary, 1024), "state": state,
        "cycle_id": cycle_id,
        "diagnostics": [incident_redact(value) for value in diagnostics],
        "evidence": [incident_redact(value) for value in evidence],
        "created_at": created_at, "updated_at": updated_at,
    }


def record_knowledge_privacy_tombstone(connection, family, item_id, reason, timestamp):
    if (not OPAQUE_ID.fullmatch(family) or not OPAQUE_ID.fullmatch(item_id)
            or not OPAQUE_ID.fullmatch(reason) or not isinstance(timestamp, int)
            or timestamp < REVIEW_START_MS):
        fail("invalid knowledge privacy tombstone")
    changed = connection.execute(
        "INSERT INTO knowledge_privacy_tombstones VALUES (?, ?, ?, ?) "
        "ON CONFLICT(family,item_id) DO NOTHING",
        (family, item_id, reason, timestamp),
    ).rowcount
    if not changed:
        return False
    row = connection.execute(
        "SELECT value FROM ledger_meta WHERE key='knowledge_privacy_sequence'").fetchone()
    if row is None or not row[0].isdigit() or int(row[0]) >= 2**64 - 1:
        fail("knowledge privacy sequence is invalid or exhausted")
    connection.execute("UPDATE ledger_meta SET value=? WHERE key='knowledge_privacy_sequence'",
                       (str(int(row[0]) + 1),))
    connection.execute("UPDATE ledger_meta SET value=? WHERE key='knowledge_privacy_digest'",
                       (knowledge_privacy_digest(connection),))
    return True


def ledger_entries(connection, scope, report_id, report):
    names = {"findings": "finding", "scorecards": "scorecard", "trends": "trend",
             "proposals": "proposal", "caveats": "caveat"}
    connection.execute("DELETE FROM ledger_entries WHERE scope=? AND report_id=?", (scope, report_id))
    for field, category in names.items():
        connection.executemany(
            "INSERT INTO ledger_entries VALUES (?, ?, ?, ?, ?)",
            ((scope, report_id, category, position, text) for position, text in enumerate(report.get(field, []))),
        )


def ledger_put_review_report(connection, report_id, report):
    connection.execute("INSERT OR REPLACE INTO review_reports VALUES (?, ?, ?)",
                       (report_id, report["reviewed_at"], ledger_payload(report)))
    connection.execute("DELETE FROM review_report_sessions WHERE report_id=?", (report_id,))
    connection.execute("DELETE FROM review_report_cycles WHERE report_id=?", (report_id,))
    connection.executemany("INSERT INTO review_report_sessions VALUES (?, ?, ?)",
                           ((report_id, position, value) for position, value in enumerate(report["session_ids"])))
    connection.executemany("INSERT INTO review_report_cycles VALUES (?, ?, ?)",
                           ((report_id, position, value) for position, value in enumerate(report.get("cycle_ids", []))))
    ledger_entries(connection, "operational", report_id, report)


def ledger_put_history_evidence(connection, evidence):
    connection.execute("INSERT OR REPLACE INTO history_evidence VALUES (?, ?, ?)",
                       (evidence["session_id"], int(evidence["completed_at"]), ledger_payload(evidence)))


def ledger_put_history_report(connection, kind, report):
    report_id = report["report_id"]
    connection.execute("INSERT OR REPLACE INTO history_reports VALUES (?, ?, ?)",
                       (report_id, kind, ledger_payload(report)))
    connection.execute("DELETE FROM history_report_members WHERE report_id=?", (report_id,))
    connection.executemany("INSERT INTO history_report_members VALUES (?, ?, ?)",
                           ((report_id, position, value) for position, value in enumerate(report["cohort"])))
    ledger_entries(connection, "history", report_id, report)


def ledger_content(connection):
    tombstones = {"schema_version": 1, "sessions": {}, "cycles": {}, "forgotten_sessions": {}}
    names = {"session": "sessions", "cycle": "cycles", "forgotten_session": "forgotten_sessions"}
    for kind, item_id, timestamp in connection.execute(
            "SELECT kind, item_id, timestamp FROM review_tombstones ORDER BY kind, item_id"):
        tombstones[names[kind]][item_id] = timestamp
    def payloads(query):
        return [(key, json.loads(payload, object_pairs_hook=no_duplicate_keys))
                for key, payload in connection.execute(query)]
    result = {
        "index": tombstones,
        "review_reports": payloads("SELECT report_id, payload FROM review_reports ORDER BY report_id"),
        "history_evidence": [value for _, value in payloads(
            "SELECT session_id, payload FROM history_evidence ORDER BY session_id")],
        "history_reports": payloads(
            "SELECT report_id, payload FROM history_reports WHERE kind='report' ORDER BY report_id"),
        "history_cohorts": payloads(
            "SELECT report_id, payload FROM history_reports WHERE kind='cohort' ORDER BY report_id"),
    }
    if connection.execute("SELECT value FROM ledger_meta WHERE key='capture_schema'").fetchone() is not None:
        result["history_captures"] = payloads(
            "SELECT capture_id, payload FROM history_captures ORDER BY capture_id")
    if connection.execute("SELECT value FROM ledger_meta WHERE key='benchmark_schema'").fetchone() is not None:
        result["benchmarks"] = payloads(
            "SELECT benchmark_id, payload FROM benchmark_effects ORDER BY benchmark_id")
        result["benchmark_definitions"] = [
            {"version": version, "metric": metric, "direction": direction}
            for version, metric, direction in connection.execute(
                "SELECT version, metric_name, direction FROM benchmark_definitions ORDER BY version")]
    if connection.execute("SELECT value FROM ledger_meta WHERE key='phase_schema'").fetchone() is not None:
        result["phase_spans"] = [
            phase_record(row) for row in connection.execute(
                "SELECT cycle_id, span_id, parent_span_id, phase, operation, attribution, dependencies, "
                "ownership_paths, started_at, finished_at, result FROM phase_spans ORDER BY cycle_id, span_id")]
        result["execution_activations"] = payloads(
            "SELECT method_revision, payload FROM execution_activation ORDER BY method_revision")
    if connection.execute("SELECT value FROM ledger_meta WHERE key='incident_schema'").fetchone() is not None:
        incidents = [incident_record(row) for row in connection.execute(
            "SELECT incident_id,session_id,parent_session_id,message_id,kind,title,summary,state,cycle_id,"
            "diagnostics,evidence,created_at,updated_at FROM incidents ORDER BY incident_id")]
        dispositions = [list(row) for row in connection.execute(
            "SELECT signal_id,incident_id,disposition,timestamp FROM incident_signal_dispositions "
            "ORDER BY signal_id")]
        if incidents or dispositions:
            result["incidents"] = incidents
            result["incident_signal_dispositions"] = dispositions
    return result


def content_digest(value):
    return hashlib.sha256(ledger_payload(value).encode()).hexdigest()


def backup_directory(root):
    directory = root / "reviews" / "backups"
    private_path(directory.parent, stat.S_IFDIR, 0o700, "review directory")
    if directory.is_symlink():
        fail("private review backup directory is unsafe")
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(directory, 0o700)
    private_path(directory, stat.S_IFDIR, 0o700, "backup directory")
    return directory


def file_digest(path):
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def create_ledger_backup(root, prefix="ledger"):
    if not ledger_exists(root):
        fail("private review ledger is missing")
    name = f"{int(time.time() * 1000)}-{prefix}-{uuid.uuid4().hex[:8]}.sqlite3"
    target = backup_directory(root) / name
    source = ledger_connection(root)
    destination = sqlite3.connect(target)
    try:
        source.backup(destination)
        destination.commit()
    except sqlite3.Error as error:
        target.unlink(missing_ok=True)
        fail(f"cannot back up private review ledger: {error}")
    finally:
        source.close()
        destination.close()
    os.chmod(target, 0o600)
    with ledger_connection(root, path=target) as check:
        ledger_integrity(check)
    fsync_directory(target.parent)
    return name, file_digest(target)


def backup_legacy_json(root):
    reviews = root / "reviews"
    files = legacy_json_files(root)
    name = f"{int(time.time() * 1000)}-legacy-{uuid.uuid4().hex[:8]}"
    target = backup_directory(root) / name
    target.mkdir(mode=0o700)
    digest = hashlib.sha256()
    directories = {target}
    for source in files:
        if source.is_symlink() or not source.is_file():
            fail("legacy private review state contains an unsafe file")
        relative = source.relative_to(reviews)
        destination = target / relative
        destination.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        os.chmod(destination.parent, 0o700)
        directories.update(parent for parent in destination.parents
                           if parent == target or target in parent.parents)
        shutil.copyfile(source, destination)
        os.chmod(destination, 0o600)
        with destination.open("rb") as handle:
            os.fsync(handle.fileno())
        digest.update(relative.as_posix().encode() + b"\0" + source.read_bytes())
    for directory in sorted(directories, key=lambda item: len(item.parts), reverse=True):
        fsync_directory(directory)
    fsync_directory(target.parent)
    return name, digest.hexdigest()


def legacy_json_files(root):
    reviews = root / "reviews"
    history = reviews / "history"
    if history.is_symlink():
        fail("legacy private review state contains an unsafe directory")
    entries = list(history.rglob("*")) if history.is_dir() else []
    directories = [history, *(path for path in entries if path.is_dir() or path.is_symlink())] if history.exists() else []
    files = sorted([*reviews.glob("*.json"), *(path for path in entries if path.suffix == ".json")])
    for directory in directories:
        details = directory.lstat()
        if stat.S_IFMT(details.st_mode) != stat.S_IFDIR or details.st_uid != os.getuid():
            fail("legacy private review state contains an unsafe directory")
        os.chmod(directory, 0o700)
    for path in files:
        details = path.lstat()
        if stat.S_IFMT(details.st_mode) != stat.S_IFREG or details.st_uid != os.getuid():
            fail("legacy private review state contains an unsafe file")
        os.chmod(path, 0o600)
    return files


def stage_pre_forget_state(root, name=None):
    reviews = root / "reviews"
    quarantine = reviews / (name or f".forget-{uuid.uuid4().hex}")
    quarantine.mkdir(mode=0o700)
    moved = []
    modified = {reviews, quarantine}
    try:
        for source in legacy_json_files(root):
            destination = quarantine / "legacy" / source.relative_to(reviews)
            destination.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
            os.chmod(destination.parent, 0o700)
            os.replace(source, destination)
            moved.append((source, destination))
            modified.update((source.parent, destination.parent))
            modified.update(parent for parent in destination.parents
                            if parent == quarantine or quarantine in parent.parents)
        backups = reviews / "backups"
        if backups.is_symlink():
            fail("private review backup directory is unsafe")
        if backups.is_dir():
            destination = quarantine / "backups"
            os.replace(backups, destination)
            moved.append((backups, destination))
            modified.update((backups.parent, destination.parent))
        for directory in sorted(modified):
            if directory.is_dir():
                fsync_directory(directory)
        return quarantine, moved
    except Exception:
        restore_staged_forget(quarantine, moved)
        raise


def stage_provider_evaluation_backups(root, report_ids, name):
    reviews = root / "reviews"
    quarantine = reviews / name
    quarantine.mkdir(mode=0o700)
    backups = reviews / "backups"
    moved = []
    try:
        if backups.is_symlink():
            fail("private review backup directory is unsafe")
        if backups.is_dir():
            private_path(backups, stat.S_IFDIR, 0o700, "backup directory")
            destination_root = quarantine / "provider-backups"
            for source in sorted(backups.glob("*.sqlite3")):
                private_path(source, stat.S_IFREG, 0o600, "review backup")
                affected = True
                try:
                    with ledger_connection(root, path=source) as connection:
                        if connection.execute(
                                "SELECT 1 FROM sqlite_master WHERE type='table' "
                                "AND name='provider_evaluation_reports'").fetchone() is None:
                            affected = False
                        else:
                            affected = any(connection.execute(
                                "SELECT 1 FROM provider_evaluation_reports WHERE report_id=?", (report_id,)
                            ).fetchone() is not None for report_id in report_ids)
                except (RuntimeError, sqlite3.Error):
                    pass
                if affected:
                    destination_root.mkdir(parents=True, exist_ok=True, mode=0o700)
                    os.chmod(destination_root, 0o700)
                    destination = destination_root / source.name
                    os.replace(source, destination)
                    moved.append((source, destination))
            if moved:
                fsync_directory(backups)
                fsync_directory(destination_root)
        fsync_directory(quarantine)
        fsync_directory(reviews)
        return quarantine, moved
    except Exception:
        restore_staged_forget(quarantine, moved)
        raise


def restore_staged_forget(quarantine, moved):
    modified = {quarantine.parent}
    for source, destination in reversed(moved):
        if destination.exists():
            source.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
            os.replace(destination, source)
            modified.update((source.parent, destination.parent))
            modified.update(parent for parent in source.parents
                            if parent == quarantine.parent or quarantine.parent in parent.parents)
    shutil.rmtree(quarantine, ignore_errors=True)
    for directory in sorted(modified):
        if directory.is_dir():
            fsync_directory(directory)


def discard_staged_forget(quarantine):
    shutil.rmtree(quarantine)
    fsync_directory(quarantine.parent)


def restore_forget_quarantine(quarantine):
    reviews = quarantine.parent
    moved = []
    legacy = quarantine / "legacy"
    if legacy.is_dir():
        for destination in sorted(legacy.rglob("*.json")):
            source = reviews / destination.relative_to(legacy)
            if source.exists() or source.is_symlink():
                fail("cannot recover staged private review state")
            moved.append((source, destination))
    staged_backups = quarantine / "backups"
    if staged_backups.is_dir():
        source = reviews / "backups"
        if source.exists() or source.is_symlink():
            fail("cannot recover staged private review backups")
        moved.append((source, staged_backups))
    staged_provider_backups = quarantine / "provider-backups"
    if staged_provider_backups.is_dir():
        for destination in sorted(staged_provider_backups.glob("*.sqlite3")):
            source = reviews / "backups" / destination.name
            if source.exists() or source.is_symlink():
                fail("cannot recover staged private review backups")
            moved.append((source, destination))
    restore_staged_forget(quarantine, moved)


def recover_forget_state(root, connection):
    reviews = root / "reviews"
    row = connection.execute("SELECT value FROM ledger_meta WHERE key='pending_forget_cleanup'").fetchone()
    pending = row[0] if row else None
    quarantines = sorted(reviews.glob(".forget-*")) if reviews.is_dir() else []
    for quarantine in quarantines:
        if not re.fullmatch(r"\.forget-[0-9a-f]{32}", quarantine.name):
            fail("private review forget quarantine is unsafe")
        private_path(quarantine, stat.S_IFDIR, 0o700, "forget quarantine")
        if quarantine.name == pending:
            discard_staged_forget(quarantine)
        else:
            restore_forget_quarantine(quarantine)
    if pending is not None:
        connection.execute("DELETE FROM ledger_meta WHERE key='pending_forget_cleanup'")
        connection.commit()


def require_review_lock_safe(root):
    directory = root / "reviews"
    if (directory.is_dir() and (any(directory.glob("*.json")) or (directory / "history").exists()
                                or ledger_exists(root)) and not (directory / ".lock").is_file()):
        fail("retained review state is missing its lock")


@contextlib.contextmanager
def existing_review_lock(root, exclusive=False):
    path = root / "reviews" / ".lock"
    if path.is_file():
        with open_existing_review_lock(path) as handle:
            fcntl.flock(handle, fcntl.LOCK_EX if exclusive else fcntl.LOCK_SH)
            yield
    else:
        yield


def exclusive_json(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    temp = None
    try:
        with tempfile.NamedTemporaryFile("w", dir=path.parent, delete=False, encoding="utf-8") as handle:
            temp = Path(handle.name)
            json.dump(value, handle, sort_keys=True, indent=2)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        try:
            os.link(temp, path)
        except FileExistsError:
            fail(f"cycle record already exists: {path.stem}")
    finally:
        if temp:
            temp.unlink(missing_ok=True)


def status_paths(root, read_only=False):
    env = {**os.environ, "GIT_OPTIONAL_LOCKS": "0"} if read_only else None
    result = subprocess.run(
        ["git", "status", "--porcelain=v1", "-z"], cwd=root, capture_output=True, env=env
    )
    if result.returncode:
        fail(result.stderr.decode(errors="replace").strip() or "git status failed")
    entries = result.stdout.split(b"\0")
    paths = []
    index = 0
    while index < len(entries):
        entry = entries[index]
        index += 1
        if not entry:
            continue
        paths.append(os.fsdecode(entry[3:]))
        if entry[0:1] in (b"R", b"C") or entry[1:2] in (b"R", b"C"):
            if index < len(entries) and entries[index]:
                paths.append(os.fsdecode(entries[index]))
                index += 1
    return paths


def branch(root):
    value = git(root, "symbolic-ref", "--quiet", "--short", "HEAD", check=False)
    return value.stdout.strip() or None


def upstream(root):
    value = git(root, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}", check=False)
    return value.stdout.strip() or None


def ahead(root, upstream_name):
    if not upstream_name:
        return []
    return git(root, "rev-list", f"{upstream_name}..HEAD").stdout.splitlines()


def remote_destination(root, upstream_name):
    remote, _ = remote_for_upstream(root, upstream_name)
    if not remote:
        return {"name": None, "push_url": None}
    url = git(root, "remote", "get-url", "--push", remote, check=False)
    return {"name": remote, "push_url": url.stdout.strip() or None}


def remote_for_upstream(root, upstream_name):
    if not upstream_name:
        return None, None
    remotes = git(root, "remote").stdout.splitlines()
    matches = [name for name in remotes if upstream_name.startswith(name + "/")]
    if not matches:
        return None, None
    remote = max(matches, key=len)
    return remote, upstream_name[len(remote) + 1:]


def relative_locator(path, base, root_name):
    try:
        relative = path.resolve().relative_to(base.resolve())
    except ValueError:
        return None
    return {"root": root_name, "path": relative.as_posix() or "."}


def locator_path(locator, roots, name):
    if (not isinstance(locator, dict) or set(locator) != {"root", "path"}
            or locator.get("root") not in roots or not isinstance(locator.get("path"), str)):
        fail(f"invalid {name} locator")
    relative = PurePosixPath(locator["path"])
    if relative.is_absolute() or locator["path"] == "" or ".." in relative.parts:
        fail(f"invalid {name} locator")
    base = roots[locator["root"]].resolve()
    candidate = (base / Path(*relative.parts)).resolve()
    try:
        candidate.relative_to(base)
    except ValueError:
        fail(f"invalid {name} locator")
    return candidate


def record_worktree(root, record):
    details = record.get("worktree", {})
    if "locator" not in details:
        value = details.get("path")
        if not isinstance(value, str) or not value:
            fail("Cycle Record contains an invalid worktree path")
        return Path(value).expanduser().resolve()
    return locator_path(details.get("locator"), {
        "cycle_worktree": root,
        "dbsctr_worktrees": worktree_registry_root(),
    }, "cycle worktree")


def record_source_worktree(root, record):
    source = record.get("source")
    if not isinstance(source, dict):
        return None
    if "locator" not in source:
        value = source.get("path")
        return Path(value).expanduser().resolve() if isinstance(value, str) and value else None
    return locator_path(source.get("locator"), {"primary_worktree": primary_worktree(root)},
                        "source worktree")


def record_worktree_matches(root, record, worktree):
    details = record.get("worktree", {})
    expected_id = (worktree_id(worktree) if "locator" in details
                   else legacy_worktree_id(worktree))
    if expected_id != details.get("id") or common_git_dir(worktree).resolve() != common_git_dir(root).resolve():
        return False
    if "locator" not in details:
        return git_dir(worktree).resolve() == Path(details.get("git_dir", "")).resolve()
    return True


def configured_upstream(root):
    current = branch(root)
    if not current:
        return None, None
    remote = git(root, "config", "--get", f"branch.{current}.remote", check=False).stdout.strip()
    merge = git(root, "config", "--get", f"branch.{current}.merge", check=False).stdout.strip()
    if not remote or not merge.startswith("refs/heads/"):
        return None, None
    return remote, merge.removeprefix("refs/heads/")


def load(root):
    active = resolved_active_path(root)
    records = cycle_dir(root) / "cycles"
    if active == legacy_cycle_dir(root) / "active":
        records = legacy_cycle_dir(root)
    if not active.exists():
        fail("no active DBSCTR cycle")
    cycle_id = active_pointer_id(root, active)
    path = records / f"{cycle_id}.json"
    if not cycle_id or not path.is_file():
        fail("active DBSCTR record is missing")
    record = json.loads(path.read_text(encoding="utf-8"))
    if "schema_version" in record and record["schema_version"] not in (1, 2, 3, 4):
        fail(f"unsupported Cycle Record schema: {record['schema_version']}")
    record_worktree(root, record)
    return path, record


def save(path, record):
    atomic_json(path, record)


def require_active(record):
    if record["state"] != "active":
        fail(f"cycle is {record['state']}, not active")


def require_pushable(record):
    if record["state"] not in ("active", "finalizing"):
        fail(f"cycle is {record['state']}, not pushable")


def is_v32(record):
    return record.get("schema_version") in (1, 2, 3, 4)


@contextlib.contextmanager
def target_lock(root, record):
    target = record.get("delivery", {}).get("lock_id")
    if not target:
        target = delivery_lock_id(record["git"]["remote"].get("push_url"), record["git"]["upstream"])
    path = cycle_dir(root) / "locks" / f"{target}.lock"
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a+", encoding="utf-8") as handle:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            fail("delivery target is locked by another DBSCTR cycle")
        yield


@contextlib.contextmanager
def evidence_lock(root, cycle_id):
    path = cycle_dir(root) / "locks" / f"evidence-{cycle_id}.lock"
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a+", encoding="utf-8") as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        yield


def delivery_lock_id(push_url, upstream_name=None, remote_branch=None):
    if remote_branch is None:
        remote_branch = upstream_name.partition("/")[2] if upstream_name else ""
    return hashlib.sha256(f"{push_url or 'no-remote'}\0{remote_branch}".encode()).hexdigest()[:24]


def no_duplicate_keys(pairs):
    value = {}
    for key, item in pairs:
        if key in value:
            fail(f"duplicate JSON key in applicability plan: {key}")
        value[key] = item
    return value


def read_plan(source, expected_digest=None):
    try:
        raw = sys.stdin.buffer.read() if source == "-" else Path(source).read_bytes()
        if expected_digest is not None and hashlib.sha256(raw).hexdigest() != expected_digest:
            fail("applicability plan changed after approval")
        text = raw.decode("utf-8")
        value = json.loads(text, object_pairs_hook=no_duplicate_keys)
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        fail(f"cannot read applicability plan: {error}")
    if not isinstance(value, dict):
        fail("applicability plan must be a JSON object")
    return value


def initiative_no_duplicate_keys(pairs):
    value = {}
    for key, item in pairs:
        if key in value:
            fail(f"duplicate JSON key in Initiative manifest: {key}")
        value[key] = item
    return value


def initiative_fields(value, fields, label):
    if not isinstance(value, dict) or set(value) != fields:
        fail(f"{label} requires exactly: {', '.join(sorted(fields))}")


def initiative_strings(value, label, allow_empty=True):
    if (not isinstance(value, list) or any(not isinstance(item, str) or not item for item in value)
            or not allow_empty and not value):
        fail(f"{label} must be {'a non-empty' if not allow_empty else 'an'} array of strings")
    if len(value) != len(set(value)):
        fail(f"{label} contains duplicate values")


def initiative_paths(value, label):
    initiative_strings(value, label)
    for item in value:
        path = PurePosixPath(item)
        if (path.is_absolute() or item != path.as_posix() or "\\" in item
                or any(part in {"", ".", ".."} for part in path.parts)
                or any(ord(character) < 32 for character in item)
                or urlsplit(item).scheme or urlsplit(item).netloc):
            fail(f"{label} must contain normalized repository-relative paths")


def initiative_repository(value, label):
    if (not isinstance(value, str)
            or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*", value)):
        fail(f"{label} must be a canonical owner/repository identity")


def github_repository_from_url(url, error):
    scp = re.fullmatch(r"(?:git@)?github\.com:([^/\s]+/[^/\s]+?)(?:\.git)?", url, re.IGNORECASE)
    if scp:
        return scp.group(1)
    try:
        parsed = urlsplit(url)
        valid_user = parsed.username is None or parsed.scheme == "ssh" and parsed.username == "git"
        valid = (parsed.scheme in {"https", "ssh", "git"} and parsed.hostname == "github.com"
                 and valid_user and parsed.password is None and not parsed.query and not parsed.fragment)
    except ValueError:
        valid = False
    if not valid:
        fail(error)
    match = re.fullmatch(r"/([^/\s]+/[^/\s]+?)(?:\.git)?/?", parsed.path)
    if not match:
        fail(error)
    return match.group(1)


def git_repository_slug(root):
    url = git(root, "remote", "get-url", "origin", check=False).stdout.strip()
    return github_repository_from_url(url, "Initiative repository must have a GitHub origin")


def github_remote_url(root, remote, repository):
    for push in (False, True):
        args = ("remote", "get-url", "--push", remote) if push else ("remote", "get-url", remote)
        url = git(root, *args, check=False).stdout.strip()
        if not url or github_repository_from_url(
                url, "draft_pr delivery requires GitHub fetch and push remotes"
        ).lower() != repository.lower():
            fail("draft_pr remote must match configured GitHub repository: " + repository)
    return f"https://github.com/{repository}.git"


def require_canonical_github_url(root, url, env):
    effective = git(root, "ls-remote", "--get-url", url, env=env).stdout.strip()
    if effective != url:
        fail("Git URL rewriting is not allowed for draft_pr delivery")


def fetch_github_branch(root, remote, url, remote_branch, env):
    require_canonical_github_url(root, url, env)
    git(root, "fetch", url,
        f"+refs/heads/{remote_branch}:refs/remotes/{remote}/{remote_branch}", env=env)


def github_remote_head(root, url, remote_ref, env):
    require_canonical_github_url(root, url, env)
    return git(root, "ls-remote", "--heads", url, remote_ref, env=env).stdout.split()


def push_github_branch(root, url, remote_branch, env):
    require_canonical_github_url(root, url, env)
    git(root, "push", url, f"HEAD:{remote_branch}", env=env)


def normalize_begin_delivery(root, args, delivery_branch):
    if args.delivery_intent == "merge" and delivery_branch == args.base_branch:
        args.delivery_intent = "draft_pr"
    elif args.delivery_intent != "draft_pr" and delivery_branch == args.base_branch:
        fail("direct delivery to the protected base branch requires draft_pr")
    if args.delivery_intent != "draft_pr":
        return
    account = getattr(args, "github_account", None)
    if not account or not OPAQUE_ID.fullmatch(account):
        fail("draft_pr delivery requires a valid GitHub account")
    repository = git_repository_slug(root)
    supplied = getattr(args, "github_repository", None)
    if supplied:
        expected = repository if "/" in supplied else repository.rsplit("/", 1)[1]
        if supplied.lower() != expected.lower():
            fail("GitHub repository must match configured GitHub repository: " + repository)
    args.github_repository = repository


def initiative_acyclic(dependencies, label):
    visiting = set()
    visited = set()

    def visit(node):
        if node in visiting:
            fail(f"{label} dependency cycle includes {node}")
        if node in visited:
            return
        visiting.add(node)
        for dependency in dependencies[node]:
            visit(dependency)
        visiting.remove(node)
        visited.add(node)

    for node in sorted(dependencies):
        visit(node)


def read_initiative_manifest(source):
    try:
        raw = Path(source).read_bytes()
        if len(raw) > 1024 * 1024:
            fail("Initiative manifest exceeds 1 MiB")
        value = json.loads(raw.decode("utf-8"), object_pairs_hook=initiative_no_duplicate_keys)
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        fail(f"cannot read Initiative manifest: {error}")
    initiative_fields(value, {
        "schema_version", "id", "title", "state", "coordinator_repository", "statements",
        "contexts", "slices", "release_groups",
    }, "Initiative manifest")
    if type(value["schema_version"]) is not int or value["schema_version"] != 1:
        fail("Initiative manifest schema_version must be 1")
    if not isinstance(value["id"], str) or not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,127}", value["id"]):
        fail("Initiative ID is invalid")
    if not isinstance(value["title"], str) or not value["title"].strip():
        fail("Initiative title is invalid")
    initiative_repository(value["coordinator_repository"], "Initiative coordinator_repository")
    if value["state"] not in {"captured", "discovering", "ready", "building", "delivered",
                               "blocked", "deferred", "rejected", "complete"}:
        fail("Initiative state is invalid")
    for name in ("statements", "contexts", "slices", "release_groups"):
        if not isinstance(value[name], list):
            fail(f"Initiative manifest {name} must be an array")

    statement_fields = {"id", "kind", "text", "disposition", "artifacts"}
    statements = {}
    for item in value["statements"]:
        initiative_fields(item, statement_fields, "material statement")
        identifier = item["id"]
        if not isinstance(identifier, str) or not re.fullmatch(r"INT-[0-9]{3,}", identifier):
            fail("material statement ID is invalid")
        if identifier in statements:
            fail(f"duplicate material statement ID: {identifier}")
        if item["kind"] not in {"requirement", "constraint", "decision", "risk", "idea", "non-goal"}:
            fail(f"material statement kind is invalid: {identifier}")
        if not isinstance(item["text"], str) or not item["text"].strip():
            fail(f"material statement text is invalid: {identifier}")
        if item["disposition"] not in {"open", "blocked", "ready", "delivered", "deferred", "rejected"}:
            fail(f"material statement disposition is invalid: {identifier}")
        initiative_paths(item["artifacts"], f"artifacts for {identifier}")
        statements[identifier] = item

    context_fields = {"id", "repository", "status", "depends_on"}
    contexts = {}
    for item in value["contexts"]:
        initiative_fields(item, context_fields, "context")
        identifier = item["id"]
        if not isinstance(identifier, str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_-]{0,127}", identifier):
            fail("context ID is invalid")
        if identifier in contexts:
            fail(f"duplicate context ID: {identifier}")
        initiative_repository(item["repository"], f"repository for {identifier}")
        initiative_strings(item["depends_on"], f"depends_on for {identifier}")
        if item["status"] not in {"captured", "approved", "discovering", "ready", "building",
                                   "delivered", "blocked", "deferred", "rejected"}:
            fail(f"context state is invalid: {identifier}")
        contexts[identifier] = item

    context_dependencies = {}
    for identifier, item in contexts.items():
        for dependency in item["depends_on"]:
            if dependency not in contexts:
                fail(f"unknown context dependency {dependency}: {identifier}")
        context_dependencies[identifier] = item["depends_on"]
    initiative_acyclic(context_dependencies, "context")

    slice_fields = {"id", "context", "state", "requirements", "depends_on", "artifacts",
                    "release_group"}
    slices = {}
    for item in value["slices"]:
        optional = {field for field in ("tickets", "execution_owner")
                    if isinstance(item, dict) and field in item}
        initiative_fields(item, slice_fields | optional, "slice")
        identifier = item["id"]
        if not isinstance(identifier, str) or not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,127}", identifier):
            fail("slice ID is invalid")
        if identifier in slices:
            fail(f"duplicate slice ID: {identifier}")
        if item["context"] not in contexts:
            fail(f"unknown context for slice {identifier}: {item['context']}")
        for field in ("requirements", "depends_on"):
            initiative_strings(item[field], f"{field} for {identifier}")
        initiative_paths(item["artifacts"], f"artifacts for {identifier}")
        if not isinstance(item["release_group"], str) or not item["release_group"]:
            fail(f"release_group is invalid: {identifier}")
        if item.get("execution_owner", "build") not in {"build", "discovery"}:
            fail(f"execution_owner is invalid: {identifier}")
        if item["state"] not in {"captured", "discovering", "ready", "building", "delivered",
                                    "blocked", "deferred", "rejected"}:
            fail(f"slice state is invalid: {identifier}")
        for requirement in item["requirements"]:
            if requirement not in statements:
                fail(f"unknown material statement {requirement} required by {identifier}")
        if item["state"] == "ready":
            if contexts[item["context"]]["status"] not in {
                    "approved", "discovering", "ready", "building", "delivered"}:
                fail(f"ready slice {identifier} context is not promotable: {item['context']}")
            for field in ("requirements", "artifacts"):
                if not item[field]:
                    fail(f"ready slice {identifier} requires {field}")
            blocked = [requirement for requirement in item["requirements"]
                       if statements[requirement]["disposition"] in {"open", "blocked"}]
            if blocked:
                fail(f"ready slice {identifier} has unresolved material statement: {blocked[0]}")
        slices[identifier] = item

    slice_dependencies = {}
    for identifier, item in slices.items():
        for dependency in item["depends_on"]:
            if dependency not in slices:
                fail(f"unknown slice dependency {dependency}: {identifier}")
        slice_dependencies[identifier] = item["depends_on"]
    initiative_acyclic(slice_dependencies, "slice")
    for identifier, item in slices.items():
        if item["state"] != "ready":
            continue
        for dependency in item["depends_on"]:
            if slices[dependency]["state"] != "delivered":
                fail(f"ready slice {identifier} dependency is not delivered: {dependency}")
        for dependency in contexts[item["context"]]["depends_on"]:
            if contexts[dependency]["status"] not in {"ready", "building", "delivered"}:
                fail(f"ready slice {identifier} context dependency is not ready: {dependency}")

    for identifier, item in statements.items():
        covered = item["artifacts"] or any(identifier in slice_item["requirements"]
                                            for slice_item in slices.values())
        if item["disposition"] not in {"deferred", "rejected"} and not covered:
            fail(f"uncovered material statement: {identifier}")

    release_fields = {"id", "members", "state"}
    release_groups = {}
    slice_release_groups = {}
    for item in value["release_groups"]:
        initiative_fields(item, release_fields, "release group")
        identifier = item["id"]
        if not isinstance(identifier, str) or not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,127}", identifier):
            fail("release-group ID is invalid")
        if identifier in release_groups:
            fail(f"duplicate release-group ID: {identifier}")
        if item["state"] not in {"planning", "ready", "building", "delivered", "blocked",
                                   "deferred", "rejected"}:
            fail(f"release-group state is invalid: {identifier}")
        initiative_strings(item["members"], f"members for {identifier}")
        for slice_id in item["members"]:
            if slice_id not in slices:
                fail(f"unknown slice {slice_id} in release group {identifier}")
            if slice_id in slice_release_groups:
                fail(f"slice {slice_id} belongs to multiple release groups")
            if slices[slice_id]["release_group"] != identifier:
                fail(f"release group mismatch for slice {slice_id}")
            slice_release_groups[slice_id] = identifier
        release_groups[identifier] = item
    for identifier, item in slices.items():
        if item["release_group"] not in release_groups:
            fail(f"unknown release group {item['release_group']} for slice {identifier}")
        if identifier not in slice_release_groups:
            fail(f"slice {identifier} is missing from release group {item['release_group']}")

    if value["state"] == "complete":
        unresolved = [identifier for identifier, item in statements.items()
                      if item["disposition"] in {"open", "blocked"}]
        nonterminal = [identifier for identifier, item in slices.items()
                       if item["state"] not in {"delivered", "deferred", "rejected"}]
        if unresolved or nonterminal:
            fail("Initiative cannot complete with open or blocked material or nonterminal slices")

    identity_value = {**value, "slices": [
        {key: field for key, field in item.items() if key != "tickets"}
        for item in value["slices"]
    ]}
    canonical = json.dumps(identity_value, sort_keys=True, separators=(",", ":"), ensure_ascii=True)
    return value, statements, contexts, slices, slice_release_groups, hashlib.sha256(canonical.encode()).hexdigest()


def initiative_summary(source):
    value, _, contexts, slices, release_groups, digest = read_initiative_manifest(source)
    return {
        "schema_version": 1,
        "initiative_id": value["id"],
        "state": value["state"],
        "manifest_digest": digest,
        "ready_slices": sorted(identifier for identifier, item in slices.items() if item["state"] == "ready"),
        "counts": {
            "statements": len(value["statements"]),
            "contexts": len(contexts),
            "slices": len(slices),
            "release_groups": len(value["release_groups"]),
        },
    }


def command_initiative_check(args):
    print(json.dumps(initiative_summary(args.manifest), sort_keys=True, separators=(",", ":")))


def initiative_receipt(source, slice_id, root=None):
    value, statements, contexts, slices, release_groups, digest = read_initiative_manifest(source)
    item = slices.get(slice_id)
    if item is None:
        fail(f"unknown Initiative slice: {slice_id}")
    if item["state"] != "ready":
        fail(f"Initiative slice is not ready: {slice_id}")
    if item.get("execution_owner", "build") != "build":
        fail(f"Initiative slice is owned by Discovery and cannot issue a Build receipt: {slice_id}")
    identity = {}
    artifacts = sorted(set(item["artifacts"]).union(
        *(statements[requirement]["artifacts"] for requirement in item["requirements"])))
    if root is not None:
        try:
            relative = Path(source).resolve().relative_to(root.resolve()).as_posix()
        except ValueError:
            fail("Initiative manifest must be inside the current repository")
        if git(root, "status", "--porcelain=v1", "--", relative).stdout.strip():
            fail("Initiative manifest must be committed and clean before receipt")
        blob = git(root, "rev-parse", f"HEAD:{relative}", check=False).stdout.strip()
        if not re.fullmatch(r"[0-9a-f]{40,64}", blob):
            fail("Initiative manifest must be committed at HEAD before receipt")
        identity = {
            "manifest_blob": blob,
            "manifest_commit": git(root, "rev-parse", "HEAD").stdout.strip(),
        }
        if git_repository_slug(root).lower() != value["coordinator_repository"].lower():
            fail("Initiative coordinator repository does not match the source Git repository")
        for artifact in artifacts:
            if (git(root, "status", "--porcelain=v1", "--", artifact).stdout.strip()
                    or git(root, "cat-file", "-e", f"HEAD:{artifact}", check=False).returncode):
                fail(f"Initiative artifact must be committed and clean before receipt: {artifact}")
    return {
        "schema_version": 1,
        "initiative_id": value["id"],
        "slice_id": slice_id,
        "manifest_digest": digest,
        "coordinator_repository": value["coordinator_repository"],
        "context": item["context"],
        "repository": contexts[item["context"]]["repository"],
        "requirements": item["requirements"],
        "depends_on": item["depends_on"],
        "artifacts": artifacts,
        "release_group": release_groups.get(slice_id),
        "execution_owner": "build",
        **identity,
    }


def command_initiative_receipt(args):
    print(json.dumps(initiative_receipt(args.manifest, args.slice, root_dir()),
                     sort_keys=True, separators=(",", ":")))


def managed_graphify_adapter():
    directory = Path(__file__).resolve().parent
    for name in ("dbsctr-project-graphify", "executable_dbsctr-project-graphify"):
        path = directory / name
        try:
            descriptor = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
        except FileNotFoundError:
            continue
        try:
            details = os.fstat(descriptor)
            content = os.read(descriptor, details.st_size + 1)
        finally:
            os.close(descriptor)
        if (stat.S_IFMT(details.st_mode) != stat.S_IFREG or details.st_uid != os.getuid()
                or not details.st_mode & stat.S_IXUSR or len(content) != details.st_size):
            fail("managed Graphify adapter is unsafe")
        return path, hashlib.sha256(content).hexdigest()
    fail("managed Graphify adapter is missing")


def archived_graphify_adapter(root, digest, source=None):
    directory = cycle_dir(root) / "graphify" / "adapters"
    managed_directory(root, directory, create=True)
    path = directory / digest
    if source is not None and not path.exists():
        descriptor = os.open(source, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
        try:
            content = os.fdopen(descriptor, "rb").read()
        finally:
            with contextlib.suppress(OSError):
                os.close(descriptor)
        if hashlib.sha256(content).hexdigest() != digest:
            fail("managed Graphify adapter identity changed")
        try:
            descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o700)
        except FileExistsError:
            pass
        else:
            with os.fdopen(descriptor, "wb") as handle:
                handle.write(content)
                handle.flush()
                os.fsync(handle.fileno())
    try:
        details = path.lstat()
        content = path.read_bytes()
    except OSError:
        fail("managed Graphify adapter snapshot is missing")
    if (path.is_symlink() or stat.S_IFMT(details.st_mode) != stat.S_IFREG
            or details.st_uid != os.getuid() or details.st_mode & 0o077
            or not details.st_mode & stat.S_IXUSR
            or hashlib.sha256(content).hexdigest() != digest):
        fail("managed Graphify adapter snapshot is unsafe")
    return path


def validate_graphify_selection(root, value, commit="HEAD", require_clean=False):
    del commit, require_clean
    if not isinstance(value, dict) or set(value) not in (
            {"version"}, {"version", "adapter_contract", "adapter_sha256"}):
        fail("graphify selection requires exactly version")
    version = value["version"]
    if not isinstance(version, str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._+-]{0,63}", version):
        fail("Graphify version is invalid")
    if len(value) == 1:
        adapter, digest = managed_graphify_adapter()
        archived_graphify_adapter(root, digest, adapter)
        normalized = {
            "version": version,
            "adapter_contract": "dbsctr-project-graphify-v1",
            "adapter_sha256": digest,
        }
    else:
        normalized = value
        if (value.get("adapter_contract") != "dbsctr-project-graphify-v1"
                or not re.fullmatch(r"[0-9a-f]{64}", value.get("adapter_sha256", ""))):
            fail("managed Graphify adapter identity is invalid")
        archived_graphify_adapter(root, value["adapter_sha256"])
    return normalized


def validate_plan(root, context, intent, plan, recorded_profile=None):
    if not set(plan) <= {"profile", "gates", "graphify"}:
        fail("applicability plan allows only profile, gates, and optional graphify")
    profile = f"docs/specs/{context}/PROFILE.md"
    profile_blob = git(root, "rev-parse", f"HEAD:{profile}", check=False).stdout.strip()
    expected_profile = recorded_profile or (profile if re.fullmatch(r"[0-9a-f]+", profile_blob)
                                              else f"docs/specs/{context}/README.md")
    if plan.get("profile") != expected_profile:
        fail(f"Engineering Profile must be {expected_profile}")
    if status := git(root, "status", "--porcelain=v1", "--", expected_profile).stdout.strip():
        fail(f"Engineering Profile must be tracked and committed: {status}")
    blob = git(root, "rev-parse", f"HEAD:{expected_profile}", check=False).stdout.strip()
    if not re.fullmatch(r"[0-9a-f]+", blob) or git(
        root, "cat-file", "-e", f"{blob}^{{blob}}", check=False
    ).returncode:
        fail("Engineering Profile is not committed at HEAD")
    gates = plan.get("gates")
    if not isinstance(gates, dict) or set(gates) != set(GATES):
        fail("applicability plan must define every gate exactly once")
    normalized = {}
    for name in GATES:
        item = gates[name]
        if not isinstance(item, dict) or item.get("applicability") not in ("required", "not_applicable"):
            fail(f"invalid applicability for gate: {name}")
        applicability = item["applicability"]
        expected_keys = {"applicability", "reason"} if applicability == "not_applicable" else {"applicability"}
        if set(item) != expected_keys:
            fail(f"invalid applicability fields for gate: {name}")
        if name in MANDATORY_GATES and applicability != "required":
            fail(f"gate is always required: {name}")
        normalized[name] = {"applicability": applicability}
        if applicability == "not_applicable":
            reason = item.get("reason")
            if not isinstance(reason, str) or not reason.strip():
                fail(f"not_applicable gate needs a reason: {name}")
            normalized[name].update({"result": "not_run", "reason": reason.strip()})
        else:
            normalized[name]["result"] = "pending"
    if intent == "release" and normalized["release"]["applicability"] != "required":
        fail("release delivery requires the release gate")
    if intent == "deploy" and normalized["deploy"]["applicability"] != "required":
        fail("deploy delivery requires the deploy gate")
    graphify = None
    if "graphify" in plan:
        graphify = validate_graphify_selection(root, plan["graphify"], require_clean=True)
    return expected_profile, blob, normalized, graphify


def disposed(gate):
    return (gate["applicability"] == "not_applicable" or gate["result"] == "passed"
            or gate["result"] in ("failed", "unavailable") and "exception" in gate)


def invalidate_later(record, gate_name):
    for name in GATES[GATES.index(gate_name) + 1:]:
        gate = record["gates"][name]
        if gate["applicability"] == "required" and gate["result"] == "passed":
            gate["result"] = "pending"
            gate.pop("evidence", None)
            gate.pop("exception", None)
            record.setdefault("metrics", {}).setdefault("gate_reopen_count", 0)
            record["metrics"]["gate_reopen_count"] += 1


def require_current_profile(root, record):
    if not is_v32(record):
        return
    profile = record["engineering_profile"]
    current = git(root, "rev-parse", f"HEAD:{profile['path']}", check=False).stdout.strip()
    if current != profile["blob"]:
        fail("Engineering Profile changed; update the applicability plan")


def apply_stricter_plan(root, record, plan):
    profile_path, profile_blob, gates, graphify = validate_plan(
        root, record["context"], record["delivery_intent"], plan,
        record["engineering_profile"]["path"],
    )
    if profile_path != record["engineering_profile"]["path"]:
        fail("Engineering Profile path changed; start a new cycle")
    previous_graphify = record["applicability_plan"].get("graphify")
    if previous_graphify and graphify is None:
        fail("Graphify selection cannot be removed")
    if previous_graphify and graphify != previous_graphify:
        fail("Graphify selection cannot change")
    if previous_graphify is None and graphify is not None and profile_blob == record["engineering_profile"]["blob"]:
        fail("Graphify selection requires a committed Engineering Profile change")
    for name, new_gate in gates.items():
        if (record["gates"][name]["applicability"] == "required"
                and new_gate["applicability"] != "required"):
            fail(f"applicability plan cannot loosen gate: {name}")
    for name, new_gate in gates.items():
        old_gate = record["gates"][name]
        if old_gate["applicability"] == "not_applicable" and new_gate["applicability"] == "required":
            old_gate.update({"applicability": "required", "result": "pending"})
            old_gate.pop("reason", None)
            old_gate.pop("exception", None)
            invalidate_later(record, name)
    if profile_blob != record["engineering_profile"]["blob"]:
        record.setdefault("profile_history", []).append({
            "blob": record["engineering_profile"]["blob"], "replaced_at": now(),
        })
        record["engineering_profile"]["blob"] = profile_blob
    record["applicability_plan"] = {"profile": profile_path, "gates": {
        name: {key: value for key, value in gate.items() if key in ("applicability", "reason")}
        for name, gate in gates.items()
    }, **({"graphify": graphify} if graphify else {})}


def artifact_check(record):
    reviews = record["artifact_reviews"]
    incomplete = [name for name in ARTIFACTS if reviews[name]["result"] == "pending"]
    if incomplete:
        fail("artifact reviews pending: " + ", ".join(incomplete))
    if not reviews["BACKLOG"]["reviewed_at"]:
        fail("BACKLOG review is incomplete")
    readme = reviews["README"]
    if readme["result"] == "unchanged" and not readme["reason"]:
        fail("README unchanged review requires a reason")
    if record["state"] in ("finalizing", "completed") and reviews["CHANGELOG"]["result"] == "pending":
        fail("CHANGELOG review is required when finalizing")


def completion_artifact_check(record):
    artifact_check(record)
    if record["artifact_reviews"]["CHANGELOG"]["result"] != "changed":
        fail("CHANGELOG must record the completed cycle before Final Push")
    changelog_path = record["artifact_reviews"]["CHANGELOG"].get("path")
    if not changelog_path:
        fail("changed CHANGELOG review needs its repository path")


def start_cycle(root, args, plan, created_by_dbsctr=False, worktree_locator=None,
                portable=True, git_env=None):
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", args.cycle_id):
        fail("cycle ID must be a simple filename")
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_-]*", args.context):
        fail("context must be a simple bounded-context name")
    directory = cycle_dir(root)
    active = active_path(root)
    if active.exists() or legacy_active_path(root).exists() or (legacy_cycle_dir(root) / "active").exists():
        fail("an active DBSCTR cycle already exists")
    record_path = directory / "cycles" / f"{args.cycle_id}.json"
    if record_path.exists():
        fail(f"cycle record already exists: {args.cycle_id}")
    dirty_paths = status_paths(root)
    if dirty_paths:
        fail("cycle must start with a clean worktree: " + ", ".join(dirty_paths))
    profile_path, profile_blob, gates, graphify = validate_plan(
        root, args.context, args.delivery_intent, plan
    )
    current_branch = branch(root)
    current_upstream = upstream(root)
    delivery_remote, delivery_branch = configured_upstream(root)
    pre_cycle_ahead = ahead(root, current_upstream)
    protected_base_branch = args.base_branch
    if git(root, "check-ref-format", "--branch", protected_base_branch, check=False).returncode:
        fail("invalid protected base branch")
    if args.delivery_intent == "draft_pr":
        account = getattr(args, "github_account", None)
        repository = getattr(args, "github_repository", None)
        if (not account or not OPAQUE_ID.fullmatch(account) or not repository
                or not re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", repository)):
            fail("draft_pr delivery requires a valid GitHub account and repository")
        if not current_branch or current_branch == protected_base_branch:
            fail("draft_pr delivery requires a feature branch distinct from its base")
        if not delivery_remote:
            fail("draft_pr delivery requires a configured remote")
        if git_env is None:
            delivery_url = delivery_remote
            git(root, "fetch", delivery_remote, protected_base_branch)
        else:
            delivery_url = github_remote_url(root, delivery_remote, repository)
            fetch_github_branch(root, delivery_remote, delivery_url, protected_base_branch, git_env)
        base_head = git(root, "rev-parse", f"refs/remotes/{delivery_remote}/{protected_base_branch}").stdout.strip()
        if git_env is None:
            published_head = git(
                root, "ls-remote", "--heads", delivery_remote, f"refs/heads/{current_branch}"
            ).stdout.split()
        else:
            published_head = github_remote_head(
                root, delivery_url, f"refs/heads/{current_branch}", git_env
            )
        if pre_cycle_ahead and (not published_head or published_head[0] != git(root, "rev-parse", "HEAD").stdout.strip()):
            fail("pre-cycle commits are not published on the feature branch")
        delivery = {
            "upstream": current_upstream, "remote": delivery_remote,
            "branch": current_branch, "base_branch": protected_base_branch, "base_head": base_head,
            **({"published_feature_head": published_head[0]} if published_head else {}),
            "github": {"host": "github.com", "account": account, "repository": repository},
            "lock_id": delivery_lock_id(
                (remote_destination(root, current_upstream).get("push_url")
                 if git_env is None else delivery_url),
                remote_branch=current_branch,
            ),
        }
    else:
        if delivery_branch == protected_base_branch:
            fail("direct delivery to the protected base branch requires draft_pr")
        delivery = {"upstream": current_upstream, "remote": delivery_remote,
                    "branch": delivery_branch, "protected_base_branch": protected_base_branch,
                    "lock_id": delivery_lock_id(
            remote_destination(root, current_upstream).get("push_url"), remote_branch=delivery_branch
        )}
    schema_version = 4 if portable else 3
    if schema_version == 4:
        worktree_locator = worktree_locator or {"root": "cycle_worktree", "path": "."}
        worktree_details = {"id": worktree_id(root), "locator": worktree_locator,
                            "branch": current_branch,
                            "base_commit": git(root, "rev-parse", "HEAD").stdout.strip(),
                            "created_by_dbsctr": created_by_dbsctr}
    else:
        worktree_details = {"id": legacy_worktree_id(root), "path": str(root.resolve()),
                            "git_dir": str(git_dir(root).resolve()), "branch": current_branch,
                            "base_commit": git(root, "rev-parse", "HEAD").stdout.strip(),
                            "created_by_dbsctr": created_by_dbsctr}
    record = {
        "method_revision": CURRENT_METHOD_REVISION, "schema_version": schema_version,
        "created_at": now(), "cycle_id": args.cycle_id,
        "context": args.context, "risk": args.risk, "delivery_intent": args.delivery_intent,
        "engineering_profile": {"path": profile_path, "blob": profile_blob},
        "applicability_plan": {"profile": profile_path, "gates": {
            name: {key: value for key, value in gate.items() if key in ("applicability", "reason")}
            for name, gate in gates.items()
        }, **({"graphify": graphify} if graphify else {})},
        "git": {"head": git(root, "rev-parse", "HEAD").stdout.strip(), "branch": current_branch,
                "upstream": current_upstream, "dirty_paths": dirty_paths,
                "pre_cycle_ahead_commits": pre_cycle_ahead,
                 "remote": remote_destination(root, current_upstream)},
        "worktree": worktree_details,
        "delivery": delivery,
        "state": "active", "commits": [], "gates": gates, "evidence": {"version": 1, "items": {}},
        "metrics": {"gate_failure_count": 0, "gate_reopen_count": 0, "remediation_round_count": 0},
        "artifact_reviews": {name: {"result": "pending", "reason": None, "reviewed_at": None}
                             for name in ARTIFACTS},
    }
    message_id = getattr(args, "opencode_message_id", None)
    session_id = (session_for_message(None, message_id) if message_id is not None
                  else getattr(args, "opencode_session_id", None))
    if session_id is not None:
        if (not OPAQUE_ID.fullmatch(session_id) or not getattr(args, "opencode_worktree", None)
                or not getattr(args, "opencode_directory", None)):
            fail("invalid OpenCode session ID")
        runtime_worktree = Path(args.opencode_worktree).resolve()
        runtime_directory = Path(args.opencode_directory).resolve()
        if not runtime_worktree.is_dir() or not runtime_directory.is_dir() or runtime_worktree not in runtime_directory.parents and runtime_directory != runtime_worktree:
            fail("invalid OpenCode runtime paths")
        activation_raw = getattr(args, "harness_activation_json", None)
        activation = (harness_activation_for_message(None, message_id, activation_raw)
                      if message_id is not None and activation_raw is not None else None)
        if schema_version == 4:
            runtime_root = root.resolve()
            root_name = "cycle_worktree"
            if runtime_worktree != runtime_root:
                runtime_root = primary_worktree(root)
                root_name = "primary_worktree"
                if runtime_worktree != runtime_root:
                    fail("invalid OpenCode runtime paths")
            try:
                runtime_directory_relative = runtime_directory.relative_to(runtime_root)
            except ValueError:
                fail("invalid OpenCode runtime paths")
            runtime = {"path_root": root_name, "worktree": ".",
                       "directory": runtime_directory_relative.as_posix() or "."}
        else:
            runtime = {"worktree": str(runtime_worktree), "directory": str(runtime_directory)}
        record["runtime"] = {"opencode": {"session_ids": [session_id], **runtime,
                                               **({"harness_activation": activation} if activation else {})}}
    elif getattr(args, "opencode_worktree", None) or getattr(args, "opencode_directory", None):
        fail("OpenCode runtime paths require a session ID")
    improvement_worker_id = os.environ.get("DBSCTR_IMPROVEMENT_WORKER_ID")
    if improvement_worker_id is not None:
        improvement_worker_id = improvement_id(improvement_worker_id, "improvement worker ID")
        ledger_root = review_root()
        if session_id is None or not ledger_exists(ledger_root):
            fail("improvement cycle requires a registered guest session")
        connection = sqlite3.connect(f"file:{ledger_path(ledger_root)}?mode=ro", uri=True)
        try:
            worker = connection.execute(
                "SELECT session_id,opportunity_id,state,discovery_report FROM improvement_workers WHERE worker_id=?",
                (improvement_worker_id,),
            ).fetchone()
        except sqlite3.Error:
            worker = None
        finally:
            connection.close()
        if (worker is None or worker[0] != session_id or worker[1] is None
                or worker[2] != "discovery" or worker[3] is None):
            fail("improvement cycle requires a Discovery-ready guest projection")
        record["improvement"] = {
            "worker_id": improvement_worker_id, "session_id": session_id,
            "opportunity_id": worker[1],
        }
    active = cycle_dir(root) / "worktrees" / record["worktree"]["id"] / "active"
    exclusive_json(record_path, record)
    try:
        write_active_pointer(root, active, args.cycle_id)
    except Exception:
        record_path.unlink(missing_ok=True)
        raise
    return record


def command_start(args):
    root = root_dir()
    record = start_cycle(root, args, read_plan(args.plan))
    print(record["cycle_id"])


def command_begin(args):
    source = root_dir()
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", args.cycle_id):
        fail("cycle ID must be a simple filename")
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_-]*", args.context):
        fail("context must be a simple bounded-context name")
    initiative_values = (args.initiative_manifest, args.initiative_slice, args.initiative_digest)
    if any(value is not None for value in initiative_values) and not all(
            value is not None for value in initiative_values):
        fail("Initiative begin requires manifest, slice, and digest together")
    if args.initiative_source is not None and not all(value is not None for value in initiative_values):
        fail("Initiative source requires manifest, slice, and digest")
    if args.initiative_manifest is not None:
        if (not re.fullmatch(r"[0-9a-f]{64}", args.expected_plan_digest or "")
                or args.expected_repository is None):
            fail("Initiative begin requires approved plan and repository identities")
        initiative_repository(args.expected_repository, "expected repository")
    initiative = None
    if args.initiative_manifest is not None:
        if not re.fullmatch(r"docs/initiatives/[a-z0-9][a-z0-9-]*/MANIFEST\.json",
                            args.initiative_manifest):
            fail("Initiative manifest must be a repository-relative docs/initiatives path")
        initiative_source = repo_root(args.initiative_source) if args.initiative_source else source
        initiative = initiative_receipt(
            initiative_source / args.initiative_manifest, args.initiative_slice, initiative_source)
        initiative["manifest_path"] = args.initiative_manifest
        if initiative["manifest_digest"] != args.initiative_digest:
            fail("Initiative manifest changed after approval")
        if git_repository_slug(source).lower() != initiative["repository"].lower():
            fail("Initiative context home does not match the target Git repository")
        if initiative["repository"].lower() != args.expected_repository.lower():
            fail("Initiative target repository changed after approval")
    if initiative is not None:
        if initiative["context"] != args.context:
            fail("Initiative receipt context does not match the cycle context")
    if args.resume_existing and initiative is None:
        fail("resume-existing is limited to approved Initiative begin")
    plan = read_plan(args.plan, args.expected_plan_digest)
    target = upstream(source)
    remote, remote_branch = configured_upstream(source)
    if not target or not remote or not remote_branch:
        fail("begin requires a configured remote upstream")
    normalize_begin_delivery(source, args, remote_branch)
    if args.delivery_intent == "draft_pr":
        remote_url = github_remote_url(source, remote, args.github_repository)
        delivery_env = github_environment(args.github_account)
    else:
        remote_url, delivery_env = remote, None
    source_record = {"path": str(source.resolve()), "branch": branch(source), "upstream": upstream(source),
                      "head": git(source, "rev-parse", "HEAD").stdout.strip(), "dirty_paths": status_paths(source),
                      "remote": remote_destination(source, upstream(source))}
    if args.delivery_intent == "draft_pr":
        fetch_github_branch(source, remote, remote_url, remote_branch, delivery_env)
    else:
        git(source, "fetch", remote, remote_branch)
    if ahead(source, target):
        fail("unknown commits are ahead of upstream; reconcile them before begin")
    branch_name = f"dbsctr/{args.context}/{args.cycle_id}"
    if git(source, "show-ref", "--verify", "--quiet", f"refs/heads/{branch_name}", check=False).returncode == 0:
        if not args.resume_existing:
            fail(f"cycle branch already exists: {branch_name}")
        record_path = cycle_dir(source) / "cycles" / f"{args.cycle_id}.json"
        if not record_path.is_file():
            fail("existing Initiative cycle record is missing")
        record = json.loads(record_path.read_text(encoding="utf-8"))
        worktree = record_worktree(source, record)
        _, active_record = load(worktree)
        require_active(active_record)
        profile_path, profile_blob, gates, graphify = validate_plan(
            worktree, args.context, args.delivery_intent, plan)
        expected_plan = {"profile": profile_path, "gates": {
            name: {key: value for key, value in gate.items() if key in ("applicability", "reason")}
            for name, gate in gates.items()
        }, **({"graphify": graphify} if graphify else {})}
        protected_base = record.get("delivery", {}).get(
            "base_branch" if args.delivery_intent == "draft_pr" else "protected_base_branch")
        expected_github = ({"host": "github.com", "account": args.github_account,
                            "repository": args.github_repository}
                           if args.delivery_intent == "draft_pr" else None)
        if (active_record != record or record.get("cycle_id") != args.cycle_id
                or record.get("context") != args.context or record.get("risk") != args.risk
                or record.get("delivery_intent") != args.delivery_intent
                or record.get("initiative") != initiative
                or record.get("git", {}).get("upstream") != target
                or record.get("worktree", {}).get("created_by_dbsctr") is not True
                or record.get("worktree", {}).get("branch") != branch_name
                or not record_worktree_matches(source, record, worktree)
                or branch(worktree) != branch_name or protected_base != args.base_branch
                or (expected_github is not None
                    and record.get("delivery", {}).get("github") != expected_github)
                or record.get("engineering_profile") != {"path": profile_path, "blob": profile_blob}
                or record.get("applicability_plan") != expected_plan):
            fail("existing Initiative cycle does not match the approved launch")
        opencode = record.get("runtime", {}).get("opencode", {})
        print(json.dumps({
            "cycle_id": record["cycle_id"], "branch": branch_name,
            "worktree": str(worktree), "upstream": target,
            "open": ["opencode", str(worktree)], "initiative": initiative,
            "resumed": True,
            "runtime_attached": bool(opencode.get("session_ids")),
        }, sort_keys=True))
        return
    repo_id = hashlib.sha256(repository_identity(source).encode()).hexdigest()[:16]
    registry = worktree_registry_root()
    parent = Path(args.worktree_root).expanduser() if args.worktree_root else registry / repo_id
    worktree = parent / args.cycle_id
    if worktree.exists():
        fail(f"cycle worktree already exists: {worktree}")
    parent.mkdir(parents=True, exist_ok=True)
    git(source, "worktree", "add", "-b", branch_name, str(worktree), target)
    worktree = worktree.resolve()
    try:
        git(worktree, "branch", "--set-upstream-to", target, branch_name)
        if (source / ".dvc").exists() or (source / "dvc.yaml").exists():
            cache_owner = primary_worktree(source)
            cache_result = subprocess.run(["dvc", "cache", "dir"], cwd=cache_owner,
                                          text=True, capture_output=True)
            if cache_result.returncode or not cache_result.stdout.strip():
                fail(cache_result.stderr.strip() or "cannot resolve source DVC cache")
            shared_cache = Path(cache_result.stdout.strip().splitlines()[-1]).expanduser()
            if not shared_cache.is_absolute():
                shared_cache = cache_owner / shared_cache
            shared_cache = shared_cache.resolve()
            result = subprocess.run(["dvc", "cache", "dir", "--local", str(shared_cache)],
                                    cwd=worktree, text=True, capture_output=True)
            if result.returncode:
                fail(result.stderr.strip() or "cannot configure linked DVC cache")
            result = subprocess.run(["dvc", "config", "--local", "cache.type", "reflink,copy"],
                                    cwd=worktree, text=True, capture_output=True)
            if result.returncode:
                fail(result.stderr.strip() or "cannot configure linked DVC cache type")
        locator = relative_locator(worktree, registry, "dbsctr_worktrees")
        portable = args.worktree_root is None or os.environ.get("DBSCTR_WORKTREE_ROOT") is not None and locator is not None
        record = start_cycle(worktree, args, plan, created_by_dbsctr=True,
                             worktree_locator=locator, portable=portable, git_env=delivery_env)
        if initiative is not None:
            record["initiative"] = initiative
        if record["schema_version"] == 4:
            source_record.pop("path")
            source_record["locator"] = {"root": "primary_worktree", "path": "."}
        record["source"] = source_record
        save(cycle_dir(worktree) / "cycles" / f"{args.cycle_id}.json", record)
    except Exception:
        git(source, "worktree", "remove", str(worktree), check=False)
        git(source, "branch", "-D", branch_name, check=False)
        raise
    print(json.dumps({
        "cycle_id": record["cycle_id"], "branch": branch_name,
        "worktree": str(worktree), "upstream": target,
        "open": ["opencode", str(worktree)],
        **({"initiative": initiative} if initiative is not None else {}),
    }, sort_keys=True))


def cycle_runtime_locator(runtime, worktree, source):
    opencode = runtime.get("opencode") if isinstance(runtime, dict) else None
    if not isinstance(opencode, dict):
        return runtime
    runtime_worktree = Path(opencode.get("worktree", "")).expanduser().resolve()
    runtime_directory = Path(opencode.get("directory", "")).expanduser().resolve()
    if runtime_worktree == worktree.resolve():
        root_name, base = "cycle_worktree", worktree.resolve()
    elif source is not None and runtime_worktree == source.resolve():
        root_name, base = "primary_worktree", source.resolve()
    else:
        fail("OpenCode runtime worktree cannot be made portable")
    try:
        directory = runtime_directory.relative_to(base).as_posix() or "."
    except ValueError:
        fail("OpenCode runtime directory cannot be made portable")
    return {**runtime, "opencode": {
        **{key: value for key, value in opencode.items()
           if key not in {"path_root", "worktree", "directory"}},
        "path_root": root_name, "worktree": ".", "directory": directory,
    }}


def validate_active_pointer(root, pointer, cycle_id, required=False):
    managed_directory(root, pointer.parent)
    if pointer.exists():
        if active_pointer_id(root, pointer) != cycle_id:
            fail("cycle active pointer identity changed")
        return True
    if pointer.is_symlink():
        fail("cycle active pointer is unsafe")
    if required:
        fail("cycle active pointer is missing")
    return False


def write_active_pointer(root, pointer, cycle_id):
    if validate_active_pointer(root, pointer, cycle_id):
        return
    managed_directory(root, pointer.parent, create=True)
    temporary = pointer.with_suffix(".tmp")
    if temporary.exists() or temporary.is_symlink():
        fail("cycle active pointer temporary is unsafe")
    with temporary.open("x", encoding="utf-8") as handle:
        handle.write(cycle_id + "\n")
    os.replace(temporary, pointer)


def portable_cycle_record(root, record):
    worktree = record_worktree(root, record)
    registry = worktree_registry_root()
    locator = relative_locator(worktree, registry, "dbsctr_worktrees")
    if locator is None:
        fail("cycle worktree is outside configured registry")
    if (not worktree.is_dir() or not record_worktree_matches(root, record, worktree)
            or branch(worktree) != record.get("worktree", {}).get("branch")):
        fail("cycle worktree identity changed")
    source = record_source_worktree(root, record)
    if source is not None and source != primary_worktree(root):
        fail("source worktree identity changed")
    portable = json.loads(json.dumps(record))
    portable["schema_version"] = 4
    portable["worktree"] = {
        **{key: value for key, value in record["worktree"].items()
           if key not in {"id", "path", "git_dir", "locator"}},
        "id": worktree_id(worktree), "locator": locator,
    }
    if source is not None:
        portable["source"] = {
            **{key: value for key, value in record["source"].items() if key != "path"},
            "locator": {"root": "primary_worktree", "path": "."},
        }
    if "runtime" in portable:
        portable["runtime"] = cycle_runtime_locator(portable["runtime"], worktree, source)
    return worktree, portable


def command_cycle_portabilize(args):
    root = root_dir()
    cycle_id = improvement_id(args.cycle_id, "cycle ID")
    path = cycle_dir(root) / "cycles" / f"{cycle_id}.json"
    backup = cycle_dir(root) / "migrations" / f"{cycle_id}.schema3.json"
    if not path.is_file() or path.is_symlink():
        fail("cycle record is missing")
    with evidence_lock(root, cycle_id):
        record = json.loads(path.read_text(encoding="utf-8"), object_pairs_hook=no_duplicate_keys)
        if record.get("cycle_id") != cycle_id or record.get("state") != "active":
            fail("only the named active cycle can be made portable")
        managed_directory(root, backup.parent)
        if backup.exists() and (backup.is_symlink() or not backup.is_file()):
            fail("schema 3 rollback is invalid")
        legacy = (json.loads(backup.read_text(encoding="utf-8"), object_pairs_hook=no_duplicate_keys)
                  if backup.is_file() else None)
        if legacy is not None and (legacy.get("schema_version") != 3
                                   or legacy.get("cycle_id") != cycle_id
                                   or legacy.get("state") != "active"):
            fail("schema 3 rollback is invalid")
        if args.rollback:
            if legacy is None:
                if record.get("schema_version") == 3:
                    print(json.dumps({"cycle_id": cycle_id, "schema_version": 3}, sort_keys=True))
                    return
                fail("portable cycle has no schema 3 rollback")
            if record.get("schema_version") == 4:
                current_id = record["worktree"]["id"]
            elif record.get("schema_version") == 3 and record == legacy:
                current_id = worktree_id(record_worktree(root, legacy))
            else:
                fail("portable cycle rollback state is invalid")
            old_pointer = cycle_dir(root) / "worktrees" / legacy["worktree"]["id"] / "active"
            write_active_pointer(root, old_pointer, cycle_id)
            if record != legacy:
                save(path, legacy)
            current_pointer = cycle_dir(root) / "worktrees" / current_id / "active"
            if current_pointer != old_pointer:
                validate_active_pointer(root, current_pointer, cycle_id)
                current_pointer.unlink(missing_ok=True)
            backup.unlink()
            print(json.dumps({"cycle_id": cycle_id, "schema_version": 3}, sort_keys=True))
            return
        if legacy is None:
            if record.get("schema_version") == 4:
                print(json.dumps({"cycle_id": cycle_id, "schema_version": 4}, sort_keys=True))
                return
            if record.get("schema_version") != 3:
                fail("cycle is not an unmigrated schema 3 record")
            old_pointer = cycle_dir(root) / "worktrees" / record["worktree"]["id"] / "active"
            validate_active_pointer(root, old_pointer, cycle_id, required=True)
            managed_directory(root, backup.parent, create=True)
            exclusive_json(backup, record)
            legacy = record
        if record.get("schema_version") == 3:
            old_pointer = cycle_dir(root) / "worktrees" / legacy["worktree"]["id"] / "active"
            validate_active_pointer(root, old_pointer, cycle_id, required=True)
        worktree, portable = portable_cycle_record(root, legacy)
        if record.get("schema_version") == 3 and record == legacy:
            save(path, portable)
        elif record.get("schema_version") != 4 or record != portable:
            fail("portable cycle migration state is invalid")
        new_pointer = cycle_dir(root) / "worktrees" / portable["worktree"]["id"] / "active"
        write_active_pointer(root, new_pointer, cycle_id)
        old_pointer = cycle_dir(root) / "worktrees" / legacy["worktree"]["id"] / "active"
        if old_pointer != new_pointer:
            if old_pointer.exists() or old_pointer.is_symlink():
                validate_active_pointer(root, old_pointer, cycle_id)
            old_pointer.unlink(missing_ok=True)
    print(json.dumps({"cycle_id": cycle_id, "schema_version": 4}, sort_keys=True))


def cleanup_cycle(root, cycle_id, immediate):
    path = cycle_dir(root) / "cycles" / f"{cycle_id}.json"
    if not path.is_file():
        fail(f"cycle record is missing: {cycle_id}")
    record = json.loads(path.read_text(encoding="utf-8"))
    if record.get("state") != "completed":
        fail("only a completed cycle can be cleaned up")
    if record.get("worktree", {}).get("created_by_dbsctr") is not True:
        fail("cleanup only removes DBSCTR-created worktrees")
    worktree = record_worktree(root, record)
    durable_cleanup = record.get("schema_version") in (3, 4)
    if not worktree.is_dir() and not durable_cleanup:
        return "already removed " + str(worktree)
    cleanup = record.get("cleanup")
    if not worktree.is_dir() and (not cleanup or cleanup.get("state") not in (
            "removing_worktree", "worktree_removed", "evidence_parked")):
        fail("cycle worktree is missing")
    branch_name = record["worktree"].get("branch")
    expected_branch = f"dbsctr/{record['context']}/{cycle_id}"
    if branch_name != expected_branch:
        fail("invalid cycle worktree branch")
    if worktree.resolve() == root.resolve():
        fail("run cleanup from another worktree")
    if cleanup and cleanup.get("state") in ("removing_worktree", "worktree_removed"):
        marker_branch = cleanup.get("branch")
        if marker_branch is not None and marker_branch != branch_name:
            fail("cleanup branch identity changed")
        if marker_branch is None:
            cleanup["branch"] = branch_name
            save(path, record)
    if not worktree.is_dir() and cleanup and cleanup.get("state") == "removing_worktree":
        registered = {line.removeprefix("worktree ") for line in
                      git(root, "worktree", "list", "--porcelain").stdout.splitlines()
                      if line.startswith("worktree ")}
        if str(worktree.resolve()) in registered:
            fail("incomplete Git worktree removal")
        record["cleanup"] = {"state": "worktree_removed", "branch": branch_name, "removed_at": now()}
        save(path, record)
        cleanup = record["cleanup"]
    completed = datetime.fromisoformat(record["completed_at"].replace("Z", "+00:00"))
    if not immediate and datetime.now(timezone.utc) - completed < timedelta(hours=24):
        fail("successful worktrees are retained for 24 hours; use --now to remove earlier")
    if worktree.is_dir() and status_paths(worktree):
        fail("refusing to remove a dirty cycle worktree")
    if worktree.is_dir() and branch(worktree) != record["worktree"]["branch"]:
        fail("cycle worktree branch changed")
    if worktree.is_dir() and not record_worktree_matches(root, record, worktree):
        fail("cycle worktree identity changed")
    recorded_commits = [entry["id"] for entry in record["commits"]]
    if worktree.is_dir() and recorded_commits and git(worktree, "rev-parse", "HEAD").stdout.strip() != recorded_commits[-1]:
        fail("cycle worktree HEAD changed")
    delivery = record.get("delivery", {})
    remote = delivery.get("remote")
    remote_branch = delivery.get("branch")
    if worktree.is_dir() and (not remote or not remote_branch):
        remote, remote_branch = remote_for_upstream(worktree, record["git"]["upstream"])
    expected = record["git"]["remote"]
    if worktree.is_dir() and expected != remote_destination(worktree, record["git"]["upstream"]):
        fail("remote push destination changed")
    if worktree.is_dir():
        if record.get("delivery_intent") == "draft_pr":
            git(worktree, "fetch", remote, f"refs/heads/{remote_branch}:refs/remotes/{remote}/{remote_branch}")
        else:
            git(worktree, "fetch", remote, remote_branch)
    target = (f"refs/remotes/{remote}/{remote_branch}" if record.get("delivery_intent") == "draft_pr"
              else record["git"]["upstream"])
    for entry in record["commits"]:
        if worktree.is_dir() and git(worktree, "merge-base", "--is-ancestor", entry["id"], target, check=False).returncode:
            fail("cycle commits are not all contained in the delivery target")
    if worktree.is_dir():
        if durable_cleanup:
            record["cleanup"] = {"state": "removing_worktree", "branch": branch_name, "started_at": now()}
            save(path, record)
        git(root, "worktree", "remove", str(worktree))
        if durable_cleanup:
            record["cleanup"] = {"state": "worktree_removed", "branch": branch_name, "removed_at": now()}
            save(path, record)
    if branch_name and git(root, "show-ref", "--verify", "--quiet", f"refs/heads/{branch_name}", check=False).returncode == 0:
        deleted = git(root, "branch", "-d", branch_name, check=False)
        if deleted.returncode:
            fail(deleted.stderr.strip() or "cannot delete cycle branch")
    if durable_cleanup:
        evidence = cycle_dir(root) / "evidence" / cycle_id
        parked = evidence.with_name(evidence.name + ".cleanup")
        cleanup = record.get("cleanup")
        if cleanup:
            if cleanup.get("state") not in ("worktree_removed", "evidence_parked"):
                fail("invalid evidence cleanup state")
            if cleanup.get("state") == "evidence_parked" and evidence.exists():
                fail("invalid evidence cleanup state")
        if cleanup and cleanup.get("state") == "worktree_removed" and parked.exists():
            if evidence.exists():
                fail("invalid evidence cleanup state")
            record["cleanup"] = {"state": "evidence_parked", "parked_at": now()}
            save(path, record)
            cleanup = record["cleanup"]
        if not cleanup and parked.exists():
            fail("untracked parked evidence directory")
        if evidence.exists():
            os.replace(evidence, parked)
            record["cleanup"] = {"state": "evidence_parked", "parked_at": now()}
            save(path, record)
        elif not cleanup or cleanup.get("state") != "evidence_parked":
            record["cleanup"] = {"state": "evidence_parked", "parked_at": now()}
            save(path, record)
        if parked.exists():
            shutil.rmtree(parked)
        path.unlink()
    return "removed " + str(worktree)


def cycle_retirement_reason(value):
    normalized = " ".join(value.split())
    if not 1 <= len(normalized.encode()) <= 512 or review_unsafe(normalized):
        fail("invalid cycle retirement reason")
    return normalized


def command_cycle_retire(args):
    root = root_dir()
    cycle_id = improvement_id(args.cycle_id, "cycle ID")
    if improvement_id(args.confirm, "confirmation") != cycle_id:
        fail("cycle confirmation does not match")
    reason = cycle_retirement_reason(args.reason)
    path = cycle_dir(root) / "cycles" / f"{cycle_id}.json"
    if not path.is_file() or path.is_symlink():
        fail("cycle record is missing")

    with evidence_lock(root, cycle_id):
        record = json.loads(path.read_text(encoding="utf-8"))
        retirement = record.get("retirement")
        retrying = (record.get("state") == "active" and isinstance(retirement, dict)
                    and retirement.get("state") == "removing_worktree")
        if record.get("state") != "active" or retirement is not None and not retrying:
            fail("only an active unretired cycle can be retired")
        if record.get("cycle_id") != cycle_id:
            fail("cycle record identity mismatch")
        details = record.get("worktree", {})
        if details.get("created_by_dbsctr") is not True:
            fail("retirement only removes DBSCTR-created worktrees")
        worktree = record_worktree(root, record)
        branch_name = details.get("branch")
        expected_branch = f"dbsctr/{record['context']}/{cycle_id}"
        if branch_name != expected_branch or worktree.resolve() == root.resolve():
            fail("invalid cycle retirement worktree")
        pointer = cycle_dir(root) / "worktrees" / details.get("id", "") / "active"
        if pointer.exists() and (not pointer.is_file() or pointer.is_symlink()
                                 or pointer.read_text(encoding="utf-8").strip() != cycle_id):
            fail("cycle active pointer identity changed")
        if not pointer.exists() and not (retrying and not worktree.is_dir()):
            fail("cycle active pointer is missing")
        marker = {
            "state": "removing_worktree", "disposition": args.disposition,
            "reason": reason, "branch": branch_name,
        }
        if retrying:
            if any(retirement.get(name) != value for name, value in marker.items()):
                fail("cycle retirement retry changed")
        elif not worktree.is_dir():
            fail("cycle retirement worktree is missing")

        if worktree.is_dir():
            if status_paths(worktree):
                fail("refusing to retire a dirty cycle worktree")
            if branch(worktree) != branch_name or not record_worktree_matches(root, record, worktree):
                fail("cycle retirement worktree identity changed")
            head = git(worktree, "rev-parse", "HEAD").stdout.strip()
            commits = [entry["id"] for entry in record.get("commits", [])]
            if args.disposition == "empty":
                if commits or head != record.get("git", {}).get("head"):
                    fail("empty retirement requires an unchanged cycle baseline")
            elif args.disposition == "integrated":
                if not commits:
                    fail("integrated retirement requires recorded Gate Commits")
                remote, target_branch = remote_for_upstream(worktree, record["git"]["upstream"])
                if not remote or not target_branch:
                    fail("cycle delivery target is unavailable")
                git(worktree, "fetch", remote, target_branch)
                target = f"refs/remotes/{remote}/{target_branch}"
                if (any(git(worktree, "merge-base", "--is-ancestor", commit, target,
                            check=False).returncode for commit in commits)
                        or git(worktree, "merge-base", "--is-ancestor", head, target,
                               check=False).returncode):
                    fail("cycle work is not integrated into its delivery target")
            record["retirement"] = {**marker, "head": head, "started_at": now()}
            save(path, record)
            git(root, "worktree", "remove", str(worktree))
        elif not retrying:
            fail("cycle retirement worktree is missing")

        pointer.unlink(missing_ok=True)
        record["state"] = "retired"
        record["retired_at"] = now()
        record["retirement"] = {**record["retirement"], "state": "retired",
                                "retired_at": record["retired_at"]}
        save(path, record)
    print(json.dumps({"cycle_id": cycle_id, "state": "retired",
                      "disposition": args.disposition, "branch": branch_name}, sort_keys=True))


def command_cycle_retire_worktree(args):
    root = root_dir()
    cycle_id = improvement_id(args.cycle_id, "cycle ID")
    if improvement_id(args.confirm, "confirmation") != cycle_id:
        fail("cycle confirmation does not match")
    reason = cycle_retirement_reason(args.reason)
    path = cycle_dir(root) / "cycles" / f"{cycle_id}.json"
    if not path.is_file() or path.is_symlink():
        fail("cycle record is missing")

    with evidence_lock(root, cycle_id):
        record = json.loads(path.read_text(encoding="utf-8"))
        retirement = record.get("worktree_retirement")
        retrying = (record.get("state") == "completed" and isinstance(retirement, dict)
                    and retirement.get("state") == "removing_worktree")
        if record.get("state") != "completed" or retirement is not None and not retrying:
            fail("only a completed cycle worktree can be retired")
        if record.get("cycle_id") != cycle_id:
            fail("cycle record identity mismatch")
        details = record.get("worktree", {})
        if details.get("created_by_dbsctr") is not True:
            fail("worktree retirement requires its DBSCTR-created owner cycle")
        worktree = record_worktree(root, record)
        branch_name = details.get("branch")
        expected_branch = f"dbsctr/{record['context']}/{cycle_id}"
        if branch_name != expected_branch or worktree.resolve() == root.resolve():
            fail("invalid completed cycle worktree")
        pointer = cycle_dir(root) / "worktrees" / details.get("id", "") / "active"
        if pointer.exists():
            fail("completed cycle worktree still has an active pointer")
        marker = {"state": "removing_worktree", "reason": reason, "branch": branch_name}
        if retrying:
            if any(retirement.get(name) != value for name, value in marker.items()):
                fail("completed worktree retirement retry changed")
        elif not worktree.is_dir():
            fail("completed cycle worktree is missing")

        if worktree.is_dir():
            if status_paths(worktree):
                fail("refusing to retire a dirty completed worktree")
            if branch(worktree) != branch_name or not record_worktree_matches(root, record, worktree):
                fail("completed cycle worktree identity changed")
            related = []
            for candidate in (cycle_dir(root) / "cycles").glob("*.json"):
                value = json.loads(candidate.read_text(encoding="utf-8"))
                other = value.get("worktree", {})
                if (other.get("id") == details["id"]
                        or record.get("schema_version") != 4 and other.get("path") == details.get("path")):
                    related.append(value)
            if not related or any(value.get("state") != "completed" for value in related):
                fail("shared worktree has a non-completed cycle")
            remote, target_branch = remote_for_upstream(worktree, record["git"]["upstream"])
            if not remote or not target_branch:
                fail("cycle delivery target is unavailable")
            git(worktree, "fetch", remote, target_branch)
            target = f"refs/remotes/{remote}/{target_branch}"
            commits = [entry["id"] for value in related for entry in value.get("commits", [])]
            head = git(worktree, "rev-parse", "HEAD").stdout.strip()
            if (not commits or any(git(worktree, "merge-base", "--is-ancestor", commit, target,
                                       check=False).returncode for commit in commits)
                    or git(worktree, "merge-base", "--is-ancestor", head, target,
                           check=False).returncode):
                fail("shared cycle work is not integrated into its delivery target")
            record["worktree_retirement"] = {
                **marker, "head": head, "related_cycles": sorted(value["cycle_id"] for value in related),
                "started_at": now(),
            }
            save(path, record)
            git(root, "worktree", "remove", str(worktree))
        elif not retrying:
            fail("completed cycle worktree is missing")

        record["worktree_retirement"] = {
            **record["worktree_retirement"], "state": "retired", "retired_at": now(),
        }
        save(path, record)
    print(json.dumps({"cycle_id": cycle_id, "state": "completed", "worktree": "retired",
                      "branch": branch_name}, sort_keys=True))


def worktree_bytes(path):
    if not path.is_dir():
        return 0
    result = subprocess.run(["du", "-sk", str(path)], text=True, capture_output=True)
    if result.returncode:
        return None
    try:
        return int(result.stdout.split(maxsplit=1)[0]) * 1024
    except (IndexError, ValueError):
        return None


def path_within(path, root):
    try:
        path.resolve().relative_to(root.resolve())
        return True
    except ValueError:
        return False


def global_worktree_roots(registry=None):
    registry = worktree_registry_root(registry)
    if not registry.exists():
        return [], []
    if not registry.is_dir() or registry.is_symlink():
        return [], [{"repository_id": "registry", "error": "invalid_registry"}]
    registry = registry.resolve()
    repositories, failures, seen = [], [], set()
    parents = sorted(registry.iterdir())
    if len(parents) > 256:
        return [], [{"repository_id": "registry", "error": "registry_limit"}]
    for parent in parents:
        if parent.is_symlink() or not parent.is_dir() or parent.resolve().parent != registry:
            continue
        children = sorted(parent.iterdir())
        if len(children) > 1024:
            failures.append({"repository_id": hashlib.sha256(parent.name.encode()).hexdigest()[:16],
                             "error": "worktree_limit"})
            continue
        for child in children:
            if child.is_symlink() or not child.is_dir() or child.resolve().parent != parent.resolve():
                continue
            found = subprocess.run(["git", "rev-parse", "--git-common-dir"], cwd=child,
                                   text=True, capture_output=True)
            if found.returncode or not found.stdout.strip():
                continue
            common = Path(found.stdout.strip())
            common = (common if common.is_absolute() else child / common).resolve()
            if common in seen:
                continue
            seen.add(common)
            listing = subprocess.run(["git", "worktree", "list", "--porcelain"], cwd=child,
                                     text=True, capture_output=True)
            primary_line = next((line for line in listing.stdout.splitlines()
                                 if line.startswith("worktree ")), None)
            repository_id = f"{common.parent.name}-{hashlib.sha256(str(common).encode()).hexdigest()[:12]}"
            if listing.returncode or primary_line is None:
                failures.append({"repository_id": repository_id, "error": "primary_unavailable"})
                continue
            primary = Path(primary_line.removeprefix("worktree ")).resolve()
            try:
                if not primary.is_dir() or common_git_dir(primary).resolve() != common:
                    raise RuntimeError
            except RuntimeError:
                failures.append({"repository_id": repository_id, "error": "identity_changed"})
                continue
            repositories.append((repository_id, primary, parent.resolve()))
            break
    return sorted(repositories), sorted(failures, key=lambda item: item["repository_id"])


def maintenance_error(error):
    message = str(error).casefold()
    for needle, code in (
        ("retained for 24 hours", "retained_24_hours"), ("dirty", "dirty"),
        ("authentication failed", "delivery_unavailable"),
        ("repository not found", "delivery_unavailable"),
        ("fetch", "delivery_unavailable"), ("identity", "identity_changed"),
        ("branch", "branch_changed"), ("head changed", "head_changed"),
        ("missing", "missing"),
    ):
        if needle in message:
            return code
    return "cleanup_failed"


def worktree_inventory(root, immediate=False, allowed_root=None):
    records = cycle_dir(root) / "cycles"
    result = []
    for path in sorted(records.glob("*.json")):
        record = json.loads(path.read_text(encoding="utf-8"))
        if record.get("worktree", {}).get("created_by_dbsctr") is not True:
            continue
        worktree = record_worktree(root, record)
        blockers = []
        shared_retired = record.get("worktree_retirement", {}).get("state") == "retired"
        if record.get("state") == "retired":
            if worktree.is_dir() or record.get("retirement", {}).get("state") != "retired":
                blockers.append("retirement_incomplete")
        elif record.get("state") != "completed":
            blockers.append("not_completed")
        elif not shared_retired:
            try:
                completed = datetime.fromisoformat(record["completed_at"].replace("Z", "+00:00"))
                if not immediate and datetime.now(timezone.utc) - completed < timedelta(hours=24):
                    blockers.append("retained_24_hours")
            except (KeyError, ValueError):
                blockers.append("invalid_completed_at")
        if worktree.is_dir():
            if allowed_root is not None and not path_within(worktree, allowed_root):
                blockers.append("outside_registry")
            if worktree.resolve() == root.resolve():
                blockers.append("current_worktree")
            if status_paths(worktree):
                blockers.append("dirty")
            if branch(worktree) != record["worktree"].get("branch"):
                blockers.append("branch_changed")
            commits = record.get("commits", [])
            if commits and git(worktree, "rev-parse", "HEAD").stdout.strip() != commits[-1]["id"]:
                blockers.append("head_changed")
            if not record_worktree_matches(root, record, worktree):
                blockers.append("identity_changed")
        elif (record.get("state") != "retired" and not shared_retired
              and record.get("cleanup", {}).get("state") not in ("worktree_removed", "evidence_parked")):
            blockers.append("missing")
        result.append({
            "bytes": worktree_bytes(worktree),
            "cleanup_candidate": (record.get("state") == "completed"
                                  and not shared_retired and not blockers),
            "cleanup_blockers": blockers,
            "cycle_id": record["cycle_id"],
            "present": worktree.is_dir(),
            "state": record.get("state"),
        })
    return result


def command_worktree_list(args):
    if getattr(args, "all", False):
        repositories, failed = global_worktree_roots()
        output, total = [], 0
        for repository_id, root, allowed_root in repositories:
            worktrees = worktree_inventory(root, args.now, allowed_root)
            total += sum(item["bytes"] or 0 for item in worktrees)
            output.append({"repository_id": repository_id, "worktrees": worktrees})
        print(json.dumps({"bytes": total, "failed": failed, "repositories": output},
                         sort_keys=True, separators=(",", ":")))
        return
    inventory = worktree_inventory(root_dir(), args.now)
    if args.json:
        print(json.dumps({"worktrees": inventory}, sort_keys=True, separators=(",", ":")))
        return
    for item in inventory:
        blockers = ",".join(item["cleanup_blockers"]) or "none"
        print(f"{item['cycle_id']} state={item['state']} bytes={item['bytes']} blockers={blockers}")


def command_cleanup(args):
    if getattr(args, "all", False):
        if args.cycle_id:
            fail("--all requires --completed")
        repositories, failed = global_worktree_roots()
        removed, reclaimed = [], 0
        for repository_id, root, allowed_root in repositories:
            for path in sorted((cycle_dir(root) / "cycles").glob("*.json")):
                try:
                    record = json.loads(path.read_text(encoding="utf-8"))
                    if (record.get("state") != "completed"
                            or record.get("worktree", {}).get("created_by_dbsctr") is not True):
                        continue
                    cycle_id = record.get("cycle_id")
                    if cycle_id != path.stem or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", cycle_id or ""):
                        raise ValueError("cycle record identity mismatch")
                    worktree = record_worktree(root, record)
                    if not path_within(worktree, allowed_root):
                        failed.append({"cycle_id": cycle_id, "repository_id": repository_id,
                                       "error": "outside_registry"})
                        continue
                    before = worktree_bytes(worktree) or 0
                    cleanup_cycle(root, cycle_id, args.now)
                    reclaimed += before
                    removed.append({"cycle_id": cycle_id, "repository_id": repository_id})
                except (RuntimeError, OSError, json.JSONDecodeError, KeyError, TypeError, ValueError) as error:
                    failed.append({"cycle_id": path.stem, "repository_id": repository_id,
                                   "error": maintenance_error(error)})
        print(json.dumps({"failed": failed, "reclaimed_bytes": reclaimed, "removed": removed},
                         sort_keys=True, separators=(",", ":")))
        if failed:
            fail(f"global cleanup incomplete: {len(failed)} failures")
        return
    root = root_dir()
    if args.cycle_id:
        print(cleanup_cycle(root, args.cycle_id, args.now))
        return
    records = cycle_dir(root) / "cycles"
    cycle_ids, failed = [], []
    for path in sorted(records.glob("*.json")):
        try:
            record = json.loads(path.read_text(encoding="utf-8"))
            if record.get("state") == "completed" and record.get("worktree", {}).get("created_by_dbsctr") is True:
                if record.get("cycle_id") != path.stem or not re.fullmatch(
                        r"[A-Za-z0-9][A-Za-z0-9._-]*", record.get("cycle_id", "")):
                    raise ValueError("cycle record identity mismatch")
                cycle_ids.append(record["cycle_id"])
        except (json.JSONDecodeError, KeyError, TypeError, ValueError) as error:
            failed.append({"cycle_id": path.stem, "error": str(error)})
    removed = []
    for cycle_id in cycle_ids:
        try:
            cleanup_cycle(root, cycle_id, args.now)
            removed.append(cycle_id)
        except (RuntimeError, OSError, json.JSONDecodeError, KeyError, TypeError, ValueError) as error:
            failed.append({"cycle_id": cycle_id, "error": str(error)})
    print(json.dumps({"failed": failed, "removed": removed}, sort_keys=True, separators=(",", ":")))
    if failed:
        fail(f"cleanup incomplete: {len(failed)} of {len(cycle_ids)} completed worktrees failed")


def command_audit(args):
    root = root_dir()
    commit = inspect_git(root, "rev-parse", "--verify", f"{args.commit}^{{commit}}").stdout.strip()
    files = set(inspect_git(root, "ls-tree", "-r", "--name-only", commit).stdout.splitlines())
    contexts = {}
    for name in files:
        parts = PurePosixPath(name).parts
        if len(parts) == 4 and parts[:2] == ("docs", "specs") and parts[3] in (
            "README.md", "CHANGELOG.md"
        ):
            contexts.setdefault(parts[2], set()).add(parts[3])
    expected = {"README.md", "CHANGELOG.md"}
    findings = []
    inventory = []
    for context in sorted(contexts):
        present = contexts[context]
        missing = sorted(expected - present)
        inventory.append({"context": context, "present": sorted(present), "missing": missing})
        for artifact in missing:
            findings.append({
                "code": "missing_lifecycle_artifact", "severity": "medium", "context": context,
                "path": f"docs/specs/{context}/{artifact}",
            })
    graph_path = "graphify-out/GRAPH_REPORT.md"
    receipt_path = "graphify-out/graph.receipt.json"
    graph = {"present": graph_path in files, "built_from": None, "stale": None,
             "receipt_present": receipt_path in files, "receipt_valid": None}
    if graph["present"]:
        report = inspect_git(root, "show", f"{commit}:{graph_path}").stdout
        match = re.search(r"Built from commit:\s*`([0-9a-f]+)`", report)
        object_format = inspect_git(root, "rev-parse", "--show-object-format").stdout.strip()
        expected_length = 64 if object_format == "sha256" else 40
        if match and len(match.group(1)) == expected_length:
            graph["built_from"] = match.group(1)
            resolved = inspect_git(root, "rev-parse", "--verify", f"{graph['built_from']}^{{commit}}", check=False)
            if resolved.returncode:
                findings.append({
                    "code": "unverified_graph_freshness", "severity": "medium", "path": graph_path,
                    "built_from": graph["built_from"],
                })
            else:
                graph["built_from"] = resolved.stdout.strip()
                authorized = graph["built_from"] == commit
                if not authorized and inspect_git(
                        root, "merge-base", "--is-ancestor", graph["built_from"], commit,
                        check=False).returncode == 0:
                    authorized = True
                    for descendant in inspect_git(
                            root, "rev-list", "--first-parent", "--reverse", f"{graph['built_from']}..{commit}"
                    ).stdout.splitlines():
                        parents = inspect_git(root, "show", "-s", "--format=%P", descendant).stdout.split()
                        if len(parents) > 1:
                            authorized = (inspect_git(root, "rev-parse", f"{descendant}^{{tree}}").stdout
                                          == inspect_git(root, "rev-parse", f"{parents[0]}^{{tree}}").stdout)
                        else:
                            changed = inspect_git(
                                root, "diff-tree", "--no-commit-id", "--name-only", "-r", descendant
                            ).stdout.splitlines()
                            authorized = bool(changed) and all(name.startswith("graphify-out/") for name in changed)
                        if not authorized:
                            break
                graph["stale"] = not authorized
                if graph["stale"]:
                    findings.append({
                        "code": "stale_graph", "severity": "low", "path": graph_path,
                        "built_from": graph["built_from"], "audited_commit": commit,
                    })
        else:
            findings.append({
                "code": "unverified_graph_freshness", "severity": "medium", "path": graph_path,
            })
        if graph["receipt_present"]:
            try:
                receipt = json.loads(inspect_git_bytes(root, "show", f"{commit}:{receipt_path}"),
                                     object_pairs_hook=no_duplicate_keys)
                expected_receipt_keys = {
                    "schema_version", "command_contract", "batch_id", "source_head", "adapter",
                    "output_files", "output_sha256", "manifest_sha256", "created_at",
                }
                manifest = inspect_git_bytes(root, "show", f"{commit}:graphify-out/manifest.json")
                output = receipt["output_sha256"]
                output_files = sorted(name.removeprefix("graphify-out/") for name in files
                                      if name.startswith("graphify-out/") and name != receipt_path)
                adapter = receipt.get("adapter")
                adapter_path = adapter.get("adapter") if isinstance(adapter, dict) else None
                adapter_entry = (inspect_git(
                    root, "ls-tree", receipt.get("source_head", ""), "--", adapter_path,
                    check=False).stdout.strip().split() if isinstance(adapter_path, str) else [])
                legacy_adapter = (isinstance(adapter, dict)
                                  and set(adapter) == {"adapter", "version", "blob"}
                                  and len(adapter_entry) >= 4
                                  and adapter_entry[:2] == ["100755", "blob"]
                                  and adapter_entry[2] == adapter["blob"])
                managed_adapter = (isinstance(adapter, dict)
                                   and set(adapter) == {
                                       "version", "adapter_contract", "adapter_sha256"}
                                   and adapter.get("adapter_contract") == "dbsctr-project-graphify-v1"
                                   and re.fullmatch(r"[0-9a-f]{64}", adapter.get("adapter_sha256", ""))
                                   and isinstance(adapter.get("version"), str)
                                   and re.fullmatch(
                                       r"[A-Za-z0-9][A-Za-z0-9._+-]{0,63}", adapter["version"]))
                valid = (set(receipt) == expected_receipt_keys
                         and receipt.get("schema_version") == 1
                         and receipt.get("command_contract") == "dbsctr-batch-graphify-v1"
                         and receipt.get("source_head") == graph["built_from"]
                         and isinstance(receipt.get("batch_id"), str)
                         and re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9-]{0,63}", receipt["batch_id"])
                         and isinstance(receipt.get("created_at"), str) and receipt["created_at"]
                         and (legacy_adapter or managed_adapter)
                         and receipt.get("manifest_sha256") == hashlib.sha256(manifest).hexdigest()
                         and receipt.get("output_files") == output_files
                         and {"GRAPH_REPORT.md", "manifest.json"} <= set(output_files)
                         and isinstance(output, dict) and sorted(output) == output_files
                         and all(re.fullmatch(r"[0-9a-f]{64}", digest or "")
                                 and hashlib.sha256(inspect_git_bytes(
                                     root, "show", f"{commit}:graphify-out/{name}"
                                 )).hexdigest() == digest for name, digest in output.items()))
            except (KeyError, json.JSONDecodeError, RuntimeError, TypeError, UnicodeDecodeError):
                valid = False
            graph["receipt_valid"] = valid
            if not valid:
                findings.append({"code": "invalid_graph_receipt", "severity": "medium",
                                 "path": receipt_path})
        else:
            findings.append({"code": "missing_graph_receipt", "severity": "medium",
                             "path": receipt_path})
    result = {
        "mode": "lifecycle_reconciliation_audit", "commit": commit,
        "dirty_overlay_excluded": status_paths(root, read_only=True), "contexts": inventory,
        "graph": graph, "findings": findings,
    }
    if args.json:
        print(json.dumps(result, sort_keys=True, separators=(",", ":")))
    else:
        print(f"{commit} contexts={len(inventory)} findings={len(findings)}")
        for finding in findings:
            print(f"{finding['severity']} {finding['code']} {finding['path']}")


def backlog_cells(line):
    stripped = line.strip()
    if not stripped.startswith("|") or not stripped.endswith("|"):
        return None
    return tuple(cell.strip() for cell in stripped[1:-1].split("|"))


def backlog_section(lines, section, path, context):
    heading = f"## {section.title()}"
    findings = []
    try:
        heading_index = lines.index(heading)
    except ValueError:
        return [{"code": "invalid_backlog_schema", "severity": "medium", "context": context,
                 "path": path, "section": section, "line": 1}], []
    end = next((index for index in range(heading_index + 1, len(lines))
                if lines[index].startswith("## ")), len(lines))
    content = [index for index in range(heading_index + 1, end) if lines[index].strip()]
    if not content:
        return [{"code": "invalid_backlog_schema", "severity": "medium", "context": context,
                 "path": path, "section": section, "line": heading_index + 1}], []
    header_index = content[0]
    if backlog_cells(lines[header_index]) != BACKLOG_COLUMNS[section]:
        return [{"code": "invalid_backlog_schema", "severity": "medium", "context": context,
                 "path": path, "section": section, "line": header_index + 1}], []
    if len(content) < 2:
        return [{"code": "invalid_backlog_schema", "severity": "medium", "context": context,
                 "path": path, "section": section, "line": header_index + 1}], []
    separator_index = content[1]
    separator = backlog_cells(lines[separator_index])
    if (separator is None or len(separator) != len(BACKLOG_COLUMNS[section])
            or any(not re.fullmatch(r":?-{3,}:?", cell) for cell in separator)):
        return [{"code": "invalid_backlog_schema", "severity": "medium", "context": context,
                 "path": path, "section": section, "line": separator_index + 1}], []
    rows = []
    for index in content[2:]:
        cells = backlog_cells(lines[index])
        if cells is None or len(cells) != len(BACKLOG_COLUMNS[section]) or not cells[0]:
            finding = {
                "code": "invalid_backlog_schema", "severity": "medium", "context": context,
                "path": path, "section": section, "line": index + 1,
            }
            if cells and cells[0]:
                finding["item_id"] = cells[0]
                rows.append((index + 1, cells[0], None))
            findings.append(finding)
            continue
        rows.append((index + 1, cells[0], dict(zip(BACKLOG_COLUMNS[section], cells))))
    return findings, rows


def backlog_commit_reachable(root, audited_commit, evidence):
    for candidate in BACKLOG_COMMIT.findall(evidence):
        resolved = inspect_git(root, "rev-parse", "--verify", f"{candidate}^{{commit}}", check=False)
        if (not resolved.returncode
                and not inspect_git(root, "merge-base", "--is-ancestor", resolved.stdout.strip(),
                                    audited_commit, check=False).returncode):
            return True
    return False


def backlog_findings(root, commit, context, path, text):
    lines = text.splitlines()
    findings, rows = [], []
    for section in ("active", "completed"):
        section_findings, section_rows = backlog_section(lines, section, path, context)
        findings.extend(section_findings)
        rows.extend((section, *row) for row in section_rows)
    identifiers = {}
    for section, line, item_id, values in rows:
        identifiers.setdefault(item_id, []).append((section, line, item_id, values))
        if values is None:
            continue
        common = {"severity": "medium", "context": context, "path": path,
                  "section": section, "line": line, "item_id": item_id}
        if section == "active" and values["status"] not in BACKLOG_ACTIVE_STATUSES:
            findings.append({"code": "invalid_active_status", **common})
        if section == "completed":
            try:
                if not re.fullmatch(r"\d{4}-\d{2}-\d{2}", values["completed"]):
                    raise ValueError
                datetime.strptime(values["completed"], "%Y-%m-%d")
            except ValueError:
                findings.append({"code": "invalid_completed_date", **common})
            if not backlog_commit_reachable(root, commit, values["commit"]):
                findings.append({"code": "invalid_completed_commit", **common})
    for duplicates in identifiers.values():
        if len(duplicates) > 1:
            for section, line, item_id, _ in duplicates:
                findings.append({
                    "code": "duplicate_backlog_id", "severity": "medium", "context": context,
                    "path": path, "section": section, "line": line, "item_id": item_id,
                })
    rank = {"active": 0, "completed": 1, "document": 2}
    return sorted(findings, key=lambda item: (
        item["line"], item["code"], rank[item["section"]], item.get("item_id", "")))


def inspect_path(path, required=False):
    if path is None:
        if required:
            fail("--path is required for this inspect action")
        return None
    try:
        encoded = os.fsencode(path)
    except UnicodeEncodeError:
        fail("unsafe path")
    pure = PurePosixPath(path)
    if (not path or len(encoded) > 4096 or b"\0" in encoded or any(byte < 32 or byte == 127 for byte in encoded)
            or pure.is_absolute() or ".." in pure.parts or path.startswith("./")):
        fail("unsafe path")
    return path.rstrip("/")


def inspect_limit(value, default, hard, name):
    value = default if value is None else value
    if value < 1 or value > hard:
        fail(f"{name} must be between 1 and {hard}")
    return value


def inspect_object(root, commit, path):
    spec = commit if path is None else f"{commit}:{path}"
    kind = inspect_git(root, "cat-file", "-t", "--", spec, check=False)
    if kind.returncode or kind.stdout.strip() not in ("blob", "tree", "commit"):
        fail("path does not name a supported Git object at commit")
    object_id = inspect_git(root, "rev-parse", "--verify", "--end-of-options", spec).stdout.strip()
    return kind.stdout.strip(), object_id, spec


def inspect_blob_size(root, spec, strict=True):
    size = int(inspect_git(root, "cat-file", "-s", "--", spec).stdout)
    if size > 4 * 1024 * 1024:
        if strict:
            fail("blob exceeds 4194304 byte hard cap")
        return None
    return size


def inspect_text(root, spec, size):
    if size > 4 * 1024 * 1024:
        fail("blob exceeds 4194304 byte hard cap")
    data = subprocess.run(
        ["git", "cat-file", "blob", "--", spec], cwd=root, capture_output=True,
        env=INSPECT_ENV,
    )
    if data.returncode:
        fail(data.stderr.decode(errors="replace").strip() or "cannot read Git blob")
    return data.stdout


def inspect_emit(result):
    encoded = json.dumps(result, sort_keys=True, separators=(",", ":"), ensure_ascii=True).encode("utf-8")
    if len(encoded) > INSPECT_RESPONSE_HARD:
        fail("inspect response exceeds 131072 bytes")
    print(encoded.decode("utf-8"))


def inspect_page(result, key, items, cursor, limit):
    selected = items[cursor:cursor + limit]
    while selected:
        next_cursor = cursor + len(selected)
        result.update({key: selected, "truncated": next_cursor < len(items),
                       "continuation": {"cursor": next_cursor} if next_cursor < len(items) else None})
        if len(json.dumps(result, sort_keys=True, separators=(",", ":"), ensure_ascii=True).encode("utf-8")) <= INSPECT_RESPONSE_HARD:
            return
        selected.pop()
    result.update({key: [], "truncated": cursor < len(items),
                   "continuation": {"cursor": cursor} if cursor < len(items) else None})


def inspect_tree_rows(root, *args):
    with tempfile.TemporaryFile() as stderr:
        process = subprocess.Popen(["git", "ls-tree", "-z", *args], cwd=root, stdout=subprocess.PIPE,
                                   stderr=stderr, env=INSPECT_ENV)
        buffer = b""
        complete = False
        try:
            while block := process.stdout.read(4096):
                buffer += block
                while b"\0" in buffer:
                    row, buffer = buffer.split(b"\0", 1)
                    if row:
                        metadata, name = row.split(b"\t", 1)
                        yield metadata.decode("ascii").split(), os.fsdecode(name)
            complete = True
        finally:
            if not complete and process.poll() is None:
                process.terminate()
            process.wait()
            if complete and process.returncode:
                stderr.seek(0)
                fail(stderr.read(8192).decode(errors="replace").strip() or "cannot list Git tree")


def inspect_overlay(root):
    with tempfile.TemporaryFile() as stderr:
        process = subprocess.Popen(
            ["git", "status", "--porcelain=v1", "-z", "--untracked-files=all"], cwd=root,
            stdout=subprocess.PIPE, stderr=stderr, env=INSPECT_ENV,
        )
        paths, total, retained_bytes, rename = [], 0, 0, False

        def record_path(raw_path):
            nonlocal total, retained_bytes
            path = os.fsdecode(raw_path)
            total += 1
            size = len(json.dumps(path, ensure_ascii=True).encode("utf-8")) + 1
            if len(paths) < 100 and retained_bytes + size <= 64 * 1024:
                paths.append(path)
                retained_bytes += size

        buffer = b""
        while block := process.stdout.read(4096):
            buffer += block
            while b"\0" in buffer:
                record, buffer = buffer.split(b"\0", 1)
                if not record:
                    continue
                if rename:
                    record_path(record)
                    rename = False
                else:
                    status, raw_path = record[:2], record[3:]
                    rename = status[:1] in b"RC" or status[1:2] in b"RC"
                    record_path(raw_path)
        process.wait()
        if process.returncode:
            stderr.seek(0)
            fail(stderr.read(8192).decode(errors="replace").strip() or "cannot inspect dirty overlay")
    return paths, total, total > len(paths)


def inspect_utf8_page(data, offset, limit):
    try:
        data.decode("utf-8")
    except UnicodeDecodeError:
        return None, len(data)
    try:
        data[:offset].decode("utf-8")
    except UnicodeDecodeError:
        fail("offset is not a UTF-8 boundary")
    end = min(offset + limit, len(data))
    while end > offset:
        try:
            return data[offset:end].decode("utf-8"), end
        except UnicodeDecodeError as error:
            if error.reason != "unexpected end of data":
                fail("offset is not a UTF-8 boundary")
            end -= 1
    if offset < len(data):
        fail("limit does not reach a UTF-8 boundary")
    return "", end


def inspect_excerpt(line, limit):
    encoded = line.encode("utf-8")
    end = min(limit, len(encoded))
    while end:
        try:
            return encoded[:end].decode("utf-8"), len(encoded) > end
        except UnicodeDecodeError:
            end -= 1
    return "", bool(encoded)


def inspect_arguments(args):
    allowed = {
        "read": {"path", "limit", "offset"}, "tree": {"path", "limit", "cursor"},
        "search": {"path", "query", "limit", "cursor", "excerpt"}, "object": {"path"},
    }[args.action]
    for name in ("path", "query", "limit", "offset", "cursor", "excerpt"):
        if getattr(args, name) is not None and name not in allowed:
            fail(f"--{name} is not valid for inspect {args.action}")


def command_inspect(args):
    root = root_dir()
    inspect_arguments(args)
    commit = inspect_git(root, "rev-parse", "--verify", "--end-of-options", f"{args.commit}^{{commit}}", check=False)
    if commit.returncode:
        fail("--commit must resolve to a commit")
    commit = commit.stdout.strip()
    if args.cursor is not None and args.cursor < 0:
        fail("cursor must be non-negative")
    path = inspect_path(args.path, args.action == "read")
    overlay, overlay_total, overlay_truncated = inspect_overlay(root)
    result = {"action": args.action, "commit": commit, "dirty_overlay_excluded": overlay,
              "dirty_overlay_total": overlay_total, "dirty_overlay_truncated": overlay_truncated}
    if args.action == "object":
        kind, object_id, _ = inspect_object(root, commit, path)
        result.update({"path": path, "object": object_id, "type": kind,
                       "size": int(inspect_git(root, "cat-file", "-s", "--", object_id).stdout)})
    elif args.action == "read":
        kind, object_id, spec = inspect_object(root, commit, path)
        if kind != "blob":
            fail("read requires a blob path")
        size = inspect_blob_size(root, spec)
        data = inspect_text(root, spec, size)
        limit = inspect_limit(args.limit, 32768, 65536, "read limit")
        offset = args.offset or 0
        if offset < 0 or offset > len(data):
            fail("offset is outside blob")
        content, end = inspect_utf8_page(data, offset, limit)
        binary = b"\0" in data or content is None
        result.update({"path": path, "object": object_id, "binary": binary, "size": size,
                       "truncated": False if binary else end < len(data),
                       "continuation": {"offset": end} if not binary and end < len(data) else None})
        if not binary:
            result["content"] = content
    elif args.action == "tree":
        if path is None:
            object_id = inspect_git(root, "rev-parse", "--verify", "--end-of-options", f"{commit}^{{tree}}").stdout.strip()
            rows = inspect_tree_rows(root, commit)
        else:
            kind, object_id, spec = inspect_object(root, commit, path)
            if kind != "tree":
                fail("tree requires a tree path")
            rows = inspect_tree_rows(root, spec)
        limit = inspect_limit(args.limit, 50, 100, "tree limit")
        cursor = args.cursor or 0
        entries = []
        try:
            for metadata, name in rows:
                if len(entries) <= cursor + limit:
                    mode, entry_kind, entry_object = metadata
                    entries.append({"path": f"{path}/{name}" if path else name, "mode": mode,
                                    "object": entry_object, "type": entry_kind})
                else:
                    break
        finally:
            rows.close()
        if cursor > len(entries) or (cursor == len(entries) and entries):
            fail("cursor is outside available entries")
        result.update({"path": path, "object": object_id})
        inspect_page(result, "entries", entries, cursor, limit)
    else:
        if not args.query:
            fail("--query is required for search")
        if len(os.fsencode(args.query)) > 256 or any(ord(char) < 32 or ord(char) == 127 for char in args.query):
            fail("unsafe query")
        limit = inspect_limit(args.limit, 25, 100, "search limit")
        excerpt = inspect_limit(args.excerpt, 1024, 2048, "excerpt limit")
        cursor = args.cursor or 0
        matches = []
        if path is None:
            rows = inspect_tree_rows(root, "-r", commit)
            scope_is_tree = False
        else:
            kind, scoped_object, spec = inspect_object(root, commit, path)
            if kind == "blob":
                rows = iter([(["100644", "blob", scoped_object], path)])
                scope_is_tree = False
            elif kind == "tree":
                rows = inspect_tree_rows(root, "-r", spec)
                scope_is_tree = True
            else:
                fail("search path must be a blob or tree")
        try:
            for (_, kind, object_id), name in rows:
                if kind != "blob" or len(matches) > cursor + limit:
                    if len(matches) > cursor + limit:
                        break
                    continue
                size = inspect_blob_size(root, object_id, strict=False)
                if size is None:
                    continue
                data = inspect_text(root, object_id, size)
                if b"\0" in data:
                    continue
                try:
                    text = data.decode("utf-8")
                except UnicodeDecodeError:
                    continue
                for number, line in enumerate(text.splitlines(), 1):
                    if args.query in line:
                        excerpt_text, excerpt_truncated = inspect_excerpt(line, excerpt)
                        matches.append({"path": f"{path}/{name}" if path and scope_is_tree else name,
                                        "line": number, "object": object_id, "excerpt": excerpt_text,
                                        "excerpt_truncated": excerpt_truncated})
                        if len(matches) > cursor + limit:
                            break
        finally:
            close = getattr(rows, "close", None)
            if close:
                close()
        if cursor > len(matches) or (cursor == len(matches) and matches):
            fail("cursor is outside available matches")
        result["query"] = args.query
        inspect_page(result, "matches", matches, cursor, limit)
    inspect_emit(result)


def command_status(args):
    root = root_dir()
    active = resolved_active_path(root)
    if not active.exists() and args.json:
        print("null")
        return
    _, record = load(root)
    if args.json:
        print(json.dumps(record, sort_keys=True, separators=(",", ":")))
    else:
        print(f"{record['cycle_id']} {record['state']} {record['risk']} {record['delivery_intent']}")


def command_attach_runtime(args):
    root = root_dir().resolve()
    if args.opencode_message_id is None:
        fail("runtime attachment requires structured message identity")
    session_id = session_for_message(None, args.opencode_message_id, require_primary=True)
    if session_id != args.opencode_session_id:
        fail("OpenCode runtime session does not own the structured message")
    activation = (harness_activation_for_message(None, args.opencode_message_id, args.harness_activation_json)
                  if args.harness_activation_json is not None else None)
    if not OPAQUE_ID.fullmatch(session_id):
        fail("invalid OpenCode session ID")
    runtime_worktree = Path(args.opencode_worktree).resolve()
    runtime_directory = Path(args.opencode_directory).resolve()
    if (not runtime_worktree.is_dir() or not runtime_directory.is_dir()
            or runtime_worktree not in runtime_directory.parents and runtime_directory != runtime_worktree):
        fail("invalid OpenCode runtime paths")
    path, record = load(root)
    cycle_id = record["cycle_id"]
    with evidence_lock(root, cycle_id):
        path, record = load(root)
        if record["cycle_id"] != cycle_id:
            fail("active DBSCTR cycle changed during runtime attachment")
        require_active(record)
        recorded_worktree = record_worktree(root, record)
        if root != recorded_worktree:
            fail("active cycle worktree identity changed")
        source_worktree = record_source_worktree(root, record)
        opencode = record.setdefault("runtime", {}).setdefault("opencode", {})
        session_ids = opencode.setdefault("session_ids", [])
        if (not isinstance(session_ids, list) or len(session_ids) > REVIEW_MAX_LIMIT
                or not all(isinstance(value, str) and OPAQUE_ID.fullmatch(value) for value in session_ids)):
            fail("Cycle Record contains invalid OpenCode runtime metadata")
        attached = session_id not in session_ids
        if attached:
            if len(session_ids) == REVIEW_MAX_LIMIT:
                fail("Cycle Record OpenCode runtime limit reached")
            session_ids.append(session_id)
        existing_activation = opencode.get("harness_activation")
        if existing_activation is not None and activation is not None and existing_activation != activation:
            fail("attached root sessions disagree on harness activation")
        if existing_activation is None and activation is not None:
            opencode["harness_activation"] = activation
        if record.get("schema_version") == 4 and runtime_worktree == root:
            opencode.update({"path_root": "cycle_worktree", "worktree": "."})
        elif record.get("schema_version") == 4 and runtime_worktree == source_worktree:
            opencode.update({"path_root": "primary_worktree", "worktree": "."})
        elif record.get("schema_version") != 4 and runtime_worktree in {root, source_worktree}:
            opencode["worktree"] = str(runtime_worktree)
        save(path, record)
    print(json.dumps({"cycle_id": record["cycle_id"], "attached": attached}, sort_keys=True,
                     separators=(",", ":")))


def sqlite_name(connection, table, choices):
    columns = {row[1].lower().replace("_", ""): row[1] for row in connection.execute(f"PRAGMA table_info({table})")}
    for choice in choices:
        if choice in columns:
            return columns[choice]
    fail(f"OpenCode {table} table lacks required columns")


def review_index(root):
    if ledger_exists(root):
        with ledger_connection(root) as connection:
            value = {"schema_version": 1, "sessions": {}, "cycles": {}, "forgotten_sessions": {}}
            names = {"session": "sessions", "cycle": "cycles", "forgotten_session": "forgotten_sessions"}
            for kind, item_id, timestamp in connection.execute(
                    "SELECT kind, item_id, timestamp FROM review_tombstones"):
                value[names[kind]][item_id] = timestamp
    else:
        path = root / "reviews" / "reviewed.json"
        if not path.exists():
            value = {"schema_version": 1, "sessions": {}, "cycles": {}, "forgotten_sessions": {}}
        else:
            try:
                private_legacy_file(root, path)
                value = json.loads(path.read_text(encoding="utf-8"), object_pairs_hook=no_duplicate_keys)
            except (OSError, json.JSONDecodeError) as error:
                fail(f"cannot read reviewed tombstones: {error}")
    if (not isinstance(value, dict) or set(value) != {"schema_version", "sessions", "cycles", "forgotten_sessions"}
            or value["schema_version"] != 1 or not isinstance(value["sessions"], dict)
            or not isinstance(value["cycles"], dict) or not isinstance(value["forgotten_sessions"], dict)):
        fail("reviewed tombstones have an invalid schema")
    for values in (value["sessions"], value["cycles"], value["forgotten_sessions"]):
        if not all(isinstance(key, str) and re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}", key)
                   and isinstance(timestamp, int) and timestamp >= REVIEW_START_MS
                   for key, timestamp in values.items()):
            fail("reviewed tombstones contain invalid entries")
    return value


def validate_review_report(report, marker_name, timestamp):
    path = Path(marker_name)
    text_fields = ("findings", "scorecards", "trends", "proposals", "caveats")
    allowed = {"session_ids", "cycle_ids", "scan_digest", "snapshot", "session_ceiling", "part_ceiling", "database_digest",
               "limit", "cursor", "decision", "notes", "reviewed_at", *text_fields}
    required = {"session_ids", "scan_digest", "limit", "cursor", "decision"}
    if (not isinstance(report, dict) or set(report) - allowed or not required <= set(report)
            or not isinstance(report.get("session_ids"), list)
            or not isinstance(report.get("cycle_ids", []), list)
            or not 1 <= len(report["session_ids"]) <= REVIEW_MAX_LIMIT
            or len(report.get("cycle_ids", [])) > REVIEW_MAX_LIMIT
            or not all(isinstance(value, str) and OPAQUE_ID.fullmatch(value)
                       for value in report["session_ids"] + report.get("cycle_ids", []))
            or len(set(report["session_ids"])) != len(report["session_ids"])
            or len(set(report.get("cycle_ids", []))) != len(report.get("cycle_ids", []))
            or not isinstance(report.get("scan_digest"), str)
            or not re.fullmatch(r"[0-9a-f]{64}", report["scan_digest"])
            or not isinstance(report.get("decision"), str) or not 1 <= len(report["decision"].encode()) <= 256
            or report.get("notes") is not None and (not isinstance(report["notes"], str)
                                                     or len(report["notes"].encode()) > 2048)):
        fail("retained review report has an invalid schema")
    if (type(report["limit"]) is not int or not 1 <= report["limit"] <= REVIEW_MAX_LIMIT
            or type(report["cursor"]) is not int or report["cursor"] < 0):
        fail("retained review report has an invalid schema")
    for name in ("snapshot", "session_ceiling", "part_ceiling"):
        if name in report and (type(report[name]) is not int or report[name] < 0):
            fail("retained review report has an invalid schema")
    current = {"session_ceiling", "part_ceiling", "database_digest"} & set(report)
    if current and not {"reviewed_at", "snapshot", "session_ceiling", "part_ceiling", "database_digest"} <= set(report):
        fail("retained review report has an invalid schema")
    if "reviewed_at" in report and not current:
        fail("retained review report has an invalid schema")
    for name in text_fields:
        values = report.get(name, [])
        if not isinstance(values, list) or len(values) > 50 or not all(
                isinstance(value, str) and 1 <= len(value) <= 512 for value in values):
            fail("retained review report has an invalid schema")
    human = [str(report.get(name, "")) for name in ("decision", "notes")]
    human.extend(value for name in text_fields for value in report.get(name, []))
    if review_unsafe(" ".join(human)):
        fail("retained review report contains unsafe content")
    if not re.fullmatch(r"[0-9a-f]{24}\.json", path.name):
        fail("retained review report has an invalid marker name")
    expected = hashlib.sha256((report["scan_digest"] + "\0" + json.dumps(report, sort_keys=True)).encode()).hexdigest()[:24]
    if path.stem != expected:
        fail("retained review report marker does not match its content")
    if (not isinstance(timestamp, int) or timestamp < REVIEW_START_MS
            or timestamp > int(datetime.now(timezone.utc).timestamp() * 1000) + 1000):
        fail("retained review report has an invalid review timestamp")
    return report, timestamp


def read_review_report(path, root=None):
    try:
        if root is not None:
            private_legacy_file(root, path)
        report = json.loads(path.read_text(encoding="utf-8"), object_pairs_hook=no_duplicate_keys)
    except (OSError, json.JSONDecodeError) as error:
        fail(f"cannot read retained review report: {error}")
    return validate_review_report(report, path.name, report.get("reviewed_at", path.stat().st_mtime_ns // 1_000_000))


def review_reports(root):
    if ledger_exists(root):
        reports = []
        with ledger_connection(root) as connection:
            for report_id, payload, timestamp in connection.execute(
                    "SELECT report_id, payload, reviewed_at FROM review_reports ORDER BY report_id"):
                try:
                    report = json.loads(payload, object_pairs_hook=no_duplicate_keys)
                except json.JSONDecodeError as error:
                    fail(f"cannot read retained review report: {error}")
                report, timestamp = validate_review_report(report, f"{report_id}.json", timestamp)
                reports.append((None, report, timestamp))
        return reports
    directory = root / "reviews"
    if not directory.is_dir():
        return []
    reports = []
    for path in directory.glob("*.json"):
        if path.name == "reviewed.json":
            continue
        report, timestamp = read_review_report(path, root)
        reports.append((path, report, timestamp))
    return reports


def reviewed_ids_unlocked(root, cutoff=None):
    index = review_index(root)
    session_times = dict(index["sessions"])
    cycle_times = dict(index["cycles"])
    for _, report, timestamp in review_reports(root):
        for key in report["session_ids"]:
            session_times[key] = max(session_times.get(key, 0), timestamp)
        for key in report.get("cycle_ids", []):
            cycle_times[key] = max(cycle_times.get(key, 0), timestamp)
    sessions = {key for key, timestamp in session_times.items()
                if (cutoff is None or timestamp <= cutoff)
                and timestamp > (index["forgotten_sessions"].get(key, 0)
                                 if cutoff is None or index["forgotten_sessions"].get(key, 0) <= cutoff else 0)}
    cycles = {key for key, timestamp in cycle_times.items() if cutoff is None or timestamp <= cutoff}
    return sessions, cycles


def reviewed_ids(state_root, cutoff=None, lock=True):
    root = review_root(state_root)
    lock_path = root / "reviews" / ".lock"
    review_state = root / "reviews"
    if lock and review_state.is_dir() and (any(review_state.glob("*.json")) or ledger_exists(root)) and not lock_path.is_file():
        fail("retained review state is missing its lock")
    if lock and lock_path.is_file():
        with open_existing_review_lock(lock_path) as handle:
            fcntl.flock(handle, fcntl.LOCK_SH)
            return reviewed_ids_unlocked(root, cutoff)
    return reviewed_ids_unlocked(root, cutoff)


def update_review_index(root, sessions=(), cycles=(), timestamp=None, connection=None):
    value = review_index(root)
    timestamp = timestamp or int(datetime.now(timezone.utc).timestamp() * 1000)
    for key in sessions:
        value["sessions"][key] = max(value["sessions"].get(key, 0), timestamp)
    for key in cycles:
        value["cycles"][key] = max(value["cycles"].get(key, 0), timestamp)
    if ledger_exists(root):
        owned = connection is None
        connection = connection or ledger_connection(root, write=True)
        connection.executemany(
            "INSERT INTO review_tombstones VALUES (?, ?, ?) ON CONFLICT(kind, item_id) DO UPDATE SET timestamp=max(timestamp, excluded.timestamp)",
            [("session", key, value["sessions"][key]) for key in sessions]
            + [("cycle", key, value["cycles"][key]) for key in cycles],
        )
        if owned:
            connection.commit()
            connection.close()
    else:
        private_json(root / "reviews" / "reviewed.json", value)
    return value


def prune_review_reports(root, connection=None):
    cutoff_ms = int((time.time() - REVIEW_RETENTION_SECONDS) * 1000)
    if ledger_exists(root):
        owned = connection is None
        connection = connection or ledger_connection(root, write=True)
        expired = list(connection.execute(
            "SELECT report_id, payload, reviewed_at FROM review_reports WHERE reviewed_at <= ?", (cutoff_ms,)))
        for report_id, payload, timestamp in expired:
            report, _ = validate_review_report(json.loads(payload, object_pairs_hook=no_duplicate_keys),
                                               f"{report_id}.json", timestamp)
            update_review_index(root, report.get("session_ids", []), report.get("cycle_ids", []), timestamp,
                                connection=connection)
            connection.execute("DELETE FROM ledger_entries WHERE scope='operational' AND report_id=?", (report_id,))
            connection.execute("DELETE FROM review_reports WHERE report_id=?", (report_id,))
            record_knowledge_privacy_tombstone(
                connection, "review", report_id, "expired", max(timestamp, REVIEW_START_MS))
        if owned:
            connection.commit()
            connection.close()
        return len(expired)
    reports, malformed_expired = [], []
    directory = root / "reviews"
    for path in directory.glob("*.json") if directory.is_dir() else ():
        if path.name == "reviewed.json":
            continue
        try:
            report, timestamp = read_review_report(path, root)
            reports.append((path, report, timestamp))
        except RuntimeError:
            if path.stat().st_mtime_ns // 1_000_000 > cutoff_ms:
                raise
            malformed_expired.append(path)
    index = review_index(root)
    for _, report, timestamp in reports:
        for key in report.get("session_ids", []):
            index["sessions"][key] = max(index["sessions"].get(key, 0), timestamp)
        for key in report.get("cycle_ids", []):
            index["cycles"][key] = max(index["cycles"].get(key, 0), timestamp)
    index_path = root / "reviews" / "reviewed.json"
    if reports or index_path.exists():
        private_json(index_path, index)
    removed = 0
    for path, _, timestamp in reports:
        if timestamp <= cutoff_ms:
            path.unlink()
            removed += 1
    for path in malformed_expired:
        path.unlink()
        removed += 1
    if removed:
        descriptor = os.open(directory, os.O_RDONLY)
        try:
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
    return removed


def valid_gate_exception(gate):
    exception = gate.get("exception")
    if (not isinstance(exception, dict)
            or exception.get("kind") not in ("deferred", "accepted_risk")
            or not all(isinstance(exception.get(name), str) and exception[name].strip()
                       for name in ("rationale", "owner", "review_condition", "approved_at"))):
        return False
    try:
        approved_at = datetime.fromisoformat(exception["approved_at"].replace("Z", "+00:00"))
    except ValueError:
        return False
    return approved_at.utcoffset() == timedelta(0)


def correlated_cycles(directory, hinted_ids, session_ids=(), cache=None, exact_session_id=None,
                      with_quality=False):
    cache_key = str(directory or "")
    cached = cache.get(cache_key) if cache is not None else None
    if cached is None:
        record_dirs, resolved = [], None
        worktree = Path(directory) if directory else None
        if worktree and worktree.is_dir():
            common_result = git(worktree, "rev-parse", "--git-common-dir", check=False)
            top_result = git(worktree, "rev-parse", "--show-toplevel", check=False)
            if not common_result.returncode and not top_result.returncode:
                common = Path(common_result.stdout.strip())
                if not common.is_absolute():
                    common = worktree / common
                record_dirs.append(common.resolve() / "dbsctr/cycles")
                resolved = Path(top_result.stdout.strip()).resolve()
        local_records = any(directory_path.is_dir() and next(directory_path.glob("*.json"), None)
                            for directory_path in record_dirs)
        if not local_records:
            try:
                current_records = common_git_dir(root_dir()).resolve() / "dbsctr/cycles"
                if current_records not in record_dirs:
                    record_dirs.append(current_records)
            except RuntimeError:
                pass
        records = []
        paths = sorted({path for directory_path in record_dirs if directory_path.is_dir()
                        for path in directory_path.glob("*.json")})
        for path in paths:
            try:
                record = json.loads(path.read_text(encoding="utf-8"))
                cycle_id = record.get("cycle_id")
                if not isinstance(cycle_id, str) or not OPAQUE_ID.fullmatch(cycle_id):
                    fail("Cycle Record contains an invalid cycle ID")
                records.append(record)
            except (OSError, json.JSONDecodeError):
                continue
        cached = (resolved, records)
        if cache is not None:
            cache[cache_key] = cached
    resolved, records = cached
    def runtime_ids(record):
        values = record.get("runtime", {}).get("opencode", {}).get("session_ids", [])
        return set(values) if isinstance(values, list) else set()

    def unique(matches, quality):
        return (matches, quality) if len(matches) == 1 else ([], "ambiguous" if matches else None)

    def recorded_path(record, source=False):
        try:
            base = resolved or root_dir()
            return (record_source_worktree(base, record) if source
                    else record_worktree(base, record))
        except (OSError, RuntimeError, KeyError, TypeError, ValueError):
            return None

    exact_ids = {exact_session_id} if exact_session_id is not None else set(session_ids)
    exact = [record for record in records if exact_ids.intersection(runtime_ids(record))]
    hinted = [record for record in records if record["cycle_id"] in hinted_ids]
    if exact:
        matched, quality = exact, "exact" if len(exact) == 1 else "ambiguous"
    elif hinted:
        matched, quality = hinted, "exact" if len(hinted) == 1 else "ambiguous"
    else:
        family_ids = set(session_ids) - exact_ids
        family, family_quality = unique(
            [record for record in records if family_ids.intersection(runtime_ids(record))], "family"
        )
        worktrees = [record for record in records if resolved is not None
                     and recorded_path(record) == resolved]
        worktree, worktree_quality = unique(worktrees, "worktree")
        sources = [record for record in records if resolved is not None
                   and recorded_path(record, source=True) == resolved]
        source, source_quality = unique(sources, "source")
        matched, quality = next(((items, value) for items, value in (
            (family, family_quality), (worktree, worktree_quality), (source, source_quality)
        ) if items), ([], "ambiguous" if "ambiguous" in (family_quality, worktree_quality, source_quality)
                       else "unavailable"))
    if not matched:
        return ([], quality) if with_quality else []
    output = []
    for record in matched:
        cycle_worktree = recorded_path(record)
        gates = record.get("gates", {}).values()
        if any(gate.get("applicability") == "required"
               and gate.get("result") in ("failed", "unavailable")
               and not valid_gate_exception(gate) for gate in gates):
            state = "blocked"
        elif record.get("state") == "completed":
            state = "completed"
        elif record.get("state") == "active" and (cycle_worktree is None or not cycle_worktree.is_dir()):
            state = "abandoned"
        else:
            state = "active"
        risk = record.get("risk", "unavailable")
        delivery = record.get("delivery_intent", "unavailable")
        if risk not in ("routine", "elevated", "critical") or delivery not in DELIVERY_INTENTS:
            risk, delivery = "unavailable", "unavailable"
        item = {"cycle_id": record["cycle_id"], "state": state,
                "risk": risk, "delivery_intent": delivery}
        context = record.get("context")
        try:
            started = datetime.fromisoformat(record["created_at"].replace("Z", "+00:00"))
            started_at = int(started.timestamp() * 1000)
            ended_at = None
            if state == "completed":
                ended = datetime.fromisoformat(record["completed_at"].replace("Z", "+00:00"))
                ended_at = int(ended.timestamp() * 1000)
                if ended_at < started_at:
                    raise ValueError
            if isinstance(context, str) and OPAQUE_ID.fullmatch(context):
                item.update({"context": context, "started_at": started_at, "ended_at": ended_at})
        except (KeyError, TypeError, ValueError):
            pass
        if state == "completed":
            counters = record.get("metrics", {})
            cycle_metrics = {name: counters.get(name, 0) for name in (
                "gate_failure_count", "gate_reopen_count", "remediation_round_count")}
            if any(type(value) is not int or value < 0 for value in cycle_metrics.values()):
                fail("Cycle Record contains invalid metrics")
            elapsed = "unavailable"
            try:
                started = datetime.fromisoformat(record["created_at"].replace("Z", "+00:00"))
                completed = datetime.fromisoformat(record["completed_at"].replace("Z", "+00:00"))
                elapsed = max(0, int((completed - started).total_seconds() * 1000))
            except (KeyError, TypeError, ValueError):
                pass
            cycle_metrics["elapsed_ms"] = elapsed
            item["metrics"] = cycle_metrics
        activation = record.get("runtime", {}).get("opencode", {}).get("harness_activation")
        if activation is not None:
            item["harness_activation"] = validate_stored_harness_activation(activation)
        if "phase_profile" in record:
            item["phase_profile"] = validate_phase_profile(record["phase_profile"], record["cycle_id"])
        output.append(item)
    output = sorted(output, key=lambda item: item["cycle_id"])
    return (output, quality) if with_quality else output


def session_family_map(rows):
    adjacency = {}
    for row in rows:
        session_id, parent_id = str(row[0]), str(row[1]) if row[1] else None
        adjacency.setdefault(session_id, set())
        if parent_id:
            adjacency[session_id].add(parent_id)
            adjacency.setdefault(parent_id, set()).add(session_id)
    families, remaining = {}, set(adjacency)
    while remaining:
        member = remaining.pop()
        family, pending = {member}, [member]
        while pending:
            current = pending.pop()
            new = adjacency[current] - family
            family.update(new)
            pending.extend(new)
        remaining.difference_update(family)
        for session_id in family:
            families[session_id] = family
    return families


def review_attention(cycles, timestamp, snapshot):
    return (["dormant"] if any(item["state"] == "active" for item in cycles)
            and snapshot - timestamp >= REVIEW_DORMANT_MS else [])


def review_priority(item):
    rank = {"blocked": 0, "abandoned": 1, "completed": 3, "active": 4}
    values = [rank[cycle["state"]] for cycle in item["cycles"]]
    if "dormant" in item["attention"]:
        values.append(2)
    return min(values, default=5)


def review_scan(args):
    if args.limit < 1 or args.limit > REVIEW_MAX_LIMIT or args.cursor < 0:
        fail("review scan limit must be 1 through 100 and cursor non-negative")
    current_ms = int(datetime.now(timezone.utc).timestamp() * 1000)
    continuation = args.snapshot is not None
    snapshot = current_ms if args.snapshot is None else args.snapshot
    if not isinstance(snapshot, int) or snapshot < REVIEW_START_MS or snapshot > current_ms:
        fail("review scan snapshot must be a valid non-future millisecond cutoff")
    database = opencode_database(args.database)
    if not database.is_file():
        fail("OpenCode database is missing")
    excluded_session_id = getattr(args, "excluded_session_id", None)
    if excluded_session_id is not None and not OPAQUE_ID.fullmatch(excluded_session_id):
        fail("invalid excluded session ID")
    excluded_message_id = getattr(args, "excluded_message_id", None)
    if excluded_message_id is not None and not OPAQUE_ID.fullmatch(excluded_message_id):
        fail("invalid excluded message ID")
    try:
        connection = sqlite3.connect(f"file:{database}?mode=ro", uri=True)
        connection.execute("BEGIN")
        tables = {row[0].lower(): row[0] for row in connection.execute("SELECT name FROM sqlite_master WHERE type='table'")}
        if not {"session", "message", "part"} <= set(tables):
            fail("OpenCode database lacks required session/message/part tables")
        session, message, part = (tables[name] for name in ("session", "message", "part"))
        exclusion_digest = getattr(args, "exclusion_digest", None)
        if exclusion_digest is not None and not re.fullmatch(r"[0-9a-f]{64}", exclusion_digest):
            fail("invalid review exclusion digest")
        session_columns = {row[1].lower().replace("_", ""): row[1]
                           for row in connection.execute(f'PRAGMA table_info("{session}")')}
        session_ceiling = args.session_ceiling
        part_ceiling = args.part_ceiling
        if continuation and (session_ceiling is None or part_ceiling is None):
            fail("review scan continuation requires row ceilings")
        if session_ceiling is None:
            session_ceiling = connection.execute(f'SELECT COALESCE(MAX(rowid), 0) FROM "{session}"').fetchone()[0]
        if part_ceiling is None:
            part_ceiling = connection.execute(f'SELECT COALESCE(MAX(rowid), 0) FROM "{part}"').fetchone()[0]
        if (type(session_ceiling) is not int or not 0 <= session_ceiling <= 2**63 - 1
                or type(part_ceiling) is not int or not 0 <= part_ceiling <= 2**63 - 1):
            fail("review scan row ceilings must be non-negative integers")
        sid = sqlite_name(connection, session, ("id",))
        pid = sqlite_name(connection, part, ("id",))
        parent = sqlite_name(connection, session, ("parentid", "parent")) if any(
            row[1].lower().replace("_", "") in ("parentid", "parent") for row in connection.execute(f"PRAGMA table_info({session})")
        ) else None
        created = sqlite_name(connection, session, ("timecreated", "createdat", "time", "timestamp"))
        directory = sqlite_name(connection, session, ("directory",)) if any(
            row[1].lower().replace("_", "") == "directory" for row in connection.execute(f"PRAGMA table_info({session})")
        ) else None
        agent = sqlite_name(connection, session, ("agent",)) if any(
            row[1].lower().replace("_", "") == "agent" for row in connection.execute(f"PRAGMA table_info({session})")
        ) else None
        mid, msession = sqlite_name(connection, message, ("id",)), sqlite_name(connection, message, ("sessionid",))
        message_columns = {row[1].lower().replace("_", ""): row[1]
                           for row in connection.execute(f'PRAGMA table_info("{message}")')}
        mtime = next((message_columns[name] for name in ("timecreated", "createdat", "time", "timestamp")
                      if name in message_columns), None)
        mbody = next((message_columns[name] for name in ("data", "text", "content")
                      if name in message_columns), None)
        pmessage = sqlite_name(connection, part, ("messageid",))
        pbody = sqlite_name(connection, part, ("data", "text", "content"))
        part_time = sqlite_name(connection, part, ("timecreated", "createdat", "time", "timestamp"))
        part_columns = {row[1].lower().replace("_", ""): row[1]
                        for row in connection.execute(f'PRAGMA table_info("{part}")')}
        part_updated = part_columns.get("timeupdated")
        if exclusion_digest is not None:
            root = next((str(row[0]) for row in connection.execute(f'SELECT "{sid}" FROM "{session}"')
                         if session_id_digest(str(row[0])) == exclusion_digest), None)
            if root is None:
                fail("review exclusion digest does not match a session")
        else:
            root = (session_for_message(args.database, excluded_message_id)
                    if excluded_message_id is not None else excluded_session_id)
            exclusion_digest = session_id_digest(root) if root is not None else None
        excluded_sessions = excluded_review_family(connection, session, root) if root is not None else set()
        excluded = tuple(sorted(excluded_sessions))
        session_exclusion = (f' AND "{sid}" NOT IN ({",".join("?" for _ in excluded)})' if excluded else "")
        message_exclusion = (f' AND (m."{msession}" NOT IN ({",".join("?" for _ in excluded)}) '
                             f'OR m."{msession}" IS NULL)' if excluded else "")
        identity = hashlib.sha256()
        source_identities = {}
        if exclusion_digest is not None:
            identity.update(b"excluded\0" + exclusion_digest.encode())
        session_identity_columns = [sid, created]
        for value in (parent, directory, agent, session_columns.get("projectid"), session_columns.get("model"),
                      session_columns.get("cost"),
                      *(session_columns.get(name) for name in (
                          "tokensinput", "tokensoutput", "tokensreasoning", "tokenscacheread", "tokenscachewrite"
                      ))):
            if value and value not in session_identity_columns:
                session_identity_columns.append(value)
        selected = ", ".join(f'"{value}"' for value in session_identity_columns)
        for row in connection.execute(
                f'SELECT {selected} FROM "{session}" WHERE "{created}" BETWEEN ? AND ? '
                f'AND rowid <= ?{session_exclusion} ORDER BY "{sid}"',
                (REVIEW_START_MS, snapshot, session_ceiling, *excluded)):
            identity.update(b"s\0")
            encoded = json.dumps(row, sort_keys=True, default=str).encode()
            identity.update(encoded)
            source_identities.setdefault(str(row[0]), hashlib.sha256()).update(b"s\0" + encoded)
        if mtime and mbody:
            for row in connection.execute(
                    f'SELECT m."{msession}", m."{mid}", m."{mtime}", m."{mbody}" FROM "{message}" m '
                    f'JOIN "{session}" s ON s."{sid}"=m."{msession}" '
                    f'WHERE s."{created}" BETWEEN ? AND ? AND s.rowid <= ? '
                    f'AND m."{mtime}" BETWEEN ? AND ?{message_exclusion} ORDER BY m."{mid}"',
                    (REVIEW_START_MS, snapshot, session_ceiling, REVIEW_START_MS, snapshot, *excluded)):
                session_value, message_id, message_timestamp, message_body = row
                encoded = hashlib.sha256(
                    f"m\0{session_value}\0{message_id}\0{message_timestamp}\0".encode()
                    + hashlib.sha256(str(message_body).encode()).digest()).digest()
                identity.update(encoded)
                source_identities.setdefault(str(session_value), hashlib.sha256()).update(encoded)
        part_identity_values = f'p."{pbody}"' + (f', p."{part_updated}"' if part_updated else '')
        part_identity_query = (
            f'SELECT m."{msession}", p."{pid}", p."{part_time}", {part_identity_values} FROM "{part}" p '
            f'LEFT JOIN "{message}" m ON p."{pmessage}"=m."{mid}" '
            f'WHERE p."{part_time}" BETWEEN ? AND ? AND p.rowid <= ?{message_exclusion} ORDER BY p."{pid}"'
        )
        for row in connection.execute(
                part_identity_query,
                (REVIEW_START_MS, snapshot, part_ceiling, *excluded)):
            session_value, part_id, part_timestamp, *part_values = row
            source = hashlib.sha256(f"p\0{session_value}\0{part_id}\0{part_timestamp}\0".encode())
            for part_value in part_values:
                source.update(hashlib.sha256(str(part_value).encode()).digest())
            encoded = source.digest()
            identity.update(encoded)
            if session_value is not None:
                source_identities.setdefault(str(session_value), hashlib.sha256()).update(encoded)
        database_digest = identity.hexdigest()
        for table, column in ((session, created), (part, part_time)):
            invalid = connection.execute(
                f'SELECT 1 FROM "{table}" WHERE "{column}" IS NOT NULL '
                f'AND (typeof("{column}") != \'integer\' OR "{column}" < 100000000000) LIMIT 1'
            ).fetchone()
            if invalid:
                fail(f"OpenCode {table} timestamps must be integer milliseconds")
        parent_value = f's."{parent}"' if parent else "NULL"
        created_value = f's."{created}"'
        directory_value = f's."{directory}"' if directory else "NULL"
        agent_value = f's."{agent}"' if agent else "''"
        child_exclusion = (f' AND c."{sid}" NOT IN ({",".join("?" for _ in excluded)})' if excluded else "")
        children = (f'(SELECT group_concat(c."{sid}", ",") FROM "{session}" c '
                    f'WHERE c."{parent}"=content.session_id AND c."{created}" <= ? AND c.rowid <= ?{child_exclusion})') if parent else "NULL"
        time_filter = f'(typeof(s."{created}") = \'integer\' AND s."{created}" BETWEEN ? AND ? AND s.rowid <= ?)'
        part_order = f'p."{part_time}" DESC'
        part_source = (f'SELECT substr(p."{pbody}", 1, 2048) body FROM "{message}" m '
                       f'JOIN "{part}" p ON p."{pmessage}"=m."{mid}" WHERE m."{msession}"=s."{sid}" '
                       f'AND p."{part_time}" <= ? AND p.rowid <= ?')
        body = (f'(SELECT group_concat(body, "\\n") FROM ('
                f'SELECT body FROM ({part_source} ORDER BY {part_order.replace(" DESC", " ASC")} LIMIT 16) '
                 f'UNION ALL SELECT body FROM ({part_source} ORDER BY {part_order} LIMIT 16)))')
        last_activity = (f'MAX({created_value}, COALESCE((SELECT MAX(p."{part_time}") FROM "{message}" m '
                         f'JOIN "{part}" p ON p."{pmessage}"=m."{mid}" WHERE m."{msession}"=s."{sid}" '
                         f'AND p."{part_time}" <= ? AND p.rowid <= ?), {created_value}))')
        query = f"""
            WITH RECURSIVE content AS (
                SELECT s."{sid}" session_id, {parent_value} parent_id,
                       {created_value} created_at, {last_activity} last_activity,
                       {directory_value} directory,
                       {agent_value} agent, COALESCE({body}, '') body
                FROM "{session}" s
                WHERE {time_filter}{session_exclusion}
            ), seeds AS (
                SELECT session_id FROM content
                WHERE lower(body) LIKE '%dbsctr%'
                   OR lower(body) LIKE '%/discovery%'
                   OR lower(body) LIKE '%/qa%'
                   OR lower(agent) IN ('reviewer-openai', 'builder-openai', 'builder-bedrock')
            ), edges(source, target) AS (
                SELECT session_id, parent_id FROM content WHERE parent_id IS NOT NULL
                UNION SELECT parent_id, session_id FROM content WHERE parent_id IS NOT NULL
            ), expanded(session_id) AS (
                SELECT session_id FROM seeds
                UNION SELECT edges.target FROM edges JOIN expanded ON edges.source=expanded.session_id
            )
            SELECT content.session_id, content.parent_id, content.created_at, content.last_activity,
                   {children}, content.body, content.directory, content.agent
            FROM content JOIN expanded ON expanded.session_id=content.session_id
            ORDER BY content.created_at, content.session_id
        """
        parameters = (snapshot, part_ceiling, snapshot, part_ceiling, snapshot, part_ceiling,
                      REVIEW_START_MS, snapshot, session_ceiling, *excluded,
                      *((snapshot, session_ceiling, *excluded) if parent else ()))
        rows = connection.execute(query, parameters).fetchall()
        history_metrics = {}
        if getattr(args, "history_metrics", False):
            wanted_sessions = {str(row[0]) for row in rows}
            project_column = session_columns.get("projectid")
            cost_column = session_columns.get("cost")
            model_column = session_columns.get("model")
            token_columns = [session_columns[name] for name in (
                "tokensinput", "tokensoutput", "tokensreasoning", "tokenscacheread", "tokenscachewrite"
            ) if name in session_columns]
            scalar_columns = [value for value in (project_column, cost_column, model_column, *token_columns) if value]
            scalar_values = {}
            if scalar_columns:
                selected = ", ".join(f's."{value}"' for value in scalar_columns)
                scalar_sql = (f'SELECT s."{sid}", {selected} FROM "{session}" s '
                              f'WHERE {time_filter}')
                for scalar_row in connection.execute(scalar_sql + session_exclusion,
                                                     (REVIEW_START_MS, snapshot, session_ceiling, *excluded)):
                    if str(scalar_row[0]) in wanted_sessions:
                        scalar_values[str(scalar_row[0])] = dict(zip(scalar_columns, scalar_row[1:]))
            for session_id in wanted_sessions:
                scalar = scalar_values.get(session_id, {})
                project_value = scalar.get(project_column) if project_column else None
                project_digest = (hashlib.sha256(str(project_value).encode()).hexdigest()
                                  if isinstance(project_value, str) and project_value else "unavailable")
                cost = scalar.get(cost_column) if cost_column else None
                cost_total = (cost if isinstance(cost, (int, float)) and not isinstance(cost, bool)
                              and math.isfinite(cost) and cost >= 0 else "unavailable")
                tokens = [scalar.get(name) for name in token_columns]
                token_total = (sum(tokens) if tokens and all(type(value) is int and value >= 0 for value in tokens)
                               else "unavailable")
                model = scalar.get(model_column) if model_column else None
                family = model_family(model) if isinstance(model, str) else "unavailable"
                history_metrics[session_id] = {
                    "project_digest": project_digest, "tool_count": "unavailable",
                    "tool_call_count": "unavailable", "tool_error_count": "unavailable",
                    "provider_error_count": "unavailable", "delegation_count": "unavailable",
                    "cost_total": cost_total, "token_total": token_total,
                    "model_families": [family] if family != "unavailable" else "unavailable",
                    "provider_ids": "unavailable", "model_ids": "unavailable",
                    "agent_ids": "unavailable", "session_relation": "unavailable",
                    "core_revisions": "unavailable", "overlay_revisions": "unavailable",
                }
            tool_case = (f'CASE WHEN json_valid(p."{pbody}") THEN '
                         f'CASE WHEN json_extract(p."{pbody}", \'$.type\')=\'tool\' THEN 1 ELSE 0 END ELSE 0 END')
            error_case = (f'CASE WHEN json_valid(p."{pbody}") THEN CASE WHEN '
                          f'json_extract(p."{pbody}", \'$.type\')=\'tool\' AND '
                          f'json_extract(p."{pbody}", \'$.state.status\') IN (\'error\',\'failed\') '
                          f'THEN 1 ELSE 0 END ELSE 0 END')
            if wanted_sessions:
                placeholders = ",".join("?" for _ in wanted_sessions)
                if parent:
                    delegation_sql = (f'SELECT s."{parent}", COUNT(*) FROM "{session}" s '
                                      f'WHERE s."{parent}" IN ({placeholders}) AND s."{created}" BETWEEN ? AND ? '
                                      f'AND s.rowid <= ?{session_exclusion} GROUP BY s."{parent}"')
                    delegation_args = (*sorted(wanted_sessions), REVIEW_START_MS, snapshot, session_ceiling, *excluded)
                    for session_value, delegation_count in connection.execute(delegation_sql, delegation_args):
                        session_id = str(session_value)
                        if session_id in history_metrics:
                            history_metrics[session_id]["delegation_count"] = int(delegation_count)
                metric_sql = (f'SELECT m."{msession}", SUM({tool_case}), SUM({error_case}) '
                              f'FROM "{message}" m JOIN "{part}" p ON p."{pmessage}"=m."{mid}" '
                              f'WHERE m."{msession}" IN ({placeholders}) AND p."{part_time}" BETWEEN ? AND ? '
                               f'AND p.rowid <= ?{message_exclusion} GROUP BY m."{msession}"')
                metric_args = (*sorted(wanted_sessions), REVIEW_START_MS, snapshot, part_ceiling, *excluded)
                for session_value, tool_calls, tool_errors in connection.execute(metric_sql, metric_args):
                    session_id = str(session_value)
                    if session_id in history_metrics:
                        history_metrics[session_id].update({
                            "tool_count": int(tool_calls or 0), "tool_call_count": int(tool_calls or 0),
                            "tool_error_count": int(tool_errors or 0),
                        })
                if mtime and mbody:
                    model_sql = (f'SELECT m."{msession}", COALESCE('
                                 f'json_extract(m."{mbody}", \'$.model.providerID\'), '
                                 f'json_extract(m."{mbody}", \'$.providerID\')), COALESCE('
                                 f'json_extract(m."{mbody}", \'$.model.modelID\'), '
                                 f'json_extract(m."{mbody}", \'$.modelID\')) FROM "{message}" m '
                                 f'WHERE m."{msession}" IN ({placeholders}) AND m."{mtime}" BETWEEN ? AND ? '
                                 f'AND json_valid(m."{mbody}"){message_exclusion}')
                    model_args = (*sorted(wanted_sessions), REVIEW_START_MS, snapshot, *excluded)
                    for session_value, provider_value, model_value in connection.execute(model_sql, model_args):
                        session_id = str(session_value)
                        family = model_family(model_value) if isinstance(model_value, str) else "unavailable"
                        if session_id in history_metrics and family != "unavailable":
                            families = history_metrics[session_id]["model_families"]
                            history_metrics[session_id]["model_families"] = sorted(
                                set(families if isinstance(families, list) else ()) | {family})
                        if session_id in history_metrics and isinstance(provider_value, str) and OPAQUE_ID.fullmatch(provider_value):
                            values = history_metrics[session_id]["provider_ids"]
                            history_metrics[session_id]["provider_ids"] = sorted(
                                set(values if isinstance(values, list) else ()) | {provider_value})
                        if (session_id in history_metrics and isinstance(model_value, str)
                                and re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}", model_value)):
                            values = history_metrics[session_id]["model_ids"]
                            history_metrics[session_id]["model_ids"] = sorted(
                                set(values if isinstance(values, list) else ()) | {model_value})
                    provider_sql = (f'SELECT m."{msession}", SUM(CASE WHEN json_valid(m."{mbody}") '
                                    f'AND json_type(m."{mbody}", \'$.error\') IS NOT NULL THEN 1 ELSE 0 END) '
                                    f'FROM "{message}" m WHERE m."{msession}" IN ({placeholders}) '
                                    f'AND m."{mtime}" BETWEEN ? AND ?{message_exclusion} GROUP BY m."{msession}"')
                    provider_args = (*sorted(wanted_sessions), REVIEW_START_MS, snapshot, *excluded)
                    for session_value, provider_errors in connection.execute(provider_sql, provider_args):
                        session_id = str(session_value)
                        if session_id in history_metrics:
                            history_metrics[session_id]["provider_error_count"] = int(provider_errors or 0)
    except sqlite3.Error as error:
        fail(f"cannot read OpenCode database: {error}")
    finally:
        if 'connection' in locals():
            connection.close()
    improvement_sessions = set()
    root = review_root(args.state_root)
    if ledger_exists(root):
        with ledger_connection(root) as ledger:
            if ledger.execute(
                    "SELECT 1 FROM sqlite_master WHERE type='table' AND name='improvement_workers'").fetchone():
                improvement_sessions = {row[0] for row in ledger.execute(
                    "SELECT session_id FROM improvement_workers WHERE session_id IS NOT NULL")}
    reviewed_sessions, _ = reviewed_ids(args.state_root, snapshot if continuation else None,
                                         lock=not getattr(args, "lock_held", False))
    eligible, cycle_cache, identity_cache = [], {}, {}
    families = session_family_map(rows)
    review_markers = {str(row[0]) for row in rows
                      if isinstance(row[5], str) and "dbsctr-improve" in row[5].lower()}
    for row in rows:
        session_id, agent_name = str(row[0]), row[7]
        if session_id in history_metrics and isinstance(agent_name, str) and OPAQUE_ID.fullmatch(agent_name):
            history_metrics[session_id]["agent_ids"] = [agent_name]
    for session_id, parent_id, timestamp, last_activity, child_ids, text, directory, agent_name in rows:
        session_id = str(session_id)
        parent_id = str(parent_id) if parent_id else None
        children_values = sorted(str(child_ids).split(","))[:16] if child_ids else []
        if (not OPAQUE_ID.fullmatch(session_id) or parent_id is not None and not OPAQUE_ID.fullmatch(parent_id)
                or not all(OPAQUE_ID.fullmatch(value) for value in children_values)):
            fail("OpenCode session metadata contains an invalid opaque ID")
        reviewed = session_id in reviewed_sessions
        if reviewed and not getattr(args, "include_reviewed", False):
            continue
        related_ids = families.get(session_id, {session_id})
        cycles, correlation_quality = correlated_cycles(
            directory, set(), related_ids, cycle_cache, exact_session_id=session_id, with_quality=True,
        )
        if getattr(args, "history_metrics", False):
            metrics = history_metrics.get(session_id, {})
            metrics["session_relation"] = "child" if parent_id else "primary"
            if parent_id is None:
                for name in ("model_families", "provider_ids", "model_ids", "agent_ids"):
                    related_values = [history_metrics.get(related_id, {}).get(name, "unavailable")
                                      for related_id in related_ids]
                    metrics[name] = (sorted({value for values in related_values for value in values})
                                     if all(isinstance(values, list) and values for values in related_values)
                                     else "unavailable")
            activations = [cycle.get("harness_activation") for cycle in cycles if cycle.get("harness_activation")]
            if activations:
                metrics["core_revisions"] = sorted({item["core_revision"] for item in activations})
                metrics["overlay_revisions"] = sorted({item["overlay_revision"] for item in activations})
        attention = review_attention(cycles, last_activity, snapshot)
        candidate = {"session_id": session_id, "parent_session_id": parent_id,
                         "child_session_ids": children_values,
                          "timestamp": str(timestamp)[:64] if timestamp is not None else None,
                          "last_activity": str(last_activity)[:64] if last_activity is not None else None,
                          "cycles": cycles, "attention": attention,
                           "correlation_quality": correlation_quality,
                           "reviewed_status": "reviewed" if reviewed else "unreviewed",
                           "review_session": bool(set(related_ids).intersection(
                               improvement_sessions | review_markers))}
        if getattr(args, "history_metrics", False):
            metrics = history_metrics.get(session_id, {})
            candidate["_history_metrics"] = metrics
            candidate["telemetry"] = history_telemetry(candidate, metrics)
            candidate["_history_identity"] = history_identity(
                cycles, directory, related_ids, metrics.get("project_digest", "unavailable"), identity_cache,
            )
        eligible.append(candidate)
    manifest = []
    for item in eligible:
        value = {key: field for key, field in item.items() if not key.startswith("_")}
        if getattr(args, "bind_history", False):
            value["history_identity"] = item.get("_history_identity", {})
            value["history_metrics"] = item.get("_history_metrics", {})
        manifest.append(value)
    database_digest = hashlib.sha256(
        (database_digest + "\0" + json.dumps(manifest, sort_keys=True, separators=(",", ":"))).encode()
    ).hexdigest()
    if (continuation and args.database_digest != database_digest
            and not getattr(args, "allow_database_drift", False)):
        fail("OpenCode database changed within the review snapshot")
    if getattr(args, "include_reviewed", False):
        eligible.sort(key=lambda item: (item["last_activity"] or "", item["session_id"]), reverse=True)
    candidates = eligible if getattr(args, "history_all", False) else eligible[args.cursor:args.cursor + args.limit]
    candidates.sort(key=lambda item: (review_priority(item), item["timestamp"] or "", item["session_id"]))
    page_identity = hashlib.sha256()
    for candidate in candidates:
        session_id = candidate["session_id"]
        page_identity.update(session_id.encode() + b"\0")
        page_identity.update(source_identities.get(session_id, hashlib.sha256()).digest())
    page_digest = page_identity.hexdigest()
    session_ids = [item["session_id"] for item in candidates]
    cycle_ids = sorted({cycle["cycle_id"] for item in candidates for cycle in item["cycles"]})
    states = [cycle["state"] for item in candidates for cycle in item["cycles"]]
    result = {"schema_version": 2, "candidates": candidates, "scorecard": {
        "active": states.count("active"), "blocked": states.count("blocked"),
        "abandoned": states.count("abandoned"),
        "dormant": sum("dormant" in item["attention"] for item in candidates),
        "completed": states.count("completed"),
        "unknown": sum(not item["cycles"] for item in candidates)},
        "session_ids": session_ids, "cycle_ids": cycle_ids,
        "digest": review_digest(candidates, snapshot, session_ceiling, part_ceiling, page_digest),
        "limit": args.limit, "cursor": args.cursor, "snapshot": snapshot,
        "session_ceiling": session_ceiling, "part_ceiling": part_ceiling,
        "database_digest": database_digest,
        "exclusion_digest": exclusion_digest,
        "continuation": {"cursor": args.cursor + args.limit, "snapshot": snapshot,
                          "session_ceiling": session_ceiling, "part_ceiling": part_ceiling,
                          "database_digest": database_digest, "exclusion_digest": exclusion_digest}
         if not getattr(args, "history_all", False) and len(eligible) > args.cursor + args.limit else None}
    result["_excluded_session_ids"] = sorted(excluded_sessions)
    if getattr(args, "history_metrics", False):
        result["_source_identities"] = {key: value.hexdigest() for key, value in source_identities.items()}
    encoded = json.dumps(result, sort_keys=True, separators=(",", ":"), ensure_ascii=True)
    if not getattr(args, "history_metrics", False) and len(encoded.encode()) > REVIEW_SCAN_HARD:
        fail("review scan response exceeds bound")
    return result


def command_review_scan(args):
    scan = review_scan(args)
    scan.pop("_excluded_session_ids", None)
    scan.pop("_source_identities", None)
    print(json.dumps(scan, sort_keys=True, separators=(",", ":"), ensure_ascii=True))


def incident_redact(value, limit=2048):
    text = str(value).replace("\r\n", "\n").replace("\r", "\n")
    text = re.sub(r"[^\x09\x0a\x20-\x7e]", " ", text)
    text = re.sub(r"(?i)\b(?:proxy-)?authorization\s*[:=]\s*[^\n]+",
                  "authorization=[REDACTED]", text)
    secret = r"(?:pass(?:word)?|secret|token|key|credential|auth(?:orization)?|cookie|api[_-]?key)"
    quoted = r'''(?:"(?:\\.|[^"\\\n])*"|'(?:\\.|[^'\\\n])*'|\S+)'''
    field = rf'''(?:"{secret}"|'{secret}'|\b{secret}\b)'''
    text = re.sub(rf"(--?{secret}(?:=|\s+)){quoted}",
                  lambda match: match.group(1) + "[REDACTED]", text, flags=re.I)
    text = re.sub(rf"({field}\s*[:=]\s*){quoted}",
                  lambda match: match.group(1) + "[REDACTED]", text, flags=re.I)
    text = re.sub(rf"(\bBearer\s+){quoted}",
                  lambda match: match.group(1) + "[REDACTED]", text, flags=re.I)
    text = SECRET_VALUE.sub("[REDACTED]", text)
    text = HIGH_ENTROPY.sub("[REDACTED]", text)
    return text.strip()[:limit]


def incident_scope(candidates, session_id):
    by_id = {item["session_id"]: item for item in candidates}
    if session_id not in by_id:
        fail("incident session is outside the DBSCTR review family")
    adjacency = {item_id: set() for item_id in by_id}
    for item_id, item in by_id.items():
        related = [item.get("parent_session_id"), *item.get("child_session_ids", [])]
        for value in related:
            if value in adjacency:
                adjacency[item_id].add(value)
                adjacency[value].add(item_id)
    family, pending = {session_id}, [session_id]
    while pending:
        current = pending.pop()
        new = adjacency[current] - family
        family.update(new)
        pending.extend(new)
    return family


def incident_signal_id(session_id, message_id, part_id, tool):
    return hashlib.sha256(f"{session_id}\0{message_id}\0{part_id}\0{tool}".encode()).hexdigest()[:24]


def incident_scan_data(args):
    session_id = getattr(args, "session_id", None)
    if session_id is not None and not OPAQUE_ID.fullmatch(session_id):
        fail("invalid incident session ID")
    scan = review_scan(argparse.Namespace(
        database=args.database, state_root=args.state_root, limit=REVIEW_MAX_LIMIT, cursor=0,
        snapshot=None, session_ceiling=None, part_ceiling=None, database_digest=None,
        excluded_session_id=None, excluded_message_id=None, exclusion_digest=None,
        history_metrics=True, history_all=True, include_reviewed=True, bind_history=False,
        lock_held=False,
    ))
    candidate_ids = {item["session_id"] for item in scan["candidates"]}
    scope = incident_scope(scan["candidates"], session_id) if session_id else candidate_ids
    root = review_root(args.state_root)
    dispositions = set()
    if ledger_exists(root):
        with ledger_connection(root) as ledger:
            if ledger.execute("SELECT value FROM ledger_meta WHERE key='incident_schema'").fetchone():
                dispositions = {row[0] for row in ledger.execute(
                    "SELECT signal_id FROM incident_signal_dispositions")}
    database = opencode_database(args.database)
    try:
        connection = sqlite3.connect(f"file:{database}?mode=ro", uri=True)
        connection.create_function("incident_signal_id", 4, incident_signal_id, deterministic=True)
        connection.execute("CREATE TEMP TABLE incident_dispositions(signal_id TEXT PRIMARY KEY)")
        connection.executemany("INSERT INTO incident_dispositions VALUES (?)",
                               ((signal_id,) for signal_id in dispositions))
        tables = {row[0].lower(): row[0] for row in connection.execute(
            "SELECT name FROM sqlite_master WHERE type='table'")}
        message, part = tables["message"], tables["part"]
        mid = sqlite_name(connection, message, ("id",))
        msession = sqlite_name(connection, message, ("sessionid",))
        pid = sqlite_name(connection, part, ("id",))
        pmessage = sqlite_name(connection, part, ("messageid",))
        ptime = sqlite_name(connection, part, ("timecreated", "createdat", "time", "timestamp"))
        pbody = sqlite_name(connection, part, ("data", "text", "content"))
        rows = []
        if scope:
            placeholders = ",".join("?" for _ in scope)
            body = f'''CASE WHEN json_valid(p."{pbody}") THEN p."{pbody}" ELSE '{{}}' END'''
            success_body = f'''CASE WHEN json_valid(sp."{pbody}") THEN sp."{pbody}" ELSE '{{}}' END'''
            tool = f'''coalesce(json_extract({body},'$.tool'),json_extract({body},'$.name'),
                                json_extract({body},'$.state.tool'),'unknown')'''
            success_tool = f'''coalesce(json_extract({success_body},'$.tool'),
                    json_extract({success_body},'$.name'),json_extract({success_body},'$.state.tool'),'unknown')'''
            rows = connection.execute(
                f'''SELECT m."{msession}",m."{mid}",p."{pid}",p."{ptime}",p."{pbody}",
                    EXISTS (SELECT 1 FROM "{message}" sm JOIN "{part}" sp
                            ON sp."{pmessage}"=sm."{mid}"
                            WHERE sm."{msession}"=m."{msession}" AND sp.rowid <= ?
                              AND sp."{ptime}" <= ? AND sp."{ptime}" > p."{ptime}"
                              AND json_extract({success_body},'$.type')='tool'
                              AND lower(json_extract({success_body},'$.state.status')) IN ('completed','success')
                              AND {success_tool}={tool}) AS recovered
                    FROM "{message}" m JOIN "{part}" p ON p."{pmessage}"=m."{mid}"
                    WHERE m."{msession}" IN ({placeholders}) AND p.rowid <= ? AND p."{ptime}" <= ?
                      AND json_extract({body},'$.type')='tool'
                      AND lower(json_extract({body},'$.state.status')) IN ('error','failed')
                      AND incident_signal_id(m."{msession}",m."{mid}",p."{pid}",{tool})
                          NOT IN (SELECT signal_id FROM incident_dispositions)
                    ORDER BY recovered,p."{ptime}" DESC,p."{pid}" LIMIT 101''',
                (scan["part_ceiling"], scan["snapshot"], *sorted(scope),
                 scan["part_ceiling"], scan["snapshot"]),
            ).fetchall()
    except (KeyError, sqlite3.Error) as error:
        fail(f"cannot read OpenCode incidents: {error}")
    finally:
        if "connection" in locals():
            connection.close()
    calls = []
    for source_session, message_id, part_id, timestamp, raw, recovered in rows:
        try:
            payload = json.loads(raw, object_pairs_hook=no_duplicate_keys)
        except (TypeError, json.JSONDecodeError, RuntimeError):
            continue
        state = payload.get("state") if isinstance(payload, dict) else None
        if not isinstance(payload, dict) or payload.get("type") != "tool" or not isinstance(state, dict):
            continue
        tool_name = payload.get("tool") or payload.get("name") or state.get("tool") or "unknown"
        if not isinstance(tool_name, str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}", tool_name):
            tool_name = "unknown"
        status = state.get("status")
        if not isinstance(status, str):
            continue
        calls.append({"session_id": str(source_session), "message_id": str(message_id),
                      "part_id": str(part_id), "timestamp": int(timestamp),
                      "tool": tool_name, "status": status.lower(), "state": state,
                      "recovered": bool(recovered)})
    incidents = []
    if ledger_exists(root):
        with ledger_connection(root) as ledger:
            if ledger.execute("SELECT value FROM ledger_meta WHERE key='incident_schema'").fetchone():
                incident_sql = (
                    "SELECT incident_id,session_id,parent_session_id,message_id,kind,title,summary,state,cycle_id,"
                    "diagnostics,evidence,created_at,updated_at FROM incidents")
                incident_args = ()
                if session_id is not None:
                    placeholders = ",".join("?" for _ in scope)
                    incident_sql += f" WHERE session_id IN ({placeholders})"
                    incident_args = tuple(sorted(scope))
                incident_sql += " ORDER BY updated_at DESC,incident_id LIMIT 101"
                for row in ledger.execute(incident_sql, incident_args):
                    item = incident_record(row)
                    item["signal_ids"] = [value[0] for value in ledger.execute(
                        "SELECT signal_id FROM incident_signal_dispositions "
                        "WHERE incident_id=? AND disposition='promoted' ORDER BY signal_id",
                        (item["incident_id"],))]
                    incidents.append(item)
    signals = []
    for item in calls:
        signal_id = incident_signal_id(item["session_id"], item["message_id"], item["part_id"], item["tool"])
        detail = item["state"].get("error", item["status"])
        if not isinstance(detail, str):
            detail = json.dumps(detail, sort_keys=True, separators=(",", ":"), ensure_ascii=True)
        signals.append({
            "signal_id": signal_id, "session_id": item["session_id"],
            "message_id": item["message_id"], "part_id": item["part_id"],
            "timestamp": item["timestamp"], "tool": item["tool"], "status": item["status"],
            "recovered": item["recovered"],
            "evidence": incident_redact(detail, 1024),
        })
    signals.sort(key=lambda item: (item["recovered"], -item["timestamp"], item["signal_id"]))
    result = {"schema_version": 1, "incidents": incidents[:100], "signals": signals[:100],
              "incident_overflow": len(incidents) > 100, "signal_overflow": len(rows) > 100,
              "snapshot": scan["snapshot"], "session_ceiling": scan["session_ceiling"],
              "part_ceiling": scan["part_ceiling"], "database_digest": scan["database_digest"]}
    if len(json.dumps(result, ensure_ascii=True).encode()) > REVIEW_SCAN_HARD:
        fail("incident scan response exceeds bound")
    return result


def command_incident_scan(args):
    print(json.dumps(incident_scan_data(args), sort_keys=True, separators=(",", ":"), ensure_ascii=True))


def incident_session_parent(database, session_id, message_id):
    if session_for_message(database, message_id) != session_id:
        fail("incident message belongs to another session")
    path = opencode_database(database)
    try:
        connection = sqlite3.connect(f"file:{path}?mode=ro", uri=True)
        table = next(row[0] for row in connection.execute(
            "SELECT name FROM sqlite_master WHERE type='table'") if row[0].lower() == "session")
        sid = sqlite_name(connection, table, ("id",))
        parent = sqlite_name(connection, table, ("parentid", "parent"))
        row = connection.execute(f'SELECT "{parent}" FROM "{table}" WHERE "{sid}"=?',
                                 (session_id,)).fetchone()
    except (StopIteration, sqlite3.Error) as error:
        fail(f"cannot validate incident session: {error}")
    finally:
        if "connection" in locals():
            connection.close()
    if row is None or row[0] is None or not OPAQUE_ID.fullmatch(str(row[0])):
        fail("incident registration requires a child session")
    return str(row[0])


def command_incident_register(args):
    if (not OPAQUE_ID.fullmatch(args.session_id) or not OPAQUE_ID.fullmatch(args.message_id)
            or args.kind not in INCIDENT_KINDS or not args.title.startswith("INCIDENT: ")
            or not 11 <= len(args.title) <= 128 or not 1 <= len(args.summary) <= 1024
            or len(args.signal_id) > 20 or len(args.diagnostic) > 20 or len(args.evidence) > 20
            or len(args.signal_id) + len(args.evidence) > 20
            or not all(re.fullmatch(r"[0-9a-f]{24}", value) for value in args.signal_id)):
        fail("invalid incident registration")
    parent_id = incident_session_parent(args.database, args.session_id, args.message_id)
    scan = incident_scan_data(argparse.Namespace(
        database=args.database, state_root=args.state_root, session_id=args.session_id))
    available = {item["signal_id"]: item for item in scan["signals"]}
    missing = set(args.signal_id) - set(available)
    if missing:
        fail("incident signal is outside the incident family or already disposed")
    diagnostics = [incident_redact(value) for value in args.diagnostic]
    evidence = [incident_redact(value) for value in args.evidence]
    evidence.extend(incident_redact(f'{available[value]["tool"]}: {available[value]["evidence"]}')
                    for value in args.signal_id)
    if any(not value for value in diagnostics + evidence):
        fail("invalid incident evidence")
    title, summary = incident_redact(args.title, 128), incident_redact(args.summary, 1024)
    if not title.startswith("INCIDENT: ") or not summary:
        fail("invalid incident registration")
    incident_id = hashlib.sha256(f"incident\0{args.session_id}".encode()).hexdigest()[:24]
    timestamp = int(datetime.now(timezone.utc).timestamp() * 1000)
    root = review_root(args.state_root)
    require_review_lock_safe(root)
    with review_lock(root) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        connection = ensure_ledger_for_write(root)
        try:
            connection.execute("BEGIN IMMEDIATE")
            if connection.execute("SELECT 1 FROM incidents WHERE session_id=?", (args.session_id,)).fetchone():
                fail("incident fork is already registered")
            connection.execute(
                "INSERT INTO incidents VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?)",
                (incident_id, args.session_id, parent_id, args.message_id, args.kind, title, summary,
                 "open", None, ledger_payload(diagnostics), ledger_payload(evidence), timestamp, timestamp),
            )
            connection.executemany(
                "INSERT INTO incident_signal_dispositions VALUES (?,?,'promoted',?)",
                ((value, incident_id, timestamp) for value in args.signal_id),
            )
            connection.commit()
        except Exception:
            connection.rollback()
            raise
        finally:
            connection.close()
    item = {"incident_id": incident_id, "session_id": args.session_id,
            "parent_session_id": parent_id, "message_id": args.message_id, "kind": args.kind,
            "title": title, "summary": summary, "state": "open", "cycle_id": None,
            "diagnostics": diagnostics, "evidence": evidence, "created_at": timestamp,
            "updated_at": timestamp, "signal_ids": args.signal_id}
    print(json.dumps({"incident": item}, sort_keys=True, separators=(",", ":"), ensure_ascii=True))


def validate_incident_cycle_record(repository, record, cycle_id):
    required = {
        "schema_version", "method_revision", "cycle_id", "context", "risk", "delivery_intent",
        "created_at", "state", "worktree", "source", "git", "delivery", "engineering_profile",
        "applicability_plan", "gates", "evidence", "artifact_reviews", "commits", "metrics", "runtime",
    }
    if (not isinstance(record, dict) or not required.issubset(record)
            or record.get("schema_version") != 4
            or record.get("cycle_id") != cycle_id
            or not OPAQUE_ID.fullmatch(str(record.get("method_revision", "")))
            or not OPAQUE_ID.fullmatch(str(record.get("context", "")))
            or record.get("risk") not in ("routine", "elevated", "critical")
            or record.get("delivery_intent") not in DELIVERY_INTENTS
            or record.get("state") not in ("active", "blocked", "abandoned", "completed")
            or not all(isinstance(record.get(name), dict) for name in (
                "worktree", "source", "git", "delivery", "engineering_profile", "applicability_plan",
                "evidence", "artifact_reviews", "metrics", "runtime"))
            or not isinstance(record.get("commits"), list)):
        fail("incident fix Cycle Record is invalid")
    try:
        created = datetime.fromisoformat(record["created_at"].replace("Z", "+00:00"))
    except (AttributeError, ValueError):
        fail("incident fix Cycle Record is invalid")
    if created.utcoffset() != timedelta(0):
        fail("incident fix Cycle Record is invalid")
    worktree = record["worktree"]
    source = record["source"]
    git_record = record["git"]
    profile = record["engineering_profile"]
    metrics = record["metrics"]
    if (not re.fullmatch(r"[0-9a-f]{16}", str(worktree.get("id", "")))
            or not re.fullmatch(r"[0-9a-f]{40}", str(worktree.get("base_commit", "")))
            or not isinstance(worktree.get("branch"), str)
            or type(worktree.get("created_by_dbsctr")) is not bool
            or not isinstance(worktree.get("locator"), dict)
            or set(worktree["locator"]) != {"root", "path"}
            or not re.fullmatch(r"[0-9a-f]{40}", str(source.get("head", "")))
            or not isinstance(source.get("locator"), dict)
            or not isinstance(source.get("dirty_paths"), list)
            or not re.fullmatch(r"[0-9a-f]{40}", str(git_record.get("head", "")))
            or not isinstance(git_record.get("dirty_paths"), list)
            or not isinstance(git_record.get("pre_cycle_ahead_commits"), list)
            or not isinstance(git_record.get("remote"), dict)
            or not isinstance(profile.get("path"), str)
            or not re.fullmatch(r"[0-9a-f]{40}", str(profile.get("blob", "")))
            or set(metrics) != {"gate_failure_count", "gate_reopen_count", "remediation_round_count"}
            or any(type(value) is not int or value < 0 for value in metrics.values())
            or record["evidence"].get("version") != 1
            or any(not isinstance(commit, dict) or not re.fullmatch(r"[0-9a-f]{40}", str(commit.get("id", "")))
                   or not isinstance(commit.get("gates"), list) or not set(commit["gates"]).issubset(GATES)
                   for commit in record["commits"])):
        fail("incident fix Cycle Record is invalid")
    gates = record.get("gates")
    items = record.get("evidence", {}).get("items")
    plan_gates = record["applicability_plan"].get("gates")
    if (not isinstance(gates, dict) or set(gates) != set(GATES) or not isinstance(items, dict)
            or not isinstance(plan_gates, dict) or set(plan_gates) != set(GATES)
            or record["applicability_plan"].get("profile") != profile["path"]):
        fail("incident fix Cycle Record is invalid")
    for name in GATES:
        gate = gates[name]
        plan_gate = plan_gates[name]
        if (not isinstance(gate, dict) or gate.get("applicability") not in ("required", "not_applicable")
                or not isinstance(plan_gate, dict) or plan_gate.get("applicability") != gate["applicability"]
                or gate.get("result") not in ("pending", "passed", "failed", "unavailable", "not_run")
                or gate["applicability"] == "not_applicable" and gate["result"] != "not_run"
                or gate["applicability"] == "required" and gate["result"] == "not_run"):
            fail("incident fix Cycle Record is invalid")
        if gate["result"] in ("passed", "failed", "unavailable"):
            evidence_id = gate.get("evidence")
            evidence = items.get(evidence_id) if isinstance(evidence_id, str) else None
            if (not isinstance(evidence, dict) or evidence.get("id") != evidence_id
                    or evidence.get("gate") != name or evidence.get("result") != gate["result"]
                    or not isinstance(evidence.get("authority"), str) or not evidence["authority"].strip()
                    or not isinstance(evidence.get("argv"), list)
                    or not all(isinstance(value, str) for value in evidence["argv"])
                    or not isinstance(evidence.get("paths"), dict)
                    or any(not isinstance(path, str) or not path or PurePosixPath(path).is_absolute()
                           or ".." in PurePosixPath(path).parts
                           or not re.fullmatch(r"[0-9a-f]{40}", str(digest))
                           for path, digest in evidence["paths"].items())
                    or evidence.get("head") != record["git"]["head"]
                    or not isinstance(evidence.get("summary"), str)
                    or not isinstance(evidence.get("urls"), list)
                    or not all(isinstance(value, str) for value in evidence["urls"])
                    or not isinstance(evidence.get("raw"), dict)
                    or set(evidence["raw"]) != {"byte_count", "lower_bound", "truncated"}
                    or type(evidence["raw"]["byte_count"]) is not int or evidence["raw"]["byte_count"] < 0
                    or type(evidence["raw"]["lower_bound"]) is not bool
                    or type(evidence["raw"]["truncated"]) is not bool):
                fail("incident fix Cycle Record evidence is invalid")
            try:
                started = datetime.fromisoformat(evidence["started_at"].replace("Z", "+00:00"))
                finished = datetime.fromisoformat(evidence["finished_at"].replace("Z", "+00:00"))
            except (AttributeError, KeyError, ValueError):
                fail("incident fix Cycle Record evidence is invalid")
            if started.utcoffset() != timedelta(0) or finished.utcoffset() != timedelta(0) or finished < started:
                fail("incident fix Cycle Record evidence is invalid")
            verify_envelope(repository, record, name, require_head=False)
        if (record["state"] == "completed" and gate["applicability"] == "required"
                and gate["result"] != "passed"
                and not (gate["result"] in ("failed", "unavailable") and valid_gate_exception(gate))):
            fail("incident completed Cycle Record has an incomplete gate")
    if record["state"] == "completed":
        try:
            completed = datetime.fromisoformat(record["completed_at"].replace("Z", "+00:00"))
        except (AttributeError, KeyError, ValueError):
            fail("incident completed Cycle Record is invalid")
        if completed.utcoffset() != timedelta(0) or completed < created:
            fail("incident completed Cycle Record is invalid")
        if (set(record["artifact_reviews"]) != {"README", "BACKLOG", "CHANGELOG"}
                or any(review.get("result") not in ("changed", "unchanged")
                       for review in record["artifact_reviews"].values())):
            fail("incident completed Cycle Record artifact reviews are invalid")
    return record


def global_cycle_record(cycle_id):
    if not OPAQUE_ID.fullmatch(cycle_id):
        fail("invalid incident cycle ID")
    roots = [root_dir()]
    repositories, failures = global_worktree_roots()
    if failures:
        fail("incident fix cycle registry is incomplete")
    roots.extend(item[1] for item in repositories)
    found, seen = [], set()
    for repository in roots:
        try:
            common = common_git_dir(repository).resolve()
        except RuntimeError:
            continue
        if common in seen:
            continue
        seen.add(common)
        path = common / "dbsctr/cycles" / f"{cycle_id}.json"
        if path.is_file() and not path.is_symlink():
            try:
                record = json.loads(path.read_text(encoding="utf-8"), object_pairs_hook=no_duplicate_keys)
            except (OSError, json.JSONDecodeError) as error:
                fail(f"cannot read incident Cycle Record: {error}")
            found.append(validate_incident_cycle_record(repository, record, cycle_id))
    if len(found) != 1:
        fail("incident fix cycle is missing or ambiguous")
    return found[0]


def command_incident_update(args):
    if (not re.fullmatch(r"[0-9a-f]{24}", args.incident_id)
            or not OPAQUE_ID.fullmatch(args.session_id) or not OPAQUE_ID.fullmatch(args.message_id)):
        fail("invalid incident ID")
    incident_session_parent(args.database, args.session_id, args.message_id)
    root = review_root(args.state_root)
    require_review_lock_safe(root)
    with review_lock(root) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        connection = ensure_ledger_for_write(root)
        try:
            row = connection.execute(
                "SELECT incident_id,session_id,parent_session_id,message_id,kind,title,summary,state,cycle_id,"
                "diagnostics,evidence,created_at,updated_at FROM incidents WHERE incident_id=?",
                (args.incident_id,)).fetchone()
            if row is None:
                fail("incident is missing")
            item = incident_record(row)
            if item["session_id"] != args.session_id:
                fail("incident lifecycle write belongs to another fork")
            transitions = {"open": {"investigating", "dismissed"},
                           "investigating": {"open", "fixing", "dismissed"},
                           "fixing": {"resolved"}, "resolved": set(), "dismissed": set()}
            if args.state != item["state"] and args.state not in transitions[item["state"]]:
                fail("invalid incident state transition")
            cycle_id = item["cycle_id"]
            if args.state == "fixing":
                requested = args.cycle_id or cycle_id
                if requested is None:
                    fail("fixing incident requires one cycle ID")
                if cycle_id is not None and requested != cycle_id:
                    fail("incident fix cycle is immutable")
                global_cycle_record(requested)
                cycle_id = requested
            elif args.cycle_id is not None and args.cycle_id != cycle_id:
                fail("incident fix cycle is immutable")
            if args.state == "resolved":
                if cycle_id is None:
                    fail("incident resolution requires verified activation")
                cycle = global_cycle_record(cycle_id)
                gates = cycle.get("gates", {})
                activation = [gates.get(name) for name in ("deploy", "operate")]
                if (cycle.get("state") != "completed" or any(
                        not isinstance(gate, dict)
                        or gate.get("applicability") not in ("required", "not_applicable")
                        or gate.get("applicability") == "required" and gate.get("result") != "passed"
                        for gate in activation)):
                    fail("incident resolution requires verified activation")
            timestamp = max(int(datetime.now(timezone.utc).timestamp() * 1000), item["updated_at"] + 1)
            connection.execute("BEGIN IMMEDIATE")
            connection.execute("UPDATE incidents SET state=?,cycle_id=?,updated_at=? WHERE incident_id=?",
                               (args.state, cycle_id, timestamp, args.incident_id))
            connection.commit()
            updated = connection.execute(
                "SELECT incident_id,session_id,parent_session_id,message_id,kind,title,summary,state,cycle_id,"
                "diagnostics,evidence,created_at,updated_at FROM incidents WHERE incident_id=?",
                (args.incident_id,)).fetchone()
        except Exception:
            connection.rollback()
            raise
        finally:
            connection.close()
    print(json.dumps({"incident": incident_record(updated)}, sort_keys=True,
                     separators=(",", ":"), ensure_ascii=True))


def command_incident_forget(args):
    if (not re.fullmatch(r"[0-9a-f]{24}", args.incident_id)
            or not OPAQUE_ID.fullmatch(args.session_id) or not OPAQUE_ID.fullmatch(args.message_id)):
        fail("invalid incident ID")
    incident_session_parent(args.database, args.session_id, args.message_id)
    root = review_root(args.state_root)
    require_review_lock_safe(root)
    with review_lock(root) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        connection = ensure_ledger_for_write(root)
        row = connection.execute("SELECT session_id FROM incidents WHERE incident_id=?",
                                 (args.incident_id,)).fetchone()
        if row is None:
            fail("incident is missing")
        if row[0] != args.session_id:
            fail("incident lifecycle write belongs to another fork")
        signal_ids = [item[0] for item in connection.execute(
            "SELECT signal_id FROM incident_signal_dispositions WHERE incident_id=?", (args.incident_id,))]
        timestamp = int(datetime.now(timezone.utc).timestamp() * 1000)
        staged = None
        quarantine_name = f".forget-{uuid.uuid4().hex}"
        try:
            connection.execute("BEGIN IMMEDIATE")
            connection.execute(
                "UPDATE incident_signal_dispositions SET incident_id=NULL,disposition='forgotten',timestamp=? "
                "WHERE incident_id=?", (timestamp, args.incident_id))
            connection.execute("DELETE FROM incidents WHERE incident_id=?", (args.incident_id,))
            record_knowledge_privacy_tombstone(connection, "incident", args.incident_id, "forgotten", timestamp)
            for signal_id in signal_ids:
                record_knowledge_privacy_tombstone(
                    connection, "incident_signal", signal_id, "forgotten", timestamp)
            connection.execute("INSERT INTO ledger_meta VALUES ('pending_forget_cleanup', ?)",
                               (quarantine_name,))
            staged = stage_pre_forget_state(root, quarantine_name)
            connection.commit()
        except Exception:
            connection.rollback()
            if staged is not None:
                restore_staged_forget(*staged)
            connection.close()
            raise
        recover_forget_state(root, connection)
        connection.close()
    print(json.dumps({"forgotten": True}, sort_keys=True, separators=(",", ":")))


def history_telemetry(candidate, metrics):
    families = metrics.get("model_families", "unavailable")
    if isinstance(families, list):
        families = sorted({value for value in families if value != "unavailable"}) or "unavailable"
    errors = {}
    for source, name in (("provider_error_count", "provider_error"), ("tool_error_count", "tool_error")):
        value = metrics.get(source, "unavailable")
        if type(value) is int:
            errors[name] = value
    identities = {}
    for name in ("provider_ids", "model_ids", "agent_ids", "core_revisions", "overlay_revisions"):
        value = metrics.get(name, "unavailable")
        identities[name] = sorted(set(value)) if isinstance(value, list) and value else "unavailable"
    cycle_metrics = candidate["cycles"][0].get("metrics", {}) if len(candidate.get("cycles", [])) == 1 else {}
    availability = {
        "approval_count": "unavailable", "retry_count": "unavailable",
        "delegation_count": "available" if type(metrics.get("delegation_count")) is int else "unavailable",
        "model_families": "available" if isinstance(families, list) else "unavailable",
        "error_classes": "available" if errors else "unavailable",
        "token_total": "available" if type(metrics.get("token_total")) is int else "unavailable",
        "cost_total": "available" if isinstance(metrics.get("cost_total"), (int, float))
                      and not isinstance(metrics.get("cost_total"), bool) else "unavailable",
        **{name: "available" if isinstance(value, list) else "unavailable"
           for name, value in identities.items()},
        "session_relation": "available" if metrics.get("session_relation") in ("primary", "child") else "unavailable",
        **{name: "available" if type(cycle_metrics.get(name)) is int else "unavailable"
           for name in ("gate_failure_count", "gate_reopen_count", "remediation_round_count")},
    }
    return {
        "schema_version": TELEMETRY_SCHEMA,
        "approval_count": "unavailable", "retry_count": "unavailable",
        "delegation_count": metrics.get("delegation_count", "unavailable"),
        "model_families": families, "error_classes": errors or "unavailable",
        "token_total": metrics.get("token_total", "unavailable"),
        "cost_total": metrics.get("cost_total", "unavailable"),
        **identities, "session_relation": metrics.get("session_relation", "unavailable"),
        **{name: cycle_metrics.get(name, "unavailable")
           for name in ("gate_failure_count", "gate_reopen_count", "remediation_round_count")},
        "availability": availability,
        "attribution_status": candidate.get("correlation_quality", "unavailable"),
    }


def validate_stored_harness_activation(value):
    if (not isinstance(value, dict) or set(value) != {"schema_version", "provider_id", "model_id", "agent_id",
                                                      "core_revision", "overlay_revision"}
            or value.get("schema_version") != HARNESS_ACTIVATION_SCHEMA
            or not all(isinstance(value.get(name), str) for name in (
                "provider_id", "model_id", "agent_id", "core_revision", "overlay_revision"))
            or not OPAQUE_ID.fullmatch(value["provider_id"])
            or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}", value["model_id"])
            or not all(OPAQUE_ID.fullmatch(value[name]) for name in (
                "agent_id", "core_revision", "overlay_revision"))):
        fail("invalid harness activation")
    return value


def validate_cycle_metrics(value):
    fields = {"elapsed_ms", "gate_failure_count", "gate_reopen_count", "remediation_round_count"}
    if (not isinstance(value, dict) or set(value) != fields
            or value["elapsed_ms"] != "unavailable" and (type(value["elapsed_ms"]) is not int or value["elapsed_ms"] < 0)
            or any(type(value[name]) is not int or value[name] < 0 for name in fields - {"elapsed_ms"})):
        fail("invalid cycle metrics")
    return value


def validate_history_telemetry(value):
    legacy_fields = {"approval_count", "retry_count", "delegation_count", "model_families", "error_classes",
                     "token_total", "cost_total", "availability", "attribution_status"}
    identity_fields = {"provider_ids", "model_ids", "agent_ids", "core_revisions", "overlay_revisions"}
    counter_fields = {"gate_failure_count", "gate_reopen_count", "remediation_round_count"}
    fields = legacy_fields | identity_fields | counter_fields | {"schema_version", "session_relation"}
    current = isinstance(value, dict) and set(value) == fields
    if isinstance(value, dict) and set(value) == legacy_fields:
        fields = legacy_fields
    availability_fields = fields - {"availability", "attribution_status", "schema_version"}
    statuses = {"exact", "family", "worktree", "source", "ambiguous", "unavailable"}
    if (not isinstance(value, dict) or set(value) != fields
            or current and value.get("schema_version") != TELEMETRY_SCHEMA
            or value["approval_count"] != "unavailable" or value["retry_count"] != "unavailable"
            or (value["delegation_count"] != "unavailable"
                and (type(value["delegation_count"]) is not int or value["delegation_count"] < 0))
            or not isinstance(value["availability"], dict) or set(value["availability"]) != availability_fields
            or any(item not in ("available", "unavailable") for item in value["availability"].values())
            or value["attribution_status"] not in statuses):
        fail("review history telemetry has an invalid schema")
    if current:
        if (value["session_relation"] not in ("primary", "child", "unavailable")
                or any(value[name] != "unavailable" and (not isinstance(value[name], list) or not value[name]
                    or value[name] != sorted(set(value[name])) or any(not isinstance(item, str)
                    or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}", item) for item in value[name]))
                       for name in identity_fields)
                or any(value[name] != "unavailable" and (type(value[name]) is not int or value[name] < 0)
                       for name in counter_fields)):
            fail("review history telemetry has an invalid schema")
    families = value["model_families"]
    if families != "unavailable" and (not isinstance(families, list) or not families
            or families != sorted(set(families)) or any(item not in {"gpt", "claude", "gemini", "llama", "mistral", "qwen"} for item in families)):
        fail("review history telemetry has an invalid schema")
    errors = value["error_classes"]
    if errors != "unavailable" and (not isinstance(errors, dict) or set(errors) - {"provider_error", "tool_error"}
            or not errors or any(type(item) is not int or item < 0 for item in errors.values())):
        fail("review history telemetry has an invalid schema")
    for name in ("token_total", "cost_total"):
        item = value[name]
        if item != "unavailable" and (not isinstance(item, (int, float)) or isinstance(item, bool)
                or not math.isfinite(item) or item < 0):
            fail("review history telemetry has an invalid schema")
    return value


def validate_history_evidence(value):
    allowed = {"schema_version", "session_id", "completed_at", "method_revision", "context",
               "project_digest", "cycles", "aggregates", "snapshot", "session_ceiling",
               "part_ceiling", "database_digest", "reviewed_status", "correlation_quality", "telemetry",
               "review_session"}
    if (not isinstance(value, dict) or set(value) - allowed or value.get("schema_version") != 1
            or not isinstance(value.get("completed_at"), str) or not value["completed_at"].isdigit()
            or int(value["completed_at"]) < REVIEW_START_MS
            or not isinstance(value.get("method_revision"), str) or (value["method_revision"] != "unavailable" and not re.fullmatch(r"3\.\d+", value["method_revision"]))
            or not isinstance(value.get("context"), str) or (value["context"] != "unavailable" and not OPAQUE_ID.fullmatch(value["context"]))
            or not isinstance(value.get("project_digest"), str)
            or value.get("reviewed_status", "reviewed") not in ("reviewed", "unreviewed")
            or type(value.get("review_session", False)) is not bool
            or value.get("correlation_quality", "unavailable") not in (
                "exact", "family", "worktree", "source", "ambiguous", "unavailable")):
        fail("review history evidence has an invalid schema")
    history_id(value.get("session_id"), "history session ID")
    if value["project_digest"] != "unavailable":
        history_digest(value["project_digest"], "project digest")
    if not isinstance(value.get("cycles"), list) or len(value["cycles"]) > REVIEW_MAX_LIMIT:
        fail("review history evidence has an invalid schema")
    for cycle in value["cycles"]:
        interval_fields = {"context", "started_at", "ended_at"}
        has_interval = isinstance(cycle, dict) and interval_fields <= set(cycle)
        if (not isinstance(cycle, dict) or set(cycle) - {"cycle_id", "state", "risk", "delivery_intent",
                                                         "phase_profile", "metrics", "harness_activation",
                                                         *interval_fields}
                or not {"cycle_id", "state"} <= set(cycle)
                or cycle["state"] not in ("active", "blocked", "abandoned", "completed", "unknown")
                or "risk" in cycle and cycle["risk"] not in ("routine", "elevated", "critical", "unavailable")
                or "delivery_intent" in cycle and cycle["delivery_intent"] not in (*DELIVERY_INTENTS, "unavailable")
                or bool(interval_fields.intersection(cycle)) != has_interval
                or has_interval and (not isinstance(cycle["context"], str)
                    or not OPAQUE_ID.fullmatch(cycle["context"])
                    or type(cycle["started_at"]) is not int or cycle["started_at"] < REVIEW_START_MS
                    or cycle["ended_at"] is not None and (type(cycle["ended_at"]) is not int
                        or cycle["ended_at"] < cycle["started_at"]))):
            fail("review history evidence has an invalid schema")
        history_id(cycle.get("cycle_id"), "history cycle ID")
        if "metrics" in cycle:
            validate_cycle_metrics(cycle["metrics"])
        if "harness_activation" in cycle:
            validate_stored_harness_activation(cycle["harness_activation"])
        if "phase_profile" in cycle:
            validate_phase_profile(cycle["phase_profile"], cycle["cycle_id"])
    aggregate_names = {"candidate_count", "cycle_count", "child_count", "elapsed_ms", "tool_count", "tool_call_count",
                       "tool_error_count", "approval_count", "retry_count", "cost_total", "token_total",
                       "cycle_active_count", "cycle_blocked_count", "cycle_abandoned_count", "cycle_completed_count", "cycle_unknown_count"}
    if not isinstance(value.get("aggregates"), dict) or set(value["aggregates"]) - aggregate_names:
        fail("review history evidence has an invalid schema")
    if not all(((isinstance(item, (int, float)) and not isinstance(item, bool)
                  and math.isfinite(item) and 0 <= item <= 2**63 - 1) or item == "unavailable")
               for item in value["aggregates"].values()):
        fail("review history evidence has an invalid schema")
    for name in ("snapshot", "session_ceiling", "part_ceiling"):
        if name in value and (type(value[name]) is not int or value[name] < 0):
            fail("review history evidence has an invalid schema")
    if "database_digest" in value:
        history_digest(value["database_digest"], "database digest")
    if "telemetry" in value:
        validate_history_telemetry(value["telemetry"])
    return {**value, "correlation_quality": value.get("correlation_quality", "unavailable")}


def read_history_evidence(path, root=None):
    try:
        if root is not None:
            private_legacy_file(root, path)
        value = json.loads(path.read_text(encoding="utf-8"), object_pairs_hook=no_duplicate_keys)
    except (OSError, json.JSONDecodeError) as error:
        fail(f"cannot read review history evidence: {error}")
    return validate_history_evidence(value)


def history_evidence(root):
    if ledger_exists(root):
        records = {}
        with ledger_connection(root) as connection:
            for payload, in connection.execute("SELECT payload FROM history_evidence ORDER BY session_id"):
                record = validate_history_evidence(json.loads(payload, object_pairs_hook=no_duplicate_keys))
                records[record["session_id"]] = record
            for payload, in connection.execute("SELECT payload FROM history_reports WHERE kind='report' ORDER BY report_id"):
                for record in validate_history_report(json.loads(payload, object_pairs_hook=no_duplicate_keys))["evidence"]:
                    records.setdefault(record["session_id"], record)
        return list(records.values())
    directory = history_dir(root)
    records = {}
    if directory.is_dir():
        for path in sorted(directory.glob("*.json")):
            record = read_history_evidence(path, root)
            if path.name != f"{record['session_id']}.json":
                fail("review history evidence marker does not match its content")
            records[record["session_id"]] = record
    reports = history_dir(root, "reports")
    if reports.is_dir():
        for path in sorted(reports.glob("*.json")):
            for record in history_report(path, root)["evidence"]:
                records.setdefault(record["session_id"], record)
    return list(records.values())


def archive_review_candidates(root, scan, mark_reviewed=True, connection=None):
    if connection is not None:
        for candidate in scan["candidates"]:
            ledger_put_history_evidence(connection, candidate_history_evidence(candidate, scan, mark_reviewed))
        return
    directory = history_dir(root, create=True)
    for candidate in scan["candidates"]:
        evidence = candidate_history_evidence(candidate, scan, mark_reviewed)
        private_json(directory / f"{evidence['session_id']}.json", evidence)


def candidate_history_evidence(candidate, scan, mark_reviewed=True):
    session_id = history_id(candidate["session_id"], "history session ID")
    cycles = candidate["cycles"]
    identity = candidate.get("_history_identity") or history_identity(cycles)
    evidence = {
        "schema_version": 1, "session_id": session_id,
        "completed_at": str(candidate["last_activity"]), **identity, "cycles": cycles,
        "correlation_quality": candidate.get("correlation_quality", "unavailable"),
        "aggregates": history_aggregates(candidate), "snapshot": scan["snapshot"],
        "session_ceiling": scan["session_ceiling"], "part_ceiling": scan["part_ceiling"],
        "database_digest": scan["database_digest"],
        "reviewed_status": "reviewed" if mark_reviewed else candidate.get("reviewed_status", "unreviewed"),
    }
    if "review_session" in candidate:
        evidence["review_session"] = candidate["review_session"]
    if "telemetry" in candidate:
        evidence["telemetry"] = candidate["telemetry"]
    return validate_history_evidence(evidence)


def history_aggregates(candidate):
    states = [item["state"] for item in candidate["cycles"]]
    created, activity = candidate.get("timestamp"), candidate.get("last_activity")
    elapsed = int(activity) - int(created) if str(created).isdigit() and str(activity).isdigit() else "unavailable"
    structural = candidate.get("_history_metrics") if isinstance(candidate.get("_history_metrics"), dict) else {}
    return {"candidate_count": 1, "cycle_count": len(states), "child_count": len(candidate.get("child_session_ids", [])),
            "elapsed_ms": elapsed if isinstance(elapsed, int) and elapsed >= 0 else "unavailable",
            "tool_count": structural.get("tool_count", "unavailable"),
            "tool_call_count": structural.get("tool_call_count", "unavailable"),
            "tool_error_count": structural.get("tool_error_count", "unavailable"),
            "approval_count": "unavailable", "retry_count": "unavailable",
            "cost_total": structural.get("cost_total", "unavailable"),
            "token_total": structural.get("token_total", "unavailable"),
            **{f"cycle_{state}_count": states.count(state) for state in ("active", "blocked", "abandoned", "completed", "unknown")}}


def history_capture_aggregates(records):
    names = ("candidate_count", "cycle_count", "child_count", "elapsed_ms", "tool_count",
             "tool_call_count", "tool_error_count", "approval_count", "retry_count", "cost_total",
             "token_total", "cycle_active_count", "cycle_blocked_count", "cycle_abandoned_count",
             "cycle_completed_count", "cycle_unknown_count")
    result = {}
    for name in names:
        values = [record["aggregates"].get(name, "unavailable") for record in records]
        result[name] = (sum(values) if values and all(isinstance(value, (int, float)) and not isinstance(value, bool)
                                                      for value in values) else "unavailable")
    return result


def history_capture_query(args):
    return {name: getattr(args, name, None) for name in (
        "after", "before", "method_revision", "cycle_id", "state", "context", "project_digest",
        "reviewed_status", "archive_only",
    )}


def validate_history_capture(value, members):
    allowed = {"schema_version", "capture_id", "query", "snapshot", "session_ceiling", "part_ceiling",
               "database_digest", "exclusion_digest", "page_size", "pages", "member_count",
               "members_digest", "aggregates"}
    transient = {"kind", "created_at"}
    if (not isinstance(value, dict) or set(value) not in (allowed, allowed | transient)
            or value.get("schema_version") != 1
            or not isinstance(value.get("query"), dict)
            or set(value["query"]) != {"after", "before", "method_revision", "cycle_id", "state", "context",
                                       "project_digest", "reviewed_status", "archive_only"}
            or type(value["query"]["archive_only"]) is not bool
            or type(value.get("page_size")) is not int or not 1 <= value["page_size"] <= REVIEW_MAX_LIMIT
            or type(value.get("member_count")) is not int or value["member_count"] < 0
            or not isinstance(value.get("pages"), list)
            or bool(value["pages"]) != bool(value["member_count"])
            or not isinstance(value.get("aggregates"), dict)):
        fail("private history capture has an invalid schema")
    if transient.issubset(value) and (value["kind"] != "federated" or type(value["created_at"]) is not int
                                      or value["created_at"] < REVIEW_START_MS):
        fail("private history capture has an invalid retention identity")
    for name in ("snapshot", "session_ceiling", "part_ceiling"):
        if type(value.get(name)) is not int or value[name] < 0:
            fail("private history capture has an invalid snapshot")
    history_digest(value.get("database_digest"), "database digest")
    if value.get("exclusion_digest") is not None:
        history_digest(value["exclusion_digest"], "exclusion digest")
    history_digest(value.get("members_digest"), "capture members digest")
    for name in ("method_revision", "cycle_id", "state", "context", "reviewed_status"):
        item = value["query"][name]
        if item is not None and (not isinstance(item, str) or not OPAQUE_ID.fullmatch(item)):
            fail("private history capture has an invalid query")
    for name in ("after", "before"):
        item = value["query"][name]
        if item is not None and (type(item) is not int or item < REVIEW_START_MS):
            fail("private history capture has an invalid query")
    project_digest = value["query"]["project_digest"]
    if project_digest is not None:
        history_digest(project_digest, "project digest")
    if value["query"]["state"] not in (None, "active", "blocked", "abandoned", "completed", "unknown"):
        fail("private history capture has an invalid query")
    if value["query"]["reviewed_status"] not in (None, "reviewed", "unreviewed"):
        fail("private history capture has an invalid query")
    expected_cursor = 0
    total = 0
    for position, page in enumerate(value["pages"]):
        if (not isinstance(page, dict) or set(page) != {"cursor", "limit", "count", "continuation", "digest"}
                or type(page.get("cursor")) is not int or page["cursor"] != expected_cursor
                or page.get("limit") != value["page_size"] or type(page.get("count")) is not int
                or not 1 <= page["count"] <= page["limit"]):
            fail("private history capture page coverage is invalid")
        history_digest(page.get("digest"), "capture page digest")
        if position < len(value["pages"]) - 1 and page["count"] != value["page_size"]:
            fail("private history capture page coverage is invalid")
        expected_continuation = expected_cursor + value["page_size"] if position < len(value["pages"]) - 1 else None
        if page.get("continuation") != expected_continuation:
            fail("private history capture page coverage is invalid")
        expected_cursor += value["page_size"]
        total += page["count"]
    records = [validate_history_evidence(record) for record in members]
    ids = [record["session_id"] for record in records]
    if total != value["member_count"] or len(records) != value["member_count"] or len(set(ids)) != len(ids):
        fail("private history capture membership mismatch")
    aggregate = history_capture_aggregates(records)
    if aggregate != value["aggregates"]:
        fail("private history capture aggregate projection mismatch")
    if hashlib.sha256(ledger_payload(records).encode()).hexdigest() != value["members_digest"]:
        fail("private history capture members digest mismatch")
    identity = {key: value[key] for key in value if key != "capture_id"}
    expected_id = hashlib.sha256(ledger_payload(identity).encode()).hexdigest()[:24]
    if value.get("capture_id") != expected_id:
        fail("private history capture identity mismatch")
    return value, records


def history_capture_summary(value):
    return {"schema_version": 1, "capture_id": value["capture_id"], "query": value["query"],
            "snapshot": value["snapshot"], "page_size": value["page_size"],
            "page_count": len(value["pages"]), "member_count": value["member_count"],
            "aggregates": value["aggregates"]}


def history_lens_summary(manifest, members, lens, scope, excluded_family=(), exclusion_digest=None):
    if any("review_session" not in member for member in members):
        fail("history capture review-session attribution is unavailable")
    members = [member for member in members if member["session_id"] not in excluded_family]
    selected = [member for member in members if member["review_session"] == (scope == "only")]
    aggregate_names = sorted(BENCHMARK_METRICS)
    telemetry_names = ("delegation_count", "gate_failure_count", "gate_reopen_count",
                       "remediation_round_count", "provider_error_count")

    def metrics(member):
        values = {name: member["aggregates"].get(name, "unavailable") for name in aggregate_names}
        telemetry = member.get("telemetry", {})
        for name in telemetry_names[:-1]:
            values[name] = telemetry.get(name, "unavailable")
        errors = telemetry.get("error_classes", {})
        values["provider_error_count"] = errors.get("provider_error", "unavailable") if isinstance(errors, dict) else "unavailable"
        return values

    metric_rows = [(member, metrics(member)) for member in selected]
    metric_summaries = {}
    for name in (*aggregate_names, *telemetry_names):
        values = [row[name] for _, row in metric_rows
                  if isinstance(row[name], (int, float)) and not isinstance(row[name], bool)]
        metric_summaries[name] = {
            "available_count": len(values), "unavailable_count": len(selected) - len(values),
            "total": sum(values) if values else "unavailable",
            "minimum": min(values) if values else "unavailable",
            "maximum": max(values) if values else "unavailable",
        }

    def counts(values):
        return {value: values.count(value) for value in sorted(set(values))}

    cycles = [cycle for member in selected for cycle in member["cycles"]]
    categories = {
        "cycle_state": counts([cycle["state"] for cycle in cycles]),
        "risk": counts([cycle.get("risk", "unavailable") for cycle in cycles]),
        "delivery_intent": counts([cycle.get("delivery_intent", "unavailable") for cycle in cycles]),
        "correlation_quality": counts([member["correlation_quality"] for member in selected]),
        "reviewed_status": counts([member["reviewed_status"] for member in selected]),
        "session_relation": counts([member.get("telemetry", {}).get("session_relation", "unavailable")
                                    for member in selected]),
    }

    def score(member, values):
        states = [cycle["state"] for cycle in member["cycles"]]
        risks = [cycle.get("risk", "unavailable") for cycle in member["cycles"]]
        cycle_metrics = [cycle.get("metrics", {}) for cycle in member["cycles"]]
        phase_profiles = [cycle.get("phase_profile", {}) for cycle in member["cycles"]]
        number = lambda name: values.get(name) if isinstance(values.get(name), (int, float)) else 0
        gates = sum(metric.get("gate_failure_count", 0) for metric in cycle_metrics)
        reopens = sum(metric.get("gate_reopen_count", 0) for metric in cycle_metrics)
        remediation = sum(metric.get("remediation_round_count", 0) for metric in cycle_metrics)
        repeated = sum(profile.get("repeated_work", 0) for profile in phase_profiles if isinstance(profile, dict))
        common = (risks.count("critical"), states.count("blocked"), states.count("abandoned"))
        if lens == "correctness_safety":
            return (*common, gates, reopens, number("tool_error_count"), number("provider_error_count"))
        if lens == "reliability_recovery":
            return (states.count("blocked"), states.count("abandoned"), number("provider_error_count"),
                    number("tool_error_count"), reopens, remediation)
        if lens == "performance_cost":
            return (number("cost_total"), number("token_total"), number("elapsed_ms"), number("tool_call_count"))
        if lens == "operator_experience":
            return (states.count("blocked"), number("approval_count"), number("retry_count"),
                    number("tool_error_count"), number("elapsed_ms"))
        if lens == "architecture_rnd_meta":
            return (repeated, number("child_count"), number("delegation_count"), remediation,
                    number("tool_count"))
        return (reopens, remediation, number("retry_count"), number("tool_error_count"), repeated)

    def projection(member, values, signal_score):
        cycle_rank = {"blocked": 4, "abandoned": 3, "active": 2, "unknown": 1, "completed": 0}
        projected_cycles = sorted(member["cycles"], key=lambda cycle: (
            cycle_rank.get(cycle["state"], 0), cycle.get("risk", ""), cycle["cycle_id"]), reverse=True)[:3]
        return {
            "session_id": member["session_id"], "context": member["context"],
            "completed_at": member["completed_at"], "correlation_quality": member["correlation_quality"],
            "cycles": [{name: cycle[name] for name in ("cycle_id", "state", "risk", "delivery_intent")
                        if name in cycle} | ({"metrics": cycle["metrics"]} if "metrics" in cycle else {})
                       for cycle in projected_cycles],
            "metrics": values, "signal_score": list(signal_score),
        }

    ranked = sorted(((score(member, values), member, values) for member, values in metric_rows),
                    key=lambda item: (item[0], int(item[1]["completed_at"]), item[1]["session_id"]),
                    reverse=True)
    review_count = sum(member["review_session"] for member in selected)
    return {
        "schema_version": 1, "capture_id": manifest["capture_id"], "lens": lens, "scope": scope,
        "snapshot": manifest["snapshot"], "session_ceiling": manifest["session_ceiling"],
        "part_ceiling": manifest["part_ceiling"], "database_digest": manifest["database_digest"],
        "exclusion_digest": exclusion_digest or manifest["exclusion_digest"], "query": manifest["query"],
        "member_count": len(selected),
        "members_digest": hashlib.sha256(ledger_payload(selected).encode()).hexdigest(),
        "telemetry": {"page_count": max(1, len(manifest["pages"])), "session_count": len(selected),
                      "review_session_count": review_count,
                      "excluded_review_session_count": (len(members) - len(selected)) if scope == "exclude" else 0,
                      "unattributed_session_count": 0},
        "categories": categories, "metrics": metric_summaries,
        "evidence": [projection(member, values, signal_score)
                     for signal_score, member, values in ranked[:20]],
    }


def history_page_digest(records, source_identities, limit, cursor):
    identity = hashlib.sha256()
    identity.update(f"{limit}\0{cursor}\0".encode())
    for record in records:
        session_id = record["session_id"]
        identity.update(session_id.encode() + b"\0")
        source = source_identities.get(session_id)
        identity.update(bytes.fromhex(source) if source else hashlib.sha256(
            json.dumps(record, sort_keys=True, separators=(",", ":")).encode()).digest())
    return identity.hexdigest()


def history_identity(cycles, session_directory=None, session_ids=(), project_digest="unavailable", cache=None):
    """Use only unambiguous Cycle Record structure; never session prose or paths."""
    cache_key = (str(session_directory or ""), tuple(item["cycle_id"] for item in cycles))
    if cache is not None and cache_key in cache:
        return {**cache[cache_key], "project_digest": project_digest}
    directories = []
    worktree = Path(session_directory) if session_directory else None
    if worktree and worktree.is_dir():
        result = git(worktree, "rev-parse", "--git-common-dir", check=False)
        if not result.returncode:
            directory = Path(result.stdout.strip())
            directories.append((directory if directory.is_absolute() else worktree / directory).resolve() / "dbsctr/cycles")
    try:
        current = common_git_dir(root_dir()).resolve() / "dbsctr/cycles"
        if current not in directories:
            directories.append(current)
    except RuntimeError:
        pass
    wanted = {item["cycle_id"] for item in cycles}
    records = []
    paths = sorted({path for directory in directories if directory.is_dir() for path in directory.glob("*.json")})
    for path in paths:
        try:
            value = json.loads(path.read_text(encoding="utf-8"), object_pairs_hook=no_duplicate_keys)
            runtime_ids = value.get("runtime", {}).get("opencode", {}).get("session_ids", [])
            if value.get("cycle_id") in wanted or set(session_ids).intersection(runtime_ids):
                records.append(value)
        except (OSError, json.JSONDecodeError):
            continue
    def same(name, valid):
        values = {item.get(name) for item in records if valid(item.get(name))}
        return values.pop() if len(values) == 1 and len(records) == len(wanted) else "unavailable"
    result = {"method_revision": same("method_revision", lambda value: isinstance(value, str) and re.fullmatch(r"3\.\d+", value)),
              "context": same("context", lambda value: isinstance(value, str) and OPAQUE_ID.fullmatch(value))}
    if cache is not None:
        cache[cache_key] = result
    return {**result, "project_digest": project_digest}


def validate_history_report(value, path=None):
    text_fields = {"findings", "scorecards", "trends", "proposals", "caveats"}
    allowed = {"schema_version", "report_id", "cohort", "evidence", "query_digest", "rubric", *text_fields}
    rubric = value.get("rubric") if isinstance(value, dict) else None
    if (not isinstance(value, dict) or set(value) - allowed or not {"schema_version", "report_id", "cohort", "evidence", "query_digest", "rubric", "findings"} <= set(value) or value.get("schema_version") != 1
            or not isinstance(value.get("report_id"), str) or not isinstance(value.get("cohort"), list)
            or not isinstance(value.get("evidence"), list) or len(value["cohort"]) != len(value["evidence"])
            or len(value["cohort"]) < 1 or len(value["cohort"]) > REVIEW_MAX_LIMIT
            or not isinstance(rubric, dict) or set(rubric) != {"name", "version", "digest"}
            or not all(isinstance(rubric.get(name), str) and rubric[name] for name in ("name", "version"))
            or any(not isinstance(value.get(name, []), list) or len(value.get(name, [])) > 50
                   for name in text_fields)):
        fail("review history report has an invalid schema")
    history_digest(value.get("query_digest"), "query digest")
    history_digest(rubric.get("digest"), "rubric digest")
    def valid_text(item, limit):
        return isinstance(item, str) and 1 <= len(item.encode()) <= limit and not any(ord(char) < 32 or ord(char) == 127 for char in item)
    if not valid_text(rubric["name"], 256) or not valid_text(rubric["version"], 256) or not all(
            valid_text(item, 512) for name in text_fields for item in value.get(name, [])):
        fail("review history report has an invalid schema")
    if review_unsafe(" ".join([rubric["name"], rubric["version"], *(item for name in text_fields for item in value.get(name, []))])):
        fail("review history report contains unsafe content")
    expected = hashlib.sha256(json.dumps({key: value[key] for key in value if key != "report_id"}, sort_keys=True,
                                         separators=(",", ":")).encode()).hexdigest()[:24]
    if value["report_id"] != expected or path is not None and path.name != f"{expected}.json":
        fail("review history report marker does not match its content")
    ids = [history_id(item, "history cohort ID") for item in value["cohort"]]
    if len(set(ids)) != len(ids):
        fail("review history report has duplicate cohort IDs")
    records = [validate_history_evidence(item) for item in value["evidence"]]
    if [item["session_id"] for item in records] != ids:
        fail("review history report evidence does not match its cohort")
    return value


def history_report(path, root=None):
    try:
        if root is not None:
            private_legacy_file(root, path)
        value = json.loads(path.read_text(encoding="utf-8"), object_pairs_hook=no_duplicate_keys)
    except (OSError, json.JSONDecodeError) as error:
        fail(f"invalid review history report: {error}")
    return validate_history_report(value, path)


def history_reports(root):
    if ledger_exists(root):
        with ledger_connection(root) as connection:
            return [validate_history_report(json.loads(payload, object_pairs_hook=no_duplicate_keys))
                    for payload, in connection.execute(
                        "SELECT payload FROM history_reports WHERE kind='report' ORDER BY report_id")]
    directory = history_dir(root, "reports")
    if not directory.is_dir():
        return []
    return [history_report(path, root) for path in sorted(directory.glob("*.json"))]


def history_cohorts(root):
    if ledger_exists(root):
        with ledger_connection(root) as connection:
            return [validate_history_report(json.loads(payload, object_pairs_hook=no_duplicate_keys))
                    for payload, in connection.execute(
                        "SELECT payload FROM history_reports WHERE kind='cohort' ORDER BY report_id")]
    directory = history_dir(root, "cohorts")
    if not directory.is_dir():
        return []
    return [history_report(path, root) for path in sorted(directory.glob("*.json"))]


def validate_history_report_input(value):
    text_fields = ("findings", "scorecards", "trends", "proposals", "caveats")
    scan_fields = ("snapshot", "session_ceiling", "part_ceiling", "database_digest")
    page_fields = ("limit", "cursor")
    allowed = {"schema_version", "cohort", "query_digest", "rubric", *text_fields, *scan_fields, *page_fields}
    if (not isinstance(value, dict) or set(value) - allowed
            or not {"schema_version", "cohort", "query_digest", "rubric", "findings"} <= set(value)
            or value.get("schema_version") != 1):
        fail("review history report has an invalid schema")
    cohort = value["cohort"]
    if not isinstance(cohort, list) or not 1 <= len(cohort) <= REVIEW_MAX_LIMIT:
        fail("review history report has an invalid cohort")
    ids = [history_id(item, "history cohort ID") for item in cohort]
    if len(set(ids)) != len(ids):
        fail("review history report has duplicate cohort IDs")
    history_digest(value.get("query_digest"), "query digest")
    rubric = value.get("rubric")
    if not isinstance(rubric, dict) or set(rubric) != {"name", "version", "digest"}:
        fail("review history report has an invalid schema")
    history_digest(rubric.get("digest"), "rubric digest")
    def valid_text(item, limit):
        return (isinstance(item, str) and 1 <= len(item.encode()) <= limit
                and not any(ord(char) < 32 or ord(char) == 127 for char in item))
    if not valid_text(rubric.get("name"), 256) or not valid_text(rubric.get("version"), 256):
        fail("review history report has an invalid schema")
    for name in text_fields:
        items = value.get(name, [])
        if (not isinstance(items, list) or len(items) > 50
                or not all(valid_text(item, 512) for item in items)):
            fail("review history report has an invalid schema")
    if review_unsafe(" ".join([rubric["name"], rubric["version"],
                               *(item for name in text_fields for item in value.get(name, []))])):
        fail("review history report contains unsafe content")
    present_scan = {name for name in scan_fields if name in value}
    if present_scan and present_scan != set(scan_fields):
        fail("review history report has incomplete scan identity")
    if present_scan:
        if any(type(value[name]) is not int or value[name] < 0 for name in scan_fields[:3]):
            fail("review history report has invalid scan identity")
        history_digest(value["database_digest"], "database digest")
    present_page = {name for name in page_fields if name in value}
    if present_page and present_page != set(page_fields):
        fail("review history report has incomplete page identity")
    if present_page and not present_scan:
        fail("review history report page identity requires scan identity")
    if present_page and (type(value["limit"]) is not int or not 1 <= value["limit"] <= REVIEW_MAX_LIMIT
                         or type(value["cursor"]) is not int or value["cursor"] < 0):
        fail("review history report has invalid page identity")
    return {**value, **{name: value.get(name, []) for name in text_fields}}


def review_history_page(args, lock_held=False):
    root = review_root(args.state_root)
    excluded_family = historical_excluded_family(args.database, args.excluded_session_id,
                                                 args.excluded_message_id)
    if args.limit < 1 or args.limit > REVIEW_MAX_LIMIT or args.cursor < 0:
        fail("review history limit must be 1 through 100 and cursor non-negative")
    require_review_lock_safe(root)
    with (contextlib.nullcontext() if lock_held else existing_review_lock(root)):
        records = history_evidence(root)
        reports = history_reports(root)
        history_cohorts(root)  # Fail closed on malformed retained replay evidence.
        if args.replay:
            report = next((item for item in reports if item["report_id"] == args.replay), None)
            if report is None:
                fail("review history replay report is missing")
            if set(report["cohort"]).intersection(excluded_family):
                fail("review history replay intersects the excluded session family")
            records = report["evidence"]
        elif not args.archive_only:
            live = review_scan(argparse.Namespace(database=args.database, state_root=args.state_root,
                               limit=REVIEW_MAX_LIMIT, cursor=0, snapshot=args.snapshot,
                               session_ceiling=args.session_ceiling, part_ceiling=args.part_ceiling,
                                database_digest=args.database_digest, lock_held=True,
                                 include_reviewed=True, history_metrics=True, history_all=True, bind_history=True,
                                  excluded_session_id=args.excluded_session_id,
                                  excluded_message_id=args.excluded_message_id,
                                  exclusion_digest=args.exclusion_digest))
            live_candidates = live["candidates"]
            live_records = [{"schema_version": 1, "session_id": item["session_id"],
                            "completed_at": str(item["last_activity"]),
                            **item.get("_history_identity", history_identity(item["cycles"])),
                             "cycles": item["cycles"],
                             "correlation_quality": item.get("correlation_quality", "unavailable"),
                             "aggregates": history_aggregates(item),
                            "snapshot": live["snapshot"], "session_ceiling": live["session_ceiling"],
                            "part_ceiling": live["part_ceiling"], "database_digest": live["database_digest"],
                             "reviewed_status": item["reviewed_status"],
                             "review_session": item.get("review_session", False),
                             **({"telemetry": item["telemetry"]} if "telemetry" in item else {})}
                            for item in live_candidates]
            archived = {item["session_id"]: item for item in records}
            merged_records = []
            for item in live_records:
                retained = archived.get(item["session_id"], {})
                merged = {**retained, **item}
                merged["review_session"] = bool(
                    retained.get("review_session", False) or item.get("review_session", False))
                merged_records.append(merged)
            records = merged_records
            records.extend(item for key, item in archived.items() if key not in {row["session_id"] for row in live_records})
            records = [item for item in records if item["session_id"] not in excluded_family]
        else:
            records = [item for item in records if item["session_id"] not in excluded_family]
        for name, value in (("after", args.after), ("before", args.before)):
            if value is not None and value < REVIEW_START_MS:
                fail(f"review history {name} must be a valid millisecond cutoff")
        if args.after is not None and args.before is not None and args.after > args.before:
            fail("review history after must not exceed before")
        def include(record):
            timestamp = int(record["completed_at"])
            return ((args.after is None or timestamp >= args.after) and (args.before is None or timestamp <= args.before)
                    and (args.method_revision is None or record["method_revision"] == args.method_revision)
                    and (args.context is None or record["context"] == args.context)
                    and (args.project_digest is None or record["project_digest"] == args.project_digest)
                    and (args.reviewed_status is None or record.get("reviewed_status", "reviewed") == args.reviewed_status)
                    and (args.cycle_id is None or any(cycle["cycle_id"] == args.cycle_id for cycle in record["cycles"]))
                    and (args.state is None or any(cycle["state"] == args.state for cycle in record["cycles"])))
        records = sorted((record for record in records if include(record)),
                         key=lambda item: (int(item["completed_at"]), item["session_id"]), reverse=True)
        page = records[args.cursor:args.cursor + args.limit]
        empty_archive = {"snapshot": 0, "session_ceiling": 0, "part_ceiling": 0,
                         "database_digest": hashlib.sha256(b"").hexdigest(), "exclusion_digest": None}
        metadata = ({} if args.replay else live if not args.archive_only else
                    (page[-1] if page else (records[-1] if records else empty_archive)))
        result = {"schema_version": 1, "candidates": page, "session_ids": [item["session_id"] for item in page],
                  "limit": args.limit, "cursor": args.cursor,
                  "continuation": args.cursor + args.limit if len(records) > args.cursor + args.limit else None,
                  "snapshot": metadata.get("snapshot"), "session_ceiling": metadata.get("session_ceiling"),
                   "part_ceiling": metadata.get("part_ceiling"), "database_digest": metadata.get("database_digest"),
                   "exclusion_digest": metadata.get("exclusion_digest"), "query": history_capture_query(args)}
        result["digest"] = review_digest(
            page, result["snapshot"], result["session_ceiling"], result["part_ceiling"],
            history_page_digest(page, live.get("_source_identities", {}) if not args.archive_only and not args.replay else {},
                                args.limit, args.cursor),
        )
        for name in ("snapshot", "session_ceiling", "part_ceiling", "database_digest", "exclusion_digest"):
            supplied = getattr(args, name)
            if args.replay and supplied is not None:
                fail("review history replay uses its report ID and cursor, not a live snapshot")
            if supplied is not None and supplied != result[name]:
                fail("review history replay does not match its immutable snapshot")
        if getattr(args, "capture_all", False):
            result["_capture_records"] = records
            result["_capture_source_identities"] = (
                live.get("_source_identities", {}) if not args.archive_only and not args.replay else {})
            return result
    encoded = json.dumps(result, sort_keys=True, separators=(",", ":"), ensure_ascii=True)
    if len(encoded.encode()) > HISTORY_SCAN_HARD:
        fail("review history response exceeds bound")
    return result


def history_capture_review_page(manifest, members, limit, cursor):
    if limit != manifest["page_size"] or cursor < 0 or cursor % limit:
        fail("review history capture page identity changed")
    page = members[cursor:cursor + limit]
    continuation = cursor + limit if len(members) > cursor + limit else None
    stored = next((item for item in manifest["pages"] if item["cursor"] == cursor), None)
    if page and stored is None:
        fail("review history capture page is missing")
    result = {
        "schema_version": 1, "capture_id": manifest["capture_id"], "candidates": page,
        "session_ids": [item["session_id"] for item in page], "limit": limit, "cursor": cursor,
        "continuation": continuation, "snapshot": manifest["snapshot"],
        "session_ceiling": manifest["session_ceiling"], "part_ceiling": manifest["part_ceiling"],
        "database_digest": manifest["database_digest"], "exclusion_digest": manifest["exclusion_digest"],
        "query": manifest["query"],
        "digest": stored["digest"] if stored else review_digest(
            [], manifest["snapshot"], manifest["session_ceiling"], manifest["part_ceiling"],
            history_page_digest([], {}, limit, cursor)),
    }
    if len(json.dumps(result, sort_keys=True, separators=(",", ":")).encode()) > HISTORY_SCAN_HARD:
        fail("review history response exceeds bound")
    return result


def capture_history_args(args):
    return argparse.Namespace(
        database=args.database, state_root=args.state_root,
        archive_only=getattr(args, "archive_only", False),
        limit=args.page_size, cursor=0, after=args.after, before=args.before,
        method_revision=args.method_revision, cycle_id=args.cycle_id, state=args.state,
        context=args.context, project_digest=args.project_digest, reviewed_status=args.reviewed_status,
        replay=None, snapshot=None, session_ceiling=None, part_ceiling=None, database_digest=None,
        exclusion_digest=None, capture_all=True,
        excluded_session_id=args.excluded_session_id, excluded_message_id=args.excluded_message_id,
    )


def command_history_capture_save(args):
    root = review_root(args.state_root)
    with review_lock(root) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        source = review_history_page(capture_history_args(args), lock_held=True)
        manifest, _ = persist_history_capture(root, source, args.page_size)
    print(json.dumps(history_capture_summary(manifest), sort_keys=True, separators=(",", ":")))


def prune_federated_captures(connection, now):
    benchmark_exists = connection.execute(
        "SELECT 1 FROM sqlite_master WHERE type='table' AND name='benchmark_effects'").fetchone() is not None
    referenced = set()
    if benchmark_exists:
        for baseline, observation in connection.execute(
                "SELECT baseline_capture_id,observation_capture_id FROM benchmark_effects"):
            referenced.update((baseline, observation))
    for capture_id, payload in connection.execute("SELECT capture_id,payload FROM history_captures").fetchall():
        manifest = json.loads(payload, object_pairs_hook=no_duplicate_keys)
        if (manifest.get("kind") == "federated"
                and manifest.get("created_at", now) < now - FEDERATED_CAPTURE_RETENTION_MS
                and capture_id not in referenced):
            connection.execute("DELETE FROM history_captures WHERE capture_id=?", (capture_id,))


def persist_history_capture(root, source, page_size, allow_empty=False, transient=False):
    members = [validate_history_evidence(item) for item in source.pop("_capture_records")]
    source_identities = source.pop("_capture_source_identities")
    if not members and not allow_empty:
        fail("history capture query selected no evidence")
    identity = {name: source[name] for name in (
        "snapshot", "session_ceiling", "part_ceiling", "database_digest", "exclusion_digest")}
    pages = []
    for cursor in range(0, len(members), page_size):
        records = members[cursor:cursor + page_size]
        continuation = cursor + page_size if len(members) > cursor + page_size else None
        pages.append({"cursor": cursor, "limit": page_size, "count": len(records),
                      "continuation": continuation,
                      "digest": review_digest(
                          records, identity["snapshot"], identity["session_ceiling"], identity["part_ceiling"],
                          history_page_digest(records, source_identities, page_size, cursor))})
    manifest = {"schema_version": 1, "query": source["query"], **identity, "page_size": page_size,
                "pages": pages, "member_count": len(members),
                "members_digest": hashlib.sha256(ledger_payload(members).encode()).hexdigest(),
                "aggregates": history_capture_aggregates(members)}
    if transient:
        manifest.update({"kind": "federated", "created_at": max(REVIEW_START_MS, int(time.time() * 1000))})
    manifest["capture_id"] = hashlib.sha256(ledger_payload(manifest).encode()).hexdigest()[:24]
    validate_history_capture(manifest, members)
    connection = ensure_ledger_for_write(root)
    ensure_capture_schema(connection)
    try:
        connection.execute("BEGIN IMMEDIATE")
        if transient:
            prune_federated_captures(connection, manifest["created_at"])
        existing = connection.execute(
            "SELECT payload FROM history_captures WHERE capture_id=?", (manifest["capture_id"],)).fetchone()
        if existing is not None and existing[0] != ledger_payload(manifest):
            fail("history capture identity collision")
        if existing is None:
            connection.execute("INSERT INTO history_captures VALUES (?, ?)",
                               (manifest["capture_id"], ledger_payload(manifest)))
            connection.executemany("INSERT INTO history_capture_members VALUES (?, ?, ?, ?)",
                                   ((manifest["capture_id"], position, record["session_id"], ledger_payload(record))
                                    for position, record in enumerate(members)))
        connection.commit()
    except Exception:
        connection.rollback()
        raise
    finally:
        connection.close()
    return manifest, members


def command_review_history(args):
    root = review_root(args.state_root)
    if args.capture:
        if (args.capture_id or args.replay or any(getattr(args, name) is not None for name in (
                "snapshot", "session_ceiling", "part_ceiling", "database_digest", "exclusion_digest"))):
            fail("review history accepts only one capture identity")
        with review_lock(root) as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            capture_args = argparse.Namespace(**{**vars(args), "capture": False, "capture_all": True})
            source = review_history_page(capture_args, lock_held=True)
            manifest, members = persist_history_capture(root, source, args.limit, allow_empty=True, transient=True)
        result = history_capture_review_page(manifest, members, args.limit, args.cursor)
    elif args.capture_id:
        changed = (args.database is not None or args.archive_only or args.replay
                   or any(getattr(args, name) is not None for name in (
                       "after", "before", "method_revision", "cycle_id", "state", "context", "project_digest",
                       "reviewed_status", "snapshot", "session_ceiling", "part_ceiling", "database_digest",
                       "excluded_session_id", "excluded_message_id", "exclusion_digest")))
        if changed:
            fail("review history capture query cannot change")
        require_review_lock_safe(root)
        with existing_review_lock(root):
            with ledger_connection(root) as connection:
                manifest, members = load_history_capture(connection, args.capture_id)
        result = history_capture_review_page(manifest, members, args.limit, args.cursor)
    else:
        result = review_history_page(args)
    print(json.dumps(result, sort_keys=True, separators=(",", ":"), ensure_ascii=True))


def load_history_capture(connection, capture_id):
    if not isinstance(capture_id, str) or not re.fullmatch(r"[0-9a-f]{24}", capture_id):
        fail("invalid history capture ID")
    if connection.execute("SELECT value FROM ledger_meta WHERE key='capture_schema'").fetchone() is None:
        fail("history capture is missing")
    row = connection.execute("SELECT payload FROM history_captures WHERE capture_id=?", (capture_id,)).fetchone()
    if row is None:
        fail("history capture is missing")
    manifest = json.loads(row[0], object_pairs_hook=no_duplicate_keys)
    members = history_capture_members(connection, capture_id)
    return validate_history_capture(manifest, members)


def command_history_capture(args):
    root = review_root(args.state_root)
    if not ledger_exists(root):
        fail("history capture is missing")
    require_review_lock_safe(root)
    with existing_review_lock(root):
        with ledger_connection(root) as connection:
            manifest, members = load_history_capture(connection, args.capture_id)
        excluded_family = historical_excluded_family(
            args.database, args.excluded_session_id, args.excluded_message_id) if args.lens_summary else set()
        root_session = (args.excluded_session_id or session_for_message(args.database, args.excluded_message_id)
                        if args.excluded_message_id else args.excluded_session_id)
        result = (history_lens_summary(manifest, members, args.lens_summary, args.review_sessions,
                                       excluded_family, session_id_digest(root_session) if root_session else None)
                  if args.lens_summary else history_capture_summary(manifest))
        if args.cursor is not None and not args.lens_summary:
            if args.cursor < 0:
                fail("history capture cursor must be non-negative")
            page = members[args.cursor:args.cursor + args.limit]
            result.update({"cursor": args.cursor, "limit": args.limit, "members": page,
                           "continuation": args.cursor + args.limit
                           if len(members) > args.cursor + args.limit else None})
        encoded = json.dumps(result, sort_keys=True, separators=(",", ":"), ensure_ascii=True)
        if len(encoded.encode()) > HISTORY_SCAN_HARD:
            fail("history capture response exceeds bound")
        print(encoded)


def command_history_capture_latest(args):
    root = review_root(args.state_root)
    query = history_capture_query(args)
    now = max(REVIEW_START_MS, int(time.time() * 1000))
    manifest = members = None
    with review_lock(root) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if ledger_exists(root):
            with ledger_connection(root) as connection:
                if connection.execute(
                        "SELECT 1 FROM sqlite_master WHERE type='table' AND name='history_captures'").fetchone():
                    rows = connection.execute("SELECT capture_id,payload FROM history_captures").fetchall()
                    candidates = []
                    for capture_id, payload in rows:
                        value = json.loads(payload, object_pairs_hook=no_duplicate_keys)
                        if (value.get("kind") == "federated" and value.get("exclusion_digest") is None
                                and value.get("query") == query
                                and now - FEDERATED_CAPTURE_RETENTION_MS <= value.get("created_at", 0)
                                <= now + 5 * 60 * 1000):
                            candidates.append((value["created_at"], capture_id))
                    if candidates:
                        manifest, members = load_history_capture(connection, max(candidates)[1])
        if manifest is None:
            capture_args = capture_history_args(argparse.Namespace(
                **{**vars(args), "excluded_session_id": None, "excluded_message_id": None}))
            source = review_history_page(capture_args, lock_held=True)
            manifest, members = persist_history_capture(
                root, source, args.page_size, allow_empty=True, transient=True)
    result = {"schema_version": 1, "capture_id": manifest["capture_id"],
              "created_at": manifest["created_at"], "query": manifest["query"],
              "snapshot": manifest["snapshot"], "session_ceiling": manifest["session_ceiling"],
              "part_ceiling": manifest["part_ceiling"], "database_digest": manifest["database_digest"],
              "page_size": manifest["page_size"], "page_count": max(1, len(manifest["pages"])),
              "member_count": manifest["member_count"]}
    print(json.dumps(result, sort_keys=True, separators=(",", ":")))


def command_history_capture_delete(args):
    root = review_root(args.state_root)
    if not ledger_exists(root):
        fail("history capture is missing")
    require_review_lock_safe(root)
    with review_lock(root) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        connection = ledger_connection(root, write=True)
        try:
            load_history_capture(connection, args.capture_id)
            connection.execute("BEGIN IMMEDIATE")
            connection.execute("DELETE FROM history_captures WHERE capture_id=?", (args.capture_id,))
            record_knowledge_privacy_tombstone(
                connection, "history_capture", args.capture_id, "deleted",
                int(time.time() * 1000))
            connection.commit()
        except Exception:
            connection.rollback()
            raise
        finally:
            connection.close()
    print(json.dumps({"deleted": args.capture_id}, sort_keys=True))


def command_review_privacy_epoch(args):
    index = review_index(review_root(args.state_root))
    identity = {"schema_version": 1, "forgotten_sessions": sorted(index["forgotten_sessions"].items())}
    print(json.dumps({"schema_version": 1,
                      "privacy_epoch_digest": hashlib.sha256(ledger_payload(identity).encode()).hexdigest()},
                      sort_keys=True, separators=(",", ":")))


def knowledge_privacy_status(root):
    digest = hashlib.sha256(ledger_payload(
        {"schema_version": 1, "tombstones": []}).encode()).hexdigest()
    sequence = 0
    if ledger_exists(root):
        connection = ledger_connection(root)
        try:
            values = dict(connection.execute(
                "SELECT key,value FROM ledger_meta WHERE key IN "
                "('knowledge_privacy_sequence','knowledge_privacy_digest')"))
        finally:
            connection.close()
        if "knowledge_privacy_sequence" in values:
            if (set(values) != {"knowledge_privacy_sequence", "knowledge_privacy_digest"}
                    or not values["knowledge_privacy_sequence"].isdigit()
                    or not 0 <= int(values["knowledge_privacy_sequence"]) < 2**64
                    or not re.fullmatch(r"[0-9a-f]{64}", values["knowledge_privacy_digest"])):
                fail("knowledge privacy state is invalid")
            sequence = int(values["knowledge_privacy_sequence"])
            digest = values["knowledge_privacy_digest"]
    return {"schema_version": 1, "privacy_sequence": sequence, "privacy_digest": digest}


def command_knowledge_privacy_status(args):
    root = review_root(args.state_root)
    require_review_lock_safe(root)
    with existing_review_lock(root):
        value = knowledge_privacy_status(root)
    print(json.dumps(value, sort_keys=True, separators=(",", ":")))


def command_knowledge_privacy_guard(args):
    if not 0 <= args.expected_sequence < 2**64:
        fail("invalid expected privacy sequence")
    if not re.fullmatch(r"[0-9a-f]{64}", args.expected_digest):
        fail("invalid expected privacy digest")
    program = list(args.program)
    if program and program[0] == "--":
        program.pop(0)
    if not program:
        fail("privacy guard requires a program")
    root = review_root(args.state_root)
    require_review_lock_safe(root)
    with review_lock(root) as lock:
        fcntl.flock(lock, fcntl.LOCK_SH)
        current = knowledge_privacy_status(root)
        if (current["privacy_sequence"] != args.expected_sequence
                or current["privacy_digest"] != args.expected_digest):
            fail("knowledge privacy status mismatch")
        result = subprocess.run(program, stdin=subprocess.DEVNULL)
    raise SystemExit(result.returncode)


def knowledge_high_entropy_text(value, field=None):
    free_text = {"caveats", "confounders", "context", "decision", "findings", "notes",
                 "proposals", "reason", "recommendations", "scorecards", "summary", "title",
                 "trends"}
    if isinstance(value, dict):
        return any(knowledge_high_entropy_text(item, key) for key, item in value.items())
    if isinstance(value, list):
        return any(knowledge_high_entropy_text(item, field) for item in value)
    return field in free_text and isinstance(value, str) and HIGH_ENTROPY.search(value)


def knowledge_record(family, source_id, payload, retention="retained"):
    text = json.dumps(payload, ensure_ascii=False)
    if (SECRET_VALUE.search(text) or knowledge_high_entropy_text(payload)
            or re.search(r"\b[\w.+-]+@[\w.-]+\.[A-Za-z]{2,}\b", text)
            or re.search(r"\b(?:https?|ftp)://", text, re.I)
            or re.search(r"(?<![A-Za-z0-9._~-])(?:~|/)[^\s`)'\"\]}]+", text)):
        fail("knowledge export contains unsafe content")
    text = ledger_payload(payload)
    return {
        "type": "record", "schema_version": 1, "family": family,
        "record_id": hashlib.sha256(f"{family}\0{source_id}".encode()).hexdigest(),
        "revision": hashlib.sha256(text.encode()).hexdigest(),
        "retention": retention, "text": text,
    }


def knowledge_ledger_records(root):
    if not ledger_exists(root):
        return []
    connection = ledger_connection(root)
    records = []
    try:
        tables = {row[0] for row in connection.execute(
            "SELECT name FROM sqlite_master WHERE type='table'")}
        for report_id, reviewed_at, payload in connection.execute(
                "SELECT report_id,reviewed_at,payload FROM review_reports ORDER BY report_id"):
            report = json.loads(payload, object_pairs_hook=no_duplicate_keys)
            records.append(knowledge_record("review", report_id, {
                "report_id": report_id, "reviewed_at": reviewed_at,
                "decision": report.get("decision"), "notes": report.get("notes"),
                "findings": report.get("findings", []), "scorecards": report.get("scorecards", []),
                "trends": report.get("trends", []), "proposals": report.get("proposals", []),
                "caveats": report.get("caveats", []),
            }, retention="expires"))
        for report_id, kind, payload in connection.execute(
                "SELECT report_id,kind,payload FROM history_reports ORDER BY report_id"):
            records.append(knowledge_record(
                "history_report", report_id,
                {"kind": kind, "report": json.loads(payload, object_pairs_hook=no_duplicate_keys)}))
        for session_id, completed_at, payload in connection.execute(
                "SELECT session_id,completed_at,payload FROM history_evidence ORDER BY session_id"):
            evidence = json.loads(payload, object_pairs_hook=no_duplicate_keys)
            records.append(knowledge_record("telemetry", session_id, {
                "session_id": session_id, "completed_at": completed_at,
                "state": evidence.get("state"), "context": evidence.get("context"),
                "risk": evidence.get("risk"), "metrics": evidence.get("metrics", {}),
                "availability": evidence.get("availability", {}),
            }))
        if "history_captures" in tables:
            for capture_id, payload in connection.execute(
                    "SELECT capture_id,payload FROM history_captures ORDER BY capture_id"):
                manifest = json.loads(payload, object_pairs_hook=no_duplicate_keys)
                records.append(knowledge_record("history_capture", capture_id, {
                    key: manifest.get(key) for key in (
                        "capture_id", "snapshot", "session_ceiling", "part_ceiling",
                        "database_digest", "exclusion_digest", "query_digest", "member_count")
                }, retention="expires" if manifest.get("kind") == "federated" else "retained"))
        if "benchmark_effects" in tables:
            for benchmark_id, payload in connection.execute(
                    "SELECT benchmark_id,payload FROM benchmark_effects ORDER BY benchmark_id"):
                records.append(knowledge_record(
                    "benchmark", benchmark_id,
                    json.loads(payload, object_pairs_hook=no_duplicate_keys)))
        if "phase_spans" in tables:
            for row in connection.execute(
                    "SELECT cycle_id,span_id,parent_span_id,phase,operation,attribution,"
                    "started_at,finished_at,result FROM phase_spans ORDER BY cycle_id,span_id"):
                cycle_id, span_id, parent, phase, operation, attribution, started, finished, result = row
                records.append(knowledge_record("execution", f"{cycle_id}-{span_id}", {
                    "cycle_id": cycle_id, "span_id": span_id, "parent_span_id": parent,
                    "phase": phase, "operation": operation, "attribution": attribution,
                    "started_at": started, "finished_at": finished, "result": result,
                }))
        if "provider_evaluation_reports" in tables:
            for report_id, payload in connection.execute(
                    "SELECT report_id,payload FROM provider_evaluation_reports ORDER BY report_id"):
                report = json.loads(payload, object_pairs_hook=no_duplicate_keys)
                records.append(knowledge_record("provider_evaluation", report_id, {
                    key: report.get(key) for key in (
                        "report_id", "rubric", "harness_identity", "aggregates", "availability",
                        "confounders", "findings", "recommendations", "created_at")
                }))
        if "improvement_workers" in tables:
            for worker_id, opportunity_id, summary, priority, state, cycle_id, created_at, updated_at in connection.execute(
                    "SELECT worker_id,opportunity_id,summary,priority,state,cycle_id,created_at,updated_at "
                    "FROM improvement_workers ORDER BY worker_id"):
                records.append(knowledge_record("improvement", worker_id, {
                    "worker_id": worker_id, "opportunity_id": opportunity_id,
                    "summary": summary, "priority": priority, "state": state,
                    "cycle_id": cycle_id, "created_at": created_at, "updated_at": updated_at,
                }))
        if "knowledge_privacy_tombstones" in tables:
            for family, item_id, reason, timestamp in knowledge_privacy_rows(connection):
                records.append({
                    "type": "privacy", "schema_version": 1, "family": family,
                    "record_id": hashlib.sha256(f"{family}\0{item_id}".encode()).hexdigest(),
                    "reason": reason, "timestamp": timestamp,
                })
    finally:
        connection.close()
    return records


def knowledge_cycle_records(repository):
    records = []
    directory = cycle_dir(repository) / "cycles"
    for path in sorted(directory.glob("*.json")) if directory.is_dir() else ():
        try:
            cycle = json.loads(path.read_text(encoding="utf-8"), object_pairs_hook=no_duplicate_keys)
        except (OSError, json.JSONDecodeError) as error:
            fail(f"cannot export Cycle Record: {error}")
        cycle_id = cycle.get("cycle_id")
        if not isinstance(cycle_id, str) or not OPAQUE_ID.fullmatch(cycle_id):
            fail("cannot export invalid Cycle Record")
        records.append(knowledge_record("cycle", cycle_id, {
            "cycle_id": cycle_id, "context": cycle.get("context"), "state": cycle.get("state"),
            "risk": cycle.get("risk"), "delivery_intent": cycle.get("delivery_intent"),
            "method_revision": cycle.get("method_revision"), "schema_version": cycle.get("schema_version"),
            "gates": {name: {key: gate.get(key) for key in ("applicability", "result", "reason")
                             if gate.get(key) is not None}
                      for name, gate in sorted(cycle.get("gates", {}).items())},
            "metrics": cycle.get("metrics", {}), "created_at": cycle.get("created_at"),
            "completed_at": cycle.get("completed_at"),
        }))
        for evidence_id, item in sorted(cycle.get("evidence", {}).get("items", {}).items()):
            records.append(knowledge_record("gate_evidence", evidence_id, {
                "evidence_id": evidence_id, "cycle_id": cycle_id, "gate": item.get("gate"),
                "authority": item.get("authority"), "result": item.get("result"),
                "summary": item.get("summary"), "head": item.get("head"),
                "started_at": item.get("started_at"), "finished_at": item.get("finished_at"),
                "content_status": item.get("content", {}).get("status")
                if isinstance(item.get("content"), dict) else "unavailable",
            }))
    return records


def knowledge_export_lines(root):
    privacy = knowledge_privacy_status(root)
    ledger = ledger_exists(root)
    repository = root_dir()
    families = {
        "cycle": "available" if (cycle_dir(repository) / "cycles").is_dir() else "unavailable",
        "gate_evidence": "available" if (cycle_dir(repository) / "evidence").is_dir() else "unavailable",
        "review": "available" if ledger else "unavailable",
        "history_report": "available" if ledger else "unavailable",
        "history_capture": "available" if ledger else "unavailable",
        "telemetry": "available" if ledger else "unavailable",
        "benchmark": "available" if ledger else "unavailable",
        "execution": "available" if ledger else "unavailable",
        "provider_evaluation": "available" if ledger else "unavailable",
        "improvement": "available" if ledger else "unavailable",
    }
    records = knowledge_cycle_records(repository) + knowledge_ledger_records(root)
    records.sort(key=lambda item: (0 if item["type"] == "privacy" else 1,
                                   item.get("family", ""), item["record_id"]))
    if len(records) > 10000:
        fail("knowledge export exceeds record bound")
    manifest = {"type": "manifest", "schema_version": 1, **privacy,
                "families": families, "record_count": len(records)}
    first = json.dumps(manifest, sort_keys=True, separators=(",", ":"), ensure_ascii=True)
    encoded_records = [json.dumps(record, sort_keys=True, separators=(",", ":"), ensure_ascii=True)
                       for record in records]
    payload = "".join(f"{line}\n" for line in [first, *encoded_records])
    if len(payload.encode()) > 16 * 1024 * 1024:
        fail("knowledge export exceeds byte bound")
    terminal = json.dumps({"type": "terminal", "schema_version": 1,
                           "digest": hashlib.sha256(payload.encode()).hexdigest(),
                           "record_count": len(records)},
                          sort_keys=True, separators=(",", ":"), ensure_ascii=True)
    return [first, *encoded_records, terminal]


def command_knowledge_export(args):
    root = review_root(args.state_root)
    require_review_lock_safe(root)
    with existing_review_lock(root):
        lines = knowledge_export_lines(root)
    print("\n".join(lines))


def validate_provider_evaluation_receipt(value):
    if (not isinstance(value, dict) or set(value) != {"schema_version", "manifest_digest", "manifest_identity", "sources"}
            or value.get("schema_version") != 1
            or not re.fullmatch(r"[0-9a-f]{64}", value.get("manifest_digest", ""))
            or hashlib.sha256(ledger_payload(value.get("manifest_identity")).encode()).hexdigest()
            != value.get("manifest_digest")
            or not isinstance(value.get("sources"), list) or not 1 <= len(value["sources"]) <= 33):
        fail("provider evaluation receipt has an invalid schema")
    manifest = value["manifest_identity"]
    if (not isinstance(manifest, dict) or set(manifest) != {"filters", "sources"}
            or not isinstance(manifest.get("filters"), dict) or not isinstance(manifest.get("sources"), list)
            or [source.get("source_id") for source in manifest["sources"]]
            != [source.get("source_id") for source in value["sources"]]):
        fail("provider evaluation receipt has invalid manifest identity")
    seen = set()
    page_fields = {"schema_version", "capture_id", "candidates", "session_ids", "limit", "cursor",
                   "continuation", "snapshot", "session_ceiling", "part_ceiling", "database_digest",
                   "exclusion_digest", "query", "digest", "member_digests"}
    query_fields = {"after", "before", "method_revision", "cycle_id", "state", "context",
                    "project_digest", "reviewed_status", "archive_only"}
    for source in value["sources"]:
        if (not isinstance(source, dict) or set(source) != {"source_id", "capture_id", "privacy_epoch_digest", "pages"}
                or not PRESENTATION_ID.fullmatch(source.get("source_id", "")) or source["source_id"] in seen
                or not re.fullmatch(r"[0-9a-f]{24}", source.get("capture_id", ""))
                or not re.fullmatch(r"[0-9a-f]{64}", source.get("privacy_epoch_digest", ""))
                or not isinstance(source.get("pages"), list) or not source["pages"]):
            fail("provider evaluation receipt has invalid source identity")
        seen.add(source["source_id"])
        expected_cursor = 0
        source_identity = None
        for position, page in enumerate(source["pages"]):
            if (not isinstance(page, dict) or set(page) != page_fields or page.get("schema_version") != 1
                    or page.get("capture_id") != source["capture_id"] or page.get("cursor") != expected_cursor
                    or not re.fullmatch(r"[0-9a-f]{64}", page.get("digest", ""))
                    or type(page.get("limit")) is not int or not 1 <= page["limit"] <= REVIEW_MAX_LIMIT
                    or not isinstance(page.get("candidates"), list) or len(page["candidates"]) > page["limit"]
                    or not isinstance(page.get("session_ids"), list)
                    or page["session_ids"] != [candidate.get("session_id") for candidate in page["candidates"]]
                    or not isinstance(page.get("member_digests"), list)
                    or page["member_digests"] != [hashlib.sha256(ledger_payload(candidate).encode()).hexdigest()
                                                   for candidate in page["candidates"]]
                    or page.get("continuation") != (page["cursor"] + page["limit"]
                                                    if position < len(source["pages"]) - 1 else None)
                    or any(type(page.get(name)) is not int or page[name] < 0
                           for name in ("snapshot", "session_ceiling", "part_ceiling"))
                    or not re.fullmatch(r"[0-9a-f]{64}", page.get("database_digest", ""))
                    or page.get("exclusion_digest") is not None
                    and not re.fullmatch(r"[0-9a-f]{64}", page["exclusion_digest"])
                    or not isinstance(page.get("query"), dict) or set(page["query"]) != query_fields
                    or type(page["query"].get("archive_only")) is not bool
                    or any(item is not None and (type(item) is not int or item < REVIEW_START_MS)
                           for item in (page["query"]["after"], page["query"]["before"]))
                    or any(item is not None and (not isinstance(item, str) or not OPAQUE_ID.fullmatch(item))
                           for item in (page["query"]["cycle_id"], page["query"]["context"]))
                    or page["query"]["method_revision"] is not None
                    and (not isinstance(page["query"]["method_revision"], str)
                         or not re.fullmatch(r"\d+(?:\.\d+)*", page["query"]["method_revision"]))
                    or page["query"]["project_digest"] is not None
                    and (not isinstance(page["query"]["project_digest"], str)
                         or not re.fullmatch(r"[0-9a-f]{64}", page["query"]["project_digest"]))
                    or page["query"]["state"] not in (None, "active", "blocked", "abandoned", "completed", "unknown")
                    or page["query"]["reviewed_status"] not in (None, "reviewed", "unreviewed")):
                fail("provider evaluation receipt has invalid page identity")
            identity = {name: page[name] for name in ("capture_id", "snapshot", "session_ceiling",
                                                       "part_ceiling", "database_digest", "exclusion_digest", "query", "limit")}
            if source_identity is not None and identity != source_identity:
                fail("provider evaluation receipt source identity changed")
            source_identity = identity
            for candidate in page["candidates"]:
                validate_history_evidence(candidate)
            expected_cursor += page["limit"]
        if source["pages"][-1]["continuation"] is not None:
            fail("provider evaluation receipt is not terminal")
    if any(source["pages"][0]["query"] != manifest["filters"] for source in value["sources"]):
        fail("provider evaluation receipt query changed")
    for source, manifest_source in zip(value["sources"], manifest["sources"]):
        if not isinstance(manifest_source, dict):
            fail("provider evaluation receipt has invalid manifest identity")
        expected = {"source_id", "availability"}
        if manifest_source.get("availability") == "available":
            expected |= {"capture_id", "snapshot", "session_ceiling", "part_ceiling", "database_digest",
                         "exclusion_digest", "limit", "cursor", "continuation", "digest"}
            page = source["pages"][-1]
            if any(manifest_source.get(name) != page[name] for name in expected - {"source_id", "availability"}):
                fail("provider evaluation receipt manifest changed")
        elif manifest_source.get("availability") != "complete":
            fail("provider evaluation receipt manifest is not terminal")
        if not isinstance(manifest_source, dict) or set(manifest_source) != expected:
            fail("provider evaluation receipt has invalid manifest identity")
    if len(json.dumps(value, sort_keys=True, separators=(",", ":")).encode()) > 2 * 1024 * 1024:
        fail("provider evaluation receipt exceeds bound")
    return value


def provider_evaluation_candidates(receipt):
    eligible = []
    for source in receipt["sources"]:
        for page in source["pages"]:
            for candidate in page["candidates"]:
                if (not isinstance(candidate, dict) or candidate.get("correlation_quality") != "exact"
                        or not isinstance(candidate.get("cycles"), list) or len(candidate["cycles"]) != 1
                        or candidate["cycles"][0].get("state") != "completed"
                        or not isinstance(candidate.get("completed_at"), str) or not candidate["completed_at"].isdigit()):
                    continue
                cycle = candidate["cycles"][0]
                try:
                    activation = validate_stored_harness_activation(cycle.get("harness_activation"))
                    metrics = validate_cycle_metrics(cycle.get("metrics"))
                    telemetry = validate_history_telemetry(candidate.get("telemetry"))
                except RuntimeError:
                    continue
                if (metrics["elapsed_ms"] == "unavailable" or telemetry.get("schema_version") != TELEMETRY_SCHEMA
                        or cycle.get("risk") not in ("routine", "elevated", "critical")
                        or cycle.get("delivery_intent") not in DELIVERY_INTENTS
                        or telemetry.get("session_relation") != "primary"
                        or telemetry.get("provider_ids") != [activation["provider_id"]]
                        or not isinstance(telemetry.get("model_ids"), list)
                        or activation["model_id"] not in telemetry["model_ids"]
                        or not isinstance(telemetry.get("agent_ids"), list)
                        or activation["agent_id"] not in telemetry["agent_ids"]
                        or telemetry.get("core_revisions") != [activation["core_revision"]]
                        or telemetry.get("overlay_revisions") != [activation["overlay_revision"]]):
                    continue
                cycle_id = cycle.get("cycle_id")
                if not isinstance(cycle_id, str) or not OPAQUE_ID.fullmatch(cycle_id):
                    continue
                harness = {name: activation[name] for name in (
                    "provider_id", "model_id", "agent_id", "core_revision", "overlay_revision")}
                errors = telemetry["error_classes"] if isinstance(telemetry["error_classes"], dict) else {}
                optional_metrics = {
                    "tool_call_count": candidate.get("aggregates", {}).get("tool_call_count", "unavailable"),
                    "tool_error_count": candidate.get("aggregates", {}).get("tool_error_count", "unavailable"),
                    "provider_error_count": errors.get("provider_error", "unavailable"),
                    **{name: telemetry[name] for name in (
                        "delegation_count", "approval_count", "retry_count", "token_total", "cost_total")},
                }
                member = {"source_id": source["source_id"], "cycle_id": cycle_id,
                          "completed_at": int(candidate["completed_at"]), "context": candidate.get("context", "unavailable"),
                          "risk": cycle["risk"], "delivery_intent": cycle["delivery_intent"],
                          **{name: telemetry[name] for name in ("provider_ids", "model_ids", "agent_ids")},
                          "metrics": metrics, "optional_metrics": optional_metrics,
                          "telemetry_digest": hashlib.sha256(ledger_payload(telemetry).encode()).hexdigest(),
                          "gate_digest": hashlib.sha256(ledger_payload(metrics).encode()).hexdigest()}
                eligible.append((harness, member))
    return eligible


def provider_evaluation_evidence(receipt):
    return [{"source_id": source["source_id"], "capture_id": source["capture_id"],
             "privacy_epoch_digest": source["privacy_epoch_digest"],
             "query_digest": hashlib.sha256(ledger_payload(source["pages"][0]["query"]).encode()).hexdigest(),
             "exclusion_digest": source["pages"][0]["exclusion_digest"],
             "pages": [{"cursor": page["cursor"], "digest": page["digest"],
                         "member_digests": page["member_digests"]}
                        for page in source["pages"]]} for source in receipt["sources"]]


def command_provider_evaluation_save(args):
    try:
        raw = sys.stdin.read() if args.receipt_json == "-" else args.receipt_json
        receipt = validate_provider_evaluation_receipt(json.loads(raw, object_pairs_hook=no_duplicate_keys))
        prose = json.loads(args.report_json, object_pairs_hook=no_duplicate_keys)
    except json.JSONDecodeError as error:
        fail(f"invalid provider evaluation input: {error}")
    if (not isinstance(prose, dict) or set(prose) != {"rubric", "findings", "recommendations"}
            or not isinstance(prose.get("rubric"), dict)
            or set(prose["rubric"]) != {"name", "version", "digest"}
            or not all(isinstance(prose["rubric"].get(name), str) for name in ("name", "version", "digest"))
            or not OPAQUE_ID.fullmatch(prose["rubric"]["name"])
            or not OPAQUE_ID.fullmatch(prose["rubric"]["version"])
            or not re.fullmatch(r"[0-9a-f]{64}", prose["rubric"]["digest"])):
        fail("invalid provider evaluation rubric")
    for name in ("findings", "recommendations"):
        if (not isinstance(prose.get(name), list) or len(prose[name]) > 50
                or any(not isinstance(item, str) or not 1 <= len(item.encode()) <= 512
                       or review_unsafe(item) for item in prose[name])):
            fail("invalid provider evaluation prose")
    root = review_root(args.state_root)
    with review_lock(root) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        connection = ensure_ledger_for_write(root)
        staged = None
        committed = False
        try:
            ensure_provider_evaluation_schema(connection)
            connection.execute("BEGIN IMMEDIATE")
            current_ms = int(time.time() * 1000)
            affected_report_ids = set()
            for source in receipt["sources"]:
                previous = connection.execute(
                    "SELECT privacy_epoch_digest FROM provider_evaluation_sources WHERE source_id=?",
                    (source["source_id"],)).fetchone()
                if previous is not None and previous[0] != source["privacy_epoch_digest"]:
                    report_ids = [row[0] for row in connection.execute(
                        "SELECT DISTINCT report_id FROM provider_evaluation_members WHERE source_id=?",
                        (source["source_id"],))]
                    affected_report_ids.update(report_ids)
                    connection.executemany("DELETE FROM provider_evaluation_reports WHERE report_id=?",
                                           ((report_id,) for report_id in report_ids))
                connection.execute("INSERT INTO provider_evaluation_sources VALUES (?, ?, 'available', ?) "
                                   "ON CONFLICT(source_id) DO UPDATE SET privacy_epoch_digest=excluded.privacy_epoch_digest, "
                                   "availability='available', verified_at=excluded.verified_at",
                                   (source["source_id"], source["privacy_epoch_digest"], current_ms))
            if affected_report_ids:
                quarantine_name = f".forget-{uuid.uuid4().hex}"
                connection.execute("INSERT INTO ledger_meta VALUES ('pending_forget_cleanup', ?)",
                                   (quarantine_name,))
                staged = stage_provider_evaluation_backups(root, affected_report_ids, quarantine_name)
            rubric_key = hashlib.sha256(ledger_payload(prose["rubric"]).encode()).hexdigest()
            existing = connection.execute(
                "SELECT reports.payload FROM provider_evaluation_reports AS reports "
                "JOIN provider_evaluation_receipts AS receipts USING (report_id) "
                "WHERE reports.rubric_key=? AND receipts.payload=? ORDER BY reports.created_at, reports.report_id LIMIT 1",
                (rubric_key, ledger_payload(receipt)),
            ).fetchone()
            if existing is not None:
                connection.rollback()
                print(existing[0])
                return
            groups = {}
            for harness, member in provider_evaluation_candidates(receipt):
                harness_key = hashlib.sha256(ledger_payload(harness).encode()).hexdigest()
                used = connection.execute(
                    "SELECT 1 FROM provider_evaluation_members WHERE rubric_key=? AND harness_key=? "
                    "AND source_id=? AND cycle_id=?", (rubric_key, harness_key, member["source_id"],
                                                        member["cycle_id"])).fetchone()
                if used is None:
                    groups.setdefault((harness_key, ledger_payload(harness)), []).append(member)
            qualified = []
            for (harness_key, serialized), members in groups.items():
                members.sort(key=lambda item: (item["completed_at"], item["cycle_id"], item["source_id"]))
                if len(members) >= 5:
                    qualified.append((members[0]["completed_at"], harness_key, serialized, members[:5]))
            if not qualified:
                if staged is None:
                    connection.rollback()
                else:
                    connection.commit()
                    committed = True
                    recover_forget_state(root, connection)
                print(json.dumps({"schema_version": 1, "status": "insufficient",
                                  "eligible_count": max((len(items) for items in groups.values()), default=0)},
                                 sort_keys=True, separators=(",", ":")))
                return
            _, harness_key, serialized_harness, members = min(qualified)
            harness = json.loads(serialized_harness)
            identity = {"rubric": prose["rubric"], "harness_identity": harness,
                        "members": [{name: member[name] for name in ("source_id", "cycle_id")}
                                    for member in members]}
            report_id = hashlib.sha256(ledger_payload(identity).encode()).hexdigest()[:24]
            existing = connection.execute(
                "SELECT payload FROM provider_evaluation_reports WHERE report_id=?", (report_id,)).fetchone()
            if existing is not None:
                connection.rollback()
                print(existing[0])
                return
            optional = ("tool_call_count", "tool_error_count", "provider_error_count", "delegation_count",
                        "approval_count", "retry_count", "token_total", "cost_total")
            aggregates = {"elapsed_ms_median": median(member["metrics"]["elapsed_ms"] for member in members),
                          "gate_failure_count": sum(member["metrics"]["gate_failure_count"] for member in members),
                          "gate_reopen_count": sum(member["metrics"]["gate_reopen_count"] for member in members),
                          "remediation_round_count": sum(member["metrics"]["remediation_round_count"] for member in members)}
            availability = {name: "unavailable" for name in optional}
            for name in optional:
                values = [member["optional_metrics"][name] for member in members]
                if all(isinstance(value, (int, float)) and not isinstance(value, bool) for value in values):
                    availability[name] = "available"
                    aggregates[name] = sum(values)
            contexts = sorted({member["context"] for member in members})
            risks = sorted({member["risk"] for member in members})
            deliveries = sorted({member["delivery_intent"] for member in members})
            child_agents = {tuple(member["agent_ids"]) for member in members}
            report = {"schema_version": 1, "report_id": report_id, **identity, "members": members,
                      "evidence": provider_evaluation_evidence(receipt),
                      "aggregates": aggregates, "availability": availability,
                      "confounders": (["context_distribution"] if len(contexts) > 1 else [])
                      + (["risk_distribution"] if len(risks) > 1 else [])
                      + (["delivery_distribution"] if len(deliveries) > 1 else [])
                      + (["child_agent_distribution"] if len(child_agents) > 1
                         or any(member["agent_ids"] != [harness["agent_id"]] for member in members) else []),
                      "findings": prose["findings"], "recommendations": prose["recommendations"],
                      "created_at": current_ms, "association_only": True}
            validate_provider_evaluation_report(report)
            connection.execute("INSERT INTO provider_evaluation_reports VALUES (?, ?, ?, ?, ?)",
                               (report_id, rubric_key, harness_key, current_ms, ledger_payload(report)))
            connection.executemany("INSERT INTO provider_evaluation_members VALUES (?, ?, ?, ?, ?, ?, ?)",
                                   ((report_id, position, rubric_key, harness_key, member["source_id"],
                                     member["cycle_id"], ledger_payload(member))
                                    for position, member in enumerate(members)))
            connection.execute("INSERT INTO provider_evaluation_receipts VALUES (?, ?)",
                               (report_id, ledger_payload(receipt)))
            connection.commit()
            committed = True
            if staged is not None:
                recover_forget_state(root, connection)
        except Exception:
            if not committed:
                connection.rollback()
                if staged is not None:
                    restore_staged_forget(*staged)
            raise
        finally:
            connection.close()
    print(json.dumps(report, sort_keys=True, separators=(",", ":")))


def command_provider_evaluation(args):
    root = review_root(args.state_root)
    if not ledger_exists(root):
        print(json.dumps({"schema_version": 1, "reports": []}, sort_keys=True))
        return
    with ledger_connection(root) as connection:
        if connection.execute(
                "SELECT value FROM ledger_meta WHERE key='provider_evaluation_schema'").fetchone() is None:
            print(json.dumps({"schema_version": 1, "reports": []}, sort_keys=True))
            return
        if args.report_id is None:
            reports = [{"report_id": row[0], "created_at": row[1]} for row in connection.execute(
                "SELECT report_id,created_at FROM provider_evaluation_reports ORDER BY created_at,report_id")]
            print(json.dumps({"schema_version": 1, "reports": reports}, sort_keys=True, separators=(",", ":")))
            return
        row = connection.execute("SELECT payload FROM provider_evaluation_reports WHERE report_id=?",
                                 (args.report_id,)).fetchone()
        if row is None:
            fail("provider evaluation report is missing")
        sources = [item[0] for item in connection.execute(
            "SELECT DISTINCT source_id FROM provider_evaluation_members WHERE report_id=?", (args.report_id,))]
        stale = int(time.time() * 1000) - 8 * 24 * 60 * 60 * 1000
        if any((state := connection.execute(
                "SELECT availability,verified_at FROM provider_evaluation_sources WHERE source_id=?", (source,)).fetchone())
                is None or state[0] != "available" or state[1] < stale for source in sources):
            fail("provider evaluation report is quarantined pending source privacy verification")
        print(row[0])


def command_provider_evaluation_forget(args):
    root = review_root(args.state_root)
    require_review_lock_safe(root)
    with review_lock(root) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        connection = ledger_connection(root, write=True)
        staged = None
        committed = False
        try:
            if connection.execute("SELECT payload FROM provider_evaluation_reports WHERE report_id=?",
                                  (args.report_id,)).fetchone() is None:
                fail("provider evaluation report is missing")
            connection.execute("BEGIN IMMEDIATE")
            connection.execute("DELETE FROM provider_evaluation_reports WHERE report_id=?", (args.report_id,))
            record_knowledge_privacy_tombstone(
                connection, "provider_evaluation", args.report_id, "forgotten",
                int(time.time() * 1000))
            quarantine_name = f".forget-{uuid.uuid4().hex}"
            connection.execute("INSERT INTO ledger_meta VALUES ('pending_forget_cleanup', ?)",
                               (quarantine_name,))
            staged = stage_provider_evaluation_backups(root, {args.report_id}, quarantine_name)
            connection.commit()
            committed = True
            recover_forget_state(root, connection)
        except Exception:
            if not committed:
                connection.rollback()
                if staged is not None:
                    restore_staged_forget(*staged)
            raise
        finally:
            connection.close()
    print(json.dumps({"forgotten": args.report_id}, sort_keys=True))


def validate_benchmark(value):
    top = {"schema_version", "benchmark_id", "definition", "inputs", "windows", "result", "evaluated_at"}
    definition_fields = {"version", "metric", "direction"}
    input_fields = {"baseline_capture_id", "observation_capture_id", "merge_identity", "merged_at",
                    "activation_status", "activation_identity", "activated_at"}
    result_fields = {"classification", "baseline_value", "observation_value", "delta", "confounders",
                     "unavailable_metrics", "association_only", "reason"}
    if (not isinstance(value, dict) or set(value) != top or value.get("schema_version") != 1
            or not re.fullmatch(r"[0-9a-f]{24}", value.get("benchmark_id", ""))
            or not isinstance(value.get("definition"), dict) or set(value["definition"]) != definition_fields
            or not OPAQUE_ID.fullmatch(value["definition"].get("version", ""))
            or value["definition"].get("metric") not in BENCHMARK_METRICS
            or value["definition"].get("direction") not in ("higher", "lower")
            or not isinstance(value.get("inputs"), dict) or set(value["inputs"]) != input_fields
            or not isinstance(value.get("result"), dict) or set(value["result"]) != result_fields
            or type(value.get("evaluated_at")) is not int or value["evaluated_at"] < REVIEW_START_MS):
        fail("benchmark evidence has an invalid schema")
    inputs, result = value["inputs"], value["result"]
    if (not all(re.fullmatch(r"[0-9a-f]{24}", inputs[name] or "")
                for name in ("baseline_capture_id", "observation_capture_id"))
            or not re.fullmatch(r"[0-9a-f]{40}(?:[0-9a-f]{24})?", inputs.get("merge_identity", ""))
            or type(inputs.get("merged_at")) is not int or inputs["merged_at"] < REVIEW_START_MS
            or inputs["merged_at"] > value["evaluated_at"]
            or inputs.get("activation_status") not in ("verified", "missing", "ambiguous")):
        fail("benchmark evidence has invalid inputs")
    verified = inputs["activation_status"] == "verified"
    if (verified and (not isinstance(inputs["activation_identity"], str)
                     or not OPAQUE_ID.fullmatch(inputs["activation_identity"])
                     or type(inputs["activated_at"]) is not int
                     or not inputs["merged_at"] <= inputs["activated_at"] <= value["evaluated_at"])):
        fail("benchmark evidence has invalid activation")
    if not verified and (inputs["activation_identity"] is not None or inputs["activated_at"] is not None):
        fail("benchmark evidence has invalid activation")
    windows = value["windows"]
    if verified:
        if (not isinstance(windows, dict) or set(windows) != {"days", "baseline", "observation"}
                or windows["days"] != 30 or any(not isinstance(windows[name], dict)
                or set(windows[name]) != {"after", "before"} for name in ("baseline", "observation"))):
            fail("benchmark evidence has invalid windows")
        expected_windows = {"days": 30,
                            "baseline": {"after": inputs["activated_at"] - BENCHMARK_WINDOW_MS,
                                         "before": inputs["activated_at"] - 1},
                            "observation": {"after": inputs["activated_at"],
                                            "before": inputs["activated_at"] + BENCHMARK_WINDOW_MS - 1}}
        if windows != expected_windows:
            fail("benchmark evidence has invalid windows")
    elif windows != "unavailable":
        fail("benchmark evidence has invalid windows")
    if (result.get("classification") not in ("improved", "neutral", "regressed", "insufficient")
            or result.get("association_only") is not True
            or not isinstance(result.get("confounders"), list)
            or len(result["confounders"]) > 64
            or result["confounders"] != sorted(set(result["confounders"]))
            or any(not OPAQUE_ID.fullmatch(item) for item in result["confounders"])
            or not isinstance(result.get("unavailable_metrics"), list)
            or result["unavailable_metrics"] != sorted(set(result["unavailable_metrics"]))
            or any(item not in BENCHMARK_METRICS for item in result["unavailable_metrics"])
            or result.get("reason") not in ("complete", "activation_missing", "activation_ambiguous",
                                             "window_incomplete", "window_mismatch", "metric_unavailable")):
        fail("benchmark evidence has an invalid result")
    for name in ("baseline_value", "observation_value", "delta"):
        item = result[name]
        if item != "unavailable" and (not isinstance(item, (int, float)) or isinstance(item, bool)
                                      or not math.isfinite(item)):
            fail("benchmark evidence has an invalid result")
    if (not verified and result["reason"] != f"activation_{inputs['activation_status']}"
            or verified and value["evaluated_at"] < inputs["activated_at"] + BENCHMARK_WINDOW_MS
            and result["reason"] != "window_incomplete"
            or result["unavailable_metrics"] not in ([], [value["definition"]["metric"]])):
        fail("benchmark evidence has an invalid result")
    if result["reason"] == "complete":
        if any(item == "unavailable" for item in (result["baseline_value"], result["observation_value"])):
            fail("benchmark evidence has an invalid result")
        delta = result["observation_value"] - result["baseline_value"]
        expected = ("neutral" if delta == 0 else "improved"
                    if (delta > 0) == (value["definition"]["direction"] == "higher") else "regressed")
        if result["delta"] != delta or result["classification"] != expected:
            fail("benchmark evidence has an invalid result")
    elif result["classification"] != "insufficient" or result["delta"] != "unavailable":
        fail("benchmark evidence has an invalid result")
    identity = {key: value[key] for key in ("definition", "inputs", "windows", "result", "evaluated_at")}
    if value["benchmark_id"] != hashlib.sha256(ledger_payload(identity).encode()).hexdigest()[:24]:
        fail("benchmark evidence identity mismatch")
    return value


def benchmark_report(args, baseline, observation):
    definition = {"version": history_id(args.definition_version, "benchmark definition version"),
                  "metric": args.metric, "direction": args.direction}
    if args.metric not in BENCHMARK_METRICS:
        fail("invalid benchmark metric")
    if len(args.confounder) > 64:
        fail("benchmark confounders exceed bound")
    if not re.fullmatch(r"[0-9a-f]{40}(?:[0-9a-f]{24})?", args.merge_identity):
        fail("invalid benchmark merge identity")
    if args.merged_at < REVIEW_START_MS or args.evaluated_at < args.merged_at:
        fail("invalid benchmark event time")
    verified = args.activation_status == "verified"
    if verified and (args.activation_identity is None or args.activated_at is None):
        fail("verified benchmark activation requires identity and time")
    if not verified and (args.activation_identity is not None or args.activated_at is not None):
        fail("unverified benchmark activation cannot claim identity or time")
    if verified:
        history_id(args.activation_identity, "benchmark activation identity")
        if not args.merged_at <= args.activated_at <= args.evaluated_at:
            fail("invalid benchmark activation time")
    inputs = {"baseline_capture_id": baseline["capture_id"],
              "observation_capture_id": observation["capture_id"],
              "merge_identity": args.merge_identity, "merged_at": args.merged_at,
              "activation_status": args.activation_status,
              "activation_identity": args.activation_identity, "activated_at": args.activated_at}
    windows = "unavailable"
    reason = f"activation_{args.activation_status}" if not verified else "complete"
    if verified:
        windows = {"days": 30,
                   "baseline": {"after": args.activated_at - BENCHMARK_WINDOW_MS,
                                "before": args.activated_at - 1},
                   "observation": {"after": args.activated_at,
                                   "before": args.activated_at + BENCHMARK_WINDOW_MS - 1}}
        if args.evaluated_at < args.activated_at + BENCHMARK_WINDOW_MS:
            reason = "window_incomplete"
        elif (any(baseline["query"].get(name) != windows["baseline"][name] for name in ("after", "before"))
              or any(observation["query"].get(name) != windows["observation"][name] for name in ("after", "before"))):
            reason = "window_mismatch"
    baseline_value = baseline["aggregates"].get(args.metric, "unavailable")
    observation_value = observation["aggregates"].get(args.metric, "unavailable")
    unavailable = ([args.metric] if "unavailable" in (baseline_value, observation_value) else [])
    if reason == "complete" and unavailable:
        reason = "metric_unavailable"
    classification, delta = "insufficient", "unavailable"
    if reason == "complete":
        delta = observation_value - baseline_value
        if delta == 0:
            classification = "neutral"
        elif (delta > 0) == (args.direction == "higher"):
            classification = "improved"
        else:
            classification = "regressed"
    confounders = set(args.confounder)
    if baseline["member_count"] != observation["member_count"]:
        confounders.add("population_drift")
    result = {"classification": classification, "baseline_value": baseline_value,
              "observation_value": observation_value, "delta": delta,
              "confounders": sorted(confounders), "unavailable_metrics": unavailable,
              "association_only": True, "reason": reason}
    identity = {"definition": definition, "inputs": inputs, "windows": windows,
                "result": result, "evaluated_at": args.evaluated_at}
    report = {"schema_version": 1,
              "benchmark_id": hashlib.sha256(ledger_payload(identity).encode()).hexdigest()[:24], **identity}
    return validate_benchmark(report)


def command_benchmark_save(args):
    root = review_root(args.state_root)
    if not ledger_exists(root):
        fail("private review ledger is missing")
    if args.evaluated_at > int(datetime.now(timezone.utc).timestamp() * 1000):
        fail("benchmark evaluation time cannot be in the future")
    require_review_lock_safe(root)
    with review_lock(root) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        connection = ledger_connection(root, write=True)
        try:
            baseline, _ = load_history_capture(connection, args.baseline_capture_id)
            observation, _ = load_history_capture(connection, args.observation_capture_id)
            report = benchmark_report(args, baseline, observation)
            ensure_benchmark_schema(connection)
            connection.execute("BEGIN IMMEDIATE")
            for payload, in connection.execute("SELECT payload FROM benchmark_effects"):
                existing_report = json.loads(payload, object_pairs_hook=no_duplicate_keys)
                if existing_report["inputs"]["merge_identity"] != args.merge_identity:
                    continue
                if existing_report["inputs"]["merged_at"] != args.merged_at:
                    fail("benchmark merge identity is immutable")
                if (args.activation_status == "verified"
                        and existing_report["inputs"]["activation_status"] == "verified"
                        and (existing_report["inputs"]["activation_identity"],
                             existing_report["inputs"]["activated_at"])
                        != (args.activation_identity, args.activated_at)):
                    fail("benchmark first verified activation is immutable")
            definition = connection.execute(
                "SELECT metric_name, direction FROM benchmark_definitions WHERE version=?",
                (args.definition_version,)).fetchone()
            expected = (args.metric, args.direction)
            if definition is not None and definition != expected:
                fail("benchmark definition version is immutable")
            if definition is None:
                connection.execute("INSERT INTO benchmark_definitions VALUES (?, ?, ?)",
                                   (args.definition_version, *expected))
            existing = connection.execute("SELECT payload FROM benchmark_effects WHERE benchmark_id=?",
                                          (report["benchmark_id"],)).fetchone()
            if existing is None:
                connection.execute("INSERT INTO benchmark_effects VALUES (?, ?, ?, ?, ?, ?)",
                                   (report["benchmark_id"], args.definition_version,
                                    args.baseline_capture_id, args.observation_capture_id,
                                    args.activation_identity, ledger_payload(report)))
            elif json.loads(existing[0], object_pairs_hook=no_duplicate_keys) != report:
                fail("benchmark identity collision")
            connection.commit()
        except Exception:
            connection.rollback()
            raise
        finally:
            connection.close()
    print(json.dumps(report, sort_keys=True, separators=(",", ":")))


def command_benchmark(args):
    root = review_root(args.state_root)
    if not ledger_exists(root):
        fail("benchmark evidence is missing")
    require_review_lock_safe(root)
    with existing_review_lock(root):
        with ledger_connection(root) as connection:
            if connection.execute("SELECT value FROM ledger_meta WHERE key='benchmark_schema'").fetchone() is None:
                fail("benchmark evidence is missing")
            row = connection.execute("SELECT payload FROM benchmark_effects WHERE benchmark_id=?",
                                     (args.benchmark_id,)).fetchone()
            if row is None:
                fail("benchmark evidence is missing")
            report = validate_benchmark(json.loads(row[0], object_pairs_hook=no_duplicate_keys))
    print(json.dumps(report, sort_keys=True, separators=(",", ":")))


def command_phase_span(args):
    record_path, record = load(root_dir())
    require_active(record)
    cycle_id = record["cycle_id"]
    if args.event == "start":
        if args.phase is None or args.operation is None or args.attribution is None or args.result is not None:
            fail("phase span start requires phase, operation, and attribution only")
        dependencies = sorted(set(args.dependency or []))
        ownership = sorted(set(phase_path(item) for item in (args.path or [])))
    else:
        if args.result is None or any(value is not None for value in (
                args.parent_span_id, args.phase, args.operation, args.attribution)) or args.dependency or args.path:
            fail("phase span finish requires only span ID and result")
    root = review_root(args.state_root)
    if not OPAQUE_ID.fullmatch(args.span_id):
        fail("invalid phase span ID")
    timestamp = max(REVIEW_START_MS, int(time.time() * 1000))
    require_review_lock_safe(root)
    with review_lock(root) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        connection = ensure_ledger_for_write(root)
        ensure_phase_schema(connection)
        try:
            connection.execute("BEGIN IMMEDIATE")
            if args.event == "start":
                row = (cycle_id, args.span_id, args.parent_span_id, args.phase, args.operation,
                       args.attribution, ledger_payload(dependencies), ledger_payload(ownership),
                       timestamp, None, None)
                phase_record(row)
                if args.parent_span_id is not None and connection.execute(
                        "SELECT 1 FROM phase_spans WHERE cycle_id=? AND span_id=?",
                        (cycle_id, args.parent_span_id)).fetchone() is None:
                    fail("phase span parent is missing")
                for dependency in dependencies:
                    dependency_row = connection.execute(
                        "SELECT finished_at FROM phase_spans WHERE cycle_id=? AND span_id=?",
                        (cycle_id, dependency),
                    ).fetchone()
                    if dependency_row is None or dependency_row[0] is None:
                        fail("phase span dependency is incomplete")
                    if timestamp < dependency_row[0]:
                        fail("phase span dependency timing is invalid")
                existing = connection.execute(
                    "SELECT cycle_id, span_id, parent_span_id, phase, operation, attribution, dependencies, "
                    "ownership_paths, started_at, finished_at, result FROM phase_spans "
                    "WHERE cycle_id=? AND span_id=?", (cycle_id, args.span_id),
                ).fetchone()
                if existing is None:
                    connection.execute("INSERT INTO phase_spans VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)", row)
                else:
                    existing = phase_record(existing)
                    expected = phase_record(row)
                    comparable = ("cycle_id", "span_id", "parent_span_id", "phase", "operation",
                                  "attribution", "dependencies", "ownership_paths", "finished_at", "result")
                    if any(existing[name] != expected[name] for name in comparable):
                        fail("phase span ID conflicts with existing marker")
            else:
                row = connection.execute(
                    "SELECT started_at, finished_at, result FROM phase_spans WHERE cycle_id=? AND span_id=?",
                    (cycle_id, args.span_id),
                ).fetchone()
                if row is None:
                    fail("phase span start is missing")
                if row[1] is not None:
                    if row[2] != args.result:
                        fail("phase span result conflicts with existing marker")
                else:
                    connection.execute(
                        "UPDATE phase_spans SET finished_at=max(started_at, ?), result=? "
                        "WHERE cycle_id=? AND span_id=?",
                        (timestamp, args.result, cycle_id, args.span_id),
                    )
            report = phase_report(phase_rows(connection, cycle_id), cycle_id)
            connection.commit()
            record["phase_profile"] = report
            save(record_path, record)
        except Exception:
            connection.rollback()
            raise
        finally:
            connection.close()
    print(json.dumps(report, sort_keys=True, separators=(",", ":")))


def command_phase_report(args):
    _, record = load(root_dir())
    root = review_root(args.state_root)
    require_review_lock_safe(root)
    with existing_review_lock(root):
        report = load_phase_report(root, record["cycle_id"])
    print(json.dumps(report, sort_keys=True, separators=(",", ":")))


def command_cycle_performance(args):
    filters = {name: value for name, value in (
        ("context", args.context), ("risk", args.risk),
        ("delivery_intent", args.delivery_intent), ("method_revision", args.method_revision),
    ) if value is not None}
    if args.context is not None and not OPAQUE_ID.fullmatch(args.context):
        fail("invalid context")
    if args.method_revision is not None and not OPAQUE_ID.fullmatch(args.method_revision):
        fail("invalid method revision")
    records = completed_cycle_records(root_dir())
    root = review_root(args.state_root)
    spans = {}
    require_review_lock_safe(root)
    if ledger_exists(root):
        with existing_review_lock(root):
            with ledger_connection(root) as connection:
                if connection.execute(
                        "SELECT value FROM ledger_meta WHERE key='phase_schema'").fetchone() is not None:
                    for record in records:
                        spans[record["cycle_id"]] = phase_rows(connection, record["cycle_id"])
    print(json.dumps(cycle_performance(records, spans, filters),
                     sort_keys=True, separators=(",", ":")))


def execution_dag(value, requested_mode, risk, activated=False):
    if (not isinstance(value, dict) or set(value) != {"nodes", "completed"}
            or not isinstance(value["nodes"], list) or not isinstance(value["completed"], list)
            or not 1 <= len(value["nodes"]) <= 100):
        fail("execution DAG has an invalid schema")
    nodes = {}
    fields = {"id", "depends_on", "operation", "ownership_paths"}
    for item in value["nodes"]:
        if (not isinstance(item, dict) or set(item) != fields
                or not isinstance(item.get("id"), str) or not OPAQUE_ID.fullmatch(item["id"])
                or item["id"] in nodes or item.get("operation") not in ("read", "readonly_qa", "reconcile")
                or not isinstance(item.get("depends_on"), list)
                or len(item["depends_on"]) > 100 or len(set(item["depends_on"])) != len(item["depends_on"])
                or any(not isinstance(dependency, str) or not OPAQUE_ID.fullmatch(dependency)
                       or dependency == item["id"] for dependency in item["depends_on"])
                or not isinstance(item.get("ownership_paths"), list)
                or not 0 <= len(item["ownership_paths"]) <= 100):
            fail("execution DAG node has an invalid operation or schema")
        nodes[item["id"]] = {**item, "depends_on": sorted(item["depends_on"]),
                             "ownership_paths": sorted(set(phase_path(path)
                                                            for path in item["ownership_paths"]))}
        if ((item["operation"] == "reconcile") != (not item["ownership_paths"])):
            fail("execution DAG reconciliation ownership is invalid")
    completed = value["completed"]
    if (len(completed) != len(set(completed)) or any(
            not isinstance(item, str) or not OPAQUE_ID.fullmatch(item) or item not in nodes
            for item in completed)):
        fail("execution DAG completed nodes are invalid")
    for item in nodes.values():
        unknown = set(item["depends_on"]) - set(nodes)
        if unknown:
            fail("execution DAG contains an unknown dependency")
    indegree = {key: len(item["depends_on"]) for key, item in nodes.items()}
    children = {key: [] for key in nodes}
    for key, item in nodes.items():
        for dependency in item["depends_on"]:
            children[dependency].append(key)
    ready = sorted(key for key, degree in indegree.items() if degree == 0)
    order = []
    while ready:
        key = ready.pop(0)
        order.append(key)
        for child in sorted(children[key]):
            indegree[child] -= 1
            if indegree[child] == 0:
                ready.append(child)
                ready.sort()
    if len(order) != len(nodes):
        fail("execution DAG contains a cycle")

    ancestors = {}
    for key in order:
        ancestors[key] = set(nodes[key]["depends_on"])
        for dependency in nodes[key]["depends_on"]:
            ancestors[key].update(ancestors[dependency])
    reconciliation = [key for key, item in nodes.items() if item["operation"] == "reconcile"]
    if len(reconciliation) != 1:
        fail("execution DAG requires one reconciliation node")
    reconciliation_id = reconciliation[0]
    workers = set(nodes) - {reconciliation_id}
    if not workers <= ancestors[reconciliation_id]:
        fail("execution DAG reconciliation must depend on every worker")
    completed_set = set(completed)
    if any(not ancestors[key] <= completed_set for key in completed_set):
        fail("execution DAG completed nodes lack completed dependencies")
    if reconciliation_id in completed_set and not workers <= completed_set:
        fail("execution DAG reconciliation completed before its workers")
    overlapping = set()
    keys = sorted(nodes)
    for position, left in enumerate(keys):
        for right in keys[position + 1:]:
            if reconciliation_id in (left, right):
                continue
            if left in ancestors[right] or right in ancestors[left]:
                continue
            left_paths = [PurePosixPath(path).parts for path in nodes[left]["ownership_paths"]]
            right_paths = [PurePosixPath(path).parts for path in nodes[right]["ownership_paths"]]
            if any(a[:len(b)] == b or b[:len(a)] == a for a in left_paths for b in right_paths):
                overlapping.update((left, right))
    reasons = []
    forced = set()
    if requested_mode == "serial":
        reasons.append("requested_serial")
        forced.update(workers)
    elif risk == "critical":
        reasons.append("critical_risk")
        forced.update(workers)
    elif overlapping:
        reasons.append("ownership_overlap")
        forced.update(overlapping)
    elif requested_mode == "benchmark":
        reasons.append("benchmark_only")
    elif not activated:
        reasons.append("benchmark_not_qualified")
        forced.update(workers)
    mode = "serial" if forced else "concurrent"
    ready_now = sorted(key for key, item in nodes.items()
                       if key not in completed and set(item["depends_on"]) <= set(completed))
    return {"schema_version": 1, "requested_mode": requested_mode, "mode": mode,
            "order": order, "ready": ready_now, "forced_serial": sorted(forced),
            "reconciliation_id": reconciliation_id, "reasons": reasons}


def command_execution_dag(args):
    _, record = load(root_dir())
    require_active(record)
    try:
        value = json.loads(args.dag_json, object_pairs_hook=no_duplicate_keys)
    except json.JSONDecodeError as error:
        fail(f"cannot read execution DAG: {error}")
    activated = load_execution_activation(review_root(args.state_root))
    print(json.dumps(execution_dag(value, args.mode, record["risk"], activated),
                     sort_keys=True, separators=(",", ":")))


def command_execution_benchmark(args):
    repository = root_dir()
    _, record = load(repository)
    require_active(record)
    fixture = {"id": args.fixture_id, "commit": args.fixture_commit,
               "path": args.fixture_path, "blob": args.fixture_blob}
    if (not OPAQUE_ID.fullmatch(fixture["id"])
            or not re.fullmatch(r"[0-9a-f]{40}(?:[0-9a-f]{24})?", fixture["commit"])
            or not fixture["path"].startswith("tests/fixtures/")
            or phase_path(fixture["path"]) != fixture["path"]
            or not re.fullmatch(r"[0-9a-f]{40}(?:[0-9a-f]{24})?", fixture["blob"])
            or git_read(repository, "merge-base", "--is-ancestor", fixture["commit"], "HEAD", check=False).returncode
            or git_read(repository, "rev-parse", f"{fixture['commit']}:{fixture['path']}", check=False).stdout.strip()
            != fixture["blob"]):
        fail("execution benchmark fixture identity is invalid")
    fixture_text = git_read(repository, "show", f"{fixture['commit']}:{fixture['path']}").stdout
    if len(fixture_text.encode()) > 64 * 1024:
        fail("execution benchmark fixture is too large")
    fixture_value = json.loads(fixture_text, object_pairs_hook=no_duplicate_keys)
    fixture_fields = {"schema_version", "fixture_id", "warmup_pairs", "measured_pairs",
                      "synthetic_delay_ms", "required_gates", "dag"}
    if (not isinstance(fixture_value, dict) or set(fixture_value) != fixture_fields
            or fixture_value.get("schema_version") != 1 or fixture_value.get("fixture_id") != fixture["id"]
            or fixture_value.get("warmup_pairs") != 1 or fixture_value.get("measured_pairs") != 5
            or type(fixture_value.get("synthetic_delay_ms")) is not int
            or not 1 <= fixture_value["synthetic_delay_ms"] <= 1000
            or not isinstance(fixture_value.get("required_gates"), list)
            or fixture_value["required_gates"] != sorted(set(fixture_value["required_gates"]))
            or any(gate not in GATES for gate in fixture_value["required_gates"])
            or not MANDATORY_GATES <= set(fixture_value["required_gates"])):
        fail("execution benchmark fixture contract is invalid")
    authorization = execution_dag(fixture_value["dag"], "benchmark", record["risk"], False)
    if authorization["mode"] != "concurrent" or authorization["reasons"] != ["benchmark_only"]:
        fail("execution benchmark fixture is not concurrency-safe")
    workers = [node for node in fixture_value["dag"]["nodes"] if node["operation"] != "reconcile"]
    if not 2 <= len(workers) <= 16 or any(len(node["ownership_paths"]) != 1 for node in workers):
        fail("execution benchmark fixture worker count is invalid")
    delay = fixture_value["synthetic_delay_ms"] / 1000
    worker_by_id = {node["id"]: node for node in workers}
    def task(node):
        path = node["ownership_paths"][0]
        result = subprocess.run(
            ["git", "show", f"{fixture['commit']}:{path}"], cwd=repository,
            stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, env=INSPECT_ENV,
        )
        if result.returncode:
            fail("execution benchmark fixture read failed")
        time.sleep(delay)
    def serial_run():
        for node_id in authorization["order"]:
            if node_id in worker_by_id:
                task(worker_by_id[node_id])
    def concurrent_run():
        completed, pending = set(), set(worker_by_id)
        while pending:
            ready = sorted(node_id for node_id in pending
                           if set(worker_by_id[node_id]["depends_on"]) <= completed)
            if not ready:
                fail("execution benchmark fixture has no ready worker")
            with concurrent.futures.ThreadPoolExecutor(max_workers=len(ready)) as pool:
                list(pool.map(task, (worker_by_id[node_id] for node_id in ready)))
            completed.update(ready)
            pending.difference_update(ready)
    serial_run()
    concurrent_run()
    gate_digest = hashlib.sha256(ledger_payload(fixture_value["required_gates"]).encode()).hexdigest()
    pairs = []
    for index in range(fixture_value["measured_pairs"]):
        started = time.monotonic()
        serial_run()
        serial_ms = max(1, round((time.monotonic() - started) * 1000))
        started = time.monotonic()
        concurrent_run()
        concurrent_ms = max(1, round((time.monotonic() - started) * 1000))
        pairs.append({"pair_id": f"pair-{index + 1}", "serial_ms": serial_ms,
                      "concurrent_ms": concurrent_ms, "serial_status": "passed",
                      "concurrent_status": "passed", "serial_gate_digest": gate_digest,
                      "concurrent_gate_digest": gate_digest, "serial_remediation_rounds": 0,
                      "concurrent_remediation_rounds": 0})
    serial_median = median(pair["serial_ms"] for pair in pairs)
    concurrent_median = median(pair["concurrent_ms"] for pair in pairs)
    improvement = round((serial_median - concurrent_median) * 100 / serial_median, 2)
    report = validate_execution_benchmark({
        "schema_version": 1, "method_revision": CURRENT_METHOD_REVISION,
        "fixture": fixture, "warmup_pairs": fixture_value["warmup_pairs"], "pairs": pairs,
        "sample_count": len(pairs), "required_gate_digest": gate_digest,
        "serial_median_ms": serial_median,
        "concurrent_median_ms": concurrent_median, "improvement_percent": improvement,
        "activated": concurrent_median <= serial_median * .9
        and all(pair["concurrent_remediation_rounds"] <= pair["serial_remediation_rounds"] for pair in pairs),
        "recorded_at": max(REVIEW_START_MS, int(time.time() * 1000)),
    })
    root = review_root(args.state_root)
    require_review_lock_safe(root)
    with review_lock(root) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        connection = ensure_ledger_for_write(root)
        ensure_phase_schema(connection)
        try:
            connection.execute("BEGIN IMMEDIATE")
            connection.execute("INSERT OR REPLACE INTO execution_activation VALUES (?, ?)",
                               (CURRENT_METHOD_REVISION, ledger_payload(report)))
            connection.commit()
        except Exception:
            connection.rollback()
            raise
        finally:
            connection.close()
    print(json.dumps(report, sort_keys=True, separators=(",", ":")))


def command_review_migrate(args):
    root = review_root(args.state_root)
    require_review_lock_safe(root)
    with review_lock(root) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if ledger_exists(root):
            with ledger_connection(root, write=True) as connection:
                recover_forget_state(root, connection)
                ledger_integrity(connection)
                digest = content_digest(ledger_content(connection))
            print(json.dumps({"migrated": False, "digest": digest}, sort_keys=True))
            return
        legacy_json_files(root)
        index = review_index(root)
        reports = [(path.stem, report) for path, report, _ in review_reports(root)]
        evidence = sorted(history_evidence(root), key=lambda item: item["session_id"])
        saved_reports = sorted(((item["report_id"], item) for item in history_reports(root)))
        cohorts = sorted(((item["report_id"], item) for item in history_cohorts(root)))
        source = {"index": index, "review_reports": reports, "history_evidence": evidence,
                  "history_reports": saved_reports, "history_cohorts": cohorts}
        source_digest = content_digest(source)
        backup_name, backup_digest = backup_legacy_json(root)
        directory = root / "reviews"
        descriptor, temporary = tempfile.mkstemp(prefix=".ledger-migrate-", suffix=".sqlite3", dir=directory)
        os.close(descriptor)
        temporary = Path(temporary)
        try:
            os.chmod(temporary, 0o600)
            connection = sqlite3.connect(temporary)
            connection.execute("PRAGMA foreign_keys=ON")
            connection.execute("PRAGMA synchronous=FULL")
            ledger_schema(connection)
            connection.commit()
            connection.execute("BEGIN IMMEDIATE")
            names = {"sessions": "session", "cycles": "cycle", "forgotten_sessions": "forgotten_session"}
            for field, kind in names.items():
                connection.executemany("INSERT INTO review_tombstones VALUES (?, ?, ?)",
                                       ((kind, key, value) for key, value in index[field].items()))
            for report_id, report in reports:
                ledger_put_review_report(connection, report_id, report)
            for item in evidence:
                ledger_put_history_evidence(connection, item)
            for _, item in saved_reports:
                ledger_put_history_report(connection, "report", item)
            for _, item in cohorts:
                ledger_put_history_report(connection, "cohort", item)
            connection.execute("INSERT INTO ledger_meta VALUES ('migration_digest', ?)", (source_digest,))
            connection.commit()
            ledger_integrity(connection)
            if content_digest(ledger_content(connection)) != source_digest:
                fail("private review ledger migration content mismatch")
            connection.close()
            os.replace(temporary, ledger_path(root))
            os.chmod(ledger_path(root), 0o600)
            fsync_directory(directory)
        except Exception:
            if "connection" in locals():
                connection.close()
            raise
        finally:
            temporary.unlink(missing_ok=True)
    print(json.dumps({"migrated": True, "digest": source_digest, "backup": backup_name,
                      "backup_digest": backup_digest}, sort_keys=True))


def command_review_backup(args):
    root = review_root(args.state_root)
    require_review_lock_safe(root)
    with review_lock(root) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        connection = ledger_connection(root, write=True)
        recover_forget_state(root, connection)
        connection.close()
        name, digest = create_ledger_backup(root)
    print(json.dumps({"backup": name, "digest": digest}, sort_keys=True))


def command_review_restore(args):
    root = review_root(args.state_root)
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}\.sqlite3", args.backup):
        fail("invalid private review backup name")
    source_path = root / "reviews" / "backups" / args.backup
    require_review_lock_safe(root)
    with review_lock(root) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        connection = ledger_connection(root, write=True)
        recover_forget_state(root, connection)
        privacy_rows = knowledge_privacy_rows(connection)
        privacy_sequence = int(connection.execute(
            "SELECT value FROM ledger_meta WHERE key='knowledge_privacy_sequence'").fetchone()[0])
        connection.close()
        if source_path.is_symlink() or not source_path.is_file():
            fail("private review backup is missing or unsafe")
        if source_path.stat().st_mode & 0o077:
            fail("private review backup permissions are too broad")
        with ledger_connection(root, path=source_path) as source:
            ledger_integrity(source)
        rollback, _ = create_ledger_backup(root, prefix="rollback")
        directory = root / "reviews"
        descriptor, temporary = tempfile.mkstemp(prefix=".ledger-restore-", suffix=".sqlite3", dir=directory)
        os.close(descriptor)
        temporary = Path(temporary)
        try:
            os.chmod(temporary, 0o600)
            source = ledger_connection(root, path=source_path)
            destination = sqlite3.connect(temporary)
            source.backup(destination)
            destination.commit()
            source.close()
            destination.close()
            restored = ledger_connection(root, write=True, path=temporary)
            try:
                restored.execute("BEGIN IMMEDIATE")
                restored_sequence = int(restored.execute(
                    "SELECT value FROM ledger_meta WHERE key='knowledge_privacy_sequence'").fetchone()[0])
                restored.executemany(
                    "INSERT INTO knowledge_privacy_tombstones VALUES (?, ?, ?, ?) "
                    "ON CONFLICT(family,item_id) DO UPDATE SET reason=excluded.reason, "
                    "timestamp=max(timestamp,excluded.timestamp)", privacy_rows)
                tombstones = knowledge_privacy_rows(restored)
                unknown = {row[0] for row in tombstones} - {
                    "telemetry", "review", "history_report", "history_capture", "benchmark",
                    "provider_evaluation", "incident", "incident_signal"}
                if unknown:
                    fail("private review restore contains unsupported privacy tombstones")
                for family, session_id, _, timestamp in tombstones:
                    if family != "telemetry":
                        continue
                    dependent = [row[0] for row in restored.execute(
                        "SELECT report_id FROM history_report_members WHERE session_id=?", (session_id,))]
                    restored.execute("DELETE FROM history_evidence WHERE session_id=?", (session_id,))
                    for report_id in dependent:
                        restored.execute("DELETE FROM ledger_entries WHERE scope='history' AND report_id=?", (report_id,))
                        restored.execute("DELETE FROM history_reports WHERE report_id=?", (report_id,))
                    if restored.execute(
                            "SELECT 1 FROM sqlite_master WHERE type='table' AND name='history_capture_members'").fetchone():
                        captures = [row[0] for row in restored.execute(
                            "SELECT capture_id FROM history_capture_members WHERE session_id=?", (session_id,))]
                        delete_capture_benchmarks(restored, captures, timestamp)
                        restored.executemany("DELETE FROM history_captures WHERE capture_id=?",
                                             ((capture_id,) for capture_id in captures))
                    restored.execute(
                        "INSERT INTO review_tombstones VALUES ('forgotten_session', ?, ?) "
                        "ON CONFLICT(kind, item_id) DO UPDATE SET timestamp=max(timestamp, excluded.timestamp)",
                        (session_id, timestamp),
                    )
                for family, report_id, _, _ in knowledge_privacy_rows(restored):
                    if family != "history_report":
                        continue
                    restored.execute("DELETE FROM ledger_entries WHERE scope='history' AND report_id=?",
                                     (report_id,))
                    restored.execute("DELETE FROM history_reports WHERE report_id=?", (report_id,))
                for family, report_id, _, _ in knowledge_privacy_rows(restored):
                    if family != "review":
                        continue
                    restored.execute("DELETE FROM ledger_entries WHERE scope='operational' AND report_id=?",
                                     (report_id,))
                    restored.execute("DELETE FROM review_reports WHERE report_id=?", (report_id,))
                for family, capture_id, _, timestamp in knowledge_privacy_rows(restored):
                    if family != "history_capture":
                        continue
                    delete_capture_benchmarks(restored, [capture_id], timestamp)
                    if restored.execute(
                            "SELECT 1 FROM sqlite_master WHERE type='table' "
                            "AND name='history_captures'").fetchone():
                        restored.execute("DELETE FROM history_captures WHERE capture_id=?", (capture_id,))
                if restored.execute(
                        "SELECT 1 FROM sqlite_master WHERE type='table' "
                        "AND name='benchmark_effects'").fetchone():
                    restored.execute("DELETE FROM benchmark_effects WHERE benchmark_id IN "
                                     "(SELECT item_id FROM knowledge_privacy_tombstones "
                                     "WHERE family='benchmark')")
                if restored.execute(
                        "SELECT 1 FROM sqlite_master WHERE type='table' "
                        "AND name='provider_evaluation_reports'").fetchone():
                    restored.execute("DELETE FROM provider_evaluation_reports WHERE report_id IN "
                                     "(SELECT item_id FROM knowledge_privacy_tombstones "
                                     "WHERE family='provider_evaluation')")
                restored.execute("DELETE FROM incidents WHERE incident_id IN "
                                 "(SELECT item_id FROM knowledge_privacy_tombstones "
                                 "WHERE family='incident')")
                restored.execute(
                    "INSERT INTO incident_signal_dispositions(signal_id,incident_id,disposition,timestamp) "
                    "SELECT item_id,NULL,'forgotten',timestamp FROM knowledge_privacy_tombstones "
                    "WHERE family='incident_signal' "
                    "ON CONFLICT(signal_id) DO UPDATE SET incident_id=NULL,disposition='forgotten',"
                    "timestamp=max(timestamp,excluded.timestamp)")
                merged_rows = knowledge_privacy_rows(restored)
                added = len({tuple(row) for row in merged_rows} - {tuple(row) for row in privacy_rows})
                sequence = max(privacy_sequence, restored_sequence) + added
                restored.execute("UPDATE ledger_meta SET value=? WHERE key='knowledge_privacy_sequence'",
                                 (str(sequence),))
                restored.execute("UPDATE ledger_meta SET value=? WHERE key='knowledge_privacy_digest'",
                                 (knowledge_privacy_digest(restored),))
                prune_phase_spans(root, connection=restored)
                restored.commit()
            except Exception:
                restored.rollback()
                raise
            finally:
                restored.close()
            with ledger_connection(root, path=temporary) as check:
                ledger_integrity(check)
            os.replace(temporary, ledger_path(root))
            os.chmod(ledger_path(root), 0o600)
            fsync_directory(directory)
        finally:
            temporary.unlink(missing_ok=True)
    print(json.dumps({"restored": args.backup, "rollback": rollback}, sort_keys=True))


def command_review_history_save(args):
    try:
        report = validate_history_report_input(json.loads(args.report_json, object_pairs_hook=no_duplicate_keys))
    except json.JSONDecodeError as error:
        fail(f"cannot read review history report: {error}")
    root = review_root(args.state_root)
    excluded_family = historical_excluded_family(args.database, args.excluded_session_id,
                                                 args.excluded_message_id)
    with review_lock(root) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        connection = ensure_ledger_for_write(root)
        records = {item["session_id"]: item for item in history_evidence(root)}
        text_fields = {"findings", "scorecards", "trends", "proposals", "caveats"}
        scan_fields = {"snapshot", "session_ceiling", "part_ceiling", "database_digest"}
        page_fields = {"limit", "cursor"}
        cohort = report["cohort"]
        ids = [history_id(item, "history cohort ID") for item in cohort]
        if set(ids).intersection(excluded_family):
            fail("review history report cohort contains an excluded session")
        missing = [item for item in ids if item not in records]
        refresh = all(name in report for name in scan_fields)
        wanted = ids if refresh else missing
        if wanted:
            if (any(type(report.get(name)) is not int for name in ("snapshot", "session_ceiling", "part_ceiling"))
                    or not isinstance(report.get("database_digest"), str)):
                fail("review history report cohort evidence is unavailable")
            history_digest(report["database_digest"], "database digest")
            page_bound = page_fields <= set(report)
            scan = review_scan(argparse.Namespace(
                database=args.database, state_root=args.state_root, limit=REVIEW_MAX_LIMIT,
                cursor=0, snapshot=report["snapshot"],
                session_ceiling=report["session_ceiling"], part_ceiling=report["part_ceiling"],
                database_digest=report["database_digest"], lock_held=True,
                include_reviewed=True, history_metrics=True, history_all=True, bind_history=True,
                excluded_session_id=args.excluded_session_id, excluded_message_id=args.excluded_message_id,
                allow_database_drift=page_bound,
            ))
            candidates = scan["candidates"]
            if set(ids).intersection(scan["_excluded_session_ids"]):
                fail("review history report cohort contains an excluded session")
            if page_bound:
                archive = {name: report[name] for name in scan_fields}
                live = {item["session_id"]: candidate_history_evidence(item, archive, mark_reviewed=False)
                        for item in candidates}
                if set(ids) - set(live) - set(records):
                    fail("review history report cohort evidence is unavailable")
                available = {key: {**records.get(key, {}), **value} for key, value in live.items()}
                available.update({key: value for key, value in records.items() if key not in live})
                page = [available[item] for item in ids]
                current_query_digest = review_digest(page, report["snapshot"], report["session_ceiling"],
                                                     report["part_ceiling"],
                                                     history_page_digest(page, scan["_source_identities"],
                                                                         report["limit"], report["cursor"]))
                if current_query_digest != report["query_digest"]:
                    fail("OpenCode database changed within the review snapshot")
            selected = {item["session_id"]: item for item in candidates if item["session_id"] in wanted}
            if set(wanted) - set(selected) - set(records):
                fail("review history report cohort evidence is unavailable")
            archive = {"snapshot": report["snapshot"], "session_ceiling": report["session_ceiling"],
                       "part_ceiling": report["part_ceiling"], "database_digest": report["database_digest"]}
            captured = {key: candidate_history_evidence(value, archive, mark_reviewed=False)
                        for key, value in selected.items()}
            records.update(captured)
        else:
            captured = {}
        stored = {key: value for key, value in report.items() if key not in scan_fields | page_fields}
        stored.update({name: report.get(name, []) for name in text_fields})
        stored["evidence"] = [records[item] for item in ids]
        report_id = hashlib.sha256(json.dumps(stored, sort_keys=True, separators=(",", ":")).encode()).hexdigest()[:24]
        stored["report_id"] = report_id
        history_report_value = validate_history_report(stored)
        try:
            connection.execute("BEGIN IMMEDIATE")
            ledger_put_history_report(connection, "report", history_report_value)
            connection.commit()
        except Exception:
            connection.rollback()
            raise
        finally:
            connection.close()
    print(json.dumps({"report_id": report_id}, sort_keys=True))


def improvement_id(value, name):
    if not isinstance(value, str) or not OPAQUE_ID.fullmatch(value):
        fail(f"invalid improvement {name}")
    return value


def improvement_presentation_id(value, name):
    if not isinstance(value, str) or not PRESENTATION_ID.fullmatch(value):
        fail(f"invalid improvement {name}")
    return value


def improvement_path(value):
    if not isinstance(value, str):
        fail("invalid improvement scope path")
    pure = PurePosixPath(value)
    normalized = str(pure)
    if pure.is_absolute() or not pure.parts or ".." in pure.parts or normalized in ("", "."):
        fail("invalid improvement scope path")
    return normalized


def improvement_summary(value):
    if not isinstance(value, str):
        fail("invalid improvement summary")
    normalized = " ".join(value.split())
    if not 1 <= len(normalized.encode()) <= 512 or review_unsafe(normalized):
        fail("unsafe improvement summary")
    return normalized


def improvement_opportunity_id(summary, kind="fix", measurement_plan=None):
    canonical = json.dumps({"summary": improvement_summary(summary).casefold(), "kind": kind,
                            "measurement_plan": measurement_plan}, sort_keys=True, separators=(",", ":"))
    return hashlib.sha256(b"dbsctr-improvement\0" + canonical.encode()).hexdigest()


def improvement_bounded_text(value, label):
    if not isinstance(value, str):
        fail(f"invalid {label}")
    normalized = " ".join(value.split())
    if not 1 <= len(normalized.encode()) <= 512 or review_unsafe(normalized):
        fail(f"unsafe {label}")
    return normalized


def improvement_json(value, label):
    try:
        payload = json.loads(value, object_pairs_hook=no_duplicate_keys) if isinstance(value, str) else value
    except json.JSONDecodeError:
        fail(f"invalid {label}")
    if not isinstance(payload, dict):
        fail(f"invalid {label}")
    return payload


def improvement_measurement_plan(value):
    payload = improvement_json(value, "improvement measurement plan")
    fields = {"schema_version", "hypothesis", "baseline", "metric", "procedure",
              "success_threshold", "evidence_path"}
    if set(payload) != fields or payload.get("schema_version") != 1:
        fail("invalid improvement measurement plan")
    for field in fields - {"schema_version", "evidence_path"}:
        payload[field] = improvement_bounded_text(payload[field], f"measurement plan {field}")
    payload["evidence_path"] = improvement_path(payload["evidence_path"])
    return json.dumps(payload, sort_keys=True, separators=(",", ":"))


def improvement_discovery_report(value):
    payload = improvement_json(value, "improvement discovery report")
    fields = {"schema_version", "interview", "assumptions", "citations", "risks", "evidence_digest"}
    if (set(payload) != fields or payload.get("schema_version") != 1
            or not isinstance(payload.get("interview"), list) or not 1 <= len(payload["interview"]) <= 20
            or not isinstance(payload.get("evidence_digest"), str)
            or not re.fullmatch(r"[0-9a-f]{64}", payload["evidence_digest"])):
        fail("invalid improvement discovery report")
    interview = []
    for item in payload["interview"]:
        if not isinstance(item, dict) or set(item) != {"question", "answer"}:
            fail("invalid improvement discovery report")
        interview.append({key: improvement_bounded_text(item[key], f"discovery {key}")
                          for key in ("question", "answer")})
    payload["interview"] = interview
    for field in ("assumptions", "citations", "risks"):
        if not isinstance(payload.get(field), list) or len(payload[field]) > 20:
            fail("invalid improvement discovery report")
        payload[field] = [improvement_bounded_text(item, f"discovery {field}") for item in payload[field]]
    return json.dumps(payload, sort_keys=True, separators=(",", ":"))


def improvement_implementation_report(value):
    payload = improvement_json(value, "improvement implementation report")
    fields = {"schema_version", "pull_request_url", "changed_paths", "diff_digest", "passed_gates"}
    if (set(payload) != fields or payload.get("schema_version") != 1
            or not isinstance(payload.get("pull_request_url"), str)
            or not re.fullmatch(r"https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/pull/[1-9][0-9]*",
                                payload["pull_request_url"])
            or not isinstance(payload.get("diff_digest"), str)
            or not re.fullmatch(r"[0-9a-f]{64}", payload["diff_digest"])):
        fail("invalid improvement implementation report")
    if (not isinstance(payload.get("changed_paths"), list) or not payload["changed_paths"]
            or payload["changed_paths"] != sorted(set(payload["changed_paths"]))):
        fail("invalid improvement implementation report")
    payload["changed_paths"] = [improvement_path(path) for path in payload["changed_paths"]]
    if (not isinstance(payload.get("passed_gates"), list)
            or payload["passed_gates"] != sorted(set(payload["passed_gates"]))
            or any(not isinstance(gate, str) or not OPAQUE_ID.fullmatch(gate) for gate in payload["passed_gates"])):
        fail("invalid improvement implementation report")
    return json.dumps(payload, sort_keys=True, separators=(",", ":"))


def improvement_readiness(value, worker_id, session_id, opportunity_id, validate_evidence=False):
    try:
        receipt = json.loads(value, object_pairs_hook=no_duplicate_keys) if isinstance(value, str) else value
    except json.JSONDecodeError:
        fail("invalid autonomous readiness receipt")
    fields = {"schema_version", "worker_id", "session_id", "opportunity_id", "risk",
              "material_questions_resolved", "evidence_digest"}
    if (not isinstance(receipt, dict) or set(receipt) != fields or receipt.get("schema_version") != 1
            or receipt.get("worker_id") != worker_id or receipt.get("session_id") != session_id
            or receipt.get("opportunity_id") != opportunity_id
            or receipt.get("risk") not in {"routine", "elevated", "critical"}
            or receipt.get("material_questions_resolved") is not True
            or not isinstance(receipt.get("evidence_digest"), str)
            or not re.fullmatch(r"[0-9a-f]{64}", receipt["evidence_digest"])):
        fail("invalid autonomous readiness receipt")
    if not validate_evidence:
        return json.dumps(receipt, sort_keys=True, separators=(",", ":"))
    path = Path(os.environ.get(
        "DBSCTR_RND_STATE", Path.home() / ".local/state/dotfiles-ai/dbsctr-rnd.sqlite3"
    )).expanduser()
    try:
        details = path.lstat()
        if (path.is_symlink() or stat.S_IFMT(details.st_mode) != stat.S_IFREG
                or details.st_uid != os.getuid() or stat.S_IMODE(details.st_mode) != 0o600):
            fail("autonomous readiness evidence is unavailable")
        connection = sqlite3.connect(f"file:{quote(str(path))}?mode=ro", uri=True, timeout=5)
        try:
            connection.execute("PRAGMA query_only=ON")
            connection.execute("PRAGMA trusted_schema=OFF")
            if connection.execute("PRAGMA integrity_check").fetchone() != ("ok",):
                fail("autonomous readiness evidence is unavailable")
            columns = tuple(row[1] for row in connection.execute("PRAGMA table_info(parallel_lens_passes)"))
            expected = ("worker_id", "lens_name", "capture_day", "manifest_digest", "outcome",
                        "recorded_at", "cadence", "no_yield_count", "quarter", "next_eligible_at",
                        "page_count", "session_count", "review_session_count",
                        "excluded_review_session_count", "unattributed_session_count", "source_count",
                         "opportunity_id", "session_id")
            if (connection.execute(
                    "SELECT value FROM scheduler_meta WHERE key='schema_version'").fetchone() not in {("7",), ("8",)}
                    or columns != expected):
                fail("autonomous readiness evidence is unavailable")
            evidence = connection.execute(
                "SELECT 1 FROM parallel_lens_passes "
                "WHERE worker_id=? AND session_id=? AND opportunity_id=? AND manifest_digest=? AND outcome='yield'",
                (worker_id, session_id, opportunity_id, receipt["evidence_digest"]),
            ).fetchone()
        finally:
            connection.close()
    except (OSError, sqlite3.Error):
        fail("autonomous readiness evidence is unavailable")
    if evidence != (1,):
        fail("autonomous readiness evidence does not match the worker")
    return json.dumps(receipt, sort_keys=True, separators=(",", ":"))


def improvement_worker(connection, worker_id):
    row = connection.execute("""
        SELECT worker_id, session_id, opportunity_id, summary, priority, kind, measurement_plan,
               discovery_report, implementation_report, authorization, readiness, state, resume_state,
               recovery_attempts, workspace_id, tab_id, pane_id, cycle_id,
               pr_number, pr_url, created_at, updated_at
        FROM improvement_workers WHERE worker_id=?
    """, (worker_id,)).fetchone()
    if row is None:
        fail("improvement worker is missing")
    names = ("worker_id", "session_id", "opportunity_id", "summary", "priority", "kind", "measurement_plan",
             "discovery_report", "implementation_report", "authorization", "readiness", "state", "resume_state",
             "recovery_attempts", "workspace_id", "tab_id", "pane_id", "cycle_id",
             "pr_number", "pr_url", "created_at", "updated_at")
    value = dict(zip(names, row))
    value["paths"] = [item[0] for item in connection.execute(
        "SELECT path FROM improvement_scope WHERE worker_id=? ORDER BY path", (worker_id,))]
    return value


def improvement_public(value):
    return {key: item for key, item in value.items() if key != "resume_state"}


def improvement_write(root, callback):
    require_review_lock_safe(root)
    with review_lock(root) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        connection = ensure_ledger_for_write(root)
        try:
            ensure_improvement_schema(connection)
            connection.execute("BEGIN IMMEDIATE")
            result = callback(connection)
            ledger_integrity(connection)
            connection.commit()
            return result
        except Exception:
            connection.rollback()
            raise
        finally:
            connection.close()


def command_improvement_claim(args):
    requested_worker_id = improvement_id(args.worker_id, "worker ID") if args.worker_id is not None else None
    session_id = improvement_id(args.session_id, "session ID")
    summary = improvement_summary(args.summary)
    priority = args.priority
    kind = args.kind
    measurement_plan = (improvement_measurement_plan(args.measurement_plan_json)
                        if args.measurement_plan_json is not None else None)
    if kind == "feature" and measurement_plan is None:
        fail("feature improvement claims require a measurement plan")
    if kind != "feature" and measurement_plan is not None:
        fail("only feature improvement claims accept a measurement plan")
    opportunity_id = improvement_opportunity_id(summary, kind, measurement_plan)
    timestamp = int(datetime.now(timezone.utc).timestamp() * 1000)
    root = review_root(args.state_root)

    def claim(connection):
        if requested_worker_id is None:
            row = connection.execute("SELECT worker_id FROM improvement_workers WHERE session_id=?",
                                     (session_id,)).fetchone()
            if row is None:
                fail("improvement worker must be registered before claiming")
            worker_id = row[0]
        else:
            worker_id = requested_worker_id
        existing = connection.execute("SELECT session_id, opportunity_id FROM improvement_workers "
                                      "WHERE worker_id=?", (worker_id,)).fetchone()
        try:
            if existing is None:
                connection.execute("""
                    INSERT INTO improvement_workers (
                        worker_id, session_id, opportunity_id, summary, priority, kind, measurement_plan,
                        state, resume_state,
                        recovery_attempts, created_at, updated_at
                    ) VALUES (?, ?, ?, ?, ?, ?, ?, 'claimed', 'claimed', 0, ?, ?)
                """, (worker_id, session_id, opportunity_id, summary, priority, kind,
                      measurement_plan, timestamp, timestamp))
            elif existing != (session_id, None):
                fail("improvement opportunity or worker is already claimed")
            else:
                connection.execute("""
                    UPDATE improvement_workers SET opportunity_id=?, summary=?, priority=?, kind=?, measurement_plan=?,
                           discovery_report=NULL, implementation_report=NULL, state='claimed', authorization='none',
                           readiness=NULL, resume_state='claimed', updated_at=? WHERE worker_id=?
                """, (opportunity_id, summary, priority, kind, measurement_plan, timestamp, worker_id))
        except sqlite3.IntegrityError:
            fail("improvement opportunity or worker is already claimed")
        return improvement_public(improvement_worker(connection, worker_id))

    print(json.dumps(improvement_write(root, claim), sort_keys=True))


def command_improvement_promote(args):
    worker_id = improvement_id(args.worker_id, "worker ID")
    if improvement_id(args.confirm, "confirmation") != worker_id:
        fail("improvement worker confirmation does not match")
    root = review_root(args.state_root)

    def promote(connection):
        current = improvement_worker(connection, worker_id)
        if current["state"] != "claimed" or current["priority"] not in {"P2", "P3"}:
            fail("only a claimed P2/P3 improvement worker can be promoted")
        timestamp = int(datetime.now(timezone.utc).timestamp() * 1000)
        connection.execute("""
            UPDATE improvement_workers SET priority='P1', authorization='operator', readiness=NULL,
                   state='discovery', resume_state='discovery', updated_at=? WHERE worker_id=?
        """, (timestamp, worker_id))
        return improvement_public(improvement_worker(connection, worker_id))

    print(json.dumps(improvement_write(root, promote), sort_keys=True))


def command_improvement_register(args):
    worker_id = improvement_id(args.worker_id, "worker ID")
    session_id = improvement_id(args.session_id, "session ID")
    identifiers = {name: improvement_presentation_id(value, name.replace("_", " "))
                    for name, value in (("workspace_id", args.workspace_id), ("tab_id", args.tab_id),
                                        ("pane_id", args.pane_id)) if value is not None}
    timestamp = int(datetime.now(timezone.utc).timestamp() * 1000)
    root = review_root(args.state_root)

    def register(connection):
        existing = connection.execute(
            "SELECT worker_id,session_id FROM improvement_workers WHERE worker_id=? OR session_id=?",
            (worker_id, session_id),
        ).fetchall()
        if existing:
            if existing == [(worker_id, session_id)]:
                return improvement_public(improvement_worker(connection, worker_id))
            fail("improvement worker is already registered")
        columns = ["worker_id", "session_id", "state", "resume_state", "recovery_attempts",
                   "created_at", "updated_at", *identifiers]
        values = [worker_id, session_id, "reviewing", "reviewing", 0, timestamp, timestamp,
                  *identifiers.values()]
        try:
            connection.execute(
                f"INSERT INTO improvement_workers ({', '.join(columns)}) VALUES ({', '.join('?' for _ in values)})",
                values,
            )
        except sqlite3.IntegrityError:
            fail("improvement worker is already registered")
        return improvement_public(improvement_worker(connection, worker_id))

    print(json.dumps(improvement_write(root, register), sort_keys=True))


def scopes_overlap(left, right):
    left, right = PurePosixPath(left).parts, PurePosixPath(right).parts
    return left[:len(right)] == right or right[:len(left)] == left


def command_improvement_update(args):
    if (args.worker_id is None) == (args.session_id is None):
        fail("improvement update requires exactly one worker or session ID")
    requested_worker_id = improvement_id(args.worker_id, "worker ID") if args.worker_id is not None else None
    requested_session_id = improvement_id(args.session_id, "session ID") if args.session_id is not None else None
    state = args.state
    identifiers = {name: improvement_presentation_id(value, name.replace("_", " "))
                    for name, value in (("workspace_id", args.workspace_id), ("tab_id", args.tab_id),
                                        ("pane_id", args.pane_id))
                    if value is not None}
    if args.cycle_id is not None:
        identifiers["cycle_id"] = improvement_id(args.cycle_id, "cycle ID")
    paths = sorted(set(improvement_path(value) for value in args.path or []))
    transitions = {
        "reviewing": {"blocked", "abandoned"},
        "claimed": {"discovery", "blocked", "abandoned"},
        "discovery": {"implementing", "blocked", "abandoned"},
        "implementing": {"blocked", "abandoned"},
        "draft_pr": {"merged", "closed", "blocked"},
        "blocked": set(), "merged": set(), "closed": set(), "abandoned": set(),
    }
    root = review_root(args.state_root)

    def update(connection):
        if requested_worker_id is None:
            row = connection.execute("SELECT worker_id FROM improvement_workers WHERE session_id=?",
                                     (requested_session_id,)).fetchone()
            if row is None:
                fail("improvement worker is missing")
            worker_id = row[0]
        else:
            worker_id = requested_worker_id
        current = improvement_worker(connection, worker_id)
        authorization = current["authorization"]
        readiness = current["readiness"]
        discovery_report = current["discovery_report"]
        if ((args.autonomous or args.readiness_json is not None or args.operator_confirm is not None)
                and not (current["state"] == "claimed" and state == "discovery")):
            fail("improvement authorization is accepted only for claimed -> discovery")
        discovery_update = (args.discovery_json is not None and current["state"] == "discovery"
                            and state == "discovery" and current["authorization"] == "operator"
                            and current["discovery_report"] is None)
        if (args.discovery_json is not None and not discovery_update
                and not (current["state"] == "claimed" and state == "discovery")):
            fail("Discovery report is accepted only when entering or completing Discovery")
        if current["state"] == "claimed" and state == "discovery":
            discovery_report = (improvement_discovery_report(args.discovery_json)
                                if args.discovery_json is not None else None)
            if args.operator_confirm == worker_id:
                if discovery_report is None:
                    fail("Discovery requires a persisted interview report")
                authorization = "operator"
                readiness = None
            elif current["priority"] in {"P0", "P1"} and args.autonomous:
                authorization = "autonomous"
                readiness = improvement_readiness(
                    args.readiness_json, worker_id, current["session_id"], current["opportunity_id"],
                    validate_evidence=True)
                receipt = json.loads(readiness)
                if (current["priority"] == "P0" and receipt["risk"] != "critical"
                        or current["priority"] == "P1" and receipt["risk"] == "critical"):
                    fail("autonomous readiness risk does not match improvement priority")
                if (discovery_report is None
                        or json.loads(discovery_report)["evidence_digest"] != receipt["evidence_digest"]):
                    fail("autonomous Discovery report does not match readiness evidence")
            else:
                fail("P0/P1 require autonomous readiness or operator confirmation; P2/P3 require promotion")
        elif discovery_update:
            discovery_report = improvement_discovery_report(args.discovery_json)
        if state != current["state"] and state not in transitions[current["state"]]:
            fail(f"invalid improvement transition: {current['state']} -> {state}")
        if state == "implementing":
            if discovery_report is None:
                fail("implementing requires a persisted Discovery interview")
            if not paths or args.cycle_id is None:
                fail("implementing requires a cycle ID and declared scope paths")
        if state == "draft_pr":
            fail("draft_pr state is recorded only by verified Final Push")
        if paths:
            if current["opportunity_id"] is None:
                fail("improvement scope requires a claimed opportunity")
            active = {"claimed", "discovery", "implementing", "draft_pr", "blocked"}
            for owner, existing in connection.execute("""
                    SELECT w.worker_id, s.path FROM improvement_scope s
                    JOIN improvement_workers w USING (worker_id)
                    WHERE w.worker_id != ? AND w.state IN (?, ?, ?, ?, ?)
            """, (worker_id, *sorted(active))):
                if any(scopes_overlap(path, existing) for path in paths):
                    fail(f"improvement scope conflicts with {owner}")
            connection.execute("DELETE FROM improvement_scope WHERE worker_id=?", (worker_id,))
            connection.executemany("INSERT INTO improvement_scope VALUES (?, ?)",
                                   ((worker_id, path) for path in paths))
        timestamp = int(datetime.now(timezone.utc).timestamp() * 1000)
        assignments = ["state=?", "updated_at=?"]
        values = [state, timestamp]
        if authorization != current["authorization"]:
            assignments.append("authorization=?")
            values.append(authorization)
        if readiness != current["readiness"]:
            assignments.append("readiness=?")
            values.append(readiness)
        if discovery_report != current["discovery_report"]:
            assignments.append("discovery_report=?")
            values.append(discovery_report)
        if state in IMPROVEMENT_RESUMABLE_STATES:
            assignments.append("resume_state=?")
            values.append(state)
        for name, value in identifiers.items():
            assignments.append(f"{name}=?")
            values.append(value)
        values.append(worker_id)
        connection.execute(f"UPDATE improvement_workers SET {', '.join(assignments)} WHERE worker_id=?", values)
        if state == "abandoned":
            connection.execute("DELETE FROM improvement_scope WHERE worker_id=?", (worker_id,))
        return improvement_public(improvement_worker(connection, worker_id))

    print(json.dumps(improvement_write(root, update), sort_keys=True))


def command_improvement_recover(args):
    worker_id = improvement_id(args.worker_id, "worker ID")
    root = review_root(args.state_root)

    def recover(connection):
        current = improvement_worker(connection, worker_id)
        if current["state"] in {"merged", "closed", "abandoned"}:
            fail("terminal improvement worker cannot be recovered")
        if (current["priority"] in {"P2", "P3"} and current["state"] == "claimed"
                and args.action != "abandon"):
            fail("P2/P3 improvement claims remain queued until promotion or abandonment")
        timestamp = int(datetime.now(timezone.utc).timestamp() * 1000)
        if args.action == "failed":
            attempts = min(current["recovery_attempts"] + 1, 3)
            state = "blocked" if attempts == 3 else current["state"]
            connection.execute("UPDATE improvement_workers SET state=?, recovery_attempts=?, updated_at=? "
                               "WHERE worker_id=?", (state, attempts, timestamp, worker_id))
        elif args.action == "retry":
            if current["state"] != "blocked":
                fail("only a blocked improvement worker can be retried")
            connection.execute("UPDATE improvement_workers SET state=resume_state, recovery_attempts=0, "
                               "updated_at=? WHERE worker_id=?", (timestamp, worker_id))
        elif args.action == "success":
            connection.execute("UPDATE improvement_workers SET recovery_attempts=0, updated_at=? WHERE worker_id=?",
                               (timestamp, worker_id))
        else:
            connection.execute("UPDATE improvement_workers SET state='abandoned', updated_at=? WHERE worker_id=?",
                               (timestamp, worker_id))
            connection.execute("DELETE FROM improvement_scope WHERE worker_id=?", (worker_id,))
        return improvement_public(improvement_worker(connection, worker_id))

    print(json.dumps(improvement_write(root, recover), sort_keys=True))


def command_improvement_forget(args):
    worker_id = improvement_id(args.worker_id, "worker ID")
    if improvement_id(args.confirm, "confirmation") != worker_id:
        fail("improvement worker confirmation does not match")
    root = review_root(args.state_root)

    def forget(connection):
        if improvement_worker(connection, worker_id)["state"] != "abandoned":
            fail("only an abandoned improvement worker can be forgotten")
        connection.execute("DELETE FROM improvement_workers WHERE worker_id=?", (worker_id,))
        return {"forgotten_worker_id": worker_id}

    print(json.dumps(improvement_write(root, forget), sort_keys=True))


def command_improvement_status(args):
    root = review_root(args.state_root)
    require_review_lock_safe(root)
    if not ledger_exists(root):
        print(json.dumps({"workers": []}, sort_keys=True))
        return
    with review_lock(root) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        connection = ledger_connection(root, write=True)
        try:
            if connection.execute("SELECT value FROM ledger_meta WHERE key='improvement_schema'").fetchone() is None:
                workers = []
            else:
                query = "SELECT worker_id FROM improvement_workers"
                values = ()
                if args.worker_id is not None:
                    query += " WHERE worker_id=?"
                    values = (improvement_id(args.worker_id, "worker ID"),)
                query += " ORDER BY created_at, worker_id"
                workers = [improvement_public(improvement_worker(connection, row[0]))
                           for row in connection.execute(query, values)]
        finally:
            connection.close()
    print(json.dumps({"workers": workers}, sort_keys=True))


def command_review_complete(args):
    try:
        raw_report = args.report_json if args.report_json is not None else Path(args.report).read_text(encoding="utf-8")
        report = json.loads(raw_report, object_pairs_hook=no_duplicate_keys)
    except (OSError, json.JSONDecodeError) as error:
        fail(f"cannot read review report: {error}")
    text_fields = ("findings", "scorecards", "trends", "proposals", "caveats")
    allowed = {"session_ids", "cycle_ids", "scan_digest", "snapshot", "session_ceiling", "part_ceiling", "database_digest",
               "exclusion_digest", "limit", "cursor", "decision", "notes", *text_fields}
    if not isinstance(report, dict) or set(report) - allowed:
        fail("review report has an invalid schema")
    sessions, cycles = report.get("session_ids"), report.get("cycle_ids", [])
    if (not isinstance(sessions, list) or not sessions or not isinstance(cycles, list)
            or not all(isinstance(value, str) and re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}", value)
                       for value in sessions + cycles)
            or len(sessions) > REVIEW_MAX_LIMIT or len(cycles) > REVIEW_MAX_LIMIT):
        fail("review report has invalid IDs")
    if len(set(sessions)) != len(sessions) or len(set(cycles)) != len(cycles):
        fail("review report IDs must be unique")
    decision, notes = report.get("decision"), report.get("notes")
    if not isinstance(decision, str) or not 1 <= len(decision.encode()) <= 256:
        fail("review report has invalid decision")
    if notes is not None and (not isinstance(notes, str) or len(notes.encode()) > 2048):
        fail("review report has invalid notes")
    digest = report.get("scan_digest")
    if not isinstance(digest, str) or args.scan_digest != digest:
        fail("review report does not match scan digest")
    if (type(report.get("snapshot")) is not int or type(report.get("session_ceiling")) is not int
            or type(report.get("part_ceiling")) is not int or type(report.get("limit")) is not int
            or type(report.get("cursor")) is not int or not 1 <= report["limit"] <= REVIEW_MAX_LIMIT
            or report["cursor"] < 0 or not 0 <= report["session_ceiling"] <= 2**63 - 1
            or not 0 <= report["part_ceiling"] <= 2**63 - 1
            or not isinstance(report.get("database_digest"), str)
            or not re.fullmatch(r"[0-9a-f]{64}", report["database_digest"])
            or report.get("exclusion_digest") is not None
            and not re.fullmatch(r"[0-9a-f]{64}", report["exclusion_digest"])):
        fail("review report requires its scan snapshot, limit, and cursor")
    for name in text_fields:
        values = report.get(name, [])
        if (not isinstance(values, list) or len(values) > 50
                or not all(isinstance(value, str) and 1 <= len(value) <= 512 for value in values)):
            fail(f"review report has invalid {name}")
    # Digests and opaque OpenCode IDs can be high entropy by design; inspect only human text.
    human_text = [str(report.get(name, "")) for name in ("decision", "notes")]
    human_text.extend(value for name in text_fields for value in report.get(name, []))
    if review_unsafe(" ".join(human_text)):
        fail("review report contains unsafe content")
    root = review_root(args.state_root)
    require_review_lock_safe(root)
    with review_lock(root) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        current_sessions, _ = reviewed_ids(args.state_root, lock=False)
        if current_sessions.intersection(sessions):
            fail("review page was already completed")
        expected = review_scan(argparse.Namespace(
            database=args.database, state_root=args.state_root,
            limit=report["limit"], cursor=report["cursor"], snapshot=report["snapshot"],
            session_ceiling=report["session_ceiling"], part_ceiling=report["part_ceiling"],
            database_digest=report["database_digest"],
            lock_held=True,
            history_metrics=False,
            excluded_session_id=args.excluded_session_id,
            excluded_message_id=args.excluded_message_id,
            exclusion_digest=report.get("exclusion_digest"),
            allow_database_drift=True,
        ))
        if (expected["session_ids"] != sessions or expected["cycle_ids"] != cycles
                or expected["digest"] != digest):
            fail("OpenCode database changed within the review snapshot")
        for candidate in expected["candidates"]:
            candidate["_history_identity"] = {
                "method_revision": "unavailable", "context": "unavailable",
                "project_digest": "unavailable",
            }
            candidate["_history_metrics"] = {}
        forgotten = review_index(root)["forgotten_sessions"]
        reviewed_at = max(int(datetime.now(timezone.utc).timestamp() * 1000), report["snapshot"] + 1,
                          *(forgotten.get(value, 0) + 1 for value in sessions))
        persisted = {key: value for key, value in report.items() if key != "exclusion_digest"}
        persisted["database_digest"] = expected["database_digest"]
        persisted.update({"cycle_ids": cycles, "reviewed_at": reviewed_at})
        name = hashlib.sha256((digest + "\0" + json.dumps(persisted, sort_keys=True)).encode()).hexdigest()[:24]
        connection = ensure_ledger_for_write(root)
        try:
            connection.execute("BEGIN IMMEDIATE")
            pruned = prune_review_reports(root, connection=connection)
            prune_phase_spans(root, connection=connection)
            archive_review_candidates(root, expected, connection=connection)
            ledger_put_review_report(connection, name, persisted)
            connection.commit()
        except Exception:
            connection.rollback()
            raise
        finally:
            connection.close()
    print(json.dumps({"digest": digest, "reviewed_sessions": len(sessions),
                      "reviewed_cycles": len(cycles), "pruned_reports": pruned}, sort_keys=True))


def command_review_prune(args):
    root = review_root(args.state_root)
    require_review_lock_safe(root)
    with review_lock(root) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        connection = ensure_ledger_for_write(root)
        try:
            connection.execute("BEGIN IMMEDIATE")
            removed = prune_review_reports(root, connection=connection)
            removed_spans = prune_phase_spans(root, connection=connection)
            connection.commit()
        except Exception:
            connection.rollback()
            raise
        finally:
            connection.close()
        removed_backup_spans = prune_phase_backup_spans(root)
    print(json.dumps({"pruned_reports": removed, "pruned_phase_spans": removed_spans,
                      "pruned_backup_phase_spans": removed_backup_spans}, sort_keys=True))


def command_review_forget(args):
    root = review_root(args.state_root)
    if not OPAQUE_ID.fullmatch(args.session_id):
        fail("invalid review forget ID")
    require_review_lock_safe(root)
    with review_lock(root) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        connection = ensure_ledger_for_write(root)
        history_evidence(root)
        reports = history_reports(root)
        cohorts = history_cohorts(root)
        dependent = {item["report_id"] for item in reports + cohorts if args.session_id in item["cohort"]}
        capture_dependent = ([row[0] for row in connection.execute(
            "SELECT capture_id FROM history_capture_members WHERE session_id=?", (args.session_id,))]
            if connection.execute(
                "SELECT 1 FROM sqlite_master WHERE type='table' AND name='history_capture_members'").fetchone() else [])
        value = review_index(root)
        session_times = [timestamp for _, report, timestamp in review_reports(root)
                         if args.session_id in report["session_ids"]]
        session_times.append(value["sessions"].get(args.session_id, 0))
        incident_ids = [row[0] for row in connection.execute(
            "SELECT incident_id FROM incidents WHERE session_id=?", (args.session_id,))]
        incident_signals = [row[0] for row in connection.execute(
            "SELECT signal_id FROM incident_signal_dispositions WHERE incident_id IN "
            "(SELECT incident_id FROM incidents WHERE session_id=?)", (args.session_id,))]
        removed = args.session_id in reviewed_ids_unlocked(root)[0] or bool(incident_ids)
        forgotten_at = max(int(datetime.now(timezone.utc).timestamp() * 1000), max(session_times) + 1)
        staged = None
        quarantine_name = f".forget-{uuid.uuid4().hex}"
        try:
            connection.execute("BEGIN IMMEDIATE")
            prune_review_reports(root, connection=connection)
            connection.execute("DELETE FROM history_evidence WHERE session_id=?", (args.session_id,))
            for report_id in dependent:
                connection.execute("DELETE FROM ledger_entries WHERE scope='history' AND report_id=?", (report_id,))
                connection.execute("DELETE FROM history_reports WHERE report_id=?", (report_id,))
            if capture_dependent:
                delete_capture_benchmarks(connection, capture_dependent, forgotten_at)
                connection.executemany("DELETE FROM history_captures WHERE capture_id=?",
                                       ((capture_id,) for capture_id in capture_dependent))
            if incident_ids:
                connection.execute(
                    "UPDATE incident_signal_dispositions SET incident_id=NULL,disposition='forgotten',timestamp=? "
                    "WHERE incident_id IN (SELECT incident_id FROM incidents WHERE session_id=?)",
                    (forgotten_at, args.session_id))
                connection.execute("DELETE FROM incidents WHERE session_id=?", (args.session_id,))
            connection.execute(
                "INSERT INTO review_tombstones VALUES ('forgotten_session', ?, ?) "
                "ON CONFLICT(kind, item_id) DO UPDATE SET timestamp=max(timestamp, excluded.timestamp)",
                (args.session_id, forgotten_at),
            )
            record_knowledge_privacy_tombstone(
                connection, "telemetry", args.session_id, "forgotten", forgotten_at)
            for report_id in dependent:
                record_knowledge_privacy_tombstone(
                    connection, "history_report", report_id, "forgotten", forgotten_at)
            for capture_id in capture_dependent:
                record_knowledge_privacy_tombstone(
                    connection, "history_capture", capture_id, "forgotten", forgotten_at)
            for incident_id in incident_ids:
                record_knowledge_privacy_tombstone(
                    connection, "incident", incident_id, "forgotten", forgotten_at)
            for signal_id in incident_signals:
                record_knowledge_privacy_tombstone(
                    connection, "incident_signal", signal_id, "forgotten", forgotten_at)
            connection.execute("INSERT INTO ledger_meta VALUES ('pending_forget_cleanup', ?)",
                               (quarantine_name,))
            staged = stage_pre_forget_state(root, quarantine_name)
            connection.commit()
        except Exception:
            connection.rollback()
            if staged is not None:
                restore_staged_forget(*staged)
            connection.close()
            raise
        recover_forget_state(root, connection)
        connection.close()
    print(json.dumps({"forgotten": removed}, sort_keys=True))


def command_review(args):
    root = root_dir()
    path, record = load(root)
    require_active(record)
    if args.result == "changed" and not args.path:
        fail("changed artifact review requires --path")
    if args.path:
        expected = f"docs/specs/{record['context']}/{args.name}.md"
        if args.path != expected:
            fail(f"{args.name} path must be {expected}")
        safe_paths(root, [args.path])
    record["artifact_reviews"][args.name] = {
        "result": args.result, "reason": args.reason, "path": args.path,
        "reviewed_at": now()
    }
    save(path, record)


def evidence_text(value, limit, name):
    try:
        raw = value.encode("utf-8")
    except UnicodeEncodeError:
        fail(f"{name} must be UTF-8")
    if not value or len(raw) > limit or any(ord(char) < 32 or ord(char) == 127 for char in value):
        fail(f"invalid {name}")
    if SECRET_VALUE.search(value) or HIGH_ENTROPY.search(value):
        fail(f"unsafe {name}")
    return value


def redact_argument(value):
    if SECRET_VALUE.search(value) or HIGH_ENTROPY.search(value) or value.startswith("op://"):
        return "[REDACTED]"
    if "://" in value and re.search(r"://[^/@:]+:[^/@]+@", value):
        return "[REDACTED]"
    return value


def sanitized_argv(argv):
    if not argv or len(argv) > 64:
        fail("argv must contain 1 through 64 entries")
    output = []
    for index, value in enumerate(argv):
        if not isinstance(value, str) or "\0" in value:
            fail("invalid argv")
        if index == 0:
            name = Path(value).name
            output.append(name if name and not SECRET_VALUE.search(name) and not HIGH_ENTROPY.search(name) else "[REDACTED]")
        elif value.startswith("--"):
            output.append(value.partition("=")[0] + ("=[REDACTED]" if "=" in value else ""))
        elif value in ("-q", "-v", "-s", "-x", "-n"):
            output.append(value)
        else:
            output.append("[REDACTED]")
    if len(json.dumps(output, ensure_ascii=True, separators=(",", ":")).encode()) > 4096:
        fail("serialized argv exceeds 4096 bytes")
    return output


def safe_output(raw):
    if not raw:
        return {"status": "no_content"}, None
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError:
        return {"status": "withheld", "reason": "non_utf8"}, None
    if (SECRET_VALUE.search(text) or HIGH_ENTROPY.search(text) or "://" in text
            or re.search(r"(?:^|\s)(?:/|~)[^\s]+", text) or any(ord(char) < 32 and char not in "\n\r\t" for char in text)):
        return {"status": "withheld", "reason": "unclassified"}, None
    lines = [line for line in text.splitlines() if line]
    if not lines or not all(SAFE_EVIDENCE_LINE.fullmatch(line) for line in lines):
        return {"status": "withheld", "reason": "unclassified"}, None
    return None, text.encode("utf-8")


def write_sidecar(root, cycle_id, data):
    digest = hashlib.sha256(data).hexdigest()
    parent = common_git_dir(root) / "dbsctr" / "evidence"
    directory = parent / cycle_id
    for candidate in (parent, directory):
        if candidate.is_symlink():
            fail("unsafe evidence directory")
        candidate.mkdir(parents=True, exist_ok=True, mode=0o700)
        os.chmod(candidate, 0o700)
        candidate_stat = candidate.stat()
        if candidate_stat.st_uid != os.getuid() or candidate_stat.st_mode & 0o777 != 0o700:
            fail("unsafe evidence directory")
    target = directory / digest
    if target.exists() or target.is_symlink():
        stat = target.lstat()
        if (not target.is_file() or target.is_symlink() or stat.st_uid != os.getuid()
                or stat.st_mode & 0o777 != 0o600 or stat.st_size != len(data)
                or hashlib.sha256(target.read_bytes()).hexdigest() != digest):
            fail("unsafe evidence sidecar")
        return digest
    descriptor, temporary = tempfile.mkstemp(dir=directory)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "wb") as handle:
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        try:
            os.link(temporary, target)
        except FileExistsError:
            pass
    finally:
        Path(temporary).unlink(missing_ok=True)
    return digest


def verify_envelope(root, record, gate_name, require_bound=False, require_head=True):
    gate = record["gates"][gate_name]
    evidence_id = gate.get("evidence")
    item = record.get("evidence", {}).get("items", {}).get(evidence_id)
    if not item or item.get("gate") != gate_name or item.get("result") != gate.get("result"):
        fail(f"invalid evidence for gate: {gate_name}")
    if require_head and item.get("head") != git(root, "rev-parse", "HEAD").stdout.strip():
        fail(f"evidence HEAD is stale: {gate_name}")
    if require_bound and not item.get("commit"):
        fail(f"evidence is not bound to a commit: {gate_name}")
    content = item.get("content", {})
    if content.get("status") == "sidecar":
        if content.get("path") != f"evidence/{record['cycle_id']}/{content.get('sha256')}":
            fail("invalid evidence sidecar path")
        target = common_git_dir(root) / "dbsctr" / content["path"]
        if (not target.exists() or target.is_symlink() or not target.is_file() or target.stat().st_uid != os.getuid()
                or target.stat().st_mode & 0o777 != 0o600 or target.stat().st_size != content.get("byte_count")
                or hashlib.sha256(target.read_bytes()).hexdigest() != content.get("sha256")):
            fail("invalid evidence sidecar")
    elif content.get("status") not in ("withheld", "no_content"):
        fail("invalid evidence content")
    return item


def evidence_path_blobs(root, paths, index=False, commit=None):
    if not paths:
        return {}
    result = {}
    for name in paths if index or commit else safe_paths(root, paths):
        if commit:
            value = git(root, "rev-parse", "--verify", f"{commit}:{name}", check=False)
        elif index:
            value = git(root, "rev-parse", "--verify", f":{name}", check=False)
        elif os.path.lexists(root / name):
            value = git(root, "hash-object", "--path", name, "--", name, check=False)
        else:
            value = None
        result[name] = value.stdout.strip() if value and value.returncode == 0 else None
    return result


def command_record_evidence(args):
    root = root_dir()
    authority = evidence_text(args.authority, 128, "authority")
    argv, sanitized = list(args.program), sanitized_argv(args.program)
    path_blobs = evidence_path_blobs(root, args.path or [])
    with evidence_lock(root, resolved_active_path(root).read_text(encoding="utf-8").strip()):
        path, record = load(root)
        require_active(record)
        if record.get("schema_version") not in (3, 4):
            fail("record-evidence requires a schema 3 or 4 Cycle Record")
        gate = record["gates"][args.gate]
        if gate["applicability"] != "required":
            fail("evidence gate is not required")
        started, observed, cutoff, start_error = now(), 0, None, False
        raw = bytearray()
        try:
            process = subprocess.Popen(argv, cwd=root, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                       stderr=subprocess.STDOUT, shell=False, start_new_session=True)
            selector = selectors.DefaultSelector()
            selector.register(process.stdout, selectors.EVENT_READ)
            deadline = datetime.now(timezone.utc).timestamp() + args.timeout
            while selector.get_map() and not cutoff:
                remaining = deadline - datetime.now(timezone.utc).timestamp()
                if remaining <= 0:
                    cutoff = "timeout"
                    break
                for key, _ in selector.select(remaining):
                    block = os.read(key.fd, 65536)
                    if not block:
                        selector.unregister(key.fileobj)
                        continue
                    observed += len(block)
                    raw.extend(block[:max(0, EVIDENCE_RAW_CAP - len(raw))])
                    if observed > EVIDENCE_RAW_CAP:
                        cutoff = "overflow"
                        break
            if cutoff:
                os.killpg(process.pid, signal.SIGTERM)
                try:
                    process.wait(timeout=1)
                except subprocess.TimeoutExpired:
                    pass
                try:
                    os.killpg(process.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
            process.wait(timeout=2)
            selector.close()
        except subprocess.TimeoutExpired:
            cutoff = "timeout"
            if process:
                try:
                    os.killpg(process.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                process.wait()
        except OSError:
            start_error, process = True, None
        finished = now()
        result = "unavailable" if start_error or cutoff else "passed" if process.returncode == 0 else "failed"
        if result == "passed":
            incomplete = [name for name in GATES[:GATES.index(args.gate)] if not disposed(record["gates"][name])]
            if incomplete:
                fail("gate predecessors are incomplete: " + ", ".join(incomplete))
        content, retained = ({"status": "withheld", "reason": cutoff or "start_failed"}, None) if (cutoff or start_error) else safe_output(bytes(raw))
        envelope = {"id": "ev-" + uuid.uuid4().hex, "gate": args.gate, "authority": authority,
                    "argv": sanitized, "paths": path_blobs,
                    "head": git(root, "rev-parse", "HEAD").stdout.strip(),
                    "started_at": started, "finished_at": finished, "result": result,
                    "raw": {"byte_count": observed, "lower_bound": bool(cutoff), "truncated": bool(cutoff)},
                    "summary": "passed" if result == "passed" else "failed" if result == "failed" else "unavailable", "urls": []}
        if retained is not None:
            retained, truncated = retained[:EVIDENCE_SIDECAR_CAP], len(retained) > EVIDENCE_SIDECAR_CAP
            digest = write_sidecar(root, record["cycle_id"], retained)
            content = {"status": "sidecar", "path": f"evidence/{record['cycle_id']}/{digest}", "sha256": digest,
                       "byte_count": len(retained), "truncated": truncated}
        envelope["content"] = content
        evidence_id = envelope["id"]
        record["evidence"]["items"][evidence_id] = envelope
        previous_result = gate["result"]
        gate.pop("exception", None)
        gate.update({"result": result, "evidence": evidence_id})
        metrics = record.setdefault("metrics", {"gate_failure_count": 0, "gate_reopen_count": 0,
                                                  "remediation_round_count": 0})
        if result in ("failed", "unavailable") and previous_result not in ("failed", "unavailable"):
            metrics["gate_failure_count"] += 1
        if previous_result in ("failed", "unavailable") and result == "passed":
            metrics["remediation_round_count"] += 1
        save(path, record)
        print(evidence_id)


def command_set_gate(args):
    root = root_dir()
    path, record = load(root)
    require_active(record)
    gate = record["gates"][args.gate]
    if record.get("schema_version") in (3, 4) and args.evidence is not None:
        item = record["evidence"]["items"].get(args.evidence)
        if not item or item["gate"] != args.gate or item["result"] != args.result:
            fail("schema 3 evidence must be a matching stored evidence ID")
        if item["head"] != git(root, "rev-parse", "HEAD").stdout.strip():
            fail("schema 3 evidence HEAD is stale")
    if is_v32(record) and args.result == "passed":
        incomplete = [name for name in GATES[:GATES.index(args.gate)] if not disposed(record["gates"][name])]
        if incomplete:
            fail("gate predecessors are incomplete: " + ", ".join(incomplete))
    if gate["applicability"] == "required" and args.result == "not_run":
        fail("required gates cannot use not_run")
    if gate["applicability"] == "not_applicable" and args.result != "not_run":
        fail("not_applicable gates can only use not_run")
    if gate["applicability"] == "required" and args.result in ("passed", "failed", "unavailable") and not args.evidence:
        fail(f"{args.result} required gate needs evidence")
    previous_result = gate["result"]
    was_disposed = disposed(gate)
    gate.pop("exception", None)
    gate["result"] = args.result
    if args.evidence is not None:
        gate["evidence"] = args.evidence
    elif args.result == "pending":
        gate.pop("evidence", None)
    if is_v32(record) and was_disposed and not disposed(gate):
        invalidate_later(record, args.gate)
    metrics = record.setdefault("metrics", {"gate_failure_count": 0, "gate_reopen_count": 0,
                                              "remediation_round_count": 0})
    if args.result in ("failed", "unavailable") and previous_result not in ("failed", "unavailable"):
        metrics["gate_failure_count"] += 1
    if previous_result in ("failed", "unavailable") and args.result == "passed":
        metrics["remediation_round_count"] += 1
    save(path, record)


def command_set_applicability(args):
    root = root_dir()
    path, record = load(root)
    require_active(record)
    gate = record["gates"][args.gate]
    if is_v32(record):
        if args.value != "required" or gate["applicability"] != "not_applicable":
            fail("V3.2 applicability may only tighten from not_applicable to required")
        gate.update({"applicability": "required", "result": "pending"})
        gate.pop("reason", None)
        gate.pop("exception", None)
        invalidate_later(record, args.gate)
        record["applicability_plan"]["gates"][args.gate] = {"applicability": "required"}
        save(path, record)
        return
    gate["applicability"] = args.value
    if args.value == "not_applicable":
        if not args.reason:
            fail("not_applicable needs a reason")
        gate.update({"result": "not_run", "reason": args.reason})
    else:
        gate.update({"result": "pending"})
        gate.pop("reason", None)
    gate.pop("exception", None)
    save(path, record)


def adopt_profile_only_commits(root, record):
    baseline = record["git"]["head"]
    lineage = git(root, "rev-list", "--first-parent", "--reverse", f"{baseline}..HEAD").stdout.splitlines()
    recorded_ids = [entry["id"] for entry in record["commits"]]
    if len(recorded_ids) != len(set(recorded_ids)):
        fail("recorded lifecycle commits contain a duplicate")
    if any(commit not in lineage for commit in recorded_ids):
        fail("recorded lifecycle commit is missing from first-parent lineage")
    recorded = {entry["id"]: entry for entry in record["commits"]}
    profile = record["applicability_plan"]["profile"]
    for commit in lineage:
        if commit in recorded:
            continue
        changed = git(root, "diff-tree", "--no-commit-id", "--name-only", "-r", commit).stdout.splitlines()
        if changed != [profile]:
            fail("unrecorded commit changes more than the Engineering Profile")
        recorded[commit] = {"id": commit, "gates": []}
    record["commits"] = [recorded[commit] for commit in lineage]


def command_raise_risk(args):
    root = root_dir()
    path, record = load(root)
    require_active(record)
    if not is_v32(record):
        fail("raise-risk requires a V3.2 Cycle Record")
    if RISK_RANK[args.to] <= RISK_RANK[record["risk"]]:
        fail("risk may only increase")
    previous = record["risk"]
    apply_stricter_plan(root, record, read_plan(args.plan))
    adopt_profile_only_commits(root, record)
    record["risk"] = args.to
    record.setdefault("risk_history", []).append({
        "from": previous, "to": args.to, "reason": args.reason, "raised_at": now(),
    })
    save(path, record)


def command_update_plan(args):
    root = root_dir()
    path, record = load(root)
    require_active(record)
    if not is_v32(record):
        fail("update-plan requires a V3.2 Cycle Record")
    apply_stricter_plan(root, record, read_plan(args.plan))
    adopt_profile_only_commits(root, record)
    save(path, record)


def graphify_receipt_path(root, cycle_id):
    return cycle_dir(root) / "graphify" / f"{cycle_id}.json"


def graphify_output_identity(output):
    files, digests, total = [], {}, 0
    for path in sorted(output.rglob("*")):
        relative = path.relative_to(output).as_posix()
        details = path.lstat()
        if stat.S_IFMT(details.st_mode) == stat.S_IFDIR:
            continue
        if stat.S_IFMT(details.st_mode) != stat.S_IFREG or path.is_symlink():
            fail("Graphify output contains an unsafe file")
        total += details.st_size
        if len(files) >= 1024 or total > 256 * 1024 * 1024:
            fail("Graphify output exceeds bounds")
        files.append(relative)
        digests[relative] = hashlib.sha256(path.read_bytes()).hexdigest()
    if not {"GRAPH_REPORT.md", "manifest.json"} <= set(files):
        fail("Graphify output lacks its report or manifest")
    return files, digests


def run_graphify_adapter(adapter, cwd, output, selection, mode, timeout):
    environment = {name: value for name, value in os.environ.items()
                   if not re.search(r"(?:TOKEN|SECRET|PASSWORD|API_KEY|ACCESS_KEY|PRIVATE_KEY|CREDENTIAL)",
                                    name, re.I)}
    environment.update({"DBSCTR_GRAPHIFY_MODE": mode,
                        "DBSCTR_GRAPHIFY_VERSION": selection["version"]})
    if mode == "finalize":
        environment["DBSCTR_GRAPHIFY_TRANSACTION"] = "controller"
    descriptor = os.open(adapter, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    try:
        details = os.fstat(descriptor)
        content = os.read(descriptor, details.st_size + 1)
    finally:
        os.close(descriptor)
    if (stat.S_IFMT(details.st_mode) != stat.S_IFREG or len(content) != details.st_size
            or hashlib.sha256(content).hexdigest() != selection["adapter_sha256"]):
        fail("managed Graphify adapter identity changed")
    with tempfile.TemporaryDirectory(prefix="dbsctr-managed-graphify-") as private:
        executable = Path(private) / "adapter"
        executable.write_bytes(content)
        executable.chmod(0o700)
        return run_graphify_process(executable, cwd, output, environment, timeout)


def run_graphify_process(adapter, cwd, output, environment, timeout):
    with tempfile.TemporaryFile() as stdout, tempfile.TemporaryFile() as stderr:
        process = subprocess.Popen(
            [str(adapter), "--output-dir", str(output)], cwd=cwd, env=environment,
            stdin=subprocess.DEVNULL, stdout=stdout, stderr=stderr, start_new_session=True,
        )
        try:
            process.wait(timeout=timeout)
        except subprocess.TimeoutExpired:
            os.killpg(process.pid, signal.SIGTERM)
            try:
                process.wait(timeout=2)
            except subprocess.TimeoutExpired:
                os.killpg(process.pid, signal.SIGKILL)
                process.wait()
            fail("Graphify adapter timed out")
        stdout.seek(0)
        stderr.seek(0)
        output_text = stdout.read(4097)
        error_text = stderr.read(2001)
    if len(output_text) > 4096 or len(error_text) > 2000:
        fail("Graphify adapter output exceeds bounds")
    return subprocess.CompletedProcess(
        [str(adapter), "--output-dir", str(output)], process.returncode,
        output_text.decode(errors="replace"), error_text.decode(errors="replace"),
    )


def valid_graphify_check_receipt(value, record, head):
    keys = {"schema_version", "command_contract", "invocation_id", "cycle_id", "head",
            "profile", "adapter", "output_files", "output_sha256", "manifest_sha256",
            "cache", "checked_at"}
    files, digests, cache = value.get("output_files"), value.get("output_sha256"), value.get("cache")
    return (set(value) == keys and value.get("schema_version") == 1
            and value.get("command_contract") == "dbsctr-graphify-check-v1"
            and isinstance(value.get("invocation_id"), str)
            and re.fullmatch(r"[0-9a-f]{32}", value["invocation_id"])
            and value.get("cycle_id") == record["cycle_id"] and value.get("head") == head
            and value.get("profile") == record["engineering_profile"]
            and value.get("adapter") == record["applicability_plan"]["graphify"]
            and isinstance(files, list) and files == sorted(set(files))
            and {"GRAPH_REPORT.md", "manifest.json"} <= set(files)
            and isinstance(digests, dict) and sorted(digests) == files
            and all(re.fullmatch(r"[0-9a-f]{64}", digest or "") for digest in digests.values())
            and value.get("manifest_sha256") == digests.get("manifest.json")
            and isinstance(cache, dict) and set(cache) == {"hits", "misses"}
            and all(type(item) is int and item >= 0 for item in cache.values())
            and isinstance(value.get("checked_at"), str) and value["checked_at"])


def require_graphify_check(root, record):
    selection = record.get("applicability_plan", {}).get("graphify")
    if selection is None:
        return
    binding = record.get("graphify_check")
    head = git(root, "rev-parse", "HEAD").stdout.strip()
    if not isinstance(binding, dict) or binding.get("head") != head:
        fail("Graphify check is missing or stale")
    receipt = graphify_receipt_path(root, record["cycle_id"])
    if binding.get("receipt") != receipt.relative_to(cycle_dir(root)).as_posix():
        fail("Graphify check receipt path is invalid")
    try:
        details = receipt.lstat()
        raw = receipt.read_bytes()
        value = json.loads(raw, object_pairs_hook=no_duplicate_keys)
    except (OSError, json.JSONDecodeError):
        fail("Graphify check receipt is missing or invalid")
    if (stat.S_IFMT(details.st_mode) != stat.S_IFREG or details.st_uid != os.getuid()
            or receipt.is_symlink() or details.st_mode & 0o077
            or hashlib.sha256(raw).hexdigest() != binding.get("receipt_sha256")
            or not valid_graphify_check_receipt(value, record, head)):
        fail("Graphify check receipt identity is invalid")


def command_graphify_check(args):
    root = root_dir()
    path, record = load(root)
    require_active(record)
    require_current_profile(root, record)
    selection = record.get("applicability_plan", {}).get("graphify")
    if selection is None:
        fail("Graphify is not selected by the applicability plan")
    head = git(root, "rev-parse", "HEAD").stdout.strip()
    parent = Path(tempfile.mkdtemp(prefix="dbsctr-graphify-check-"))
    worktree, output = parent / "worktree", parent / "output"
    added = False
    try:
        git(root, "worktree", "add", "--detach", str(worktree), head)
        added = True
        selection = validate_graphify_selection(root, selection)
        adapter = archived_graphify_adapter(root, selection["adapter_sha256"])
        result = run_graphify_adapter(adapter, worktree, output, selection, "check", args.timeout)
        if result.returncode:
            fail(result.stderr[-2000:].strip() or "Graphify check failed")
        if len(result.stdout.encode()) > 4096:
            fail("Graphify check summary exceeds bounds")
        try:
            summary = json.loads(result.stdout or "{}", object_pairs_hook=no_duplicate_keys)
            manifest = json.loads((output / "manifest.json").read_text(encoding="utf-8"),
                                  object_pairs_hook=no_duplicate_keys)
            report = (output / "GRAPH_REPORT.md").read_text(encoding="utf-8")
        except (OSError, json.JSONDecodeError):
            fail("Graphify check output is invalid")
        if not isinstance(manifest, dict) or f"Built from commit: `{head}`" not in report:
            fail("Graphify check output does not match current HEAD")
        cache = {"hits": summary.get("cache_hits", 0), "misses": summary.get("cache_misses", 0)}
        if any(type(value) is not int or value < 0 for value in cache.values()):
            fail("Graphify cache counters are invalid")
        files, digests = graphify_output_identity(output)
        receipt_value = {
            "schema_version": 1, "command_contract": "dbsctr-graphify-check-v1",
            "invocation_id": uuid.uuid4().hex, "cycle_id": record["cycle_id"], "head": head,
            "profile": record["engineering_profile"], "adapter": selection,
            "output_files": files, "output_sha256": digests,
            "manifest_sha256": digests["manifest.json"], "cache": cache, "checked_at": now(),
        }
        receipt = graphify_receipt_path(root, record["cycle_id"])
        private_json(receipt, receipt_value)
        raw = receipt.read_bytes()
        relative = receipt.relative_to(cycle_dir(root)).as_posix()
        record["graphify_check"] = {"head": head, "receipt": relative,
                                     "receipt_sha256": hashlib.sha256(raw).hexdigest(),
                                     "checked_at": receipt_value["checked_at"]}
        save(path, record)
    finally:
        had_error = sys.exc_info()[0] is not None
        cleanup_error = None
        if added:
            removed = git(root, "worktree", "remove", "--force", str(worktree), check=False)
            if removed.returncode:
                cleanup_error = removed.stderr.strip() or "cannot remove disposable Graphify worktree"
        shutil.rmtree(parent)
        if cleanup_error and not had_error:
            fail(cleanup_error)
    print(json.dumps({"head": head, "receipt": relative, "cache": cache},
                     sort_keys=True, separators=(",", ":")))


def command_approve_exception(args):
    root = root_dir()
    path, record = load(root)
    require_active(record)
    gate = record["gates"][args.gate]
    if gate["applicability"] != "required" or gate["result"] not in ("failed", "unavailable"):
        fail("only a failed or unavailable required gate can receive an exception")
    gate["exception"] = {
        "kind": args.kind, "rationale": args.rationale, "owner": args.owner,
        "review_condition": args.review_condition, "approved_at": now(),
    }
    save(path, record)


def command_record_dvc_push(args):
    root = root_dir()
    path, record = load(root)
    require_active(record)
    if not ((root / ".dvc").exists() or (root / "dvc.yaml").exists()):
        fail("repository does not use DVC")
    head = git(root, "rev-parse", "HEAD").stdout.strip()
    if args.head != head:
        fail("DVC push evidence must match current HEAD")
    record["dvc_push"] = {"head": head, "evidence": args.evidence, "recorded_at": now()}
    save(path, record)


def safe_paths(root, paths):
    if not paths:
        fail("at least one path is required")
    cleaned = []
    for name in paths:
        pure = PurePosixPath(name)
        if pure.is_absolute() or ".." in pure.parts or name.startswith(".") and name == ".":
            fail(f"path must be repo-relative: {name}")
        basename = pure.name.lower()
        if basename == ".env" or basename.startswith(".env.") or basename in SECRET_NAMES or pure.suffix.lower() in (".key", ".pem"):
            fail(f"refusing possible secret path: {name}")
        tracked = git(root, "ls-files", "--error-unmatch", "--", name, check=False).returncode == 0
        if not (root / pure).is_file() and not tracked:
            fail(f"path does not exist: {name}")
        if git(root, "check-ignore", "--quiet", "--", name, check=False).returncode == 0:
            fail(f"path is ignored: {name}")
        cleaned.append(name)
    return cleaned


def command_gate_commit(args):
    root = root_dir()
    path, record = load(root)
    require_active(record)
    require_current_profile(root, record)
    schema3_items = []
    for name in args.gates:
        gate = record["gates"][name]
        complete = gate["applicability"] == "not_applicable" or gate["result"] == "passed" or "exception" in gate
        if not complete:
            fail(f"gate is not complete: {name}")
        if record.get("schema_version") in (3, 4) and gate["result"] in ("passed", "failed", "unavailable"):
            item = verify_envelope(root, record, name)
            if set(item.get("paths", {})) != set(args.paths):
                fail(f"evidence paths differ from commit paths: {name}")
            if evidence_path_blobs(root, args.paths) != item["paths"]:
                fail(f"evidence paths changed after validation: {name}")
            schema3_items.append((name, item))
    paths = safe_paths(root, args.paths)
    staged = git(root, "diff", "--cached", "--name-only").stdout.splitlines()
    if staged and set(staged) != set(paths):
        fail("unrelated staged paths present: " + ", ".join(staged))
    if git(root, "diff", "--check", check=False).returncode:
        fail("git diff --check failed")
    git(root, "add", "--", *paths)
    for name, item in schema3_items:
        if evidence_path_blobs(root, args.paths, index=True) != item["paths"]:
            fail(f"staged paths differ from evidence: {name}")
    if git(root, "diff", "--cached", "--check", check=False).returncode:
        fail("staged git diff --check failed")
    staged = git(root, "diff", "--cached", "--name-only").stdout.splitlines()
    if set(staged) != set(paths):
        fail("staged paths differ from requested paths")
    if not staged or not git(root, "diff", "--cached", "--quiet", check=False).returncode:
        fail("staged diff is empty")
    git(root, "commit", "-m", args.message)
    commit = git(root, "rev-parse", "HEAD").stdout.strip()
    if record.get("schema_version") in (3, 4):
        for name, item in schema3_items:
            if evidence_path_blobs(root, args.paths, commit=commit) != item["paths"]:
                fail(f"committed paths differ from evidence: {name}")
        for name in args.gates:
            gate = record["gates"][name]
            if gate.get("evidence"):
                record["evidence"]["items"][gate["evidence"]]["commit"] = commit
    record["commits"].append({"id": commit, "gates": args.gates})
    save(path, record)
    print(commit)


def command_check(args):
    root = root_dir()
    _, record = load(root)
    if args.subject == "artifacts":
        artifact_check(record)


def sync_source_checkout(record, remote, remote_branch, root=None):
    source = record.get("source")
    if not source:
        return {"status": "not_applicable", "reason": "no_recorded_source"}
    try:
        checkout = record_source_worktree(root or root_dir(), record)
        if not checkout.is_dir():
            return {"status": "skipped", "reason": "missing"}
        if status_paths(checkout):
            return {"status": "skipped", "reason": "dirty"}
        if branch(checkout) != source.get("branch"):
            return {"status": "skipped", "reason": "branch_changed"}
        if upstream(checkout) != source.get("upstream"):
            return {"status": "skipped", "reason": "upstream_changed"}
        if remote_destination(checkout, source.get("upstream")) != source.get("remote"):
            return {"status": "skipped", "reason": "target_changed"}
        git(checkout, "fetch", remote, remote_branch)
        target = source["upstream"]
        if git(checkout, "merge-base", "--is-ancestor", "HEAD", target, check=False).returncode:
            return {"status": "skipped", "reason": "diverged"}
        git(checkout, "merge", "--ff-only", target)
        return {"status": "updated", "reason": "fast_forward"}
    except (OSError, RuntimeError, KeyError):
        return {"status": "skipped", "reason": "sync_failed"}


def validate_draft_reconciliation(root, cycle_base, target_head, recorded_commits,
                                  evidence_points, review_point=None):
    if git(root, "merge-base", "--is-ancestor", target_head, "HEAD", check=False).returncode:
        fail("protected base advanced without reconciliation")
    merges = git(root, "rev-list", "--first-parent", "--merges", f"{cycle_base}..HEAD").stdout.splitlines()
    matches = [commit for commit in merges
               if git(root, "rev-parse", f"{commit}^2", check=False).stdout.strip() == target_head]
    if len(matches) != 1:
        fail("protected base reconciliation merge is missing or ambiguous")
    reconciliation = matches[0]
    first_parent = git(
        root, "rev-list", "--reverse", "--first-parent", f"{cycle_base}..HEAD"
    ).stdout.splitlines()
    if reconciliation in recorded_commits:
        if (first_parent != recorded_commits or review_point is None
                or git(root, "merge-base", "--is-ancestor", reconciliation, review_point,
                       check=False).returncode):
            fail("recorded reconciliation is not the reviewed Gate Commit")
        if any(git(root, "merge-base", "--is-ancestor", reconciliation, point,
                   check=False).returncode for point in evidence_points):
            fail("required gate evidence predates protected base reconciliation")
        return recorded_commits
    if any(git(root, "merge-base", "--is-ancestor", reconciliation, point,
               check=False).returncode for point in evidence_points):
        fail("required gate evidence predates protected base reconciliation")
    current_ahead = [commit for commit in first_parent if commit != reconciliation]
    if current_ahead != recorded_commits:
        fail("ahead commits are not exactly the recorded cycle commits")
    return current_ahead


def github_environment(account):
    lookup_env = {key: value for key, value in os.environ.items()
                  if key not in {"GH_TOKEN", "GITHUB_TOKEN"}}
    result = subprocess.run(
        ["gh", "auth", "token", "--hostname", "github.com", "--user", account],
        text=True, capture_output=True, env=lookup_env,
    )
    token = result.stdout.strip()
    if result.returncode or not token:
        fail(result.stderr.strip() or f"GitHub account is not authenticated: {account}")
    env = {**os.environ, "GH_TOKEN": token, "GIT_TERMINAL_PROMPT": "0",
           "GCM_INTERACTIVE": "Never"}
    for key in tuple(env):
        if (key in {"GIT_CONFIG", "GIT_CONFIG_COUNT", "GIT_CONFIG_PARAMETERS", "GIT_CURL_VERBOSE"}
                or re.fullmatch(r"GIT_CONFIG_(?:KEY|VALUE)_\d+", key)
                or key.startswith("GIT_TRACE")):
            del env[key]
    env.update({
        "GIT_CONFIG_COUNT": "3",
        "GIT_CONFIG_KEY_0": "credential.helper",
        "GIT_CONFIG_VALUE_0": "",
        "GIT_CONFIG_KEY_1": "credential.helper",
        "GIT_CONFIG_VALUE_1": (
            "!f() { printf '%s\\n' username=x-access-token \"password=$GH_TOKEN\"; }; f"
        ),
        "GIT_CONFIG_KEY_2": "http.extraHeader",
        "GIT_CONFIG_VALUE_2": "",
    })
    return env


def github_json(root, env, *args):
    result = subprocess.run(["gh", *args], cwd=root, env=env, text=True, capture_output=True)
    if result.returncode:
        fail(result.stderr.strip() or "GitHub CLI command failed")
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError:
        fail("GitHub CLI returned invalid JSON")


def deliver_draft_pr(root, record, env=None):
    delivery = record["delivery"]
    github = delivery["github"]
    env = env or github_environment(github["account"])
    fields = "number,url,isDraft,state,baseRefName,headRefName,headRepositoryOwner"
    owner = github["repository"].partition("/")[0]
    head = f"{owner}:{delivery['branch']}"
    existing = github_json(
        root, env, "pr", "list", "--repo", github["repository"], "--head", delivery["branch"],
        "--state", "all", "--limit", "100", "--json", fields,
    )
    if not isinstance(existing, list):
        fail("GitHub returned invalid pull requests for the feature branch")
    existing = [pull_request for pull_request in existing
                if pull_request.get("headRepositoryOwner", {}).get("login") == owner]
    if len(existing) > 1:
        fail("GitHub returned ambiguous pull requests for the feature branch")
    if existing:
        pull_request = existing[0]
    else:
        title = f"{record['cycle_id']}: {record['context']} improvement"
        body = "Automated DBSCTR improvement. Human review and merge are required."
        result = subprocess.run([
            "gh", "pr", "create", "--repo", github["repository"],
            "--base", delivery["base_branch"], "--head", head,
            "--draft", "--title", title, "--body", body,
        ], cwd=root, env=env, text=True, capture_output=True)
        if result.returncode or not result.stdout.strip():
            fail(result.stderr.strip() or "GitHub draft pull request creation failed")
        pull_request = github_json(
            root, env, "pr", "view", result.stdout.strip(), "--repo", github["repository"],
            "--json", fields,
        )
    if (not isinstance(pull_request, dict) or pull_request.get("isDraft") is not True
            or pull_request.get("state") != "OPEN"
            or pull_request.get("baseRefName") != delivery["base_branch"]
            or pull_request.get("headRefName") != delivery["branch"]
            or pull_request.get("headRepositoryOwner", {}).get("login") != owner
            or type(pull_request.get("number")) is not int or pull_request["number"] < 1
            or not isinstance(pull_request.get("url"), str)
            or not pull_request["url"].startswith("https://github.com/")):
        fail("GitHub pull request is not the expected open draft")
    return {
        "number": pull_request["number"], "url": pull_request["url"], "draft": True,
        "state": "OPEN", "verified_at": now(),
    }


def batch_id(value):
    if not isinstance(value, str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9-]{0,63}", value):
        fail("invalid batch ID")
    return value


@contextlib.contextmanager
def batch_lock(root, identifier):
    path = cycle_dir(root) / "locks" / f"batch-{identifier}.lock"
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor = os.open(path, os.O_RDWR | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0), 0o600)
    try:
        details = os.fstat(descriptor)
        if stat.S_IFMT(details.st_mode) != stat.S_IFREG or details.st_uid != os.getuid():
            fail("batch lock is unsafe")
        os.fchmod(descriptor, 0o600)
        fcntl.flock(descriptor, fcntl.LOCK_EX)
        yield
    finally:
        os.close(descriptor)


def serialized_batch(function):
    def command(args):
        root = root_dir()
        with batch_lock(root, batch_id(args.batch_id)):
            return function(args)
    return command


def batch_path(root, identifier):
    return cycle_dir(root) / "batches" / f"{identifier}.json"


def batch_worktree(root, identifier):
    repository = hashlib.sha256(str(common_git_dir(root).resolve()).encode()).hexdigest()[:16]
    return dbsctr_state_root() / "batch-worktrees" / repository / identifier


def load_batch(root, identifier):
    path = batch_path(root, identifier)
    if not path.is_file() or path.is_symlink():
        fail("batch is missing")
    try:
        value = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        fail("batch metadata is invalid")
    if (value.get("schema_version") not in (1, 2) or value.get("batch_id") != identifier
            or value.get("branch") != f"rnd/batch/{identifier}"
            or value.get("worktree") != str(batch_worktree(root, identifier))):
        fail("batch metadata is invalid")
    return path, value


def batch_source_tip(value):
    return value["sources"][-1]["merge"] if value["sources"] else value["base"]


def validate_batch_tip(worktree, value):
    expected = value["base"]
    for item in value["sources"]:
        if (not isinstance(item, dict) or set(item) != {"branch", "sha", "merge"}
                or not all(isinstance(item[name], str) for name in item)
                or not re.fullmatch(r"dbsctr/[A-Za-z0-9._/-]+", item["branch"])
                or ".." in PurePosixPath(item["branch"]).parts
                or not re.fullmatch(r"[0-9a-f]{40,64}", item["sha"])
                or not re.fullmatch(r"[0-9a-f]{40,64}", item["merge"])
                or git(worktree, "show", "-s", "--format=%P", item["merge"]).stdout.split()
                != [expected, item["sha"]]):
            fail("batch merge history is invalid")
        expected = item["merge"]
    graph = value.get("graph")
    if graph is not None:
        if (not isinstance(graph, dict) or not re.fullmatch(r"[0-9a-f]{40,64}", graph.get("commit", ""))
                or git(worktree, "show", "-s", "--format=%P", graph["commit"]).stdout.split() != [expected]
                or any(not name.startswith("graphify-out/") for name in git(
                    worktree, "diff-tree", "--no-commit-id", "--name-only", "-r", graph["commit"]
                ).stdout.splitlines())):
            fail("batch graph history is invalid")
        expected = graph["commit"]
    if git(worktree, "rev-parse", "HEAD").stdout.strip() != expected:
        fail("batch tip is not the recorded merge history")


def recover_batch_merges(worktree, value, source_heads):
    expected = batch_source_tip(value)
    head = git(worktree, "rev-parse", "HEAD").stdout.strip()
    if head == expected:
        return []
    candidates = {sha: (source, sha) for source, sha, _record in source_heads}
    recovered, entries = [], []
    known = {item["branch"] for item in value["sources"]}
    for commit in git(worktree, "rev-list", "--first-parent", "--reverse", f"{expected}..{head}").stdout.splitlines():
        parents = git(worktree, "show", "-s", "--format=%P", commit).stdout.split()
        candidate = candidates.get(parents[1]) if len(parents) == 2 and parents[0] == expected else None
        if candidate is None or candidate[0] in known:
            return []
        source, sha = candidate
        entries.append({"branch": source, "sha": sha, "merge": commit})
        recovered.append(source)
        known.add(source)
        expected = commit
    if expected != head:
        return []
    value["sources"].extend(entries)
    return recovered


def batch_graph_value(worktree, value, source_head, commit):
    changed = git(worktree, "diff-tree", "--no-commit-id", "--name-only", "-r", commit).stdout.splitlines()
    if (not changed or any(not name.startswith("graphify-out/") for name in changed)
            or git(worktree, "show", "-s", "--format=%P", commit).stdout.split() != [source_head]):
        fail("batch graph history is invalid")
    try:
        receipt_raw = git(worktree, "show", f"{commit}:graphify-out/graph.receipt.json").stdout.encode()
        receipt = json.loads(receipt_raw, object_pairs_hook=no_duplicate_keys)
        report = git(worktree, "show", f"{commit}:graphify-out/GRAPH_REPORT.md").stdout.encode()
        manifest = git(worktree, "show", f"{commit}:graphify-out/manifest.json").stdout.encode()
    except (json.JSONDecodeError, RuntimeError):
        fail("batch graph receipt is invalid")
    if (receipt.get("command_contract") != "dbsctr-batch-graphify-v1"
            or receipt.get("batch_id") != value["batch_id"] or receipt.get("source_head") != source_head
            or receipt.get("adapter") != value.get("graphify")):
        fail("batch graph receipt identity is invalid")
    requires_dvc_push = any(name.removeprefix("graphify-out/").endswith(".dvc")
                            or name.removeprefix("graphify-out/") in (
                                "dvc.yaml", "dvc.lock", ".dvc/config", ".dvcignore") for name in changed)
    return {"source_head": source_head, "commit": commit,
            "report_sha256": hashlib.sha256(report).hexdigest(),
            "manifest_sha256": hashlib.sha256(manifest).hexdigest(),
            "receipt_sha256": hashlib.sha256(receipt_raw).hexdigest(),
            "requires_dvc_push": requires_dvc_push}


@contextlib.contextmanager
def graphify_finalization_transaction(worktree, output):
    parent = Path(tempfile.mkdtemp(prefix="dbsctr-batch-graphify-", dir=worktree.parent))
    preserve = False
    backup = parent / "graphify-out"
    index_raw = git(worktree, "rev-parse", "--git-path", "index").stdout.strip()
    index = Path(index_raw)
    if not index.is_absolute():
        index = worktree / index
    descriptor, index_backup_raw = tempfile.mkstemp(
        prefix=".dbsctr-graphify-index-", dir=index.parent)
    os.close(descriptor)
    index_backup = Path(index_backup_raw)
    try:
        details = output.lstat()
        if output.is_symlink() or stat.S_IFMT(details.st_mode) != stat.S_IFDIR:
            fail("canonical graph output is unsafe")
        if sys.platform == "darwin":
            result = subprocess.run(
                ["/bin/cp", "-cR", str(output), str(backup)],
                text=True, capture_output=True,
            )
            if result.returncode:
                fail(result.stderr.strip() or "cannot clone canonical graph baseline")
        else:
            shutil.copytree(output, backup, symlinks=True)
        shutil.copy2(index, index_backup)
        try:
            yield
        except BaseException:
            try:
                interrupted = parent / "interrupted"
                os.replace(output, interrupted)
                os.replace(backup, output)
                os.replace(index_backup, index)
                shutil.rmtree(interrupted)
            except BaseException as rollback_error:
                preserve = True
                fail(f"batch Graphify rollback failed: {rollback_error}")
            raise
    finally:
        if not preserve:
            shutil.rmtree(parent, ignore_errors=True)
            index_backup.unlink(missing_ok=True)


def completed_source(root, source, sha):
    matches = []
    for path in (cycle_dir(root) / "cycles").glob("*.json"):
        try:
            record = json.loads(path.read_text())
        except (OSError, json.JSONDecodeError):
            continue
        delivery = record.get("delivery", {})
        if (record.get("state") == "completed" and record.get("delivery_intent") == "draft_pr"
                and delivery.get("branch") == source
                and delivery.get("published_feature_head") == sha):
            matches.append(record)
    if len(matches) != 1:
        fail("batch source is not one completed DBSCTR draft-PR delivery")
    return matches[0]


@serialized_batch
def command_batch_create(args):
    root = root_dir()
    identifier = batch_id(args.batch_id)
    branch_name = f"rnd/batch/{identifier}"
    path = batch_path(root, identifier)
    worktree = batch_worktree(root, identifier)
    if (not OPAQUE_ID.fullmatch(args.github_account)
            or not re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", args.github_repository)):
        fail("batch requires a valid GitHub account and repository")
    if path.exists() or worktree.exists() or git(root, "show-ref", "--verify", "--quiet",
                                                 f"refs/heads/{branch_name}", check=False).returncode == 0:
        fail("batch already exists")
    if status_paths(root):
        fail("source worktree is not clean")
    git(root, "fetch", "origin", "main")
    base = git(root, "rev-parse", "refs/remotes/origin/main").stdout.strip()
    worktree.parent.mkdir(parents=True, exist_ok=True)
    git(root, "worktree", "add", "-b", branch_name, str(worktree), base)
    value = {
        "schema_version": 2, "batch_id": identifier, "branch": branch_name,
        "base": base, "worktree": str(worktree), "sources": [],
        "state": "open", "graphify": None, "graphify_policy_set": False,
        "github": {"host": "github.com", "account": args.github_account,
                   "repository": args.github_repository}, "created_at": now(),
    }
    private_json(path, value)
    print(json.dumps(value, sort_keys=True))


def batch_source(root, source):
    if not re.fullmatch(r"dbsctr/[A-Za-z0-9._/-]+", source) or ".." in PurePosixPath(source).parts:
        fail("invalid batch source branch")
    git(root, "fetch", "origin", source)
    sha = git(root, "rev-parse", f"refs/remotes/origin/{source}").stdout.strip()
    return sha, completed_source(root, source, sha)


@serialized_batch
def command_batch_integrate(args):
    root = root_dir()
    identifier = batch_id(args.batch_id)
    sources = list(dict.fromkeys(args.source))
    if len(sources) != len(args.source):
        fail("batch source is duplicated")
    git(root, "fetch", "origin", "main")
    source_heads = [(source, *batch_source(root, source)) for source in sources]
    if args.preview:
        parent = Path(tempfile.mkdtemp(prefix=f"dbsctr-batch-{identifier}-"))
        temporary = parent / "worktree"
        added = False
        try:
            base = git(root, "rev-parse", "refs/remotes/origin/main").stdout.strip()
            git(root, "worktree", "add", "--detach", str(temporary), base)
            added = True
            for _source, sha, _record in source_heads:
                git(temporary, "merge", "--no-ff", "--no-edit", sha)
            print(json.dumps({"batch_id": identifier, "preview": True,
                              "head": git(temporary, "rev-parse", "HEAD").stdout.strip()}, sort_keys=True))
        finally:
            if added:
                removed = git(root, "worktree", "remove", "--force", str(temporary), check=False)
                if removed.returncode:
                    fail(removed.stderr.strip() or "cannot remove batch preview worktree")
            shutil.rmtree(parent)
        return
    path, value = load_batch(root, identifier)
    if value.get("state", "open") != "open":
        fail("batch source admission is closed")
    worktree = Path(value["worktree"])
    if not worktree.is_dir() or status_paths(worktree):
        fail("batch worktree is missing or dirty")
    selections = [record.get("applicability_plan", {}).get("graphify")
                  for _source, _sha, record in source_heads]
    selected = [selection for selection in selections if selection is not None]
    if selected and (len(selected) != len(selections) or any(item != selected[0] for item in selected)):
        fail("batch sources have incompatible Graphify selections")
    incoming = selected[0] if selected else None
    if value.get("graphify_policy_set", bool(value["sources"])) and value.get("graphify") != incoming:
        fail("batch Graphify selection changed")
    if selected:
        for selection, (_source, sha, _record) in zip(selections, source_heads):
            validate_graphify_selection(root, selection, sha)
    value.update({"schema_version": 2, "graphify": incoming, "graphify_policy_set": True})
    recovered = recover_batch_merges(worktree, value, source_heads)
    if recovered:
        value["updated_at"] = now()
        private_json(path, value)
        if set(recovered) == set(sources):
            print(json.dumps(value, sort_keys=True))
            return
    validate_batch_tip(worktree, value)
    if git(root, "rev-parse", "refs/remotes/origin/main").stdout.strip() != value["base"]:
        fail("protected base branch drifted")
    recorded = {item["branch"] for item in value["sources"]}
    if recorded.intersection(sources):
        fail("batch source is already integrated")
    for item in value["sources"]:
        git(root, "fetch", "origin", item["branch"])
        current = git(root, "rev-parse", f"refs/remotes/origin/{item['branch']}").stdout.strip()
        if current != item["sha"]:
            fail("batch source drifted")
    for source, sha, _record in source_heads:
        git(worktree, "merge", "--no-ff", "--no-edit", sha)
        value["sources"].append({"branch": source, "sha": sha,
                                 "merge": git(worktree, "rev-parse", "HEAD").stdout.strip()})
        value["updated_at"] = now()
        private_json(path, value)
    print(json.dumps(value, sort_keys=True))


@serialized_batch
def command_batch_finalize(args):
    root = root_dir()
    identifier = batch_id(args.batch_id)
    path, value = load_batch(root, identifier)
    if value.get("state", "open") != "open":
        fail("batch source admission is closed")
    selection = value.get("graphify")
    if not value["sources"] or not isinstance(selection, dict):
        fail("batch has no selected Graphify version")
    worktree = Path(value["worktree"])
    if not worktree.is_dir():
        fail("batch worktree is missing")
    source_head = batch_source_tip(value)
    current_head = git(worktree, "rev-parse", "HEAD").stdout.strip()
    if current_head != source_head:
        graph = batch_graph_value(worktree, value, source_head, current_head)
        value.update({"schema_version": 2, "state": "finalized", "finalized_at": now(), "graph": graph})
        private_json(path, value)
        print(json.dumps({"batch_id": identifier, "state": value["state"], "graph": graph},
                         sort_keys=True, separators=(",", ":")))
        return
    dirty = status_paths(worktree)
    if any(not name.startswith("graphify-out/") for name in dirty):
        fail("batch worktree has unrelated changes")
    validate_batch_tip(worktree, value)
    selection = validate_graphify_selection(worktree, selection, source_head)
    adapter = archived_graphify_adapter(root, selection["adapter_sha256"])
    output = worktree / "graphify-out"
    with graphify_finalization_transaction(worktree, output):
        result = run_graphify_adapter(adapter, worktree, output, selection, "finalize", args.timeout)
        if result.returncode:
            fail(result.stderr[-2000:].strip() or "batch Graphify finalization failed")
        try:
            manifest = json.loads((output / "manifest.json").read_text(encoding="utf-8"),
                                  object_pairs_hook=no_duplicate_keys)
            report = (output / "GRAPH_REPORT.md").read_text(encoding="utf-8")
        except (OSError, json.JSONDecodeError):
            fail("batch Graphify output is invalid")
        if not isinstance(manifest, dict) or f"Built from commit: `{source_head}`" not in report:
            fail("batch Graphify output does not match its source tip")
        (output / "graph.receipt.json").unlink(missing_ok=True)
        files, digests = graphify_output_identity(output)
        receipted = [name for name in files if git(
            worktree, "check-ignore", "--quiet", "--", f"graphify-out/{name}", check=False
        ).returncode != 0]
        receipt = {
            "schema_version": 1, "command_contract": "dbsctr-batch-graphify-v1",
            "batch_id": identifier, "source_head": source_head, "adapter": selection,
            "output_files": receipted, "output_sha256": {name: digests[name] for name in receipted},
            "manifest_sha256": digests["manifest.json"], "created_at": now(),
        }
        (output / "graph.receipt.json").write_text(
            json.dumps(receipt, sort_keys=True, indent=2) + "\n", encoding="utf-8")
        git(worktree, "add", "-A", "--", "graphify-out")
        changed = git(worktree, "diff", "--cached", "--name-only").stdout.splitlines()
        if not changed or any(not name.startswith("graphify-out/") for name in changed):
            fail("batch Graphify finalization must change only graphify-out")
        git(worktree, "commit", "-m", f"chore(graphify): finalize {identifier}")
    commit = git(worktree, "rev-parse", "HEAD").stdout.strip()
    graph = batch_graph_value(worktree, value, source_head, commit)
    value.update({"schema_version": 2, "state": "finalized", "finalized_at": now(),
                  "graph": graph})
    private_json(path, value)
    print(json.dumps({"batch_id": identifier, "state": value["state"], "graph": value["graph"]},
                     sort_keys=True, separators=(",", ":")))


@serialized_batch
def command_batch_record_dvc_push(args):
    root = root_dir()
    identifier = batch_id(args.batch_id)
    path, value = load_batch(root, identifier)
    graph = value.get("graph", {})
    if value.get("state") != "finalized" or not graph.get("requires_dvc_push"):
        fail("batch does not require DVC push evidence")
    if args.head != graph.get("commit"):
        fail("batch DVC push evidence must match the graph commit")
    value["dvc_push"] = {"head": args.head, "evidence": args.evidence, "recorded_at": now()}
    private_json(path, value)
    print(json.dumps(value["dvc_push"], sort_keys=True, separators=(",", ":")))


@serialized_batch
def command_batch_publish(args):
    root = root_dir()
    identifier = batch_id(args.batch_id)
    if batch_id(args.confirm) != identifier:
        fail("batch confirmation does not match")
    path, value = load_batch(root, identifier)
    worktree = Path(value["worktree"])
    if not value["sources"] or not worktree.is_dir() or status_paths(worktree):
        fail("batch is not ready for publication")
    graph = value.get("graph")
    if value.get("graphify") and value.get("state") != "finalized":
        fail("batch Graphify finalization is required")
    if graph and graph.get("requires_dvc_push") and value.get("dvc_push", {}).get("head") != graph.get("commit"):
        fail("current DVC push evidence is required")
    validate_batch_tip(worktree, value)
    git(root, "fetch", "origin", "main")
    if git(root, "rev-parse", "refs/remotes/origin/main").stdout.strip() != value["base"]:
        fail("protected base branch drifted")
    for item in value["sources"]:
        git(root, "fetch", "origin", item["branch"])
        if git(root, "rev-parse", f"refs/remotes/origin/{item['branch']}").stdout.strip() != item["sha"]:
            fail("batch source drifted")
    git(worktree, "push", "origin", f"HEAD:{value['branch']}")
    record = {"cycle_id": identifier, "context": "batch integration", "delivery": {
        "branch": value["branch"], "base_branch": "main", "github": value["github"]}}
    pull_request = deliver_draft_pr(worktree, record)
    value["pull_request"] = pull_request
    value["published_at"] = now()
    private_json(path, value)
    print(json.dumps({"batch_id": identifier, "pull_request": pull_request}, sort_keys=True))


def link_improvement_pull_request(record, pull_request, worktree=None, comparison_base=None):
    sessions = record.get("runtime", {}).get("opencode", {}).get("session_ids", [])
    binding = record.get("improvement")
    if not sessions:
        if binding is not None:
            fail("bound improvement cycle has no OpenCode session")
        return
    ledger_root = review_root()
    if not ledger_exists(ledger_root):
        if binding is not None:
            fail("bound improvement worker ledger is missing")
        return
    connection = sqlite3.connect(f"file:{ledger_path(ledger_root)}?mode=ro", uri=True)
    try:
        if connection.execute(
                "SELECT 1 FROM sqlite_master WHERE type='table' AND name='improvement_workers'"
        ).fetchone() is None:
            if binding is not None:
                fail("bound improvement worker ledger is invalid")
            return
    finally:
        connection.close()

    def link(connection):
        row = (connection.execute(
            "SELECT worker_id FROM improvement_workers WHERE worker_id=? AND session_id=? AND opportunity_id=?",
            (binding["worker_id"], binding["session_id"], binding["opportunity_id"]),
        ).fetchone() if binding is not None else connection.execute(
            "SELECT worker_id FROM improvement_workers WHERE session_id=?", (sessions[-1],)
        ).fetchone())
        if row is None:
            if binding is not None:
                fail("bound improvement worker projection is missing")
            return
        worker_id = row[0]
        if worktree is None:
            fail("improvement draft report requires the cycle worktree")
        base = comparison_base or record["delivery"]["base_head"]
        comparison = f"{base}...HEAD"
        changed_paths = sorted(set(filter(None, git(
            worktree, "diff", "--name-only", comparison).stdout.splitlines())))
        diff = git(worktree, "diff", "--binary", comparison).stdout
        implementation_report = improvement_implementation_report({
            "schema_version": 1,
            "pull_request_url": pull_request["url"],
            "changed_paths": changed_paths,
            "diff_digest": hashlib.sha256(diff.encode()).hexdigest(),
            "passed_gates": sorted(name for name, gate in record["gates"].items()
                                   if gate["result"] == "passed"),
        })
        current = improvement_worker(connection, worker_id)
        if current["state"] not in {"implementing", "draft_pr"}:
            fail("improvement worker is not ready for draft_pr delivery")
        connection.execute("""
            UPDATE improvement_workers SET state='draft_pr', resume_state='draft_pr',
                   pr_number=?, pr_url=?, implementation_report=?, updated_at=? WHERE worker_id=?
        """, (pull_request["number"], pull_request["url"],
              implementation_report, int(datetime.now(timezone.utc).timestamp() * 1000), worker_id))

    improvement_write(ledger_root, link)


def finish_push(root, path, record):
    pointer = resolved_active_path(root)
    if record["state"] == "completed":
        pointer.unlink(missing_ok=True)
        prefix = "draft_pr " + record["delivery"]["pull_request"]["url"] + " " if record["delivery_intent"] == "draft_pr" else ""
        print(prefix + "pushed " + " ".join(entry["id"] for entry in record["commits"]))
        return
    require_pushable(record)
    require_current_profile(root, record)
    require_graphify_check(root, record)
    if record.get("schema_version") in (3, 4):
        final_head = git(root, "rev-parse", "HEAD").stdout.strip()
        for name, gate in record["gates"].items():
            if gate["applicability"] == "required" and gate["result"] in ("passed", "failed", "unavailable"):
                item = verify_envelope(root, record, name, require_head=False)
                gate_commits = {entry["id"] for entry in record["commits"] if name in entry["gates"]}
                if item.get("commit") and item["commit"] not in gate_commits:
                    fail(f"evidence commit is not bound to its gate: {name}")
                if not item.get("commit") and item.get("head") != final_head:
                    fail(f"uncommitted gate evidence HEAD is stale: {name}")
    if any(gate["applicability"] == "required" and gate["result"] != "passed" and "exception" not in gate
           for gate in record["gates"].values()):
        fail("required gates have not all passed")
    completion_artifact_check(record)
    if status_paths(root):
        fail("worktree is not clean")
    baseline = record["git"]
    if not baseline["branch"] or branch(root) != baseline["branch"]:
        fail("HEAD is detached or not on the original branch")
    current_upstream = upstream(root)
    if not baseline["upstream"] or current_upstream != baseline["upstream"]:
        fail("upstream is missing or changed")
    delivery = record.get("delivery", {})
    delivery_env = (github_environment(delivery["github"]["account"])
                    if record["delivery_intent"] == "draft_pr" else None)
    if (baseline["pre_cycle_ahead_commits"] and not (
            record["delivery_intent"] == "draft_pr"
            and delivery.get("published_feature_head") == baseline["head"])):
        fail("pre-cycle ahead commits would be pushed")
    remote = delivery.get("remote")
    remote_branch = delivery.get("branch")
    if not remote or not remote_branch:
        remote, remote_branch = remote_for_upstream(root, current_upstream)
    if not remote or not remote_branch:
        fail("upstream is not a remote branch")
    protected_base_branch = delivery.get("protected_base_branch")
    if (record["delivery_intent"] != "draft_pr" and protected_base_branch
            and remote_branch == protected_base_branch):
        fail("direct delivery to the protected base branch requires draft_pr")
    base_branch = (delivery.get("base_branch", "main")
                   if record["delivery_intent"] == "draft_pr" else remote_branch)
    if baseline.get("remote") != remote_destination(root, current_upstream):
        fail("remote push destination changed")
    if record["delivery_intent"] == "draft_pr":
        remote_url = github_remote_url(root, remote, delivery["github"]["repository"])
        fetch_github_branch(root, remote, remote_url, base_branch, delivery_env)
    else:
        remote_url = remote
        git(root, "fetch", remote, base_branch)
    cycle_base = baseline["head"]
    target_ref = (f"refs/remotes/{remote}/{base_branch}"
                  if record["delivery_intent"] == "draft_pr" else current_upstream)
    target_head = git(root, "rev-parse", target_ref).stdout.strip()
    recorded_commits = [entry["id"] for entry in record["commits"]]
    reconciled = False
    base_head = delivery.get("base_head", cycle_base)
    recorded_reconciliation = any(
        git(root, "rev-parse", f"{commit}^2", check=False).stdout.strip() == target_head
        for commit in recorded_commits
    )
    if (record["delivery_intent"] == "draft_pr"
            and (target_head != base_head or recorded_reconciliation)):
        evidence_points, review_point = [], None
        for name, gate in record["gates"].items():
            if gate["applicability"] == "required":
                item = record["evidence"]["items"][gate["evidence"]]
                point = item.get("commit") or item["head"]
                evidence_points.append(point)
                if name == "review_integrate":
                    review_point = point
        current_ahead = validate_draft_reconciliation(
            root, cycle_base, target_head, recorded_commits, evidence_points, review_point
        )
        reconciled = True
    else:
        if (target_head != base_head
                and (git(root, "merge-base", "--is-ancestor", cycle_base, target_head,
                         check=False).returncode
                     or git(root, "merge-base", "--is-ancestor", target_head, "HEAD",
                            check=False).returncode)):
            fail("delivery target advanced outside the cycle lineage")
        reconciled = target_head != base_head
        comparison_base = cycle_base if record["delivery_intent"] == "draft_pr" else current_upstream
        current_ahead = git(root, "rev-list", "--reverse", f"{comparison_base}..HEAD").stdout.splitlines()
    if current_ahead != recorded_commits:
        if not (record["state"] == "finalizing" and not current_ahead and reconciled
                and git(root, "rev-list", "--reverse", f"{cycle_base}..{target_head}").stdout.splitlines()[-len(recorded_commits):]
                    == recorded_commits):
            fail("ahead commits are not exactly the recorded cycle commits")
    if not current_ahead and record["state"] != "finalizing":
        fail("ahead commits are not exactly the recorded cycle commits")
    changed = set(git(root, "diff", "--name-only", f"{cycle_base}..HEAD").stdout.splitlines())
    changelog_path = record["artifact_reviews"]["CHANGELOG"]["path"]
    if changelog_path not in changed:
        fail("reviewed CHANGELOG path is not committed in this cycle")
    dvc_relevant = any(name.endswith(".dvc") or name in ("dvc.yaml", "dvc.lock", ".dvc/config", ".dvcignore")
                       for name in changed)
    if dvc_relevant:
        dvc_targets = sorted(name for name in changed if name.endswith(".dvc"))
        if any(name in changed for name in ("dvc.yaml", "dvc.lock")):
            dvc_targets.append("dvc.yaml")
        if dvc_targets:
            dvc_status = subprocess.run(["dvc", "status", *dvc_targets], cwd=root, text=True, capture_output=True)
            if dvc_status.returncode:
                fail(dvc_status.stderr.strip() or "dvc status failed")
            if "Data and pipelines are up to date." not in dvc_status.stdout:
                fail("dvc status reports changed or missing data")
        dvc_push = record.get("dvc_push")
        if not dvc_push or dvc_push["head"] != git(root, "rev-parse", "HEAD").stdout.strip():
            fail("DVC repository requires separately approved `dvc push` evidence at current HEAD")
    record["phase_profile"] = (validate_phase_profile(record["phase_profile"], record["cycle_id"])
                               if "phase_profile" in record
                               else unavailable_phase_report(record["cycle_id"]))
    if current_ahead:
        record["state"] = "finalizing"
        save(path, record)
        if record["delivery_intent"] == "draft_pr":
            remote_ref = f"refs/heads/{remote_branch}"
            existing = github_remote_head(root, remote_url, remote_ref, delivery_env)
            if existing and git(root, "merge-base", "--is-ancestor", existing[0], "HEAD", check=False).returncode:
                fail("feature branch changed remotely; normal push would not be safe")
        if record["delivery_intent"] == "draft_pr":
            push_github_branch(root, remote_url, remote_branch, delivery_env)
        else:
            git(root, "push", remote_url, f"HEAD:{remote_branch}")
    if record["delivery_intent"] == "draft_pr":
        remote_head = github_remote_head(
            root, remote_url, f"refs/heads/{remote_branch}", delivery_env
        )
        if not remote_head or git(root, "rev-parse", "HEAD").stdout.strip() != remote_head[0]:
            fail("push did not synchronize feature branch")
        record["delivery"]["pull_request"] = deliver_draft_pr(root, record, delivery_env)
        link_improvement_pull_request(record, record["delivery"]["pull_request"], root, target_head)
    elif git(root, "rev-parse", "HEAD").stdout.strip() != git(root, "rev-parse", current_upstream).stdout.strip():
        fail("push did not synchronize upstream")
    if reconciled and record["delivery_intent"] != "draft_pr":
        baseline["head"] = target_head
        baseline["reconciled_at"] = now()
    record["state"] = "completed"
    record["completed_at"] = now()
    save(path, record)
    source_sync = ({"status": "not_applicable", "reason": "draft_pr_delivery"}
                   if record["delivery_intent"] == "draft_pr"
        else sync_source_checkout(record, remote, remote_branch, root))
    record["source_sync"] = source_sync
    save(path, record)
    pointer.unlink()
    prefix = "draft_pr " + record["delivery"]["pull_request"]["url"] + " " if record["delivery_intent"] == "draft_pr" else ""
    profile = json.dumps(record["phase_profile"], sort_keys=True, separators=(",", ":"))
    print(prefix + "pushed " + " ".join(recorded_commits) + " source_sync=" + source_sync["status"]
          + " profile=" + profile)


def command_final_push(args):
    root = root_dir()
    path, record = load(root)
    with target_lock(root, record):
        finish_push(root, path, record)


def command_reconcile_target(args):
    root = root_dir()
    _, record = load(root)
    require_active(record)
    require_current_profile(root, record)
    if status_paths(root):
        fail("target reconciliation requires a clean worktree")
    for operation in ("MERGE_HEAD", "REBASE_HEAD", "CHERRY_PICK_HEAD", "REVERT_HEAD"):
        if git(root, "rev-parse", "--verify", "-q", operation, check=False).returncode == 0:
            fail("another Git operation is already active")

    baseline = record["git"]
    if not baseline["branch"] or branch(root) != baseline["branch"]:
        fail("HEAD is detached or not on the original branch")
    current_upstream = upstream(root)
    if not baseline["upstream"] or current_upstream != baseline["upstream"]:
        fail("upstream is missing or changed")
    if baseline["pre_cycle_ahead_commits"]:
        fail("pre-cycle ahead commits cannot be reconciled")
    if baseline.get("remote") != remote_destination(root, current_upstream):
        fail("remote push destination changed")

    recorded = [entry["id"] for entry in record["commits"]]
    first_parent = git(
        root, "rev-list", "--first-parent", "--reverse", f"{baseline['head']}..HEAD"
    ).stdout.splitlines()
    if not recorded or first_parent != recorded:
        fail("first-parent lineage is not exactly the recorded Gate Commits")

    remote, remote_branch = remote_for_upstream(root, current_upstream)
    if not remote or not remote_branch:
        fail("upstream is not a remote branch")
    with target_lock(root, record):
        git(root, "fetch", remote, remote_branch)
        target = git(root, "rev-parse", current_upstream).stdout.strip()
        if git(root, "merge-base", "--is-ancestor", baseline["head"], target,
               check=False).returncode:
            fail("delivery target no longer descends from the cycle baseline")
        if target == baseline["head"]:
            result = {"status": "up_to_date", "staged_paths": [], "conflict_paths": []}
        elif git(root, "merge-base", "--is-ancestor", target, "HEAD", check=False).returncode == 0:
            result = {"status": "integrated", "staged_paths": [], "conflict_paths": []}
        elif args.mode == "preview":
            result = {"status": "diverged", "staged_paths": [], "conflict_paths": []}
        else:
            merged = git(root, "merge", "--no-commit", "--no-ff", target, check=False)
            conflicts = sorted(set(git(
                root, "diff", "--name-only", "--diff-filter=U"
            ).stdout.splitlines()))
            staged = sorted(set(git(root, "diff", "--cached", "--name-only").stdout.splitlines()))
            if merged.returncode and not conflicts:
                fail(merged.stderr.strip() or "target merge failed without conflicts")
            if len(staged) > 512 or len(conflicts) > 512 or any(
                    len(name.encode()) > 512 for name in staged + conflicts):
                fail("target reconciliation path output exceeded bounds")
            result = {
                "status": "conflicts" if conflicts else "prepared",
                "staged_paths": staged,
                "conflict_paths": conflicts,
            }
    print(json.dumps(result, sort_keys=True, separators=(",", ":")))


INFERENCE_TOKEN_COLUMNS = {
    "input": "tokens_input", "output": "tokens_output", "reasoning": "tokens_reasoning",
    "cache_read": "tokens_cache_read", "cache_write": "tokens_cache_write",
}


def inference_capabilities(connection):
    tables = {row[0].lower(): row[0] for row in connection.execute(
        "SELECT name FROM sqlite_master WHERE type='table'")}
    required = {
        "session": {"id", "time_created", "time_updated", "cost", *INFERENCE_TOKEN_COLUMNS.values()},
        "message": {"id", "session_id", "time_created", "time_updated", "data"},
        "part": {"id", "message_id", "session_id", "time_created", "time_updated", "data"},
    }
    capabilities = {}
    for name, canonical in required.items():
        if name not in tables:
            fail(f"OpenCode database is missing required {name} metadata table")
        columns = {row[1] for row in connection.execute(f'PRAGMA table_info("{tables[name]}")')}
        missing = sorted(canonical - columns)
        if missing:
            fail(f"OpenCode database is missing required metadata columns: {', '.join(missing)}")
        capabilities[name] = {"table": tables[name], "columns": sorted(canonical)}
    return capabilities


def inference_model(provider, model, variant):
    variant = variant if variant is not None else "default"
    if (not isinstance(provider, str) or not OPAQUE_ID.fullmatch(provider)
            or not isinstance(model, str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}", model)
            or not isinstance(variant, str) or not OPAQUE_ID.fullmatch(variant)):
        return "UNAVAILABLE", "UNAVAILABLE", "UNAVAILABLE"
    return provider, model, variant


def load_inference_mapping(path):
    if path is None:
        return {}
    try:
        value = json.loads(Path(path).expanduser().read_text(encoding="utf-8"), object_pairs_hook=no_duplicate_keys)
    except OSError:
        fail("cannot read inference context mapping")
    except json.JSONDecodeError:
        fail("inference context mapping is not valid JSON")
    sessions = value.get("sessions") if isinstance(value, dict) else None
    if (not isinstance(value, dict) or set(value) != {"schema_version", "sessions"}
            or value.get("schema_version") != 1 or not isinstance(sessions, dict)
            or any(not isinstance(key, str) or not OPAQUE_ID.fullmatch(key)
                   or not isinstance(context, str) or not OPAQUE_ID.fullmatch(context)
                   for key, context in sessions.items())):
        fail("inference context mapping has an invalid schema")
    return sessions


def inference_contexts(state_root, mapping):
    contexts = {}
    try:
        records = history_evidence(review_root(state_root))
    except (OSError, RuntimeError, json.JSONDecodeError):
        fail("cannot read sanitized DBSCTR history")
    for record in records:
        session_id = record["session_id"]
        quality = record.get("correlation_quality", "unavailable")
        intervals = []
        if quality in ("exact", "family", "ambiguous"):
            for cycle in record.get("cycles", []):
                if (cycle.get("state") not in ("completed", "active", "blocked")
                        or not isinstance(cycle.get("context"), str)
                        or type(cycle.get("started_at")) is not int
                        or cycle.get("ended_at") is not None and type(cycle["ended_at"]) is not int):
                    continue
                intervals.append({"context": cycle["context"], "started_at": cycle["started_at"],
                                  "ended_at": cycle["ended_at"]})
        contexts[session_id] = {"quality": quality, "intervals": intervals}
    for session_id, context in mapping.items():
        contexts.setdefault(session_id, {"quality": "unavailable", "intervals": []})["mapping"] = context
    return contexts


def inference_attribution(contexts, session_id, timestamp):
    evidence = contexts.get(session_id, {"quality": "unavailable", "intervals": []})
    matching = {item["context"] for item in evidence["intervals"]
                if item["started_at"] <= timestamp
                and (item["ended_at"] is None or timestamp < item["ended_at"])}
    if len(matching) > 1:
        attribution = {"context": "MULTI_CONTEXT", "status": "MULTI_CONTEXT",
                       "confidence": "UNAVAILABLE", "source": "DBSCTR_HISTORY"}
    elif matching:
        attribution = {"context": matching.pop(), "status": "ATTRIBUTED",
                       "confidence": "MEDIUM" if evidence["quality"] == "family" else "HIGH",
                       "source": "DBSCTR_HISTORY"}
    elif evidence["quality"] == "ambiguous" and not evidence["intervals"]:
        attribution = {"context": "MULTI_CONTEXT", "status": "MULTI_CONTEXT",
                       "confidence": "UNAVAILABLE", "source": "DBSCTR_HISTORY"}
    else:
        attribution = {"context": "UNKNOWN", "status": "UNKNOWN",
                       "confidence": "UNAVAILABLE", "source": "UNAVAILABLE"}
    mapped = evidence.get("mapping")
    if mapped is not None:
        if attribution["status"] == "UNKNOWN":
            attribution = {"context": mapped, "status": "ATTRIBUTED",
                           "confidence": "MEDIUM", "source": "EXPLICIT_MAPPING"}
        elif attribution["context"] != mapped:
            attribution = {"context": "MULTI_CONTEXT", "status": "MULTI_CONTEXT",
                           "confidence": "UNAVAILABLE", "source": "CONFLICT"}
    return attribution


def load_inference_rates(path):
    try:
        raw = Path(path).expanduser().read_bytes()
        value = json.loads(raw, object_pairs_hook=no_duplicate_keys)
    except OSError:
        fail("cannot read inference rate card")
    except json.JSONDecodeError:
        fail("inference rate card is not valid JSON")
    entries = value.get("entries") if isinstance(value, dict) else None
    if (not isinstance(value, dict) or set(value) != {"schema_version", "currency", "retrieved_at", "entries"}
            or value.get("schema_version") != 1 or value.get("currency") != "USD"
            or not isinstance(value.get("retrieved_at"), str) or not isinstance(entries, list)):
        fail("inference rate card has an invalid schema")
    parsed = []
    for entry in entries:
        rates = entry.get("usd_per_million_tokens") if isinstance(entry, dict) else None
        fields = {"provider", "model", "effective_from", "effective_to", "source",
                  "max_input_tokens", "usd_per_million_tokens"}
        try:
            converted = {name: (Decimal(str(rates[name])) if rates[name] is not None else None)
                         for name in INFERENCE_TOKEN_COLUMNS}
        except (KeyError, InvalidOperation, TypeError):
            fail("inference rate card has invalid token rates")
        source_value = entry.get("source") if isinstance(entry, dict) else None
        source = urlsplit(source_value) if isinstance(source_value, str) else urlsplit("")
        if (not isinstance(entry, dict) or set(entry) != fields
                or not isinstance(entry.get("provider"), str) or not OPAQUE_ID.fullmatch(entry["provider"])
                or not isinstance(entry.get("model"), str)
                or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}", entry["model"])
                or type(entry.get("effective_from")) is not int or entry["effective_from"] < 0
                or entry.get("effective_to") is not None and (type(entry["effective_to"]) is not int
                    or entry["effective_to"] <= entry["effective_from"])
                or entry.get("max_input_tokens") is not None and (type(entry["max_input_tokens"]) is not int
                    or entry["max_input_tokens"] < 1)
                or not isinstance(entry.get("source"), str) or source.scheme != "https" or not source.hostname
                or source.username is not None or source.password is not None or source.query or source.fragment
                or not isinstance(rates, dict) or set(rates) != set(INFERENCE_TOKEN_COLUMNS)
                or any(rate is not None and (not rate.is_finite() or rate < 0) for rate in converted.values())):
            fail("inference rate card has an invalid entry")
        rate_id = hashlib.sha256(json.dumps(entry, sort_keys=True, separators=(",", ":")).encode()).hexdigest()[:24]
        parsed.append({**entry, "rates": converted, "rate_id": rate_id})
    for index, entry in enumerate(parsed):
        for other in parsed[index + 1:]:
            if entry["provider"] != other["provider"] or entry["model"] != other["model"]:
                continue
            left_end = entry["effective_to"] if entry["effective_to"] is not None else 2**63 - 1
            right_end = other["effective_to"] if other["effective_to"] is not None else 2**63 - 1
            if max(entry["effective_from"], other["effective_from"]) < min(left_end, right_end):
                fail("inference rate card contains overlapping entries")
    return value, parsed, hashlib.sha256(raw).hexdigest()


def nearest_rank(values, fraction):
    ordered = sorted(values)
    return ordered[max(0, math.ceil(len(ordered) * fraction) - 1)]


def inference_number(value):
    value = round(float(value), 6)
    return int(value) if value.is_integer() else value


def inference_stats(values):
    if not values:
        return None
    return {
        "min": min(values), "p25": nearest_rank(values, .25),
        "mean": inference_number(sum(values) / len(values)), "median": inference_number(median(values)),
        "p75": nearest_rank(values, .75), "p95": nearest_rank(values, .95), "max": max(values),
        "population_standard_deviation": inference_number(pstdev(values)),
    }


def inference_money(value):
    return float(value.quantize(Decimal("0.000001")))


def inference_summary(context, records):
    token_total = sum(record["token_total"] for record in records)
    actual_covered = sum(record["token_total"] for record in records if record["actual_cost"] is not None)
    estimate_covered = sum(record["token_total"] for record in records if record["estimated_cost"] is not None)
    actual_values = [record["actual_cost"] for record in records if record["actual_cost"] is not None]
    estimate_values = [record["estimated_cost"] for record in records if record["estimated_cost"] is not None]
    grouped = {}
    for record in records:
        grouped.setdefault((record["provider"], record["model"], record["variant"]), []).append(record)
    models = []
    for (provider, model, variant), members in sorted(grouped.items()):
        models.append({
            "provider": provider, "model": model, "variant": variant,
            "session_count": len({item["session_key"] for item in members}),
            "usage_count": len(members),
            "tokens": sum(item["token_total"] for item in members),
            "actual_cost_usd": (inference_money(sum((item["actual_cost"] for item in members
                                                      if item["actual_cost"] is not None), Decimal()))
                                if any(item["actual_cost"] is not None for item in members) else None),
            "estimated_cost_usd": (inference_money(sum((item["estimated_cost"] for item in members
                                                         if item["estimated_cost"] is not None), Decimal()))
                                   if any(item["estimated_cost"] is not None for item in members) else None),
            "rate_entry_ids": sorted({item["rate_entry"]["id"] for item in members if item["rate_entry"]}),
        })
    sessions = {}
    for record in records:
        session = sessions.setdefault(record["session_key"], {"tokens": 0, "actual": Decimal(),
                                                               "estimated": Decimal(),
                                                               "has_actual": False, "has_estimated": False})
        session["tokens"] += record["token_total"]
        if record["actual_cost"] is not None:
            session["actual"] += record["actual_cost"]
            session["has_actual"] = True
        if record["estimated_cost"] is not None:
            session["estimated"] += record["estimated_cost"]
            session["has_estimated"] = True
    token_values = [item["tokens"] for item in sessions.values()]
    stats = inference_stats(token_values)
    mean = stats["mean"] if stats else 0
    attribution_tokens = sum(record["token_total"] for record in records
                             if record["attribution_status"] == "ATTRIBUTED")
    return {
        "bounded_context": context, "session_count": len(sessions), "usage_count": len(records),
        "reconciled_session_count": len({record["session_key"] for record in records if record["reconciled"]}),
        "unreconciled_session_count": len({record["session_key"] for record in records if not record["reconciled"]}),
        "reconciliation_coverage": (round(sum(record["token_total"] for record in records if record["reconciled"])
                                                  / token_total, 6) if token_total else 1.0),
        **{f"{name}_tokens": sum(record[name] for record in records) for name in INFERENCE_TOKEN_COLUMNS},
        "actual_cost_usd": inference_money(sum(actual_values, Decimal())) if actual_values else None,
        "estimated_cost_usd": inference_money(sum(estimate_values, Decimal())) if estimate_values else None,
        "actual_cost_coverage": round(actual_covered / token_total, 6) if token_total else 1.0,
        "estimated_cost_coverage": round(estimate_covered / token_total, 6) if token_total else 1.0,
        "attribution_coverage": round(attribution_tokens / token_total, 6) if token_total else 1.0,
        "attribution_statuses": {name: len({record["session_key"] for record in records
                                             if record["attribution_status"] == name})
                                 for name in ("ATTRIBUTED", "MULTI_CONTEXT", "UNKNOWN")},
        "attribution_confidence": {name: len({record["session_key"] for record in records
                                               if record["attribution_confidence"] == name})
                                   for name in ("HIGH", "MEDIUM", "UNAVAILABLE")},
        "attribution_sources": {name: len({record["session_key"] for record in records
                                            if record["attribution_source"] == name})
                                for name in ("DBSCTR_HISTORY", "EXPLICIT_MAPPING", "CONFLICT", "UNAVAILABLE")},
        "models": models, "tokens_per_session_stats": stats,
        "actual_cost_per_session_stats": inference_stats([float(item["actual"]) for item in sessions.values()
                                                           if item["has_actual"]]),
        "estimated_cost_per_session_stats": inference_stats([float(item["estimated"]) for item in sessions.values()
                                                              if item["has_estimated"]]),
        "p95_to_median_tokens": (round(stats["p95"] / stats["median"], 6)
                                  if stats and stats["median"] else None),
        "token_coefficient_of_variation": (round(stats["population_standard_deviation"] / mean, 6)
                                             if mean else None),
    }


def inference_markdown(report):
    lines = ["# OpenCode inference cost report", "", "| Bounded context | Sessions | Usage | Tokens | Actual USD | Actual coverage | Estimated USD | Estimated coverage | Attribution coverage | Reconciliation coverage | Models |", "|---|---:|---:|---:|---:|---:|---:|---:|---:|---:|---|"]
    for item in report["contexts"]:
        tokens = sum(item[f"{name}_tokens"] for name in INFERENCE_TOKEN_COLUMNS)
        models = ", ".join(sorted({f'{model["provider"]}/{model["model"]}' for model in item["models"]}))
        lines.append(f'| {item["bounded_context"]} | {item["session_count"]} | {item["usage_count"]} | {tokens} | '
                     f'{item["actual_cost_usd"] if item["actual_cost_usd"] is not None else "unavailable"} | '
                     f'{item["actual_cost_coverage"]:.1%} | '
                     f'{item["estimated_cost_usd"] if item["estimated_cost_usd"] is not None else "unavailable"} | '
                     f'{item["estimated_cost_coverage"]:.1%} | {item["attribution_coverage"]:.1%} | '
                     f'{item["reconciliation_coverage"]:.1%} | {models} |')
    lines.extend(["", "Costs are sums over covered usage; coverage shows the share of tokens represented."])
    return "\n".join(lines) + "\n"


def valid_inference_output(path):
    try:
        manifest = json.loads((path / "manifest.json").read_text(encoding="utf-8"))
        files = manifest["files"]
        return set(files) == {"inference-cost-report.json", "inference-cost-report.md"} and all(
            hashlib.sha256((path / name).read_bytes()).hexdigest() == digest
            for name, digest in files.items())
    except (KeyError, OSError, json.JSONDecodeError, TypeError):
        return False


def publish_inference_report(output, files):
    output = output.expanduser()
    output.parent.mkdir(parents=True, exist_ok=True)
    temporary = Path(tempfile.mkdtemp(prefix=f".{output.name}-", dir=output.parent))
    backup = output.parent / f".{output.name}-backup"
    try:
        if backup.exists():
            if output.exists():
                if valid_inference_output(output):
                    shutil.rmtree(backup)
                else:
                    interrupted = output.parent / f".{output.name}-interrupted"
                    if interrupted.exists():
                        fail("inference report requires manual recovery")
                    os.replace(output, interrupted)
                    os.replace(backup, output)
                    shutil.rmtree(interrupted)
            else:
                os.replace(backup, output)
        for name, content in files.items():
            (temporary / name).write_text(content, encoding="utf-8")
        if output.exists():
            os.replace(output, backup)
        try:
            os.replace(temporary, output)
        except Exception:
            if backup.exists():
                os.replace(backup, output)
            raise
        if backup.exists():
            shutil.rmtree(backup)
    finally:
        if temporary.exists():
            shutil.rmtree(temporary)


def command_inference_cost_report(args):
    database = Path(args.opencode_db).expanduser()
    if not database.is_file():
        fail("OpenCode database is missing")
    if args.after is not None and args.after < 0 or args.before is not None and args.before < 0:
        fail("inference report time bounds must be non-negative milliseconds")
    if args.after is not None and args.before is not None and args.after >= args.before:
        fail("inference report time bounds are invalid")
    rate_card, rates, rate_digest = load_inference_rates(args.rate_card)
    mapping = load_inference_mapping(args.mapping)
    try:
        connection = sqlite3.connect(f"file:{database}?mode=ro", uri=True)
        connection.execute("BEGIN")
        capabilities = inference_capabilities(connection)
        session_table = capabilities["session"]["table"]
        message_table = capabilities["message"]["table"]
        part_table = capabilities["part"]["table"]
        ceilings = {name: connection.execute(
            f'SELECT COALESCE(MAX(rowid), 0) FROM "{value["table"]}"').fetchone()[0]
                    for name, value in capabilities.items()}
        session_columns = ["id", "time_created", "time_updated", "cost", *INFERENCE_TOKEN_COLUMNS.values()]
        session_rows = connection.execute(
            f'SELECT {", ".join(f"\"{name}\"" for name in session_columns)} FROM "{session_table}" '
            f'WHERE rowid <= ? ORDER BY "id"', (ceilings["session"],),
        ).fetchall()
        part_rows = connection.execute(f'''SELECT
            p."id", p."session_id", p."time_created", p."time_updated", m."id",
            json_extract(m."data", '$.role'), json_extract(m."data", '$.providerID'),
            coalesce(json_extract(m."data", '$.modelID'), json_extract(m."data", '$.model.id')),
            coalesce(json_extract(m."data", '$.variant'), 'default'),
            json_extract(p."data", '$.cost'), json_extract(p."data", '$.tokens.input'),
            json_extract(p."data", '$.tokens.output'), json_extract(p."data", '$.tokens.reasoning'),
            json_extract(p."data", '$.tokens.cache.read'), json_extract(p."data", '$.tokens.cache.write')
            FROM "{part_table}" p
            LEFT JOIN "{message_table}" m ON m."id" = p."message_id" AND m."session_id" = p."session_id"
            WHERE p.rowid <= ? AND json_extract(p."data", '$.type') = 'step-finish'
            ORDER BY p."id"''', (ceilings["part"],)).fetchall()
    except sqlite3.Error as error:
        fail(f"cannot read OpenCode database: {error}")
    finally:
        if "connection" in locals():
            connection.close()
    source_identity, attribution_identity = hashlib.sha256(), hashlib.sha256()
    parts_by_session = {}
    for row in part_rows:
        part_id, session_id, timestamp, updated, message_id, role, provider, model, variant, raw_cost, *tokens = row
        if (not isinstance(part_id, str) or not OPAQUE_ID.fullmatch(part_id)
                or not isinstance(session_id, str) or not OPAQUE_ID.fullmatch(session_id)
                or not isinstance(message_id, str) or not OPAQUE_ID.fullmatch(message_id)
                or role != "assistant" or type(timestamp) is not int or timestamp < 0
                or type(updated) is not int or updated < timestamp
                or any(type(value) is not int for value in tokens)
                or not isinstance(raw_cost, (int, float)) or isinstance(raw_cost, bool)
                or not math.isfinite(raw_cost)):
            fail("OpenCode canonical usage metadata contains invalid values")
        provider, model, variant = inference_model(provider, model, variant)
        token_values = dict(zip(INFERENCE_TOKEN_COLUMNS, tokens))
        parts_by_session.setdefault(session_id, []).append({
            "part_key": part_id, "session_key": session_id, "timestamp": timestamp, "updated": updated,
            "provider": provider, "model": model, "variant": variant,
            "raw_cost": Decimal(str(raw_cost)), "valid_usage": raw_cost >= 0 and all(value >= 0 for value in tokens),
            "token_total": sum(tokens), **token_values,
        })
        source_identity.update(json.dumps(row, sort_keys=True, default=str).encode() + b"\0")
    contexts = inference_contexts(args.state_root, mapping)
    records = []
    for row in session_rows:
        session_id, timestamp, updated, raw_cost, *tokens = row
        if (not isinstance(session_id, str) or not OPAQUE_ID.fullmatch(session_id)
                or type(timestamp) is not int or timestamp < 0 or type(updated) is not int or updated < timestamp
                or any(type(value) is not int or value < 0 for value in tokens)
                or not isinstance(raw_cost, (int, float)) or isinstance(raw_cost, bool)
                or not math.isfinite(raw_cost) or raw_cost < 0):
            fail("OpenCode session metadata contains invalid values")
        token_values = dict(zip(INFERENCE_TOKEN_COLUMNS, tokens))
        total = sum(tokens)
        source_identity.update(json.dumps(row, sort_keys=True, default=str).encode() + b"\0")
        members = parts_by_session.pop(session_id, [])
        reconciled = (all(item["valid_usage"] for item in members)
                      and tokens == [sum(item[name] for item in members) for name in INFERENCE_TOKEN_COLUMNS]
                      and abs(sum((item["raw_cost"] for item in members), Decimal())
                              - Decimal(str(raw_cost))) <= Decimal("0.000001"))
        if not reconciled:
            if (args.after is not None and timestamp < args.after
                    or args.before is not None and timestamp >= args.before):
                continue
            actual = Decimal(str(raw_cost)) if raw_cost > 0 or total == 0 else None
            records.append({"session_key": session_id, "context": "UNKNOWN",
                            "attribution_status": "UNKNOWN", "attribution_confidence": "UNAVAILABLE",
                            "attribution_source": "UNAVAILABLE", "provider": "UNAVAILABLE",
                            "model": "UNAVAILABLE", "variant": "UNAVAILABLE", "actual_cost": actual,
                            "estimated_cost": None, "rate_entry": None, "reconciled": False,
                            "token_total": total, **token_values})
            continue
        for member in members:
            if (args.after is not None and member["timestamp"] < args.after
                    or args.before is not None and member["timestamp"] >= args.before):
                continue
            attribution = inference_attribution(contexts, session_id, member["timestamp"])
            matching = [entry for entry in rates
                        if entry["provider"] == member["provider"] and entry["model"] == member["model"]
                        and entry["effective_from"] <= member["timestamp"]
                        and (entry["effective_to"] is None or member["updated"] < entry["effective_to"])
                        and (entry["max_input_tokens"] is None or sum(member[name] for name in (
                            "input", "cache_read", "cache_write")) <= entry["max_input_tokens"])]
            estimated, rate_entry = None, None
            if len(matching) == 1 and all(
                    matching[0]["rates"][name] is not None or member[name] == 0
                    for name in INFERENCE_TOKEN_COLUMNS):
                estimated = sum((Decimal(member[name]) * (matching[0]["rates"][name] or Decimal())
                                 for name in INFERENCE_TOKEN_COLUMNS), Decimal()) / Decimal(1_000_000)
                rate_entry = {"id": matching[0]["rate_id"], "provider": member["provider"],
                              "model": member["model"], "effective_from": matching[0]["effective_from"],
                              "effective_to": matching[0]["effective_to"], "source": matching[0]["source"]}
            actual = member["raw_cost"] if member["raw_cost"] > 0 or member["token_total"] == 0 else None
            attribution_identity.update(
                f'{session_id}\0{member["part_key"]}\0{attribution["context"]}\0{attribution["status"]}\0'
                f'{attribution["confidence"]}\0{attribution["source"]}\0'.encode())
            records.append({"session_key": session_id, "context": attribution["context"],
                            "attribution_status": attribution["status"],
                            "attribution_confidence": attribution["confidence"],
                            "attribution_source": attribution["source"], "provider": member["provider"],
                            "model": member["model"], "variant": member["variant"], "actual_cost": actual,
                            "estimated_cost": estimated, "rate_entry": rate_entry, "reconciled": True,
                            "token_total": member["token_total"],
                            **{name: member[name] for name in INFERENCE_TOKEN_COLUMNS}})
    if parts_by_session:
        fail("OpenCode canonical usage references a missing session control")
    capability = {"adapter": "opencode_step_finish_v2",
                  "tables": {name: value["columns"] for name, value in capabilities.items()}}
    if args.dry_run:
        print(json.dumps({"schema_version": 2, "capabilities": capability,
                          "planned_session_count": len({record["session_key"] for record in records}),
                          "planned_usage_count": len(records),
                          "unreconciled_session_count": len({record["session_key"] for record in records
                                                              if not record["reconciled"]})},
                         sort_keys=True, separators=(",", ":")))
        return
    summaries = [inference_summary(context, [record for record in records if record["context"] == context])
                 for context in sorted({record["context"] for record in records})]
    used_rates = {record["rate_entry"]["id"]: record["rate_entry"] for record in records if record["rate_entry"]}
    report = {"schema_version": 2, "source_snapshot": {"session_ceiling": ceilings["session"],
               "message_ceiling": ceilings["message"], "part_ceiling": ceilings["part"],
               "database_digest": source_identity.hexdigest(), "after": args.after, "before": args.before,
               "attribution_digest": attribution_identity.hexdigest(), "capabilities": capability},
               "rate_card": {"schema_version": rate_card["schema_version"],
               "retrieved_at": rate_card["retrieved_at"], "digest": rate_digest,
               "used_entries": [used_rates[key] for key in sorted(used_rates)]},
               "contexts": summaries, "totals": inference_summary("ALL", records)}
    report_json = json.dumps(report, sort_keys=True, indent=2) + "\n"
    markdown = inference_markdown(report)
    generated = now()
    manifest = {"schema_version": 2, "generated_at": generated,
                "files": {"inference-cost-report.json": hashlib.sha256(report_json.encode()).hexdigest(),
                          "inference-cost-report.md": hashlib.sha256(markdown.encode()).hexdigest()},
                "source_snapshot": report["source_snapshot"], "rate_card": report["rate_card"]}
    try:
        publish_inference_report(Path(args.output_dir), {
            "inference-cost-report.json": report_json, "inference-cost-report.md": markdown,
            "manifest.json": json.dumps(manifest, sort_keys=True, indent=2) + "\n",
        })
    except OSError:
        fail("cannot publish inference report")
    print(json.dumps({"status": "written", "session_count": len({record["session_key"] for record in records}),
                      "usage_count": len(records),
                      "context_count": len(summaries)}, sort_keys=True, separators=(",", ":")))


def graphify_timeout(value):
    try:
        timeout = int(value)
    except ValueError as error:
        raise argparse.ArgumentTypeError("timeout must be an integer") from error
    if not 1 <= timeout <= 3600:
        raise argparse.ArgumentTypeError("timeout must be 1 through 3600 seconds")
    return timeout


def parser():
    result = argparse.ArgumentParser(prog="dbsctrctl")
    commands = result.add_subparsers(dest="command", required=True)
    start = commands.add_parser("start")
    start.add_argument("--cycle-id", required=True)
    start.add_argument("--context", required=True)
    start.add_argument("--risk", required=True, choices=("routine", "elevated", "critical"))
    start.add_argument("--delivery-intent", required=True, choices=DELIVERY_INTENTS)
    start.add_argument("--plan", required=True, help="applicability-plan JSON path or - for stdin")
    start.add_argument("--github-account")
    start.add_argument("--github-repository")
    start.add_argument("--base-branch", default="main")
    start.set_defaults(func=command_start)
    begin = commands.add_parser("begin")
    begin.add_argument("--cycle-id", required=True)
    begin.add_argument("--context", required=True)
    begin.add_argument("--risk", required=True, choices=("routine", "elevated", "critical"))
    begin.add_argument("--delivery-intent", required=True, choices=DELIVERY_INTENTS)
    begin.add_argument("--plan", required=True, help="applicability-plan JSON path or - for stdin")
    begin.add_argument("--github-account")
    begin.add_argument("--github-repository")
    begin.add_argument("--base-branch", default="main")
    begin.add_argument("--worktree-root")
