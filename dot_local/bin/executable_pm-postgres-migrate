#!/bin/sh
set -eu

attempt=0
until podman exec pm-postgres pg_isready -U pm_kernel -d pm_kernel >/dev/null 2>&1; do
  attempt=$((attempt + 1))
  test "$attempt" -lt 60 || { echo "pm-postgres: readiness timed out" >&2; exit 1; }
  sleep 1
done

podman exec pm-postgres psql -v ON_ERROR_STOP=1 -U pm_kernel -d pm_kernel \
  -f /docker-entrypoint-initdb.d/001-pm-kernel.sql
test "$(podman exec pm-postgres psql -v ON_ERROR_STOP=1 -At -U pm_kernel -d pm_kernel \
  -c 'SELECT 1 FROM context.schema_migrations WHERE version=1')" = 1
