#!/bin/bash
set -euo pipefail

{{ if ne .chezmoi.os "linux" -}}
exit 0
{{ end -}}

version={{ .dotfiles_ai.codex.version | quote }}
url={{ .dotfiles_ai.codex.linux_asset_url | quote }}
sha256={{ .dotfiles_ai.codex.linux_asset_sha256 | quote }}
directory="$HOME/.local/libexec/dotfiles-ai"
target="$directory/codex"
[[ ! -e $directory || ( -d $directory && ! -L $directory ) ]] || {
    echo "managed Codex directory is unsafe" >&2
    exit 1
}
"$HOME/.local/bin/codex-archive" --validate-target "$target"

valid_version() {
    local output=$1
    [[ ${#output} -le 128 && ( $output == "$version" || $output == *" $version" ) ]]
}

if [[ -x $target && ! -L $target ]] && output=$($target --version 2>/dev/null) && valid_version "$output"; then
    exit 0
fi
tmp=$(mktemp -d)
trap 'rm -rf "$tmp" "$target.new"' EXIT
curl -fsSL --retry 3 --retry-all-errors --connect-timeout 10 --max-time 180 "$url" -o "$tmp/codex.tar.gz"
printf '%s  %s\n' "$sha256" "$tmp/codex.tar.gz" | sha256sum -c -
binary="$tmp/codex-aarch64-unknown-linux-musl"
"$HOME/.local/bin/codex-archive" "$tmp/codex.tar.gz" "$binary"
[[ -f $binary && -x $binary && ! -L $binary ]] || { echo "Codex release archive is invalid" >&2; exit 1; }
install -d -m 0700 "$directory"
rm -f "$target.new"
install -m 0755 "$binary" "$target.new"
output=$($target.new --version)
valid_version "$output" || { echo "managed Codex version mismatch" >&2; exit 1; }
mv -f "$target.new" "$target"
