#!/usr/bin/env python3
import contextlib
import fcntl
import json
import os
import re
import shlex
import signal
import sqlite3
import stat
import subprocess
import sys
import tempfile
import time
from pathlib import Path

HERDR = os.environ.get("HERDR_BIN", "herdr")


def safe_regular(path: Path) -> None:
    details = path.lstat()
    if (not stat.S_ISREG(details.st_mode) or details.st_uid != os.getuid()
            or details.st_mode & 0o022):
        raise ValueError("unsafe state file")


def safe_directory(path: Path) -> None:
    details = path.lstat()
    if (not stat.S_ISDIR(details.st_mode) or details.st_uid != os.getuid()
            or details.st_mode & 0o022):
        raise ValueError("unsafe state directory")


def read_state(path: Path) -> str:
    safe_regular(path)
    with os.fdopen(os.open(path, os.O_RDONLY | os.O_NOFOLLOW)) as handle:
        value = handle.read(1024 * 1024 + 1)
    if len(value) > 1024 * 1024:
        raise ValueError("oversized state file")
    return value


def atomic_state(path: Path, value: str) -> None:
    safe_directory(path.parent)
    if path.exists() or path.is_symlink():
        safe_regular(path)
    descriptor, name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(descriptor, "w") as handle:
            handle.write(value)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(name, path)
    finally:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(name)


def pace_start(command: list[str]) -> int:
    if not command:
        raise ValueError("paced start requires a command")
    root = Path(os.environ.get("DOTFILES_AI_STATE_ROOT") or os.environ.get("TMPDIR", "/tmp")) / "herdr"
    owned = False
    lock = root / "opencode-startup.lock"
    timestamp = root / "opencode-startup.timestamp"
    for number in (signal.SIGINT, signal.SIGTERM):
        signal.signal(number, lambda signum, _: sys.exit(128 + signum))
    try:
        root.mkdir(exist_ok=True)
        safe_directory(root)
        if not os.access(root, os.W_OK | os.X_OK):
            raise OSError("pacing directory unavailable")
        started = progress = time.monotonic()
        last_seen = None
        while True:
            if lock.exists() or lock.is_symlink():
                with contextlib.suppress(FileNotFoundError):
                    safe_regular(lock)
            stamp = read_state(timestamp) if timestamp.exists() or timestamp.is_symlink() else "0"
            if stamp != last_seen:
                progress, last_seen = time.monotonic(), stamp
            result = subprocess.run(["/usr/bin/shlock", "-p", str(os.getpid()), "-f", str(lock)],
                                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
            if result.returncode == 0:
                owned = True
                break
            now = time.monotonic()
            if now - progress >= 20 or now - started >= 300:
                print("OpenCode start blocked: pacing queue stalled or exceeded five minutes; "
                      "retry after pending starts settle", file=sys.stderr)
                return 75
            time.sleep(0.1)
        stamp = read_state(timestamp) if timestamp.exists() or timestamp.is_symlink() else "0"
        last = int(stamp.strip()) if re.fullmatch(r"[0-9]{1,12}\s*", stamp) else 0
        now = int(time.time())
        if last <= now:
            time.sleep(max(0, 6 - now + last))
        atomic_state(timestamp, str(int(time.time())) + "\n")
    except (OSError, ValueError, subprocess.SubprocessError):
        print("OpenCode start blocked: pacing state is unsafe or unavailable; run herdr-host doctor",
              file=sys.stderr)
        return 75
    finally:
        if owned:
            # Keep the shared shlock identity for compatibility with older wrappers.
            try:
                if read_state(lock).strip() != str(os.getpid()):
                    raise ValueError("pacing lock owner changed")
                lock.unlink()
            except (OSError, ValueError):
                print("OpenCode start blocked: pacing lock cannot be safely released", file=sys.stderr)
                raise SystemExit(75)
    os.execvp(command[0], command)
    return 0


class HostPreflightError(RuntimeError):
    def __init__(self, status: int, message: str) -> None:
        super().__init__(message)
        self.status = status


def preflight_host(*, cached: bool = False) -> None:
    host = Path(os.environ.get("HERDR_HOST_BIN", Path.home() / ".local/bin/herdr-host"))
    active = os.environ.get("HERDR_HOST_ACTIVE") == "1"
    if not host.is_file() or not os.access(host, os.X_OK):
        if active:
            raise HostPreflightError(
                75,
                "Herdr Host health preflight is unavailable; run herdr-host doctor",
            )
        return
    arguments = [str(host), "preflight", "--if-active"]
    if cached:
        arguments.append("--cached")
    try:
        result = subprocess.run(
            arguments,
            check=False,
            capture_output=True,
            text=True,
            timeout=5,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise HostPreflightError(
            75,
            "Herdr Host health preflight is unavailable; run herdr-host doctor",
        ) from error
    if result.returncode:
        message = result.stderr.strip() or (
            "Herdr Host blocked external-state access; run herdr-host doctor"
        )
        raise HostPreflightError(result.returncode, message)


def capture_failure_message(error: Exception) -> str:
    if isinstance(error, OSError):
        return f"operating-system error {error.errno if error.errno is not None else 'unknown'}"
    if isinstance(error, subprocess.SubprocessError):
        return "Herdr command failed"
    if isinstance(error, (json.JSONDecodeError, ValueError, KeyError, TypeError)):
        return "invalid structured recovery data"
    return "unexpected internal error"

def run(*args: str) -> dict:
    return json.loads(subprocess.run((HERDR, *args), check=True, capture_output=True, text=True, timeout=10).stdout)


def session_argument(argv: list[str]) -> str | None:
    for index, argument in enumerate(argv):
        if argument == "--session" and index + 1 < len(argv):
            return argv[index + 1]
        if argument.startswith("--session="):
            return argument.partition("=")[2]
    return None


def pane_state(pane: str) -> tuple[str | None, bool]:
    processes = run("pane", "process-info", "--pane", pane)["result"]["process_info"]["foreground_processes"]
    for process in processes:
        argv = process.get("argv", [])
        if argv and Path(argv[0]).name == "opencode" and (session := session_argument(argv)):
            return session, True
    return None, bool(processes)


def pane_session(pane: str) -> str | None:
    return pane_state(pane)[0]


def validate_entries(document: dict) -> list[dict]:
    if (not isinstance(document, dict) or set(document) != {"schema_version", "sessions"}
            or type(document["schema_version"]) is not int or document["schema_version"] not in (1, 2)
            or not isinstance(document["sessions"], list)):
        raise ValueError("invalid OpenCode recovery manifest")
    entries = document["sessions"]
    required = {"pane_id", "directory", "session_id"}
    if document["schema_version"] == 2:
        required.add("recovery_state")
    if any(not isinstance(item, dict) or set(item) != required
           or not all(isinstance(item[key], str) and item[key] for key in required) for item in entries):
        raise ValueError("invalid OpenCode recovery entry")
    if any(not re.fullmatch(r"ses_[A-Za-z0-9]+", item["session_id"])
           or not re.fullmatch(r"[A-Za-z0-9]+:[A-Za-z0-9]+", item["pane_id"])
           or not Path(item["directory"]).is_absolute()
           or item.get("recovery_state", "pending") not in ("pending", "observed") for item in entries):
        raise ValueError("unsafe OpenCode recovery entry")
    if (len({item["pane_id"] for item in entries}) != len(entries)
            or len({item["session_id"] for item in entries}) != len(entries)):
        raise ValueError("conflicting OpenCode recovery entries")
    return [{**item, "recovery_state": item.get("recovery_state", "pending")} for item in entries]


def load_manifest(manifest: Path) -> list[dict]:
    try:
        return validate_entries(json.loads(read_state(manifest)))
    except FileNotFoundError:
        if manifest.is_symlink():
            raise ValueError("unsafe recovery manifest")
        return []


def save_manifest(manifest: Path, entries: list[dict]) -> None:
    document = {"schema_version": 2, "sessions": entries}
    validate_entries(document)
    atomic_state(manifest, json.dumps(document, indent=2) + "\n")


@contextlib.contextmanager
def recovery_lock(manifest: Path):
    safe_directory(manifest.parent)
    lock = manifest.parent / "opencode-restore.lock"
    descriptor = os.open(lock, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    with os.fdopen(descriptor, "r+") as handle:
        safe_regular(lock)
        deadline = time.monotonic() + 5
        while True:
            try:
                fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise RuntimeError("recovery state busy")
                time.sleep(0.1)
        yield


def running_sessions() -> list[dict]:
    sessions = []
    panes = run("pane", "list")["result"]["panes"]
    if not isinstance(panes, list):
        raise ValueError("invalid pane inventory")
    for pane in panes:
        pane_id = pane.get("pane_id")
        if not isinstance(pane_id, str):
            raise ValueError("invalid pane inventory")
        process = run("pane", "process-info", "--pane", pane_id)["result"]["process_info"]
        processes = process["foreground_processes"]
        if not isinstance(processes, list):
            raise ValueError("invalid process inventory")
        for foreground in processes:
            argv, directory = foreground.get("argv", []), foreground.get("cwd")
            if not isinstance(argv, list) or not argv or not all(isinstance(arg, str) for arg in argv):
                raise ValueError("incomplete process inventory")
            if Path(argv[0]).name == "opencode":
                session = session_argument(argv)
                if not session:
                    raise ValueError("OpenCode identity unavailable")
                sessions.append({"pane_id": pane_id, "directory": directory, "session_id": session,
                                 "recovery_state": "observed"})
                break
    return validate_entries({"schema_version": 2, "sessions": sessions})


def capture(manifest: Path) -> int:
    with recovery_lock(manifest):
        previous = load_manifest(manifest)
        observed = running_sessions()
        running = {item["session_id"] for item in observed}
        pending = [item for item in previous if item["recovery_state"] == "pending"
                   and item["session_id"] not in running]
        save_manifest(manifest, pending + observed)
    return 0


def main() -> int:
    if sys.argv[1:2] == ["--pace-start"]:
        return pace_start(sys.argv[2:])
    check = sys.argv[1:] == ["--check"]
    capturing = sys.argv[1:] == ["--capture"]
    watching = sys.argv[1:] == ["--watch"]
    if sys.argv[1:] not in ([], ["--check"], ["--capture"], ["--watch"]):
        raise ValueError("usage: herdr-opencode-restore [--check|--capture|--watch|--pace-start COMMAND...]")
    root_value = os.environ.get("DOTFILES_AI_STATE_ROOT")
    if not root_value:
        if os.environ.get("HERDR_HOST_ACTIVE") == "1":
            print("Herdr Host active owner has no configured state root", file=sys.stderr)
            return 78
        return 0
    root = Path(root_value)
    manifest = root / "herdr/opencode-sessions.json"
    if capturing:
        try:
            preflight_host()
        except HostPreflightError as error:
            print(error, file=sys.stderr)
            return error.status
        return capture(manifest)
    if watching:
        blocked = False
        while True:
            time.sleep(60)
            try:
                preflight_host()
            except HostPreflightError as error:
                if not blocked:
                    print(error, file=sys.stderr)
                blocked = True
                continue
            blocked = False
            try:
                capture(manifest)
            except Exception as error:
                print(
                    f"OpenCode session capture failed: {capture_failure_message(error)}",
                    file=sys.stderr,
                )
    try:
        preflight_host()
    except HostPreflightError as error:
        print(error, file=sys.stderr)
        return error.status
    database = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "opencode/opencode.db"
    opencode = Path.home() / ".local/bin/opencode"
    if not manifest.exists() and not manifest.is_symlink():
        return 0

    with recovery_lock(manifest):
        entries = load_manifest(manifest)
        if not check:
            entries = [{**item, "recovery_state": "pending"} for item in entries]
            save_manifest(manifest, entries)
        if not database.is_file() or not opencode.is_file():
            raise RuntimeError("recovery database or wrapper unavailable")
        return restore(manifest, entries, database, opencode, check)


def restore(manifest: Path, entries: list[dict], database: Path, opencode: Path, check: bool) -> int:
    with sqlite3.connect(f"file:{database}?mode=ro", uri=True) as connection:
        known = {row[0] for row in connection.execute(
            f"SELECT id FROM session WHERE id IN ({','.join('?' for _ in entries)})",
            [entry["session_id"] for entry in entries],
        )} if entries else set()

    agents = run("agent", "list")["result"]["agents"]
    running = {agent.get("agent_session", {}).get("value") for agent in agents}
    failures = []
    for entry in entries:
        session, pane, directory = entry["session_id"], entry["pane_id"], Path(entry["directory"])
        try:
            if session not in known or not directory.is_dir():
                raise RuntimeError("session or directory unavailable")
            current = run("pane", "get", pane)["result"]["pane"]
            active_session, occupied = pane_state(pane)
            if active_session == session:
                if not check:
                    entry["recovery_state"] = "observed"
                    save_manifest(manifest, entries)
                continue
            if session in running:
                raise RuntimeError("session is running in another pane")
            if current.get("agent") or occupied:
                raise RuntimeError("pane is occupied")
            pane_directory = current.get("foreground_cwd") or current.get("cwd")
            if not isinstance(pane_directory, str) or Path(pane_directory).resolve() != directory.resolve():
                raise RuntimeError("pane directory mismatch")
            if check:
                continue
            command = "exec " + shlex.join([str(opencode), "--session", session, "--auto"])
            subprocess.run(
                [HERDR, "pane", "run", pane, command],
                cwd=directory, check=True, capture_output=True, text=True, timeout=10,
            )
            for _ in range(300):
                if pane_session(pane) == session:
                    break
                time.sleep(0.1)
            else:
                raise RuntimeError("restored session identity mismatch")
            entry["recovery_state"] = "observed"
            save_manifest(manifest, entries)
        except subprocess.CalledProcessError as error:
            failures.append("Herdr command failed")
        except Exception as error:
            failures.append(capture_failure_message(error))

    if failures:
        print(
            f"OpenCode recovery failed for {len(failures)} entr{'y' if len(failures) == 1 else 'ies'}: "
            f"{failures[0]}",
            file=sys.stderr,
        )
        return 1
    if check:
        print(f"validated {len(entries)} OpenCode recovery sessions")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as error:
        print(f"OpenCode recovery failed: {capture_failure_message(error)}", file=sys.stderr)
        raise SystemExit(1)
