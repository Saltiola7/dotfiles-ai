#!/usr/bin/env python3
import os
from pathlib import Path
import shutil
import sys
import tarfile


EXPECTED = "codex-aarch64-unknown-linux-musl"
MAX_SIZE = 320 * 1024 * 1024


def validate_target(target):
    target = Path(target)
    if not os.path.lexists(target):
        return
    metadata = target.stat(follow_symlinks=False)
    if (target.is_symlink() or not metadata or not os.path.isfile(target)
            or metadata.st_uid != os.getuid()):
        raise ValueError("managed Codex target has unsafe type")


def extract(archive, destination, expected=EXPECTED):
    archive = Path(archive)
    destination = Path(destination)
    if destination.exists() or destination.is_symlink():
        raise ValueError("Codex archive destination already exists")
    with tarfile.open(archive, "r:gz") as bundle:
        members = bundle.getmembers()
        if (len(members) != 1 or members[0].name != expected or not members[0].isreg()
                or members[0].size <= 0 or members[0].size > MAX_SIZE):
            raise ValueError("Codex archive has an unsafe member set")
        source = bundle.extractfile(members[0])
        if source is None:
            raise ValueError("Codex archive executable is unavailable")
        descriptor = os.open(destination, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o700)
        try:
            with os.fdopen(descriptor, "wb") as output:
                shutil.copyfileobj(source, output, 64 * 1024)
                output.flush()
                os.fsync(output.fileno())
        except Exception:
            destination.unlink(missing_ok=True)
            raise


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    if argv[:1] == ["--validate-target"] and len(argv) == 2:
        validate_target(argv[1])
        return
    if len(argv) not in {2, 3}:
        raise SystemExit("usage: codex-archive ARCHIVE DESTINATION [EXPECTED]")
    extract(argv[0], argv[1], argv[2] if len(argv) == 3 else EXPECTED)


if __name__ == "__main__":
    main()
