#!/usr/bin/env python3
import fcntl
import json
import os
import signal
import subprocess
import sys
import time
from pathlib import Path


ROOT = Path(os.environ.get("DOTFILES_AI_STATE_ROOT", "~/.local/state")).expanduser()
DIRECTORY = ROOT / "dotfiles-ai/history-projection-refresh"
STATUS = DIRECTORY / "status.json"
LOCK = DIRECTORY / "run.lock"
FIELDS = ("schema_version", "state", "failure_class", "consecutive_failures", "started_at",
          "finished_at", "duration_seconds", "snapshot_age_seconds", "snapshot_size_bytes")
STATES = {"never_run", "running", "succeeded", "failed", "timed_out"}
FAILURES = {"timeout", "source_unavailable", "refresh_failed", "status_invalid"}


def never_run():
    return dict(zip(FIELDS, (1, "never_run", None, 0, None, None, None, None, None)))


def invalid():
    sys.stderr.write("scheduler_state_invalid\n")
    raise SystemExit(75)


def valid(value):
    if not isinstance(value, dict) or tuple(value) != FIELDS or value["schema_version"] != 1:
        return False
    if value["state"] not in STATES or not isinstance(value["consecutive_failures"], int) or value["consecutive_failures"] < 0:
        return False
    if value["failure_class"] is not None and value["failure_class"] not in FAILURES:
        return False
    if value["state"] in {"failed", "timed_out"} and value["failure_class"] is None:
        return False
    if value["state"] not in {"failed", "timed_out"} and value["failure_class"] is not None:
        return False
    return all(item is None or isinstance(item, int) and item >= 0 for item in (
        value["started_at"], value["finished_at"], value["duration_seconds"],
        value["snapshot_age_seconds"], value["snapshot_size_bytes"],
    ))


def read_status():
    if not os.path.lexists(STATUS):
        return never_run()
    try:
        info = STATUS.lstat()
        if (STATUS.is_symlink() or info.st_uid != os.getuid() or not info.st_mode & 0o600
                or info.st_mode & 0o077 or info.st_size > 4096):
            invalid()
        value = json.loads(STATUS.read_text())
    except (OSError, ValueError, json.JSONDecodeError):
        invalid()
    if not valid(value):
        invalid()
    return value


def write_status(value):
    DIRECTORY.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(DIRECTORY, 0o700)
    temporary = DIRECTORY / ".status.tmp"
    try:
        descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(descriptor, "w") as handle:
            json.dump(value, handle, separators=(",", ":"))
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, STATUS)
    except OSError:
        temporary.unlink(missing_ok=True)
        raise


def run(timeout):
    DIRECTORY.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(DIRECTORY, 0o700)
    with LOCK.open("a+") as lock:
        os.chmod(LOCK, 0o600)
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return 0
        previous = read_status()
        started = time.time_ns() // 1_000_000
        running = {**previous, "state": "running", "failure_class": None, "started_at": started,
                   "finished_at": None, "duration_seconds": None}
        write_status(running)
        timed_out = False
        try:
            child = subprocess.Popen(["dbsctrctl", "history-source-index-refresh"], start_new_session=True,
                                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            try:
                result = child.wait(timeout=timeout)
            except subprocess.TimeoutExpired:
                timed_out = True
                os.killpg(child.pid, signal.SIGTERM)
                try:
                    child.wait(timeout=30)
                except subprocess.TimeoutExpired:
                    os.killpg(child.pid, signal.SIGKILL)
                    child.wait()
                result = 1
        except OSError:
            result = 1
        finished = time.time_ns() // 1_000_000
        if result == 0:
            final = {**running, "state": "succeeded", "finished_at": finished,
                     "duration_seconds": finished - started, "consecutive_failures": 0}
            event = "succeeded"
        else:
            failure = "timeout" if timed_out else "refresh_failed"
            final = {**running, "state": "timed_out" if timed_out else "failed", "failure_class": failure,
                     "finished_at": finished, "duration_seconds": finished - started,
                     "consecutive_failures": previous["consecutive_failures"] + 1}
            event = failure
        write_status(final)
        print(f"history_projection_refresh={event}")
        return 0 if result == 0 else 1


def main():
    if len(sys.argv) < 2 or sys.argv[1] not in {"run", "status"}:
        raise SystemExit(64)
    if sys.argv[1] == "status":
        if len(sys.argv) != 2:
            raise SystemExit(64)
        print(json.dumps(read_status(), separators=(",", ":")))
        return
    if len(sys.argv) != 3 or not sys.argv[2].isdigit() or not 900 <= int(sys.argv[2]) <= 3600:
        raise SystemExit(64)
    raise SystemExit(run(int(sys.argv[2])))


if __name__ == "__main__":
    main()
