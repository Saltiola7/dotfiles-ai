#!/usr/bin/env python3
import argparse
import contextlib
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import stat
import subprocess
import sys
import tempfile


RUNTIME_SHA256 = "26b1be946c79b13611ab7e5c1d24cb56cbe80576036147f764a282c1f6fedd5e"
STAGED_RUNTIME_SHA256 = "0678888dfb1c78b5129825ca999f3a3c2f547c85262efa8d294c3bb72f1dd325"
REVISION = "43d54acbfa9e731f7a592bb582c1f4b9d48ed73e"
CONFIG = {"extractor": "graphifyy[sql]", "mode": "code-only",
          "normalization": "stable-staged-graph-v1", "version": "0.9.50"}
MAX_CACHE_BYTES = 128 * 1024 * 1024


def canonical(value):
    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=True)


def digest(value):
    return hashlib.sha256(canonical(value).encode()).hexdigest()


def runtime_digest(root):
    rows = []
    python = (root / "bin/python").resolve(strict=True)
    python_root = python.parent.parent
    for prefix, tree in (("venv", root), ("python", python_root)):
        for path in sorted(tree.rglob("*")):
            if "__pycache__" in path.parts or path.suffix == ".pyc":
                continue
            relative = f"{prefix}/{path.relative_to(tree).as_posix()}"
            mode = stat.S_IMODE(path.lstat().st_mode)
            if path.is_symlink():
                resolved = path.resolve(strict=True)
                if tree not in resolved.parents and resolved != python:
                    raise ValueError("Graphify runtime contains an escaping symlink")
                rows.append(f"{relative}\0link\0{mode:o}\0{os.readlink(path)}\n")
            elif path.is_dir():
                rows.append(f"{relative}\0dir\0{mode:o}\n")
            elif path.is_file():
                rows.append(f"{relative}\0file\0{mode:o}\0{hashlib.sha256(path.read_bytes()).hexdigest()}\n")
            else:
                raise ValueError("Graphify runtime contains a special file")
    return hashlib.sha256("".join(rows).encode()).hexdigest()


def safe_output(path_value):
    path = Path(path_value).expanduser()
    if not path.is_absolute() or path.exists() or path.parent.is_symlink():
        raise ValueError("output must be a new absolute path")
    parent = path.parent.resolve(strict=True)
    details = parent.stat()
    if details.st_uid != os.getuid() or stat.S_IMODE(details.st_mode) & 0o022:
        raise ValueError("output directory is unsafe")
    return path


def cache_namespace(root_value, identity):
    fields = {"project", "config_sha256", "runtime_sha256", "corpus_manifest_sha256"}
    if (set(identity) != fields or not re.fullmatch(r"[a-z][a-z0-9_-]{0,62}", identity["project"])
            or any(not re.fullmatch(r"[0-9a-f]{64}", identity[key])
                   for key in fields - {"project"})):
        raise ValueError("Graphify cache identity is invalid")
    root = Path(root_value).expanduser()
    if not root.is_absolute() or root.parent.is_symlink():
        raise ValueError("Graphify cache root is unsafe")
    parent = root.parent.resolve(strict=True)
    details = parent.stat()
    if details.st_uid != os.getuid() or stat.S_IMODE(details.st_mode) & 0o022:
        raise ValueError("Graphify cache parent is unsafe")
    current = root
    for part in (identity["project"], identity["config_sha256"], identity["runtime_sha256"]):
        current.mkdir(mode=0o700, exist_ok=True)
        details = current.lstat()
        if (not stat.S_ISDIR(details.st_mode) or current.is_symlink()
                or details.st_uid != os.getuid() or stat.S_IMODE(details.st_mode) != 0o700):
            raise ValueError("Graphify cache directory is unsafe")
        current /= part
    current.mkdir(mode=0o700, exist_ok=True)
    details = current.lstat()
    if (not stat.S_ISDIR(details.st_mode) or current.is_symlink()
            or details.st_uid != os.getuid() or stat.S_IMODE(details.st_mode) != 0o700):
        raise ValueError("Graphify cache directory is unsafe")
    return current


def cache_entry(namespace, identity):
    return namespace / f"{identity['corpus_manifest_sha256']}.json"


@contextlib.contextmanager
def cache_lock(namespace):
    path = namespace / "cache.lock"
    descriptor = os.open(path, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    try:
        details = os.fstat(descriptor)
        if (not stat.S_ISREG(details.st_mode) or details.st_uid != os.getuid()
                or stat.S_IMODE(details.st_mode) != 0o600):
            raise ValueError("Graphify cache lock is unsafe")
        fcntl.flock(descriptor, fcntl.LOCK_EX)
        yield
    finally:
        os.close(descriptor)


def atomic_write(path, payload):
    descriptor, temporary = tempfile.mkstemp(prefix=f".{path.name}.part.", dir=path.parent)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(payload)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    finally:
        Path(temporary).unlink(missing_ok=True)


def load_cached_extraction(path, identity):
    if not path.exists():
        return None
    try:
        details = path.lstat()
        if (not stat.S_ISREG(details.st_mode) or details.st_uid != os.getuid()
                or stat.S_IMODE(details.st_mode) != 0o600 or details.st_size > MAX_CACHE_BYTES):
            raise ValueError("unsafe cache entry")
        value = json.loads(path.read_bytes(), object_pairs_hook=lambda pairs: dict(pairs)
                           if len(dict(pairs)) == len(pairs) else (_ for _ in ()).throw(
                               ValueError("duplicate cache key")))
        if (not isinstance(value, dict) or set(value) != {"schema_version", "identity",
                                                         "extraction", "extraction_sha256"}
                or value.get("schema_version") != 1 or value.get("identity") != identity
                or not isinstance(value.get("extraction"), dict)
                or value.get("extraction_sha256") != digest(value["extraction"])):
            raise ValueError("invalid cache entry")
        return value["extraction"]
    except (OSError, ValueError, json.JSONDecodeError):
        path.unlink(missing_ok=True)
        return None


def store_cached_extraction(path, identity, extraction):
    value = {"schema_version": 1, "identity": identity, "extraction": extraction,
             "extraction_sha256": digest(extraction)}
    payload = (canonical(value) + "\n").encode()
    if len(payload) > MAX_CACHE_BYTES:
        raise ValueError("Graphify cache entry exceeds byte bound")
    atomic_write(path, payload)


def extract_graph(runtime, files):
    script = """
import contextlib, json, sys
from graphify.detect import detect
from graphify.extract import extract
from pathlib import Path
root, scratch = map(Path, sys.argv[1:3])
allowed = {str(Path(item).resolve()) for item in sys.argv[3:]}
with contextlib.redirect_stdout(sys.stderr):
    found = detect(root)
    files = [Path(item) for item in found.get('files', {}).get('code', [])
             if str(Path(item).resolve()) in allowed]
    value = extract(files, cache_root=scratch)
print(json.dumps(value, sort_keys=True, separators=(',', ':'), ensure_ascii=True))
"""
    python_root = (runtime / "bin/python").resolve(strict=True).parent.parent
    with tempfile.TemporaryDirectory(prefix="dbsctr-graphify-") as scratch:
        scratch = Path(scratch).resolve()
        staged_runtime = scratch / "runtime"
        staged_python = scratch / "python"
        staged_corpus = scratch / "corpus"
        id_prefix = re.sub(r"[^A-Za-z0-9]+", "_", str(staged_corpus)).strip("_").lower() + "_"
        cache = scratch / "cache"
        shutil.copytree(runtime, staged_runtime, symlinks=True)
        shutil.copytree(python_root, staged_python, symlinks=True)
        bin_mode = stat.S_IMODE((runtime / "bin").stat().st_mode)
        (staged_runtime / "bin").chmod(bin_mode | stat.S_IWUSR)
        (staged_runtime / "bin/python").unlink()
        (staged_runtime / "bin/python").symlink_to("../../python/bin/python3.13")
        (staged_runtime / "bin").chmod(bin_mode)
        if runtime_digest(staged_runtime) != STAGED_RUNTIME_SHA256:
            raise ValueError("staged Graphify runtime identity mismatch")
        staged_files = []
        cache.mkdir()
        for relative, payload in files.items():
            path = staged_corpus / relative
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_bytes(payload)
            staged_files.append(str(path))
        if runtime_digest(runtime) != RUNTIME_SHA256:
            raise ValueError("Graphify runtime changed during staging")
        scratch_text = str(scratch)
        profile = """(version 1)
(deny default)
(deny network*)
(import "system.sb")
(allow process*)
(allow signal)
(allow sysctl-read)
(allow mach-lookup)
(allow ipc-posix-sem)
(allow file-read* (subpath %s)
  (subpath "/System") (subpath "/usr/lib") (subpath "/private/etc")
  (literal "/dev/null") (literal "/dev/urandom"))
(allow file-write* (subpath %s))
(deny file-write* (subpath %s) (subpath %s) (subpath %s))
""" % tuple(json.dumps(str(path)) for path in (
            scratch, scratch, staged_runtime, staged_python, staged_corpus))
        completed = subprocess.run(
            [Path("/usr/bin/sandbox-exec"), "-p", profile, str(staged_runtime / "bin/python"),
             "-c", script, ".", str(cache), *staged_files], check=False, text=True,
            capture_output=True, stdin=subprocess.DEVNULL, cwd=staged_corpus,
            env={"PATH": "/usr/bin:/bin", "HOME": scratch_text, "TMPDIR": scratch_text,
                 "PYTHONHOME": str(staged_python), "PYTHONNOUSERSITE": "1"},
        )
        if completed.returncode:
            raise ValueError("Graphify sandbox failed: " + completed.stderr[-1000:])
        extracted = json.loads(completed.stdout)
        if extracted.get("failed_sources"):
            raise ValueError("Graphify extraction failed for corpus sources")
        id_map = {node["id"]: node["id"][len(id_prefix):]
                  if node.get("id", "").startswith(id_prefix) else node["id"]
                  for node in extracted.get("nodes", [])}
        if len(set(id_map.values())) != len(id_map):
            raise ValueError("Graphify stable node identity collision")
        for node in extracted.get("nodes", []):
            node["id"] = id_map[node["id"]]
        for edge in extracted.get("edges", []):
            edge["source"] = id_map.get(edge.get("source"), edge.get("source"))
            edge["target"] = id_map.get(edge.get("target"), edge.get("target"))
        extracted["nodes"] = sorted(extracted.get("nodes", []), key=canonical)
        extracted["edges"] = sorted(extracted.get("edges", []), key=canonical)
        return extracted


def main():
    parser = argparse.ArgumentParser(prog="dbsctr-graphify")
    parser.add_argument("--corpus", required=True)
    parser.add_argument("--output", required=True)
    parser.add_argument("--receipt", required=True)
    args = parser.parse_args()
    corpus = Path(args.corpus).expanduser().resolve(strict=True)
    manifest_path = corpus / "dks-corpus.json"
    manifest_raw = manifest_path.read_bytes()
    manifest = json.loads(manifest_raw)
    if (not manifest_path.is_file() or manifest_path.is_symlink() or not isinstance(manifest, dict)
            or set(manifest) != {"schema_version", "project", "commit", "source_profile_sha256", "documents"}
            or manifest.get("schema_version") != 1 or not manifest.get("documents")
            or any(not isinstance(item, dict) or set(item) != {"path", "blob_id", "content_sha256"}
                   for item in manifest.get("documents", []))):
        raise ValueError("corpus manifest is invalid")
    files = {}
    for item in manifest["documents"]:
        path = (corpus / item["path"]).resolve(strict=True)
        if corpus not in path.parents or not path.is_file() or path.is_symlink():
            raise ValueError("corpus document is unsafe")
        payload = path.read_bytes()
        actual = hashlib.sha256(payload).hexdigest()
        if actual != item["content_sha256"]:
            raise ValueError("corpus document identity mismatch")
        files[item["path"]] = payload
    runtime = Path(os.environ.get(
        "DBSCTR_GRAPHIFY_RUNTIME",
        "~/.config/dotfiles-ai/runtime/graphify-sql-0.9.50-26b1be94")).expanduser()
    if runtime_digest(runtime) != RUNTIME_SHA256:
        raise ValueError("Graphify runtime identity mismatch")
    sandbox = Path("/usr/bin/sandbox-exec")
    if not sandbox.is_file():
        raise ValueError("network sandbox is unavailable")
    config_sha = digest(CONFIG)
    identity = {"project": manifest["project"], "config_sha256": config_sha,
                "runtime_sha256": RUNTIME_SHA256,
                "corpus_manifest_sha256": hashlib.sha256(manifest_raw).hexdigest()}
    namespace = cache_namespace(os.environ.get(
        "DBSCTR_GRAPHIFY_CACHE", "~/.cache/dotfiles-ai-graphify"), identity)
    entry = cache_entry(namespace, identity)
    with cache_lock(namespace):
        extracted = load_cached_extraction(entry, identity)
        cache_hit = extracted is not None
        if extracted is None:
            extracted = extract_graph(runtime, files)
            store_cached_extraction(entry, identity, extracted)
    for relative, payload in files.items():
        if hashlib.sha256((corpus / relative).read_bytes()).hexdigest() != hashlib.sha256(payload).hexdigest():
            raise ValueError("corpus changed during Graphify extraction")
    raw_extraction_sha = hashlib.sha256(canonical(extracted).encode()).hexdigest()
    for item in [*extracted.get("nodes", []), *extracted.get("edges", [])]:
        source = item.get("source_file")
        if isinstance(source, str) and source.startswith("../corpus/"):
            item["source_file"] = source[len("../corpus/"):]
    extracted["nodes"] = sorted(extracted.get("nodes", []), key=canonical)
    extracted["edges"] = sorted(extracted.get("edges", []), key=canonical)
    missing = {node.get("id") for node in extracted.get("nodes", [])
               if node.get("source_file") not in (None, "")
               and node.get("source_location") in (None, "")}
    graph = {"nodes": [node for node in extracted.get("nodes", []) if node.get("id") not in missing],
             "edges": [edge for edge in extracted.get("edges", [])
                       if edge.get("source") not in missing and edge.get("target") not in missing],
             "hyperedges": [], "input_tokens": extracted.get("input_tokens"),
             "output_tokens": extracted.get("output_tokens")}
    graph_raw = (canonical(graph) + "\n").encode()
    output = safe_output(args.output)
    receipt_path = safe_output(args.receipt)
    if output == receipt_path:
        raise ValueError("artifact and receipt paths must differ")
    version = "3.13.2"
    receipt = {"schema_version": 2, "command_contract": "dks-graphify-code-v2",
               "package": "graphifyy[sql]", "extractor_version": "0.9.50",
               "extractor_revision": REVISION, "python_version": version,
               "runtime_sha256": RUNTIME_SHA256,
               "producer_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
               "config_sha256": config_sha,
               "corpus_manifest_sha256": hashlib.sha256(manifest_raw).hexdigest(),
               "artifact_sha256": hashlib.sha256(graph_raw).hexdigest(),
               "raw_extraction_sha256": raw_extraction_sha, "cache_schema_version": 1,
               "cache_key_sha256": digest(identity), "cache_hit": cache_hit,
               "network_disabled": True, "excluded_missing_locations": len(missing),
               "excluded_missing_location_ids_sha256": digest(sorted(missing))}
    receipt_raw = (canonical(receipt) + "\n").encode()
    for path, payload in ((output, graph_raw), (receipt_path, receipt_raw)):
        atomic_write(path, payload)
    print(canonical({"artifact_sha256": receipt["artifact_sha256"],
                     "receipt_sha256": hashlib.sha256(receipt_raw).hexdigest()}))


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, subprocess.SubprocessError, json.JSONDecodeError) as error:
        print(f"dbsctr-graphify: {error}", file=sys.stderr)
        raise SystemExit(1)
