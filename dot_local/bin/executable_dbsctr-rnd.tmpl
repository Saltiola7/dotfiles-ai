def command(argv, *, parse=True, env=None):
    try:
        result = subprocess.run(argv, check=True, text=True, capture_output=True, env=env, timeout=COMMAND_TIMEOUT)
    except subprocess.TimeoutExpired as error:
        raise RuntimeError(f"{argv[0]} timed out") from error
    if not parse:
        return result.stdout
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise RuntimeError(f"{Path(argv[0]).name} returned invalid JSON") from error


def result(value):
    return value.get("result", value)


def safe_id(value):
    allowed = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-"
    return (isinstance(value, str) and 1 <= len(value) <= 128
            and value[0] in allowed[:-3] and all(character in allowed for character in value))


def validate_parallel_state(connection):
    expected_columns = {
        "parallel_lens_state": ("lens_name", "cadence", "no_yield_count", "quarter", "next_eligible_at"),
        "parallel_lens_attempts": ("reservation_id", "lens_name", "worker_id", "capture_day",
                                   "cadence", "no_yield_count", "quarter", "session_id"),
        "parallel_lens_passes": ("worker_id", "lens_name", "capture_day",
                                 "manifest_digest", "outcome", "recorded_at", "cadence",
                                 "no_yield_count", "quarter", "next_eligible_at", "page_count",
                                 "session_count", "review_session_count", "excluded_review_session_count",
                                 "unattributed_session_count", "source_count", "opportunity_id", "session_id"),
        "scheduler_activity": ("singleton", "reserve_count", "last_reserve_at", "last_reserve_status",
                               "last_lens", "release_count", "last_release_at", "last_release_reason"),
    }
    expected_tables = {"scheduler_meta", "scheduler_state", "spawn_reservations", "outcome_events",
                       "lens_state", "lens_attempts", "lens_passes", "parallel_lens_state",
                       "parallel_lens_attempts", "parallel_lens_passes", "scheduler_activity"}
    if {row[0] for row in connection.execute("SELECT name FROM sqlite_master WHERE type='table'")} != expected_tables:
        raise RuntimeError("scheduler schema is malformed")
    nullable = {"parallel_lens_state": set(),
                "parallel_lens_attempts": {"worker_id", "session_id"},
                "parallel_lens_passes": {"opportunity_id", "session_id"},
                "scheduler_activity": {"last_lens"}}
    for table, expected in expected_columns.items():
        columns = connection.execute(f"PRAGMA table_info({table})").fetchall()
        metadata = tuple((row[1], row[2].upper(), row[3], row[5]) for row in columns)
        wanted = tuple((name, "INTEGER" if name in {
            "singleton", "reserve_count", "last_reserve_at", "release_count", "last_release_at",
            "no_yield_count", "recorded_at", "next_eligible_at", "page_count", "session_count",
            "review_session_count", "excluded_review_session_count", "unattributed_session_count", "source_count"
        } else "TEXT", 0 if name in nullable[table]
        or table == "scheduler_activity" and name == "singleton" else 1,
                        1 if name == expected[0] else 0)
                       for name in expected)
        if metadata != wanted:
            raise RuntimeError("parallel lens schema is malformed")
    states = connection.execute(
        "SELECT lens_name,cadence,no_yield_count,quarter,next_eligible_at FROM parallel_lens_state"
    ).fetchall()
    if ({row[0] for row in states} != set(LENSES) or any(
            cadence not in LENS_CADENCE_SECONDS or type(count) is not int or count < 0
            or not isinstance(quarter, str) or type(next_at) is not int or next_at < 0
            for _, cadence, count, quarter, next_at in states)):
        raise RuntimeError("parallel lens state is malformed")
    activity = connection.execute(
        "SELECT reserve_count,last_reserve_at,last_reserve_status,last_lens,release_count,"
        "last_release_at,last_release_reason FROM scheduler_activity WHERE singleton=1"
    ).fetchall()
    if (len(activity) != 1 or any(type(value) is not int or value < 0
                                   for value in (activity[0][0], activity[0][1], activity[0][4], activity[0][5]))
            or not safe_id(activity[0][2]) or activity[0][3] is not None and activity[0][3] not in LENSES
            or not safe_id(activity[0][6])):
        raise RuntimeError("scheduler activity is malformed")
    for reservation, lens_name, worker_id, session_id, day, cadence, count, quarter in connection.execute(
            "SELECT reservation_id,lens_name,worker_id,session_id,capture_day,cadence,no_yield_count,quarter "
            "FROM parallel_lens_attempts"):
        if (not safe_id(reservation) or lens_name not in LENSES
                or worker_id is not None and not safe_id(worker_id)
                or session_id is not None and not safe_id(session_id)
                or not re.fullmatch(r"\d{4}-\d{2}-\d{2}", day)
                or cadence not in LENS_CADENCE_SECONDS or type(count) is not int or count < 0
                or not isinstance(quarter, str)):
            raise RuntimeError("parallel lens attempt is malformed")
    for row in connection.execute(
            "SELECT worker_id,session_id,lens_name,capture_day,manifest_digest,outcome,recorded_at,cadence,"
            "no_yield_count,quarter,next_eligible_at,page_count,session_count,review_session_count,"
            "excluded_review_session_count,unattributed_session_count,source_count FROM parallel_lens_passes"):
        worker_id, session_id, lens_name, day, digest, outcome, recorded_at, cadence, count, quarter, next_at, *metrics = row
        if (not safe_id(worker_id) or session_id is not None and not safe_id(session_id) or lens_name not in LENSES
                or not re.fullmatch(r"\d{4}-\d{2}-\d{2}", day)
                or not re.fullmatch(r"[0-9a-f]{64}", digest) or outcome not in {"yield", "no_yield"}
                or type(recorded_at) is not int or recorded_at < 0
                or cadence not in LENS_CADENCE_SECONDS or type(count) is not int or count < 0
                or not isinstance(quarter, str) or type(next_at) is not int or next_at < 0
                or any(type(value) is not int or value < 0 for value in metrics)
                or metrics[5] < 1 or metrics[0] < metrics[5] or metrics[2] > metrics[1]
                or metrics[4] != 0
                or lens_name == REVIEW_SESSION_LENS and metrics[3] != 0
                or lens_name == REVIEW_SESSION_LENS and metrics[1] != metrics[2]
                or lens_name != REVIEW_SESSION_LENS and metrics[2] != 0):
            raise RuntimeError("parallel lens pass is malformed")


def records(value, key):
    found = result(value).get(key, [])
    if not isinstance(found, list):
        raise RuntimeError(f"invalid {key} response")
    return found


def required_id(value, key):
    found = set()

    def visit(item):
        if isinstance(item, dict):
            if isinstance(item.get(key), str) and item[key]:
                found.add(item[key])
            for child in item.values():
                visit(child)
        elif isinstance(item, list):
            for child in item:
                visit(child)

    visit(result(value))
    if len(found) != 1:
        raise RuntimeError(f"missing or ambiguous {key} in command response")
    return found.pop()


def required_path(value, *keys):
    item = result(value)
    for key in keys:
        item = item.get(key) if isinstance(item, dict) else None
    if not isinstance(item, str) or not item:
        raise RuntimeError(f"missing {'.'.join(keys)} in command response")
    return item


def state_connection():
    if STATE.parent.is_symlink():
        raise RuntimeError("scheduler state directory is unsafe")
    STATE.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(STATE.parent, 0o700)
    parent = STATE.parent.lstat()
    if (stat.S_IFMT(parent.st_mode) != stat.S_IFDIR or parent.st_uid != os.getuid()
            or STATE.is_symlink()):
        raise RuntimeError("scheduler state path is unsafe")
    if STATE.exists():
        details = STATE.lstat()
        if stat.S_IFMT(details.st_mode) != stat.S_IFREG or details.st_uid != os.getuid():
            raise RuntimeError("scheduler state path is unsafe")
    connection = sqlite3.connect(STATE, timeout=5)
    connection.execute("PRAGMA foreign_keys=ON")
    connection.execute("PRAGMA busy_timeout=5000")
    connection.execute("PRAGMA synchronous=FULL")
    connection.execute("PRAGMA journal_mode=DELETE")
    has_meta = connection.execute(
        "SELECT 1 FROM sqlite_master WHERE type='table' AND name='scheduler_meta'"
    ).fetchone()
    existing_version = (connection.execute(
        "SELECT value FROM scheduler_meta WHERE key='schema_version'"
    ).fetchone() if has_meta else None)
    migrating = existing_version in (("3",), ("4",), ("5",), ("6",))
    if migrating:
        connection.execute("BEGIN IMMEDIATE")
    else:
        connection.executescript("""
        CREATE TABLE IF NOT EXISTS scheduler_meta (
            key TEXT PRIMARY KEY,
            value TEXT NOT NULL
        ) WITHOUT ROWID;
        CREATE TABLE IF NOT EXISTS scheduler_state (
            singleton INTEGER PRIMARY KEY CHECK (singleton=1),
            cadence TEXT NOT NULL CHECK (cadence IN ('weekly','twice_weekly','daily')),
            last_evaluation INTEGER NOT NULL,
            cutoff_time INTEGER NOT NULL,
            cutoff_id TEXT NOT NULL,
            halt_reason TEXT,
            halt_reset_at INTEGER NOT NULL,
            next_eligible_at INTEGER NOT NULL
        );
        CREATE TABLE IF NOT EXISTS spawn_reservations (
            reservation_id TEXT PRIMARY KEY,
            created_at INTEGER NOT NULL,
            worker_id TEXT UNIQUE
        ) WITHOUT ROWID;
        CREATE TABLE IF NOT EXISTS outcome_events (
            event_id TEXT PRIMARY KEY,
            attempt_id TEXT NOT NULL,
            kind TEXT NOT NULL CHECK (kind IN ('failed','merged','effect_finalized')),
            classification TEXT,
            reason TEXT NOT NULL,
            recorded_at INTEGER NOT NULL,
            benchmark_id TEXT,
            definition_version TEXT,
            activation_identity TEXT,
            merge_event_id TEXT REFERENCES outcome_events(event_id),
            merge_identity TEXT,
            cost TEXT,
            UNIQUE (attempt_id, definition_version, activation_identity)
        ) WITHOUT ROWID;
        CREATE UNIQUE INDEX IF NOT EXISTS unique_terminal_attempt
            ON outcome_events(attempt_id,kind) WHERE kind!='effect_finalized';
        CREATE TABLE IF NOT EXISTS lens_state (
            singleton INTEGER PRIMARY KEY CHECK (singleton=1),
            cadence TEXT NOT NULL CHECK (cadence IN ('daily','weekly','monthly')),
            no_yield_count INTEGER NOT NULL CHECK (no_yield_count>=0),
            quarter TEXT NOT NULL,
            next_eligible_at INTEGER NOT NULL CHECK (next_eligible_at>=0)
        );
        CREATE TABLE IF NOT EXISTS lens_attempts (
            capture_day TEXT PRIMARY KEY,
            reservation_id TEXT NOT NULL UNIQUE REFERENCES spawn_reservations(reservation_id) ON DELETE CASCADE,
            worker_id TEXT UNIQUE,
            cadence TEXT NOT NULL CHECK (cadence IN ('daily','weekly','monthly')),
            no_yield_count INTEGER NOT NULL CHECK (no_yield_count>=0),
            quarter TEXT NOT NULL
        ) WITHOUT ROWID;
        CREATE TABLE IF NOT EXISTS lens_passes (
            worker_id TEXT PRIMARY KEY,
            capture_day TEXT NOT NULL UNIQUE,
            manifest_digest TEXT NOT NULL,
            outcome TEXT NOT NULL CHECK (outcome IN ('yield','no_yield')),
            lenses_digest TEXT NOT NULL,
            recorded_at INTEGER NOT NULL,
            cadence TEXT NOT NULL CHECK (cadence IN ('daily','weekly','monthly')),
            no_yield_count INTEGER NOT NULL CHECK (no_yield_count>=0),
            quarter TEXT NOT NULL,
            next_eligible_at INTEGER NOT NULL CHECK (next_eligible_at>=0)
        ) WITHOUT ROWID;
        CREATE TABLE IF NOT EXISTS parallel_lens_state (
            lens_name TEXT PRIMARY KEY,
            cadence TEXT NOT NULL CHECK (cadence IN ('daily','weekly','monthly')),
            no_yield_count INTEGER NOT NULL CHECK (no_yield_count>=0),
            quarter TEXT NOT NULL,
            next_eligible_at INTEGER NOT NULL CHECK (next_eligible_at>=0)
        ) WITHOUT ROWID;
        CREATE TABLE IF NOT EXISTS parallel_lens_attempts (
            reservation_id TEXT PRIMARY KEY REFERENCES spawn_reservations(reservation_id) ON DELETE CASCADE,
            lens_name TEXT NOT NULL UNIQUE,
            worker_id TEXT UNIQUE,
            capture_day TEXT NOT NULL,
            cadence TEXT NOT NULL CHECK (cadence IN ('daily','weekly','monthly')),
            no_yield_count INTEGER NOT NULL CHECK (no_yield_count>=0),
            quarter TEXT NOT NULL,
            session_id TEXT
        ) WITHOUT ROWID;
        CREATE TABLE IF NOT EXISTS parallel_lens_passes (
            worker_id TEXT PRIMARY KEY,
            lens_name TEXT NOT NULL,
            capture_day TEXT NOT NULL,
            manifest_digest TEXT NOT NULL,
            outcome TEXT NOT NULL CHECK (outcome IN ('yield','no_yield')),
            recorded_at INTEGER NOT NULL,
            cadence TEXT NOT NULL CHECK (cadence IN ('daily','weekly','monthly')),
            no_yield_count INTEGER NOT NULL CHECK (no_yield_count>=0),
            quarter TEXT NOT NULL,
            next_eligible_at INTEGER NOT NULL CHECK (next_eligible_at>=0),
            page_count INTEGER NOT NULL CHECK (page_count>=0),
            session_count INTEGER NOT NULL CHECK (session_count>=0),
            review_session_count INTEGER NOT NULL CHECK (review_session_count>=0),
            excluded_review_session_count INTEGER NOT NULL CHECK (excluded_review_session_count>=0),
            unattributed_session_count INTEGER NOT NULL CHECK (unattributed_session_count>=0),
            source_count INTEGER NOT NULL CHECK (source_count>=0),
            opportunity_id TEXT,
            session_id TEXT
        ) WITHOUT ROWID;
        CREATE TABLE IF NOT EXISTS scheduler_activity (
            singleton INTEGER PRIMARY KEY CHECK (singleton=1),
            reserve_count INTEGER NOT NULL CHECK (reserve_count>=0),
            last_reserve_at INTEGER NOT NULL CHECK (last_reserve_at>=0),
            last_reserve_status TEXT NOT NULL,
            last_lens TEXT,
            release_count INTEGER NOT NULL CHECK (release_count>=0),
            last_release_at INTEGER NOT NULL CHECK (last_release_at>=0),
            last_release_reason TEXT NOT NULL
        );
        """)
    if migrating:
        connection.execute("""CREATE TABLE IF NOT EXISTS parallel_lens_state (
            lens_name TEXT PRIMARY KEY, cadence TEXT NOT NULL CHECK (cadence IN ('daily','weekly','monthly')),
            no_yield_count INTEGER NOT NULL CHECK (no_yield_count>=0), quarter TEXT NOT NULL,
            next_eligible_at INTEGER NOT NULL CHECK (next_eligible_at>=0)
        ) WITHOUT ROWID""")
        connection.execute("""CREATE TABLE IF NOT EXISTS parallel_lens_attempts (
            reservation_id TEXT PRIMARY KEY REFERENCES spawn_reservations(reservation_id) ON DELETE CASCADE,
            lens_name TEXT NOT NULL UNIQUE, worker_id TEXT UNIQUE, capture_day TEXT NOT NULL,
            cadence TEXT NOT NULL CHECK (cadence IN ('daily','weekly','monthly')),
            no_yield_count INTEGER NOT NULL CHECK (no_yield_count>=0), quarter TEXT NOT NULL,
            session_id TEXT
        ) WITHOUT ROWID""")
        connection.execute("""CREATE TABLE IF NOT EXISTS parallel_lens_passes (
            worker_id TEXT PRIMARY KEY, lens_name TEXT NOT NULL, capture_day TEXT NOT NULL,
            manifest_digest TEXT NOT NULL, outcome TEXT NOT NULL CHECK (outcome IN ('yield','no_yield')),
            recorded_at INTEGER NOT NULL, cadence TEXT NOT NULL CHECK (cadence IN ('daily','weekly','monthly')),
            no_yield_count INTEGER NOT NULL CHECK (no_yield_count>=0), quarter TEXT NOT NULL,
            next_eligible_at INTEGER NOT NULL CHECK (next_eligible_at>=0),
            page_count INTEGER NOT NULL CHECK (page_count>=0), session_count INTEGER NOT NULL CHECK (session_count>=0),
            review_session_count INTEGER NOT NULL CHECK (review_session_count>=0),
            excluded_review_session_count INTEGER NOT NULL CHECK (excluded_review_session_count>=0),
            unattributed_session_count INTEGER NOT NULL CHECK (unattributed_session_count>=0),
            source_count INTEGER NOT NULL CHECK (source_count>=0), opportunity_id TEXT, session_id TEXT
        ) WITHOUT ROWID""")
        connection.execute("""CREATE TABLE IF NOT EXISTS scheduler_activity (
            singleton INTEGER PRIMARY KEY CHECK (singleton=1),
            reserve_count INTEGER NOT NULL CHECK (reserve_count>=0),
            last_reserve_at INTEGER NOT NULL CHECK (last_reserve_at>=0),
            last_reserve_status TEXT NOT NULL,
            last_lens TEXT,
            release_count INTEGER NOT NULL CHECK (release_count>=0),
            last_release_at INTEGER NOT NULL CHECK (last_release_at>=0),
            last_release_reason TEXT NOT NULL
        )""")
    version = existing_version if migrating else connection.execute(
        "SELECT value FROM scheduler_meta WHERE key='schema_version'").fetchone()
    if version is None:
        connection.execute("INSERT INTO scheduler_meta VALUES ('schema_version','7')")
        connection.execute("INSERT INTO scheduler_state VALUES (1,'weekly',0,0,'',NULL,0,0)")
        connection.execute("INSERT INTO lens_state VALUES (1,'daily',0,'',0)")
        version = ("7",)
    elif version == ("1",):
        connection.execute("INSERT OR IGNORE INTO lens_state VALUES (1,'daily',0,'',0)")
        connection.execute("UPDATE scheduler_meta SET value='7' WHERE key='schema_version'")
        version = ("7",)
    elif version == ("3",):
        if connection.execute(
                "SELECT 1 FROM sqlite_master WHERE type='table' AND name='parallel_lens_passes_v3'").fetchone():
            connection.close()
            persist_malformed_halt()
            raise RuntimeError("scheduler state has an incomplete schema migration")
        columns = {row[1] for row in connection.execute("PRAGMA table_info(parallel_lens_passes)")}
        if "unattributed_session_count" not in columns:
            connection.execute("ALTER TABLE parallel_lens_passes RENAME TO parallel_lens_passes_v3")
            connection.execute("""CREATE TABLE parallel_lens_passes (
                worker_id TEXT PRIMARY KEY, lens_name TEXT NOT NULL, capture_day TEXT NOT NULL,
                manifest_digest TEXT NOT NULL, outcome TEXT NOT NULL CHECK (outcome IN ('yield','no_yield')),
                recorded_at INTEGER NOT NULL, cadence TEXT NOT NULL CHECK (cadence IN ('daily','weekly','monthly')),
                no_yield_count INTEGER NOT NULL CHECK (no_yield_count>=0), quarter TEXT NOT NULL,
                next_eligible_at INTEGER NOT NULL CHECK (next_eligible_at>=0),
                page_count INTEGER NOT NULL CHECK (page_count>=0),
                session_count INTEGER NOT NULL CHECK (session_count>=0),
                review_session_count INTEGER NOT NULL CHECK (review_session_count>=0),
                excluded_review_session_count INTEGER NOT NULL CHECK (excluded_review_session_count>=0),
                unattributed_session_count INTEGER NOT NULL CHECK (unattributed_session_count>=0),
                source_count INTEGER NOT NULL CHECK (source_count>=0), opportunity_id TEXT, session_id TEXT
            ) WITHOUT ROWID""")
            connection.execute("""INSERT INTO parallel_lens_passes
                SELECT worker_id,lens_name,capture_day,manifest_digest,outcome,recorded_at,cadence,
                no_yield_count,quarter,next_eligible_at,page_count,session_count,review_session_count,
                excluded_review_session_count,0,source_count,NULL,NULL FROM parallel_lens_passes_v3""")
            connection.execute("DROP TABLE parallel_lens_passes_v3")
        connection.execute("UPDATE scheduler_meta SET value='4' WHERE key='schema_version'")
        version = ("4",)
    if version == ("4",):
        columns = {row[1] for row in connection.execute("PRAGMA table_info(parallel_lens_passes)")}
        if "opportunity_id" not in columns:
            connection.execute("ALTER TABLE parallel_lens_passes ADD COLUMN opportunity_id TEXT")
        connection.execute("UPDATE scheduler_meta SET value='5' WHERE key='schema_version'")
        version = ("5",)
    if version == ("5",):
        columns = {row[1] for row in connection.execute("PRAGMA table_info(parallel_lens_attempts)")}
        if "session_id" not in columns:
            connection.execute("ALTER TABLE parallel_lens_attempts ADD COLUMN session_id TEXT")
        connection.execute(
            "DELETE FROM spawn_reservations WHERE reservation_id IN "
            "(SELECT reservation_id FROM parallel_lens_attempts WHERE session_id IS NULL)"
        )
        connection.execute("UPDATE scheduler_meta SET value='6' WHERE key='schema_version'")
        version = ("6",)
    if version == ("6",):
        columns = {row[1] for row in connection.execute("PRAGMA table_info(parallel_lens_passes)")}
        if "session_id" not in columns:
            connection.execute("ALTER TABLE parallel_lens_passes ADD COLUMN session_id TEXT")
        connection.execute("UPDATE scheduler_meta SET value='7' WHERE key='schema_version'")
        version = ("7",)
    if version != ("7",):
        connection.close()
        persist_malformed_halt()
        raise RuntimeError("scheduler state has an unsupported schema")
    connection.executemany(
        "INSERT OR IGNORE INTO parallel_lens_state VALUES (?,'daily',0,'',0)",
        ((name,) for name in LENSES),
    )
    connection.execute("INSERT OR IGNORE INTO scheduler_activity VALUES (1,0,0,'never',NULL,0,0,'never')")
    os.chmod(STATE, 0o600)
    if connection.execute("PRAGMA integrity_check").fetchone() != ("ok",):
        connection.close()
        persist_malformed_halt()
        raise RuntimeError("scheduler state integrity check failed")
    if connection.execute("PRAGMA foreign_key_check").fetchone() is not None:
        connection.close()
        persist_malformed_halt()
        raise RuntimeError("scheduler state foreign-key check failed")
    row = connection.execute(
        "SELECT cadence,last_evaluation,cutoff_time,cutoff_id,halt_reason,halt_reset_at,next_eligible_at "
        "FROM scheduler_state"
    ).fetchall()
    if (len(row) != 1 or row[0][0] not in CADENCES
            or any(type(item) is not int or item < 0 for item in (*row[0][1:3], *row[0][5:7]))
            or not isinstance(row[0][3], str)
            or row[0][4] is not None and not safe_id(row[0][4])):
        connection.close()
        persist_malformed_halt()
        raise RuntimeError("scheduler state is malformed")
    lens_row = connection.execute(
        "SELECT cadence,no_yield_count,quarter,next_eligible_at FROM lens_state WHERE singleton=1"
    ).fetchall()
    if (len(lens_row) != 1 or lens_row[0][0] not in LENS_CADENCE_SECONDS
            or type(lens_row[0][1]) is not int or lens_row[0][1] < 0
            or not isinstance(lens_row[0][2], str)
            or type(lens_row[0][3]) is not int or lens_row[0][3] < 0):
        connection.close()
        persist_malformed_halt()
        raise RuntimeError("scheduler lens state is malformed")
    for reservation, created_at, worker_id in connection.execute(
            "SELECT reservation_id,created_at,worker_id FROM spawn_reservations"):
        if (not safe_id(reservation) or type(created_at) is not int or created_at < 0
                or worker_id is not None and not safe_id(worker_id)):
            connection.close()
            persist_malformed_halt()
            raise RuntimeError("scheduler state is malformed")
    for day, reservation, worker_id, cadence, count, quarter in connection.execute(
            "SELECT capture_day,reservation_id,worker_id,cadence,no_yield_count,quarter FROM lens_attempts"):
        if (not re.fullmatch(r"\d{4}-\d{2}-\d{2}", day) or not safe_id(reservation)
                or worker_id is not None and not safe_id(worker_id)
                or cadence not in LENS_CADENCE_SECONDS or type(count) is not int or count < 0
                or not isinstance(quarter, str)):
            connection.close()
            persist_malformed_halt()
            raise RuntimeError("scheduler lens attempt is malformed")
    for worker_id, day, digest, outcome, lenses_digest, recorded_at, cadence, count, quarter, next_at in connection.execute(
            "SELECT worker_id,capture_day,manifest_digest,outcome,lenses_digest,recorded_at,"
            "cadence,no_yield_count,quarter,next_eligible_at FROM lens_passes"):
        if (not safe_id(worker_id) or not re.fullmatch(r"\d{4}-\d{2}-\d{2}", day)
                or not re.fullmatch(r"[0-9a-f]{64}", digest)
                or outcome not in {"yield", "no_yield"}
                or not re.fullmatch(r"[0-9a-f]{64}", lenses_digest)
                or type(recorded_at) is not int or recorded_at < 0
                or cadence not in LENS_CADENCE_SECONDS or type(count) is not int or count < 0
                or not isinstance(quarter, str) or type(next_at) is not int or next_at < 0):
            connection.close()
            persist_malformed_halt()
            raise RuntimeError("scheduler lens pass is malformed")
    try:
        validate_parallel_state(connection)
    except RuntimeError:
        connection.close()
        persist_malformed_halt()
        raise
    for event in connection.execute(
            "SELECT event_id,attempt_id,kind,classification,reason,recorded_at,benchmark_id,"
            "definition_version,activation_identity,merge_event_id,merge_identity,cost FROM outcome_events"):
        (identifier, attempt, kind, classification, reason, recorded_at, benchmark_id,
         definition_version, activation_identity, merge_event_id, merge_identity, cost) = event
        try:
            decoded_cost = json.loads(cost)
        except (TypeError, json.JSONDecodeError):
            decoded_cost = None
        if (not safe_id(identifier) or not safe_id(attempt)
                or kind not in {"failed", "merged", "effect_finalized"}
                or classification not in {None, "improved", "neutral", "regressed", "insufficient"}
                or not safe_id(reason) or type(recorded_at) is not int or recorded_at < 0
                or any(value is not None and not safe_id(value) for value in (
                    benchmark_id, definition_version, activation_identity, merge_event_id))
                or merge_identity is not None and (len(merge_identity) not in (40, 64)
                    or any(character not in "0123456789abcdef" for character in merge_identity))
                or decoded_cost != "unavailable" and (not isinstance(decoded_cost, (int, float))
                    or isinstance(decoded_cost, bool) or decoded_cost < 0 or decoded_cost != decoded_cost)
                or identifier != event_id(attempt, kind, definition_version or "", activation_identity or "")
                or kind == "failed" and (classification is not None or reason not in {
                    "blocked", "abandoned", "closed", "reverted"} or any(value is not None for value in (
                        benchmark_id, definition_version, activation_identity, merge_event_id, merge_identity)))
                or kind == "merged" and (classification is not None or reason != "merged"
                    or merge_identity is None or any(value is not None for value in (
                        benchmark_id, definition_version, activation_identity, merge_event_id)))
                or kind == "effect_finalized" and (classification is None or reason != classification
                    or any(value is None for value in (
                        benchmark_id, definition_version, activation_identity, merge_event_id, merge_identity)))):
            connection.close()
            persist_malformed_halt()
            raise RuntimeError("scheduler state is malformed")
    if connection.execute(
            "SELECT 1 FROM outcome_events e LEFT JOIN outcome_events m ON m.event_id=e.merge_event_id "
            "WHERE e.kind='effect_finalized' AND (m.kind!='merged' OR m.attempt_id!=e.attempt_id "
            "OR m.merge_identity!=e.merge_identity) LIMIT 1").fetchone() is not None:
        connection.close()
        persist_malformed_halt()
        raise RuntimeError("scheduler state is malformed")
    connection.commit()
    return connection


def event_id(*values):
    return hashlib.sha256("\0".join(str(value) for value in values).encode()).hexdigest()[:24]


def halt_scheduler(reason):
    connection = state_connection()
    try:
        connection.execute("UPDATE scheduler_state SET halt_reason=? WHERE singleton=1", (reason,))
        connection.commit()
    finally:
        connection.close()


def validated_workers(value):
    workers = value.get("workers") if isinstance(value, dict) else None
    states = NONTERMINAL | TERMINAL
    if (not isinstance(workers, list) or any(not isinstance(worker, dict)
            or not safe_id(worker.get("worker_id")) or worker.get("state") not in states
            for worker in workers)):
        halt_scheduler("malformed_state")
        raise RuntimeError("invalid improvement status response")
    return workers


def append_event(connection, attempt_id, kind, reason, recorded_at, **values):
    if not safe_id(attempt_id) or type(recorded_at) is not int or recorded_at < 0:
        raise RuntimeError("invalid scheduler outcome")
    identifier = event_id(attempt_id, kind, values.get("definition_version", ""),
                          values.get("activation_identity", ""))
    payload = (identifier, attempt_id, kind, values.get("classification"), reason, recorded_at,
               values.get("benchmark_id"), values.get("definition_version"),
               values.get("activation_identity"), values.get("merge_event_id"),
               values.get("merge_identity"), json.dumps(values.get("cost", "unavailable")))
    existing = connection.execute("SELECT * FROM outcome_events WHERE event_id=?", (identifier,)).fetchone()
    if existing is None:
        connection.execute("INSERT INTO outcome_events VALUES (?,?,?,?,?,?,?,?,?,?,?,?)", payload)
    elif kind == "failed":
        return identifier
    elif existing[:5] + existing[6:] != payload[:5] + payload[6:]:
        raise RuntimeError("immutable scheduler outcome conflicts with retained evidence")
    return identifier


def sync_worker_outcomes(connection, workers, now, merge_identities=None):
    merge_identities = merge_identities or {}
    for worker in workers:
        if not isinstance(worker, dict) or not isinstance(worker.get("worker_id"), str):
            raise RuntimeError("invalid improvement worker state")
        attempt, state = worker["worker_id"], worker.get("state")
        if state in {"blocked", "abandoned", "closed"}:
            append_event(connection, attempt, "failed", state, now)
        elif state == "merged" and attempt in merge_identities:
            append_event(connection, attempt, "merged", "merged", now,
                         merge_identity=merge_identities[attempt])
    reset_at = connection.execute("SELECT halt_reset_at FROM scheduler_state WHERE singleton=1").fetchone()[0]
    outcomes = connection.execute(
        "SELECT kind,reason FROM outcome_events WHERE kind IN ('failed','effect_finalized') "
        "AND recorded_at>? ORDER BY recorded_at DESC,event_id DESC LIMIT 3", (reset_at,)).fetchall()
    if len(outcomes) == 3 and all(kind == "failed" and reason in {"blocked", "abandoned", "reverted"}
                                  for kind, reason in outcomes):
        connection.execute("UPDATE scheduler_state SET halt_reason='three_consecutive_failures' WHERE singleton=1")


def reserve_spawn(workers, now):
    connection = state_connection()
    try:
        connection.execute("BEGIN IMMEDIATE")
        connection.execute(
            "DELETE FROM spawn_reservations WHERE worker_id IS NULL AND created_at<=?",
            (now - RESERVATION_LEASE_SECONDS,),
        )
        worker_ids = [worker.get("worker_id") for worker in workers
                      if isinstance(worker, dict) and isinstance(worker.get("worker_id"), str)]
        if len(worker_ids) != len(workers):
            raise RuntimeError("invalid improvement worker state")
        if worker_ids:
            connection.execute(
                f"DELETE FROM spawn_reservations WHERE worker_id IS NOT NULL AND created_at<=? "
                f"AND worker_id NOT IN ({','.join('?' for _ in worker_ids)})",
                (now - RESERVATION_LEASE_SECONDS, *worker_ids))
        else:
            connection.execute(
                "DELETE FROM spawn_reservations WHERE worker_id IS NOT NULL AND created_at<=?",
                (now - RESERVATION_LEASE_SECONDS,))
        terminal_workers = [worker["worker_id"] for worker in workers if worker.get("state") in TERMINAL]
        if terminal_workers:
            connection.execute(
                f"DELETE FROM spawn_reservations WHERE worker_id IN ({','.join('?' for _ in terminal_workers)})",
                terminal_workers)
        sync_worker_outcomes(connection, workers, now)
        evaluate_month(connection, now)
        active_workers = sum(worker.get("state") in NONTERMINAL for worker in workers)
        halt_reason = connection.execute(
            "SELECT halt_reason FROM scheduler_state WHERE singleton=1").fetchone()[0]
        reservations = connection.execute(
            "SELECT COUNT(*) FROM spawn_reservations WHERE worker_id IS NULL").fetchone()[0]
        if halt_reason:
            connection.commit()
            return None, "halted"
        if active_workers + reservations >= 3:
            connection.commit()
            return None, "worker_cap"
        if reservations:
            connection.commit()
            return None, "spawn_in_progress"
        plan = lens_plan(connection, now)
        if not plan["due"]:
            connection.commit()
            return None, "cadence_not_due"
        reservation = f"reservation-{uuid.uuid4().hex}"
        connection.execute("INSERT INTO spawn_reservations VALUES (?,?,NULL)", (reservation, now))
        connection.execute("INSERT INTO lens_attempts VALUES (?,?,NULL,?,?,?)",
                           (plan["capture_day"], reservation, plan["cadence"],
                            plan["no_yield_count"], plan["quarter"]))
        connection.commit()
        return reservation, "reserved"
    finally:
        connection.close()


def observe_reserve(connection, now, status, lens_name=None):
    connection.execute(
        "UPDATE scheduler_activity SET reserve_count=reserve_count+1,last_reserve_at=?,"
        "last_reserve_status=?,last_lens=? WHERE singleton=1",
        (now, status, lens_name),
    )


def reserve_parallel_lens(workers, now):
    connection = state_connection()
    try:
        connection.execute("BEGIN IMMEDIATE")
        connection.execute(
            "DELETE FROM spawn_reservations WHERE worker_id IS NULL AND created_at<=?",
            (now - RESERVATION_LEASE_SECONDS,),
        )
        worker_ids = {worker["worker_id"] for worker in workers}
        for reservation, created_at, worker_id in connection.execute(
                "SELECT reservation_id,created_at,worker_id FROM spawn_reservations "
                "WHERE worker_id IS NOT NULL"):
            if worker_id not in worker_ids and created_at <= now - RESERVATION_LEASE_SECONDS:
                connection.execute("DELETE FROM spawn_reservations WHERE reservation_id=?", (reservation,))
        terminal_workers = [worker["worker_id"] for worker in workers if worker.get("state") in TERMINAL]
        if terminal_workers:
            connection.execute(
                f"DELETE FROM spawn_reservations WHERE worker_id IN ({','.join('?' for _ in terminal_workers)})",
                terminal_workers)
        sync_worker_outcomes(connection, workers, now)
        if connection.execute(
                "SELECT halt_reason FROM scheduler_state WHERE singleton=1").fetchone()[0]:
            observe_reserve(connection, now, "halted")
            connection.commit()
            return None, None, "halted"
        if connection.execute("SELECT 1 FROM lens_attempts LIMIT 1").fetchone() is not None:
            observe_reserve(connection, now, "legacy_attempt_active")
            connection.commit()
            return None, None, "legacy_attempt_active"
        quarter = quarter_at(now)
        active = {row[0] for row in connection.execute("SELECT lens_name FROM parallel_lens_attempts")}
        selected = None
        for lens_name in LENSES:
            cadence, count, recorded_quarter, next_at = connection.execute(
                "SELECT cadence,no_yield_count,quarter,next_eligible_at FROM parallel_lens_state "
                "WHERE lens_name=?", (lens_name,)).fetchone()
            if recorded_quarter != quarter:
                cadence, count, next_at = "daily", 0, now
                connection.execute(
                    "UPDATE parallel_lens_state SET cadence='daily',no_yield_count=0,quarter=?,"
                    "next_eligible_at=? WHERE lens_name=?", (quarter, now, lens_name))
            if lens_name not in active and now >= next_at:
                selected = (lens_name, cadence, count, quarter)
                break
        if selected is None:
            observe_reserve(connection, now, "no_lens_due")
            connection.commit()
            return None, None, "no_lens_due"
        lens_name, cadence, count, quarter = selected
        reservation = f"reservation-{uuid.uuid4().hex}"
        connection.execute("INSERT INTO spawn_reservations VALUES (?,?,NULL)", (reservation, now))
        connection.execute(
            "INSERT INTO parallel_lens_attempts VALUES (?,?,NULL,?,?,?, ?,NULL)",
            (reservation, lens_name, capture_day_at(now), cadence, count, quarter),
        )
        observe_reserve(connection, now, "reserved", lens_name)
        connection.commit()
        return reservation, lens_name, "reserved"
    finally:
        connection.close()


def release_reservation(reservation, reason="operator_release"):
    if reservation is None:
        return
    if reason not in {"operator_release", "prelaunch_failed", "launch_failed"}:
        raise RuntimeError("invalid reservation release reason")
    connection = state_connection()
    try:
        existing = connection.execute(
            "SELECT 1 FROM spawn_reservations WHERE reservation_id=?", (reservation,)
        ).fetchone()
        connection.execute("DELETE FROM spawn_reservations WHERE reservation_id=?", (reservation,))
        if existing is not None:
            connection.execute(
                "UPDATE scheduler_activity SET release_count=release_count+1,last_release_at=?,"
                "last_release_reason=? WHERE singleton=1",
                (int(time.time()), reason),
            )
        connection.commit()
    finally:
        connection.close()


def claim_reservation(reservation, worker_id, claimed_at=None):
    if not safe_id(reservation) or not safe_id(worker_id):
        raise RuntimeError("invalid spawn reservation")
    claimed_at = int(time.time()) if claimed_at is None else claimed_at
    connection = state_connection()
    try:
        connection.execute("BEGIN IMMEDIATE")
        row = connection.execute(
            "SELECT created_at,worker_id FROM spawn_reservations WHERE reservation_id=?",
            (reservation,),
        ).fetchone()
        if row is None or row[1] is not None or row[0] <= claimed_at - RESERVATION_LEASE_SECONDS:
            if row is not None and row[1] is None:
                connection.execute("DELETE FROM spawn_reservations WHERE reservation_id=?", (reservation,))
                connection.commit()
            raise RuntimeError("spawn reservation is missing, claimed, or expired")
        connection.execute(
            "UPDATE spawn_reservations SET worker_id=? WHERE reservation_id=? AND worker_id IS NULL",
            (worker_id, reservation),
        )
        if connection.total_changes != 1:
            raise RuntimeError("spawn reservation claim failed")
        connection.execute("UPDATE lens_attempts SET worker_id=? WHERE reservation_id=?",
                           (worker_id, reservation))
        connection.execute("UPDATE parallel_lens_attempts SET worker_id=? WHERE reservation_id=?",
                           (worker_id, reservation))
        connection.commit()
    except Exception:
        connection.rollback()
        raise
    finally:
        connection.close()


def complete_reservation(reservation, worker_id, completed_at=None, session_id=None):
    connection = state_connection()
    try:
        connection.execute("BEGIN IMMEDIATE")
        row = connection.execute(
            "SELECT worker_id FROM spawn_reservations WHERE reservation_id=?", (reservation,)
        ).fetchone()
        if row is None or row[0] != worker_id:
            raise RuntimeError("spawn reservation is missing or unclaimed")
        parallel = connection.execute(
            "SELECT session_id FROM parallel_lens_attempts WHERE reservation_id=?", (reservation,)
        ).fetchone()
        if parallel is not None:
            if not safe_id(session_id):
                raise RuntimeError("parallel lens attempt requires a worker session")
            if parallel[0] is None:
                updated = connection.execute(
                    "UPDATE parallel_lens_attempts SET session_id=? WHERE reservation_id=? AND session_id IS NULL",
                    (session_id, reservation),
                )
                if updated.rowcount != 1:
                    raise RuntimeError("parallel lens attempt worker incarnation changed")
            elif parallel[0] != session_id:
                raise RuntimeError("parallel lens attempt worker incarnation changed")
        connection.commit()
    except Exception:
        connection.rollback()
        raise
    finally:
        connection.close()


def scheduler_health():
    if STATE.parent.is_symlink() or STATE.is_symlink() or not STATE.exists():
        raise RuntimeError("scheduler state path is unsafe")
    parent, details = STATE.parent.lstat(), STATE.lstat()
    if (stat.S_IFMT(parent.st_mode) != stat.S_IFDIR or parent.st_uid != os.getuid()
            or stat.S_IMODE(parent.st_mode) != 0o700
            or stat.S_IFMT(details.st_mode) != stat.S_IFREG or details.st_uid != os.getuid()
            or stat.S_IMODE(details.st_mode) != 0o600):
        raise RuntimeError("scheduler state path is unsafe")
    connection = sqlite3.connect(f"file:{quote(str(STATE), safe='/')}?mode=ro", uri=True)
    try:
        if connection.execute("PRAGMA integrity_check").fetchone() != ("ok",):
            raise RuntimeError("scheduler state integrity check failed")
        if connection.execute("PRAGMA foreign_key_check").fetchone() is not None:
            raise RuntimeError("scheduler state foreign-key check failed")
        if connection.execute(
                "SELECT value FROM scheduler_meta WHERE key='schema_version'").fetchone() != ("7",):
            raise RuntimeError("scheduler state has an unsupported schema")
        validate_parallel_state(connection)
        activity = connection.execute(
            "SELECT reserve_count,last_reserve_at,last_reserve_status,last_lens,release_count,"
            "last_release_at,last_release_reason FROM scheduler_activity WHERE singleton=1"
        ).fetchone()
        attempts = connection.execute("SELECT COUNT(*) FROM parallel_lens_attempts").fetchone()[0]
        passes = connection.execute("SELECT COUNT(*) FROM parallel_lens_passes").fetchone()[0]
    except sqlite3.Error as error:
        raise RuntimeError("scheduler state integrity check failed") from error
    finally:
        connection.close()
    if (activity is None or any(type(value) is not int or value < 0
                                for value in (activity[0], activity[1], activity[4], activity[5], attempts, passes))
            or not safe_id(activity[2]) or activity[3] is not None and activity[3] not in LENSES
            or not safe_id(activity[6])):
        raise RuntimeError("scheduler activity is malformed")
    return {"schema_version": 1, "reserve_count": activity[0], "last_reserve_at": activity[1],
            "last_reserve_status": activity[2], "last_lens": activity[3],
            "release_count": activity[4], "last_release_at": activity[5],
            "last_release_reason": activity[6], "active_attempt_count": attempts,
            "pass_count": passes}


def quarter_at(now):
    value = time.gmtime(now)
    return f"{value.tm_year}-Q{(value.tm_mon - 1) // 3 + 1}"


def capture_day_at(now):
    return time.strftime("%Y-%m-%d", time.gmtime(now))


def lens_plan(connection, now, worker_id=None):
    if worker_id is not None:
        owned = connection.execute(
            "SELECT capture_day,cadence,no_yield_count,quarter FROM lens_attempts WHERE worker_id=?",
            (worker_id,)).fetchone()
        if owned is not None:
            next_eligible = connection.execute(
                "SELECT next_eligible_at FROM lens_state WHERE singleton=1").fetchone()[0]
            return {"schema_version": 1, "capture_day": owned[0], "quarter": owned[3],
                    "cadence": owned[1], "no_yield_count": owned[2], "due": True,
                    "next_eligible_at": next_eligible,
                    "lenses": [{"name": name, "version": LENS_VERSION} for name in LEGACY_LENSES]}
    quarter = quarter_at(now)
    cadence, count, recorded_quarter, next_eligible = connection.execute(
        "SELECT cadence,no_yield_count,quarter,next_eligible_at FROM lens_state WHERE singleton=1"
    ).fetchone()
    day = capture_day_at(now)
    if connection.execute("SELECT 1 FROM lens_attempts LIMIT 1").fetchone() is not None:
        return {"schema_version": 1, "capture_day": day, "quarter": recorded_quarter,
                "cadence": cadence, "no_yield_count": count, "due": False,
                "next_eligible_at": next_eligible, "lenses": []}
    if recorded_quarter != quarter:
        cadence, count, next_eligible = "daily", 0, now
        connection.execute(
            "UPDATE lens_state SET cadence='daily',no_yield_count=0,quarter=?,next_eligible_at=? "
            "WHERE singleton=1", (quarter, now))
    passed = connection.execute("SELECT 1 FROM lens_passes WHERE capture_day=?", (day,)).fetchone()
    due = now >= next_eligible and passed is None
    return {"schema_version": 1, "capture_day": day, "quarter": quarter,
            "cadence": cadence, "no_yield_count": count, "due": due,
            "next_eligible_at": next_eligible,
             "lenses": ([{"name": name, "version": LENS_VERSION} for name in LEGACY_LENSES] if due else [])}


def lens_plan_action(worker_id=None, now=None):
    connection = state_connection()
    try:
        connection.execute("BEGIN IMMEDIATE")
        owned = connection.execute(
            "SELECT lens_name,capture_day,cadence,no_yield_count,quarter FROM parallel_lens_attempts "
            "WHERE worker_id=?", (worker_id,)).fetchone() if worker_id else None
        if owned is None:
            plan = lens_plan(connection, int(time.time()) if now is None else now, worker_id)
        else:
            lens_name, day, cadence, count, quarter = owned
            next_at = connection.execute(
                "SELECT next_eligible_at FROM parallel_lens_state WHERE lens_name=?",
                (lens_name,)).fetchone()[0]
            plan = {
                "schema_version": 2, "capture_day": day, "quarter": quarter,
                "cadence": cadence, "no_yield_count": count, "due": True,
                "next_eligible_at": next_at,
                "lenses": [{"name": lens_name, "version": LENS_VERSION,
                            "review_sessions": "only" if lens_name == REVIEW_SESSION_LENS else "exclude"}],
            }
        connection.commit()
        print(json.dumps(plan, sort_keys=True, separators=(",", ":")))
    finally:
        connection.close()


def parallel_lens_result(worker_id, capture_day, manifest_digest, outcome, telemetry, now=None):
    now = int(time.time()) if now is None else now
    telemetry_names = {"page_count", "session_count", "review_session_count",
                       "excluded_review_session_count", "unattributed_session_count", "source_count"}
    if (not safe_id(worker_id) or not re.fullmatch(r"\d{4}-\d{2}-\d{2}", capture_day or "")
            or not re.fullmatch(r"[0-9a-f]{64}", manifest_digest or "")
            or outcome not in {"yield", "no_yield"} or set(telemetry) != telemetry_names
            or any(type(telemetry[name]) is not int or telemetry[name] < 0 for name in telemetry_names)):
        raise RuntimeError("invalid parallel lens result")
    if (telemetry["source_count"] < 1 or telemetry["page_count"] < telemetry["source_count"]
            or telemetry["review_session_count"] > telemetry["session_count"]
            or telemetry["unattributed_session_count"] != 0):
        raise RuntimeError("inconsistent parallel lens telemetry")
    workers = validated_workers(command([DBSCTRCTL, "improvement-status", "--worker-id", worker_id]))
    connection = state_connection()
    try:
        existing = connection.execute(
            "SELECT session_id,lens_name,capture_day,manifest_digest,outcome,cadence,no_yield_count,quarter,"
            "next_eligible_at,page_count,session_count,review_session_count,"
            "excluded_review_session_count,unattributed_session_count,source_count "
            "FROM parallel_lens_passes WHERE worker_id=?",
            (worker_id,)).fetchone()
        if existing is not None:
            if (len(workers) != 1 or workers[0].get("worker_id") != worker_id
                    or workers[0].get("session_id") != existing[0]):
                raise RuntimeError("parallel lens result worker incarnation changed")
            supplied = (existing[0], existing[1], capture_day, manifest_digest, outcome, *existing[5:9],
                        telemetry["page_count"], telemetry["session_count"],
                        telemetry["review_session_count"], telemetry["excluded_review_session_count"],
                        telemetry["unattributed_session_count"],
                        telemetry["source_count"])
            if supplied != existing:
                raise RuntimeError("parallel lens result conflicts with immutable pass")
            return {"schema_version": 2, "worker_id": worker_id, "lens": existing[1],
                    "capture_day": capture_day, "manifest_digest": manifest_digest,
                    "outcome": outcome, "cadence": existing[5], "no_yield_count": existing[6],
                    "quarter": existing[7], "next_eligible_at": existing[8], "telemetry": telemetry}
    finally:
        connection.close()
    required_state = "claimed" if outcome == "yield" else "reviewing"
    if (len(workers) != 1 or workers[0].get("worker_id") != worker_id
            or workers[0].get("state") != required_state):
        raise RuntimeError("parallel lens result worker is not in the required state")
    opportunity_id = workers[0].get("opportunity_id") if outcome == "yield" else None
    session_id = workers[0].get("session_id")
    if not safe_id(session_id):
        raise RuntimeError("parallel lens result worker session is unavailable")
    if outcome == "yield" and not re.fullmatch(r"[0-9a-f]{64}", opportunity_id or ""):
        raise RuntimeError("parallel lens yield is missing its claimed opportunity")
    connection = state_connection()
    try:
        connection.execute("BEGIN IMMEDIATE")
        attempt = connection.execute(
            "SELECT reservation_id,lens_name,session_id,cadence,no_yield_count,quarter FROM parallel_lens_attempts "
            "WHERE capture_day=? AND worker_id=?", (capture_day, worker_id)).fetchone()
        if attempt is None:
            raise RuntimeError("parallel lens result has no due pass")
        reservation, lens_name, attempt_session_id, cadence, count, recorded_quarter = attempt
        if attempt_session_id != session_id:
            raise RuntimeError("parallel lens result worker incarnation changed")
        scope = "only" if lens_name == REVIEW_SESSION_LENS else "exclude"
        receipt_path = RECEIPTS / f"{manifest_digest}.{scope}.json"
        if RECEIPTS.is_symlink() or not RECEIPTS.is_dir() or receipt_path.is_symlink():
            raise RuntimeError("parallel lens telemetry receipt path is unsafe")
        details = receipt_path.lstat()
        if (stat.S_IFMT(details.st_mode) != stat.S_IFREG or details.st_uid != os.getuid()
                or stat.S_IMODE(details.st_mode) != 0o600):
            raise RuntimeError("parallel lens telemetry receipt is unsafe")
        receipt = json.loads(receipt_path.read_text(encoding="utf-8"))
        if (receipt != {"schema_version": 1, "manifest_digest": manifest_digest,
                        "scope": scope, "telemetry": telemetry}):
            raise RuntimeError("parallel lens telemetry does not match its capture receipt")
        if lens_name == REVIEW_SESSION_LENS:
            if (telemetry["excluded_review_session_count"]
                    or telemetry["session_count"] != telemetry["review_session_count"]):
                raise RuntimeError("review-session lens cannot exclude review sessions")
        elif telemetry["review_session_count"]:
            raise RuntimeError("ordinary lens cannot review review sessions")
        quarter = quarter_at(now)
        if outcome == "yield" or recorded_quarter != quarter:
            cadence, count = "daily", 0
            next_at = now
        else:
            count += 1
            threshold = {"daily": 3, "weekly": 4}.get(cadence)
            if threshold and count >= threshold:
                cadence = "weekly" if cadence == "daily" else "monthly"
                count = 0
            next_at = now + LENS_CADENCE_SECONDS[cadence]
        connection.execute(
            "INSERT INTO parallel_lens_passes VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)",
            (worker_id, lens_name, capture_day, manifest_digest, outcome, now, cadence, count,
              quarter, next_at, telemetry["page_count"], telemetry["session_count"],
              telemetry["review_session_count"], telemetry["excluded_review_session_count"],
               telemetry["unattributed_session_count"],
              telemetry["source_count"], opportunity_id, session_id),
        )
        connection.execute("DELETE FROM spawn_reservations WHERE reservation_id=?", (reservation,))
        connection.execute(
            "UPDATE parallel_lens_state SET cadence=?,no_yield_count=?,quarter=?,next_eligible_at=? "
            "WHERE lens_name=?", (cadence, count, quarter, next_at, lens_name))
        connection.commit()
        receipt_path.unlink()
        return {"schema_version": 2, "worker_id": worker_id, "lens": lens_name,
                "capture_day": capture_day, "manifest_digest": manifest_digest,
                "outcome": outcome, "cadence": cadence, "no_yield_count": count,
                "quarter": quarter, "next_eligible_at": next_at, "telemetry": telemetry}
    except Exception:
        connection.rollback()
        raise
    finally:
        connection.close()


def lens_result(worker_id, capture_day, manifest_digest, outcome, now=None):
    connection = state_connection()
    try:
        parallel = connection.execute(
            "SELECT 1 FROM parallel_lens_attempts WHERE worker_id=?", (worker_id,)).fetchone()
    finally:
        connection.close()
    if parallel:
        raise RuntimeError("parallel lens result requires telemetry")
    now = int(time.time()) if now is None else now
    if (not safe_id(worker_id) or not re.fullmatch(r"\d{4}-\d{2}-\d{2}", capture_day or "")
            or not re.fullmatch(r"[0-9a-f]{64}", manifest_digest or "")
            or outcome not in {"yield", "no_yield"}):
        raise RuntimeError("invalid lens result")
    lenses_digest = hashlib.sha256(json.dumps(
        [{"name": name, "version": LENS_VERSION} for name in LEGACY_LENSES],
        sort_keys=True, separators=(",", ":")).encode()).hexdigest()

    def replay(existing):
        if existing is None:
            return None
        if existing[:4] != (capture_day, manifest_digest, outcome, lenses_digest):
            raise RuntimeError("lens result conflicts with immutable pass")
        return {"schema_version": 1, "worker_id": worker_id, "capture_day": capture_day,
                "manifest_digest": manifest_digest, "outcome": outcome, "cadence": existing[4],
                "no_yield_count": existing[5], "quarter": existing[6],
                "next_eligible_at": existing[7]}

    connection = state_connection()
    try:
        existing = connection.execute(
            "SELECT capture_day,manifest_digest,outcome,lenses_digest,cadence,no_yield_count,quarter,"
            "next_eligible_at FROM lens_passes WHERE worker_id=?", (worker_id,)).fetchone()
        restored = replay(existing)
        if restored is not None:
            return restored
    finally:
        connection.close()
    workers = validated_workers(command([DBSCTRCTL, "improvement-status", "--worker-id", worker_id]))
    required_state = "claimed" if outcome == "yield" else "reviewing"
    if (len(workers) != 1 or workers[0].get("worker_id") != worker_id
            or workers[0].get("state") != required_state):
        raise RuntimeError("lens result worker is not in the required state")
    connection = state_connection()
    try:
        connection.execute("BEGIN IMMEDIATE")
        attempt = connection.execute(
            "SELECT reservation_id,cadence,no_yield_count,quarter FROM lens_attempts "
            "WHERE capture_day=? AND worker_id=?", (capture_day, worker_id)).fetchone()
        if attempt is None:
            raise RuntimeError("lens result has no due pass")
        cadence, count, recorded_quarter = attempt[1:]
        quarter = quarter_at(now)
        if outcome == "yield" or recorded_quarter != quarter:
            cadence, count = "daily", 0
        else:
            count += 1
            threshold = {"daily": 3, "weekly": 4}.get(cadence)
            if threshold and count >= threshold:
                cadence = "weekly" if cadence == "daily" else "monthly"
                count = 0
        next_at = now + LENS_CADENCE_SECONDS[cadence]
        connection.execute("INSERT INTO lens_passes VALUES (?,?,?,?,?,?,?,?,?,?)",
                           (worker_id, capture_day, manifest_digest, outcome, lenses_digest,
                            now, cadence, count, quarter, next_at))
        connection.execute("DELETE FROM spawn_reservations WHERE reservation_id=?", (attempt[0],))
        connection.execute(
            "UPDATE lens_state SET cadence=?,no_yield_count=?,quarter=?,next_eligible_at=? "
            "WHERE singleton=1", (cadence, count, quarter, next_at))
        connection.commit()
        return {"schema_version": 1, "worker_id": worker_id, "capture_day": capture_day,
                "manifest_digest": manifest_digest, "outcome": outcome, "cadence": cadence,
                "no_yield_count": count, "quarter": quarter, "next_eligible_at": next_at}
    except Exception:
        connection.rollback()
        raise
    finally:
        connection.close()


def finalize_effect(connection, request, benchmark, now):
    if (not isinstance(request, dict) or set(request) != {"attempt_id", "benchmark_id"}
            or not all(safe_id(request[name]) for name in request)):
        raise RuntimeError("invalid effect finalization request")
    if benchmark.get("benchmark_id") != request["benchmark_id"]:
        raise RuntimeError("benchmark identity mismatch")
    inputs, definition, outcome = (benchmark.get(name) for name in ("inputs", "definition", "result"))
    if not all(isinstance(value, dict) for value in (inputs, definition, outcome)):
        raise RuntimeError("invalid benchmark response")
    activation = inputs.get("activation_identity")
    activated_at = inputs.get("activated_at")
    if (inputs.get("activation_status") != "verified" or not safe_id(activation)
            or type(activated_at) is not int or type(benchmark.get("evaluated_at")) is not int
            or benchmark["evaluated_at"] < activated_at + 30 * 86400 * 1000):
        raise RuntimeError("benchmark activation window is incomplete")
    classification = outcome.get("classification")
    if (classification not in {"improved", "neutral", "regressed", "insufficient"}
            or not safe_id(definition.get("version"))):
        raise RuntimeError("invalid benchmark classification")
    merge = connection.execute(
        "SELECT event_id,merge_identity FROM outcome_events WHERE attempt_id=? AND kind='merged'",
        (request["attempt_id"],)).fetchone()
    if merge is None or merge[1] != inputs.get("merge_identity"):
        raise RuntimeError("benchmark does not reference the retained merge event")
    metric = definition.get("metric")
    cost = outcome.get("observation_value") if metric == "cost_total" else "unavailable"
    if (cost != "unavailable" and (not isinstance(cost, (int, float))
            or isinstance(cost, bool) or cost < 0 or cost != cost)):
        raise RuntimeError("invalid benchmark cost")
    return append_event(
        connection, request["attempt_id"], "effect_finalized", classification, now,
        classification=classification, benchmark_id=request["benchmark_id"],
        definition_version=definition.get("version"), activation_identity=activation,
        merge_event_id=merge[0], merge_identity=merge[1], cost=cost,
    )


def evaluate_month(connection, now):
    cadence, last_evaluation, cutoff_time, cutoff_id = connection.execute(
        "SELECT cadence,last_evaluation,cutoff_time,cutoff_id FROM scheduler_state WHERE singleton=1").fetchone()
    events = connection.execute(
        "SELECT event_id,attempt_id,kind,classification,reason,cost FROM outcome_events "
        "WHERE (recorded_at>? OR (recorded_at=? AND event_id>?)) AND recorded_at<=? "
        "ORDER BY recorded_at,event_id", (cutoff_time, cutoff_time, cutoff_id, now)).fetchall()
    counts = {name: 0 for name in (
        "improved", "neutral", "regressed", "failed", "insufficient", "pending", "active")}
    costs = []
    finalized_attempts = {attempt for _, attempt, kind, *_ in events if kind == "effect_finalized"}
    for _, attempt, kind, classification, _, encoded_cost in events:
        if kind == "failed":
            counts["failed"] += 1
        elif kind == "merged" and attempt not in finalized_attempts:
            counts["pending"] += 1
        elif classification in counts:
            counts[classification] += 1
        cost = json.loads(encoded_cost)
        if isinstance(cost, (int, float)) and not isinstance(cost, bool) and cost >= 0:
            costs.append(cost)
    changed = False
    if last_evaluation == 0 or now - last_evaluation >= MONTH_SECONDS:
        denominator = sum(counts[name] for name in ("improved", "neutral", "regressed", "failed"))
        target = cadence
        if denominator and (counts["regressed"] or counts["failed"] / denominator >= 0.5):
            target = CADENCES[max(0, CADENCES.index(cadence) - 1)]
        elif (counts["improved"] >= 2 and not counts["regressed"]
              and denominator and counts["failed"] / denominator <= 0.2):
            target = CADENCES[min(len(CADENCES) - 1, CADENCES.index(cadence) + 1)]
        changed = target != cadence
        cadence = target
        connection.execute(
            "UPDATE scheduler_state SET cadence=?,last_evaluation=?,cutoff_time=?,cutoff_id='~',"
            "next_eligible_at=CASE WHEN ? THEN ? ELSE next_eligible_at END WHERE singleton=1",
            (cadence, now, now, changed, now + CADENCE_SECONDS[cadence]))
    return cadence, changed, counts, sum(costs) if costs else "unavailable"


def analytics(now, json_output=False, finalize_request=None, failure_request=None):
    if type(now) is not int or now < 0:
        raise RuntimeError("invalid analytics cutoff")
    workers = validated_workers(command([DBSCTRCTL, "improvement-status"]))
    if (finalize_request is not None and (not isinstance(finalize_request, dict)
            or set(finalize_request) != {"attempt_id", "benchmark_id"}
            or not all(safe_id(value) for value in finalize_request.values()))):
        raise RuntimeError("invalid effect finalization request")
    if (failure_request is not None and (not isinstance(failure_request, dict)
            or set(failure_request) != {"attempt_id", "reason"}
            or not safe_id(failure_request.get("attempt_id"))
            or failure_request.get("reason") not in {"blocked", "abandoned", "closed", "reverted"})):
        raise RuntimeError("invalid failure outcome request")
    if failure_request is not None:
        matching = [worker for worker in workers if worker.get("worker_id") == failure_request["attempt_id"]]
        expected_state = "merged" if failure_request["reason"] == "reverted" else failure_request["reason"]
        if len(matching) != 1 or matching[0].get("state") != expected_state:
            raise RuntimeError("failure outcome does not match authoritative worker state")
    benchmark = (command([DBSCTRCTL, "benchmark", "--benchmark-id", finalize_request["benchmark_id"]])
                 if finalize_request is not None else None)
    connection = state_connection()
    try:
        connection.execute("BEGIN IMMEDIATE")
        sync_worker_outcomes(connection, workers, now)
        if failure_request is not None:
            append_event(connection, failure_request["attempt_id"], "failed",
                         failure_request["reason"], now)
        finalized = (finalize_effect(connection, finalize_request, benchmark, now)
                     if finalize_request is not None else None)
        cadence, changed, counts, cost = evaluate_month(connection, now)
        finalized_attempts = {row[0] for row in connection.execute(
            "SELECT DISTINCT attempt_id FROM outcome_events WHERE kind='effect_finalized'")}
        failed_attempts = {row[0] for row in connection.execute(
            "SELECT DISTINCT attempt_id FROM outcome_events WHERE kind='failed'")}
        pending_attempts = ({worker["worker_id"] for worker in workers if worker.get("state") == "merged"}
                            | {row[0] for row in connection.execute(
                                "SELECT DISTINCT attempt_id FROM outcome_events WHERE kind='merged'")})
        counts["pending"] = len(pending_attempts - finalized_attempts - failed_attempts)
        counts["active"] = sum(worker.get("state") in NONTERMINAL - {"blocked"} for worker in workers)
        halt_reason, next_eligible = connection.execute(
            "SELECT halt_reason,next_eligible_at FROM scheduler_state WHERE singleton=1").fetchone()
        connection.commit()
    except Exception:
        connection.rollback()
        raise
    finally:
        connection.close()
    report = {"cadence": cadence, "changed": changed, "halt_reason": halt_reason,
              "next_eligible_at": next_eligible, "counts": counts, "cost_total": cost,
              "finalized_event_id": finalized}
    if json_output:
        print(json.dumps(report, sort_keys=True, separators=(",", ":")))
    else:
        print(f"cadence={cadence} changed={str(changed).lower()} halt={halt_reason or 'none'} ")
        print(" ".join(f"{name}={counts[name]}" for name in counts) + f" cost={cost}")


def reset_schedule():
    connection = state_connection()
    try:
        connection.execute("BEGIN IMMEDIATE")
        connection.execute("UPDATE scheduler_state SET halt_reason=NULL,halt_reset_at=?,next_eligible_at=0 "
                           "WHERE singleton=1", (int(time.time()),))
        connection.execute("DELETE FROM spawn_reservations")
        connection.commit()
    finally:
        connection.close()
    print('{"status":"reset"}')


def backlog_cells(line):
    line = line.strip()
    if not line.startswith("|") or not line.endswith("|"):
        return None
    return tuple(cell.strip().replace("\\|", "|")
                 for cell in re.split(r"(?<!\\)\|", line[1:-1]))


def canonical_backlogs(repository_filter=None):
    repositories = []
    for configured in BACKLOG_ROOTS:
        if configured.is_symlink() or not configured.is_dir():
            raise RuntimeError("configured backlog root is unavailable or unsafe")
        root = configured.resolve()
        candidates = [root] if (root / ".git").exists() else sorted(root.iterdir())
        if len(candidates) > 128:
            raise RuntimeError("backlog repository limit exceeded")
        for candidate in candidates:
            if candidate.is_symlink() or not candidate.is_dir() or not (candidate / ".git").exists():
                continue
            repository = candidate.resolve()
            if repository != root and repository.parent != root:
                raise RuntimeError("backlog repository escapes configured root")
            common = command(["git", "-C", str(repository), "rev-parse", "--path-format=absolute",
                              "--git-common-dir"], parse=False).strip()
            repositories.append((hashlib.sha256(common.encode()).hexdigest()[:16], repository))
    if len(repositories) > 128:
        raise RuntimeError("backlog repository limit exceeded")
    entries, input_bytes = [], 0
    for repository_id, repository in sorted(set(repositories)):
        specs = repository / "docs/specs"
        if not specs.is_dir() or specs.is_symlink():
            continue
        contexts = sorted(specs.iterdir())
        if len(contexts) > 128:
            raise RuntimeError("backlog context limit exceeded")
        for context in contexts:
            backlog = context / "BACKLOG.md"
            if context.is_symlink() or backlog.is_symlink():
                raise RuntimeError("backlog symlink is unsafe")
            if (not backlog.is_file() or backlog.resolve().parent != context.resolve()
                    or context.resolve().parent != specs.resolve()):
                continue
            flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
            descriptor = os.open(backlog, flags)
            try:
                details = os.fstat(descriptor)
                if not stat.S_ISREG(details.st_mode) or details.st_size > 256 * 1024:
                    raise RuntimeError("backlog file is oversized or unsafe")
                input_bytes += details.st_size
                if input_bytes > 1024 * 1024:
                    raise RuntimeError("backlog input limit exceeded")
                with os.fdopen(descriptor, encoding="utf-8") as stream:
                    descriptor = -1
                    lines = stream.read().splitlines()
            finally:
                if descriptor >= 0:
                    os.close(descriptor)
            try:
                active = lines.index("## Active")
            except ValueError as error:
                raise RuntimeError("canonical backlog Active section is missing") from error
            header = next((index for index in range(active + 1, len(lines)) if lines[index].strip()), None)
            if header is None or backlog_cells(lines[header]) != BACKLOG_COLUMNS:
                raise RuntimeError("canonical backlog Active header is invalid")
            separator = backlog_cells(lines[header + 1]) if header + 1 < len(lines) else None
            if (separator is None or len(separator) != len(BACKLOG_COLUMNS)
                    or any(not re.fullmatch(r":?-{3,}:?", cell) for cell in separator)):
                raise RuntimeError("canonical backlog Active separator is invalid")
            index = header + 2
            seen_ids = set()
            while index < len(lines) and lines[index].strip() and not lines[index].startswith("## "):
                cells = backlog_cells(lines[index])
                if cells is None or len(cells) != len(BACKLOG_COLUMNS) or not cells[0]:
                    raise RuntimeError("canonical backlog row is invalid")
                values = dict(zip(BACKLOG_COLUMNS, cells))
                if values["status"] not in BACKLOG_STATUSES:
                    raise RuntimeError("canonical backlog status is invalid")
                if values["id"] in seen_ids:
                    raise RuntimeError("canonical backlog ID is duplicated")
                seen_ids.add(values["id"])
                identity = hashlib.sha256(
                    f"{repository_id}\0{context.name}\0{values['id']}".encode()).hexdigest()
                entries.append({"context": context.name, "idempotency_key": identity,
                                "repository_id": repository_id,
                                "repository": str(repository), **values})
                index += 1
    if repository_filter is not None:
        entries = [item for item in entries if item["repository_id"] == repository_filter]
    payload = {"backlogs": entries, "schema_version": 1}
    if len(json.dumps(payload).encode()) > 256 * 1024:
        raise RuntimeError("backlog output is oversized")
    return payload


def backlog_repositories():
    items = canonical_backlogs()["backlogs"]
    repositories = {}
    for item in items:
        repositories[item["repository_id"]] = item["repository"]
    return {"project_profiles": PROJECT_PROFILES, "repositories": [
        {"profile": f"project-{hashlib.sha256(HERMES_PROFILE.encode()).hexdigest()[:8]}-{identifier}",
         "repository": repositories[identifier], "repository_id": identifier}
        for identifier in sorted(repositories)
    ], "schema_version": 1}


def reserve_action():
    workers = validated_workers(command([DBSCTRCTL, "improvement-status"]))
    reservation, lens_name, reason = reserve_parallel_lens(workers, int(time.time()))
    if reservation is None:
        print(json.dumps({"status": "no_op", "reason": reason}, separators=(",", ":")))
        return
    print(json.dumps({"status": "reserved", "reservation": reservation,
                      "worker_id": f"dbsctr-{uuid.uuid4().hex[:8]}", "lens": lens_name},
                     separators=(",", ":")))


def complete_action(reservation, worker_id):
    workers = validated_workers(command([DBSCTRCTL, "improvement-status", "--worker-id", worker_id]))
    if len(workers) != 1 or workers[0].get("worker_id") != worker_id:
        raise RuntimeError("registered worker identity is missing")
    complete_reservation(reservation, worker_id, session_id=workers[0].get("session_id"))
    print(json.dumps({"status": "completed", "worker_id": worker_id}, separators=(",", ":")))


def release_action(reservation, reason):
    release_reservation(reservation, reason)
    print('{"status":"released"}')


def launch_action(reservation, worker_id, repository_id):
    if not all(safe_id(value) for value in (reservation, worker_id, repository_id)):
        raise RuntimeError("invalid direct launch identity")
    matches = {item["repository"] for item in canonical_backlogs()["backlogs"]
               if item["repository_id"] == repository_id}
    if len(matches) != 1:
        raise RuntimeError("direct launch repository is missing or ambiguous")
    repository = Path(matches.pop()).resolve()
    claim_reservation(reservation, worker_id)
    process = None
    registered = False
    try:
        before = session_ids(repository)
        log_dir = STATE.parent / "launches"
        log_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
        os.chmod(log_dir, 0o700)
        log_path = log_dir / f"{worker_id}.log"
        with log_path.open("a", encoding="utf-8") as output:
            os.chmod(log_path, 0o600)
            child_env = {key: value for key, value in os.environ.items()
                         if not key.startswith("OPENCODE")}
            process = subprocess.Popen(
                [OPENCODE, "run", "--agent", "build", "--command", "dbsctr-improve",
                  "--format", "json"], cwd=repository, stdout=output, stderr=subprocess.STDOUT,
                env={**child_env, "PATH": MANAGED_PATH, "DBSCTR_RND_WORKER_ID": worker_id},
                start_new_session=True,
            )
            session_id = None
            for _ in range(SESSION_POLLS):
                created = session_ids(repository) - before
                if len(created) > 1:
                    raise RuntimeError("direct launch created ambiguous OpenCode sessions")
                if len(created) == 1:
                    candidate = next(iter(created))
                    if candidate in log_path.read_text(encoding="utf-8"):
                        session_id = candidate
                        break
                if process.poll() is not None:
                    break
                time.sleep(0.5)
            if session_id is None:
                raise RuntimeError("direct launch session identity did not become available")
            complete_reservation(reservation, worker_id, session_id=session_id)
            worker = command([DBSCTRCTL, "improvement-register", "--worker-id", worker_id,
                              "--session-id", session_id])
            if (not isinstance(worker, dict) or worker.get("worker_id") != worker_id
                    or worker.get("session_id") != session_id):
                raise RuntimeError("direct launch registration identity mismatch")
            registered = True
            print(json.dumps({"session_id": session_id, "status": "started",
                              "worker_id": worker_id}, separators=(",", ":")))
    except Exception as launch_error:
        cleanup_errors = []
        if process is not None:
            try:
                os.killpg(process.pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
            except OSError as error:
                cleanup_errors.append(error)
            try:
                process.wait(timeout=5)
            except subprocess.TimeoutExpired:
                pass
            except OSError as error:
                cleanup_errors.append(error)
            try:
                os.killpg(process.pid, 0)
            except ProcessLookupError:
                group_alive = False
            except OSError as error:
                cleanup_errors.append(error)
                group_alive = False
            else:
                group_alive = True
            if group_alive:
                try:
                    os.killpg(process.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                except OSError as error:
                    cleanup_errors.append(error)
            try:
                process.wait(timeout=5)
            except (OSError, subprocess.TimeoutExpired) as error:
                cleanup_errors.append(error)
        try:
            release_reservation(reservation, "launch_failed")
        except Exception as error:
            cleanup_errors.append(error)
        if registered:
            try:
                subprocess.run([DBSCTRCTL, "improvement-update", "--worker-id", worker_id,
                                "--state", "blocked"], check=False, timeout=5)
            except (OSError, subprocess.TimeoutExpired) as error:
                cleanup_errors.append(error)
        if cleanup_errors:
            raise ExceptionGroup("direct launch and cleanup failed", [launch_error, *cleanup_errors])
        raise launch_error


def panes(workspace_id):
    return records(command([HERDR, "pane", "list", "--workspace", workspace_id]), "panes")


def close_unchanged_staging(workspace_id, tab_id, shell_pane_id):
    current = [pane.get("pane_id") for pane in panes(workspace_id) if pane.get("tab_id") == tab_id]
    if current == [shell_pane_id]:
        command([HERDR, "tab", "close", tab_id], parse=False)


def workspace():
    matches = [item for item in records(command([HERDR, "workspace", "list"]), "workspaces")
               if item.get("label") == WORKSPACE_LABEL]
    if len(matches) > 1:
        raise RuntimeError(f"multiple Herdr workspaces named {WORKSPACE_LABEL!r}")
    if matches:
        return required_id(matches[0], "workspace_id")
    created = command([
        HERDR, "workspace", "create", "--cwd", str(REVIEW_WORKDIR),
        "--label", WORKSPACE_LABEL, "--no-focus",
    ])
    return required_id(created, "workspace_id")


def session_ids(workdir=REVIEW_WORKDIR):
    output = command([OPENCODE, "session", "list", "--pure", "--format", "json", "-n", "100"], parse=False)
    try:
        value = json.loads(output) if output.strip() else []
    except json.JSONDecodeError as error:
        raise RuntimeError("opencode returned invalid JSON") from error
    if not isinstance(value, list):
        raise RuntimeError("invalid OpenCode session list")
    return {item["id"] for item in value
            if isinstance(item, dict) and item.get("directory") == str(workdir)
            and isinstance(item.get("id"), str)}


def pane_runs(pane_id, expected_argv):
    info = result(command([HERDR, "pane", "process-info", "--pane", pane_id]))
    processes = info.get("process_info", {}).get("foreground_processes", [])
    return len(processes) == 1 and processes[0].get("argv") == expected_argv


def wait_for_session(pane_id, expected=None, before=None, expected_argv=None):
    for _ in range(SESSION_POLLS):
        matches = [agent for agent in records(command([HERDR, "agent", "list"]), "agents")
                   if agent.get("pane_id") == pane_id]
        if len(matches) == 1:
            session = matches[0].get("agent_session", {}).get("value")
            if isinstance(session, str) and session and (expected is None or session == expected):
                return session
        if expected_argv and pane_runs(pane_id, expected_argv):
            current = session_ids()
            if expected and expected in current:
                return expected
            created = current - (before or set())
            if expected is None and len(created) == 1:
                return created.pop()
        time.sleep(0.5)
    raise RuntimeError("OpenCode session identity did not become available")


def launch(workspace_id, worker_id, session_id=None):
    before = session_ids() if session_id is None else None
    staging = command([
        HERDR, "tab", "create", "--workspace", workspace_id,
        "--cwd", str(REVIEW_WORKDIR), "--label", f"{worker_id}-staging", "--no-focus",
    ])
    staging_tab = required_path(staging, "tab", "tab_id")
    shell_pane = required_path(staging, "root_pane", "pane_id")
    agent_pane = worker_tab = None
    try:
        argv = (["opencode", "--mini", str(REVIEW_WORKDIR), "-s", session_id,
                 "--agent", "build", "--no-replay"] if session_id else
                ["opencode", "run", "--agent", "build", "--command", "dbsctr-improve", "--interactive"])
        started = command([
            HERDR, "agent", "start", worker_id, "--cwd", str(REVIEW_WORKDIR),
            "--tab", staging_tab, "--env", f"PATH={MANAGED_PATH}",
            "--env", f"DBSCTR_RND_WORKER_ID={worker_id}", "--no-focus", "--", *argv,
        ])
        agent_pane = required_id(started, "pane_id")
        moved = command([
            HERDR, "pane", "move", agent_pane, "--new-tab", "--workspace", workspace_id,
            "--label", f"R&D {worker_id[-8:]}", "--no-focus",
        ])
        worker_tab = required_path(moved, "move_result", "created_tab", "tab_id")
        destination = [pane.get("pane_id") for pane in panes(workspace_id)
                       if pane.get("tab_id") == worker_tab]
        if destination != [agent_pane]:
            raise RuntimeError("worker destination tab is not single-pane")
        close_unchanged_staging(workspace_id, staging_tab, shell_pane)
        actual_session = wait_for_session(agent_pane, session_id, before, argv)
        return actual_session, worker_tab, agent_pane
    except Exception:
        try:
            if agent_pane and worker_tab:
                close_pending_launch(workspace_id, worker_tab, agent_pane)
            close_unchanged_staging(workspace_id, staging_tab, shell_pane)
        except Exception:
            pass
        raise


def close_pending_launch(workspace_id, tab_id, pane_id):
    current = [pane.get("pane_id") for pane in panes(workspace_id) if pane.get("tab_id") == tab_id]
    if current == [pane_id]:
        command([HERDR, "tab", "close", tab_id], parse=False)
        return True
    return False


def spawn():
    if not REVIEW_WORKDIR.is_dir():
        raise RuntimeError(f"review workdir does not exist: {REVIEW_WORKDIR}")
    workers = validated_workers(command([DBSCTRCTL, "improvement-status"]))
    reservation, reason = reserve_spawn(workers, int(time.time()))
    if reservation is None:
        print(json.dumps({"status": "no_op", "reason": reason}, separators=(",", ":")))
        return
    worker_id = f"dbsctr-{uuid.uuid4().hex[:8]}"
    workspace_id = tab_id = pane_id = None
    try:
        claim_reservation(reservation, worker_id)
        workspace_id = workspace()
        session_id, tab_id, pane_id = launch(workspace_id, worker_id)
        complete_reservation(reservation, worker_id, session_id=session_id)
        worker = command([
            DBSCTRCTL, "improvement-register", "--worker-id", worker_id,
            "--session-id", session_id, "--workspace-id", workspace_id,
            "--tab-id", tab_id, "--pane-id", pane_id,
        ])
        if (not isinstance(worker, dict) or worker.get("worker_id") != worker_id
                or worker.get("session_id") != session_id):
            raise RuntimeError("registered worker identity mismatch")
    except Exception:
        if all(value is not None for value in (workspace_id, tab_id, pane_id)):
            close_pending_launch(workspace_id, tab_id, pane_id)
        release_reservation(reservation)
        raise
    print(json.dumps(worker, separators=(",", ":")))


def managed_cwd(value):
    return isinstance(value, str) and Path(value).resolve() == REVIEW_WORKDIR


def exact_resumed_agent(worker, agents):
    recorded = [agent for agent in agents
                if agent.get("pane_id") == worker.get("pane_id")
                and agent.get("tab_id") == worker.get("tab_id")
                and agent.get("workspace_id") == worker.get("workspace_id")
                and managed_cwd(agent.get("foreground_cwd") or agent.get("cwd"))]
    if len(recorded) != 1:
        return []
    tab_panes = [pane for pane in panes(worker["workspace_id"])
                 if pane.get("tab_id") == worker["tab_id"]]
    info = result(command([HERDR, "pane", "process-info", "--pane", worker["pane_id"]]))
    processes = info.get("process_info", {}).get("foreground_processes", [])
    expected = ["opencode", "--mini", str(REVIEW_WORKDIR), "-s", worker["session_id"],
                "--agent", "build", "--no-replay"]
    if ([pane.get("pane_id") for pane in tab_panes] == [worker["pane_id"]]
            and len(processes) == 1 and processes[0].get("argv") == expected):
        return recorded
    return []


def reconcile_pr(worker, token):
    if worker["state"] != "draft_pr" or not worker.get("pr_url"):
        return token, worker, None
    if token is None:
        token = command([
            GH, "auth", "token", "--hostname", "github.com", "--user", GITHUB_ACCOUNT,
        ], parse=False).strip()
        if not token:
            raise RuntimeError("configured GitHub account returned no token")
    pull = command([
        GH, "pr", "view", worker["pr_url"], "--repo", GITHUB_REPOSITORY,
        "--json", "state,isDraft,mergeCommit",
    ], env={**os.environ, "GH_TOKEN": token})
    if not isinstance(pull, dict):
        raise RuntimeError("GitHub pull request response is not an object")
    state = {"MERGED": "merged", "CLOSED": "closed"}.get(pull.get("state"))
    merge_identity = pull.get("mergeCommit", {}).get("oid") if state == "merged" else None
    if state == "merged" and merge_identity is None:
        raise RuntimeError("GitHub merge identity is missing")
    if merge_identity is not None and (len(merge_identity) not in (40, 64)
                                       or any(character not in "0123456789abcdef" for character in merge_identity)):
        raise RuntimeError("GitHub merge identity is invalid")
    if state:
        worker = command([
            DBSCTRCTL, "improvement-update", "--worker-id", worker["worker_id"], "--state", state,
        ])
    return token, worker, merge_identity


def watchdog():
    LOCK.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(LOCK.parent, 0o700)
    lock = LOCK.open("a+")
    os.chmod(LOCK, 0o600)
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        print('{"events":[],"status":"already_running"}')
        return 0
    workers = validated_workers(command([DBSCTRCTL, "improvement-status"]))
    current_workers = {worker["worker_id"]: worker for worker in workers}
    merge_identities = {}
    actionable = [worker for worker in workers
                  if not (worker["state"] == "claimed" and worker.get("priority") != "P1")]
    agents = (records(command([HERDR, "agent", "list"]), "agents") if actionable else [])
    token = None
    events = []
    for worker in workers:
        try:
            token, worker, merge_identity = reconcile_pr(worker, token)
            current_workers[worker["worker_id"]] = worker
            if merge_identity is not None:
                merge_identities[worker["worker_id"]] = merge_identity
        except (OSError, subprocess.CalledProcessError, json.JSONDecodeError, RuntimeError) as error:
            events.append({"worker_id": worker["worker_id"], "status": "pr_check_failed", "error": str(error)})
        if worker["state"] in TERMINAL:
            continue
        if worker["state"] == "blocked":
            events.append({"worker_id": worker["worker_id"], "status": "blocked"})
            continue
        if worker["state"] == "claimed" and worker.get("priority") != "P1":
            events.append({"worker_id": worker["worker_id"], "status": "waiting_priority"})
            continue
        matches = [agent for agent in agents
                   if agent.get("agent_session", {}).get("value") == worker["session_id"]]
        if not matches and worker.get("pane_id") and worker.get("tab_id") and worker.get("workspace_id"):
            recorded = [agent for agent in agents
                        if agent.get("pane_id") == worker["pane_id"]
                        and agent.get("tab_id") == worker["tab_id"]
                        and agent.get("workspace_id") == worker["workspace_id"]]
            try:
                matches = exact_resumed_agent(worker, agents) if len(recorded) == 1 else []
            except (OSError, subprocess.CalledProcessError, json.JSONDecodeError, RuntimeError):
                matches = []
            if recorded and not matches:
                command([DBSCTRCTL, "improvement-update", "--worker-id", worker["worker_id"], "--state", "blocked"])
                current_workers[worker["worker_id"]] = {**worker, "state": "blocked"}
                events.append({"worker_id": worker["worker_id"], "status": "ambiguous"})
                continue
        if len(matches) > 1:
            command([DBSCTRCTL, "improvement-update", "--worker-id", worker["worker_id"], "--state", "blocked"])
            current_workers[worker["worker_id"]] = {**worker, "state": "blocked"}
            events.append({"worker_id": worker["worker_id"], "status": "ambiguous"})
            continue
        if len(matches) == 1:
            status = matches[0].get("agent_status")
            if status in {"working", "idle", "blocked"}:
                continue
            if status != "missing":
                command([DBSCTRCTL, "improvement-update", "--worker-id", worker["worker_id"], "--state", "blocked"])
                current_workers[worker["worker_id"]] = {**worker, "state": "blocked"}
                events.append({"worker_id": worker["worker_id"], "status": "unknown"})
                continue
        if worker["recovery_attempts"] >= 3:
            events.append({"worker_id": worker["worker_id"], "status": "blocked"})
            continue
        launched = None
        try:
            workspace_id = workspace()
            session_id, tab_id, pane_id = launch(workspace_id, worker["worker_id"], worker["session_id"])
            launched = (workspace_id, tab_id, pane_id, session_id)
            command([
                DBSCTRCTL, "improvement-update", "--worker-id", worker["worker_id"],
                "--state", worker["state"], "--workspace-id", workspace_id,
                "--tab-id", tab_id, "--pane-id", pane_id,
            ])
            command([DBSCTRCTL, "improvement-recover", "--worker-id", worker["worker_id"], "--action", "success"])
            events.append({"worker_id": worker["worker_id"], "session_id": session_id, "status": "recovered"})
        except (OSError, subprocess.CalledProcessError, json.JSONDecodeError, RuntimeError) as error:
            if launched:
                close_pending_launch(*launched[:3])
            command([DBSCTRCTL, "improvement-recover", "--worker-id", worker["worker_id"], "--action", "failed"])
            events.append({"worker_id": worker["worker_id"], "status": "recovery_failed", "error": str(error)})
    scheduler = state_connection()
    try:
        scheduler.execute("BEGIN IMMEDIATE")
        sync_worker_outcomes(scheduler, list(current_workers.values()), int(time.time()), merge_identities)
        scheduler.commit()
    except Exception:
        scheduler.rollback()
        raise
    finally:
        scheduler.close()
    print(json.dumps({"events": events}, separators=(",", ":")))
    return int(any(event["status"] not in {"recovered", "waiting_priority"} for event in events))


def persist_malformed_halt():
    try:
        connection = sqlite3.connect(STATE)
        connection.execute("UPDATE scheduler_state SET halt_reason='malformed_state' WHERE singleton=1")
        connection.commit()
        connection.close()
    except sqlite3.Error:
        pass


parser = argparse.ArgumentParser()
parser.add_argument("action", choices=("spawn", "watchdog", "analytics", "reset-schedule",
                                        "backlogs", "repositories", "reserve", "complete", "release", "launch",
                                        "lens-plan", "lens-result", "health"))
parser.add_argument("--json", action="store_true")
parser.add_argument("--finalize-json")
parser.add_argument("--failure-json")
parser.add_argument("--reservation")
parser.add_argument("--worker-id")
parser.add_argument("--repository-id")
parser.add_argument("--capture-day")
parser.add_argument("--manifest-digest")
parser.add_argument("--outcome", choices=("yield", "no_yield"))
parser.add_argument("--telemetry-json")
parser.add_argument("--reason", choices=("operator_release", "prelaunch_failed"), default="operator_release")
args = parser.parse_args()
try:
    if args.action == "analytics":
        request = json.loads(args.finalize_json) if args.finalize_json else None
        failure = json.loads(args.failure_json) if args.failure_json else None
        analytics(int(time.time()), args.json, request, failure)
    elif args.action == "reset-schedule":
        if args.finalize_json or args.failure_json:
            raise RuntimeError("reset-schedule does not accept analytics inputs")
        reset_schedule()
    elif args.action == "backlogs":
        print(json.dumps(canonical_backlogs(args.repository_id), sort_keys=True, separators=(",", ":")))
    elif args.action == "repositories":
        print(json.dumps(backlog_repositories(), sort_keys=True, separators=(",", ":")))
    elif args.action == "reserve":
        reserve_action()
    elif args.action == "complete":
        if not args.reservation or not args.worker_id:
            raise RuntimeError("complete requires reservation and worker ID")
        complete_action(args.reservation, args.worker_id)
    elif args.action == "release":
        if not args.reservation:
            raise RuntimeError("release requires reservation")
        release_action(args.reservation, args.reason)
    elif args.action == "health":
        print(json.dumps(scheduler_health(), sort_keys=True, separators=(",", ":")))
    elif args.action == "launch":
        if not args.reservation or not args.worker_id or not args.repository_id:
            raise RuntimeError("launch requires reservation, worker ID, and repository ID")
        launch_action(args.reservation, args.worker_id, args.repository_id)
    elif args.action == "lens-plan":
        lens_plan_action(args.worker_id)
    elif args.action == "lens-result":
        if not all((args.worker_id, args.capture_day, args.manifest_digest, args.outcome)):
            raise RuntimeError("lens-result requires worker, capture, digest, and outcome")
        if args.telemetry_json:
            value = parallel_lens_result(args.worker_id, args.capture_day, args.manifest_digest,
                                         args.outcome, json.loads(args.telemetry_json))
        else:
            value = lens_result(args.worker_id, args.capture_day, args.manifest_digest, args.outcome)
        print(json.dumps(value, sort_keys=True, separators=(",", ":")))
    else:
        if args.json or args.finalize_json or args.failure_json:
            raise RuntimeError(f"{args.action} does not accept analytics inputs")
        status = {"spawn": spawn, "watchdog": watchdog}[args.action]()
        if status:
            raise SystemExit(status)
except (OSError, subprocess.CalledProcessError, json.JSONDecodeError, sqlite3.Error,
        KeyError, ValueError, RuntimeError) as error:
    raise SystemExit(str(error))
