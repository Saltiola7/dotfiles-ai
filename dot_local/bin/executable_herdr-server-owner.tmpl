#!/bin/bash

set -u
HERDR={{ .dotfiles_ai.herdr.executable | quote }}
error=$(mktemp "${TMPDIR:-/tmp}/herdr-server.XXXXXX") || exit 1
trap '/bin/rm -f "$error"' EXIT
"$HERDR" server 2>"$error"
status=$?
if [[ $status -ne 0 ]] && /usr/bin/grep -q '^error: herdr server is already running$' "$error" \
    && "$HERDR" status server >/dev/null 2>&1; then
    exit 0
fi
/bin/cat "$error" >&2
exit "$status"
