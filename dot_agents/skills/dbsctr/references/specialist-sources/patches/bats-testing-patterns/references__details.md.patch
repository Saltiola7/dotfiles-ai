-    cp "$FIXTURES_DIR/input.txt" "$WORK_DIR/input.txt"
-
-    # Run function
-    run my_process_function "$WORK_DIR/input.txt"
-
-    # Compare output
-    diff "$WORK_DIR/output.txt" "$FIXTURES_DIR/expected_output.txt"
