#!/usr/bin/env bash
# Worktrunk 0.80.0, official Linux aarch64/x86_64 releases.
set -euo pipefail
{{ if not .dotfiles_ai.linux_workstation.enabled -}}
exit 0
{{ end -}}
case "$(uname -s):$(uname -m)" in
  Linux:aarch64|Linux:arm64)
    asset=worktrunk-aarch64-unknown-linux-musl
    sha256=347b260c1b044a53a7720b33181d7c66dcde945efbd605d784e5b6a5616c17e9
    ;;
  Linux:x86_64)
    asset=worktrunk-x86_64-unknown-linux-musl
    sha256=532ce3ed5eecb1be274c925b5887f61671e2434a4ca2561b9a8ac9379dbba199
    ;;
  *) echo "This workstation profile requires Linux aarch64 or x86_64." >&2; exit 1 ;;
esac
version=0.80.0
target="$HOME/.local/bin/wt"
provider=$(type -P wt || true)
if [[ -n $provider ]]; then
    if [[ $("$provider" --version 2>/dev/null) == "wt v$version" ]]; then exit 0; fi
    echo "Worktrunk ownership review required: existing PATH provider at $provider differs from the qualified Linux pin; leaving it unchanged." >&2
    exit 1
fi
if [[ -x $target ]]; then
    if [[ $("$target" --version 2>/dev/null) == "wt v$version" ]]; then exit 0; fi
    echo "Worktrunk ownership review required: existing executable at $target differs from the pin; leaving it unchanged." >&2
    exit 1
fi
if [[ -e $target || -L $target ]]; then
    echo "Worktrunk ownership review required: existing destination at $target; leaving it unchanged." >&2
    exit 1
fi
stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT
curl -fsSL --retry 3 --connect-timeout 10 --max-time 180 \
  "https://github.com/max-sixty/worktrunk/releases/download/v$version/$asset.tar.xz" -o "$stage/worktrunk.tar.xz"
printf '%s  %s\n' "$sha256" "$stage/worktrunk.tar.xz" | sha256sum -c -
tar -xJf "$stage/worktrunk.tar.xz" -C "$stage" "$asset/wt"
[[ $("$stage/$asset/wt" --version) == "wt v$version" ]] || { echo "managed Worktrunk version mismatch" >&2; exit 1; }
install -Dm755 "$stage/$asset/wt" "$HOME/.local/bin/wt"
