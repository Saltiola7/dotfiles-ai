# Repository-root context; public source allowlist only, never a host HOME.
FROM registry.access.redhat.com/ubi10/ubi
ENV container=docker
RUN dnf -y --setopt=install_weak_deps=False install \
      systemd systemd-pam dbus-daemon dbus-broker shadow-utils util-linux procps-ng iproute \
      git-core python3 curl-minimal tar gzip unzip findutils \
    && dnf clean all \
    && useradd --uid 1000 --create-home --shell /bin/bash fixture \
    && systemctl set-default multi-user.target \
    && systemctl unmask systemd-logind.service \
    && systemctl add-wants multi-user.target systemd-logind.service dbus.socket
COPY .chezmoidata.toml config.remote-user.example.toml /opt/f01/source/
COPY dot_local/bin/executable_opencode.tmpl dot_local/bin/executable_opencode-install.tmpl dot_local/bin/executable_remote-herdr dot_local/bin/executable_remote-herdr-core /opt/f01/source/dot_local/bin/
COPY dot_local/share/dotfiles-ai/remote-herdr/controller.py dot_local/share/dotfiles-ai/remote-herdr/native.py dot_local/share/dotfiles-ai/remote-herdr/layout.py dot_local/share/dotfiles-ai/remote-herdr/processes.py dot_local/share/dotfiles-ai/remote-herdr/protocol.py /opt/f01/source/dot_local/share/dotfiles-ai/remote-herdr/
COPY private_dot_config/systemd/user/opencode-shared.service private_dot_config/systemd/user/remote-herdr-tui.service.tmpl private_dot_config/systemd/user/remote-herdr-restore.service.tmpl private_dot_config/systemd/user/remote-herdr-restore.timer.tmpl /opt/f01/source/private_dot_config/systemd/user/
COPY private_dot_config/herdr/config.toml.tmpl /opt/f01/source/private_dot_config/herdr/
COPY private_dot_config/dotfiles-ai/herdr-core.json.tmpl private_dot_config/dotfiles-ai/herdr-runtime.json.tmpl /opt/f01/source/private_dot_config/dotfiles-ai/
COPY run_onchange_after_install-00-remote-herdr.sh.tmpl run_onchange_after_install-00z-remote-herdr-core.sh.tmpl run_onchange_after_install-01-remote-opencode.sh.tmpl run_after_install-04-remote-opencode-service.sh.tmpl run_after_install-05-remote-herdr-runtime.sh.tmpl /opt/f01/source/
COPY dot_local/bin/executable_remote-user-bootstrap /opt/f01/bootstrap.py
COPY tests/remote_opencode_systemd/verify-user.py /opt/f01/verify-user.py
COPY tests/remote_herdr_systemd/boot-smoke.sh tests/remote_herdr_systemd/verify-user.py /opt/f07/
RUN install -d -m 0700 /var/lib/f07
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
