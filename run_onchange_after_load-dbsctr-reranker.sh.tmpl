#!/bin/bash
# plist: {{ include "private_Library/LaunchAgents/dev.dotfiles-ai.dbsctr-reranker.plist.tmpl" | sha256sum }}
# wrapper: {{ include "dot_local/bin/executable_dbsctr-reranker.tmpl" | sha256sum }}
set -euo pipefail
[[ $(uname) == Darwin ]] || exit 0
domain="gui/$(id -u)"; label=dev.dotfiles-ai.dbsctr-reranker
plist="$HOME/Library/LaunchAgents/$label.plist"; wrapper="$HOME/.local/bin/dbsctr-reranker"
{{ if not (and .dotfiles_ai.knowledge_store.enabled .dotfiles_ai.knowledge_store.quality_services_enabled) -}}
if /bin/launchctl print "$domain/$label" >/dev/null 2>&1; then /bin/launchctl bootout "$domain/$label"; fi
[[ $(/usr/libexec/PlistBuddy -c 'Print :Label' "$plist" 2>/dev/null || true) != "$label" ]] || /bin/rm -f "$plist"
/bin/rm -f "$wrapper" "$HOME/.config/dotfiles-ai/knowledge/reranker-space.json"
exit 0
{{ end -}}
/usr/bin/plutil -lint "$plist" >/dev/null
{{ .dotfiles_ai.knowledge_store.quality_model_root | quote }}/dbsctr/reranker-venv/bin/python "$wrapper" verify
/bin/launchctl bootout "$domain/$label" >/dev/null 2>&1 || true
for _ in {1..50}; do
    /bin/launchctl print "$domain/$label" >/dev/null 2>&1 || break
    /bin/sleep 0.1
done
/bin/launchctl print "$domain/$label" >/dev/null 2>&1 && {
    echo "load-dbsctr-reranker: prior service did not unload" >&2
    exit 1
}
/bin/launchctl bootstrap "$domain" "$plist"
cleanup() { /bin/launchctl bootout "$domain/$label" >/dev/null 2>&1 || true; }
trap cleanup ERR INT TERM
for _ in {1..90}; do
    if /usr/bin/curl -fsS --max-time 2 "http://127.0.0.1:{{ .dotfiles_ai.knowledge_store.reranker_port }}/health" >/dev/null 2>&1; then
        {{ .dotfiles_ai.knowledge_store.quality_model_root | quote }}/dbsctr/reranker-venv/bin/python "$wrapper" check >/dev/null
        trap - ERR INT TERM
        exit 0
    fi
    /bin/sleep 2
done
echo "load-dbsctr-reranker: service did not become ready" >&2
exit 1
