#!/bin/bash
# config: {{ includeTemplate "private_dot_config/mise/config.toml.tmpl" . | sha256sum }}
# lock: {{ includeTemplate "private_dot_config/mise/mise.lock.tmpl" . | sha256sum }}
set -euo pipefail
{{ if not .dotfiles_ai.remote_user_environment.enabled -}}
exit 0
{{ end -}}
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"
export XDG_CACHE_HOME="$HOME/.cache"
export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"
export UV_PYTHON_DOWNLOADS=never
mise="$HOME/.local/bin/remote-mise"
"$mise" install --locked
{{ if .dotfiles_ai.prefect_mcp.enabled -}}
version=$("$mise" exec -- python -I -c 'import sys; print(".".join(map(str, sys.version_info[:3])))')
[[ $version == {{ .dotfiles_ai.remote_user_environment.prefect_python_version | quote }} ]] || {
    echo 'remote mise Python pin is unavailable' >&2
    exit 1
}
{{ end -}}
