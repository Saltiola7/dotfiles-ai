#!/bin/bash
set -euo pipefail

{{ if ne .dotfiles_ai.codex.channel "stable" -}}
{{ fail "codex.channel must be stable" }}
{{ end -}}
{{ if .dotfiles_ai.state.root -}}
export DOTFILES_AI_STATE_ROOT={{ .dotfiles_ai.state.root | quote }}
export CODEX_HOME={{ printf "%s/codex" .dotfiles_ai.state.root | quote }}
{{ else -}}
export CODEX_HOME="$HOME/.local/state/dotfiles-ai/codex"
{{ end -}}
{{ if or .dotfiles_ai.remote_user_environment.enabled .dotfiles_ai.linux_workstation.enabled -}}
export DOTFILES_AI_REMOTE_USER_ENVIRONMENT=1
{{ end -}}
{{ if and (eq .chezmoi.os "darwin") (eq .chezmoi.arch "arm64") -}}
exec "$HOME/.local/bin/codex-install"
{{ else -}}
exec "$HOME/.local/bin/codex-update-all"
{{ end -}}
