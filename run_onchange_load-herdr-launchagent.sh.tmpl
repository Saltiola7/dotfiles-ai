#!/bin/bash
# Keep Herdr in Aqua so persistent panes can access the login Keychain.
# plist hash: {{ include "private_Library/LaunchAgents/dev.dotfiles-ai.herdr-server.plist.tmpl" | sha256sum }}
# owner wrapper: {{ include "dot_local/bin/executable_herdr-server-owner.tmpl" | sha256sum }}
# enabled: {{ .dotfiles_ai.herdr.launchagent }}

set -u
[[ "$(uname)" == "Darwin" ]] || exit 0

PLIST="$HOME/Library/LaunchAgents/dev.dotfiles-ai.herdr-server.plist"
DOMAIN="gui/$(id -u)"
LABEL="dev.dotfiles-ai.herdr-server"
HERDR={{ .dotfiles_ai.herdr.executable | quote }}

herdr_server_running() {
    "$HERDR" status server --json 2>/dev/null | /usr/bin/grep -q '"running":true'
}

{{ if not .dotfiles_ai.herdr.launchagent -}}
/bin/launchctl bootout "$DOMAIN/$LABEL" >/dev/null 2>&1 || true
PLIST_LABEL=$(/usr/libexec/PlistBuddy -c 'Print :Label' "$PLIST" 2>/dev/null || true)
if [[ "$PLIST_LABEL" == "$LABEL" ]]; then
    /bin/rm -f "$PLIST"
fi
exit 0
{{ end -}}

[[ -f "$PLIST" ]] || exit 0
mkdir -p "$HOME/Library/Logs"

if ! /bin/launchctl print "$DOMAIN/$LABEL" >/dev/null 2>&1 \
    && herdr_server_running; then
    echo "[herdr-launchagent] unmanaged server owns the socket; run 'herdr server stop', then rerun chezmoi apply" >&2
    exit 1
fi

/bin/launchctl bootout "$DOMAIN/$LABEL" >/dev/null 2>&1 || true
for _ in {1..50}; do
    if ! herdr_server_running; then
        exec /bin/launchctl bootstrap "$DOMAIN" "$PLIST"
    fi
    sleep 0.1
done
echo "[herdr-launchagent] managed server did not stop within 5 seconds" >&2
exit 1
