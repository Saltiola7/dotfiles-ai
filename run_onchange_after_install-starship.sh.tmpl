#!/bin/sh
set -eu

version=1.26.0
archive="$(mktemp)"
tmpdir="$(mktemp -d)"
trap 'rm -rf "$archive" "$tmpdir"' EXIT
curl -fsSL "https://github.com/starship/starship/releases/download/v${version}/starship-aarch64-unknown-linux-musl.tar.gz" -o "$archive"
printf '%s  %s\n' dc30189378d2f2e287384e8a692d3f95ad1df64cf0e8c36aa9201516028aed6b "$archive" | sha256sum -c -
install -d -m 0755 "$HOME/.local/bin"
tar -xzf "$archive" -C "$tmpdir" starship
install -m 0755 "$tmpdir/starship" "$HOME/.local/bin/.starship.new"
mv -f "$HOME/.local/bin/.starship.new" "$HOME/.local/bin/starship"
