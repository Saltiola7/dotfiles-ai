#!/bin/bash
# plist: {{ include "private_Library/LaunchAgents/dev.dotfiles-ai.dbsctr-knowledge-reconcile.plist.tmpl" | sha256sum }}
# dksctl: {{ include "dot_local/bin/executable_dksctl" | sha256sum }}
set -euo pipefail
[[ $(uname) == Darwin ]] || exit 0
domain="gui/$(id -u)"; label=dev.dotfiles-ai.dbsctr-knowledge-reconcile
plist="$HOME/Library/LaunchAgents/$label.plist"
{{ if not (and .dotfiles_ai.knowledge_store.enabled .dotfiles_ai.knowledge_store.postgres_enabled .dotfiles_ai.knowledge_store.reconcile_enabled) -}}
if /bin/launchctl print "$domain/$label" >/dev/null 2>&1; then /bin/launchctl bootout "$domain/$label"; fi
[[ $(/usr/libexec/PlistBuddy -c 'Print :Label' "$plist" 2>/dev/null || true) != "$label" ]] || /bin/rm -f "$plist"
exit 0
{{ end -}}
{{ if or (lt (.dotfiles_ai.knowledge_store.reconcile_interval_seconds | int) 300) (gt (.dotfiles_ai.knowledge_store.reconcile_interval_seconds | int) 86400) -}}
{{ fail "dotfiles_ai.knowledge_store.reconcile_interval_seconds must be between 300 and 86400" }}
{{ end -}}
{{ if or (lt (.dotfiles_ai.knowledge_store.reconcile_timeout_seconds | int) 60) (gt (.dotfiles_ai.knowledge_store.reconcile_timeout_seconds | int) 86400) -}}
{{ fail "dotfiles_ai.knowledge_store.reconcile_timeout_seconds must be between 60 and 86400" }}
{{ end -}}
/usr/bin/plutil -lint "$plist" >/dev/null
/bin/launchctl bootout "$domain/$label" >/dev/null 2>&1 || true
/bin/launchctl bootstrap "$domain" "$plist"
