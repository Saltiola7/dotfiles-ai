#!/bin/bash
# Brewfile hash: {{ include "Brewfile" | sha256sum }}
set -euo pipefail

{{ if ne .chezmoi.os "darwin" -}}
exit 0
{{ end -}}

command -v brew >/dev/null || {
    echo "Homebrew is required to install OpenCode: https://brew.sh" >&2
    exit 1
}

brew bundle --file="{{ .chezmoi.sourceDir }}/Brewfile"
