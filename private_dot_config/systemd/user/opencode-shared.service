[Unit]
Description=Managed OpenCode shared service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
WorkingDirectory=%h
Environment=HOME=%h
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/opencode serve --service --hostname 127.0.0.1 --port 0
Restart=on-failure
RestartSec=3
UMask=0077
TimeoutStopSec=30

[Install]
WantedBy=default.target
