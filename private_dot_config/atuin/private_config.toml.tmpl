{{ if .dotfiles_ai.remote_user_environment.enabled -}}
auto_sync = false
sync_address = ""
{{ else -}}
auto_sync = true
sync_address = {{ .dotfiles_ai.atuin.sync_address | quote }}
{{ end -}}
sync_frequency = "10m"
filter_mode = "global"
workspaces = true
secrets_filter = true
enter_accept = true
network_connect_timeout = 2
network_timeout = 5

history_filter = [
  '^atuin key(?:\s|$)',
  '^gh auth token(?:\s|$)',
  '^op read(?:\s|$)',
  '(?i)(?:password|secret|token|api[_-]?key)\s*=',
]

[sync]
records = true

[daemon]
enabled = false
