minimumLimaVersion: "2.1.4"
base:
  - template:_images/fedora-44
vmType: "vz"
mountType: "virtiofs"
arch: "aarch64"
cpus: {{ .dotfiles_ai.sandbox.cpus }}
memory: "{{ .dotfiles_ai.sandbox.memory_gib }}GiB"
disk: "{{ .dotfiles_ai.sandbox.disk_gib }}GiB"
mounts:
@@MOUNTS@@
@@PORT_FORWARDS@@
provision:
  - mode: system
    script: |
      set -eu
      dnf install -y ca-certificates curl git gh jq python3 ripgrep tar gzip util-linux uv
      install -d -m 0755 /usr/local/libexec /etc/opencode-sandbox
      cat >/etc/opencode-sandbox/workspace.json <<'JSON'
      @@WORKSPACE_JSON@@
      JSON
      cat >/usr/local/libexec/opencode-protected-paths <<'PY'
      #!/usr/bin/env python3
      import configparser
      import json
      from pathlib import Path, PurePosixPath
      config = json.loads(Path("/etc/opencode-sandbox/workspace.json").read_text())
      protected = []
      for mount in config["mounts"]:
          if not mount["protect_git_submodules"]:
              continue
          root = Path(mount["guest"]).resolve(strict=True)
          parser = configparser.ConfigParser(interpolation=None)
          if not parser.read(root / ".gitmodules"):
              raise SystemExit("missing .gitmodules")
          paths = []
          for section in parser.sections():
              if not section.startswith("submodule ") or not parser.has_option(section, "path"):
                  continue
              value = parser.get(section, "path")
              relative = PurePosixPath(value)
              if relative.is_absolute() or not value or "." in relative.parts or ".." in relative.parts:
                  raise SystemExit("invalid submodule path")
              target = (root / value).resolve(strict=True)
              target.relative_to(root)
              paths.append(str(target))
          if len(paths) != len(set(paths)):
              raise SystemExit("duplicate submodule path")
          protected.extend(paths)
          protected.append(str(root / ".gitmodules"))
          if (root / ".git/modules").is_dir():
              protected.append(str(root / ".git/modules"))
      print(json.dumps(sorted(protected), separators=(",", ":")))
      PY
      chmod 0755 /usr/local/libexec/opencode-protected-paths
      /usr/local/libexec/opencode-protected-paths >/etc/opencode-sandbox/protected.json
      chmod 0444 /etc/opencode-sandbox/workspace.json /etc/opencode-sandbox/protected.json
      tmp="$(mktemp)"
      curl -fsSL https://github.com/anomalyco/opencode/releases/download/v1.18.4/opencode-linux-arm64.tar.gz -o "$tmp"
      printf '%s  %s\n' eba87efba3976d533a24cca0316f8ef375b5f8e797c0a95c25ee919700b7ba35 "$tmp" | sha256sum -c -
      tar -xzf "$tmp" -C /usr/local/libexec
      curl -fsSL https://github.com/ogulcancelik/herdr/releases/download/v0.7.5/herdr-linux-aarch64 -o "$tmp"
      printf '%s  %s\n' 32e763a1499a6b694b1d708e4f062b743be1da9f34fcfa4d212d6db6fe09a8b9 "$tmp" | sha256sum -c -
      install -m 0755 "$tmp" /usr/local/bin/herdr
      curl -fsSL https://github.com/twpayne/chezmoi/releases/download/v2.69.4/chezmoi-2.69.4-aarch64.rpm -o "$tmp"
      printf '%s  %s\n' f9879c21933225a5adb86fafaf904ac06e4395cae915d4f838c9ccffd9cd4847 "$tmp" | sha256sum -c -
      rpm -Uvh --replacepkgs "$tmp"
      rm -f "$tmp"
      cat >/usr/local/bin/opencode <<'EOF'
      #!/bin/sh
      test -e /run/opencode-sandbox-ready || { echo "opencode: sandbox protection is not ready" >&2; exit 1; }
      case "${1:-}" in
        acp|attach|completion|mcp|debug|providers|auth|agent|upgrade|uninstall|serve|web|models|stats|export|import|github|pr|plugin|db)
          exec /usr/local/libexec/opencode "$@" ;;
        *) exec /usr/local/libexec/opencode --auto "$@" ;;
      esac
      EOF
      chmod 0755 /usr/local/bin/opencode
      agent_user="$(getent passwd | awk -F: '$6 ~ /\.guest$/ {print $1}')"
      test -n "$agent_user"
      test "$(printf '%s\n' "$agent_user" | grep -c .)" -eq 1
      printf '%s ALL=(ALL) !ALL\n' "$agent_user" >/etc/sudoers.d/99-opencode-sandbox
      chmod 0440 /etc/sudoers.d/99-opencode-sandbox
      visudo -cf /etc/sudoers.d/99-opencode-sandbox
      chmod 0750 /usr/bin/sudo
      cat >/usr/local/libexec/opencode-sandbox-ready <<'EOF'
      #!/bin/sh
      set -eu
      rm -f /run/opencode-sandbox-ready
      wait_mount() {
        target="$1"
        for _ in $(seq 1 60); do
          test "$(findmnt -T "$target" -n -o FSTYPE 2>/dev/null)" = virtiofs && return
          sleep 1
        done
        echo "sandbox mount is unavailable: $target" >&2
        exit 1
      }
      protect() {
        target="$1"
        test -e "$target" || { echo "missing protected path: $target" >&2; exit 1; }
        mountpoint -q "$target" || mount --bind "$target" "$target"
        mount -o remount,bind,ro "$target"
        findmnt -n -o OPTIONS --target "$target" | tr ',' '\n' | grep -qx ro
      }
      tab="$(printf '\t')"
      jq -r '.mounts[] | [.guest, (.writable | tostring)] | @tsv' /etc/opencode-sandbox/workspace.json |
      while IFS="$tab" read -r target writable; do
        wait_mount "$target"
        expected=ro
        test "$writable" = true && expected=rw
        findmnt -n -o OPTIONS --target "$target" | tr ',' '\n' | grep -qx "$expected"
      done
      current="$(mktemp)"
      /usr/local/libexec/opencode-protected-paths >"$current"
      cmp "$current" /etc/opencode-sandbox/protected.json
      rm -f "$current"
      jq -r '.[]' /etc/opencode-sandbox/protected.json | while IFS= read -r target; do protect "$target"; done
      agent_user="$(getent passwd | awk -F: '$6 ~ /\.guest$/ {print $1}')"
      test -n "$agent_user"
      test "$(printf '%s\n' "$agent_user" | grep -c .)" -eq 1
      test "$(stat -c '%U:%G:%a' /usr/bin/sudo)" = root:root:750
      if su -s /bin/sh - "$agent_user" -c 'test -x /usr/bin/sudo'; then
        echo "sandbox user can execute sudo" >&2
        exit 1
      fi
      touch /run/opencode-sandbox-ready
      EOF
      chmod 0755 /usr/local/libexec/opencode-sandbox-ready
      cat >/etc/systemd/system/opencode-sandbox-ready.service <<'EOF'
      [Unit]
      Description=Verify OpenCode sandbox boundaries
      Wants=lima-guestagent.service
      After=lima-guestagent.service

      [Service]
      Type=oneshot
      ExecStart=/usr/local/libexec/opencode-sandbox-ready
      RemainAfterExit=yes

      [Install]
      WantedBy=multi-user.target
      EOF
      systemctl daemon-reload
      systemctl enable --now opencode-sandbox-ready.service
      test -e /run/opencode-sandbox-ready
  - mode: user
    script: |
      set -eu
      source="$HOME/.local/share/chezmoi-dotfiles-ai"
      if test -d "$source/.git"; then git -C "$source" pull --ff-only; else git clone @@SOURCE@@ "$source"; fi
      mkdir -p "$HOME/.config/dotfiles-ai"
      cat >"$HOME/.config/dotfiles-ai/chezmoi.toml" <<'EOF'
      @@GUEST_CONFIG@@
      EOF
      chezmoi -c "$HOME/.config/dotfiles-ai/chezmoi.toml" apply
      herdr integration install opencode
