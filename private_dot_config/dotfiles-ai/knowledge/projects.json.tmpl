{{- if and .dotfiles_ai.knowledge_store.enabled .dotfiles_ai.knowledge_store.postgres_enabled -}}
{
  "schema_version": 1,
  "psql": {{ printf "%s/.local/bin/dks-psql" .chezmoi.homeDir | toJson }},
  "quality_benchmark_approval_commit": {{ .dotfiles_ai.knowledge_store.quality_benchmark_approval_commit | toJson }},
  "quality_benchmark_query_digest": {{ .dotfiles_ai.knowledge_store.quality_benchmark_query_digest | toJson }},
  "quality_benchmark_judgment_digest": {{ .dotfiles_ai.knowledge_store.quality_benchmark_judgment_digest | toJson }},
  "embedding": {
    "url": {{ printf "http://127.0.0.1:%v" .dotfiles_ai.knowledge_store.embedding_port | toJson }},
    "api_key_file": {{ printf "%s/dbsctr/knowledge/private/embedding-api-key" .dotfiles_ai.state.root | toJson }},
    "manifest_file": {{ printf "%s/.config/dotfiles-ai/knowledge/embedding-space.json" .chezmoi.homeDir | toJson }},
    "model": "qwen3-embedding-8b-q4km",
    "space_id": "qwen3e8b-q4km-llamacpp-b10505-native4096-v1",
    "manifest_sha256": {{ includeTemplate "private_dot_config/dotfiles-ai/knowledge/embedding-space.json.tmpl" . | sha256sum | toJson }}
  },
  "code_embedding": {
    "url": {{ printf "http://127.0.0.1:%v" .dotfiles_ai.knowledge_store.code_embedding_port | toJson }},
    "api_key_file": {{ printf "%s/.config/dotfiles-ai/private/code-embedding-api-key" .chezmoi.homeDir | toJson }},
    "manifest_file": {{ printf "%s/.config/dotfiles-ai/knowledge/code-embedding-space.json" .chezmoi.homeDir | toJson }},
    "model": "nomic-embed-code-q4km",
    "space_id": "nomic-code-q4km-llamacpp-0e1d9185-native3584-v1",
    "manifest_sha256": {{ includeTemplate "private_dot_config/dotfiles-ai/knowledge/code-embedding-space.json.tmpl" . | sha256sum | toJson }}
  },
  "reranker": {
    "url": {{ printf "http://127.0.0.1:%v" .dotfiles_ai.knowledge_store.reranker_port | toJson }},
    "api_key_file": {{ printf "%s/.config/dotfiles-ai/private/reranker-api-key" .chezmoi.homeDir | toJson }},
    "manifest_file": {{ printf "%s/.config/dotfiles-ai/knowledge/reranker-space.json" .chezmoi.homeDir | toJson }},
    "model": "qwen3-reranker-4b",
    "manifest_sha256": {{ includeTemplate "private_dot_config/dotfiles-ai/knowledge/reranker-space.json.tmpl" . | sha256sum | toJson }}
  },
  "projects": {
{{- $project := index .dotfiles_ai.knowledge_store.projects "dotfiles_ai" }}
    "dotfiles-ai": {
      "repository": {{ $project.repository | toJson }},
      "remote": {{ $project.remote | toJson }},
      "source_profile_file": {{ printf "%s/.local/share/dbsctr-knowledge/source-profile.json" .chezmoi.homeDir | toJson }},
      "source_profile_sha256": {{ includeTemplate "dot_local/share/dbsctr-knowledge/source-profile.json" . | sha256sum | toJson }},
      "knowledge_state_root": {{ printf "%s/dbsctr" .dotfiles_ai.state.root | toJson }}
    }
  }
}
{{- end }}
