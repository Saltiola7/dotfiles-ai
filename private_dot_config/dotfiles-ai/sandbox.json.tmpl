{{- if and .dotfiles_ai.pm_kernel.enabled .dotfiles_ai.pm_kernel.postgres_enabled -}}
{{- if or (not .dotfiles_ai.onepassword.enabled) (not .dotfiles_ai.pm_kernel.workspace) (not (hasPrefix "op://" .dotfiles_ai.pm_kernel.postgres_password_ref)) (not (hasPrefix "/" .dotfiles_ai.state.root)) (regexMatch "(^|/)\\.\\.(/|$)" .dotfiles_ai.pm_kernel.postgres_backup_dir) (not (hasPrefix (printf "%s/" .dotfiles_ai.state.root) .dotfiles_ai.pm_kernel.postgres_backup_dir)) -}}
{{ fail "enabled PM PostgreSQL requires 1Password, workspace, password reference, and absolute backup directory" }}
{{- end -}}
{{- end -}}
{{- if .dotfiles_ai.knowledge_store.postgres_enabled -}}
{{- $project := index .dotfiles_ai.knowledge_store.projects "dotfiles_ai" -}}
{{- if or (not .dotfiles_ai.knowledge_store.enabled) (not .dotfiles_ai.pm_kernel.enabled) (not .dotfiles_ai.pm_kernel.postgres_enabled) (not .dotfiles_ai.onepassword.enabled) (not $project.repository) (not (hasPrefix "https://" $project.remote)) (not (hasPrefix "op://" $project.postgres_password_ref)) -}}
{{ fail "enabled knowledge PostgreSQL requires embedding, PM PostgreSQL, 1Password, and a configured dotfiles-ai project" }}
{{- end -}}
{{- end -}}
{{- if and (eq .dotfiles_ai.pm_kernel.jira_adapter "acli") (or (not .dotfiles_ai.pm_kernel.jira_project) (not .dotfiles_ai.pm_kernel.jira_issue_types)) -}}
{{ fail "ACLI Jira requires a project and allowed issue types" }}
{{- end -}}
{{- if not (has .dotfiles_ai.rnd.runtime (list "opencode" "codex")) -}}
{{ fail "rnd.runtime must be opencode or codex" }}
{{- end -}}
{{- range $workspace := .dotfiles_ai.sandbox.workspaces -}}
{{- if and (hasKey $workspace "runtime") (not (kindIs "string" (get $workspace "runtime"))) -}}
{{ fail "workspace runtime must be a string" }}
{{- end -}}
{{- $runtime := get $workspace "runtime" | default "" -}}
{{- if not (has $runtime (list "" "opencode" "codex")) -}}
{{ fail "workspace runtime must be empty, opencode, or codex" }}
{{- end -}}
{{- end -}}
{
  "schema_version": 9,
  "enabled": {{ .dotfiles_ai.sandbox.enabled | toJson }},
  "source": {{ .dotfiles_ai.distribution.repository | toJson }},
  "template": {{ printf "%s/.config/dotfiles-ai/lima/workspace.yaml" .chezmoi.homeDir | toJson }},
  "build_workspace": {{ .dotfiles_ai.sandbox.build_workspace | toJson }},
  "atuin_workspace": {{ .dotfiles_ai.sandbox.atuin_workspace | toJson }},
  "pm_kernel": {
    "enabled": {{ .dotfiles_ai.pm_kernel.enabled | toJson }},
    "workspace": {{ .dotfiles_ai.pm_kernel.workspace | toJson }},
    "postgres_enabled": {{ .dotfiles_ai.pm_kernel.postgres_enabled | toJson }},
    "postgres_image": {{ .dotfiles_ai.pm_kernel.postgres_image | toJson }},
    "knowledge_postgres_enabled": {{ .dotfiles_ai.knowledge_store.postgres_enabled | toJson }}
  },
  "state_root": {{ .dotfiles_ai.state.root | toJson }},
  "codex": {
    "channel": {{ .dotfiles_ai.codex.channel | toJson }}
  },
  "lima_home": {{ .dotfiles_ai.sandbox.lima_home | toJson }},
  "tailscale": {
    "enabled": {{ .dotfiles_ai.tailscale.enabled | toJson }},
    "ssh": {{ .dotfiles_ai.tailscale.ssh | toJson }}
  },
  "onepassword": {
    "enabled": {{ .dotfiles_ai.onepassword.enabled | toJson }},
    "account": {{ .dotfiles_ai.onepassword.account | toJson }},
    "user_uuid": {{ .dotfiles_ai.onepassword.user_uuid | toJson }},
    "keychain_service": {{ .dotfiles_ai.onepassword.keychain_service | toJson }}
  },
  "resources": {
    "cpus": {{ .dotfiles_ai.sandbox.cpus }},
    "memory_gib": {{ .dotfiles_ai.sandbox.memory_gib }},
    "disk_gib": {{ .dotfiles_ai.sandbox.disk_gib }}
  },
  "guest": {
    "default_model": {{ .dotfiles_ai.opencode.default_model | toJson }},
    "small_model": {{ .dotfiles_ai.opencode.small_model | toJson }},
    "theme": {{ .dotfiles_ai.opencode.theme | toJson }},
    "atuin_sync_address": {{ .dotfiles_ai.atuin.sync_address | toJson }},
    "hermes_enabled": {{ .dotfiles_ai.hermes.enabled | toJson }},
    "rnd_backend": {{ .dotfiles_ai.rnd.backend | toJson }},
    "rnd_runtime": {{ .dotfiles_ai.rnd.runtime | toJson }},
    "vertex_project": {{ .dotfiles_ai.opencode.vertex_project | toJson }},
    "vertex_location": {{ .dotfiles_ai.opencode.vertex_location | toJson }},
    "vertex_account": {{ .dotfiles_ai.opencode.vertex_account | toJson }}
  },
  "workspaces": [
{{- range $index, $workspace := .dotfiles_ai.sandbox.workspaces }}{{ if $index }},{{ end }}
    {
      "name": {{ $workspace.name | toJson }},
      "instance": {{ $workspace.instance | toJson }},
      "shell_alias": {{ $workspace.shell_alias | default "" | toJson }},
      "federate": {{ $workspace.federate | toJson }},
      "runtime": {{ get $workspace "runtime" | default "" | toJson }},
      "hermes_projects": {{ get $workspace "hermes_projects" | default false | toJson }},
      "hermes_backlog_roots": {{ get $workspace "hermes_backlog_roots" | default list | toJson }},
      "mounts": {{ $workspace.mounts | toJson }}
    }
{{- end }}
  ]
}
