{
  "schema_version": 3,
  "enabled": {{ .dotfiles_ai.sandbox.enabled | toJson }},
  "source": {{ .dotfiles_ai.distribution.repository | toJson }},
  "template": {{ printf "%s/.config/dotfiles-ai/lima/workspace.yaml" .chezmoi.homeDir | toJson }},
  "build_workspace": {{ .dotfiles_ai.sandbox.build_workspace | toJson }},
  "tailscale": {
    "enabled": {{ .dotfiles_ai.tailscale.enabled | toJson }},
    "ssh": {{ .dotfiles_ai.tailscale.ssh | toJson }}
  },
  "resources": {
    "cpus": {{ .dotfiles_ai.sandbox.cpus }},
    "memory_gib": {{ .dotfiles_ai.sandbox.memory_gib }},
    "disk_gib": {{ .dotfiles_ai.sandbox.disk_gib }}
  },
  "guest": {
    "default_model": {{ .dotfiles_ai.opencode.default_model | toJson }},
    "small_model": {{ .dotfiles_ai.opencode.small_model | toJson }},
    "theme": {{ .dotfiles_ai.opencode.theme | toJson }},
    "atuin_sync_address": {{ .dotfiles_ai.atuin.sync_address | toJson }},
    "hermes_enabled": {{ .dotfiles_ai.hermes.enabled | toJson }},
    "rnd_backend": {{ .dotfiles_ai.rnd.backend | toJson }}
  },
  "workspaces": [
{{- range $index, $workspace := .dotfiles_ai.sandbox.workspaces }}{{ if $index }},{{ end }}
    {
      "name": {{ $workspace.name | toJson }},
      "instance": {{ $workspace.instance | toJson }},
      "shell_alias": {{ $workspace.shell_alias | default "" | toJson }},
      "federate": {{ $workspace.federate | toJson }},
      "hermes_projects": {{ get $workspace "hermes_projects" | default false | toJson }},
      "hermes_backlog_roots": {{ get $workspace "hermes_backlog_roots" | default list | toJson }},
      "mounts": {{ $workspace.mounts | toJson }}
    }
{{- end }}
  ]
}
