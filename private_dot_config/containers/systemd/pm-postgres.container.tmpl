{{- if and .dotfiles_ai.pm_kernel.enabled .dotfiles_ai.pm_kernel.postgres_enabled -}}
{{- if not (regexMatch "^docker\\.io/library/postgres:19beta3@sha256:[0-9a-f]{64}$" .dotfiles_ai.pm_kernel.postgres_image) -}}
{{ fail "dotfiles_ai.pm_kernel.postgres_image must be an exact PostgreSQL 19 image digest" }}
{{- end -}}
{{- if and .dotfiles_ai.knowledge_store.postgres_enabled (ne .dotfiles_ai.pm_kernel.postgres_image "docker.io/library/postgres:19beta3@sha256:bfa69ac147240b42c3fc9005d8d173a8b0f07949c7d5c5bbc8985c17b011ec40") -}}
{{ fail "knowledge PostgreSQL requires the approved PostgreSQL 19 Beta 3 base digest" }}
{{- end -}}
[Unit]
Description=PM Kernel and DBSCTR Knowledge PostgreSQL 19 projection
Wants=network-online.target
After=network-online.target

[Container]
{{- if .dotfiles_ai.knowledge_store.postgres_enabled }}
Image=localhost/dotfiles-ai/postgres-pgvector:19beta3-0.8.6
{{- else }}
Image={{ .dotfiles_ai.pm_kernel.postgres_image }}
{{- end }}
ContainerName=pm-postgres
Environment=POSTGRES_DB=pm_kernel
Environment=POSTGRES_USER=pm_kernel
Environment=POSTGRES_PASSWORD_FILE=/run/secrets/pm-postgres-password
Secret=pm-postgres-password,type=mount
PublishPort=127.0.0.1:55432:5432
Volume=pm-postgres-data.volume:/var/lib/postgresql
Volume=%h/.local/share/pm-kernel/schema.sql:/docker-entrypoint-initdb.d/001-pm-kernel.sql:ro,Z
Volume=%h/.local/share/pm-kernel/health.sh:/usr/local/bin/pm-kernel-health:ro,Z
HealthCmd=/bin/sh /usr/local/bin/pm-kernel-health
HealthInterval=30s
HealthTimeout=5s
HealthRetries=5

[Service]
Restart=on-failure
TimeoutStartSec=120
{{- if .dotfiles_ai.knowledge_store.postgres_enabled }}
ExecStartPre=%h/.local/bin/pm-postgres-image-verify
{{- end }}
ExecStartPost=%h/.local/bin/pm-postgres-migrate

[Install]
WantedBy=default.target
{{- end }}
