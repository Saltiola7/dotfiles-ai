{{- if and .dotfiles_ai.pm_kernel.enabled .dotfiles_ai.pm_kernel.postgres_enabled -}}
{{- if not (regexMatch "^docker\\.io/library/postgres:19beta3@sha256:[0-9a-f]{64}$" .dotfiles_ai.pm_kernel.postgres_image) -}}
{{ fail "dotfiles_ai.pm_kernel.postgres_image must be an exact PostgreSQL 19 image digest" }}
{{- end -}}
[Unit]
Description=PM Kernel PostgreSQL 19 projection
Wants=network-online.target
After=network-online.target

[Container]
Image={{ .dotfiles_ai.pm_kernel.postgres_image }}
ContainerName=pm-postgres
Environment=POSTGRES_DB=pm_kernel
Environment=POSTGRES_USER=pm_kernel
EnvironmentFile=%h/.config/pm-kernel/postgres.env
PublishPort=127.0.0.1:55432:5432
Volume=pm-postgres-data.volume:/var/lib/postgresql
Volume=%h/.local/share/pm-kernel/schema.sql:/docker-entrypoint-initdb.d/001-pm-kernel.sql:ro
Volume=%h/.local/share/pm-kernel/health.sh:/usr/local/bin/pm-kernel-health:ro
HealthCmd=/bin/sh /usr/local/bin/pm-kernel-health
HealthInterval=30s
HealthTimeout=5s
HealthRetries=5

[Service]
Restart=on-failure
TimeoutStartSec=120
ExecStartPost=%h/.local/bin/pm-postgres-migrate

[Install]
WantedBy=default.target
{{- end }}
