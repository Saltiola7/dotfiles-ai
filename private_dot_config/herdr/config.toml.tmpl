onboarding = false

[experimental]
allow_nested = true
pane_history = true

[advanced]
scrollback_limit_bytes = 10000000

[theme]
name = {{ .dotfiles_ai.herdr.theme | quote }}

[ui]
agent_panel_sort = {{ .dotfiles_ai.herdr.agent_panel_sort | quote }}{{ if .dotfiles_ai.state.root }}
[worktrees]
directory = {{ printf "%s/herdr/worktrees" .dotfiles_ai.state.root | quote }}
{{ end }}
{{ if .dotfiles_ai.remote_user_environment.enabled }}
[session]
resume_agents_on_restore = true
{{ end }}
