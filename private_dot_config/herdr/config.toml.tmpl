onboarding = false

[experimental]
allow_nested = true
pane_history = true

[advanced]
scrollback_limit_bytes = 10000000

[theme]
name = {{ .dotfiles_ai.herdr.theme | quote }}

[ui]
agent_panel_sort = {{ .dotfiles_ai.herdr.agent_panel_sort | quote }}{{ if .dotfiles_ai.state.root }}
[worktrees]
directory = {{ printf "%s/herdr/worktrees" .dotfiles_ai.state.root | quote }}
{{ end }}
{{ if .dotfiles_ai.remote_user_environment.enabled }}
{{ if not (has .dotfiles_ai.herdr.runtime (list "herdr-core" "tui")) }}
{{ fail "remote Herdr runtime must be herdr-core or tui" }}
{{ end }}
[session]
resume_agents_on_restore = {{ eq .dotfiles_ai.herdr.runtime "tui" }}
{{ end }}
