{{- /* chezmoi:modify-template */ -}}
{{- $managed := includeTemplate "opencode.json.tmpl" . | fromJson -}}
{{- $config := $managed -}}
{{- if ne (trim .chezmoi.stdin) "" -}}
{{- $config = mergeOverwrite (fromJson .chezmoi.stdin) $managed -}}
{{- end -}}
{{- /* Remove known managed names only; unfamiliar local rules require review. */ -}}
{{- $retired := list
  "status" "attach" "preflight" "begin" "initiative_begin" "initiative_launch" "reconcile"
  "continuation_enroll" "continuation_recover" "continuation_finish" "continuation_bind"
  "continuation_release" "continuation_handover" "continuation_provider" "continuation_storage_recover"
  "runtime_health" "phase_span" "execution_dag" "execution_benchmark" "audit" "inspect"
  "review" "review_complete" "review_history" "review_federated" "review_history_save"
  "incident_scan" "incident_register" "incident_update" "incident_forget" "lens_summary"
  "vm_handoff" "history_capture" "history_telemetry" "benchmark" "provider_evaluation"
  "provider_evaluation_save" "improvement_status" "improvement_claim" "improvement_update" -}}
{{- $scopes := list (get $config "permission") -}}
{{- range $agent := get $config "agent" -}}
{{- if kindIs "map" $agent -}}
{{- $scopes = append $scopes (get $agent "permission") -}}
{{- end -}}
{{- end -}}
{{- range $permissions := $scopes -}}
{{- if kindIs "map" $permissions -}}
{{- range $name := $retired -}}
{{- $_ := unset $permissions (printf "dbsctr_%s" $name) -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- $_ := unset (get $config "references") "dbsctr-worktrees" -}}
{{ $config | toPrettyJson }}
