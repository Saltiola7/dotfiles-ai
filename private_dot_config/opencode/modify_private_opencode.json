{{- /* chezmoi:modify-template */ -}}
{{- $managed := includeTemplate "opencode.json.tmpl" . | fromJson -}}
{{- if eq (trim .chezmoi.stdin) "" -}}
{{ $managed | toPrettyJson }}
{{- else -}}
{{- $existing := fromJson .chezmoi.stdin -}}
{{- if hasKey $existing "command" -}}
{{- $_ := unset (get $existing "command") "discovery-coordinator" -}}
{{- end -}}
{{ mergeOverwrite $existing $managed | toPrettyJson }}
{{- end -}}
