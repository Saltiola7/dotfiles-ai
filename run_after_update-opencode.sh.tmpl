#!/bin/bash
set -euo pipefail

{{ if .dotfiles_ai.remote_user_environment.enabled -}}
export DOTFILES_AI_REMOTE_USER_ENVIRONMENT=1
{{ end -}}
{{ if and (eq .chezmoi.os "darwin") (eq .chezmoi.arch "arm64") -}}
exec "$HOME/.local/bin/opencode-install"
{{ else -}}
exec "$HOME/.local/bin/opencode-update-all"
{{ end -}}
