#!/bin/bash
set -euo pipefail

{{ if or .dotfiles_ai.remote_user_environment.enabled .dotfiles_ai.linux_workstation.enabled -}}
export DOTFILES_AI_REMOTE_USER_ENVIRONMENT=1
{{ end -}}
{{ if or (and (eq .chezmoi.os "darwin") (eq .chezmoi.arch "arm64")) (and (eq .chezmoi.os "linux") (or (eq .chezmoi.arch "arm64") (eq .chezmoi.arch "amd64"))) -}}
exec "$HOME/.local/bin/opencode-install"
{{ else -}}
exec "$HOME/.local/bin/opencode-update-all"
{{ end -}}
