#!/bin/sh
# plist hash: {{ include "private_Library/LaunchAgents/dev.dotfiles-ai.pm-postgres-backup.plist.tmpl" | sha256sum }}
{{ if ne .chezmoi.os "darwin" -}}
exit 0
{{ end -}}
set -eu
label=dev.dotfiles-ai.pm-postgres-backup
domain="gui/$(id -u)"
plist="$HOME/Library/LaunchAgents/$label.plist"
if launchctl print "$domain/$label" >/dev/null 2>&1; then
    launchctl bootout "$domain/$label"
fi
{{ if and .dotfiles_ai.pm_kernel.enabled .dotfiles_ai.pm_kernel.postgres_enabled -}}
"$HOME/.local/bin/sandbox-vm" validate {{ .dotfiles_ai.pm_kernel.workspace | quote }}
. "$HOME/.local/bin/op-session"
op read {{ .dotfiles_ai.pm_kernel.postgres_password_ref | quote }} | \
    "$HOME/.local/bin/sandbox-vm" provision-pm-postgres
{{ if .dotfiles_ai.knowledge_store.postgres_enabled -}}
dks_password=$(op read {{ (index .dotfiles_ai.knowledge_store.projects "dotfiles_ai").postgres_password_ref | quote }})
security add-generic-password -U -s dev.dotfiles-ai.dks-postgres -a dks_dotfiles_ai -w "$dks_password" >/dev/null
unset dks_password
baseline=
if "$HOME/.local/bin/sandbox-vm" shell {{ .dotfiles_ai.pm_kernel.workspace | quote }} -- \
    systemctl --user is-active --quiet pm-postgres.service; then
    baseline=$("$HOME/.local/bin/pm-postgres-baseline")
    "$HOME/.local/bin/pm-postgres-backup" >/dev/null
elif "$HOME/.local/bin/sandbox-vm" shell {{ .dotfiles_ai.pm_kernel.workspace | quote }} -- \
    podman volume exists pm-postgres-data; then
    echo "pm-postgres: existing inactive volume cannot be migrated without verified backup" >&2
    exit 1
fi
{{ end -}}
"$HOME/.local/bin/sandbox-vm" update {{ .dotfiles_ai.pm_kernel.workspace | quote }}
"$HOME/.local/bin/sandbox-vm" shell {{ .dotfiles_ai.pm_kernel.workspace | quote }} -- \
    systemctl --user is-active --quiet pm-postgres.service
"$HOME/.local/bin/sandbox-vm" configure-pm-postgres
healthy=
for _ in $(seq 1 60); do
    if "$HOME/.local/bin/sandbox-vm" shell {{ .dotfiles_ai.pm_kernel.workspace | quote }} -- \
        sh -c 'systemctl --user is-active --quiet pm-postgres.service && podman healthcheck run pm-postgres >/dev/null 2>&1'; then
        healthy=1
        break
    fi
    sleep 1
done
if [ -z "$healthy" ]; then
    echo "pm-postgres: service did not recover after Lima reconfiguration" >&2
    exit 1
fi
"$HOME/.local/bin/dks-postgres-migrate"
{{ if .dotfiles_ai.knowledge_store.postgres_enabled -}}
if [ -n "$baseline" ]; then
    "$HOME/.local/bin/pm-postgres-baseline" --compare "$baseline" >/dev/null
fi
{{ else -}}
security delete-generic-password -s dev.dotfiles-ai.dks-postgres -a dks_dotfiles_ai >/dev/null 2>&1 || true
/bin/rm -f "$HOME/.local/bin/dksctl" "$HOME/.local/bin/dks-psql" \
    "$HOME/.config/dotfiles-ai/knowledge/projects.json"
{{ end -}}
launchctl bootstrap "$domain" "$plist"
{{ else -}}
security delete-generic-password -s dev.dotfiles-ai.dks-postgres -a dks_dotfiles_ai >/dev/null 2>&1 || true
"$HOME/.local/bin/sandbox-vm" configure-pm-postgres --remove
/bin/rm -f "$plist"
{{ end -}}
