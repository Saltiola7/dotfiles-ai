# Portable guest shell configuration derived from the personal dotfiles.
if [ -f "$HOME/.common_profile" ]; then
    . "$HOME/.common_profile"
fi

[[ $- != *i* ]] && return

# Separate sources contribute snippets without owning this shared startup file.
for dotfiles_ai_snippet in "$HOME"/.bashrc.d/*.sh; do
    if [[ -f $dotfiles_ai_snippet && -r $dotfiles_ai_snippet ]]; then
        . "$dotfiles_ai_snippet"
    fi
done
unset dotfiles_ai_snippet

if command -v wt >/dev/null; then
    eval "$(wt config shell init bash)"
fi

if [ -t 0 ] && command -v atuin >/dev/null; then
    eval "$(atuin init bash)"
fi

if [ -t 0 ] && command -v starship >/dev/null; then
    export SHELL_LABEL="bash ${BASH_VERSION%%(*}"
    eval "$(starship init bash)"
fi

# Lima BEGIN
# Make sure iptables and mount.fuse3 are available
PATH="$PATH:/usr/sbin:/sbin"
export PATH
# Lima END

[ -f "$HOME/.local/share/bash-preexec/bash-preexec.sh" ] && source "$HOME/.local/share/bash-preexec/bash-preexec.sh"
