#!/bin/sh
set -eu

state="$HOME/.local/state/opencode/kv.json"
tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT
install -d -m 0700 "$(dirname "$state")"
if [ -f "$state" ]; then
    jq --arg theme {{ .dotfiles_ai.opencode.theme | quote }} '.theme = $theme' "$state" >"$tmp"
else
    jq -n --arg theme {{ .dotfiles_ai.opencode.theme | quote }} '{theme: $theme}' >"$tmp"
fi
chmod 0600 "$tmp"
mv -f "$tmp" "$state"
